      "additions": 21,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5c5e5a8afbba5ac93757c9ca22f3f424b977c35d/tests%2Ftest_parameter_shape_mismatch.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_parameter_shape_mismatch.py?ref=5c5e5a8afbba5ac93757c9ca22f3f424b977c35d",
      "deletions": 0,
      "filename": "tests/test_parameter_shape_mismatch.py",
      "patch": "@@ -0,0 +1,21 @@\n+import torch\n+from vllm.model_executor.parameter import BasevLLMParameter\n+\n+\n+def test_assert_and_load_shape_mismatch_raises():\n+    # parameter expects shape (2,)\n+    param_tensor = torch.empty(2)\n+\n+    # create BasevLLMParameter with a dummy loader\n+    p = BasevLLMParameter(data=param_tensor, weight_loader=lambda: None)\n+\n+    # loaded_weight has incompatible shape (3,)\n+    loaded = torch.empty(3)\n+\n+    try:\n+        p._assert_and_load(loaded)\n+        assert False, \"Expected ValueError on shape mismatch\"\n+    except ValueError as e:\n+        assert \"weight shape mismatch\" in str(e)\n+        assert \"(2,)\" in str(e)\n+        assert \"(3,)\" in str(e)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5c5e5a8afbba5ac93757c9ca22f3f424b977c35d/tests%2Ftest_parameter_shape_mismatch.py",
      "sha": "ed1f05a5855396a855208133f1141c7fc179cb8f",
      "status": "added"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5c5e5a8afbba5ac93757c9ca22f3f424b977c35d/vllm%2Fmodel_executor%2Fparameter.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fparameter.py?ref=5c5e5a8afbba5ac93757c9ca22f3f424b977c35d",
      "deletions": 2,
      "filename": "vllm/model_executor/parameter.py",
      "patch": "@@ -91,9 +91,13 @@ def _is_1d_and_scalar(self, loaded_weight: torch.Tensor):\n         return cond1 and cond2\n \n     def _assert_and_load(self, loaded_weight: torch.Tensor):\n-        assert self.data.shape == loaded_weight.shape or self._is_1d_and_scalar(\n+        if self.data.shape != loaded_weight.shape and not self._is_1d_and_scalar(\n             loaded_weight\n-        )\n+        ):\n+            raise ValueError(\n+                f\"weight shape mismatch: parameter has {tuple(self.data.shape)}, \"\n+                f\"checkpoint has {tuple(loaded_weight.shape)}\"\n+            )\n         self.data.copy_(loaded_weight)\n \n     def load_column_parallel_weight(self, loaded_weight: torch.Tensor):",
