      "blob_url": "https://github.com/vllm-project/vllm/blob/a988e0f03bafae06455f0972e798ecc0a66df5c2/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmetrics.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmetrics.py?ref=a988e0f03bafae06455f0972e798ecc0a66df5c2",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/metrics.py",
      "patch": "@@ -51,6 +51,13 @@ def is_empty(self) -> bool:\n \n \n class KVConnectorLogging:\n+    \"\"\"Accumulate connector statistics and periodically log interval summaries.\n+\n+    The whole pipeline: observe() -> transfer_stats_accumulator.aggregate()\n+    -> transfer_stats_accumulator.reduce() -> log()\n+    This class receives statistics pre-aggregated across workers.\n+    \"\"\"\n+\n     def __init__(self, kv_transfer_config: KVTransferConfig | None):\n         # Instantiate the connector's stats class.\n         if kv_transfer_config and kv_transfer_config.kv_connector:\n@@ -63,6 +70,7 @@ def reset(self):\n         self.transfer_stats_accumulator: KVConnectorStats | None = None\n \n     def observe(self, transfer_stats_data: dict[str, Any]):\n+        \"\"\"Accumulate a pre-aggregated worker payload for the logging interval.\"\"\"\n         # Should not be called when a KVConnector is not configured.\n         assert self.connector_cls is not None\n         # Called periodically when connector syncs with the scheduler.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a988e0f03bafae06455f0972e798ecc0a66df5c2/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmetrics.py",
      "sha": "f19f4d767609670291e36b4625c1c4e854e36c3f",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/vllm-project/vllm/blob/a988e0f03bafae06455f0972e798ecc0a66df5c2/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fstats.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fstats.py?ref=a988e0f03bafae06455f0972e798ecc0a66df5c2",
      "deletions": 1,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/nixl/stats.py",
      "patch": "@@ -23,7 +23,12 @@\n \n @dataclass\n class NixlKVConnectorStats(KVConnectorStats):\n-    \"\"\"Container for transfer performance metrics.\"\"\"\n+    \"\"\"Container for transfer performance metrics.\n+\n+    Each worker records telemetry independently. In multi-rank TP deployments,\n+    worker observations are pooled, which means the metrics calculated below are\n+    aggregated across all TP ranks.\n+    \"\"\"\n \n     def __post_init__(self):\n         if not self.data:\n@@ -128,6 +133,8 @@ def reduce(self) -> dict[str, int | float]:\n                 **failure_counts,\n             }\n \n+        # Observations have already been pooled across TP ranks and reporting\n+        # batches in the logging interval. Each sample is a rank-level transfer.\n         xfer_time = np.asarray(self.data[\"transfer_duration\"])\n         post_time = np.asarray(self.data[\"post_duration\"])\n         # Convert to MB for CLI logging.\n@@ -137,11 +144,15 @@ def reduce(self) -> dict[str, int | float]:\n         assert n == self.num_successful_transfers\n \n         total_mb = mb.sum()\n+        # Mean payload size per rank-level transfer in the combined pool.\n         avg_mb = total_mb / n\n \n+        # Divide pooled transfer volume by summed rank-level transfer durations.\n+        # This is a duration-weighted average of individual transfer rates.\n         total_time_seconds = xfer_time.sum()\n         throughput_mb_s = total_mb / total_time_seconds\n \n+        # Means and P90s are computed from the combined raw observations\n         return {\n             \"Num successful transfers\": n,\n             \"Avg xfer time (ms)\": round(xfer_time.mean().item() * 1e3, 3),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a988e0f03bafae06455f0972e798ecc0a66df5c2/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fstats.py",
      "sha": "b94475e05ae152b130406a515f89538bd18b76d5",
      "status": "modified"
    }
