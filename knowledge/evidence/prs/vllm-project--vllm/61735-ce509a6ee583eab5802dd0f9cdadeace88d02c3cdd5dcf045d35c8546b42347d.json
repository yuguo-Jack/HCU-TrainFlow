      "deletions": 2,
      "filename": "vllm/model_executor/layers/lightning_attn.py",
      "patch": "@@ -377,8 +377,8 @@ def _fwd_none_diag_kernel(\n     # Load query values\n     q = tl.load(Q_block_ptr, mask=q_index[:, None] < n, other=0.0).to(tl.float32)\n \n-    # Compute decay factors for the current sub-block\n-    q_decay = tl.exp(-s.to(tl.float32) * (off_c * CBLOCK + c_array[:, None]))\n+    # The incoming state precedes this block, so its first query decays it once.\n+    q_decay = tl.exp(-s.to(tl.float32) * (off_c * CBLOCK + c_array[:, None] + 1))\n \n     # Compute non-diagonal attention output\n     qkv_none_diag = tl.dot(q, kv) * q_decay",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5d531553594daa18e0aa4292517196c7ed0290cc/vllm%2Fmodel_executor%2Flayers%2Flightning_attn.py",
      "sha": "d51a59dac527c1f581c64a356812099c93b8197d",
