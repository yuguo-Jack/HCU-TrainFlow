  "files": [
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d302efb8b578aef902c77d4eddb4a59d8933b55a/recipes%2Fmodels%2FGoogle%2Fgemma-4-31B-it.yaml",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2FGoogle%2Fgemma-4-31B-it.yaml?ref=d302efb8b578aef902c77d4eddb4a59d8933b55a",
      "deletions": 2,
      "filename": "recipes/models/Google/gemma-4-31B-it.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"Google\"\n   description: \"Google's unified multimodal Gemma 4 dense model (31B) with native text, image, and audio, plus thinking mode and tool-use protocol.\"\n   date_added: 2026-04-02\n-  date_updated: 2026-09-09\n+  date_updated: 2026-10-30\n   tasks:\n     - multimodal\n     - text\n@@ -22,7 +22,7 @@ meta:\n \n model:\n   model_id: \"google/gemma-4-31B-it\"\n-  min_vllm_version: \"0.19.1\"\n+  min_vllm_version: \"0.29.0\"\n   architecture: dense\n   parameter_count: \"31B\"\n   active_parameters: \"31B\"\n@@ -87,6 +87,13 @@ features:\n         args:\n           - \"--speculative-config\"\n           - '{\"model\": \"RedHatAI/gemma-4-31B-it-speculator.eagle3\", \"num_speculative_tokens\": 3, \"method\": \"eagle3\"}'\n+      dflash2:\n+        label: \"DFlash2 (RedHatAI)\"\n+        description: \"RedHatAI DFlash2 draft with 7 tokens. The card's deployment was tested on vLLM 0.29.0 with target TP4 and draft TP4.\"\n+        variants: [default]\n+        args:\n+          - \"--speculative-config\"\n+          - '{\"model\":\"RedHatAI/gemma-4-31B-it-speculator.dflash2\",\"num_speculative_tokens\":7,\"draft_tensor_parallel_size\":4,\"method\":\"dflash\"}'\n opt_in_features:\n   - text_only\n   - spec_decoding\n@@ -416,6 +423,8 @@ guide: |\n \n   ## References\n \n+  - [RedHatAI DFlash2 speculator](https://huggingface.co/RedHatAI/gemma-4-31B-it-speculator.dflash2)\n+\n   - [Model card](https://huggingface.co/google/gemma-4-31B-it)\n   - [FP8 variant](https://huggingface.co/RedHatAI/gemma-4-31B-it-FP8-dynamic)\n   - [NVFP4 variant](https://huggingface.co/nvidia/gemma-4-31B-it-NVFP4)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d302efb8b578aef902c77d4eddb4a59d8933b55a/recipes%2Fmodels%2FGoogle%2Fgemma-4-31B-it.yaml",
      "sha": "2d05d1e17910d6ba9de8e6476dc2b2e430252f69",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d302efb8b578aef902c77d4eddb4a59d8933b55a/recipes%2Fmodels%2Fopenai%2Fgpt-oss-120b.yaml",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2Fopenai%2Fgpt-oss-120b.yaml?ref=d302efb8b578aef902c77d4eddb4a59d8933b55a",
      "deletions": 6,
      "filename": "recipes/models/openai/gpt-oss-120b.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"OpenAI\"\n   description: \"OpenAI's gpt-oss family (20B / 120B) with MXFP4 MoE, attention-sinks, built-in tools via Responses API\"\n   date_added: 2025-08-05\n-  date_updated: 2026-09-22\n+  date_updated: 2026-10-30\n   tasks:\n     - text\n   related_recipes: []\n@@ -20,7 +20,7 @@ meta:\n \n model:\n   model_id: \"openai/gpt-oss-120b\"\n-  min_vllm_version: \"0.10.1\"\n+  min_vllm_version: \"0.19.0\"\n   architecture: moe\n   parameter_count: \"120B\"\n   active_parameters: \"5.1B\"\n@@ -36,10 +36,21 @@ features:\n       - \"openai\"\n       - \"--enable-auto-tool-choice\"\n   spec_decoding:\n-    description: \"EAGLE3 speculative decoding for accelerated inference\"\n-    args:\n-      - \"--speculative-config\"\n-      - '{\"model\":\"nvidia/gpt-oss-120b-Eagle3-v3\",\"num_speculative_tokens\":7,\"method\":\"eagle3\",\"draft_tensor_parallel_size\":1}'\n+    description: \"EAGLE3 speculative decoding using the NVIDIA or RedHatAI draft model\"\n+    default_mode: nvidia\n+    modes:\n+      nvidia:\n+        label: \"EAGLE3 (NVIDIA)\"\n+        description: \"Existing NVIDIA EAGLE3 draft with 7 speculative tokens.\"\n+        args:\n+          - \"--speculative-config\"\n+          - '{\"model\":\"nvidia/gpt-oss-120b-Eagle3-v3\",\"num_speculative_tokens\":7,\"method\":\"eagle3\",\"draft_tensor_parallel_size\":1}'\n+      redhat:\n+        label: \"EAGLE3 (RedHatAI)\"\n+        description: \"RedHatAI EAGLE3 draft with 5 speculative tokens; the checkpoint card requires vLLM 0.19.0 or newer.\"\n+        args:\n+          - \"--speculative-config\"\n+          - '{\"model\":\"RedHatAI/gpt-oss-120b-speculator.eagle3\",\"num_speculative_tokens\":5,\"method\":\"eagle3\"}'\n \n opt_in_features:\n   - spec_decoding\n@@ -293,6 +304,8 @@ guide: |\n \n   ## References\n \n+  - [RedHatAI EAGLE3 speculator](https://huggingface.co/RedHatAI/gpt-oss-120b-speculator.eagle3)\n+\n   - [gpt-oss-120b](https://huggingface.co/openai/gpt-oss-120b)\n   - [gpt-oss-20b](https://huggingface.co/openai/gpt-oss-20b)\n   - [amd/gpt-oss-120b-w-mxfp4-a-fp8](https://huggingface.co/amd/gpt-oss-120b-w-mxfp4-a-fp8)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d302efb8b578aef902c77d4eddb4a59d8933b55a/recipes%2Fmodels%2Fopenai%2Fgpt-oss-120b.yaml",
      "sha": "907723e7cdab328d19cc9dffb20f1a3acd92b35a",
