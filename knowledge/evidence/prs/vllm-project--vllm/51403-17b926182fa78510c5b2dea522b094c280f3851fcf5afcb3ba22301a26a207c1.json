      "blob_url": "https://github.com/vllm-project/vllm/blob/cfbfce73e9f5ecafcceb1b0be72c4d6f4b511b97/tests%2Fkernels%2Fattention%2Ftest_rocm_aiter_mla_head_padding.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fattention%2Ftest_rocm_aiter_mla_head_padding.py?ref=cfbfce73e9f5ecafcceb1b0be72c4d6f4b511b97",
      "deletions": 7,
      "filename": "tests/kernels/attention/test_rocm_aiter_mla_head_padding.py",
      "patch": "@@ -161,10 +161,12 @@ def test_is_valid_num_heads():\n     assert not AiterMLAHelper.is_valid_num_heads(0)\n \n \n-def test_nondivisor_and_multitoken_never_use_gluon():\n-    # Non-divisor decode always takes the asm path (12 heads/rank at TP8).\n-    assert not AiterMLAHelper.use_gluon_decode(12, 1, \"auto\")\n-    assert not AiterMLAHelper.use_gluon_decode(6, 1, \"auto\")\n+def test_nondivisor_single_token_follows_arch_and_multitoken_never_gluon():\n+    # Non-divisor single-token decode uses Gluon on gfx950 (avoids padded\n+    # asm kernels that may be missing for some dtype combos like bf16/fp8).\n+    on_gfx950 = _on_gfx950()\n+    assert AiterMLAHelper.use_gluon_decode(12, 1, \"auto\") is on_gfx950\n+    assert AiterMLAHelper.use_gluon_decode(6, 1, \"auto\") is on_gfx950\n     # >=16 heads never pad, never Gluon.\n     assert not AiterMLAHelper.use_gluon_decode(16, 1, \"auto\")\n     # Multi-token (verify / qlen>1) is never the single-token Gluon decode.\n@@ -208,9 +210,9 @@ def test_asm_padding_env_force_gluon_follows_arch(monkeypatch):\n def test_asm_padding_env_auto_matches_arch_gate(monkeypatch):\n     monkeypatch.setenv(\"VLLM_ROCM_AITER_MLA_ASM_PADDING\", \"auto\")\n     on_gfx950 = _on_gfx950()\n-    # auto: divisor counts keep Gluon on gfx950, non-divisor counts take asm.\n-    assert AiterMLAHelper.use_gluon_decode(8, 1, \"auto\") is on_gfx950\n-    assert not AiterMLAHelper.use_gluon_decode(12, 1, \"auto\")\n+    # auto: all small-head counts prefer Gluon on gfx950.\n+    assert AiterMLAHelper.use_gluon_decode(8, 1,\"auto\") is on_gfx950\n+    assert AiterMLAHelper.use_gluon_decode(12, 1, \"auto\") is on_gfx950\n \n \n @pytest.mark.skipif(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cfbfce73e9f5ecafcceb1b0be72c4d6f4b511b97/tests%2Fkernels%2Fattention%2Ftest_rocm_aiter_mla_head_padding.py",
      "sha": "1f6d326275da430fc9820d94d1608fc3ff6bdc0f",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/cfbfce73e9f5ecafcceb1b0be72c4d6f4b511b97/vllm%2Fv1%2Fattention%2Fbackends%2Fmla%2Frocm_aiter_mla.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Fmla%2Frocm_aiter_mla.py?ref=cfbfce73e9f5ecafcceb1b0be72c4d6f4b511b97",
      "deletions": 1,
      "filename": "vllm/v1/attention/backends/mla/rocm_aiter_mla.py",
      "patch": "@@ -906,6 +906,16 @@ def use_gluon_decode(num_heads: int, max_qo_len: int, kv_cache_dtype: str) -> bo\n         # Small-head (<16) single-token decode takes either the Gluon kernel or\n         # the padded asm persistent decode, selected by\n         # VLLM_ROCM_AITER_MLA_ASM_PADDING and the arch (Gluon is gfx950 only).\n+    def use_gluon_decode(num_heads: int, max_qo_len: int) -> bool:\n+        # Small-head (<16) single-token decode can use either the Gluon kernel\n+        # or the padded asm persistent decode, selected by\n+        # VLLM_ROCM_AITER_MLA_ASM_PADDING (see _aiter_mla_small_head_mode)\n+        # and the arch: Gluon only has a gfx950 build. In \"auto\" (default)\n+        # mode ALL small-head counts prefer Gluon on gfx950 -- including\n+        # non-divisor counts like 12 heads/rank at TP8 -- because the padded\n+        # asm path may lack kernels for certain q_type/kv_type combinations\n+        # (e.g. bf16 query + fp8 kv at gqa=16). On gfx942 (no Gluon build)\n+        # the asm path is still used for all counts.\n         m = AiterMLAHelper._AITER_MIN_MLA_HEADS\n         if num_heads >= m or max_qo_len != 1:\n             return False\n@@ -921,7 +931,7 @@ def use_gluon_decode(num_heads: int, max_qo_len: int, kv_cache_dtype: str) -> bo\n         gluon_supported = _gluon_mla_decode_supported()\n         if mode == \"gluon\":\n             return gluon_supported\n-        return m % num_heads == 0 and gluon_supported\n+        return gluon_supported\n \n     @staticmethod\n     def use_gluon_verify(num_heads: int, max_qo_len: int, kv_cache_dtype: str) -> bool:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cfbfce73e9f5ecafcceb1b0be72c4d6f4b511b97/vllm%2Fv1%2Fattention%2Fbackends%2Fmla%2Frocm_aiter_mla.py",
      "sha": "2ffb3ac74da9c467b5b5449a9baaf69c4d57beef",
      "status": "modified"
    }
  ],
