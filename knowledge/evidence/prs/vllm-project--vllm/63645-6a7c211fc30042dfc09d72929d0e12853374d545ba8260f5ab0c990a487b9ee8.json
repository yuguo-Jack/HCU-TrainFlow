      "blob_url": "https://github.com/vllm-project/vllm/blob/932e21f33764e3f22ea69a39bbd9931977be8dfa/.buildkite%2Ftest_areas%2Fmisc.yaml",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Ftest_areas%2Fmisc.yaml?ref=932e21f33764e3f22ea69a39bbd9931977be8dfa",
      "deletions": 0,
      "filename": ".buildkite/test_areas/misc.yaml",
      "patch": "@@ -844,6 +844,43 @@ steps:\n   commands:\n   - pytest -v -s tool_parsers\n \n+- label: \":computer: (CPU) Distributed, Platforms, CLI\"\n+  key: cpu-distributed-platforms-cli\n+  depends_on:\n+  - image-build-cpu\n+  timeout_in_minutes: 20\n+  source_file_dependencies:\n+  - vllm/distributed/\n+  - vllm/config/\n+  - vllm/platforms/\n+  - vllm/entrypoints/cli/\n+  - vllm/entrypoints/launchers/\n+  - vllm/logger.py\n+  - vllm/utils/network_utils.py\n+  - vllm/model_executor/layers/fused_moe/expert_map_manager.py\n+  - vllm/v1/core/sched/output.py\n+  - vllm/v1/outputs.py\n+  - vllm/v1/worker/gpu/async_utils.py\n+  - tools/pre_commit/validate_config.py\n+  - tests/distributed/test_expert_placement.py\n+  - tests/distributed/test_file_store.py\n+  - tests/distributed/test_kvlayout.py\n+  - tests/distributed/test_kv_cache_events.py\n+  - tests/distributed/test_mq_connect_ip.py\n+  - tests/distributed/test_pipeline_partition.py\n+  - tests/distributed/aux_output_connector/test_store.py\n+  - tests/platforms/test_cpu.py\n+  - tests/entrypoints/cli/test_serve.py\n+  - tests/tools/test_config_validator.py\n+  device: cpu-small\n+  commands:\n+  - pytest -v -s distributed/test_expert_placement.py distributed/test_file_store.py distributed/test_kvlayout.py distributed/test_kv_cache_events.py distributed/test_mq_connect_ip.py distributed/test_pipeline_partition.py distributed/aux_output_connector/test_store.py\n+  - pytest -v -s entrypoints/cli/test_serve.py\n+  - pytest -v -s tools/test_config_validator.py\n+  # test_cpu.py needs VLLM_TARGET_DEVICE=cpu; the CPU image sets it globally,\n+  # but be explicit.\n+  - VLLM_TARGET_DEVICE=cpu pytest -v -s platforms/test_cpu.py\n+\n # Disabled until the pytest plugins installation is locked.\n # - label: \":nvidia: (A100) Batch Invariance\"\n #   key: batch-invariance-a100",
      "raw_url": "https://github.com/vllm-project/vllm/raw/932e21f33764e3f22ea69a39bbd9931977be8dfa/.buildkite%2Ftest_areas%2Fmisc.yaml",
      "sha": "2d2927715598bd83a4d3d4560cd7cc620713cbf5",
      "status": "modified"
    },
    {
      "additions": 0,
      "blob_url": "https://github.com/vllm-project/vllm/blob/932e21f33764e3f22ea69a39bbd9931977be8dfa/tools%2Fpre_commit%2Ftest_tethering_allowlist.txt",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tools%2Fpre_commit%2Ftest_tethering_allowlist.txt?ref=932e21f33764e3f22ea69a39bbd9931977be8dfa",
      "deletions": 15,
      "filename": "tools/pre_commit/test_tethering_allowlist.txt",
      "patch": "@@ -18,27 +18,17 @@\n \n # tests/distributed/ - multi-GPU / multi-node suites, launched via torchrun or a\n # custom runner rather than a directory-level pytest invocation.\n-tests/distributed/aux_output_connector/test_store.py  # added by #45635 (2026-09-21), no job collects this path\n tests/distributed/test_dcp_a2a.py  # multi-GPU DCP all-to-all; no dir-level pytest job\n tests/distributed/test_eplb_events.py  # multi-GPU EPLB; no dir-level pytest job\n tests/distributed/test_eplb_fused_moe_layer.py  # multi-GPU EPLB; no dir-level pytest job\n tests/distributed/test_eplb_fused_moe_layer_dep_nvfp4.py  # multi-GPU EPLB nvfp4; no dir-level pytest job\n tests/distributed/test_eplb_quant_scale_consistency.py  # multi-GPU EPLB; no dir-level pytest job\n tests/distributed/test_expert_parallel.py  # multi-GPU expert parallel; no dir-level pytest job\n-tests/distributed/test_expert_placement.py  # multi-GPU expert placement; no dir-level pytest job\n-tests/distributed/test_file_store.py  # no distributed.yaml job collects this path\n tests/distributed/test_flashinfer_pcie_ipc_all_reduce.py  # multi-GPU PCIe IPC all-reduce (#53576); no job\n tests/distributed/test_kimi_linear_context_parallel.py  # multi-GPU context parallel; no dir-level pytest job\n-tests/distributed/test_kv_cache_events.py  # needs multi-proc KV-events setup; no job\n-tests/distributed/test_kvlayout.py  # no distributed.yaml job collects this path\n-tests/distributed/test_mq_connect_ip.py  # no distributed.yaml job collects this path\n-tests/distributed/test_pipeline_partition.py  # no distributed.yaml job collects this path\n tests/distributed/test_split_group.py  # no distributed.yaml job collects this path\n tests/distributed/test_weight_transfer_nccl_uid.py  # sibling test_weight_transfer.py is tethered; not added to that job (#53784)\n \n-# tests/entrypoints/cli/\n-tests/entrypoints/cli/test_serve.py  # added by #53124 (2026-09-15); no job collects tests/entrypoints/cli/\n-\n # tests/kernels/\n tests/kernels/test_shuffle_rows.py  # explicitly --ignore'd in kernels.yaml with no follow-up job\n \n@@ -52,11 +42,6 @@ tests/v1/ec_connector/integration/test_epd_correctness.py  # run_epd_correctness\n tests/v1/ec_connector/integration/test_nixl_failure.py  # 2-GPU + NIXL E/PD integration test (#55290); no Buildkite job collects ec_connector/integration/\n tests/v1/kv_connector/nixl_integration/test_disagg_accuracy.py  # run by intel_jobs/misc_intel.yaml's run_xpu_disagg_accuracy_test.sh, which names it via $EXP_ROOT (the script's own dir) - not statically resolvable\n \n-# tests/platforms/\n-tests/platforms/test_cpu.py  # CPU-only unit test; no job targets tests/platforms/\n-\n-# tests/tools/\n-tests/tools/test_config_validator.py  # logic covered by the validate-config pre-commit hook; no test_areas job\n \n # Temporary gaps from disabling jobs until their transitive dependencies are locked.\n tests/evals/qwen4_exp/test_accuracy.py  # CI jobs disabled pending locked evalscope transitive dependencies",
