  "files": [
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/789ad66921133c996633ffe3b3895be8bf8453c7/tests%2Fdistributed%2Ftest_pipeline_partition.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fdistributed%2Ftest_pipeline_partition.py?ref=789ad66921133c996633ffe3b3895be8bf8453c7",
      "deletions": 7,
      "filename": "tests/distributed/test_pipeline_partition.py",
      "patch": "@@ -41,21 +41,22 @@ def _verify(partition_str, num_layers, pp_size, goldens):\n @pytest.mark.parametrize(\n     \"num_hidden_layers,pp_size,pp_rank,indices\",\n     [\n+        # Remainder layers are placed on the last stage(s).\n         # pp_size 2\n         (2, 2, 0, (0, 1)),\n         (2, 2, 1, (1, 2)),\n-        (3, 2, 0, (0, 2)),\n-        (3, 2, 1, (2, 3)),\n+        (3, 2, 0, (0, 1)),\n+        (3, 2, 1, (1, 3)),\n         # pp_size 3\n         (3, 3, 0, (0, 1)),\n         (3, 3, 1, (1, 2)),\n         (3, 3, 2, (2, 3)),\n         (4, 3, 0, (0, 1)),\n-        (4, 3, 1, (1, 3)),\n-        (4, 3, 2, (3, 4)),\n-        (5, 3, 0, (0, 2)),\n-        (5, 3, 1, (2, 4)),\n-        (5, 3, 2, (4, 5)),\n+        (4, 3, 1, (1, 2)),\n+        (4, 3, 2, (2, 4)),\n+        (5, 3, 0, (0, 1)),\n+        (5, 3, 1, (1, 3)),\n+        (5, 3, 2, (3, 5)),\n     ],\n )\n def test_uneven_auto_partition(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/789ad66921133c996633ffe3b3895be8bf8453c7/tests%2Fdistributed%2Ftest_pipeline_partition.py",
      "sha": "d5a558e0c208a0665661cba0ee6d787eb8a55882",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/789ad66921133c996633ffe3b3895be8bf8453c7/vllm%2Fdistributed%2Futils.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Futils.py?ref=789ad66921133c996633ffe3b3895be8bf8453c7",
      "deletions": 11,
      "filename": "vllm/distributed/utils.py",
      "patch": "@@ -111,16 +111,13 @@ def get_pp_indices(\n ) -> tuple[int, int]:\n     \"\"\"Try to evenly distribute layers across partitions.\n \n-    If the number of layers is not divisible by the number of partitions,\n-    the remaining layers are evenly distributed across all but the last\n-    partition. The last partition is excluded because it often contains an\n-    additional norm layer and we are attempting to balance compute.\n-\n-    If `pp_size > 2` and the number of remaining layers is\n-    `0 < x <= pp_size - 2` then the remaining layers are evenly distributed\n-    across the middle partitions. The first and last partitions are excluded\n-    because they contain the input and output embeddings respectively and we\n-    are attempting to reduce maximum memory consumption across partitions.\n+    If the number of layers is not divisible by the number of partitions, the\n+    remaining layers are placed on the last stage(s). This placement strategy\n+    is observed to perform better in practice.\n+\n+    For example, 9 layers across 4 stages are partitioned as [2, 2, 2, 3], and\n+    10 layers across 4 stages as [2, 2, 3, 3] (the 2 remainder layers go on the\n+    last two stages).\n     \"\"\"\n     partition_list_str = envs.VLLM_PP_LAYER_PARTITION\n     if partition_list_str is not None:\n@@ -139,7 +136,7 @@ def get_pp_indices(\n         partitions = [layers_per_partition for _ in range(pp_size)]\n \n         if remaining_layers := num_hidden_layers % pp_size:\n-            for i in range(2, remaining_layers + 2):\n+            for i in range(1, remaining_layers + 1):\n                 partitions[-i] += 1\n             logger.info(\n                 \"Hidden layers were unevenly partitioned: [%s]. \"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/789ad66921133c996633ffe3b3895be8bf8453c7/vllm%2Fdistributed%2Futils.py",
      "sha": "aaaf44f4a6471d9229d387b5d6e9c36b63c53172",
      "status": "modified"
    }
  ],
