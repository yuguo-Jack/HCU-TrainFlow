      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile?ref=c803479e6c787e91daf5f75a235a5000b31345fc",
      "deletions": 0,
      "filename": "docker/Dockerfile",
      "patch": "@@ -224,6 +224,7 @@ RUN --mount=type=cache,target=/opt/uv/cache \\\n     && if [ \"$(echo $CUDA_VERSION | cut -d. -f1)\" = \"12\" ]; then \\\n         sed -i 's/^nvidia-cutlass-dsl\\[cu13\\]/nvidia-cutlass-dsl/' requirements/cuda.txt; \\\n         sed -i 's/^humming-kernels\\[cu13\\]/humming-kernels[cu12]/' requirements/cuda.txt; \\\n+        sed -i \"s/^torchcodec==.*/torchcodec==0.16.0+cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')/\" requirements/cuda.txt; \\\n     fi \\\n     && if [ \"$(uname -m)\" = \"aarch64\" ]; then \\\n         # The manylinux 2_28 (glibc 2.28) aarch64 builder cannot use\n@@ -926,6 +927,7 @@ RUN --mount=type=cache,target=/opt/uv/cache \\\n     if [ \"$(echo $CUDA_VERSION | cut -d. -f1)\" = \"12\" ]; then \\\n         sed -i 's/^nvidia-cutlass-dsl\\[cu13\\]/nvidia-cutlass-dsl/' /tmp/requirements-cuda.txt; \\\n         sed -i 's/^humming-kernels\\[cu13\\]/humming-kernels[cu12]/' /tmp/requirements-cuda.txt; \\\n+        sed -i \"s/^torchcodec==.*/torchcodec==0.16.0+cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.')/\" /tmp/requirements-cuda.txt; \\\n     fi && \\\n     if [ \"${INSTALL_RUBIN_PRERELEASE}\" = \"true\" ]; then \\\n         uv pip install --system \\",
