  "files": [
    {
      "additions": 28,
      "blob_url": "https://github.com/vllm-project/vllm/blob/93d6f546745b33baecbfec1c74f76037e55bf1d6/tests%2Fmodels%2Finkling%2Ftest_sconv_cache_layout.py",
      "changes": 28,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Finkling%2Ftest_sconv_cache_layout.py?ref=93d6f546745b33baecbfec1c74f76037e55bf1d6",
      "deletions": 0,
      "filename": "tests/models/inkling/test_sconv_cache_layout.py",
      "patch": "@@ -0,0 +1,28 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+\"\"\"NVIDIA runtime conv-block-size tracking (see the ROCm twin test).\n+\n+The KV-cache planner enlarges the conv group's block size (W=4 -> e.g. 8)\n+when the attention page is a multiple of the conv page\n+(``unify_kv_cache_spec_page_size``). Slot mappings are then built with the\n+enlarged size, so NVIDIA call sites must index with the *runtime* block size,\n+not the kernel window size.\n+\"\"\"\n+\n+import torch\n+from torch import nn\n+\n+from vllm.models.inkling.nvidia.sconv_swa_attn import InklingConvState\n+\n+\n+def test_runtime_sconv_block_size_tracks_unified_cache_page():\n+    owner = InklingConvState.__new__(InklingConvState)\n+    nn.Module.__init__(owner)\n+    owner.block_size = 4\n+\n+    owner.kv_cache = torch.tensor([])\n+    assert owner.cache_block_size == 4\n+\n+    owner.kv_cache = torch.empty(2, 1, 32, 1024)\n+    assert owner.cache_block_size == 32",
      "raw_url": "https://github.com/vllm-project/vllm/raw/93d6f546745b33baecbfec1c74f76037e55bf1d6/tests%2Fmodels%2Finkling%2Ftest_sconv_cache_layout.py",
      "sha": "f4cec3678dabdc8679e97141ac4b526201e0c502",
      "status": "added"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fattention.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Finkling%2Fnvidia%2Fattention.py?ref=93d6f546745b33baecbfec1c74f76037e55bf1d6",
      "deletions": 1,
      "filename": "vllm/models/inkling/nvidia/attention.py",
      "patch": "@@ -260,7 +260,7 @@ def forward(\n                 fa_md.slot_mapping,\n                 off_k,\n                 off_v,\n-                self.conv_owner.block_size,\n+                self.conv_owner.cache_block_size,\n                 log_scaling if not self.is_local else None,\n             )\n             q = q.view(num_tokens, self.num_heads, self.head_dim)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fattention.py",
      "sha": "02031d3e284a8030f9b5fcb8aa98db3fb67cbedd",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fmodel.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Finkling%2Fnvidia%2Fmodel.py?ref=93d6f546745b33baecbfec1c74f76037e55bf1d6",
      "deletions": 1,
      "filename": "vllm/models/inkling/nvidia/model.py",
      "patch": "@@ -108,7 +108,7 @@ def _sconv_add_norm(\n             m.slot_mapping,\n             off_s,\n             ws,\n-            sconv.owner.block_size,\n+            sconv.owner.cache_block_size,\n             shared_tensor=shared_delta,\n         )\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fmodel.py",
      "sha": "446b91bb5af73f17b0a2d36cab6ff6ead3a4608b",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fsconv_swa_attn.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Finkling%2Fnvidia%2Fsconv_swa_attn.py?ref=93d6f546745b33baecbfec1c74f76037e55bf1d6",
      "deletions": 3,
      "filename": "vllm/models/inkling/nvidia/sconv_swa_attn.py",
      "patch": "@@ -150,9 +150,10 @@ def __init__(\n         self.num_kv_heads = num_kv_heads // tp_size\n         hidden_per_head = hidden_size // num_kv_heads\n         # Packed per-head width: K + V + attn-output chunk + mlp-output chunk,\n-        # padded to a power of two so every layer's conv page is the same size\n-        # and an exact multiple of the attention page (the page unifier then\n-        # scales attention block sizes instead of padding).\n+        # padded to a power of two so every layer's conv page is the same size.\n+        # The page unifier may still scale the logical conv block size up to\n+        # match a larger attention page; index the bound cache with its runtime\n+        # token dim (``cache_block_size``), not this kernel window size.\n         raw_head_size = 2 * head_dim + 2 * hidden_per_head\n         self.head_size = 1 << (raw_head_size - 1).bit_length()\n         self.sliding_window = kernel_size\n@@ -179,6 +180,13 @@ def __init__(\n \n     def forward(self): ...\n \n+    @property\n+    def cache_block_size(self) -> int:\n+        \"\"\"Return the block size used by cache metadata and physical indexing.\"\"\"\n+        if self.kv_cache.numel() > 0:\n+            return self.kv_cache.shape[2]\n+        return self.block_size\n+\n     def get_attn_backend(self) -> type[AttentionBackend]:\n         return InklingSconvBackend\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fsconv_swa_attn.py",
      "sha": "e6425eebb733b46779af32bcda8ebe92e5ac4b48",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fshort_conv.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Finkling%2Fnvidia%2Fshort_conv.py?ref=93d6f546745b33baecbfec1c74f76037e55bf1d6",
      "deletions": 1,
      "filename": "vllm/models/inkling/nvidia/short_conv.py",
      "patch": "@@ -72,7 +72,13 @@ def forward(self, x: torch.Tensor, positions: torch.Tensor) -> torch.Tensor:\n             return x\n \n         off_s, ws = self.owner.stream_ranges[self.stream_idx]\n-        block_size = self.owner.block_size\n+        # The hybrid KV-cache planner can enlarge the logical conv block so\n+        # that its physical page size matches the attention caches (for\n+        # example, W=4 becomes 8 when the attention page doubles the conv\n+        # page). Metadata slot mappings are built with that enlarged size, so\n+        # index the bound cache with its runtime token dimension rather than\n+        # the kernel window size.\n+        block_size = self.owner.cache_block_size\n         x = x.contiguous()\n         weight = self.weight.squeeze(1)  # (dim, W)\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/93d6f546745b33baecbfec1c74f76037e55bf1d6/vllm%2Fmodels%2Finkling%2Fnvidia%2Fshort_conv.py",
      "sha": "3e972b9082afccaec419698919ffadf2f64822ab",
      "status": "modified"
    }
  ],
  "inline_comments": [],
  "issue_comments": [
    {
      "body": "Hi @DarkLight1337 @ywang96 @AndreasKaratzas, quick reminder about this PR: This is not a default path issue, but the NVIDIA Inkling path is still incorrect when KV-cache page unification enlarges the convolution block size, causing corrupted generations with configurations such as `--block-size 64`. The fix is small, mirrors the existing AMD handling and prevents annoying errors when tuning the kv cache block size. Could you take a look when you have a moment?",
      "created_at": "2026-10-01T09:47:26Z",
      "html_url": "https://github.com/vllm-project/vllm/pull/51951#issuecomment-5928932701",
      "id": 5928932701,
      "updated_at": "2026-10-01T09:47:26Z",
      "user": {
        "login": "fjosw"
      }
    }
