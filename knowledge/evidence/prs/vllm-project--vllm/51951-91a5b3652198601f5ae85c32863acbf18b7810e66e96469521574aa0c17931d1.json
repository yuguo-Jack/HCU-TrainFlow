    "title": "[Bugfix][Model] Fix Inkling NVIDIA sconv cache block-size mismatch",
    "updated_at": "2026-10-10T10:42:01Z",
    "url": "https://api.github.com/repos/vllm-project/vllm/pulls/51951",
