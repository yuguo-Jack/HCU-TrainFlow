    {
      "additions": 53,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ff42815704e32a6f17f71da95d63cb9fe0a3cece/tests%2Fentrypoints%2Flaunchers%2Fapi_server%2Ftest_api_server_process_manager.py",
      "changes": 57,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Flaunchers%2Fapi_server%2Ftest_api_server_process_manager.py?ref=ff42815704e32a6f17f71da95d63cb9fe0a3cece",
      "deletions": 4,
      "filename": "tests/entrypoints/launchers/api_server/test_api_server_process_manager.py",
      "patch": "@@ -12,6 +12,7 @@\n import pytest\n import zmq\n \n+import vllm.envs as envs\n from vllm.utils.network_utils import make_zmq_listener, make_zmq_socket\n from vllm.v1.engine.admission_control import SharedAdmissionStats\n from vllm.v1.utils import (\n@@ -412,9 +413,32 @@ def run_with_exception_capture():\n         WORKER_RUNTIME_SECONDS = prev_worker_runtime\n \n \n-def test_rust_frontend_launch_log_redacts_credentials(monkeypatch):\n-    \"\"\"The Rust frontend command carries every non-default arg as JSON.\n-    Credentials must not reach the log line.\"\"\"\n+@pytest.mark.skip_global_cleanup\n+@pytest.mark.parametrize(\n+    (\n+        \"media_mb\",\n+        \"audio_mb\",\n+        \"existing_audio_mb\",\n+        \"expected_media_mb\",\n+        \"expected_audio_mb\",\n+    ),\n+    [\n+        (256, 25, None, 256, 25),\n+        (10, 25, None, 10, 10),\n+        (256, 25, 5, 256, 5),\n+        (256, 25, 0, 256, 0),\n+        (512, 512, None, 256, 256),\n+    ],\n+)\n+def test_rust_frontend_launch_config(\n+    monkeypatch,\n+    media_mb,\n+    audio_mb,\n+    existing_audio_mb,\n+    expected_media_mb,\n+    expected_audio_mb,\n+):\n+    \"\"\"Forward media limits without changing the parent or logging credentials.\"\"\"\n     import subprocess as subprocess_mod\n \n     from vllm.entrypoints.launchers.cli_args import make_arg_parser\n@@ -423,6 +447,14 @@ def test_rust_frontend_launch_log_redacts_credentials(monkeypatch):\n \n     hf_token = \"hf_TESTTOKEN123\"\n     api_key = \"sk-TESTKEY456\"\n+    monkeypatch.setattr(envs, \"VLLM_MAX_MEDIA_DOWNLOAD_SIZE_MB\", media_mb)\n+    monkeypatch.setattr(envs, \"VLLM_MAX_AUDIO_CLIP_FILESIZE_MB\", audio_mb)\n+    for modality in (\"IMAGE\", \"VIDEO\", \"AUDIO\"):\n+        monkeypatch.delenv(f\"SMG_{modality}_MAX_INPUT_BYTES\", raising=False)\n+    if existing_audio_mb is not None:\n+        monkeypatch.setenv(\n+            \"SMG_AUDIO_MAX_INPUT_BYTES\", str(existing_audio_mb * (1 << 20))\n+        )\n     args = make_arg_parser(FlexibleArgumentParser()).parse_args(\n         [\"--model\", \"org/model\", \"--hf-token\", hf_token, \"--api-key\", api_key]\n     )\n@@ -440,8 +472,14 @@ def wait(self, timeout=None):\n     sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n     input_listener = make_zmq_listener(\"tcp://127.0.0.1:0\", zmq.ROUTER)\n     output_listener = make_zmq_listener(\"tcp://127.0.0.1:0\", zmq.PULL)\n+    popen_calls = []\n+\n+    def fake_popen(cmd, **kwargs):\n+        popen_calls.append(kwargs)\n+        return _FakeProc()\n+\n     try:\n-        monkeypatch.setattr(subprocess_mod, \"Popen\", lambda *a, **kw: _FakeProc())\n+        monkeypatch.setattr(subprocess_mod, \"Popen\", fake_popen)\n         with patch(\"vllm.v1.utils.logger.info\") as log_info:\n             RustFrontendProcessManager(\n                 binary_path=\"/nonexistent/vllm-rs\",\n@@ -463,6 +501,17 @@ def wait(self, timeout=None):\n     assert api_key not in message\n     assert '\"hf_token\": \"***\"' in message\n     assert '\"api_key\": \"***\"' in message\n+    [popen_kwargs] = popen_calls\n+    rust_env = popen_kwargs[\"env\"]\n+    for modality in (\"IMAGE\", \"VIDEO\"):\n+        assert rust_env[f\"SMG_{modality}_MAX_INPUT_BYTES\"] == str(\n+            expected_media_mb * (1 << 20)\n+        )\n+    assert rust_env[\"SMG_AUDIO_MAX_INPUT_BYTES\"] == str(expected_audio_mb * (1 << 20))\n+    parent_audio_limit = (\n+        str(existing_audio_mb * (1 << 20)) if existing_audio_mb is not None else None\n+    )\n+    assert os.environ.get(\"SMG_AUDIO_MAX_INPUT_BYTES\") == parent_audio_limit\n \n \n def test_rust_frontend_uses_config_model_as_model_tag(monkeypatch, caplog, tmp_path):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ff42815704e32a6f17f71da95d63cb9fe0a3cece/tests%2Fentrypoints%2Flaunchers%2Fapi_server%2Ftest_api_server_process_manager.py",
      "sha": "65b00930540d84ec566d27da3ac78e1f7b08002b",
      "status": "modified"
    },
    {
      "additions": 23,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ff42815704e32a6f17f71da95d63cb9fe0a3cece/vllm%2Fv1%2Futils.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Futils.py?ref=ff42815704e32a6f17f71da95d63cb9fe0a3cece",
      "deletions": 1,
      "filename": "vllm/v1/utils.py",
      "patch": "@@ -370,9 +370,31 @@ def __init__(\n \n         redacted_json = json.dumps(redact_sensitive_args(args_dict), sort_keys=True)\n         logger.info(\"Launching Rust frontend: %s\", \" \".join(cmd[:-1] + [redacted_json]))\n+        rust_env = os.environ.copy()\n+        media_limit_mb = envs.VLLM_MAX_MEDIA_DOWNLOAD_SIZE_MB\n+        for modality, limits_mb in (\n+            (\"IMAGE\", (media_limit_mb,)),\n+            (\"VIDEO\", (media_limit_mb,)),\n+            (\"AUDIO\", (media_limit_mb, envs.VLLM_MAX_AUDIO_CLIP_FILESIZE_MB)),\n+        ):\n+            enabled_limits = [limit for limit in limits_mb if limit > 0]\n+            if not enabled_limits:\n+                continue\n+            name = f\"SMG_{modality}_MAX_INPUT_BYTES\"\n+            limit_bytes = min(enabled_limits) * (1 << 20)\n+            existing_limit = rust_env.get(name, \"\")\n+            configured_limit = (\n+                int(existing_limit) if existing_limit.isdecimal() else None\n+            )\n+            # The pinned llm-multimodal crate defaults to 256 MiB per modality.\n+            crate_limit = (\n+                configured_limit if configured_limit is not None else 256 * (1 << 20)\n+            )\n+            limit_bytes = min(limit_bytes, crate_limit)\n+            rust_env[name] = str(limit_bytes)\n         self._listeners = [input_listener, output_listener]\n         try:\n-            self._proc = subprocess.Popen(cmd, pass_fds=inherited_fds)\n+            self._proc = subprocess.Popen(cmd, pass_fds=inherited_fds, env=rust_env)\n         except BaseException:\n             for listener in self._listeners:\n                 listener.cleanup()",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ff42815704e32a6f17f71da95d63cb9fe0a3cece/vllm%2Fv1%2Futils.py",
      "sha": "85448553732c516041d1421c3fb25258bd7040b3",
