  "files": [
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/a8db038e9b8c5b93c8a5692e75ca6ce071350c2d/vllm%2Fentrypoints%2Fscale_out%2Ftoken_in_token_out%2Fapi_router.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fentrypoints%2Fscale_out%2Ftoken_in_token_out%2Fapi_router.py?ref=a8db038e9b8c5b93c8a5692e75ca6ce071350c2d",
      "deletions": 2,
      "filename": "vllm/entrypoints/scale_out/token_in_token_out/api_router.py",
      "patch": "@@ -42,6 +42,12 @@ def engine_client(request: Request) -> EngineClient:\n \n router = APIRouter()\n \n+# Tasks scheduled with asyncio.create_task() must be referenced until they\n+# finish; the event loop only keeps a weak reference, so an unreferenced task\n+# can be garbage-collected mid-run.\n+# https://docs.python.org/3/library/asyncio-task.html#asyncio.create_task\n+_background_tasks: set[asyncio.Task] = set()\n+\n \n @router.post(\n     \"/inference/v1/generate\",\n@@ -95,8 +101,11 @@ async def abort_requests(raw_request: Request):\n                     status_code=HTTPStatus.BAD_REQUEST.value,\n                     detail=\"Missing 'request_ids' in request body\",\n                 )\n-            # Abort requests in background\n-            asyncio.create_task(engine_client(raw_request).abort(request_ids))\n+            # Abort requests in background. Keep a strong reference to the task\n+            # so it isn't garbage-collected before the abort completes.\n+            task = asyncio.create_task(engine_client(raw_request).abort(request_ids))\n+            _background_tasks.add(task)\n+            task.add_done_callback(_background_tasks.discard)\n             return Response(status_code=200)\n \n     app.include_router(router)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a8db038e9b8c5b93c8a5692e75ca6ce071350c2d/vllm%2Fentrypoints%2Fscale_out%2Ftoken_in_token_out%2Fapi_router.py",
      "sha": "8547fdec243a85ecc98dc2465b67ee6ab26451d9",
      "status": "modified"
    }
