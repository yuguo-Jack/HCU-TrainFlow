      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Fmamba%2Fops%2Fselective_state_update_replayssm_output_only.py?ref=46e446e0235f11870467df2257be8fdc2a257877",
      "deletions": 3,
      "filename": "vllm/model_executor/layers/mamba/ops/selective_state_update_replayssm_output_only.py",
      "patch": "@@ -581,9 +581,10 @@ def selective_state_update_replayssm_output_only(\n     nf_nds = triton.cdiv(bs_dstate, nf_dstate_tile)\n     fl_dstate_tile = max(16, min(fl_tile, bs_dstate))\n     fl_nds = triton.cdiv(bs_dstate, fl_dstate_tile)\n-    # AMD Triton does not support tf32x3, so use its backend default. CUDA\n-    # retains tf32x3 to preserve fp32 parity with the elementwise baseline.\n-    dot_input_precision = None if current_platform.is_rocm() else \"tf32x3\"\n+    # tf32x3 is CUDA-only; other backends (ROCm, Ascend NPU, XPU) use their\n+    # backend default. CUDA retains tf32x3 to preserve fp32 parity with the\n+    # elementwise baseline.\n+    dot_input_precision = \"tf32x3\" if current_platform.is_cuda() else None\n \n     grid = lambda META: (triton.cdiv(dim, META[\"BLOCK_SIZE_M\"]), batch, nheads)\n     z_strides = (z.stride(0), z.stride(1), z.stride(2)) if z is not None else (0, 0, 0)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/46e446e0235f11870467df2257be8fdc2a257877/vllm%2Fmodel_executor%2Flayers%2Fmamba%2Fops%2Fselective_state_update_replayssm_output_only.py",
