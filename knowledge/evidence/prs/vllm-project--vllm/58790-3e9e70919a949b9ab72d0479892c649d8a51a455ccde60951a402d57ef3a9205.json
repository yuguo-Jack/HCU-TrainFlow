      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/csrc%2Fmoe%2Fmoe_permute_unpermute_op.cu?ref=47a4c415817441ccf1e3ca655e22134a4da2f3bc",
      "deletions": 0,
      "filename": "csrc/moe/moe_permute_unpermute_op.cu",
      "patch": "@@ -92,6 +92,14 @@ torch::stable::Tensor moe_sort_routing(\n   auto expanded_rows = n_token * topk;\n   auto stream = get_current_cuda_stream(topk_ids.get_device_index());\n \n+  // No rows: preprocessTopkIdLauncher would divide by block == 0 (#58789).\n+  if (expanded_rows == 0) {\n+    torch::stable::zero_(expert_first_token_offset);\n+    return maybe_allocate_tensor(maybe_sorted_row_idx, inv_permuted_idx.sizes(),\n+                                 torch::headeronly::ScalarType::Int, device,\n+                                 \"sorted_row_idx\");\n+  }\n+\n   auto sorter_size = moe_permute_sort_workspace_size(expanded_rows, n_expert);\n   auto sort_workspace = maybe_allocate_tensor(\n       maybe_sort_workspace, {sorter_size}, torch::headeronly::ScalarType::Char,\n@@ -147,6 +155,9 @@ void moe_permute_impl(\n       topk, expert_first_token_offset, inv_permuted_idx, maybe_sort_workspace,\n       maybe_permuted_experts_id, maybe_sorted_row_idx, maybe_topk_ids_for_sort,\n       false);\n+  if (topk_ids.numel() == 0) {\n+    return;\n+  }\n   auto stream = get_current_cuda_stream(input.get_device_index());\n   auto n_token = input.size(0);\n   auto n_hidden = input.size(1);",
      "raw_url": "https://github.com/vllm-project/vllm/raw/47a4c415817441ccf1e3ca655e22134a4da2f3bc/csrc%2Fmoe%2Fmoe_permute_unpermute_op.cu",
      "sha": "7563e5165ea08d1ee0162f43c6ab77ab5c9de122",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/vllm-project/vllm/blob/47a4c415817441ccf1e3ca655e22134a4da2f3bc/tests%2Fkernels%2Fmoe%2Ftest_moe_permute_unpermute.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fmoe%2Ftest_moe_permute_unpermute.py?ref=47a4c415817441ccf1e3ca655e22134a4da2f3bc",
      "deletions": 0,
      "filename": "tests/kernels/moe/test_moe_permute_unpermute.py",
      "patch": "@@ -227,6 +227,31 @@ def test_moe_permute_unpermute(\n     torch.testing.assert_close(result4, gold4, atol=2e-2, rtol=0)\n \n \n+@pytest.mark.parametrize(\"use_scratch\", [False, True])\n+def test_moe_permute_empty_routing(use_scratch: bool) -> None:\n+    if not moe_permute_unpermute_supported():\n+        pytest.skip(\"moe_permute_unpermute is not supported on this platform.\")\n+\n+    hidden_states = torch.empty((0, 128), dtype=torch.bfloat16, device=\"cuda\")\n+    topk_ids = torch.empty((0, 2), dtype=torch.int32, device=\"cuda\")\n+    expert_map = torch.arange(8, dtype=torch.int32, device=\"cuda\")\n+    scratch = None\n+    if use_scratch:\n+        scratch = get_moe_permute_scratch(\n+            num_experts=8, num_local_experts=8, device=hidden_states.device\n+        )\n+        scratch.reserve(2)\n+\n+    permuted, _, offsets, inverse, permuted_idx = moe_permute(\n+        hidden_states, None, topk_ids, 8, expert_map=expert_map, scratch=scratch\n+    )\n+\n+    assert permuted.shape == (0, 128)\n+    torch.testing.assert_close(offsets, torch.zeros_like(offsets))\n+    assert inverse.numel() == 0\n+    assert permuted_idx.numel() == 0\n+\n+\n @pytest.mark.parametrize(\"dtype\", [torch.float16, torch.bfloat16])\n @pytest.mark.parametrize(\"n_token\", [1, 33, 128])\n @pytest.mark.parametrize(\"topk\", [1, 6, 8])",
      "raw_url": "https://github.com/vllm-project/vllm/raw/47a4c415817441ccf1e3ca655e22134a4da2f3bc/tests%2Fkernels%2Fmoe%2Ftest_moe_permute_unpermute.py",
      "sha": "85fd45d0ad52e88764efdbd459d3ede9e7bd2156",
      "status": "modified"
    }
