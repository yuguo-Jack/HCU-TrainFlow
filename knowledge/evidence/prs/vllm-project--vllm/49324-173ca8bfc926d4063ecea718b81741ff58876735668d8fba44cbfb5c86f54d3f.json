  "inline_comments": [],
  "issue_comments": [
    {
      "body": "Hi @Isotr0py and @DarkLight1337,\r\n\r\nCould you (or someone from the loader team) take a look at this PR when you get a chance?\r\n\r\nWhat it does: This PR enables safetensors_load_strategy=\"prefetch\" to work together with the multi-thread loader. On network filesystems, this combination avoids duplicated NFS reads across TP ranks by prefetching files into page cache, while still gaining the speedup from multi-threaded loading.\r\n\r\ncc @22quinn",
      "created_at": "2026-07-22T11:04:52Z",
      "html_url": "https://github.com/vllm-project/vllm/pull/49324#issuecomment-5045032981",
