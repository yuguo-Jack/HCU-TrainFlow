  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1d6afa81aca002d4c6183fdf15d450fcb5d31f51/docker%2FDockerfile",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile?ref=1d6afa81aca002d4c6183fdf15d450fcb5d31f51",
      "deletions": 1,
      "filename": "docker/Dockerfile",
      "patch": "@@ -643,9 +643,11 @@ RUN --mount=type=cache,target=/opt/uv/cache \\\n         python3 tools/use_existing_torch.py --prefix; \\\n     fi\n \n-# Build the vLLM wheel\n+# Build the vLLM wheel. dirty=false matches the Rust frontend build, since\n+# .dockerignore drops tracked paths (e.g. /recipes) from the build context.\n RUN --mount=type=cache,target=/opt/uv/cache \\\n     --mount=type=bind,source=.git,target=.git \\\n+    export SETUPTOOLS_SCM_PRETEND_METADATA=\"{dirty=false}\" && \\\n     if [ \"${vllm_target_device}\" = \"cuda\" ]; then \\\n         export VLLM_USE_PRECOMPILED=1; \\\n         export VLLM_PRECOMPILED_WHEEL_LOCATION=$(ls /precompiled-wheels/*.whl); \\",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1d6afa81aca002d4c6183fdf15d450fcb5d31f51/docker%2FDockerfile",
      "sha": "eea1033544491e538925838b42b6bc00f3a25115",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1d6afa81aca002d4c6183fdf15d450fcb5d31f51/tests%2Ftools%2Ftest_docker_build_metadata_args.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftools%2Ftest_docker_build_metadata_args.py?ref=1d6afa81aca002d4c6183fdf15d450fcb5d31f51",
      "deletions": 0,
      "filename": "tests/tools/test_docker_build_metadata_args.py",
      "patch": "@@ -180,6 +180,16 @@ def test_rust_build_cache_excludes_git_metadata() -> None:\n         assert \"bash tools/build_rust.sh\" in exact_version_stage\n \n \n+def test_wheel_version_matches_rust_frontend_dirty_flag() -> None:\n+    dockerfile = (REPO_ROOT / \"docker\" / \"Dockerfile\").read_text()\n+    build_stage = dockerfile.split(\"FROM base AS build\", maxsplit=1)[1]\n+    build_stage = build_stage.split(\"\\nFROM \", maxsplit=1)[0]\n+    wheel_build = build_stage.split(\"# Build the vLLM wheel\", maxsplit=1)[1]\n+    wheel_build = wheel_build.split(\"bdist_wheel\", maxsplit=1)[0]\n+\n+    assert 'SETUPTOOLS_SCM_PRETEND_METADATA=\"{dirty=false}\"' in wheel_build\n+\n+\n def test_rocm_ci_base_bake_embeds_content_hash_label() -> None:\n     bake_file = (REPO_ROOT / \"docker\" / \"docker-bake-rocm.hcl\").read_text()\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1d6afa81aca002d4c6183fdf15d450fcb5d31f51/tests%2Ftools%2Ftest_docker_build_metadata_args.py",
      "sha": "d04f3e294e85342a927d893bf8ec42a8e28036ce",
      "status": "modified"
    }
