      "additions": 38,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9d1fa7715007b81f038fd4c636ac94ffc831ccff/tests%2Fv1%2Fsample%2Ftest_sampling_params.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fsample%2Ftest_sampling_params.py?ref=9d1fa7715007b81f038fd4c636ac94ffc831ccff",
      "deletions": 0,
      "filename": "tests/v1/sample/test_sampling_params.py",
      "patch": "@@ -0,0 +1,38 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+from types import SimpleNamespace\n+\n+import pytest\n+\n+from vllm import SamplingParams\n+\n+pytestmark = pytest.mark.skip_global_cleanup\n+\n+\n+def _model_config(vocab_size: int = 10):\n+    return SimpleNamespace(\n+        max_logprobs=20,\n+        logits_processors=None,\n+        get_vocab_size=lambda: vocab_size,\n+    )\n+\n+\n+def _verify_without_tokenizer(params: SamplingParams) -> None:\n+    params.verify(\n+        _model_config(),\n+        speculative_config=None,\n+        structured_outputs_config=None,\n+        tokenizer=None,\n+    )\n+\n+\n+@pytest.mark.parametrize(\"stop\", [\"foo\", [\"foo\"]])\n+def test_stop_strings_require_tokenizer(stop: str | list[str]):\n+    with pytest.raises(ValueError, match=\"skip_tokenizer_init\"):\n+        _verify_without_tokenizer(SamplingParams(stop=stop))\n+\n+\n+def test_tokenizer_free_stop_params():\n+    _verify_without_tokenizer(SamplingParams())\n+    _verify_without_tokenizer(SamplingParams(stop_token_ids=[1]))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9d1fa7715007b81f038fd4c636ac94ffc831ccff/tests%2Fv1%2Fsample%2Ftest_sampling_params.py",
      "sha": "5b7e8f2a756e038c11b063a9e545bb4adab8a300",
      "status": "added"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9d1fa7715007b81f038fd4c636ac94ffc831ccff/vllm%2Fsampling_params.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fsampling_params.py?ref=9d1fa7715007b81f038fd4c636ac94ffc831ccff",
      "deletions": 0,
      "filename": "vllm/sampling_params.py",
      "patch": "@@ -745,6 +745,7 @@ def verify(\n         self._validate_logits_processors(model_config)\n         self._validate_allowed_token_ids(tokenizer)\n         self._validate_spec_decode(speculative_config)\n+        self._validate_stop(tokenizer)\n         self._validate_structured_outputs(\n             model_config, structured_outputs_config, tokenizer\n         )\n@@ -878,6 +879,13 @@ def _validate_spec_decode(\n                 \"are not yet supported with speculative decoding.\"\n             )\n \n+    def _validate_stop(self, tokenizer: TokenizerLike | None) -> None:\n+        if tokenizer is None and self.stop:\n+            raise ValueError(\n+                \"Stop strings require a tokenizer so they can't be used \"\n+                \"with 'skip_tokenizer_init'\"\n+            )\n+\n     def _validate_structured_outputs(\n         self,\n         model_config: ModelConfig,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9d1fa7715007b81f038fd4c636ac94ffc831ccff/vllm%2Fsampling_params.py",
      "sha": "81ddf4f7fa0c2f76443bc4769de3deebc50412ed",
      "status": "modified"
    }
