      "deletions": 3,
      "filename": "tests/v1/determinism/test_batch_invariance_vlm.py",
      "patch": "@@ -9,7 +9,7 @@\n import pytest\n import torch\n from PIL import Image\n-from utils import _extract_step_logprobs, skip_if_not_cuda_alike\n+from utils import _extract_step_logprobs, skip_unsupported\n \n from vllm import LLM, SamplingParams\n from vllm.inputs import TextPrompt\n@@ -89,7 +89,7 @@ def _assert_batch_invariant(llm: LLM, inputs: list[TextPrompt], sampling) -> Non\n         )\n \n \n-@skip_if_not_cuda_alike\n+@skip_unsupported\n @pytest.mark.parametrize(\"input_type\", [\"image\", \"video\"])\n @pytest.mark.parametrize(\"mm_encoder_attn_backend\", [\"FLASH_ATTN\", \"TORCH_SDPA\"])\n def test_vlm_batch_invariance_bs1_vs_bsN(\n@@ -101,7 +101,7 @@ def test_vlm_batch_invariance_bs1_vs_bsN(\n     _run_vlm_batch_invariance(input_type, mm_encoder_attn_backend, enforce_eager=True)\n \n \n-@skip_if_not_cuda_alike\n+@skip_unsupported\n def test_vlm_batch_invariance_default_execution(monkeypatch: pytest.MonkeyPatch):\n     monkeypatch.setenv(\"VLLM_USE_FLASHINFER_SAMPLER\", \"0\")\n     _run_vlm_batch_invariance(\"image\", \"FLASH_ATTN\", enforce_eager=False)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/602986ecb8bc26197257069eb8f5418d9205254c/tests%2Fv1%2Fdeterminism%2Ftest_batch_invariance_vlm.py",
      "sha": "68159d5d9fb87f9998006ddcc15dcfb2216fedce",
      "status": "modified"
    },
    {
      "additions": 84,
      "blob_url": "https://github.com/vllm-project/vllm/blob/602986ecb8bc26197257069eb8f5418d9205254c/vllm%2Fmodel_executor%2Fdeterminism%2Fbatch_invariant.py",
      "changes": 84,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fdeterminism%2Fbatch_invariant.py?ref=602986ecb8bc26197257069eb8f5418d9205254c",
      "deletions": 0,
      "filename": "vllm/model_executor/determinism/batch_invariant.py",
      "patch": "@@ -1123,6 +1123,85 @@ def rms_norm_batch_invariant(\n     return output.reshape(original_shape)\n \n \n+@triton.jit\n+def _layer_norm_kernel(\n+    input_ptr,\n+    weight_ptr,\n+    bias_ptr,\n+    output_ptr,\n+    mean_ptr,\n+    rstd_ptr,\n+    n_cols,\n+    eps,\n+    BLOCK_SIZE: tl.constexpr,\n+    HAS_WEIGHT: tl.constexpr,\n+    HAS_BIAS: tl.constexpr,\n+):\n+    \"\"\"LayerNorm over the last dim of a contiguous 2D tensor, one program per\n+    row, fixed reduction order, so a row's result does not depend on how many\n+    rows are in the batch.\"\"\"\n+    row_idx = tl.program_id(0).to(tl.int64)\n+    row_ptr = input_ptr + row_idx * n_cols\n+    out_ptr = output_ptr + row_idx * n_cols\n+\n+    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n+    for col_offset in range(0, n_cols, BLOCK_SIZE):\n+        col_idx = col_offset + tl.arange(0, BLOCK_SIZE)\n+        mask = col_idx < n_cols\n+        acc += tl.load(row_ptr + col_idx, mask=mask, other=0.0).to(tl.float32)\n+    mean = tl.sum(acc, axis=0) / n_cols\n+\n+    acc = tl.zeros([BLOCK_SIZE], dtype=tl.float32)\n+    for col_offset in range(0, n_cols, BLOCK_SIZE):\n+        col_idx = col_offset + tl.arange(0, BLOCK_SIZE)\n+        mask = col_idx < n_cols\n+        x = tl.load(row_ptr + col_idx, mask=mask, other=0.0).to(tl.float32)\n+        d = tl.where(mask, x - mean, 0.0)\n+        acc += d * d\n+    rstd = 1.0 / tl.sqrt(tl.sum(acc, axis=0) / n_cols + eps)\n+    tl.store(mean_ptr + row_idx, mean)\n+    tl.store(rstd_ptr + row_idx, rstd)\n+\n+    for col_offset in range(0, n_cols, BLOCK_SIZE):\n+        col_idx = col_offset + tl.arange(0, BLOCK_SIZE)\n+        mask = col_idx < n_cols\n+        x = tl.load(row_ptr + col_idx, mask=mask, other=0.0)\n+        y = (x.to(tl.float32) - mean) * rstd\n+        if HAS_WEIGHT:\n+            y = y * tl.load(weight_ptr + col_idx, mask=mask, other=1.0).to(tl.float32)\n+        if HAS_BIAS:\n+            y = y + tl.load(bias_ptr + col_idx, mask=mask, other=0.0).to(tl.float32)\n+        tl.store(out_ptr + col_idx, y.to(x.dtype), mask=mask)\n+\n+\n+def native_layer_norm_batch_invariant(input, normalized_shape, weight, bias, eps):\n+    \"\"\"Batch-invariant replacement for ``aten::native_layer_norm``.\n+    Returns ``(output, mean, rstd)`` like the native op; mean/rstd are fp32.\"\"\"\n+    n_norm = len(normalized_shape)\n+    n_cols = math.prod(normalized_shape)\n+    x = input.contiguous().reshape(-1, n_cols)\n+    n_rows = x.shape[0]\n+    out = torch.empty_like(x)\n+    mean = torch.empty(n_rows, dtype=torch.float32, device=x.device)\n+    rstd = torch.empty(n_rows, dtype=torch.float32, device=x.device)\n+    if n_rows > 0:\n+        _layer_norm_kernel[(n_rows,)](\n+            x,\n+            weight.contiguous() if weight is not None else x,\n+            bias.contiguous() if bias is not None else x,\n+            out,\n+            mean,\n+            rstd,\n+            n_cols,\n+            eps,\n+            BLOCK_SIZE=1024,\n+            HAS_WEIGHT=weight is not None,\n+            HAS_BIAS=bias is not None,\n+        )\n+    stat_shape = tuple(input.shape[: input.dim() - n_norm]) + (1,) * n_norm\n+    return out.reshape(input.shape), mean.reshape(stat_shape), rstd.reshape(stat_shape)\n+\n+\n def linear_batch_invariant(input, weight, bias=None):\n     if bias is not None:\n         bias = bias.expand(weight.shape[0])\n@@ -1350,6 +1429,11 @@ def _triton_alloc_fn(size: int, alignment: int, stream: int | None):\n         _batch_invariant_LIB.impl(\"aten::addmm.out\", addmm_out_batch_invariant, key)\n         _batch_invariant_LIB.impl(\"aten::matmul\", matmul_batch_invariant, key)\n         _batch_invariant_LIB.impl(\"aten::linear\", linear_batch_invariant, key)\n+        # Native XPU layer_norm changes its reduction once a call has >= 256\n+        # rows (seen on torch 2.14), so a row's result depends on batch size.\n+        _batch_invariant_LIB.impl(\n+            \"aten::native_layer_norm\", native_layer_norm_batch_invariant, key\n+        )\n \n         _fp16_block_size_n = 128\n ",
