      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Fflashinfer.py?ref=c048561f4e65ee0526eeb0711e0714f1a8599b03",
      "deletions": 0,
      "filename": "vllm/v1/attention/backends/flashinfer.py",
      "patch": "@@ -1127,6 +1127,14 @@ def __init__(\n             max_num_reqs, dtype=torch.int32, device=self.device, pin_memory=False\n         )\n \n+    @property\n+    def supports_standalone_draft_prefill_as_decode(self) -> bool:\n+        return (\n+            not self.use_dcp\n+            and self.flashinfer_trtllm_api_decode_kernel is not None\n+            and (not self.attention_config.use_non_causal or self.use_xqa)\n+        )\n+\n     def _resolve_cache_dtype(self) -> str:\n         cache_dtype = self.cache_config.cache_dtype\n         if cache_dtype != \"auto\":",
