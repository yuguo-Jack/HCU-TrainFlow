      "blob_url": "https://github.com/vllm-project/vllm/blob/d35a346d6be4c92c8228c7f98702d249092dab40/tests%2Fentrypoints%2Fopenai%2Fchat_completion%2Ftest_serving_chat.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Fopenai%2Fchat_completion%2Ftest_serving_chat.py?ref=d35a346d6be4c92c8228c7f98702d249092dab40",
      "deletions": 1,
      "filename": "tests/entrypoints/openai/chat_completion/test_serving_chat.py",
      "patch": "@@ -579,6 +579,7 @@ class MockParallelConfig:\n class MockVllmConfig:\n     model_config: MockModelConfig\n     parallel_config: MockParallelConfig\n+    kv_transfer_config: object | None = None\n \n \n def _build_renderer(model_config: MockModelConfig):\n@@ -3088,7 +3089,11 @@ def test_make_request_with_harmony_rejects_invalid_kv_transfer_prompt_token_ids(\n @pytest.mark.parametrize(\"ids\", [[], [-1], [1.5], [1.0], [\"1\"], [True], \"abc\", 5])\n async def test_chat_kv_transfer_prompt_token_ids_rejects_invalid_ids(ids):\n     \"\"\"``kv_transfer_params`` is untyped, so the ids are checked on reuse.\"\"\"\n-    serving_chat = _build_serving_chat(_build_mock_engine())\n+    mock_engine = _build_mock_engine()\n+    # The reuse gate runs before the shape checks; a decode-side server has a\n+    # connector, so give the mock one to keep exercising the shape errors.\n+    mock_engine.renderer.config.kv_transfer_config = object()\n+    serving_chat = _build_serving_chat(mock_engine)\n \n     request = ChatCompletionRequest(\n         model=MODEL_NAME,\n@@ -3099,6 +3104,48 @@ async def test_chat_kv_transfer_prompt_token_ids_rejects_invalid_ids(ids):\n         await serving_chat.render_chat_request(request)\n \n \n+@pytest.mark.asyncio\n+async def test_chat_kv_transfer_prompt_token_ids_rejected_without_kv_connector():\n+    \"\"\"Without a KV connector the forwarded ids must not replace the prompt.\n+\n+    The reuse contract is disaggregated serving; on a plain server the ids\n+    would silently take over from the rendered messages (#62307).\n+    \"\"\"\n+    serving_chat = _build_serving_chat(_build_mock_engine())\n+\n+    request = ChatCompletionRequest(\n+        model=MODEL_NAME,\n+        messages=[{\"role\": \"user\", \"content\": \"hi\"}],\n+        kv_transfer_params={\"prompt_token_ids\": [10, 20, 30]},\n+    )\n+    with pytest.raises(VLLMValidationError, match=\"KV transfer connector\"):\n+        await serving_chat.render_chat_request(request)\n+\n+\n+@pytest.mark.asyncio\n+async def test_chat_kv_transfer_prompt_token_ids_reused_with_kv_connector():\n+    \"\"\"With a connector configured, well-formed ids skip templating and tokenization.\"\"\"\n+    mock_engine = _build_mock_engine()\n+    mock_engine.renderer.config.kv_transfer_config = object()\n+    serving_chat = _build_serving_chat(mock_engine)\n+\n+    request = ChatCompletionRequest(\n+        model=MODEL_NAME,\n+        messages=[{\"role\": \"user\", \"content\": \"hi\"}],\n+        kv_transfer_params={\n+            \"prompt_token_ids\": [10, 20, 30],\n+            \"do_remote_prefill\": True,\n+        },\n+    )\n+    result = await serving_chat.render_chat_request(request)\n+    assert not isinstance(result, ErrorResponse)\n+\n+    conversation, engine_inputs = result\n+    assert conversation == []\n+    assert engine_inputs[0][\"prompt_token_ids\"] == [10, 20, 30]\n+    assert request.kv_transfer_params == {\"do_remote_prefill\": True}\n+\n+\n @pytest.mark.asyncio\n @pytest.mark.parametrize(\n     (\"ids\", \"stream\", \"match\"),\n@@ -3112,6 +3159,7 @@ async def test_chat_kv_transfer_prompt_token_ids_rejection_notifies_kv_connector\n ):\n     \"\"\"A render-time 400 on a decode request notifies the KV connector.\"\"\"\n     mock_engine = _build_mock_engine()\n+    mock_engine.renderer.config.kv_transfer_config = object()\n     mock_engine.notify_kv_transfer_request_rejected = AsyncMock()\n     serving_chat = _build_serving_chat(mock_engine)\n     serving_chat.has_kv_connector = True",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d35a346d6be4c92c8228c7f98702d249092dab40/tests%2Fentrypoints%2Fopenai%2Fchat_completion%2Ftest_serving_chat.py",
      "sha": "f90354525e6eac414a198ef2c4de19e3ba2e32b1",
      "status": "modified"
    },
    {
      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d35a346d6be4c92c8228c7f98702d249092dab40/vllm%2Frenderers%2Fonline_renderer.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Frenderers%2Fonline_renderer.py?ref=d35a346d6be4c92c8228c7f98702d249092dab40",
      "deletions": 2,
      "filename": "vllm/renderers/online_renderer.py",
      "patch": "@@ -114,8 +114,8 @@ def _reused_prompt_token_ids(\n \n     Returns None without checking the ids when ``echo`` is set or ``messages``\n     has non-text content, since both need ``messages`` to be rendered.\n-    Otherwise raises VLLMValidationError if the ids are malformed or out of\n-    vocabulary.\n+    Otherwise raises VLLMValidationError if the server has no KV transfer\n+    connector, or if the ids are malformed or out of vocabulary.\n     \"\"\"\n     kv = getattr(request, \"kv_transfer_params\", None)\n     if not isinstance(kv, dict):\n@@ -135,6 +135,17 @@ def _reused_prompt_token_ids(\n             \"messages have non-text content and are rendered instead.\"\n         )\n         return None\n+    # The reuse contract is disaggregated serving, where the decode side runs\n+    # with a KV transfer connector. Without one the forwarded ids would\n+    # replace the rendered messages outright, skipping the chat template,\n+    # truncate_prompt_tokens, and tokenization on any client-supplied text.\n+    if getattr(renderer.config, \"kv_transfer_config\", None) is None:\n+        raise VLLMValidationError(\n+            \"`kv_transfer_params['prompt_token_ids']` is only honored when the \"\n+            \"server runs a KV transfer connector (`--kv-transfer-config`); \"\n+            \"without one the forwarded ids would replace the rendered prompt.\",\n+            parameter=\"kv_transfer_params.prompt_token_ids\",\n+        )\n     # bool is an int subclass, hence the exact type check.\n     if (\n         not isinstance(ids, list)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d35a346d6be4c92c8228c7f98702d249092dab40/vllm%2Frenderers%2Fonline_renderer.py",
      "sha": "61ff8353bbe7a740d4cbbaf8cb56011801bb7258",
      "status": "modified"
    }
