      "additions": 40,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c5fc4aa8821e5bd596d9ea62f87bde5eeaa83cc4/tests%2Fparser%2Fengine%2Ftest_plamo3.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fparser%2Fengine%2Ftest_plamo3.py?ref=c5fc4aa8821e5bd596d9ea62f87bde5eeaa83cc4",
      "deletions": 0,
      "filename": "tests/parser/engine/test_plamo3.py",
      "patch": "@@ -554,3 +554,43 @@ def test_delayed_text_keeps_split_markers_intact(parser_cls, mock_tokenizer, del\n     )\n     assert (result.reasoning, result.content) == (\"reasoning\", \"content\")\n     assert result.tool_calls == [{\"name\": \"weather\", \"arguments\": \"{}\"}]\n+\n+\n+def test_prompt_closed_reasoning_parses_output_as_content(\n+    parser_cls, mock_tokenizer, mock_request\n+):\n+    # The prompt already closed the think block (continue_final_message), so\n+    # the generated text must be content, not reasoning.\n+    parser = parser_cls(mock_tokenizer)\n+    parser.set_prompt_token_ids(mock_tokenizer.encode(END_THINK + \"prior answer\"))\n+\n+    output = \"generated content\"\n+    reasoning, content, _ = parser.parse(\n+        output,\n+        mock_request,\n+        model_output_token_ids=mock_tokenizer.encode(output),\n+    )\n+\n+    assert reasoning is None\n+    assert content == output\n+\n+\n+def test_earlier_turn_reasoning_end_keeps_current_turn_reasoning(\n+    parser_cls, mock_tokenizer, mock_request\n+):\n+    # A prior assistant turn closed reasoning and ended with EOT. The new turn\n+    # opens a fresh assistant message, so the output is reasoning.\n+    parser = parser_cls(mock_tokenizer)\n+    parser.set_prompt_token_ids(\n+        mock_tokenizer.encode(END_THINK + \"prior\" + EOT + \"user\" + EOT + \"assistant\")\n+    )\n+\n+    output = \"thinking now\"\n+    reasoning, content, _ = parser.parse(\n+        output,\n+        mock_request,\n+        model_output_token_ids=mock_tokenizer.encode(output),\n+    )\n+\n+    assert reasoning == output\n+    assert content is None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c5fc4aa8821e5bd596d9ea62f87bde5eeaa83cc4/tests%2Fparser%2Fengine%2Ftest_plamo3.py",
      "sha": "fc7f2b94830100e45b954d4f8254e7d495a3950c",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c5fc4aa8821e5bd596d9ea62f87bde5eeaa83cc4/vllm%2Fparser%2Fplamo3.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fparser%2Fplamo3.py?ref=c5fc4aa8821e5bd596d9ea62f87bde5eeaa83cc4",
      "deletions": 0,
      "filename": "vllm/parser/plamo3.py",
      "patch": "@@ -153,6 +153,7 @@ def plamo3_config(thinking: bool = True) -> ParserEngineConfig:\n         strip_trailing_reasoning_whitespace=False,\n         preserve_tokens=PLAMO_MARKER_TOKENS,\n         tool_args_json=True,\n+        turn_boundary_tokens=frozenset({EOT}),\n     )\n \n ",
