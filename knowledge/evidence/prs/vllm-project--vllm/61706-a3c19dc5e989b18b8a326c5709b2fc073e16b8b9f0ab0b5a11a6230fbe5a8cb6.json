      "additions": 128,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5c26d951b1e2fad745cd0cd17492a285c642d611/.buildkite%2Ftest-amd.yaml",
      "changes": 128,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Ftest-amd.yaml?ref=5c26d951b1e2fad745cd0cd17492a285c642d611",
      "deletions": 0,
      "filename": ".buildkite/test-amd.yaml",
      "patch": "@@ -3237,6 +3237,46 @@ steps:\n   - amd-smi\n   - VLLM_ROCM_USE_AITER=1 VLLM_ROCM_USE_AITER_CUSTOM_AR=1 pytest -v -s tests/compile/fusions_e2e/test_tp2_ar_rms.py -k 'test_tp2_ar_rms_fp8_fusions and qwen3 and ROCM_AITER_UNIFIED_ATTN and +quant_fp8 and (dynamo_partition or not +rms_norm)'\n \n+- label: \":amd: (MI355) Fusion E2E TP2 AR-RMS (Inductor Partition)\"\n+  timeout_in_minutes: 65\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n+  dind: false\n+  agent_pool: mi355_2\n+  num_gpus: 2\n+  optional: true\n+  working_dir: \"/vllm-workspace/\"\n+  source_file_dependencies:\n+  - vllm/compilation/\n+  - vllm/model_executor/layers\n+  - tests/compile/fusions_e2e/\n+  - vllm/_aiter_ops.py\n+  - vllm/platforms/rocm.py\n+  - csrc/quantization/\n+  - vllm/v1/attention/\n+  commands:\n+  - export VLLM_TEST_CLEAN_GPU_MEMORY=1\n+  - pytest -v -s tests/compile/fusions_e2e/test_tp2_ar_rms.py::test_tp2_ar_rms_fusions -k \"inductor_partition\"\n+\n+- label: \":amd: (MI355) Fusion E2E TP2 AR-RMS (Dynamo Partition)\"\n+  timeout_in_minutes: 65\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n+  dind: false\n+  agent_pool: mi355_2\n+  num_gpus: 2\n+  optional: true\n+  working_dir: \"/vllm-workspace/\"\n+  source_file_dependencies:\n+  - vllm/compilation/\n+  - vllm/model_executor/layers\n+  - tests/compile/fusions_e2e/\n+  - vllm/_aiter_ops.py\n+  - vllm/platforms/rocm.py\n+  - csrc/quantization/\n+  - vllm/v1/attention/\n+  commands:\n+  - export VLLM_TEST_CLEAN_GPU_MEMORY=1\n+  - pytest -v -s tests/compile/fusions_e2e/test_tp2_ar_rms.py::test_tp2_ar_rms_fusions -k \"dynamo_partition\"\n+\n - label: \":amd: (MI355) Fusion and Compile FP8\"\n   timeout_in_minutes: 45\n   mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n@@ -4322,6 +4362,51 @@ steps:\n   - export VLLM_WORKER_MULTIPROC_METHOD=spawn\n   - pytest -s -v evals/gsm8k/test_gsm8k_correctness.py --config-list-file=configs/models-gfx950-large.txt\n \n+- label: \":amd: (MI355) LM Eval Large Models Harness\"\n+  timeout_in_minutes: 85\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n+  dind: false\n+  agent_pool: mi355_8\n+  num_gpus: 8\n+  optional: true\n+  working_dir: \"/vllm-workspace/.buildkite/lm-eval-harness\"\n+  source_file_dependencies:\n+  - csrc/\n+  - vllm/model_executor/layers/quantization\n+  - vllm/model_executor/models/\n+  - vllm/model_executor/model_loader/\n+  - vllm/v1/attention/backends/\n+  - vllm/v1/attention/selector.py\n+  - vllm/_aiter_ops.py\n+  - vllm/platforms/rocm.py\n+  - .buildkite/lm-eval-harness/\n+  commands:\n+  - export VLLM_WORKER_MULTIPROC_METHOD=spawn\n+  - pytest -s -v test_lm_eval_correctness.py --config-list-file=configs/models-large.txt --tp-size=4\n+\n+- label: \":amd: (MI355) Qwen3-Next-80B-A3B-Instruct MTP Async EPLB Accuracy\"\n+  timeout_in_minutes: 45\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n+  dind: false\n+  agent_pool: mi355_4\n+  num_gpus: 4\n+  optional: true\n+  working_dir: \"/vllm-workspace\"\n+  source_file_dependencies:\n+  - vllm/model_executor/models/\n+  - vllm/model_executor/model_loader/\n+  - vllm/v1/spec_decode/\n+  - vllm/distributed/eplb\n+  - vllm/model_executor/layers/fused_moe/\n+  - vllm/model_executor/layers/quantization/\n+  - vllm/v1/attention/backends/\n+  - vllm/v1/attention/selector.py\n+  - .buildkite/scripts/scheduled_integration_test/\n+  - vllm/_aiter_ops.py\n+  - vllm/platforms/rocm.py\n+  commands:\n+  - VLLM_ENGINE_READY_TIMEOUT_S=1800 bash .buildkite/scripts/scheduled_integration_test/qwen3_next_mtp_async_eplb.sh 0.8 1319 8040\n+\n - label: \":amd: (MI355) LM Eval DeepSeek R1 TP\"\n   timeout_in_minutes: 65\n   mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n@@ -4826,6 +4911,23 @@ steps:\n   - amd-smi\n   - VLLM_ROCM_USE_AITER=1 VLLM_ROCM_USE_AITER_MOE=1 VLLM_ROCM_USE_AITER_FUSION_SHARED_EXPERTS=0 pytest -v -s kernels/moe/test_mori_moe.py\n \n+- label: \":amd: (MI355) DeepSeek-V4.1 Mono Decode Numerics\"\n+  timeout_in_minutes: 40\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n+  dind: false\n+  agent_pool: mi355_4\n+  num_gpus: 4\n+  optional: true\n+  working_dir: \"/vllm-workspace/\"\n+  source_file_dependencies:\n+  - docker/Dockerfile.rocm_base\n+  - vllm/models/deepseek_v41/amd/\n+  - tests/models/test_dsv41_mono_numerics.py\n+  - tests/models/test_dsv41_mono_layers.py\n+  commands:\n+  - pytest -v -s tests/models/test_dsv41_mono_numerics.py\n+  - pytest -v -s tests/models/test_dsv41_mono_layers.py\n+\n - label: \":amd: (MI355) Quantization Kernels Shard %N\"\n   timeout_in_minutes: 120\n   parallelism: 6\n@@ -4902,6 +5004,32 @@ steps:\n     - pytest -v -s kernels/moe/test_triton_moe_no_act_mul.py\n     - pytest -v -s kernels/moe/test_triton_moe_ptpc_fp8.py\n \n+- label: \":amd: (MI355 DPX) Native Quantization Kernels\"\n+  timeout_in_minutes: 40\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]\n+  dind: false\n+  agent_pool: mi355_dpx\n+  optional: true\n+  working_dir: \"/vllm-workspace/tests\"\n+  source_file_dependencies:\n+  - csrc/rocm/\n+  - vllm/model_executor/layers/quantization/\n+  - vllm/model_executor/kernels/linear/\n+  - vllm/_aiter_ops.py\n+  - vllm/_custom_ops.py\n+  - vllm/platforms/rocm.py\n+  - vllm/envs.py\n+  - tests/kernels/quantization/test_rocm_mxfp4.py\n+  - tests/kernels/quantization/test_rocm_mxfp8_linear.py\n+  - tests/kernels/quantization/test_rocm_skinny_gemms.py\n+  - tests/quantization/reference_mxfp4.py\n+  - tests/kernels/quant_utils.py\n+  - tests/kernels/utils.py\n+  commands:\n+  - pytest -v -s kernels/quantization/test_rocm_mxfp4.py\n+  - pytest -v -s kernels/quantization/test_rocm_mxfp8_linear.py\n+  - pytest -v -s kernels/quantization/test_rocm_skinny_gemms.py -k wvsplitkrc\n+\n - label: \":amd: (MI355) DeepEP FP8 MoE Kernels\" # TBD\n   timeout_in_minutes: 55\n   mirror_hardwares: [amdexperimental, amdproduction, amdgfx950nightly, amdmi355]",
