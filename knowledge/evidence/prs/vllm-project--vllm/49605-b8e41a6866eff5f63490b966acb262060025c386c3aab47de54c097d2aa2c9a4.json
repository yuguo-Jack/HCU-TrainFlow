      "blob_url": "https://github.com/vllm-project/vllm/blob/64f818893418635fe88d4767f14d1d607d63506d/tests%2Fv1%2Fengine%2Ftest_output_processor.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fengine%2Ftest_output_processor.py?ref=64f818893418635fe88d4767f14d1d607d63506d",
      "deletions": 0,
      "filename": "tests/v1/engine/test_output_processor.py",
      "patch": "@@ -21,6 +21,7 @@\n from vllm.outputs import CompletionOutput, RequestOutput\n from vllm.sampling_params import RequestOutputKind, SamplingParams\n from vllm.tokenizers import TokenizerLike\n+from vllm.tracing import SpanAttributes\n from vllm.v1.engine import (\n     EngineCoreEvent,\n     EngineCoreEventType,\n@@ -1135,6 +1136,45 @@ def test_iteration_stats(dummy_test_vectors):\n     assert iteration_stats.num_generation_tokens == num_active\n \n \n+def test_tracing_includes_zero_temperature(monkeypatch: pytest.MonkeyPatch):\n+    output_processor = OutputProcessor(None, log_stats=True)\n+    request_state = RequestState(\n+        request_id=\"request\",\n+        external_req_id=\"external-request\",\n+        parent_req=None,\n+        request_index=0,\n+        lora_request=None,\n+        output_kind=RequestOutputKind.FINAL_ONLY,\n+        prompt=None,\n+        prompt_token_ids=[1],\n+        prompt_embeds=None,\n+        logprobs_processor=None,\n+        detokenizer=None,\n+        max_tokens_param=None,\n+        temperature=0.0,\n+        arrival_time=1.0,\n+        queue=None,\n+        log_stats=True,\n+        stream_interval=1,\n+    )\n+    assert request_state.stats is not None\n+    iteration_stats = IterationStats()\n+    iteration_stats.iteration_timestamp = 5.0\n+    attributes = {}\n+    monkeypatch.setattr(\n+        \"vllm.v1.engine.output_processor.instrument_manual\",\n+        lambda **kwargs: attributes.update(kwargs[\"attributes\"]),\n+    )\n+\n+    output_processor.do_tracing(\n+        EngineCoreOutput(request_id=\"request\", new_token_ids=[]),\n+        request_state,\n+        iteration_stats,\n+    )\n+\n+    assert attributes[SpanAttributes.GEN_AI_REQUEST_TEMPERATURE] == 0.0\n+\n+\n @pytest.mark.parametrize(\"log_stats\", [True, False])\n def test_lora_request_tracking(log_stats: bool, dummy_test_vectors):\n     \"\"\"Test LoRA request lifecycle tracking through waiting -> running -> finished.\"\"\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/64f818893418635fe88d4767f14d1d607d63506d/tests%2Fv1%2Fengine%2Ftest_output_processor.py",
      "sha": "180ec1501846333fe2a33c1f57e1c3154aeace0d",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/64f818893418635fe88d4767f14d1d607d63506d/vllm%2Fv1%2Fengine%2Foutput_processor.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Foutput_processor.py?ref=64f818893418635fe88d4767f14d1d607d63506d",
      "deletions": 1,
      "filename": "vllm/v1/engine/output_processor.py",
      "patch": "@@ -838,7 +838,7 @@ def do_tracing(\n             attributes[SpanAttributes.GEN_AI_REQUEST_MAX_TOKENS] = (\n                 req_state.max_tokens_param\n             )\n-        if req_state.temperature:\n+        if req_state.temperature is not None:\n             attributes[SpanAttributes.GEN_AI_REQUEST_TEMPERATURE] = (\n                 req_state.temperature\n             )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/64f818893418635fe88d4767f14d1d607d63506d/vllm%2Fv1%2Fengine%2Foutput_processor.py",
