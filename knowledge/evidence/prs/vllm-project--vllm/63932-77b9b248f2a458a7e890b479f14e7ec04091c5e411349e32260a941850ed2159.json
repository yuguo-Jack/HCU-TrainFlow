      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmooncake%2Fstore%2Fconnector.py?ref=fdd78debf6b6b9dd5c277508efdb327ab7e0284e",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/mooncake/store/connector.py",
      "patch": "@@ -269,6 +269,8 @@ def request_finished_all_groups(\n         request: Request,\n         block_ids: tuple[list[int], ...],\n     ) -> tuple[bool, dict[str, Any] | None]:\n+        assert self.connector_scheduler is not None\n+        self.connector_scheduler.client.discard(request.request_id)\n         # An in-flight store job holds its own reference on the blocks it reads,\n         # so a finishing request never has to defer freeing them.\n         return False, None",
