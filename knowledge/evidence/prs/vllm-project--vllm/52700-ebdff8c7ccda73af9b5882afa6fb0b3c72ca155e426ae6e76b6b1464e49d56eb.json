      "raw_url": "https://github.com/vllm-project/vllm/raw/fef9c975e6b60621f7a3b9e972c7061657700c38/vllm%2Fv1%2Fkv_offload%2Fcpu%2Fshared_offload_region.py",
      "sha": "d2897e65a5172dc5bf033d1d2171461225638af7",
