    {
      "additions": 55,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d69ee40f49be80d52c1bc218725f0220406af970/tests%2Fkernels%2Fquantization%2Ftest_mxfp8_emulation_linear.py",
      "changes": 55,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fquantization%2Ftest_mxfp8_emulation_linear.py?ref=d69ee40f49be80d52c1bc218725f0220406af970",
      "deletions": 0,
      "filename": "tests/kernels/quantization/test_mxfp8_emulation_linear.py",
      "patch": "@@ -0,0 +1,55 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"MXFP8 emulation after load-time dequantization runs the platform GEMM (on\n+ROCm, the skinny wvSplitK/LLMM1 kernels at decode batch sizes).\"\"\"\n+\n+import pytest\n+import torch\n+\n+from vllm.model_executor.kernels.linear.mxfp8.emulation import (\n+    EmulationMxfp8LinearKernel,\n+)\n+from vllm.model_executor.kernels.linear.mxfp8.Mxfp8LinearKernel import (\n+    Mxfp8LinearLayerConfig,\n+)\n+from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (\n+    _mxfp8_e4m3_quantize_torch,\n+    dequant_mxfp8_to_bf16,\n+)\n+from vllm.platforms import current_platform\n+\n+# (N, K) of the DeepSeek-V4.1-Flash MXFP8 linears at TP=4.\n+V41_SHAPES = [\n+    (1792, 5120),\n+    (8192, 1280),\n+    (2048, 4096),\n+    (5120, 2048),\n+    (1152, 5120),\n+    (5120, 576),\n+]\n+\n+\n+@pytest.mark.skipif(not current_platform.is_cuda_alike(), reason=\"needs a GPU\")\n+@pytest.mark.parametrize(\"n,k\", V41_SHAPES)\n+@pytest.mark.parametrize(\"num_tokens\", [1, 2, 4, 7, 32, 256])\n+@torch.inference_mode()\n+def test_mxfp8_emulation_matches_bf16_linear(monkeypatch, n, k, num_tokens):\n+    \"\"\"Matches F.linear on the dequantized weight at the token counts that\n+    select different ROCm GEMM kernels.\"\"\"\n+    monkeypatch.setenv(\"VLLM_MXFP8_EMULATION_DEQUANT_AT_LOAD\", \"1\")\n+    torch.manual_seed(num_tokens)\n+    weight, scale = _mxfp8_e4m3_quantize_torch(\n+        torch.randn(n, k, device=\"cuda\", dtype=torch.bfloat16) * 0.05\n+    )\n+    expected_weight = dequant_mxfp8_to_bf16(weight, scale).float()\n+    layer = torch.nn.Module()\n+    layer.weight = torch.nn.Parameter(weight, requires_grad=False)\n+    layer.weight_scale = torch.nn.Parameter(scale, requires_grad=False)\n+    kernel = EmulationMxfp8LinearKernel(Mxfp8LinearLayerConfig(weight_shape=(n, k)))\n+    kernel.process_weights_after_loading(layer)\n+\n+    x = torch.randn(num_tokens, k, device=\"cuda\", dtype=torch.bfloat16)\n+    out = kernel.apply_weights(layer, x)\n+    expected = x.float() @ expected_weight.T\n+    rel = (out.float() - expected).norm() / expected.norm()\n+    assert out.dtype == x.dtype and rel < 5e-3, rel",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d69ee40f49be80d52c1bc218725f0220406af970/tests%2Fkernels%2Fquantization%2Ftest_mxfp8_emulation_linear.py",
      "sha": "280dc5d343dad7e0a9cb821a42af469a909042e8",
      "status": "added"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d69ee40f49be80d52c1bc218725f0220406af970/vllm%2Fmodel_executor%2Fkernels%2Flinear%2Fmxfp8%2Femulation.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fkernels%2Flinear%2Fmxfp8%2Femulation.py?ref=d69ee40f49be80d52c1bc218725f0220406af970",
      "deletions": 3,
      "filename": "vllm/model_executor/kernels/linear/mxfp8/emulation.py",
      "patch": "@@ -9,6 +9,7 @@\n     MXFP8_SCALE_DTYPE,\n     dequant_mxfp8_to_bf16,\n )\n+from vllm.model_executor.layers.utils import dispatch_unquantized_gemm\n \n from .Mxfp8LinearKernel import Mxfp8LinearKernel, Mxfp8LinearLayerConfig\n \n@@ -59,9 +60,8 @@ def apply_weights(\n         # Load-time dequant path: weights are already BF16/FP16 (>= 2-byte), so\n         # run a plain linear -- no per-step dequant. (MXFP8 weights are 1-byte.)\n         if weight.element_size() >= 2:\n-            # F.linear requires x and weight share a dtype; .to() is a no-op when\n-            # they already match (e.g. both BF16).\n-            output = torch.nn.functional.linear(x, weight.to(x.dtype), bias)\n+            # Use the platform GEMM, as an unquantized layer would.\n+            output = dispatch_unquantized_gemm()(layer, x, weight.to(x.dtype), bias)\n             return output.to(x.dtype)\n \n         # Fallback: weights still in MXFP8 -- dequant on the fly (other archs /",
