      "filename": "csrc/custom_all_reduce.cuh",
      "patch": "@@ -13,7 +13,11 @@ __global__ void __launch_bounds__(512, 1)\n   // note: we don't reorder the address so the accumulation order is the same\n   // for all ranks, ensuring bitwise identical results\n   auto dp = *_dp;\n+#if defined(USE_ROCM)\n+  barrier_at_start_release<ngpus>(sg, self_sg, rank);\n+#else\n   barrier_at_start<ngpus>(sg, self_sg, rank);\n+#endif\n   // do the actual reduction\n   for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < size;\n        idx += gridDim.x * blockDim.x) {\n@@ -48,7 +52,11 @@ __global__ void __launch_bounds__(512, 1)\n     tmps[i] = get_tmp_buf<P>(sg.signals[target]);\n   }\n   auto tmp_out = tmps[0];\n+#if defined(USE_ROCM)\n+  barrier_at_start_release<ngpus>(sg, self_sg, rank);\n+#else\n   barrier_at_start<ngpus>(sg, self_sg, rank);\n+#endif\n \n   // stage 1: reduce scatter\n   for (int idx = start + tid; idx < end; idx += stride) {",
      "raw_url": "https://github.com/vllm-project/vllm/raw/b42c797404260814eee903af91e8161f21bb273f/csrc%2Fcustom_all_reduce.cuh",
