      "additions": 29,
      "blob_url": "https://github.com/vllm-project/vllm/blob/6fd3d38e3b89e5b25e90c606ef312350f7418cea/tests%2Fv1%2Fattention%2Ftest_attention_splitting.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fattention%2Ftest_attention_splitting.py?ref=6fd3d38e3b89e5b25e90c606ef312350f7418cea",
      "deletions": 0,
      "filename": "tests/v1/attention/test_attention_splitting.py",
      "patch": "@@ -131,6 +131,35 @@ def test_make_metadata_with_slice_mixed_batch(mixed_small_metadata):\n     assert torch.equal(result.seq_lens, torch.tensor([40, 48]))\n \n \n+def test_make_metadata_with_slice_carries_positions(mixed_small_metadata):\n+    \"\"\"positions must be sliced alongside slot_mapping (DBO regression)\"\"\"\n+    mixed_small_metadata.positions = torch.arange(\n+        mixed_small_metadata.num_actual_tokens, dtype=torch.int64\n+    )\n+\n+    request_slice = slice(1, 3)\n+    token_slice = slice(1, 7)\n+    ubatch_slice = UBatchSlice(request_slice, token_slice)\n+\n+    result = _make_metadata_with_slice(ubatch_slice, mixed_small_metadata)\n+\n+    assert result.num_reqs == 2\n+    assert result.num_actual_tokens == 6\n+    assert result.max_query_len == 5\n+    assert torch.equal(result.query_start_loc, torch.tensor([0, 1, 6]))\n+    assert torch.equal(result.seq_lens, torch.tensor([40, 48]))\n+\n+    assert result.positions is not None\n+    assert torch.equal(result.positions, mixed_small_metadata.positions[token_slice])\n+    assert torch.equal(\n+        result.slot_mapping, mixed_small_metadata.slot_mapping[token_slice]\n+    )\n+    assert torch.equal(\n+        result.block_table_tensor,\n+        mixed_small_metadata.block_table_tensor[request_slice],\n+    )\n+\n+\n def test_split_attn_metadata_decode_batch(large_decode_metadata):\n     \"\"\"Test splitting decode batch into two equal parts\"\"\"\n     num_tokens = large_decode_metadata.num_reqs",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6fd3d38e3b89e5b25e90c606ef312350f7418cea/tests%2Fv1%2Fattention%2Ftest_attention_splitting.py",
      "sha": "94f3422afaebc2f9a11872e02f040c163e875404",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/6fd3d38e3b89e5b25e90c606ef312350f7418cea/vllm%2Fv1%2Fworker%2Fubatch_utils.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fubatch_utils.py?ref=6fd3d38e3b89e5b25e90c606ef312350f7418cea",
      "deletions": 0,
      "filename": "vllm/v1/worker/ubatch_utils.py",
      "patch": "@@ -231,6 +231,11 @@ def _make_metadata_with_slice(\n \n     block_table_tensor = attn_metadata.block_table_tensor[request_slice]\n     slot_mapping = attn_metadata.slot_mapping[token_slice]\n+    positions = (\n+        attn_metadata.positions[token_slice]\n+        if attn_metadata.positions is not None\n+        else None\n+    )\n \n     return CommonAttentionMetadata(\n         query_start_loc=query_start_loc,\n@@ -242,6 +247,7 @@ def _make_metadata_with_slice(\n         max_seq_len=max_seq_len,\n         block_table_tensor=block_table_tensor,\n         slot_mapping=slot_mapping,\n+        positions=positions,\n         seq_lens_cpu_upper_bound=seq_lens_cpu_upper_bound,\n         _seq_lens_cpu=seq_lens_cpu,\n         _num_computed_tokens_cpu=num_computed_tokens_cpu,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6fd3d38e3b89e5b25e90c606ef312350f7418cea/vllm%2Fv1%2Fworker%2Fubatch_utils.py",
      "sha": "a1ad498a4272d8aeb5bbd64d2fd6bb11038df47b",
