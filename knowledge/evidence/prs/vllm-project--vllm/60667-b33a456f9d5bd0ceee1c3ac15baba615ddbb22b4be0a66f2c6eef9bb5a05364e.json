    {
      "body": "error:\r\n`ModuleNotFoundError: No module named 'vllm.distributed.device_communicators.utils'` ",
      "created_at": "2026-10-09T09:12:06Z",
      "html_url": "https://github.com/vllm-project/vllm/pull/60667#issuecomment-6077964311",
      "id": 6077964311,
