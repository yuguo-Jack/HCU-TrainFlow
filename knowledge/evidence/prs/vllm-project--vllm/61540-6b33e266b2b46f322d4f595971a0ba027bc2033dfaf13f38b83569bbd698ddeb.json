      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmetrics.py?ref=8a885bb9b9f91a97b77148f73be1ed64598d76f1",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/metrics.py",
      "patch": "@@ -51,6 +51,18 @@ def is_empty(self) -> bool:\n \n \n class KVConnectorLogging:\n+    \"\"\"Periodically logs KV connector transfer metrics.\n+\n+    Pipeline: ``observe()`` -> ``aggregate()`` -> ``reduce()`` -> ``log()``.\n+\n+    ``observe()`` is called each time the connector syncs with the scheduler;\n+    the payload it receives is already aggregated across all workers, i.e. it\n+    consists of observations from every rank combined into one pool (see\n+    ``KVConnectorStats.aggregate``). Successive payloads are accumulated via\n+    ``aggregate()`` until ``log()`` calls ``reduce()`` to summarize the\n+    interval and then resets the accumulator.\n+    \"\"\"\n+\n     def __init__(self, kv_transfer_config: KVTransferConfig | None):\n         # Instantiate the connector's stats class.\n         if kv_transfer_config and kv_transfer_config.kv_connector:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8a885bb9b9f91a97b77148f73be1ed64598d76f1/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmetrics.py",
      "sha": "f05bde07acd531222e8353d3af80b4e885ec1a35",
      "status": "modified"
    },
    {
      "additions": 26,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8a885bb9b9f91a97b77148f73be1ed64598d76f1/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fstats.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fstats.py?ref=8a885bb9b9f91a97b77148f73be1ed64598d76f1",
      "deletions": 1,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/nixl/stats.py",
      "patch": "@@ -23,7 +23,24 @@\n \n @dataclass\n class NixlKVConnectorStats(KVConnectorStats):\n-    \"\"\"Container for transfer performance metrics.\"\"\"\n+    \"\"\"Container for transfer performance metrics.\n+\n+    Each TP rank records its own per-transfer telemetry via\n+    :meth:`record_transfer`. Before summary statistics are computed, stats from\n+    all ranks are concatenated by :meth:`aggregate` (``list.extend``), so every\n+    metric reported by :meth:`reduce` is computed over the combined pool of\n+    observations from all ranks:\n+\n+    - \"Num successful transfers\" is the total count across all ranks, not\n+      per-rank.\n+    - \"Avg MB per transfer\" is the average over all individual rank-level\n+      transfers, not the total bytes moved by one KV cache transfer operation.\n+    - \"Throughput (MB/s)\" is total MB over total time across all ranks --\n+      effectively an average per-rank throughput, not aggregate system\n+      throughput.\n+    - Percentiles (P90) are computed over the combined distribution of all\n+      ranks' transfer times.\n+    \"\"\"\n \n     def __post_init__(self):\n         if not self.data:\n@@ -90,6 +107,9 @@ def is_empty(self) -> bool:\n         )\n \n     def aggregate(self, other: KVConnectorStats) -> KVConnectorStats:\n+        # Concatenate the other rank's observations into this pool\n+        # (list.extend). Stats from all TP ranks end up in a single combined\n+        # pool before reduce() computes summary statistics over it.\n         if not other.is_empty():\n             for k, v in other.data.items():\n                 accumulator = self.data[k]\n@@ -99,6 +119,11 @@ def aggregate(self, other: KVConnectorStats) -> KVConnectorStats:\n \n     def reduce(self) -> dict[str, int | float]:\n         # Compute compact representative stats suitable for CLI logging.\n+        # NOTE on multi-rank semantics: aggregate() has concatenated the\n+        # per-rank observations into one combined pool by now, so the\n+        # averages/percentiles below are computed over all ranks' observations.\n+        # \"Throughput (MB/s)\" is total_MB_all_ranks / total_time_all_ranks --\n+        # an average per-rank throughput, not the aggregate system throughput.\n         # Failure counts are reported on every interval: transfer, handshake\n         # and notification failures are grouped as sporadic\n         # lower-transport-layer events, while KV expiry is reported separately",
