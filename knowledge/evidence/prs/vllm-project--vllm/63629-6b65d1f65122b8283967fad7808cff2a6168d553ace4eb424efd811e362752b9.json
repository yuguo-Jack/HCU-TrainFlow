      "deletions": 0,
      "filename": "tests/models/multimodal/processing/test_moss_audio.py",
      "patch": "@@ -594,6 +594,29 @@ def make_model(num_layers, deepstack_layers=None):\n     assert set(forward_tensors.tensors) == set(tensors.tensors)\n \n \n+@pytest.mark.parametrize(\"device\", [\"cpu\", \"meta\"])\n+@pytest.mark.parametrize((\"num_mel_bins\", \"conv_freq\"), [(128, 16), (129, 17)])\n+def test_moss_audio_encoder_initialization(\n+    dist_init: None, device: str, num_mel_bins: int, conv_freq: int\n+) -> None:\n+    \"\"\"Encoder construction preserves projection shapes, including on meta.\"\"\"\n+    config = MossAudioEncoderConfig(\n+        d_model=8,\n+        output_dim=8,\n+        num_mel_bins=num_mel_bins,\n+        encoder_layers=1,\n+        encoder_attention_heads=2,\n+        encoder_ffn_dim=16,\n+        downsample_hidden_size=2,\n+        deepstack_encoder_layer_indexes=[],\n+    )\n+    with torch.device(device):\n+        encoder = MossAudioEncoder(config)\n+\n+    assert encoder.stem_proj.weight.shape == (8, 2 * conv_freq)\n+    assert all(param.device.type == device for param in encoder.parameters())\n+\n+\n def test_moss_audio_encoder_loads_realistic_attention_weight_names(monkeypatch):\n     from vllm.config import VllmConfig, set_current_vllm_config\n     from vllm.config.device import DeviceConfig",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1e6e0d45cb0aa9e92b11a74ac0daa712d47254ea/tests%2Fmodels%2Fmultimodal%2Fprocessing%2Ftest_moss_audio.py",
      "sha": "294d53f23895166f2b73b38ff926eecbc7e7fb1f",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1e6e0d45cb0aa9e92b11a74ac0daa712d47254ea/vllm%2Fmodel_executor%2Fmodels%2Fmoss_audio.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fmoss_audio.py?ref=1e6e0d45cb0aa9e92b11a74ac0daa712d47254ea",
      "deletions": 3,
      "filename": "vllm/model_executor/models/moss_audio.py",
      "patch": "@@ -504,9 +504,11 @@ def __init__(\n             padding=(1, 1),\n         )\n \n-        conv_freq = self._compute_downsampled_length(\n-            torch.tensor(config.num_mel_bins)\n-        ).item()\n+        # Use integer arithmetic because meta tensors do not support .item().\n+\n+        # Three convolutions with kernel=3, stride=2, padding=1 each yield\n+        # ceil(n / 2); together they yield ceil(n / 8) = (n + 7) // 8.\n+        conv_freq = (config.num_mel_bins + 7) // 8\n         self.stem_proj = ReplicatedLinear(\n             config.downsample_hidden_size * int(conv_freq),\n             config.d_model,",
