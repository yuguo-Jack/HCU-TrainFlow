      "additions": 56,
      "blob_url": "https://github.com/vllm-project/vllm/blob/346148dc61653b17a2be5d370081e92b14136332/tests%2Futils_%2Ftest_async_utils.py",
      "changes": 57,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Futils_%2Ftest_async_utils.py?ref=346148dc61653b17a2be5d370081e92b14136332",
      "deletions": 1,
      "filename": "tests/utils_/test_async_utils.py",
      "patch": "@@ -2,10 +2,13 @@\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n import asyncio\n from collections.abc import AsyncIterator\n+from concurrent.futures import ThreadPoolExecutor\n+from threading import Event\n+from unittest.mock import patch\n \n import pytest\n \n-from vllm.utils.async_utils import merge_async_iterators\n+from vllm.utils.async_utils import make_async_with_semaphore, merge_async_iterators\n \n \n async def _mock_async_iterator(idx: int):\n@@ -62,3 +65,55 @@ async def gen():\n     assert await anext(merged) == (0, \"x\")\n     await merged.aclose()\n     assert closed\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\"worker_error\", [False, True])\n+async def test_cancelled_worker_keeps_capacity_until_completion(worker_error):\n+    started = asyncio.Event()\n+    release = Event()\n+    loop = asyncio.get_running_loop()\n+\n+    def work() -> int:\n+        loop.call_soon_threadsafe(started.set)\n+        assert release.wait(5)\n+        if worker_error:\n+            raise ValueError(\"worker failed\")\n+        return 42\n+\n+    with ThreadPoolExecutor(max_workers=1) as executor:\n+        run = make_async_with_semaphore(work, executor)\n+        with patch.object(executor, \"submit\", wraps=executor.submit) as submit:\n+            task: asyncio.Task[int] = asyncio.create_task(run())\n+            try:\n+                await asyncio.wait_for(started.wait(), 5)\n+                task.cancel()\n+                with pytest.raises(asyncio.CancelledError):\n+                    await task\n+                for _ in range(10):\n+                    waiter: asyncio.Task[int] = asyncio.create_task(run())\n+                    await asyncio.sleep(0)\n+                    waiter.cancel()\n+                    with pytest.raises(asyncio.CancelledError):\n+                        await waiter\n+                assert submit.call_count == 1\n+            finally:\n+                release.set()\n+\n+            if worker_error:\n+                with pytest.raises(ValueError, match=\"worker failed\"):\n+                    await asyncio.wait_for(run(), 5)\n+            else:\n+                assert await asyncio.wait_for(run(), 5) == 42\n+\n+\n+@pytest.mark.asyncio\n+async def test_submission_failure_releases_capacity():\n+    with ThreadPoolExecutor(max_workers=1) as executor:\n+        run = make_async_with_semaphore(lambda: 42, executor)\n+        with (\n+            patch.object(executor, \"submit\", side_effect=RuntimeError(\"rejected\")),\n+            pytest.raises(RuntimeError, match=\"rejected\"),\n+        ):\n+            await run()\n+        assert await asyncio.wait_for(run(), 5) == 42",
      "raw_url": "https://github.com/vllm-project/vllm/raw/346148dc61653b17a2be5d370081e92b14136332/tests%2Futils_%2Ftest_async_utils.py",
      "sha": "2653555cb84c0ce0b0a26ee6d3e87a3a36fbee88",
