    {
      "additions": 15,
      "blob_url": "https://github.com/vllm-project/vllm/blob/346148dc61653b17a2be5d370081e92b14136332/vllm%2Futils%2Fasync_utils.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Futils%2Fasync_utils.py?ref=346148dc61653b17a2be5d370081e92b14136332",
      "deletions": 2,
      "filename": "vllm/utils/async_utils.py",
      "patch": "@@ -61,8 +61,21 @@ def make_async_with_semaphore(\n     async def _async_wrapper(*args: P.args, **kwargs: P.kwargs) -> T:\n         loop = asyncio.get_event_loop()\n         p_func = partial(func, *args, **kwargs)\n-        async with semaphore:\n-            return await loop.run_in_executor(executor, p_func)\n+        await semaphore.acquire()\n+        try:\n+            future = loop.run_in_executor(executor, p_func)\n+        except BaseException:\n+            semaphore.release()\n+            raise\n+\n+        def on_done(future: Future[T]) -> None:\n+            semaphore.release()\n+            # The caller may have been cancelled while the worker kept running.\n+            if not future.cancelled():\n+                future.exception()\n+\n+        future.add_done_callback(on_done)\n+        return await asyncio.shield(future)\n \n     return _async_wrapper\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/346148dc61653b17a2be5d370081e92b14136332/vllm%2Futils%2Fasync_utils.py",
