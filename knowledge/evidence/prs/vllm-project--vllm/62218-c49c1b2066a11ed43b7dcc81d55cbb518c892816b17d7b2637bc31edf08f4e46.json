  "files": [
    {
      "additions": 63,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1e1840de393cfb2f4335be7cf9b2082172cc3a3c/tests%2Frenderers%2Ftest_empty_conversation.py",
      "changes": 63,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Frenderers%2Ftest_empty_conversation.py?ref=1e1840de393cfb2f4335be7cf9b2082172cc3a3c",
      "deletions": 0,
      "filename": "tests/renderers/test_empty_conversation.py",
      "patch": "@@ -0,0 +1,63 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"An empty conversation must be rejected whatever the renderer.\n+\n+The HF tokenizer refuses one inside ``apply_chat_template``, but renderers with\n+their own chat encoding (e.g. DeepSeek V3.2/V4/V4.1) render it to a bare BOS\n+prompt, from which the model generates unrelated text.\n+\"\"\"\n+\n+import pytest\n+\n+from vllm.exceptions import VLLMValidationError\n+from vllm.renderers.base import BaseRenderer\n+from vllm.renderers.params import ChatParams, TokenizeParams\n+\n+\n+class _Rendered(Exception):\n+    \"\"\"Raised by the stub once a conversation reaches ``render_messages``.\"\"\"\n+\n+\n+def _renderer() -> BaseRenderer:\n+    class _StubRenderer(BaseRenderer):\n+        def __init__(self):\n+            self.tokenizer = None\n+\n+        def render_messages(self, messages, params):\n+            raise _Rendered\n+\n+    return _StubRenderer()\n+\n+\n+def _render(renderer, conversations):\n+    return renderer.render_chat(\n+        conversations, ChatParams(), TokenizeParams(max_total_tokens=4096)\n+    )\n+\n+\n+@pytest.mark.parametrize(\n+    \"conversations\",\n+    [[[]], [[{\"role\": \"user\", \"content\": \"hi\"}], []]],\n+    ids=[\"only\", \"one_of_two\"],\n+)\n+def test_render_chat_rejects_an_empty_conversation(conversations):\n+    with pytest.raises(VLLMValidationError, match=\"empty conversation\"):\n+        _render(_renderer(), conversations)\n+\n+\n+@pytest.mark.asyncio\n+async def test_render_chat_async_rejects_an_empty_conversation():\n+    with pytest.raises(VLLMValidationError, match=\"empty conversation\"):\n+        await _renderer().render_chat_async(\n+            [[]], ChatParams(), TokenizeParams(max_total_tokens=4096)\n+        )\n+\n+\n+@pytest.mark.parametrize(\n+    \"conversation\",\n+    [[{\"role\": \"user\", \"content\": \"hi\"}], [{\"role\": \"system\", \"content\": \"Be brief.\"}]],\n+    ids=[\"user\", \"system_only\"],\n+)\n+def test_render_chat_renders_a_non_empty_conversation(conversation):\n+    with pytest.raises(_Rendered):\n+        _render(_renderer(), [conversation])",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1e1840de393cfb2f4335be7cf9b2082172cc3a3c/tests%2Frenderers%2Ftest_empty_conversation.py",
      "sha": "e03841abeaaecb9acf933f0a73317f17b9e48848",
      "status": "added"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1e1840de393cfb2f4335be7cf9b2082172cc3a3c/vllm%2Frenderers%2Fbase.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Frenderers%2Fbase.py?ref=1e1840de393cfb2f4335be7cf9b2082172cc3a3c",
      "deletions": 0,
      "filename": "vllm/renderers/base.py",
      "patch": "@@ -1292,6 +1292,19 @@ async def render_cmpl_async(\n             )\n         )\n \n+    @staticmethod\n+    def _check_conversations_not_empty(\n+        conversations: Sequence[list[\"ChatCompletionMessageParam\"]],\n+    ) -> None:\n+        # the HF tokenizer refuses an empty conversation in apply_chat_template,\n+        # but renderers with their own chat encoding render it to a bare BOS\n+        # prompt. Refuse it here so every renderer answers the same way.\n+        if any(not conversation for conversation in conversations):\n+            raise VLLMValidationError(\n+                \"Cannot apply chat template to an empty conversation. \"\n+                \"Provide at least one message.\"\n+            )\n+\n     def render_chat(\n         self,\n         conversations: Sequence[list[\"ChatCompletionMessageParam\"]],\n@@ -1301,6 +1314,7 @@ def render_chat(\n         prompt_extras: dict[str, Any] | None = None,\n         skip_mm_cache: bool = False,\n     ):\n+        self._check_conversations_not_empty(conversations)\n         arrival_time = time.time()\n \n         if tok_params is None:\n@@ -1341,6 +1355,7 @@ async def render_chat_async(\n         prompt_extras: dict[str, Any] | None = None,\n         skip_mm_cache: bool = False,\n     ):\n+        self._check_conversations_not_empty(conversations)\n         arrival_time = time.time()\n \n         if tok_params is None:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1e1840de393cfb2f4335be7cf9b2082172cc3a3c/vllm%2Frenderers%2Fbase.py",
      "sha": "8915fd6f8c5c6c4724ade2128ca85b8dfb8af527",
