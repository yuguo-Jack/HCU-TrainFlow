      "additions": 9,
      "blob_url": "https://github.com/vllm-project/vllm/blob/085a06f930f1f05a5c5bc49c67e832c12aa7b007/vllm%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Fdata%2Fnixl.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Fdata%2Fnixl.py?ref=085a06f930f1f05a5c5bc49c67e832c12aa7b007",
      "deletions": 6,
      "filename": "vllm/v1/kv_offload/tiering/p2p/data/nixl.py",
      "patch": "@@ -1,5 +1,4 @@\n-# SPDX-License-Identifier: Apache-2.0\n-# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n \"\"\"\n NixlTransport: Data-plane transport for RDMA-based KV block transfers via NIXL.\n \"\"\"\n@@ -209,13 +208,17 @@ def poll(self, peer_id: str | None = None) -> PollResult:\n                 continue\n             try:\n                 state = self._agent.check_xfer_state(entry.handle)\n-            except Exception as exc:\n+            except Exception:\n                 logger.warning(\n-                    \"NixlTransport %s: check_xfer_state failed for transfer_id=%d: %s\",\n+                    \"NixlTransport %s: check_xfer_state failed for \"\n+                    \"transfer_id=%d, marking as failed\",\n                     self._agent_name,\n                     transfer_id,\n-                    exc,\n+                    exc_info=True,\n                 )\n+                if failed_ids is None:\n+                    failed_ids = []\n+                failed_ids.append(transfer_id)\n                 continue\n             if state == \"DONE\":\n                 if done_ids is None:\n@@ -315,4 +318,4 @@ def _release_handles(self, handles: list[object]) -> None:\n                     \"NixlTransport %s: release_xfer_handle failed: %s\",\n                     self._agent_name,\n                     exc,\n-                )\n+                )\n\\ No newline at end of file",
      "raw_url": "https://github.com/vllm-project/vllm/raw/085a06f930f1f05a5c5bc49c67e832c12aa7b007/vllm%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Fdata%2Fnixl.py",
      "sha": "520e30e21657c4003d8e082a506d820b94db42eb",
