  "files": [
    {
      "additions": 26,
      "blob_url": "https://github.com/vllm-project/vllm/blob/413530019302fff4dfd2fe5bbdf08555977033be/tests%2Ftool_use%2Ftest_muse_glimmer.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_use%2Ftest_muse_glimmer.py?ref=413530019302fff4dfd2fe5bbdf08555977033be",
      "deletions": 0,
      "filename": "tests/tool_use/test_muse_glimmer.py",
      "patch": "@@ -168,6 +168,32 @@ def test_json_object_array_and_bool_params_decode():\n     }\n \n \n+@pytest.mark.parametrize(\"token\", [\"1e999\", \"Infinity\", \"-Infinity\", \"NaN\", \"[1e999]\"])\n+def test_non_finite_tool_args_are_kept_as_valid_json_strings(token):\n+    \"\"\"Non-finite numbers must not be emitted as bare NaN/Infinity tokens.\n+\n+    ``json.loads`` accepts them, but they are not valid JSON (RFC 8259), so a\n+    strict client cannot parse ``arguments``. The value is kept as its raw\n+    string, including when it is nested inside an array.\n+    \"\"\"\n+    raw = (\n+        \"<|start|>assistant to=api.call<|message|>\"\n+        '<atem:function_calls>\\n<atem:invoke name=\"api.call\">\\n'\n+        f'<atem:parameter name=\"value\">{token}</atem:parameter>\\n'\n+        \"</atem:invoke>\\n</atem:function_calls><|eot|>\"\n+    )\n+    out = MuseGlimmerToolParser.extract_tool_calls(T, raw, _NO_REQ)\n+    arguments = out.tool_calls[0].function.arguments\n+\n+    # A parser that rejects NaN/Infinity constants must still parse the whole\n+    # arguments, proving no bare non-finite token is emitted; the value is kept\n+    # verbatim as a string (the parametrized array case is nested).\n+    def _reject_constants(value):\n+        raise ValueError(value)\n+\n+    assert json.loads(arguments, parse_constant=_reject_constants) == {\"value\": token}\n+\n+\n # ------------------------------------------------- reasoning -> tool handoff\n \n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/413530019302fff4dfd2fe5bbdf08555977033be/tests%2Ftool_use%2Ftest_muse_glimmer.py",
      "sha": "b220c0c389756d72e80cdf33096002caf5a514ff",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/vllm-project/vllm/blob/413530019302fff4dfd2fe5bbdf08555977033be/vllm%2Ftool_parsers%2Fmuse_tool_parser.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fmuse_tool_parser.py?ref=413530019302fff4dfd2fe5bbdf08555977033be",
      "deletions": 1,
      "filename": "vllm/tool_parsers/muse_tool_parser.py",
      "patch": "@@ -103,11 +103,24 @@ def _decode_value(raw: str):\n     \"\"\"JSON-decode a parameter value when possible, else keep the raw string.\n \n     Mirrors the schema's ``x-parser: json`` with ``allow_non_json: True``.\n+\n+    Values that decode to a non-finite float are kept as the raw string.\n+    ``json.loads`` accepts ``NaN``/``Infinity``/``-Infinity`` and overflows a\n+    large exponent such as ``1e999`` to ``inf``, but ``json.dumps`` renders\n+    those back as bare ``NaN``/``Infinity`` tokens, which are not valid JSON\n+    (RFC 8259). Emitting them would put an unparseable ``arguments`` string on\n+    the wire for any strict client. ``allow_nan=False`` also rejects a non-finite\n+    float nested inside a decoded list or dict (e.g. ``[1e999]``).\n     \"\"\"\n     try:\n-        return json.loads(raw)\n+        parsed = json.loads(raw)\n     except (json.JSONDecodeError, ValueError):\n         return raw\n+    try:\n+        json.dumps(parsed, allow_nan=False)\n+    except (ValueError, TypeError):\n+        return raw\n+    return parsed\n \n \n def _iter_messages(text: str) -> Iterator[tuple[str | None, str, bool]]:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/413530019302fff4dfd2fe5bbdf08555977033be/vllm%2Ftool_parsers%2Fmuse_tool_parser.py",
      "sha": "34bb6b72f651bb64dc6139106a9dd7ea7c720bd6",
      "status": "modified"
    }
