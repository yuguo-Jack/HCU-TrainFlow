  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/32179214e6b50d2e4aa594f6cd9e4ba57371b0e6/docker%2FDockerfile",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile?ref=32179214e6b50d2e4aa594f6cd9e4ba57371b0e6",
      "deletions": 0,
      "filename": "docker/Dockerfile",
      "patch": "@@ -1313,6 +1313,12 @@ RUN --mount=type=cache,target=/opt/uv/cache \\\n     fi\n \n ENV VLLM_USAGE_SOURCE production-docker-image\n+# The CUDA base image only requests the `compute,utility` driver\n+# capabilities. The NVDEC video decoder (`VLLM_VIDEO_LOADER_BACKEND=\n+# pynvvideocodec`, PyNvVideoCodec is installed below) also needs the\n+# driver's video libraries (libnvcuvid, libnvidia-encode), which the\n+# NVIDIA container runtime mounts only for the `video` capability.\n+ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video\n ENV VLLM_BUILD_COMMIT=${VLLM_BUILD_COMMIT:-unknown} \\\n     VLLM_BUILD_PIPELINE=${VLLM_BUILD_PIPELINE:-local} \\\n     VLLM_BUILD_URL=${VLLM_BUILD_URL:-} \\",
      "raw_url": "https://github.com/vllm-project/vllm/raw/32179214e6b50d2e4aa594f6cd9e4ba57371b0e6/docker%2FDockerfile",
      "sha": "d8bf624772839d7a7c1648f91fc8a788b2bf078e",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/32179214e6b50d2e4aa594f6cd9e4ba57371b0e6/docs%2Ffeatures%2Fmultimodal_inputs.md",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Ffeatures%2Fmultimodal_inputs.md?ref=32179214e6b50d2e4aa594f6cd9e4ba57371b0e6",
      "deletions": 0,
      "filename": "docs/features/multimodal_inputs.md",
      "patch": "@@ -937,6 +937,17 @@ decoders.\n     process while model serving runs in the engine process, so multiple CUDA\n     processes share the same GPU. Configure and start MPS before starting vLLM.\n \n+!!! note\n+    NVDEC needs the driver's video libraries (`libnvcuvid`, `libnvidia-encode`).\n+    The NVIDIA container runtime mounts them only when the `video` driver\n+    capability is requested; the official `vllm/vllm-openai` image sets\n+    `NVIDIA_DRIVER_CAPABILITIES=compute,utility,video` for this reason. When you\n+    build your own image from a CUDA base image (which requests only\n+    `compute,utility`), set that variable in the image or pass\n+    `-e NVIDIA_DRIVER_CAPABILITIES=compute,utility,video` to `docker run`;\n+    otherwise decoder creation fails with\n+    `Failed to load NVENC library: libnvidia-encode.so.1`.\n+\n You must also set a positive `--mm-ipc-gpu-memory-gb` value to reserve VRAM for\n video decoding. vLLM carves this budget out of the memory available to the KV\n cache and uses it to bound concurrent frontend decode allocations. If the",
      "raw_url": "https://github.com/vllm-project/vllm/raw/32179214e6b50d2e4aa594f6cd9e4ba57371b0e6/docs%2Ffeatures%2Fmultimodal_inputs.md",
      "sha": "d9c599459e8d610bed844cddd57dc66c95b93a72",
      "status": "modified"
    }
  ],
