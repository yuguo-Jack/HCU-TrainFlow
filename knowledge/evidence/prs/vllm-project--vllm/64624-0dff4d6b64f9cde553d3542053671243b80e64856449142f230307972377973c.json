  "files": [
    {
      "additions": 30,
      "blob_url": "https://github.com/vllm-project/vllm/blob/760bb2165afcfd5e49645c7067ed55a29090d67a/tests%2Fv1%2Fworker%2Ftest_gpu_model_runner.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fworker%2Ftest_gpu_model_runner.py?ref=760bb2165afcfd5e49645c7067ed55a29090d67a",
      "deletions": 0,
      "filename": "tests/v1/worker/test_gpu_model_runner.py",
      "patch": "@@ -493,6 +493,36 @@ def test_preferred_block_size_rejects_backends_with_no_common_size():\n         Platform._preferred_block_size_for_backends(classes, 16, None)\n \n \n+@pytest.mark.parametrize(\n+    (\"prefix_match_unit\", \"expected_block_size\"),\n+    [(None, 400), (80, 400), (256, 512)],\n+)\n+def test_hybrid_block_size_rounds_up_to_prefix_match_unit(\n+    prefix_match_unit, expected_block_size\n+):\n+    \"\"\"The block size derived from the mamba state (400 tokens for this model)\n+    is rounded up to a multiple of prefix_match_unit instead of being rejected\n+    later by the KV cache manager.\"\"\"\n+    from vllm.v1.attention.backends.flash_attn import FlashAttentionBackend\n+\n+    vllm_config = VllmConfig(\n+        model_config=ModelConfig(\n+            model=\"ibm-granite/granite-4.0-tiny-preview\", dtype=\"bfloat16\"\n+        ),\n+        cache_config=CacheConfig(\n+            block_size=16,\n+            enable_prefix_caching=True,\n+            prefix_match_unit=prefix_match_unit,\n+        ),\n+    )\n+\n+    Platform._align_hybrid_block_size(vllm_config, FlashAttentionBackend)\n+\n+    cache_config = vllm_config.cache_config\n+    assert cache_config.block_size == expected_block_size\n+    assert cache_config.mamba_block_size == expected_block_size\n+\n+\n @pytest.mark.parametrize(\"cpu\", [False, True])\n def test_alignment_rejected_by_a_sibling_backend_raises(monkeypatch, cpu):\n     # Alignment that lands on a size an exact-size sibling rejects must fail",
      "raw_url": "https://github.com/vllm-project/vllm/raw/760bb2165afcfd5e49645c7067ed55a29090d67a/tests%2Fv1%2Fworker%2Ftest_gpu_model_runner.py",
      "sha": "f937c691d399a63b406d79c65822a72d52de35c2",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/760bb2165afcfd5e49645c7067ed55a29090d67a/vllm%2Fconfig%2Fcache.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fconfig%2Fcache.py?ref=760bb2165afcfd5e49645c7067ed55a29090d67a",
      "deletions": 1,
      "filename": "vllm/config/cache.py",
      "patch": "@@ -208,7 +208,8 @@ class CacheConfig:\n     1024-token hybrid-model block) as long as every KV cache group's\n     `block_size` is divisible by it, enabling cache hits at boundaries\n     inside a physical block. It controls matching granularity only, not how\n-    often states are stored.\n+    often states are stored. For hybrid attention/mamba models, the block size\n+    derived from the mamba state is rounded up to a multiple of it.\n \n     This equals to the `hash_block_size` used throughout the KV cache code.\n     \"\"\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/760bb2165afcfd5e49645c7067ed55a29090d67a/vllm%2Fconfig%2Fcache.py",
      "sha": "3ec626451bade48f8b349649486b9b2086a36302",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/vllm-project/vllm/blob/760bb2165afcfd5e49645c7067ed55a29090d67a/vllm%2Fplatforms%2Finterface.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fplatforms%2Finterface.py?ref=760bb2165afcfd5e49645c7067ed55a29090d67a",
      "deletions": 0,
      "filename": "vllm/platforms/interface.py",
      "patch": "@@ -1107,6 +1107,28 @@ def _align_hybrid_block_size(\n         attn_block_size = backend_block_alignment * cdiv(\n             attn_block_size, backend_block_alignment\n         )\n+        # Prefix-cacheable block sizes must be multiples of prefix_match_unit.\n+        # The size derived from the mamba state can be divisor-poor (e.g. 2112\n+        # or 2096 tokens), so round it up; the mamba page is padded to the\n+        # attention page below anyway.\n+        if (\n+            unit := cache_config.prefix_match_unit\n+        ) is not None and attn_block_size % unit != 0:\n+            step = lcm(kernel_block_alignment_size, backend_block_alignment, unit)\n+            rounded = step * cdiv(attn_block_size, step)\n+            growth = rounded / attn_block_size - 1\n+            log = logger.warning if growth > 0.1 else logger.info\n+            log(\n+                \"Rounding attention block size %d up to %d tokens (+%.0f%% \"\n+                \"mamba page padding) so it is divisible by \"\n+                \"prefix_match_unit=%d. A unit that divides %d avoids it.\",\n+                attn_block_size,\n+                rounded,\n+                100 * growth,\n+                unit,\n+                attn_block_size,\n+            )\n+            attn_block_size = rounded\n \n         if cache_config.block_size < attn_block_size:\n             cache_config.block_size = attn_block_size",
      "raw_url": "https://github.com/vllm-project/vllm/raw/760bb2165afcfd5e49645c7067ed55a29090d67a/vllm%2Fplatforms%2Finterface.py",
      "sha": "06fefcbb032a89a875f03fc78bcf1b6d9b7120b7",
      "status": "modified"
    }
  ],
