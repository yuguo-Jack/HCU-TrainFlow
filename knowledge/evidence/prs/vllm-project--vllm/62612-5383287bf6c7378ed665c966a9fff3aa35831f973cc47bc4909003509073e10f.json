      "blob_url": "https://github.com/vllm-project/vllm/blob/e6a550d2efe5008349bc1df1e36ced4efcddaeab/tests%2Fv1%2Fworker%2Ftest_gpu_sampler_flags.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fworker%2Ftest_gpu_sampler_flags.py?ref=e6a550d2efe5008349bc1df1e36ced4efcddaeab",
      "deletions": 1,
      "filename": "tests/v1/worker/test_gpu_sampler_flags.py",
      "patch": "@@ -13,6 +13,7 @@\n     pytest.skip(\"CUDA required for sampler flag tests\", allow_module_level=True)\n \n from vllm.sampling_params import SamplingParams\n+from vllm.v1.worker.gpu.sample import sampler as sampler_module\n from vllm.v1.worker.gpu.sample.logits_processor import (\n     LogitsContext,\n     LogitsProcessor,\n@@ -30,7 +31,10 @@ class MockReasoningConfig:\n     natural_reasoning_end_token_ids = [91]\n \n \n-def _make_sampler(custom_logits_processors: Sequence[LogitsProcessor] = ()) -> Sampler:\n+def _make_sampler(\n+    custom_logits_processors: Sequence[LogitsProcessor] = (),\n+    use_fp64_gumbel: bool = False,\n+) -> Sampler:\n     req_states = RequestState(\n         max_num_reqs=4,\n         max_model_len=64,\n@@ -45,6 +49,7 @@ def _make_sampler(custom_logits_processors: Sequence[LogitsProcessor] = ()) -> S\n         vocab_size=VOCAB_SIZE,\n         device=DEVICE,\n         req_states=req_states,\n+        use_fp64_gumbel=use_fp64_gumbel,\n         custom_logits_processors=custom_logits_processors,\n     )\n \n@@ -133,6 +138,35 @@ def has_topp_only_rows(idx: list[int], vocab_size: int = VOCAB_SIZE) -> bool:\n     assert has_topp_only_rows([0], vocab_size=10)\n \n \n+def test_fp64_gumbel_bypasses_flashinfer_sampler(monkeypatch: pytest.MonkeyPatch):\n+    \"\"\"FlashInfer draws fp32 noise, so an unseeded top-p request, which would\n+    otherwise use the fused FlashInfer sampler, must use fp64 Gumbel sampling.\"\"\"\n+\n+    def flashinfer_sample(*args, **kwargs):\n+        raise AssertionError(\"FlashInfer sampler used despite use_fp64_gumbel\")\n+\n+    monkeypatch.setattr(sampler_module, \"flashinfer_sampler_supported\", lambda: True)\n+    monkeypatch.setattr(sampler_module, \"flashinfer_sample\", flashinfer_sample)\n+    sampler = _make_sampler(use_fp64_gumbel=True)\n+    sampler.add_request(0, SamplingParams(top_p=0.9))\n+    sampler.apply_staged_writes()\n+\n+    idx_mapping = torch.zeros(1, dtype=torch.int32, device=DEVICE)\n+    zeros = torch.zeros(1, dtype=torch.int32, device=DEVICE)\n+    sampled, _ = sampler.sample(\n+        torch.randn(1, VOCAB_SIZE, device=DEVICE),\n+        expanded_idx_mapping=idx_mapping,\n+        idx_mapping=idx_mapping,\n+        idx_mapping_np=np.zeros(1, dtype=np.intp),\n+        pos=zeros,\n+        input_ids=zeros,\n+        expanded_local_pos=zeros,\n+        seq_lens_upper_bound_np=np.ones(1, dtype=np.int64),\n+    )\n+\n+    assert sampled.shape == (1,)\n+\n+\n def test_logits_processing_cache_only_checks_active_requests():\n     sampler = _make_sampler()\n     sampler.add_request(0, SamplingParams(temperature=0.0))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/e6a550d2efe5008349bc1df1e36ced4efcddaeab/tests%2Fv1%2Fworker%2Ftest_gpu_sampler_flags.py",
      "sha": "a44098f521ed86773b448938d32a8ac17c110640",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/e6a550d2efe5008349bc1df1e36ced4efcddaeab/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Fsampler.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Fsampler.py?ref=e6a550d2efe5008349bc1df1e36ced4efcddaeab",
      "deletions": 2,
      "filename": "vllm/v1/worker/gpu/sample/sampler.py",
      "patch": "@@ -85,10 +85,12 @@ def __init__(\n         self.needs_logits_processing = np.zeros(max_num_reqs, dtype=bool)\n         self.num_speculative_tokens = num_speculative_tokens\n         self.return_sampling_mask = return_sampling_mask\n+        # The FlashInfer and XPU kernels draw fp32 noise, so they can't honor fp64.\n         self.use_flashinfer = (\n-            not return_sampling_mask and flashinfer_sampler_supported()\n+            not return_sampling_mask\n+            and not use_fp64_gumbel\n+            and flashinfer_sampler_supported()\n         )\n-        # The XPU kernel draws fp32 exponential noise, so it can't honor fp64.\n         self.use_xpu_sampler = (\n             not return_sampling_mask and not use_fp64_gumbel and xpu_sampler_supported()\n         )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/e6a550d2efe5008349bc1df1e36ced4efcddaeab/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Fsampler.py",
      "sha": "e2c2e8c9c98c65c8672507eff6e206584c5478e6",
      "status": "modified"
