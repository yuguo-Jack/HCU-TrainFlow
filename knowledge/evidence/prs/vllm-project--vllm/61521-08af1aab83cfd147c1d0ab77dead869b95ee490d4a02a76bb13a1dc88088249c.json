    {
      "additions": 37,
      "blob_url": "https://github.com/vllm-project/vllm/blob/02fc1fe6625dcbcbb0cd3d73ee5caebd6ebf62bf/tests%2Ftest_forward_context.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_forward_context.py?ref=02fc1fe6625dcbcbb0cd3d73ee5caebd6ebf62bf",
      "deletions": 0,
      "filename": "tests/test_forward_context.py",
      "patch": "@@ -0,0 +1,37 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+from unittest.mock import MagicMock\n+\n+import vllm.forward_context as forward_context\n+from vllm.config import VllmConfig\n+\n+\n+def test_batch_timing_retains_only_recent_samples(monkeypatch):\n+    config = VllmConfig()\n+    samples = type(forward_context.batchsize_forward_time)(\n+        forward_context.batchsize_forward_time.default_factory\n+    )\n+    logger = MagicMock()\n+    monkeypatch.setattr(forward_context, \"batchsize_forward_time\", samples)\n+    monkeypatch.setattr(forward_context, \"track_batchsize\", True)\n+    monkeypatch.setattr(forward_context, \"batchsize_logging_interval\", float(\"inf\"))\n+    monkeypatch.setattr(forward_context, \"last_logging_time\", 0)\n+    monkeypatch.setattr(forward_context, \"logger\", logger)\n+    monkeypatch.setattr(forward_context.current_platform, \"synchronize\", lambda: None)\n+    clock = 0.0\n+\n+    def now():\n+        nonlocal clock\n+        clock += 0.001\n+        return clock\n+\n+    monkeypatch.setattr(forward_context.time, \"perf_counter\", now)\n+    for _ in range(2048):\n+        with forward_context.set_forward_context({}, config, num_tokens=16):\n+            pass\n+    assert len(samples[16]) == 1024\n+    monkeypatch.setattr(forward_context, \"batchsize_logging_interval\", 0)\n+    with forward_context.set_forward_context({}, config, num_tokens=16):\n+        pass\n+    assert logger.info.call_args.args[1] == [(16, 1024, 1.0)]",
      "raw_url": "https://github.com/vllm-project/vllm/raw/02fc1fe6625dcbcbb0cd3d73ee5caebd6ebf62bf/tests%2Ftest_forward_context.py",
      "sha": "16bb8416c85edc0228b6bf74fff3bb7b6b58c30c",
      "status": "added"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/02fc1fe6625dcbcbb0cd3d73ee5caebd6ebf62bf/vllm%2Fforward_context.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fforward_context.py?ref=02fc1fe6625dcbcbb0cd3d73ee5caebd6ebf62bf",
      "deletions": 4,
      "filename": "vllm/forward_context.py",
      "patch": "@@ -2,7 +2,7 @@\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n \n import time\n-from collections import defaultdict\n+from collections import defaultdict, deque\n from contextlib import contextmanager\n from dataclasses import dataclass, field\n from typing import Any\n@@ -23,7 +23,10 @@\n last_logging_time: float = 0\n forward_start_time: float = 0\n batchsize_logging_interval: float = envs.VLLM_LOG_BATCHSIZE_INTERVAL\n-batchsize_forward_time: defaultdict = defaultdict(list)\n+# Report a rolling window so diagnostics do not retain every forward forever.\n+batchsize_forward_time: defaultdict[int | None, deque[float]] = defaultdict(\n+    lambda: deque(maxlen=1024)\n+)\n \n \n @dataclass(frozen=True)\n@@ -380,15 +383,15 @@ def set_forward_context(\n                     if len(times) <= 1:\n                         # can be cudagraph / profiling run\n                         continue\n-                    medium = torch.quantile(torch.tensor(times), q=0.5).item()\n+                    medium = torch.quantile(torch.tensor(list(times)), q=0.5).item()\n                     medium = round(medium, 2)\n                     forward_stats.append((bs, len(times), medium))\n                 forward_stats.sort(key=lambda x: x[1], reverse=True)\n                 if forward_stats:\n                     logger.info(\n                         (\n                             \"Batchsize forward time stats \"\n-                            \"(batchsize, count, median_time(ms)): %s\"\n+                            \"(batchsize, window_count, median_time(ms)): %s\"\n                         ),\n                         forward_stats,\n                     )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/02fc1fe6625dcbcbb0cd3d73ee5caebd6ebf62bf/vllm%2Fforward_context.py",
