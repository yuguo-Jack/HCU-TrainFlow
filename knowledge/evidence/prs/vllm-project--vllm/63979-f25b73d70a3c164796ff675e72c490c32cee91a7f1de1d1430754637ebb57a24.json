      "changes": 1,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Foracle%2Fmxfp4.py?ref=57d8a77121ce9a65c1c439d0087a90a7464b734b",
      "deletions": 0,
      "filename": "vllm/model_executor/layers/fused_moe/oracle/mxfp4.py",
      "patch": "@@ -443,6 +443,7 @@ def _get_priority_backends() -> list[Mxfp4MoeBackend]:\n     if current_platform.is_rocm():\n         return [\n             Mxfp4MoeBackend.AITER_MXFP4_BF16,\n+            Mxfp4MoeBackend.TRITON_UNFUSED,\n             Mxfp4MoeBackend.EMULATION,\n         ]\n     if current_platform.is_xpu():",
