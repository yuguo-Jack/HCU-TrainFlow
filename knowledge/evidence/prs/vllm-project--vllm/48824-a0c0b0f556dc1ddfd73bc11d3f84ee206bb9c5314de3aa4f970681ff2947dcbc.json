      "patch": "@@ -150,7 +150,7 @@ pub(crate) fn validate_vocab_range(\n         validate_param(\n             \"bad_words\",\n             bad_words_token_ids.iter().flatten().copied(),\n-            limits.tokenizer_vocab_size,\n+            limits.model_vocab_size,\n         )?;\n     }\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/46f80ae48b71205f083c39a499a1b56804ae3279/rust%2Fsrc%2Ftext%2Fsrc%2Flower%2Ftoken_ids.rs",
