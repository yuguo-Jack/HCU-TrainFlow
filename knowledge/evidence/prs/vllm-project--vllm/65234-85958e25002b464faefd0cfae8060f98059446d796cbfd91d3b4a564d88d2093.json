      "filename": ".buildkite/test_areas/models_multimodal.yaml",
      "patch": "@@ -177,7 +177,12 @@ steps:\n - label: \":nvidia: (H200 MIG 35GB) [Nightly] Multimodal Models (Extended Generation 1)\"\n   device: h200_35gb\n   key: multi-modal-models-extended-generation-1\n+  automatic_shard: true\n   optional: true\n+  env:\n+    # Engines in a shard can start after other tests touched CUDA in the\n+    # pytest process, so never fork them.\n+    VLLM_WORKER_MULTIPROC_METHOD: spawn\n   source_file_dependencies:\n   - vllm/\n   - \"!vllm/distributed/kv_transfer/\"\n@@ -192,6 +197,7 @@ steps:\n     - pytest -v -s models/multimodal/test_mapping.py\n   mirror:\n     amd:\n+      automatic_shard: true\n       label: \":amd: (MI355 DPX) Multimodal Models (Extended Generation 1)\"\n       dind: false\n       device: mi355_dpx",
