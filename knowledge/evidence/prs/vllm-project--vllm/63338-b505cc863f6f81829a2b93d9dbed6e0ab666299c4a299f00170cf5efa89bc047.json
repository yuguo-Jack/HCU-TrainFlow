  "files": [
    {
      "additions": 33,
      "blob_url": "https://github.com/vllm-project/vllm/blob/cd3490441cd9d408860e73f35e3229acf6a0d0c2/tests%2Fplatforms%2Ftest_cpu.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fplatforms%2Ftest_cpu.py?ref=cd3490441cd9d408860e73f35e3229acf6a0d0c2",
      "deletions": 0,
      "filename": "tests/platforms/test_cpu.py",
      "patch": "@@ -50,6 +50,7 @@ def _cpu_config(\n             layer_types=layer_types,\n         ),\n         registry=_FakeRegistry,\n+        multimodal_config=None,\n     )\n     config = VllmConfig(cache_config=cache_config)\n     config.model_config = model_config\n@@ -222,3 +223,35 @@ def test_cpu_conv_state_layout_selection(\n \n     CpuPlatform.check_and_update_config(config)\n     assert os.environ.get(layout_env) == expected_layout\n+\n+\n+@pytest.mark.parametrize(\n+    (\"kv_cache_space\", \"compile_mm_encoder\", \"expected_skip\"),\n+    [\n+        pytest.param(\"8\", False, True, id=\"explicit-kv-cache\"),\n+        pytest.param(None, False, False, id=\"auto-kv-cache\"),\n+        pytest.param(\"8\", True, False, id=\"explicit-kv-cache-encoder-compile\"),\n+    ],\n+)\n+def test_cpu_mm_profiling_skipped_with_explicit_kv_cache(\n+    monkeypatch: pytest.MonkeyPatch,\n+    kv_cache_space: str | None,\n+    compile_mm_encoder: bool,\n+    expected_skip: bool,\n+) -> None:\n+    monkeypatch.setattr(\"torch.cpu._is_avx512_bf16_supported\", lambda: False)\n+    if kv_cache_space is None:\n+        monkeypatch.delenv(\"VLLM_CPU_KVCACHE_SPACE\", raising=False)\n+    else:\n+        monkeypatch.setenv(\"VLLM_CPU_KVCACHE_SPACE\", kv_cache_space)\n+    config = _cpu_config(\n+        CacheConfig(mamba_ssm_cache_dtype=\"float32\"),\n+        model_type=\"qwen3_5\",\n+        resolved_dtype=\"float32\",\n+    )\n+    mm_config = SimpleNamespace(skip_mm_profiling=False)\n+    config.model_config.multimodal_config = mm_config\n+    config.compilation_config.compile_mm_encoder = compile_mm_encoder\n+\n+    CpuPlatform.check_and_update_config(config)\n+    assert mm_config.skip_mm_profiling is expected_skip",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cd3490441cd9d408860e73f35e3229acf6a0d0c2/tests%2Fplatforms%2Ftest_cpu.py",
      "sha": "e237a8d5ecd50f3012c61eed1f57b9188bd947c1",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/vllm-project/vllm/blob/cd3490441cd9d408860e73f35e3229acf6a0d0c2/vllm%2Fplatforms%2Fcpu.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fplatforms%2Fcpu.py?ref=cd3490441cd9d408860e73f35e3229acf6a0d0c2",
      "deletions": 0,
      "filename": "vllm/platforms/cpu.py",
      "patch": "@@ -343,6 +343,22 @@ def check_and_update_config(cls, vllm_config: VllmConfig) -> None:\n             kv_cache_space = int(os.environ[env_key])\n             cache_config.kv_cache_memory_bytes = kv_cache_space * GiB_bytes\n \n+        # Encoder profiling only feeds the auto KV-cache size, and one\n+        # maximum-size image through a vision encoder takes minutes on CPU.\n+        # It also compiles the encoder, so keep it when that is enabled.\n+        mm_config = model_config.multimodal_config if model_config else None\n+        if (\n+            mm_config is not None\n+            and cache_config.kv_cache_memory_bytes is not None\n+            and not mm_config.skip_mm_profiling\n+            and not vllm_config.compilation_config.compile_mm_encoder\n+        ):\n+            logger.info(\n+                \"Skipping multimodal encoder profiling: the KV cache size is \"\n+                \"set explicitly.\"\n+            )\n+            mm_config.skip_mm_profiling = True\n+\n         scheduler_config = vllm_config.scheduler_config\n         # async scheduling is not required on CPU\n         scheduler_config.async_scheduling = False",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cd3490441cd9d408860e73f35e3229acf6a0d0c2/vllm%2Fplatforms%2Fcpu.py",
      "sha": "e5b07da29f49aa7fa5f68437f4a36cf48467f514",
      "status": "modified"
    }
  ],
