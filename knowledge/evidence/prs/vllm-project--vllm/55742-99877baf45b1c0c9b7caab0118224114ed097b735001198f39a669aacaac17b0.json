      "deletions": 2,
      "filename": "vllm/model_executor/kernels/linear/mixed_precision/rdna_hybrid_w4a16.py",
      "patch": "@@ -663,17 +663,19 @@ def _rdna_hybrid_w4a16_apply_impl(\n     K = x_2d.shape[1]\n     N = w_q.shape[0]\n \n+    symmetry = \"asym\" if w_zp is not None else \"sym\"\n+\n     if M <= MAX_SKINNY_BATCH_SIZE and (\n         K * M <= MEDIUM_SKINNY_LIMIT_ELEMENTS or _on_gfx115x()\n     ):\n-        with _profile_scope(f\"wvsplitk_int4 {M}x{N}x{K}\"):\n+        with _profile_scope(f\"wvsplitk_int4 {M}x{N}x{K} g={group_size} {symmetry}\"):\n             return ops.wvSplitK_int4_g(w_q, x_2d, w_s, cu_count, group_size, w_zp, bias)\n \n     if w_dequant is not None and M >= MIN_DENSE_M:\n         with _profile_scope(f\"hybrid_dequant_w4a16 {M}x{N}x{K}\"):\n             return rocm_unquantized_gemm_impl(x_2d, w_dequant, bias)\n \n-    with _profile_scope(f\"hybrid_triton_w4a16 {M}x{N}x{K}\"):\n+    with _profile_scope(f\"hybrid_triton_w4a16 {M}x{N}x{K} g={group_size} {symmetry}\"):\n         output = triton_w4a16_skinny_fmt_gemm(\n             a=_pad_activation_rows(x_2d),\n             b_q=w_q.view(torch.int32),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a6bfe6feea58ee25684b3d0509bc26b594d142ec/vllm%2Fmodel_executor%2Fkernels%2Flinear%2Fmixed_precision%2Frdna_hybrid_w4a16.py",
