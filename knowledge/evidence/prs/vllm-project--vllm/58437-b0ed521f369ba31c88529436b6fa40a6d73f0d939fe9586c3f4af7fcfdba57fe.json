    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/892d75ab59c952d07de2f1f8f76384d8f6912b37/vllm%2Fparser%2Fdeepseek_v32.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fparser%2Fdeepseek_v32.py?ref=892d75ab59c952d07de2f1f8f76384d8f6912b37",
      "deletions": 2,
      "filename": "vllm/parser/deepseek_v32.py",
      "patch": "@@ -113,7 +113,9 @@ def deepseek_v32_config() -> ParserEngineConfig:\n             ParserState.TOOL_NAME: EventType.TOOL_NAME,\n             ParserState.TOOL_ARGS: EventType.ARG_VALUE_CHUNK,\n         },\n-        arg_converter=_dsml_arg_converter,\n+        arg_converter=functools.partial(\n+            _dsml_arg_converter, defer_invalid_partial=True\n+        ),\n         arg_structural_chars=frozenset(\">\"),\n         strip_content_whitespace_with_tools=False,\n         tool_args_json=False,\n@@ -137,7 +139,9 @@ def __init__(\n         self._arg_converter = self._convert_args\n \n     def _convert_args(self, raw_args: str, partial: bool) -> str:\n-        result = _dsml_arg_converter(raw_args, partial)\n+        converter = self.parser_engine_config.arg_converter\n+        assert converter is not None\n+        result = converter(raw_args, partial)\n         if not self._tools:\n             return result\n         func_name = next((s.name for s in self._tool_slots if s.args == raw_args), None)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/892d75ab59c952d07de2f1f8f76384d8f6912b37/vllm%2Fparser%2Fdeepseek_v32.py",
      "sha": "c57789bd97e25dd41e349a1a9de9e36ba91da5fe",
