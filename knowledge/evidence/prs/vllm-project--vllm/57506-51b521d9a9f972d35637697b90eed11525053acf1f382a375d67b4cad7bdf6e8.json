      "additions": 50,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d88e2187aa10e56dde66cf8bee6ccc9b04e9bd8b/tests%2Fv1%2Fkv_offload%2Fcpu%2Ftest_gpu_worker.py",
      "changes": 51,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_offload%2Fcpu%2Ftest_gpu_worker.py?ref=d88e2187aa10e56dde66cf8bee6ccc9b04e9bd8b",
      "deletions": 1,
      "filename": "tests/v1/kv_offload/cpu/test_gpu_worker.py",
      "patch": "@@ -233,7 +233,56 @@ def record_region_cleanup() -> None:\n     assert calls == [\"sync\", \"region\"]\n     mmap_region.cleanup.assert_called_once_with()\n     if device_sync_fails:\n-        assert \"Device sync before mmap cleanup failed\" in caplog_vllm.text\n+        assert \"retaining private CPU tensors\" in caplog_vllm.text\n+\n+\n+def test_private_worker_retains_tensors_when_device_sync_fails(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    worker = CPUOffloadingWorker.__new__(CPUOffloadingWorker)\n+    private_tensor = MagicMock()\n+    cpu_tensors = [private_tensor]\n+    worker._private_cpu_tensors = tuple(cpu_tensors)\n+    worker._mmap_region = None\n+\n+    store_handler = MagicMock()\n+\n+    def store_shutdown() -> None:\n+        cpu_tensors.clear()\n+        raise RuntimeError(\"event did not drain\")\n+\n+    store_handler.shutdown.side_effect = store_shutdown\n+    load_handler = MagicMock()\n+\n+    def device_sync() -> None:\n+        raise RuntimeError(\"device did not drain\")\n+\n+    monkeypatch.setattr(torch.accelerator, \"synchronize\", device_sync)\n+    worker._store_handler = store_handler\n+    worker._load_handler = load_handler\n+\n+    worker.shutdown()\n+\n+    assert worker._private_cpu_tensors == (private_tensor,)\n+    store_handler.shutdown.assert_called_once_with()\n+    load_handler.shutdown.assert_called_once_with()\n+\n+\n+def test_private_worker_releases_tensors_after_normal_shutdown(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    worker = CPUOffloadingWorker.__new__(CPUOffloadingWorker)\n+    worker._private_cpu_tensors = (MagicMock(),)\n+    worker._mmap_region = None\n+    worker._store_handler = MagicMock()\n+    worker._load_handler = MagicMock()\n+    device_sync = MagicMock()\n+    monkeypatch.setattr(torch.accelerator, \"synchronize\", device_sync)\n+\n+    worker.shutdown()\n+\n+    assert worker._private_cpu_tensors is None\n+    device_sync.assert_not_called()\n \n \n @pytest.mark.parametrize(\"gpu_to_cpu\", [True, False])",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d88e2187aa10e56dde66cf8bee6ccc9b04e9bd8b/tests%2Fv1%2Fkv_offload%2Fcpu%2Ftest_gpu_worker.py",
      "sha": "6db555a4ea5f6544de0a7cb5fda83c3bd676b626",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d88e2187aa10e56dde66cf8bee6ccc9b04e9bd8b/vllm%2Fv1%2Fkv_offload%2Fcpu%2Fgpu_worker.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fkv_offload%2Fcpu%2Fgpu_worker.py?ref=d88e2187aa10e56dde66cf8bee6ccc9b04e9bd8b",
      "deletions": 11,
      "filename": "vllm/v1/kv_offload/cpu/gpu_worker.py",
      "patch": "@@ -343,10 +343,12 @@ def __init__(\n             else:\n                 assert cpu_page_size == gpu_page_size * blocks_per_chunk\n \n-        self.src_tensors: list[torch.Tensor] = (\n+        # Keep private containers for each handler. The worker owns the\n+        # tensors; handlers only borrow references while transfers are live.\n+        self.src_tensors: list[torch.Tensor] = list(\n             gpu_tensors if gpu_to_cpu else cpu_tensors\n         )\n-        self.dst_tensors: list[torch.Tensor] = (\n+        self.dst_tensors: list[torch.Tensor] = list(\n             cpu_tensors if gpu_to_cpu else gpu_tensors\n         )\n         self.gpu_to_cpu: bool = gpu_to_cpu\n@@ -881,6 +883,11 @@ def __init__(\n             canonical_layout=canonical_layout,\n             host_memory_is_pinned=host_memory_is_pinned,\n         )\n+        # The worker owns private CPU tensors. Keep an independent owner until\n+        # both handlers and any required device sync complete.\n+        self._private_cpu_tensors: tuple[torch.Tensor, ...] | None = (\n+            tuple(cpu_tensors) if mmap_region is None else None\n+        )\n \n     def submit_store(\n         self, job_id: int, src_spec: GPULoadStoreSpec, dst_spec: LoadStoreSpec\n@@ -915,15 +922,21 @@ def shutdown(self) -> None:\n             logger.exception(\"Failed to shut down load offloading handler\")\n             handler_failed = True\n \n+        safe_to_release_private_tensors = True\n+        if handler_failed:\n+            try:\n+                torch.accelerator.synchronize()\n+            except Exception:\n+                safe_to_release_private_tensors = False\n+                logger.warning(\n+                    \"Device sync after handler shutdown failed; retaining \"\n+                    \"private CPU tensors because completion was not confirmed\",\n+                    exc_info=True,\n+                )\n+\n         if self._mmap_region is not None:\n-            if handler_failed:\n-                try:\n-                    torch.accelerator.synchronize()\n-                except Exception:\n-                    logger.warning(\n-                        \"Device sync before mmap cleanup failed; \"\n-                        \"proceeding with cleanup anyway\",\n-                        exc_info=True,\n-                    )\n             self._mmap_region.cleanup()\n             self._mmap_region = None\n+\n+        if safe_to_release_private_tensors:\n+            self._private_cpu_tensors = None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d88e2187aa10e56dde66cf8bee6ccc9b04e9bd8b/vllm%2Fv1%2Fkv_offload%2Fcpu%2Fgpu_worker.py",
