      "additions": 9,
      "blob_url": "https://github.com/vllm-project/vllm/blob/40c9725f85ced69b39be476a09d6e5ea2539aacc/vllm%2Fenvs.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fenvs.py?ref=40c9725f85ced69b39be476a09d6e5ea2539aacc",
      "deletions": 0,
      "filename": "vllm/envs.py",
      "patch": "@@ -171,6 +171,9 @@\n     VLLM_MLA_DISABLE: bool = False\n     VLLM_RAY_PER_WORKER_GPUS: float = 1.0\n     VLLM_RAY_BUNDLE_INDICES: str = \"\"\n+    VLLM_RAY_PG_STRATEGY: Literal[\"PACK\", \"SPREAD\", \"STRICT_PACK\", \"STRICT_SPREAD\"] = (\n+        \"PACK\"\n+    )\n     VLLM_CUDART_SO_PATH: str | None = None\n     VLLM_DP_RANK: int = 0\n     VLLM_DP_RANK_LOCAL: int = -1\n@@ -1449,6 +1452,12 @@ def _resolve_rust_cli_path() -> str | None:\n     # which indices are used for the Ray bundle, for every worker.\n     # Format: comma-separated list of integers, e.g. \"0,1,2,3\"\n     \"VLLM_RAY_BUNDLE_INDICES\": lambda: os.getenv(\"VLLM_RAY_BUNDLE_INDICES\", \"\"),\n+    # Placement group strategy for Ray distributed execution.\n+    \"VLLM_RAY_PG_STRATEGY\": env_with_choices(\n+        \"VLLM_RAY_PG_STRATEGY\",\n+        \"PACK\",\n+        [\"PACK\", \"SPREAD\", \"STRICT_PACK\", \"STRICT_SPREAD\"],\n+    ),\n     # In some system, find_loaded_library() may not work. So we allow users to\n     # specify the path through environment variable VLLM_CUDART_SO_PATH.\n     \"VLLM_CUDART_SO_PATH\": lambda: os.getenv(\"VLLM_CUDART_SO_PATH\", None),",
