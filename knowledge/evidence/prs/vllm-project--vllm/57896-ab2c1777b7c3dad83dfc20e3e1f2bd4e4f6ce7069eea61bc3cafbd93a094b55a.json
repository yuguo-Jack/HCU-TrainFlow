      "patch": "@@ -183,6 +183,8 @@ dpcpp-cpp-rt==2026.0.0\n     #   onemkl-sycl-rng\n     #   onemkl-sycl-sparse\n     #   torch\n+dpctl==0.22.1\n+    # via -r requirements/test/xpu.in\n einops==0.8.2\n     # via -r requirements/test/../common.txt\n email-validator==2.3.0\n@@ -336,6 +338,7 @@ iniconfig==2.3.0\n     # via pytest\n intel-cmplr-lib-rt==2026.0.0\n     # via\n+    #   dpctl\n     #   intel-sycl-rt\n     #   torch\n intel-cmplr-lib-ur==2026.0.0\n@@ -367,6 +370,7 @@ intel-pti==0.17.0\n intel-sycl-rt==2026.0.0\n     # via\n     #   dpcpp-cpp-rt\n+    #   dpctl\n     #   oneccl\n     #   torch\n interegular==0.3.3\n@@ -525,6 +529,7 @@ numpy==2.2.6\n     #   contourpy\n     #   datasets\n     #   decord\n+    #   dpctl\n     #   evaluate\n     #   librosa\n     #   lm-eval",
      "raw_url": "https://github.com/vllm-project/vllm/raw/84ee7e093958d301f253c27fbec73323756b958e/requirements%2Ftest%2Fxpu.txt",
