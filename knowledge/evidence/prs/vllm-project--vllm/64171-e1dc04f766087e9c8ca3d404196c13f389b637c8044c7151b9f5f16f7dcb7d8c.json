  "files": [
    {
      "additions": 31,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1010fb5a18b9cbfd6ae5a265a66b30c084d12dba/tests%2Futils_%2Ftest_counter.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Futils_%2Ftest_counter.py?ref=1010fb5a18b9cbfd6ae5a265a66b30c084d12dba",
      "deletions": 0,
      "filename": "tests/utils_/test_counter.py",
      "patch": "@@ -0,0 +1,31 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+import threading\n+\n+from vllm.utils.counter import AtomicCounter, Counter\n+\n+\n+def test_counter_reset_restores_start():\n+    counter = Counter(start=5)\n+    assert [next(counter) for _ in range(3)] == [5, 6, 7]\n+\n+    counter.reset()\n+    assert next(counter) == 5\n+\n+\n+def test_atomic_counter_concurrent_inc_dec():\n+    counter = AtomicCounter(10)\n+    num_threads, iters = 8, 1000\n+\n+    def worker():\n+        for _ in range(iters):\n+            counter.inc(2)\n+            counter.dec()\n+\n+    threads = [threading.Thread(target=worker) for _ in range(num_threads)]\n+    for t in threads:\n+        t.start()\n+    for t in threads:\n+        t.join()\n+\n+    assert counter.value == 10 + num_threads * iters",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1010fb5a18b9cbfd6ae5a265a66b30c084d12dba/tests%2Futils_%2Ftest_counter.py",
      "sha": "5bad05e3b95358d99b79b3c50903a57db54a91bf",
      "status": "added"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1010fb5a18b9cbfd6ae5a265a66b30c084d12dba/vllm%2Futils%2Fcounter.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Futils%2Fcounter.py?ref=1010fb5a18b9cbfd6ae5a265a66b30c084d12dba",
      "deletions": 1,
      "filename": "vllm/utils/counter.py",
      "patch": "@@ -7,6 +7,7 @@ class Counter:\n     def __init__(self, start: int = 0) -> None:\n         super().__init__()\n \n+        self.start = start\n         self.counter = start\n \n     def __next__(self) -> int:\n@@ -15,7 +16,7 @@ def __next__(self) -> int:\n         return i\n \n     def reset(self) -> None:\n-        self.counter = 0\n+        self.counter = self.start\n \n \n class AtomicCounter:",
