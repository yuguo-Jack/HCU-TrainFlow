      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/a46940b5e43e28c75e550df3433501b50f0df6c5/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Fpenalties.py",
