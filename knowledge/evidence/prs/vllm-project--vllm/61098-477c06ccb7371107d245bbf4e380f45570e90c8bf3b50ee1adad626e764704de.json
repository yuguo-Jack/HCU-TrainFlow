  "files": [
    {
      "additions": 66,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f37cd1fcc7f241d4f08ec75a97c98c9cabe6cbe2/tests%2Fmodels%2Fmultimodal%2Fprocessing%2Ftest_kimi_audio_embed.py",
      "changes": 66,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Fmultimodal%2Fprocessing%2Ftest_kimi_audio_embed.py?ref=f37cd1fcc7f241d4f08ec75a97c98c9cabe6cbe2",
      "deletions": 0,
      "filename": "tests/models/multimodal/processing/test_kimi_audio_embed.py",
      "patch": "@@ -0,0 +1,66 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+from types import SimpleNamespace\n+\n+import pytest\n+import torch\n+\n+from vllm.model_executor.models.kimi_audio import KimiAudioForConditionalGeneration\n+\n+\n+@pytest.mark.parametrize(\"container\", [list, tuple, torch.stack])\n+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])\n+def test_batched_audio_matches_individual_requests(container, dtype):\n+    \"\"\"Every request's audio must survive batching and chunked prefill.\"\"\"\n+    embedding = torch.nn.Embedding(8, 4, dtype=dtype)\n+    model = SimpleNamespace(\n+        language_model=SimpleNamespace(model=SimpleNamespace(embed_tokens=embedding))\n+    )\n+    embed = KimiAudioForConditionalGeneration.embed_input_ids\n+    lengths = [2, 2] if container is torch.stack else [2, 3]\n+    audio = [torch.full((n, 4), float(i + 1)) for i, n in enumerate(lengths)]\n+    ids = [torch.arange(n + 2) for n in lengths]\n+    masks = [torch.tensor([False] + [True] * n + [False]) for n in lengths]\n+    expected = torch.cat(\n+        [\n+            embed(model, tokens, [features], is_multimodal=mask)\n+            for tokens, features, mask in zip(ids, audio, masks)\n+        ]\n+    )\n+    all_ids, all_masks = torch.cat(ids), torch.cat(masks)\n+    actual = embed(model, all_ids, container(audio), is_multimodal=all_masks)\n+    torch.testing.assert_close(actual, expected)\n+    torch.testing.assert_close(actual[~all_masks], embedding(all_ids)[~all_masks])\n+    fused = (embedding(all_ids)[all_masks] + torch.cat(audio).to(dtype)) * (2**0.5)\n+    torch.testing.assert_close(actual[all_masks], fused)\n+\n+    # The runner passes only the audio rows in the scheduled token window.\n+    split = 2\n+    first_count = int(all_masks[:split].sum())\n+    chunks = [\n+        embed(\n+            model,\n+            all_ids[:split],\n+            [audio[0][:first_count]],\n+            is_multimodal=all_masks[:split],\n+        ),\n+        embed(\n+            model,\n+            all_ids[split:],\n+            [audio[0][first_count:], audio[1]],\n+            is_multimodal=all_masks[split:],\n+        ),\n+    ]\n+    torch.testing.assert_close(torch.cat(chunks), expected)\n+\n+\n+@pytest.mark.parametrize(\"audio\", [None, []])\n+def test_text_only_embeddings_unchanged(audio):\n+    embedding = torch.nn.Embedding(8, 4)\n+    model = SimpleNamespace(\n+        language_model=SimpleNamespace(model=SimpleNamespace(embed_tokens=embedding))\n+    )\n+    ids = torch.arange(4)\n+    actual = KimiAudioForConditionalGeneration.embed_input_ids(model, ids, audio)\n+    torch.testing.assert_close(actual, embedding(ids))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f37cd1fcc7f241d4f08ec75a97c98c9cabe6cbe2/tests%2Fmodels%2Fmultimodal%2Fprocessing%2Ftest_kimi_audio_embed.py",
      "sha": "83d51815190337577d08d0a4dd649ebf89fd35b0",
      "status": "added"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f37cd1fcc7f241d4f08ec75a97c98c9cabe6cbe2/vllm%2Fmodel_executor%2Fmodels%2Fkimi_audio.py",
      "changes": 41,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fkimi_audio.py?ref=f37cd1fcc7f241d4f08ec75a97c98c9cabe6cbe2",
      "deletions": 34,
      "filename": "vllm/model_executor/models/kimi_audio.py",
      "patch": "@@ -26,6 +26,7 @@\n from vllm.model_executor.models.utils import (\n     AutoWeightsLoader,\n     WeightsMapper,\n+    _merge_multimodal_embeddings,\n     init_vllm_registered_model,\n     maybe_prefix,\n )\n@@ -508,42 +509,14 @@ def embed_input_ids(\n         if is_multimodal is None or not is_multimodal.any():\n             return inputs_embeds\n \n-        # multimodal_embeddings[0] contains audio embeddings\n-        audio_embeds = multimodal_embeddings[0]\n-\n-        # Handle different tensor structures\n-        if isinstance(audio_embeds, (list, tuple)):\n-            audio_embeds = torch.cat(audio_embeds, dim=0)\n-        elif audio_embeds.dim() == 3:\n-            audio_embeds = audio_embeds.reshape(-1, audio_embeds.shape[-1])\n-\n-        # In PP, audio_embeds count should match is_multimodal.sum()\n-        # For now, use embeddings sequentially\n-        # (works for non-PP, PP needs vLLM infra fix)\n-        num_mm_tokens = is_multimodal.sum().item()\n-        num_audio_embeds = audio_embeds.shape[0]\n-\n-        # Use the minimum of available embeddings and positions\n-        # This ensures we don't access out-of-bounds\n-        num_to_use = min(num_audio_embeds, num_mm_tokens)\n-\n-        # Get positions for the tokens we'll actually process\n-        mm_positions = is_multimodal.nonzero(as_tuple=True)[0]\n-        actual_mm_mask = torch.zeros_like(is_multimodal)\n-        actual_mm_mask[mm_positions[:num_to_use]] = True\n-\n-        # Use corresponding embeddings\n-        used_audio_embeds = audio_embeds[:num_to_use]\n-\n-        # Save text embeddings at multimodal positions\n-        text_at_mm_positions = inputs_embeds[actual_mm_mask].clone()\n-\n-        # Replace text with audio at multimodal positions\n-        inputs_embeds[actual_mm_mask] = used_audio_embeds.to(dtype=inputs_embeds.dtype)\n+        text_at_mm_positions = inputs_embeds[is_multimodal].clone()\n+        inputs_embeds = _merge_multimodal_embeddings(\n+            inputs_embeds, multimodal_embeddings, is_multimodal\n+        )\n \n         # Apply Kimi-Audio's unique fusion formula: (text + audio) × √2\n-        inputs_embeds[actual_mm_mask] = (\n-            inputs_embeds[actual_mm_mask] + text_at_mm_positions\n+        inputs_embeds[is_multimodal] = (\n+            inputs_embeds[is_multimodal] + text_at_mm_positions\n         ) * (2**0.5)\n \n         return inputs_embeds",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f37cd1fcc7f241d4f08ec75a97c98c9cabe6cbe2/vllm%2Fmodel_executor%2Fmodels%2Fkimi_audio.py",
      "sha": "dc559f82b942ed6462044b4dfbfa57cfce316f3e",
      "status": "modified"
    }
