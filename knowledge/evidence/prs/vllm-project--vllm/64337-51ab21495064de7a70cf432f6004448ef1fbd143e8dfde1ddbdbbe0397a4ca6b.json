      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/0200da69d6651bf7b4491148a45eacb0b70542f6/tests%2Fmultimodal%2Fmedia%2Ftest_audio.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmultimodal%2Fmedia%2Ftest_audio.py?ref=0200da69d6651bf7b4491148a45eacb0b70542f6",
      "deletions": 0,
      "filename": "tests/multimodal/media/test_audio.py",
      "patch": "@@ -104,6 +104,19 @@ def test_load_audio_max_duration_rejected(dummy_audio_bytes):\n         load_audio(BytesIO(dummy_audio_bytes), sr=None, max_duration_s=0.0001)\n \n \n+def test_audio_media_io_rejects_truncated_wav_as_value_error():\n+    \"\"\"A recognised but corrupt file (a WAV cut inside its header) must raise\n+    ValueError so the server answers 400. libsndfile reports it with an error\n+    code outside the format-detection ones; that used to re-raise as a\n+    RuntimeError and surface as HTTP 500.\"\"\"\n+    buf = BytesIO()\n+    sf.write(buf, np.zeros(1600, dtype=np.int16), 16000, format=\"WAV\")\n+    truncated = buf.getvalue()[:30]\n+\n+    with pytest.raises(ValueError):\n+        AudioMediaIO().load_bytes(truncated)\n+\n+\n def test_audio_media_io_from_video(video_assets):\n     audio_io = AudioMediaIO()\n     video_path = video_assets[0].video_path",
      "raw_url": "https://github.com/vllm-project/vllm/raw/0200da69d6651bf7b4491148a45eacb0b70542f6/tests%2Fmultimodal%2Fmedia%2Ftest_audio.py",
      "sha": "29cfd5084714f02822fd7854ebe71e2da1f296bc",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/0200da69d6651bf7b4491148a45eacb0b70542f6/vllm%2Fmultimodal%2Fmedia%2Faudio.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmultimodal%2Fmedia%2Faudio.py?ref=0200da69d6651bf7b4491148a45eacb0b70542f6",
      "deletions": 3,
      "filename": "vllm/multimodal/media/audio.py",
      "patch": "@@ -499,10 +499,14 @@ def load_audio(\n         logger.error(\"Failed to load audio via soundfile: %r\", exc)\n     except soundfile.LibsndfileError as exc:\n         # libsndfile covers fewer containers than FFmpeg, so defer only on a\n-        # format-detection failure; re-raise anything else (e.g. corrupt but\n-        # recognised) since PyAV would hit the same corruption.\n+        # format-detection failure. Anything else (e.g. corrupt but recognised)\n+        # is a bad input that PyAV would reject too; report it as a client\n+        # error instead of letting the RuntimeError surface as an HTTP 500.\n         if exc.code not in _BAD_SF_CODES:\n-            raise\n+            raise ValueError(\n+                \"Invalid or corrupted audio data. Ensure the input is a valid \"\n+                \"audio file (e.g. a complete WAV, FLAC, or MP3).\"\n+            ) from exc\n \n     # PyAV is terminal: nothing left to fall back to. Normalize an FFmpeg\n     # failure to ValueError; let a missing soundfile/PyAV surface its",
      "raw_url": "https://github.com/vllm-project/vllm/raw/0200da69d6651bf7b4491148a45eacb0b70542f6/vllm%2Fmultimodal%2Fmedia%2Faudio.py",
      "sha": "3b0467795122d410d31e137532d05fec239c6f58",
      "status": "modified"
    }
