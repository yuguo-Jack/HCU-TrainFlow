  "files": [
    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ff84ea5190f37626d3ac4b831a48680f92e452fc/.buildkite%2Fci_config_intel.yaml",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Fci_config_intel.yaml?ref=ff84ea5190f37626d3ac4b831a48680f92e452fc",
      "deletions": 0,
      "filename": ".buildkite/ci_config_intel.yaml",
      "patch": "@@ -3,6 +3,8 @@ job_dirs:\n   - \".buildkite/intel_jobs\"\n run_all_patterns:\n   - \".buildkite/ci_config_intel.yaml\"\n+  - \".buildkite/image_build/image_build_xpu.sh\"\n+  - \".buildkite/intel_jobs/test-intel.yaml\"\n   - \".buildkite/scripts/hardware_ci/run-intel-test.sh\"\n   - \"docker/Dockerfile\"\n   - \"docker/Dockerfile.xpu\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ff84ea5190f37626d3ac4b831a48680f92e452fc/.buildkite%2Fci_config_intel.yaml",
      "sha": "990c96bf62d3666773d4cdaf53d454f5410954fd",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ff84ea5190f37626d3ac4b831a48680f92e452fc/.buildkite%2Fimage_build%2Fimage_build_xpu.sh",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Fimage_build%2Fimage_build_xpu.sh?ref=ff84ea5190f37626d3ac4b831a48680f92e452fc",
      "deletions": 0,
      "filename": ".buildkite/image_build/image_build_xpu.sh",
      "patch": "@@ -10,6 +10,10 @@ REGISTRY=$1\n REPO=$2\n BUILDKITE_COMMIT=$3\n IMAGE=\"$REGISTRY/$REPO:$BUILDKITE_COMMIT-xpu\"\n+PYTORCH_NIGHTLY_ARGS=()\n+if [[ \"${TORCH_NIGHTLY:-0}\" == \"1\" ]]; then\n+  PYTORCH_NIGHTLY_ARGS+=(--build-arg PYTORCH_NIGHTLY=1)\n+fi\n \n # authenticate with AWS ECR\n aws ecr-public get-login-password --region us-east-1 | docker login --username AWS --password-stdin \"$REGISTRY\" || true\n@@ -25,6 +29,7 @@ else\n     --file docker/Dockerfile.xpu \\\n     --build-arg max_jobs=16 \\\n     --build-arg buildkite_commit=\"$BUILDKITE_COMMIT\" \\\n+    \"${PYTORCH_NIGHTLY_ARGS[@]}\" \\\n     --tag \"$IMAGE\" \\\n     --progress plain .\n   # push",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ff84ea5190f37626d3ac4b831a48680f92e452fc/.buildkite%2Fimage_build%2Fimage_build_xpu.sh",
      "sha": "11434317f1fb39e06572c22bed2f9de9ffae8319",
      "status": "modified"
    },
    {
      "additions": 38,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ff84ea5190f37626d3ac4b831a48680f92e452fc/docker%2FDockerfile.xpu",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile.xpu?ref=ff84ea5190f37626d3ac4b831a48680f92e452fc",
      "deletions": 4,
      "filename": "docker/Dockerfile.xpu",
      "patch": "@@ -207,6 +207,8 @@ RUN --mount=type=cache,target=/root/.cache/uv \\\n FROM vllm-base AS vllm-openai\n ENV UV_COMPILE_BYTECODE=1\n \n+ARG PYTORCH_NIGHTLY=0\n+\n # Must match the ucx-nixl-build stage above: ARG does not cross stages, so a stale\n # value here installs a meta package that disagrees with the wheel built there.\n ARG NIXL_VERSION=v1.5.0\n@@ -237,13 +239,41 @@ RUN --mount=type=cache,target=/root/.cache/uv \\\n     && uv pip install --no-deps nixl==${NIXL_VERSION} \\\n     && rm -rf /tmp/nixl_wheels\n \n+COPY requirements requirements\n+COPY tools/use_existing_torch.py tools/use_existing_torch.py\n+COPY pyproject.toml pyproject.toml\n+\n RUN --mount=type=cache,target=/root/.cache/uv \\\n-    --mount=type=bind,src=requirements/common.txt,target=/workspace/vllm/requirements/common.txt \\\n-    --mount=type=bind,src=requirements/xpu.txt,target=/workspace/vllm/requirements/xpu.txt \\\n-    --mount=type=bind,src=requirements/test/xpu.txt,target=/workspace/vllm/requirements/test/xpu.txt \\\n     uv pip install grpcio-tools protobuf nanobind && \\\n+    if [ \"${PYTORCH_NIGHTLY}\" = \"1\" ]; then \\\n+        export UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/nightly/xpu && \\\n+        uv pip install --pre --index-strategy first-index \\\n+            --index-url https://pypi.org/simple \\\n+            torch torchvision torchaudio && \\\n+        python -c \"import torch; assert '.dev' in torch.__version__, torch.__version__; print('Selected PyTorch nightly:', torch.__version__)\" && \\\n+        uv pip freeze | grep -E '^(torch|torchvision|torchaudio|triton-xpu)==' > /tmp/torch-nightly-constraints.txt && \\\n+        export UV_CONSTRAINT=/tmp/torch-nightly-constraints.txt && \\\n+        python tools/use_existing_torch.py --prefix && \\\n+        sed -i '/^triton==/d' requirements/xpu.txt && \\\n+        cat /tmp/torch-nightly-constraints.txt >> requirements/test/xpu.in && \\\n+        uv pip compile requirements/test/xpu.in -c requirements/xpu.txt \\\n+            -o requirements/test/xpu.txt --prerelease=allow \\\n+            --index-strategy unsafe-best-match \\\n+            --extra-index-url https://download.pytorch.org/whl/nightly/xpu; \\\n+    fi && \\\n     uv pip install -r /workspace/vllm/requirements/xpu.txt && \\\n-    uv pip install --no-build-isolation -r /workspace/vllm/requirements/test/xpu.txt\n+    uv pip install --no-build-isolation -r /workspace/vllm/requirements/test/xpu.txt && \\\n+    if [ \"${PYTORCH_NIGHTLY}\" = \"1\" ]; then \\\n+        TRITON_XPU_VERSION=\"$(sed -n 's/^triton-xpu==//p' /tmp/torch-nightly-constraints.txt)\" && \\\n+        test -n \"${TRITON_XPU_VERSION}\" && \\\n+        uv pip uninstall triton triton-xpu && \\\n+        UV_EXTRA_INDEX_URL=https://download.pytorch.org/whl/nightly/xpu \\\n+            uv pip install --no-deps --reinstall --index-strategy first-index \\\n+                --index-url https://download.pytorch.org/whl/nightly/xpu \\\n+                \"triton-xpu==${TRITON_XPU_VERSION}\" && \\\n+        python -c \"from importlib.metadata import distributions, version; assert version('triton-xpu') == '${TRITON_XPU_VERSION}'; assert all(d.metadata['Name'].lower() != 'triton' for d in distributions()), 'generic triton remains installed'\" && \\\n+        python -c \"import torch; assert '.dev' in torch.__version__, torch.__version__; print('PyTorch nightly:', torch.__version__)\"; \\\n+    fi\n \n # Keep source-dependent layers near the end so frequent code-only changes\n # don't invalidate heavy dependency and UCX/NIXL layers.\n@@ -263,6 +293,10 @@ ENV VLLM_WORKER_MULTIPROC_METHOD=spawn\n \n RUN --mount=type=cache,target=/root/.cache/uv \\\n     --mount=type=bind,source=.git,target=.git \\\n+    if [ \"${PYTORCH_NIGHTLY}\" = \"1\" ]; then \\\n+        python tools/use_existing_torch.py --prefix && \\\n+        sed -i '/^triton==/d' requirements/xpu.txt; \\\n+    fi && \\\n     uv pip install --no-build-isolation --no-deps .\n \n RUN --mount=type=cache,target=/root/.cache/uv \\",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ff84ea5190f37626d3ac4b831a48680f92e452fc/docker%2FDockerfile.xpu",
      "sha": "62bf1235af4c101189e7423078c8dc409597cf71",
      "status": "modified"
    }
