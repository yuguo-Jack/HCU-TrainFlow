      "changes": 17,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fengine%2Ftest_input_processor_trace_replay.py?ref=c3c92bfb6ed568ad539ddcb953a29174a5bc54f9",
      "deletions": 0,
      "filename": "tests/v1/engine/test_input_processor_trace_replay.py",
      "patch": "@@ -60,6 +60,23 @@ def test_normalize_trace_replay_params():\n     assert request.status == RequestStatus.FINISHED_LENGTH_CAPPED\n \n \n+def test_trace_length_overrides_default_max_tokens():\n+    params = SamplingParams(trace_decode_token_ids=list(range(20)))\n+    assert params.max_tokens == 16\n+\n+    _normalize(params, prompt_len=3, max_model_len=128)\n+\n+    assert params.max_tokens == 20\n+\n+\n+def test_trace_length_overrides_explicit_max_tokens():\n+    params = SamplingParams(max_tokens=4, trace_decode_token_ids=list(range(20)))\n+\n+    _normalize(params, prompt_len=3, max_model_len=128)\n+\n+    assert params.max_tokens == 20\n+\n+\n def test_trace_longer_than_remaining_context_is_truncated():\n     \"\"\"The trace is staged into a max_model_len-wide row, so it must be cut.\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c3c92bfb6ed568ad539ddcb953a29174a5bc54f9/tests%2Fv1%2Fengine%2Ftest_input_processor_trace_replay.py",
      "sha": "b525feb41745a8a4733297a4c9469c0893821d74",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c3c92bfb6ed568ad539ddcb953a29174a5bc54f9/vllm%2Fv1%2Fengine%2Finput_processor.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Finput_processor.py?ref=c3c92bfb6ed568ad539ddcb953a29174a5bc54f9",
      "deletions": 4,
      "filename": "vllm/v1/engine/input_processor.py",
      "patch": "@@ -266,17 +266,14 @@ def _normalize_trace_replay_params(\n         \"\"\"Apply trace replay's generation semantics to request-local params.\"\"\"\n         trace_token_ids = sampling_params.trace_decode_token_ids\n         assert trace_token_ids\n-        assert sampling_params.max_tokens is not None\n \n         max_trace_len = max(self.model_config.max_model_len - prompt_len, 1)\n         trace_token_ids = trace_token_ids[:max_trace_len]\n         sampling_params.trace_decode_token_ids = trace_token_ids\n \n         # Apply this after the generation config so its EOS token cannot stop\n         # replay before the trace is exhausted.\n-        sampling_params.max_tokens = min(\n-            len(trace_token_ids), sampling_params.max_tokens\n-        )\n+        sampling_params.max_tokens = len(trace_token_ids)\n         sampling_params.min_tokens = 0\n         sampling_params.ignore_eos = True\n         sampling_params._eos_token_id = None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c3c92bfb6ed568ad539ddcb953a29174a5bc54f9/vllm%2Fv1%2Fengine%2Finput_processor.py",
