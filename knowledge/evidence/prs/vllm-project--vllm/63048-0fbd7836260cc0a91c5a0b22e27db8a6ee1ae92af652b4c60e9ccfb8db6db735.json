      "deletions": 0,
      "filename": "tests/kernels/moe/test_fp8_tp_loading.py",
      "patch": "@@ -166,6 +166,26 @@ def test_fp8_tp_default_keeps_refined_layout(monkeypatch, backend, tp_size, bloc\n     assert layer.quant_method.moe_block_shape == [block, block]\n \n \n+@pytest.mark.parametrize(\"aiter_enabled,padded\", [(\"1\", True), (\"0\", False)])\n+def test_fp8_tp_env_forced_aiter_uses_block_aligned_layout(\n+    monkeypatch, aiter_enabled, padded\n+):\n+    # VLLM_ROCM_USE_AITER forces AITER, which only supports 128x128 blocks,\n+    # even when moe_backend is left on auto.\n+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER\", aiter_enabled)\n+    monkeypatch.setenv(\"VLLM_ROCM_USE_AITER_MOE\", \"1\")\n+    layer = _make_fp8_tp_experts(monkeypatch, 4, 0, \"auto\")\n+    assert layer.moe_config.tp_shard_with_padding is padded\n+    if padded:\n+        assert layer.moe_config.intermediate_size_per_partition == 256\n+        assert layer.moe_config.intermediate_pad == 0\n+        assert layer.quant_method.moe_block_shape == [128, 128]\n+    else:\n+        assert layer.moe_config.intermediate_size_per_partition == 160\n+        assert layer.moe_config.intermediate_pad is None\n+        assert layer.quant_method.moe_block_shape == [32, 32]\n+\n+\n @pytest.mark.parametrize(\n     \"field,value\",\n     [",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9ea3ce91ad13f804a694b96502f93520abfdb874/tests%2Fkernels%2Fmoe%2Ftest_fp8_tp_loading.py",
      "sha": "740d1ee33d3585531c2fae44c38d59b1286369f4",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9ea3ce91ad13f804a694b96502f93520abfdb874/vllm%2Fdistributed%2Fdevice_communicators%2Faiter_custom_all_reduce.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fdevice_communicators%2Faiter_custom_all_reduce.py?ref=9ea3ce91ad13f804a694b96502f93520abfdb874",
      "deletions": 0,
      "filename": "vllm/distributed/device_communicators/aiter_custom_all_reduce.py",
      "patch": "@@ -68,6 +68,10 @@ def registers_graph_buffers(self) -> bool:\n         )\n \n     def should_custom_ar(self, inp: torch.Tensor) -> bool:\n+        # AITER's gate checks only size and contiguity, but its kernel raises\n+        # for other dtypes (e.g. int8 FP8-embedding reductions); fall back.\n+        if inp.dtype not in (torch.float32, torch.float16, torch.bfloat16):\n+            return False\n         return self._impl.should_custom_ar(inp)\n \n     def custom_all_reduce(self, inp: torch.Tensor) -> torch.Tensor | None:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9ea3ce91ad13f804a694b96502f93520abfdb874/vllm%2Fdistributed%2Fdevice_communicators%2Faiter_custom_all_reduce.py",
