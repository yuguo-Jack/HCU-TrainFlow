      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9ea3ce91ad13f804a694b96502f93520abfdb874/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Foracle%2Ffp8.py",
