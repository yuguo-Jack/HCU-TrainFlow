      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7c5871cff2b13ce287d3226711d9303995ae1905/vllm%2Fv1%2Fattention%2Fops%2Ftriton_decode_attention.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fops%2Ftriton_decode_attention.py?ref=7c5871cff2b13ce287d3226711d9303995ae1905",
      "deletions": 1,
      "filename": "vllm/v1/attention/ops/triton_decode_attention.py",
      "patch": "@@ -623,14 +623,20 @@ def _fwd_kernel_stage2(\n             e_sum = e_sum * old_scale + exp_logic\n             e_max = n_e_max\n \n-    result = acc / e_sum\n+    # CUDA-graph decode pads inactive request slots with seq_len=0. Stage1\n+    # writes nothing for those rows, so e_sum stays 0 and acc/e_sum is 0/0=NaN.\n+    # Online FP8 MoE uses a per-tensor dynamic activation scale (amax over the\n+    # whole batch), so a single pad NaN poisons every co-batched request\n+    # (DeepSeek-V2-Lite TRITON_MLA + --quantization fp8, issue #57017).\n+    result = tl.where(e_sum > 0, acc / e_sum, 0.0)\n     if OUTPUT_FP16:\n         result = result.to(tl.float16)\n     tl.store(\n         o + cur_batch * stride_obs + cur_head * stride_oh + offs_d,\n         result,\n         mask=mask_d,\n     )\n+    # log(0) -> -inf; (-inf)+(-inf) is -inf (not NaN) for empty rows.\n     lse_val = e_max + tl.log(e_sum)\n     tl.store(\n         lse + cur_batch * stride_lse_bs + cur_head,",
