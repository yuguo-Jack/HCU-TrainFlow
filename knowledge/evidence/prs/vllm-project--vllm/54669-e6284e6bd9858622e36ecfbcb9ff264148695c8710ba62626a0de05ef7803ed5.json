      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/dab8bad37787163e6ecaa08d919b0a7a9a4b3569/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Foracle%2Fnvfp4.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Foracle%2Fnvfp4.py?ref=dab8bad37787163e6ecaa08d919b0a7a9a4b3569",
