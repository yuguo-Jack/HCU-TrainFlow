      "patch": "@@ -25,6 +25,12 @@ def register_api_routers(\n \n     register_models_api_router(app)\n \n+    from vllm.entrypoints.openai.parser.api_router import (\n+        register_parser_api_router,\n+    )\n+\n+    register_parser_api_router(app)\n+\n     from vllm.entrypoints.generate.structured_decisions.api_router import (\n         register_structured_decisions_api_router,\n     )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4dc1f05ae51b53dc13413f4dddc2f3671c3048d9/vllm%2Fentrypoints%2Flaunchers%2Fapi_server%2Frouters.py",
