      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftokenizers_%2Ftest_deepseek_history_tool_arguments.py?ref=d2f3d676490faec7a9d8480b2e32272de0f588a4",
      "deletions": 0,
      "filename": "tests/tokenizers_/test_deepseek_history_tool_arguments.py",
      "patch": "@@ -0,0 +1,49 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import pytest\n+\n+from vllm.tokenizers.deepseek_v4_encoding import (\n+    encode_arguments_to_dsml as encode_dsv4_arguments,\n+)\n+from vllm.tokenizers.deepseek_v32_encoding import (\n+    encode_arguments_to_dsml as encode_dsv32_arguments,\n+)\n+\n+\n+@pytest.mark.parametrize(\n+    \"encoder\",\n+    [encode_dsv4_arguments, encode_dsv32_arguments],\n+    ids=[\"deepseek_v4\", \"deepseek_v32\"],\n+)\n+def test_deepseek_history_tool_arguments_must_be_object(encoder):\n+    with pytest.raises(ValueError, match=\"must be a JSON object\"):\n+        encoder({\"name\": \"noop\", \"arguments\": \"-12\"})\n+\n+\n+@pytest.mark.parametrize(\n+    \"encoder\",\n+    [encode_dsv4_arguments, encode_dsv32_arguments],\n+    ids=[\"deepseek_v4\", \"deepseek_v32\"],\n+)\n+def test_deepseek_history_tool_arguments_must_be_valid_json(encoder):\n+    with pytest.raises(ValueError, match=\"must be a valid JSON object\"):\n+        encoder({\"name\": \"noop\", \"arguments\": \"{-12}\"})\n+\n+\n+@pytest.mark.parametrize(\n+    \"encoder\",\n+    [encode_dsv4_arguments, encode_dsv32_arguments],\n+    ids=[\"deepseek_v4\", \"deepseek_v32\"],\n+)\n+def test_deepseek_history_tool_arguments_preserve_objects(encoder):\n+    rendered = encoder(\n+        {\n+            \"name\": \"weather\",\n+            \"arguments\": '{\"city\": \"New York\", \"temp\": 72, \"alerts\": [\"wind\"]}',\n+        }\n+    )\n+\n+    assert '<｜DSML｜parameter name=\"city\" string=\"true\">New York' in rendered\n+    assert '<｜DSML｜parameter name=\"temp\" string=\"false\">72' in rendered\n+    assert '<｜DSML｜parameter name=\"alerts\" string=\"false\">[\"wind\"]' in rendered",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d2f3d676490faec7a9d8480b2e32272de0f588a4/tests%2Ftokenizers_%2Ftest_deepseek_history_tool_arguments.py",
      "sha": "9ea0f22f0256146f08bc3001153e225f355363aa",
      "status": "added"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d2f3d676490faec7a9d8480b2e32272de0f588a4/vllm%2Ftokenizers%2Fdeepseek_encoding_utils.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftokenizers%2Fdeepseek_encoding_utils.py?ref=d2f3d676490faec7a9d8480b2e32272de0f588a4",
      "deletions": 0,
      "filename": "vllm/tokenizers/deepseek_encoding_utils.py",
      "patch": "@@ -0,0 +1,24 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import json\n+from collections.abc import Mapping\n+from typing import Any\n+\n+\n+def load_tool_call_arguments(tool_call: Mapping[str, Any]) -> dict[str, Any]:\n+    raw_arguments = tool_call.get(\"arguments\")\n+    if isinstance(raw_arguments, str):\n+        try:\n+            arguments = json.loads(raw_arguments)\n+        except json.JSONDecodeError as exc:\n+            raise ValueError(\n+                \"DeepSeek tool call function.arguments must be a valid JSON object.\"\n+            ) from exc\n+    else:\n+        arguments = raw_arguments\n+\n+    if not isinstance(arguments, dict):\n+        raise ValueError(\"DeepSeek tool call function.arguments must be a JSON object.\")\n+\n+    return arguments",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d2f3d676490faec7a9d8480b2e32272de0f588a4/vllm%2Ftokenizers%2Fdeepseek_encoding_utils.py",
      "sha": "0f078d7e1ef595ead9ca229637a3005c26232bea",
      "status": "added"
    },
