      "deletions": 0,
      "filename": "tests/models/kimi_k3/amd_specialized_decode/test_runtime.py",
      "patch": "@@ -233,6 +233,15 @@ def test_moriio_consumer_is_supported(supported_vllm_config, read_mode, backend)\n     assert specialized_decode_config(supported_vllm_config) == DecodeConfig(q=8)\n \n \n+def test_mooncake_consumer_is_supported(supported_vllm_config):\n+    supported_vllm_config.kv_transfer_config = KVTransferConfig(\n+        kv_connector=\"MooncakeConnector\",\n+        kv_role=\"kv_consumer\",\n+        kv_connector_extra_config={\"mooncake_protocol\": \"rdma\"},\n+    )\n+    assert specialized_decode_config(supported_vllm_config) == DecodeConfig(q=8)\n+\n+\n @pytest.mark.parametrize(\n     \"overrides\",\n     [\n@@ -241,6 +250,8 @@ def test_moriio_consumer_is_supported(supported_vllm_config, read_mode, backend)\n         {\"kv_connector_module_path\": \"custom.connector\"},\n         {\"kv_role\": \"kv_producer\"},\n         {\"kv_role\": \"kv_both\"},\n+        {\"kv_connector\": \"MooncakeConnector\", \"kv_role\": \"kv_producer\"},\n+        {\"kv_connector\": \"MooncakeConnector\", \"kv_role\": \"kv_both\"},\n     ],\n )\n def test_unsupported_kv_transfer_is_refused(supported_vllm_config, overrides):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ef9202db6a03e38951fec2342da76330ca837d21/tests%2Fmodels%2Fkimi_k3%2Famd_specialized_decode%2Ftest_runtime.py",
