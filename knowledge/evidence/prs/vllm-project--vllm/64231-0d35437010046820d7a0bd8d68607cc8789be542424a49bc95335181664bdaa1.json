      "deletions": 0,
      "filename": "vllm/v1/worker/gpu/sample/output.py",
      "patch": "@@ -9,6 +9,7 @@\n import numpy as np\n import torch\n \n+from vllm.platforms import current_platform\n from vllm.triton_utils import tl, triton\n from vllm.v1.outputs import LogprobsTensors, SamplingMaskLists\n \n@@ -105,6 +106,36 @@ def from_logits(\n         num_sampled_tokens: torch.Tensor,\n         max_num_kept: int,\n         rows_per_request: int = 1,\n+    ) -> SamplingMaskTensors:\n+        \"\"\"Capture the finite-logit support of every row with a sampled token.\"\"\"\n+        if current_platform.is_xpu():\n+            _, vocab_size = logits.shape\n+            token_ids, packed_mask, counts = torch.ops._xpu_C.compact_sampling_mask(\n+                logits,\n+                cu_num_logits,\n+                num_sampled_tokens,\n+                max_num_kept,\n+                MAX_COMPACT_SUPPORT,\n+                rows_per_request,\n+            )\n+            return cls(token_ids, packed_mask, counts, vocab_size, rows_per_request)\n+        else:\n+            return cls._from_logits_triton(\n+                logits,\n+                cu_num_logits,\n+                num_sampled_tokens,\n+                max_num_kept,\n+                rows_per_request,\n+            )\n+\n+    @classmethod\n+    def _from_logits_triton(\n+        cls,\n+        logits: torch.Tensor,\n+        cu_num_logits: torch.Tensor,\n+        num_sampled_tokens: torch.Tensor,\n+        max_num_kept: int,\n+        rows_per_request: int = 1,\n     ) -> SamplingMaskTensors:\n         \"\"\"Capture committed target supports in fixed request-major slots.\"\"\"\n         num_reqs = num_sampled_tokens.shape[0]",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c0ae8e38a8e0e3e2040c107c4e6127ab71801c3c/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Foutput.py",
