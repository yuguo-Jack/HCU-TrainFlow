      "deletions": 0,
      "filename": "vllm/tracing/utils.py",
      "patch": "@@ -21,8 +21,12 @@ class SpanAttributes:\n     \"\"\"\n \n     # Attribute names copied from OTel semantic conventions to avoid version conflicts\n+    # Legacy names (deprecated in OTel GenAI semconv; kept for backward compatibility)\n     GEN_AI_USAGE_COMPLETION_TOKENS = \"gen_ai.usage.completion_tokens\"\n     GEN_AI_USAGE_PROMPT_TOKENS = \"gen_ai.usage.prompt_tokens\"\n+    # Current OTel GenAI semconv names\n+    GEN_AI_USAGE_INPUT_TOKENS = \"gen_ai.usage.input_tokens\"\n+    GEN_AI_USAGE_OUTPUT_TOKENS = \"gen_ai.usage.output_tokens\"\n     GEN_AI_REQUEST_MAX_TOKENS = \"gen_ai.request.max_tokens\"\n     GEN_AI_REQUEST_TOP_P = \"gen_ai.request.top_p\"\n     GEN_AI_REQUEST_TEMPERATURE = \"gen_ai.request.temperature\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/16be42caed26d568219179dff28cdfd6a96659ca/vllm%2Ftracing%2Futils.py",
      "sha": "1b56312b7ab1be581b2943242562136661e09200",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/16be42caed26d568219179dff28cdfd6a96659ca/vllm%2Fv1%2Fengine%2Foutput_processor.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Foutput_processor.py?ref=16be42caed26d568219179dff28cdfd6a96659ca",
      "deletions": 0,
      "filename": "vllm/v1/engine/output_processor.py",
      "patch": "@@ -757,10 +757,14 @@ def do_tracing(\n             ),\n             SpanAttributes.GEN_AI_LATENCY_E2E: e2e_time,\n             SpanAttributes.GEN_AI_LATENCY_TIME_IN_QUEUE: queued_time,\n+            # Emit both legacy and current OTel GenAI semconv names so existing\n+            # dashboards keep working while new consumers can use the spec names.\n             SpanAttributes.GEN_AI_USAGE_PROMPT_TOKENS: prompt_length,\n+            SpanAttributes.GEN_AI_USAGE_INPUT_TOKENS: prompt_length,\n             SpanAttributes.GEN_AI_USAGE_COMPLETION_TOKENS: (\n                 metrics.num_generation_tokens\n             ),\n+            SpanAttributes.GEN_AI_USAGE_OUTPUT_TOKENS: (metrics.num_generation_tokens),\n             SpanAttributes.GEN_AI_LATENCY_TIME_IN_MODEL_PREFILL: prefill_time,\n             SpanAttributes.GEN_AI_LATENCY_TIME_IN_MODEL_DECODE: decode_time,\n             SpanAttributes.GEN_AI_LATENCY_TIME_IN_MODEL_INFERENCE: inference_time,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/16be42caed26d568219179dff28cdfd6a96659ca/vllm%2Fv1%2Fengine%2Foutput_processor.py",
      "sha": "6423230f454954929c6bf44997628e466446adf8",
      "status": "modified"
    }
