  "files": [
    {
      "additions": 26,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9c9d0417da96b7bee18526aac195419aadb38dbe/tests%2Ftool_use%2Ftest_muse_glimmer.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_use%2Ftest_muse_glimmer.py?ref=9c9d0417da96b7bee18526aac195419aadb38dbe",
      "deletions": 0,
      "filename": "tests/tool_use/test_muse_glimmer.py",
      "patch": "@@ -23,6 +23,7 @@\n \"\"\"\n \n import json\n+import time\n from types import SimpleNamespace\n from typing import cast\n \n@@ -95,6 +96,31 @@ def _call(name):\n # ---------------------------------------------------------------- tool calls\n \n \n+def test_repeated_open_invoke_tags_are_not_quadratic():\n+    \"\"\"A 52 KB model output must not cost seconds of CPU to parse.\n+\n+    The attribute runs in _NAME_RE and _PARAM_RE were ``[^>]*?``, so output\n+    that opens tags without ever closing one retried the ``name=\"...\"`` search\n+    from every ``<atem:invoke`` position, each retry scanning to the end of the\n+    block: 13 KB cost 0.47 s and 52 KB cost 7.5 s, on the event loop. The\n+    output below is one complete invoke block on the tool channel, so\n+    extraction reaches both patterns. The bound is far above the repaired cost\n+    (~2 ms) and far below the old one, so it does not depend on runner speed.\n+    \"\"\"\n+    raw = (\n+        \"<|start|>assistant to=weather.get<|message|>\"\n+        + \"<atem:invoke \" * 4000\n+        + \"</atem:invoke><|eot|>\"\n+    )\n+\n+    started = time.perf_counter()\n+    out = MuseGlimmerToolParser.extract_tool_calls(T, raw, _NO_REQ)\n+    elapsed = time.perf_counter() - started\n+\n+    assert not out.tools_called\n+    assert elapsed < 1.0, f\"parsing {len(raw)} bytes took {elapsed:.1f}s\"\n+\n+\n def test_single_tool_call_after_reasoning():\n     raw = (\n         \"to=self<|message|>Let me check the weather.<|eom|>\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9c9d0417da96b7bee18526aac195419aadb38dbe/tests%2Ftool_use%2Ftest_muse_glimmer.py",
      "sha": "18f797cd83b152b44083546b119fe6c15c6380ec",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9c9d0417da96b7bee18526aac195419aadb38dbe/vllm%2Ftool_parsers%2Fmuse_glimmer_tool_parser.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fmuse_glimmer_tool_parser.py?ref=9c9d0417da96b7bee18526aac195419aadb38dbe",
      "deletions": 2,
      "filename": "vllm/tool_parsers/muse_glimmer_tool_parser.py",
      "patch": "@@ -93,9 +93,15 @@\n \n # --- Tool-call extraction (unchanged from MUSE_GLIMMER_RESPONSE_SCHEMA) -------------\n _INVOKE_RE = re.compile(r\"(<atem:invoke\\b.*?</atem:invoke>)\", re.DOTALL)\n-_NAME_RE = re.compile(r'<atem:invoke\\b[^>]*?\\bname=\"([^\"]+)\"')\n+# `[^<>]` and not `[^>]` for the attribute runs: a tag's attributes cannot\n+# contain either bracket, and stopping at `<` keeps the scan linear. With\n+# `[^>]`, model output that repeats an opening tag without ever closing it --\n+# `\"<atem:invoke \" * n` -- retries the attribute search from every one of those\n+# n positions, and each retry runs to the end of the text, so the cost grows\n+# with the square of the output length (52 KB took 7.5 s).\n+_NAME_RE = re.compile(r'<atem:invoke\\b[^<>]*?\\bname=\"([^\"]+)\"')\n _PARAM_RE = re.compile(\n-    r'<atem:parameter\\b[^>]*?\\bname=\"(?P<key>[^\"]+)\"[^>]*?>(?P<value>.*?)</atem:parameter>',\n+    r'<atem:parameter\\b[^<>]*?\\bname=\"(?P<key>[^\"]+)\"[^<>]*?>(?P<value>.*?)</atem:parameter>',\n     re.DOTALL,\n )\n _FUNCTION_CALLS_OPEN = \"<atem:function_calls>\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9c9d0417da96b7bee18526aac195419aadb38dbe/vllm%2Ftool_parsers%2Fmuse_glimmer_tool_parser.py",
      "sha": "13f497d2e2212551d227d7bb1ba39b330a4e97a0",
      "status": "modified"
    }
