    {
      "additions": 39,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9151dd05604951d176ed6831f92aa3f588c3e1c0/recipes%2Fmodels%2FQwen%2FQwen3.8-2.4T-A95B.yaml",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2FQwen%2FQwen3.8-2.4T-A95B.yaml?ref=9151dd05604951d176ed6831f92aa3f588c3e1c0",
      "deletions": 1,
      "filename": "recipes/models/Qwen/Qwen3.8-2.4T-A95B.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"Qwen\"\n   description: \"2.4T-parameter hybrid-attention MoE (~95B active) with linear attention on 69 of 92 layers, 512 routed experts, a built-in MTP draft head, 262K native context window and extensible to 1M context\"\n   date_added: 2026-08-10\n-  date_updated: 2026-09-14\n+  date_updated: 2026-10-30\n   tasks:\n     - text\n   # Measured, not a capacity claim. The previous headline said \"down to a single node\",\n@@ -151,6 +151,40 @@ variants:\n     vram_minimum_gb: 1373\n     supported_hardware: [b200, b300, gb200, gb300]\n     description: \"NVFP4 quantization + 25% uniform expert pruning via REAP — 4.25x compression with ~99% accuracy recovery\"\n+  redhat_nvfp4:\n+    model_id: \"RedHatAI/Qwen3.8-2.4T-A95B-NVFP4\"\n+    precision: nvfp4\n+    label: \"NVFP4 (RedHatAI)\"\n+    # Estimated from a related NVFP4 checkpoint; verify the shard index before\n+    # capacity planning.\n+    vram_minimum_gb: 1737\n+    supported_hardware: [b200, b300, gb200, gb300]\n+    description: \"RedHatAI NVFP4 MoE expert weights and activations; attention and other unquantized layers retain their source precision. VRAM minimum is an estimate pending exact shard-size inspection.\"\n+  redhat_nvfp4_fp8:\n+    model_id: \"RedHatAI/Qwen3.8-2.4T-A95B-NVFP4-FP8\"\n+    precision: nvfp4\n+    label: \"NVFP4 + FP8 (RedHatAI)\"\n+    # Mixed FP4 MoE experts and block-FP8 attention; confirm the exact checkpoint\n+    # footprint before using this estimate for capacity planning.\n+    vram_minimum_gb: 1770\n+    supported_hardware: [b200, b300, gb200, gb300]\n+    description: \"RedHatAI mixed precision: NVFP4 MoE expert weights/activations and block-FP8 attention weights/activations.\"\n+  redhat_nvfp4_reap50:\n+    model_id: \"RedHatAI/Qwen3.8-2.4T-A95B-NVFP4-REAP-50\"\n+    precision: nvfp4\n+    label: \"NVFP4-REAP-50 (RedHatAI)\"\n+    # Estimated from the existing NVFP4 footprint and 50% routed-expert pruning.\n+    # Replace with ceil(total safetensors bytes x 1.2) after inspecting the index.\n+    vram_minimum_gb: 1000\n+    supported_hardware: [b200, b300, gb200, gb300]\n+    description: \"RedHatAI NVFP4 checkpoint with 50% routed-expert REAP pruning; VRAM minimum is an estimate pending exact shard-size inspection.\"\n+  redhat_fp8:\n+    model_id: \"RedHatAI/Qwen3.8-2.4T-A95B-FP8\"\n+    precision: fp8\n+    label: \"FP8 (RedHatAI)\"\n+    # Sized from the corresponding 2.4T FP8 checkpoint; verify exact shard sizes.\n+    vram_minimum_gb: 2996\n+    description: \"RedHatAI FP8 checkpoint; VRAM minimum is an estimate pending exact shard-size inspection.\"\n \n # Full MoE strategy set. Note the 3.4x spread between variants: NVFP4/MXFP4 fit 8 GPUs\n # while BF16 needs 24, so no per-STRATEGY floor is set — one sized for BF16 would block\n@@ -428,6 +462,10 @@ guide: |\n   ## References\n \n   - Model card: https://huggingface.co/Qwen/Qwen3.8-2.4T-A95B\n+  - RedHatAI NVFP4 checkpoint: https://huggingface.co/RedHatAI/Qwen3.8-2.4T-A95B-NVFP4\n+  - RedHatAI mixed NVFP4+FP8 checkpoint: https://huggingface.co/RedHatAI/Qwen3.8-2.4T-A95B-NVFP4-FP8\n+  - RedHatAI NVFP4-REAP-50 checkpoint: https://huggingface.co/RedHatAI/Qwen3.8-2.4T-A95B-NVFP4-REAP-50\n+  - RedHatAI FP8 checkpoint: https://huggingface.co/RedHatAI/Qwen3.8-2.4T-A95B-FP8\n   - FP8 checkpoint: https://huggingface.co/Qwen/Qwen3.8-2.4T-A95B-FP8\n   - MXFP4 build (AMD): https://huggingface.co/Inferact/Qwen3.8-2.4T-A95B-MXFP4\n   - NVFP4 W4A4 build (NVIDIA): https://huggingface.co/Inferact/Qwen3.8-2.4T-A95B-NVFP4",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9151dd05604951d176ed6831f92aa3f588c3e1c0/recipes%2Fmodels%2FQwen%2FQwen3.8-2.4T-A95B.yaml",
      "sha": "f004cfc43a73ad86df13494b64df0634d500fe69",
      "status": "modified"
    },
    {
      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9151dd05604951d176ed6831f92aa3f588c3e1c0/recipes%2Fmodels%2FQwen%2FQwen3.8-27B.yaml",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2FQwen%2FQwen3.8-27B.yaml?ref=9151dd05604951d176ed6831f92aa3f588c3e1c0",
      "deletions": 3,
      "filename": "recipes/models/Qwen/Qwen3.8-27B.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"Qwen\"\n   description: \"27B-parameter dense hybrid-attention model with linear attention on 48 of 64 layers, a vision tower, a built-in MTP draft head, 262K native context window and extensible to 1M context\"\n   date_added: 2026-08-14\n-  date_updated: 2026-10-15\n+  date_updated: 2026-10-30\n   tasks:\n     - multimodal\n     - text\n@@ -97,7 +97,7 @@ features:\n         # off the TOP-level config (config/speculative.py), but this checkpoint carries it only\n         # under `text_config`, so the depth cannot be inferred here — omit it and startup fails.\n         description: \"Native MTP head, 3 draft tokens.\"\n-        variants: [default, fp8, nvfp4, nvfp4_nvidia, int4, mxfp4]\n+        variants: [default, fp8, nvfp4, nvfp4_nvidia, int4, mxfp4, redhat_nvfp4]\n         args:\n           - \"--speculative-config\"\n           - '{\"method\":\"mtp\",\"num_speculative_tokens\":3}'\n@@ -123,7 +123,7 @@ features:\n       dflash:\n         label: \"DFlash2\"\n         description: \"External DFlash2 drafter (incoai/Qwen3.8-27B-DFlash2). method is dflash; DFlash2 is selected by the draft architecture. Needs vLLM >=0.28.0, which shipped vllm-project/vllm#52816. num_speculative_tokens must be 7 (block_size 8 minus one).\"\n-        variants: [default]\n+        variants: [default, redhat_nvfp4]\n         args:\n           - \"--speculative-config\"\n           - '{\"method\":\"dflash\",\"model\":\"incoai/Qwen3.8-27B-DFlash2\",\"num_speculative_tokens\":7}'\n@@ -264,6 +264,14 @@ variants:\n     supported_hardware: [h100, h200, b200, b300, gb200, gb300, rtx_5090, rtx_5090_2x]\n     description: \"Red Hat AI compressed-tensors MXFP4 build — 19.8 GB: 1 GPU. True W4A4 on Blackwell (SM100+); W4A16 via Marlin on Hopper and elsewhere.\"\n \n+  redhat_nvfp4:\n+    model_id: \"RedHatAI/Qwen3.8-27B-NVFP4\"\n+    precision: nvfp4\n+    label: \"NVFP4 (RedHatAI)\"\n+    # The model card reports a 24.7 GB checkpoint; 1.2x load headroom rounds to 30 GB.\n+    vram_minimum_gb: 30\n+    supported_hardware: [b200, b300, gb200, gb300]\n+    description: \"RedHatAI mixed FP4/FP8 checkpoint: FP4 MLP projections, FP8 attention and final MLP layers, FP8 KV cache, and BF16 LM head.\"\n # Dense model: no routed experts, so none of the expert-parallel or PD strategies apply.\n #\n # `multi_node_tp` is deliberately ABSENT, unlike the 2.4T sibling. Multi-node TP sets\n@@ -484,6 +492,8 @@ guide: |\n \n   ## References\n \n+  - [RedHatAI Qwen3.8-27B NVFP4 checkpoint](https://huggingface.co/RedHatAI/Qwen3.8-27B-NVFP4)\n+\n   - Model card: https://huggingface.co/Qwen/Qwen3.8-27B\n   - FP8 checkpoint: https://huggingface.co/Qwen/Qwen3.8-27B-FP8\n   - NVFP4 build (NVIDIA): https://huggingface.co/nvidia/Qwen3.8-27B-NVFP4",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9151dd05604951d176ed6831f92aa3f588c3e1c0/recipes%2Fmodels%2FQwen%2FQwen3.8-27B.yaml",
      "sha": "a06028644a3dc9fc80992a8d3b608705cec97e03",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9151dd05604951d176ed6831f92aa3f588c3e1c0/recipes%2Fmodels%2FQwen%2FQwen3.8-Flash-Next.yaml",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2FQwen%2FQwen3.8-Flash-Next.yaml?ref=9151dd05604951d176ed6831f92aa3f588c3e1c0",
      "deletions": 16,
      "filename": "recipes/models/Qwen/Qwen3.8-Flash-Next.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"Qwen\"\n   description: \"Qwen4 architecture preview with a 125B-parameter main model, supplemented by an additional 51B N-gram embeddings, with 6B parameters activated per token.\"\n   date_added: 2026-08-26\n-  date_updated: 2026-10-27\n+  date_updated: 2026-10-30\n   tasks:\n     - multimodal\n     - text\n@@ -138,21 +138,13 @@ variants:\n           - \"--max-num-batched-tokens\"\n           - \"8192\"\n           - \"--enable-prefix-caching\"\n-          - \"--distributed-executor-backend\"\n-          - \"mp\"\n-          - \"-cc.mode\"\n-          - \"none\"\n-          - \"-cc.cudagraph_mode\"\n-          - \"full_decode_only\"\n-      rtx_pro_6000_4x:\n-        extra_args:\n-          - \"--max-num-seqs\"\n-          - \"16\"\n-          - \"--gpu-memory-utilization\"\n-          - \"0.95\"\n-          - \"--max-num-batched-tokens\"\n-          - \"8192\"\n-          - \"--enable-prefix-caching\"\n+\n+  redhat_nvfp4:\n+    model_id: \"RedHatAI/Qwen3.8-Flash-Next-NVFP4\"\n+    precision: nvfp4\n+    label: \"NVFP4 (RedHatAI)\"\n+    vram_minimum_gb: 130\n+    description: \"RedHatAI NVFP4 MoE expert weights and activations; non-expert weights retain BF16 precision\"\n   bf16:\n     model_id: \"Qwen/Qwen3.8-Flash-Next\"\n     precision: bf16\n@@ -504,6 +496,8 @@ guide: |\n \n   ## References\n \n+  - [RedHatAI Qwen3.8-Flash-Next NVFP4 checkpoint](https://huggingface.co/RedHatAI/Qwen3.8-Flash-Next-NVFP4)\n+\n   - [Qwen3.8-Flash-Next model card](https://huggingface.co/Qwen/Qwen3.8-Flash-Next)\n   - [Qwen3.8-Flash-Next FP8 checkpoint](https://huggingface.co/Qwen/Qwen3.8-Flash-Next-FP8)\n   - [Qwen3.8-Flash-Next: A New Architecture, Towards Ultimate Cost-Efficiency](https://qwen.ai/blog?id=qwen3.8-flash-next)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9151dd05604951d176ed6831f92aa3f588c3e1c0/recipes%2Fmodels%2FQwen%2FQwen3.8-Flash-Next.yaml",
      "sha": "b6cc9c3eed0187113d44804a2445e17388c39f08",
