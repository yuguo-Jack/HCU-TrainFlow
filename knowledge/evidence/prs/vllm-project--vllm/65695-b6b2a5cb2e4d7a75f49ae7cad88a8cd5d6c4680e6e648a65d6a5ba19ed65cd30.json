      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Fanthropic%2Ftest_anthropic_messages_conversion.py?ref=4805c2a637dff92a335007d0ac6aa4cb9460194f",
      "deletions": 1,
      "filename": "tests/entrypoints/anthropic/test_anthropic_messages_conversion.py",
      "patch": "@@ -1830,7 +1830,8 @@ async def chunk_input():\n class TestToolUseStopReason:\n     \"\"\"A response carrying a tool_use block reports ``stop_reason=\"tool_use\"``\n     even when the chat layer says ``finish_reason=\"stop\"``, as it does for a\n-    forced (named) tool. A call cut short by max_tokens or a stop string does not.\n+    forced (named) tool. A call cut short by max_tokens, a stop string, a stop\n+    token id or a natural EOS inside its arguments does not.\n     \"\"\"\n \n     @pytest.mark.parametrize(\n@@ -1871,6 +1872,14 @@ def test_non_streaming(self, finish_reason, stop_reason, expected):\n             ('{\"city\": \"Pa', \"length\", None, \"max_tokens\"),\n             ('{\"city\": \"Paris\"}', \"tool_calls\", \"</x>\", \"tool_use\"),\n             ('{\"city\": \"Pa', \"tool_calls\", \"</x>\", \"stop_sequence\"),\n+            # EOS or a stop token inside the arguments: the chat layer still\n+            # finishes with tool_calls, but the call is not complete\n+            ('{\"city\": \"Pa', \"tool_calls\", None, \"end_turn\"),\n+            ('{\"city\": \"Pa', \"stop\", None, \"end_turn\"),\n+            ('{\"city\": \"Pa', \"tool_calls\", 128009, \"end_turn\"),\n+            # no arguments streamed, as for a tool without parameters\n+            (\"\", \"tool_calls\", None, \"tool_use\"),\n+            (\"  \", \"tool_calls\", None, \"tool_use\"),\n         ],\n     )\n     async def test_streaming(self, args, finish_reason, stop_reason, expected):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4805c2a637dff92a335007d0ac6aa4cb9460194f/tests%2Fentrypoints%2Fanthropic%2Ftest_anthropic_messages_conversion.py",
      "sha": "c439fa0cdbe353f020110fca97a249416b8c0d95",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4805c2a637dff92a335007d0ac6aa4cb9460194f/vllm%2Fentrypoints%2Fanthropic%2Fserving.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fentrypoints%2Fanthropic%2Fserving.py?ref=4805c2a637dff92a335007d0ac6aa4cb9460194f",
      "deletions": 3,
      "filename": "vllm/entrypoints/anthropic/serving.py",
      "patch": "@@ -120,6 +120,7 @@ def _to_anthropic_stop_reason(\n     stop_reason: int | str | None,\n     tool_used: bool,\n     tool_complete: bool,\n+    tool_cut: bool = False,\n ) -> tuple[\n     Literal[\"end_turn\", \"max_tokens\", \"stop_sequence\", \"tool_use\"] | None,\n     str | None,\n@@ -131,6 +132,8 @@ def _to_anthropic_stop_reason(\n     ``tool_used`` records whether a ``tool_use`` block was produced.\n     ``max_tokens`` always wins. A matched stop string wins unless the tool\n     calls are complete (``tool_complete``): a call it cut short must not run.\n+    The same holds for a natural EOS or a stop token id inside a call's\n+    arguments (``tool_cut``): the turn ended, and the call did not.\n     \"\"\"\n     if finish_reason == \"length\":\n         return \"max_tokens\", None\n@@ -142,6 +145,8 @@ def _to_anthropic_stop_reason(\n     # an int stop-token-id or None (natural EOS) is not a stop sequence.\n     if isinstance(stop_reason, str):\n         return \"stop_sequence\", stop_reason\n+    if tool_cut:\n+        return \"end_turn\", None\n     if finish_reason == \"tool_calls\" or tool_used:\n         return \"tool_use\", None\n     return \"end_turn\", None\n@@ -1118,14 +1123,18 @@ def stop_and_flush() -> list[str]:\n                 if len(origin_chunk.choices) == 0:\n                     for event in stop_and_flush():\n                         yield event\n+                    tool_args = \"\".join(last_tool_args)\n+                    tool_complete = tool_used and _is_json(tool_args)\n+                    # Arguments were streamed but never became JSON. No\n+                    # arguments at all is a call without parameters.\n+                    tool_cut = tool_used and bool(tool_args.strip())\n                     anthropic_stop_reason, anthropic_stop_sequence = (\n                         _to_anthropic_stop_reason(\n                             finish_reason or \"stop\",\n                             stop_sequence,\n                             tool_used=tool_used,\n-                            tool_complete=(\n-                                tool_used and _is_json(\"\".join(last_tool_args))\n-                            ),\n+                            tool_complete=tool_complete,\n+                            tool_cut=tool_cut and not tool_complete,\n                         )\n                     )\n                     stop_delta = AnthropicDelta(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4805c2a637dff92a335007d0ac6aa4cb9460194f/vllm%2Fentrypoints%2Fanthropic%2Fserving.py",
      "sha": "f7d1192ad71f5ffc8265565611cf41c2e66fd846",
