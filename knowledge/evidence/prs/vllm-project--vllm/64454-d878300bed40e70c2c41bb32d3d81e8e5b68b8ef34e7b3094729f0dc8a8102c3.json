  "files": [
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ce3eae7e3cd3d666a1fdd364f59c5c470e4b23cb/benchmarks%2Fkernels%2Fbenchmark_activation.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/benchmarks%2Fkernels%2Fbenchmark_activation.py?ref=ce3eae7e3cd3d666a1fdd364f59c5c470e4b23cb",
      "deletions": 7,
      "filename": "benchmarks/kernels/benchmark_activation.py",
      "patch": "@@ -45,12 +45,15 @@ def benchmark_activation(\n         layer = op_registry[func_name]()\n \n     x = torch.randn(num_tokens, dim, dtype=dtype, device=device)\n-    compiled_layer = torch.compile(layer.forward_native)\n-\n-    if provider == \"custom\":\n-        fn = lambda: layer(x)\n+    if provider == \"native\":\n+        fn = lambda: layer.forward_native(x)\n+    elif provider == \"custom\":\n+        fn = lambda: layer.forward_cuda(x)\n     elif provider == \"compiled\":\n+        compiled_layer = torch.compile(layer.forward_native)\n         fn = lambda: compiled_layer(x)\n+    else:\n+        raise ValueError(f\"Unknown provider: {provider}\")\n \n     ms, min_ms, max_ms = triton.testing.do_bench_cudagraph(\n         fn, quantiles=[0.5, 0.2, 0.8]\n@@ -90,9 +93,9 @@ def benchmark_activation(\n             x_names=[\"batch_size\", \"seq_len\", \"intermediate_size\"],\n             x_vals=configs,\n             line_arg=\"provider\",\n-            line_vals=[\"custom\", \"compiled\"],\n-            line_names=[\"Custom OP\", \"Compiled\"],\n-            styles=[(\"blue\", \"-\"), (\"green\", \"-\")],\n+            line_vals=[\"native\", \"custom\", \"compiled\"],\n+            line_names=[\"PyTorch (eager)\", \"Custom OP\", \"Compiled\"],\n+            styles=[(\"red\", \"-\"), (\"blue\", \"-\"), (\"green\", \"-\")],\n             ylabel=\"ms\",\n             plot_name=f\"{func_name}-op-performance\",\n             args={},",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ce3eae7e3cd3d666a1fdd364f59c5c470e4b23cb/benchmarks%2Fkernels%2Fbenchmark_activation.py",
      "sha": "c09230e642834ffcc2b5da1c6e1e53dd70a270ad",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ce3eae7e3cd3d666a1fdd364f59c5c470e4b23cb/docs%2Fbenchmarking%2FREADME.md",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Fbenchmarking%2FREADME.md?ref=ce3eae7e3cd3d666a1fdd364f59c5c470e4b23cb",
      "deletions": 0,
      "filename": "docs/benchmarking/README.md",
      "patch": "@@ -6,3 +6,18 @@ vLLM provides comprehensive benchmarking tools for performance testing and evalu\n - **[Parameter Sweeps](./sweeps.md)**: Automate `vllm bench` runs for multiple configurations, useful for [optimization and tuning](../configuration/optimization.md).\n - **[Performance Dashboard](./dashboard.md)**: Automated CI that publishes benchmarks on each commit.\n - **[Benchmark using vLLM Recipes](../../tools/recipes/README.md)**: Use the Recipe conversion tool to generate `config.yaml` and `env.sh` from [vLLM Recipes](https://recipes.vllm.ai/) for Benchmarking.\n+\n+## Activation Kernel Benchmarks\n+\n+Compare eager PyTorch, a vLLM custom operator, and `torch.compile` using:\n+\n+```bash\n+python benchmarks/kernels/benchmark_activation.py --func-name silu_and_mul --dtype bfloat16\n+```\n+\n+The `PyTorch (eager)` column calls the layer's uncompiled `forward_native`\n+implementation. `Custom OP` calls the layer's CUDA implementation, and `Compiled`\n+compiles `forward_native` with `torch.compile`. All three use the same shape\n+grid, seeded input generation, and CUDA graph timing. Results are in\n+milliseconds and measure steady-state kernel latency; they exclude compilation\n+time and do not measure end-to-end serving throughput.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ce3eae7e3cd3d666a1fdd364f59c5c470e4b23cb/docs%2Fbenchmarking%2FREADME.md",
      "sha": "2dc6b346264cc6777ff80447fae7f6427f2edbeb",
      "status": "modified"
    }
  ],
