      "changes": 24,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fcompilation%2Fpasses%2Ffusion%2Frope_kvcache_fusion.py?ref=b0b88014dd96d54a53f6310914b2372316b9641d",
      "deletions": 6,
      "filename": "vllm/compilation/passes/fusion/rope_kvcache_fusion.py",
      "patch": "@@ -261,7 +261,10 @@ def register(self, pm_pass: PatternMatcherPass) -> None:\n             pattern, replacement = self._mk_pattern_with_layer_name_closure(_ln)\n \n         def fwd_and_view_to_reshape(*args, **kwargs) -> fx.GraphModule:\n-            gm = pm.fwd_only(*args, **kwargs)\n+            try:\n+                gm = pm.fwd_only(*args, **kwargs)\n+            except ValueError as e:\n+                raise RuntimeError(str(e)) from e\n             view_to_reshape(gm)\n             return gm\n \n@@ -393,7 +396,10 @@ def register(self, pm_pass: PatternMatcherPass) -> None:\n         # NOTE: use view_to_reshape to unify view/reshape to simplify\n         # pattern and increase matching opportunities\n         def fwd_and_view_to_reshape(*args, **kwargs) -> fx.GraphModule:\n-            gm = pm.fwd_only(*args, **kwargs)\n+            try:\n+                gm = pm.fwd_only(*args, **kwargs)\n+            except ValueError as e:\n+                raise RuntimeError(str(e)) from e\n             view_to_reshape(gm)\n             return gm\n \n@@ -430,10 +436,18 @@ def __init__(self, config: VllmConfig) -> None:\n         self.max_token_num = cc.pass_config.rope_kvcache_fusion_max_token_num\n \n         attn_layers = get_layers_from_vllm_config(config, Attention)\n-        # When _USE_LAYERNAME is enabled, layer_name is a wildcard so all\n-        # layers produce the same pattern — register once then break.\n+        seen_geometries: set[tuple[int, int, int, int]] = set()\n         for _, layer in attn_layers.items():\n             if layer.impl.fused_rope_kvcache_supported():\n+                geometry = (\n+                    layer.num_heads,\n+                    layer.num_kv_heads,\n+                    layer.head_size,\n+                    layer.head_size_v,\n+                )\n+                if _USE_LAYERNAME and geometry in seen_geometries:\n+                    continue\n+                seen_geometries.add(geometry)\n                 for is_neox in [True, False]:\n                     if _supports_static_q_fp8_quant_fusion():\n                         RopeStaticQQuantKVCachePattern(\n@@ -444,8 +458,6 @@ def __init__(self, config: VllmConfig) -> None:\n                         layer=layer,\n                         is_neox=is_neox,\n                     ).register(self.patterns)\n-                if _USE_LAYERNAME:\n-                    break\n \n         self.dump_patterns(config, self.patterns)\n ",
