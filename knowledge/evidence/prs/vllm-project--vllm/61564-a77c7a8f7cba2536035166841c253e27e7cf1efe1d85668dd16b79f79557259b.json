    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/b44b5a132b9b7c0b0bdf1d927bb843c8d71cb70e/vllm%2Fplatforms%2F__init__.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fplatforms%2F__init__.py?ref=b44b5a132b9b7c0b0bdf1d927bb843c8d71cb70e",
      "deletions": 0,
      "filename": "vllm/platforms/__init__.py",
      "patch": "@@ -57,6 +57,16 @@ def tpu_platform_plugin() -> str | None:\n def cuda_platform_plugin() -> str | None:\n     is_cuda = False\n     logger.debug(\"Checking if CUDA platform is available.\")\n+\n+    # Edge case: an XPU (Intel GPU) build running on a node that also exposes\n+    # NVIDIA GPUs / a working NVML. The wheel is built for XPU, so CUDA must\n+    # not activate here; otherwise both the CUDA and XPU plugins activate and\n+    # platform resolution raises \"Only one platform plugin can be activated\".\n+    # Defer to xpu_platform_plugin by declining, mirroring the cpu-build guard\n+    # below.\n+    if vllm_version_matches_substr(\"xpu\"):\n+        logger.debug(\"CUDA platform is not available because vLLM is built for XPU.\")\n+        return None\n     try:\n         from vllm.utils.import_utils import import_pynvml\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/b44b5a132b9b7c0b0bdf1d927bb843c8d71cb70e/vllm%2Fplatforms%2F__init__.py",
      "sha": "24b581aa3fe5e551dc64172f3a1170b6c8c31817",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/b44b5a132b9b7c0b0bdf1d927bb843c8d71cb70e/vllm%2Ftriton_utils%2Fimporting.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftriton_utils%2Fimporting.py?ref=b44b5a132b9b7c0b0bdf1d927bb843c8d71cb70e",
      "deletions": 0,
      "filename": "vllm/triton_utils/importing.py",
      "patch": "@@ -33,6 +33,17 @@\n             if name != \"cpu\" and x.driver and x.driver.is_active()\n         ]\n \n+        # Honor TRITON_DEFAULT_BACKEND (same env var Triton's own\n+        # `triton.runtime.driver._create_driver()` uses) so that on machines\n+        # with more than one active driver (e.g. a node with both NVIDIA and\n+        # Intel GPUs), the user can pin the backend vLLM should treat as the\n+        # single active one instead of disabling Triton entirely.\n+        selected_backend = os.environ.get(\"TRITON_DEFAULT_BACKEND\")\n+        if selected_backend:\n+            backend = backends.get(selected_backend)\n+            if backend is not None and backend.driver and backend.driver.is_active():\n+                active_drivers = [backend.driver]\n+\n         # Check Triton CPU\n         if vllm_version_matches_substr(\"cpu\"):\n             if \"cpu\" in backends:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/b44b5a132b9b7c0b0bdf1d927bb843c8d71cb70e/vllm%2Ftriton_utils%2Fimporting.py",
      "sha": "571abf4fdb2235ad877e1fb097267900ea610e57",
