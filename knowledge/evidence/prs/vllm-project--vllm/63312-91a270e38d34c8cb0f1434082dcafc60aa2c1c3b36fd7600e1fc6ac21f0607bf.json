  "files": [
    {
      "additions": 49,
      "blob_url": "https://github.com/vllm-project/vllm/blob/be3876c3664bd30b61dedda142c9d65784c6decd/tests%2Ftokenizers_%2Ftest_kimi_audio.py",
      "changes": 49,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftokenizers_%2Ftest_kimi_audio.py?ref=be3876c3664bd30b61dedda142c9d65784c6decd",
      "deletions": 0,
      "filename": "tests/tokenizers_/test_kimi_audio.py",
      "patch": "@@ -0,0 +1,49 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import json\n+from pathlib import Path\n+\n+import pybase64\n+\n+from vllm.tokenizers.kimi_audio import KimiAudioTokenizer\n+\n+SPECIAL_TOKENS = {\"<|im_end|>\": 100, \"<|im_user_msg_start|>\": 101}\n+\n+\n+def test_config_special_tokens_are_consistent(tmp_path: Path):\n+    \"\"\"Config special tokens behave the same in decode, encode and conversion.\"\"\"\n+    vocab_file = tmp_path / \"tiktoken.model\"\n+    vocab_file.write_text(\n+        \"\\n\".join(\n+            f\"{pybase64.b64encode(token.encode()).decode()} {rank}\"\n+            for rank, token in enumerate([\"hello\", \" world\"])\n+        )\n+        + \"\\n\",\n+        encoding=\"utf-8\",\n+    )\n+    (tmp_path / \"tokenizer_config.json\").write_text(\n+        json.dumps(\n+            {\n+                \"added_tokens_decoder\": {\n+                    str(token_id): {\"content\": token, \"special\": True}\n+                    for token, token_id in SPECIAL_TOKENS.items()\n+                }\n+            }\n+        ),\n+        encoding=\"utf-8\",\n+    )\n+    tokenizer = KimiAudioTokenizer(\n+        vocab_file=vocab_file, name_or_path=str(tmp_path), truncation_side=\"left\"\n+    )\n+\n+    # `TokenizerLike.all_special_tokens` is a `list[str]`: `_build_drop_info`\n+    # and the detokenizer compare its entries against token strings.\n+    assert all(isinstance(token, str) for token in tokenizer.all_special_tokens)\n+    # `convert_ids_to_tokens` must skip exactly what `decode` skips, including\n+    # config-declared tokens that never enter `added_tokens_decoder`.\n+    ids = list(SPECIAL_TOKENS.values())\n+    assert tokenizer.decode(ids, skip_special_tokens=True) == \"\"\n+    assert tokenizer.convert_ids_to_tokens(ids, skip_special_tokens=True) == []\n+    # Config-declared special tokens must also be encodable from prompt text.\n+    assert tokenizer.encode(\"hello<|im_end|>\")[-1] == SPECIAL_TOKENS[\"<|im_end|>\"]",
      "raw_url": "https://github.com/vllm-project/vllm/raw/be3876c3664bd30b61dedda142c9d65784c6decd/tests%2Ftokenizers_%2Ftest_kimi_audio.py",
      "sha": "56a6fbeed630e8af9fd6899c8ffdce3f32fe3494",
      "status": "added"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/vllm-project/vllm/blob/be3876c3664bd30b61dedda142c9d65784c6decd/vllm%2Ftokenizers%2Fkimi_audio.py",
      "changes": 47,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftokenizers%2Fkimi_audio.py?ref=be3876c3664bd30b61dedda142c9d65784c6decd",
      "deletions": 23,
      "filename": "vllm/tokenizers/kimi_audio.py",
      "patch": "@@ -20,6 +20,17 @@\n \n logger = init_logger(__name__)\n \n+# Special tokens the Kimi-Audio chat template emits. Registered even when\n+# tokenizer_config.json does not list them.\n+KIMIAUDIO_SPECIAL_TOKENS: dict[str, int] = {\n+    \"<|im_media_begin|>\": 151661,\n+    \"<|im_media_end|>\": 151663,\n+    \"<|im_kimia_text_blank|>\": 151666,\n+    \"<|im_msg_end|>\": 151645,\n+    \"<|im_kimia_user_msg_start|>\": 151670,\n+    \"<|im_kimia_assistant_msg_start|>\": 151671,\n+}\n+\n \n def _load_tiktoken_encoding(\n     vocab_file: Path, special_tokens: dict[str, int]\n@@ -161,6 +172,10 @@ def __init__(\n         # Add Kimi-Audio special tokens\n         self._add_kimiaudio_special_tokens()\n \n+        # `decode()` skips every token listed in tokenizer_config.json; keep the\n+        # same set of ids here so `convert_ids_to_tokens()` skips them too.\n+        self._special_ids = frozenset(self._special_tokens.values())\n+\n         # Set default special token IDs (will be updated when special tokens are added)\n         self._bos_token_id = 151643  # Kimi-Audio BOS\n         self._eos_token_id = 151644  # Kimi-Audio EOS\n@@ -175,16 +190,7 @@ def _add_kimiaudio_special_tokens(self) -> None:\n         \"\"\"Add Kimi-Audio special tokens to the tokenizer.\"\"\"\n         # Tokens should already be in self._special_tokens from tokenizer_config.json\n         # Just add them to added_tokens_decoder for compatibility\n-        kimiaudio_special_tokens = {\n-            \"<|im_media_begin|>\": 151661,\n-            \"<|im_media_end|>\": 151663,\n-            \"<|im_kimia_text_blank|>\": 151666,\n-            \"<|im_msg_end|>\": 151645,\n-            \"<|im_kimia_user_msg_start|>\": 151670,\n-            \"<|im_kimia_assistant_msg_start|>\": 151671,\n-        }\n-\n-        for token_str, token_id in kimiaudio_special_tokens.items():\n+        for token_str, token_id in KIMIAUDIO_SPECIAL_TOKENS.items():\n             # Only add if not already present\n             if token_id not in self._added_tokens_decoder:\n                 self._added_tokens_decoder[token_id] = AddedToken(\n@@ -201,7 +207,9 @@ def num_special_tokens_to_add(self) -> int:\n \n     @property\n     def all_special_tokens(self) -> list[str]:\n-        return list(self._added_tokens_decoder.values())\n+        # `added_tokens_decoder` stores AddedToken objects, which never compare\n+        # equal to (or hash like) the token strings used by callers.\n+        return [str(token) for token in self._added_tokens_decoder.values()]\n \n     @property\n     def all_special_ids(self) -> list[int]:\n@@ -287,14 +295,9 @@ def encode(\n         # Allow Kimi-Audio special tokens to be encoded\n         tokens = self._tokenizer.encode(\n             text,\n-            allowed_special={\n-                \"<|im_media_begin|>\",\n-                \"<|im_media_end|>\",\n-                \"<|im_kimia_text_blank|>\",\n-                \"<|im_msg_end|>\",\n-                \"<|im_kimia_user_msg_start|>\",\n-                \"<|im_kimia_assistant_msg_start|>\",\n-            },\n+            # Any special token from tokenizer_config.json can appear in the\n+            # rendered prompt; tiktoken raises on anything not listed here.\n+            allowed_special=set(self._special_tokens) | KIMIAUDIO_SPECIAL_TOKENS.keys(),\n         )\n         if truncation:\n             tokens = self._maybe_truncate(tokens, max_length)\n@@ -307,9 +310,7 @@ def decode(\n         if isinstance(ids, int):\n             ids = [ids]\n         if skip_special_tokens:\n-            # Skip tokens that are in special_tokens (loaded from config)\n-            special_ids = set(self._special_tokens.values())\n-            ids = [token_id for token_id in ids if token_id not in special_ids]\n+            ids = [token_id for token_id in ids if token_id not in self._special_ids]\n         return self._tokenizer.decode(ids)\n \n     @overload\n@@ -328,7 +329,7 @@ def convert_ids_to_tokens(\n     ) -> list[str]:\n         tokens = []\n         for token_id in ids:\n-            if skip_special_tokens and token_id in self._added_tokens_decoder:\n+            if skip_special_tokens and token_id in self._special_ids:\n                 continue\n             tokens.append(self._id_to_token.get(token_id, \"<|unk|>\"))\n         return tokens",
      "raw_url": "https://github.com/vllm-project/vllm/raw/be3876c3664bd30b61dedda142c9d65784c6decd/vllm%2Ftokenizers%2Fkimi_audio.py",
      "sha": "e40d407a00209c33874b4ea5d0a2a343bf102867",
