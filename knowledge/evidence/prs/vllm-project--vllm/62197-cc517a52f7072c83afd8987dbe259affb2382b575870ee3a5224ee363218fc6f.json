      "additions": 54,
      "blob_url": "https://github.com/vllm-project/vllm/blob/47b8a1356cb8b63e74be92147012b38095d728f8/tests%2Fkernels%2Fattention%2Ftest_rocm_triton_attn_dsv4.py",
      "changes": 54,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fattention%2Ftest_rocm_triton_attn_dsv4.py?ref=47b8a1356cb8b63e74be92147012b38095d728f8",
      "deletions": 0,
      "filename": "tests/kernels/attention/test_rocm_triton_attn_dsv4.py",
      "patch": "@@ -1050,6 +1050,60 @@ def test_sparse_attn_decode_ragged_kernel() -> None:\n     torch.testing.assert_close(actual, expected, atol=2e-2, rtol=2e-2)\n \n \n+@torch.inference_mode()\n+def test_sparse_attn_decode_reports_only_rows_it_rotated() -> None:\n+    \"\"\"Callers inverse-RoPE only the rows past the returned count, so on every\n+    arch (split-K reduce or the un-tuned fallback) fusing must end up where\n+    decoding unfused and rotating every row afterwards does.\"\"\"\n+    from vllm.v1.attention.ops.rocm_aiter_mla_sparse import (\n+        rocm_inverse_rope_rows_,\n+        rocm_sparse_attn_decode,\n+    )\n+\n+    device = torch.device(\"cuda\")\n+    torch.manual_seed(2)\n+    q = torch.randn(2, 16, HEAD_DIM, dtype=torch.bfloat16, device=device) * 0.125\n+    kv = torch.randn(6, HEAD_DIM, dtype=torch.bfloat16, device=device) * 0.125\n+    swa_cache = _pack_fp8_ds_mla_cache(\n+        kv, block_size=4, use_fnuz=current_platform.is_fp8_fnuz()\n+    )\n+    swa_indices = torch.tensor([[0, 2, 4], [1, 3, 5]], dtype=torch.int32, device=device)\n+    swa_lens = torch.tensor([3, 3], dtype=torch.int32, device=device)\n+    positions = torch.tensor([7, 11], dtype=torch.int64, device=device)\n+    cos_sin_cache = _random_cos_sin_cache(16, device)\n+\n+    def decode(fuse: bool) -> torch.Tensor:\n+        out = torch.empty_like(q)\n+        rotated = rocm_sparse_attn_decode(\n+            q=q,\n+            kv_cache=None,\n+            swa_k_cache=swa_cache,\n+            swa_only=True,\n+            topk_indices=None,\n+            topk_lens=None,\n+            swa_indices=swa_indices,\n+            swa_lens=swa_lens,\n+            swa_ragged_indices=None,\n+            swa_ragged_indptr=None,\n+            topk_ragged_indices=None,\n+            topk_ragged_indptr=None,\n+            attn_sink=None,\n+            scale=HEAD_DIM**-0.5,\n+            head_dim=HEAD_DIM,\n+            nope_head_dim=NOPE_HEAD_DIM,\n+            rope_head_dim=ROPE_HEAD_DIM,\n+            output=out,\n+            inv_rope_positions=positions if fuse else None,\n+            inv_rope_cos_sin_cache=cos_sin_cache if fuse else None,\n+        )\n+        rocm_inverse_rope_rows_(\n+            out[rotated:], positions[rotated:], cos_sin_cache, ROPE_HEAD_DIM\n+        )\n+        return out\n+\n+    torch.testing.assert_close(decode(True), decode(False), atol=2e-2, rtol=2e-2)\n+\n+\n @requires_gfx950\n @torch.inference_mode()\n def test_sparse_attn_decode_scrubs_untrusted_cache_by_default() -> None:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/47b8a1356cb8b63e74be92147012b38095d728f8/tests%2Fkernels%2Fattention%2Ftest_rocm_triton_attn_dsv4.py",
      "sha": "eab8b470c61e0bca047364b9ccfafd827e2ccf6d",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/47b8a1356cb8b63e74be92147012b38095d728f8/vllm%2Fv1%2Fattention%2Fops%2Frocm_aiter_mla_sparse.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fops%2Frocm_aiter_mla_sparse.py?ref=47b8a1356cb8b63e74be92147012b38095d728f8",
      "deletions": 1,
      "filename": "vllm/v1/attention/ops/rocm_aiter_mla_sparse.py",
      "patch": "@@ -4607,7 +4607,10 @@ def rocm_sparse_attn_decode(\n     assert output is not None\n     if direct_out is None:\n         output.copy_(attn_out.to(output.dtype))\n-    return output.shape[0] if inv_rope_positions is not None else 0\n+    # Only the split-K reduce (gfx942/gfx950) folds in the inverse RoPE; the\n+    # un-tuned fallback kernel leaves every row to the caller's standalone pass.\n+    fused_inv_rope = inv_rope_positions is not None and (_ON_GFX942 or _ON_GFX950)\n+    return output.shape[0] if fused_inv_rope else 0\n \n \n @triton.jit(do_not_specialize=[\"token_offset\"])",
      "raw_url": "https://github.com/vllm-project/vllm/raw/47b8a1356cb8b63e74be92147012b38095d728f8/vllm%2Fv1%2Fattention%2Fops%2Frocm_aiter_mla_sparse.py",
      "sha": "462325de4b1448f4aa7d2eedd657534f5641befb",
      "status": "modified"
    }
