      "additions": 66,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8981f138932a0ca620887dc99e1fef29f9bb36ce/tests%2Fmodel_executor%2Ftest_minimax_m3_msa_warmup.py",
      "changes": 66,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodel_executor%2Ftest_minimax_m3_msa_warmup.py?ref=8981f138932a0ca620887dc99e1fef29f9bb36ce",
      "deletions": 0,
      "filename": "tests/model_executor/test_minimax_m3_msa_warmup.py",
      "patch": "@@ -0,0 +1,66 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import importlib\n+import sys\n+from types import SimpleNamespace\n+from unittest.mock import Mock\n+\n+import pytest\n+\n+from vllm.model_executor.warmup import minimax_m3_msa_warmup as warmup\n+\n+_MINIMAX_MODEL_MODULE = \"vllm.models.minimax_m3.nvidia.model\"\n+\n+\n+def test_warmup_module_does_not_import_minimax_model(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    monkeypatch.delitem(sys.modules, warmup.__name__)\n+    monkeypatch.setitem(sys.modules, _MINIMAX_MODEL_MODULE, None)\n+\n+    importlib.import_module(warmup.__name__)\n+\n+\n+@pytest.mark.parametrize(\n+    (\"architecture\", \"is_blackwell\", \"should_run\"),\n+    [\n+        (\"DiffusionGemmaForBlockDiffusion\", True, False),\n+        (\"MiniMaxM3SparseForCausalLM\", False, False),\n+        (\"MiniMaxM3SparseForCausalLM\", True, True),\n+    ],\n+)\n+def test_warmup_requires_supported_model_and_platform(\n+    monkeypatch: pytest.MonkeyPatch,\n+    architecture: str,\n+    is_blackwell: bool,\n+    should_run: bool,\n+) -> None:\n+    class SparseAttention:\n+        pass\n+\n+    monkeypatch.setitem(\n+        sys.modules,\n+        _MINIMAX_MODEL_MODULE,\n+        SimpleNamespace(MiniMaxM3SparseAttention=SparseAttention),\n+    )\n+    monkeypatch.setattr(warmup.current_platform, \"is_cuda\", lambda: True)\n+    monkeypatch.setattr(\n+        warmup.current_platform,\n+        \"is_device_capability_family\",\n+        lambda capability: is_blackwell and capability == 100,\n+    )\n+    get_model = Mock(return_value=SimpleNamespace(modules=lambda: [SparseAttention()]))\n+    dummy_run = Mock()\n+    worker = SimpleNamespace(\n+        get_model=get_model,\n+        model_runner=SimpleNamespace(_dummy_run=dummy_run),\n+        vllm_config=SimpleNamespace(\n+            model_config=SimpleNamespace(architecture=architecture)\n+        ),\n+    )\n+\n+    warmup.minimax_m3_msa_warmup(worker)\n+\n+    assert get_model.called is should_run\n+    assert dummy_run.called is should_run",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8981f138932a0ca620887dc99e1fef29f9bb36ce/tests%2Fmodel_executor%2Ftest_minimax_m3_msa_warmup.py",
      "sha": "22c53b398fff9640567bb723a216be5372ae7674",
      "status": "added"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8981f138932a0ca620887dc99e1fef29f9bb36ce/vllm%2Fmodel_executor%2Fwarmup%2Fminimax_m3_msa_warmup.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fwarmup%2Fminimax_m3_msa_warmup.py?ref=8981f138932a0ca620887dc99e1fef29f9bb36ce",
      "deletions": 5,
      "filename": "vllm/model_executor/warmup/minimax_m3_msa_warmup.py",
      "patch": "@@ -4,7 +4,6 @@\n from typing import TYPE_CHECKING\n \n from vllm.logger import init_logger\n-from vllm.models.minimax_m3.nvidia.model import MiniMaxM3SparseAttention\n from vllm.platforms import current_platform\n from vllm.tracing import instrument\n \n@@ -13,9 +12,26 @@\n \n logger = init_logger(__name__)\n \n+_MINIMAX_M3_ARCHITECTURES = frozenset(\n+    {\n+        \"MiniMaxM3MTP\",\n+        \"MiniMaxM3SparseForCausalLM\",\n+        \"MiniMaxM3SparseForConditionalGeneration\",\n+    }\n+)\n+\n \n @instrument(span_name=\"MiniMax M3 MSA warmup\")\n def minimax_m3_msa_warmup(worker: \"Worker\") -> None:\n+    if worker.vllm_config.model_config.architecture not in _MINIMAX_M3_ARCHITECTURES:\n+        return\n+    if not (\n+        current_platform.is_cuda() and current_platform.is_device_capability_family(100)\n+    ):\n+        return\n+\n+    from vllm.models.minimax_m3.nvidia.model import MiniMaxM3SparseAttention\n+\n     sparse_module = next(\n         (\n             module\n@@ -26,10 +42,6 @@ def minimax_m3_msa_warmup(worker: \"Worker\") -> None:\n     )\n     if sparse_module is None:\n         return\n-    if not (\n-        current_platform.is_cuda() and current_platform.is_device_capability_family(100)\n-    ):\n-        return\n \n     logger.info(\"Warming up MiniMax M3 MSA kernels.\")\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8981f138932a0ca620887dc99e1fef29f9bb36ce/vllm%2Fmodel_executor%2Fwarmup%2Fminimax_m3_msa_warmup.py",
