  "files": [
    {
      "additions": 39,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7cbe0ed5005cf5b447242c574a9953a663f3aac3/tests%2Fv1%2Fattention%2Ftest_rocm_aiter_fa_swa_decode_tables.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fattention%2Ftest_rocm_aiter_fa_swa_decode_tables.py?ref=7cbe0ed5005cf5b447242c574a9953a663f3aac3",
      "deletions": 0,
      "filename": "tests/v1/attention/test_rocm_aiter_fa_swa_decode_tables.py",
      "patch": "@@ -0,0 +1,39 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+from types import SimpleNamespace\n+\n+import torch\n+\n+from vllm.utils.math_utils import cdiv\n+from vllm.v1.attention.backends.rocm_aiter_fa import AiterFlashAttentionMetadataBuilder\n+\n+\n+def test_swa_decode_tables_match_reference():\n+    # window and block edges, and a window start inside a block\n+    window, block_size = 2048, 16\n+    lens = torch.tensor(\n+        [*range(1, 3 * window, 37), window, window + 1, 200000], dtype=torch.int32\n+    )\n+    n, width = len(lens), cdiv(window, block_size) + 1\n+    full = torch.randperm(n * (cdiv(int(lens.max()), block_size) + 3)).view(n, -1)\n+    full = full.to(torch.int32)\n+    builder = SimpleNamespace(\n+        aot_sliding_window=(window - 1, 0),\n+        block_size=block_size,\n+        _swa_block_table=torch.zeros(n, width, dtype=torch.int32),\n+        _swa_seq_lens=torch.zeros(n, dtype=torch.int32),\n+        _swa_block_offsets=torch.arange(width),\n+    )\n+    table, seq_lens, max_seq_len = (\n+        AiterFlashAttentionMetadataBuilder._build_swa_decode_tables(\n+            builder, full, lens, n, int(lens.max())\n+        )\n+    )\n+\n+    assert table is not None and seq_lens is not None\n+    first = (lens - window).clamp(min=0) // block_size\n+    index = (first[:, None] + torch.arange(width)).clamp(max=full.shape[1] - 1)\n+    assert torch.equal(table, full.gather(1, index))\n+    assert torch.equal(seq_lens, lens - first * block_size)\n+    assert seq_lens.dtype == torch.int32\n+    assert max_seq_len == window + block_size - 1",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7cbe0ed5005cf5b447242c574a9953a663f3aac3/tests%2Fv1%2Fattention%2Ftest_rocm_aiter_fa_swa_decode_tables.py",
      "sha": "d13be07d5bce6ae0474c6a52bbde76dd4cf86d43",
      "status": "added"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7cbe0ed5005cf5b447242c574a9953a663f3aac3/vllm%2Fv1%2Fattention%2Fbackends%2Frocm_aiter_fa.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Frocm_aiter_fa.py?ref=7cbe0ed5005cf5b447242c574a9953a663f3aac3",
      "deletions": 3,
      "filename": "vllm/v1/attention/backends/rocm_aiter_fa.py",
      "patch": "@@ -566,14 +566,15 @@ def _build_swa_decode_tables(\n         assert self._swa_seq_lens is not None and self._swa_block_offsets is not None\n         window = self.aot_sliding_window[0] + 1\n         lens = seq_lens[:num_decodes]\n-        first_block = torch.clamp(lens - window, min=0) // self.block_size\n-        index = (first_block.to(torch.int64)[:, None] + self._swa_block_offsets).clamp_(\n+        first_block = (lens - window).clamp_(min=0) // self.block_size\n+        # int64 offsets promote the sum, so the gather index needs no cast copy\n+        index = (self._swa_block_offsets + first_block[:, None]).clamp_(\n             max=block_table.shape[1] - 1\n         )\n         swa_block_table = self._swa_block_table[:num_decodes]\n         torch.gather(block_table[:num_decodes], 1, index, out=swa_block_table)\n         swa_seq_lens = self._swa_seq_lens[:num_decodes]\n-        swa_seq_lens.copy_(lens - first_block * self.block_size)\n+        torch.sub(lens, first_block, alpha=self.block_size, out=swa_seq_lens)\n         return (\n             swa_block_table,\n             swa_seq_lens,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7cbe0ed5005cf5b447242c574a9953a663f3aac3/vllm%2Fv1%2Fattention%2Fbackends%2Frocm_aiter_fa.py",
      "sha": "7520421361d0c89a751f355b73ccd7480bcba3a3",
      "status": "modified"
    }
  ],
