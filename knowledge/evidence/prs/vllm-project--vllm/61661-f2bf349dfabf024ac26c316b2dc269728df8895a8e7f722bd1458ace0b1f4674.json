      "blob_url": "https://github.com/vllm-project/vllm/blob/85e420be189c80620eb9faf657a7c8acf335f420/tests%2Fdetokenizer%2Ftest_stop_string_while_stop_model_terminates.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fdetokenizer%2Ftest_stop_string_while_stop_model_terminates.py?ref=85e420be189c80620eb9faf657a7c8acf335f420",
      "deletions": 0,
      "filename": "tests/detokenizer/test_stop_string_while_stop_model_terminates.py",
      "patch": "@@ -8,6 +8,7 @@\n from vllm.v1.engine import EngineCoreOutput, EngineCoreRequest, FinishReason\n from vllm.v1.engine.detokenizer import BaseIncrementalDetokenizer\n from vllm.v1.engine.output_processor import OutputProcessor\n+from vllm.v1.metrics.stats import IterationStats\n from vllm.v1.outputs import LogprobsLists, SamplingMaskLists\n \n \n@@ -202,3 +203,28 @@ def test_stop_string_trims_speculative_overflow(\n     assert result.sampling_mask.token_ids == [[token] for token in expected_token_ids]\n     assert result.routed_experts is not None\n     assert result.routed_experts.ravel().tolist() == expected_token_ids\n+\n+\n+def test_stop_string_trim_updates_generation_token_stats(\n+    include_stop_str_in_output: bool,\n+):\n+    \"\"\"Tokens dropped past a stop string are not counted as generated.\"\"\"\n+    token_ids = [ord(c) for c in \"abcdef\"]\n+    req = _make_request(\n+        stop=[\"cd\"], include_stop_str_in_output=include_stop_str_in_output\n+    )\n+    req.external_req_id = req.request_id\n+    processor = OutputProcessor(tokenizer=None, log_stats=True)\n+    processor.add_request(req, prompt=None)\n+    processor.request_states[req.request_id].detokenizer = _DummyDetokenizer(req)\n+\n+    iteration_stats = IterationStats()\n+    outputs = processor.process_outputs(\n+        [EngineCoreOutput(request_id=req.request_id, new_token_ids=token_ids)],\n+        engine_core_timestamp=0.0,\n+        iteration_stats=iteration_stats,\n+    )\n+\n+    assert outputs.request_outputs[0].outputs[0].token_ids == token_ids[:4]\n+    assert iteration_stats.num_generation_tokens == 4\n+    assert iteration_stats.finished_requests[0].num_generation_tokens == 4",
      "raw_url": "https://github.com/vllm-project/vllm/raw/85e420be189c80620eb9faf657a7c8acf335f420/tests%2Fdetokenizer%2Ftest_stop_string_while_stop_model_terminates.py",
      "sha": "a42c9eb47e33fa34b5f8f9ed524f6af9fd5af662",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/85e420be189c80620eb9faf657a7c8acf335f420/vllm%2Fv1%2Fengine%2Foutput_processor.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Foutput_processor.py?ref=85e420be189c80620eb9faf657a7c8acf335f420",
      "deletions": 2,
      "filename": "vllm/v1/engine/output_processor.py",
      "patch": "@@ -772,7 +772,7 @@ def process_outputs(\n                     finish_reason = FinishReason.STOP\n                     stop_reason = stop_string\n                     self._trim_surplus_tokens(\n-                        req_state, engine_core_output, num_prev_tokens\n+                        req_state, engine_core_output, num_prev_tokens, iteration_stats\n                     )\n \n                 if engine_core_output.new_sampling_mask is not None:\n@@ -833,7 +833,10 @@ def process_outputs(\n \n     @staticmethod\n     def _trim_surplus_tokens(\n-        req_state: RequestState, output: EngineCoreOutput, num_prev_tokens: int\n+        req_state: RequestState,\n+        output: EngineCoreOutput,\n+        num_prev_tokens: int,\n+        iteration_stats: IterationStats | None,\n     ) -> None:\n         \"\"\"Drop new tokens generated past a stop string matched by the\n         detokenizer, e.g. when multiple tokens are accepted in one step.\"\"\"\n@@ -843,6 +846,11 @@ def _trim_surplus_tokens(\n         if num_dropped <= 0:\n             return\n         del output.new_token_ids[num_kept:]\n+        # The stats for this step were counted before the stop string matched.\n+        if iteration_stats is not None:\n+            assert req_state.stats is not None\n+            iteration_stats.num_generation_tokens -= num_dropped\n+            req_state.stats.num_generation_tokens -= num_dropped\n         if output.new_logprobs is not None:\n             output.new_logprobs = output.new_logprobs.slice_request(0, num_kept)\n         if output.new_sampling_mask is not None:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/85e420be189c80620eb9faf657a7c8acf335f420/vllm%2Fv1%2Fengine%2Foutput_processor.py",
      "sha": "6f098fdb18c86fc85d3164990a228596eb679933",
