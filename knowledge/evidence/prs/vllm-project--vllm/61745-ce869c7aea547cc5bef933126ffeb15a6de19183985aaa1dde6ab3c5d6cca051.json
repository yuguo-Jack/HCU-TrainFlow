  "files": [
    {
      "additions": 9,
      "blob_url": "https://github.com/vllm-project/vllm/blob/6ec6e5943465973bc1ee9fcfce05e6e1030e1bfe/tests%2Fv1%2Fshutdown%2Futils.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fshutdown%2Futils.py?ref=6ec6e5943465973bc1ee9fcfce05e6e1030e1bfe",
      "deletions": 1,
      "filename": "tests/v1/shutdown/utils.py",
      "patch": "@@ -2,5 +2,13 @@\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n \"\"\"Shutdown test utils.\"\"\"\n \n-SHUTDOWN_TEST_TIMEOUT_SEC = 120\n+from vllm.platforms import current_platform\n+\n+# XPU forces the `spawn` multiprocessing start method (see\n+# `vllm.platforms.xpu`), which re-imports modules and re-initializes the\n+# device runtime in each child process instead of inheriting them via\n+# `fork`'s copy-on-write memory. That makes EngineCore/Worker subprocess\n+# startup noticeably slower and more variable, so give it extra headroom to\n+# avoid flaky timeouts.\n+SHUTDOWN_TEST_TIMEOUT_SEC = 240 if current_platform.is_xpu() else 120\n SHUTDOWN_TEST_THRESHOLD_BYTES = 2 * 2**30",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6ec6e5943465973bc1ee9fcfce05e6e1030e1bfe/tests%2Fv1%2Fshutdown%2Futils.py",
      "sha": "48f1660f2e30a6ce5ed0b144cac85bd33586cf85",
      "status": "modified"
    }
