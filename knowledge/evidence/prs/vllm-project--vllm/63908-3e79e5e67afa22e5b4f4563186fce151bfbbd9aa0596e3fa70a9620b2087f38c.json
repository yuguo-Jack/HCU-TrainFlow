  "files": [
    {
      "additions": 67,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4c620e4e65fe3ff53934f14b530d3d1b7e0b14ac/tests%2Fmodels%2Fqwen4_exp%2Ftest_nvfp4_csf_decode.py",
      "changes": 67,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Fqwen4_exp%2Ftest_nvfp4_csf_decode.py?ref=4c620e4e65fe3ff53934f14b530d3d1b7e0b14ac",
      "deletions": 0,
      "filename": "tests/models/qwen4_exp/test_nvfp4_csf_decode.py",
      "patch": "@@ -0,0 +1,67 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import torch\n+\n+from vllm.models.qwen4_exp.nvidia.model import (\n+    decode_nvfp4_csf,\n+    maybe_decode_nvfp4_csf_weights,\n+)\n+\n+\n+def test_decode_nvfp4_csf_dtype_and_shape():\n+    \"\"\"Verify decode_nvfp4_csf returns float8_e4m3fn and correct shapes.\"\"\"\n+    num_slabs = 4\n+    slab_bytes = 48  # (48 - 16) // 16 = 2 packed cols -> 4 unpacked cols\n+    num_rows = num_slabs * 16\n+    expected_cols = 4\n+\n+    fixed = torch.zeros((num_slabs, slab_bytes), dtype=torch.uint8)\n+    fixed[:, :16] = 0x38  # 1.0 in FP8 E4M3FN\n+\n+    decoded = decode_nvfp4_csf(fixed)\n+    assert decoded.dtype == torch.float8_e4m3fn\n+    assert decoded.shape == (num_rows, expected_cols)\n+\n+\n+def test_decode_nvfp4_csf_with_exceptions():\n+    \"\"\"Verify exceptions overwrite decoded base+nibbles correctly.\"\"\"\n+    num_slabs = 2\n+    slab_bytes = 32\n+    num_rows = num_slabs * 16\n+\n+    fixed = torch.zeros((num_slabs, slab_bytes), dtype=torch.uint8)\n+    # Pack an exception at flat position 5 with byte value 0x40\n+    target_pos = 5\n+    exact_byte = 0x40\n+    packed_val = target_pos | (exact_byte << 24)\n+    exceptions = torch.tensor([packed_val], dtype=torch.int32)\n+\n+    decoded = decode_nvfp4_csf(fixed, exceptions)\n+    assert decoded.dtype == torch.float8_e4m3fn\n+\n+    raw_bytes = decoded.view(torch.uint8).flatten()\n+    assert raw_bytes[target_pos].item() == exact_byte\n+\n+\n+def test_maybe_decode_nvfp4_csf_weights():\n+    \"\"\"Verify paired CSF weight keys are fused and decoded.\"\"\"\n+    prefix = \"model.layers.0.mlp.experts.0.gate_up_proj.weight_scale\"\n+    fixed_name = f\"{prefix}.nvfp4_csf_fixed\"\n+    exc_name = f\"{prefix}.nvfp4_csf_exceptions\"\n+\n+    fixed_tensor = torch.zeros((2, 32), dtype=torch.uint8)\n+    exc_tensor = torch.empty((0,), dtype=torch.int32)\n+\n+    weights = [\n+        (fixed_name, fixed_tensor),\n+        (exc_name, exc_tensor),\n+        (\"unrelated_layer.weight\", torch.ones((4, 4), dtype=torch.bfloat16)),\n+    ]\n+\n+    decoded_weights = dict(maybe_decode_nvfp4_csf_weights(weights))\n+    assert prefix in decoded_weights\n+    assert fixed_name not in decoded_weights\n+    assert exc_name not in decoded_weights\n+    assert decoded_weights[prefix].dtype == torch.float8_e4m3fn\n+    assert \"unrelated_layer.weight\" in decoded_weights",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4c620e4e65fe3ff53934f14b530d3d1b7e0b14ac/tests%2Fmodels%2Fqwen4_exp%2Ftest_nvfp4_csf_decode.py",
      "sha": "6e2c0d8d85e9b0663c0e4b0a97bc04f041bb20f9",
      "status": "added"
    },
    {
      "additions": 66,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4c620e4e65fe3ff53934f14b530d3d1b7e0b14ac/vllm%2Fmodels%2Fqwen4_exp%2Fnvidia%2Fmodel.py",
      "changes": 66,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Fqwen4_exp%2Fnvidia%2Fmodel.py?ref=4c620e4e65fe3ff53934f14b530d3d1b7e0b14ac",
      "deletions": 0,
      "filename": "vllm/models/qwen4_exp/nvidia/model.py",
      "patch": "@@ -147,8 +147,71 @@ def _remap_qsa_cache_scale_name(\n     \"_v_scale\",\n     \"_weight_scale\",\n     \"_input_scale\",\n+    \".nvfp4_csf_fixed\",\n+    \".nvfp4_csf_exceptions\",\n ]\n \n+\n+def decode_nvfp4_csf(\n+    fixed: torch.Tensor, exceptions: torch.Tensor | None = None\n+) -> torch.Tensor:\n+    num_slabs, slab_bytes = fixed.shape\n+    num_rows = num_slabs * 16\n+    packed_cols = (slab_bytes - 16) // 16\n+    num_cols = packed_cols * 2\n+\n+    base = fixed[:, :16].reshape(-1, 1)\n+    stream = fixed[:, 16:].reshape(num_rows, packed_cols)\n+\n+    low_nibble = stream & 0x0F\n+    high_nibble = (stream >> 4) & 0x0F\n+\n+    nibbles = torch.stack([low_nibble, high_nibble], dim=-1).reshape(\n+        num_rows, num_cols\n+    )\n+    scales = base + nibbles\n+\n+    if exceptions is not None and exceptions.numel() > 0:\n+        flat = exceptions.to(torch.int64)\n+        pos = flat & 0x00FFFFFF\n+        exact_bytes = ((flat >> 24) & 0xFF).to(torch.uint8)\n+        scales.view(-1).scatter_(0, pos, exact_bytes)\n+\n+    return scales.view(torch.float8_e4m3fn)\n+\n+\n+def maybe_decode_nvfp4_csf_weights(\n+    weights: Iterable[tuple[str, torch.Tensor]],\n+) -> Iterable[tuple[str, torch.Tensor]]:\n+    pending_fixed: dict[str, torch.Tensor] = {}\n+    pending_exc: dict[str, torch.Tensor] = {}\n+\n+    for name, tensor in weights:\n+        if name.endswith(\".weight_scale.nvfp4_csf_fixed\"):\n+            prefix = name[:-len(\".nvfp4_csf_fixed\")]\n+            if prefix in pending_exc:\n+                exc = pending_exc.pop(prefix)\n+                decoded = decode_nvfp4_csf(tensor, exc)\n+                yield prefix, decoded\n+            else:\n+                pending_fixed[prefix] = tensor\n+        elif name.endswith(\".weight_scale.nvfp4_csf_exceptions\"):\n+            prefix = name[:-len(\".nvfp4_csf_exceptions\")]\n+            if prefix in pending_fixed:\n+                fixed = pending_fixed.pop(prefix)\n+                decoded = decode_nvfp4_csf(fixed, tensor)\n+                yield prefix, decoded\n+            else:\n+                pending_exc[prefix] = tensor\n+        else:\n+            yield name, tensor\n+\n+    for prefix in list(pending_fixed.keys()):\n+        fixed = pending_fixed.pop(prefix)\n+        exc = pending_exc.pop(prefix, None)\n+        decoded = decode_nvfp4_csf(fixed, exc)\n+        yield prefix, decoded\n+\n # The checkpoint stores these projections separately; runtime packs each group\n # into adjacent logical shards of a MergedColumnParallelLinear.\n _EXTRA_WEIGHTS_MAPPER = WeightsMapper(\n@@ -645,6 +708,7 @@ def forward(\n         return sample_hidden_states\n \n     def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:\n+        weights = maybe_decode_nvfp4_csf_weights(weights)\n         weights = (\n             (\n                 _remap_qsa_cache_scale_name(name, self._qsa_layer_ids),\n@@ -920,6 +984,7 @@ def get_mrope_input_positions(\n         return positions.unsqueeze(0).expand(3, -1), 0\n \n     def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:\n+        weights = maybe_decode_nvfp4_csf_weights(weights)\n         mapper = self.hf_to_vllm_mapper | WeightsMapper(\n             orig_to_new_substr={\"mtp.\": None}\n         )\n@@ -1119,6 +1184,7 @@ def forward(\n         return hidden_states\n \n     def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:\n+        weights = maybe_decode_nvfp4_csf_weights(weights)\n         mapper = self.hf_to_vllm_mapper | WeightsMapper(\n             orig_to_new_substr={\"mtp.\": None},\n             orig_to_new_prefix={\"visual.\": None} if self.language_model_only else {},",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4c620e4e65fe3ff53934f14b530d3d1b7e0b14ac/vllm%2Fmodels%2Fqwen4_exp%2Fnvidia%2Fmodel.py",
      "sha": "aeb31bc9b282f5e0899e9c263df4d17ba27b605e",
      "status": "modified"
    }
