      "deletions": 0,
      "filename": ".buildkite/test_areas/models_multimodal.yaml",
      "patch": "@@ -116,6 +116,11 @@ steps:\n   timeout_in_minutes: 98\n   device: h200_18gb\n   parallelism: 4\n+  # The processor tests are CPU-bound, and the container sees every host CPU\n+  # while sharing it with the other MIG slices. Cap the thread pools so each\n+  # shard does not size them to the whole host.\n+  env:\n+    OMP_NUM_THREADS: \"4\"\n   source_file_dependencies:\n   - vllm/\n   - \"!vllm/distributed/kv_transfer/\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/561bc251dabf4a52ff69f7074e43221c84dbdc90/.buildkite%2Ftest_areas%2Fmodels_multimodal.yaml",
