      "blob_url": "https://github.com/vllm-project/vllm/blob/cf3b37d2caa9a493bf6b4f74bc4c75e340320555/tests%2Freasoning%2Ftest_qwen3_reasoning_parser.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Freasoning%2Ftest_qwen3_reasoning_parser.py?ref=cf3b37d2caa9a493bf6b4f74bc4c75e340320555",
      "deletions": 20,
      "filename": "tests/reasoning/test_qwen3_reasoning_parser.py",
      "patch": "@@ -59,14 +59,11 @@ def qwen3_tokenizer(request):\n     \"content\": \"This is the rest\",\n }\n \n-# --- No think tokens at all (thinking enabled, truncated) ---\n-\n-# With thinking enabled (default), no think tokens means the output was\n-# truncated before </think> could be generated. All output is reasoning.\n+# --- No </think> in output ---\n WITHOUT_THINK = {\n     \"output\": \"This is the rest\",\n-    \"reasoning\": \"This is the rest\",\n-    \"content\": None,\n+    \"reasoning\": None,\n+    \"content\": \"This is the rest\",\n }\n # In streaming, the parser cannot distinguish \"thinking disabled\" from\n # \"reasoning in progress\" when no think tokens have appeared yet.\n@@ -109,12 +106,10 @@ def qwen3_tokenizer(request):\n     \"reasoning\": \"This is a reasoning\\nsection\",\n     \"content\": \"This is the rest\\nThat\",\n }\n-# Truncated output: <think> present but no </think> (thinking enabled).\n-# Everything is reasoning because the output was cut off mid-thought.\n ONLY_OPEN_TAG = {\n     \"output\": \"<think>This is a reasoning section\",\n-    \"reasoning\": \"This is a reasoning section\",\n-    \"content\": None,\n+    \"reasoning\": None,\n+    \"content\": \"This is a reasoning section\",\n }\n \n ONLY_OPEN_TAG_STREAM = {\n@@ -123,15 +118,13 @@ def qwen3_tokenizer(request):\n     \"content\": None,\n }\n \n-# Truncated output without <think> prefix (Qwen3.5 style where <think>\n-# is in the prompt). No </think> means truncation — all is reasoning.\n-TRUNCATED_NO_START_TOKEN = {\n+NO_THINK_CLOSE_NO_START_TOKEN = {\n     \"output\": \"This is a reasoning section\",\n-    \"reasoning\": \"This is a reasoning section\",\n-    \"content\": None,\n+    \"reasoning\": None,\n+    \"content\": \"This is a reasoning section\",\n }\n \n-TRUNCATED_NO_START_TOKEN_STREAM = {\n+NO_THINK_CLOSE_NO_START_TOKEN_STREAM = {\n     \"output\": \"This is a reasoning section\",\n     \"reasoning\": \"This is a reasoning section\",\n     \"content\": None,\n@@ -210,13 +203,13 @@ def qwen3_tokenizer(request):\n     ),\n     pytest.param(\n         False,\n-        TRUNCATED_NO_START_TOKEN,\n-        id=\"truncated_no_start_token\",\n+        NO_THINK_CLOSE_NO_START_TOKEN,\n+        id=\"no_think_close_no_start_token\",\n     ),\n     pytest.param(\n         True,\n-        TRUNCATED_NO_START_TOKEN_STREAM,\n-        id=\"truncated_no_start_token_stream\",\n+        NO_THINK_CLOSE_NO_START_TOKEN_STREAM,\n+        id=\"no_think_close_no_start_token_stream\",\n     ),\n     pytest.param(\n         False,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cf3b37d2caa9a493bf6b4f74bc4c75e340320555/tests%2Freasoning%2Ftest_qwen3_reasoning_parser.py",
      "sha": "66a529b92f2352927826e2fc33ea7bda948ac19b",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/cf3b37d2caa9a493bf6b4f74bc4c75e340320555/vllm%2Freasoning%2Fqwen3_reasoning_parser.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Freasoning%2Fqwen3_reasoning_parser.py?ref=cf3b37d2caa9a493bf6b4f74bc4c75e340320555",
      "deletions": 8,
      "filename": "vllm/reasoning/qwen3_reasoning_parser.py",
      "patch": "@@ -123,11 +123,9 @@ def extract_reasoning(\n         If <think> is present (e.g. from a different template), it is\n         stripped before extraction.\n \n-        When thinking is explicitly disabled and no </think> appears,\n-        returns (None, model_output) — all output is content.\n-        Otherwise (thinking enabled, default), a missing </think> means\n-        the output was truncated and everything is reasoning:\n-        returns (model_output, None).\n+        When no </think> appears, returns (None, model_output) so direct\n+        answers are routed to content. Truncated responses are indicated\n+        separately by finish_reason=\"length\".\n \n         Returns:\n             tuple[Optional[str], Optional[str]]: reasoning content and content\n@@ -153,9 +151,9 @@ def extract_reasoning(\n             reasoning = model_output[:tool_call_index]\n             content = model_output[tool_call_index:]\n             return reasoning or None, content or None\n-        # Thinking enabled but no </think>: output was truncated.\n-        # Everything generated so far is reasoning.\n-        return model_output, None\n+        # When thinking is explicitly disabled and no </think> appears,\n+        # returns (None, model_output) — all output is content.\n+        return None, model_output\n \n     def extract_reasoning_streaming(\n         self,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cf3b37d2caa9a493bf6b4f74bc4c75e340320555/vllm%2Freasoning%2Fqwen3_reasoning_parser.py",
      "sha": "5f67f4f3fa3161a4767cfcf4cee56bfa342d5958",
      "status": "modified"
    }
