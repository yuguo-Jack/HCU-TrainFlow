      "deletions": 2,
      "filename": "vllm/v1/structured_output/backend_guidance.py",
      "patch": "@@ -112,7 +112,7 @@ def compile_grammar(\n         grammar_spec: str,\n         stop_token_ids: set[int] | None = None,\n     ) -> StructuredOutputGrammar:\n-        self.serialized_grammar = serialize_guidance_grammar(\n+        serialized_grammar = serialize_guidance_grammar(\n             request_type,\n             grammar_spec,\n             self.disable_any_whitespace,\n@@ -121,7 +121,7 @@ def compile_grammar(\n \n         ll_matcher = llguidance.LLMatcher(\n             self.ll_tokenizer,\n-            self.serialized_grammar,\n+            serialized_grammar,\n             log_level=int(os.environ.get(\"LLGUIDANCE_LOG_LEVEL\", \"1\")),\n         )\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/eacf96515b156b102924a200e04683bf286a7abc/vllm%2Fv1%2Fstructured_output%2Fbackend_guidance.py",
