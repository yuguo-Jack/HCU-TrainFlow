      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ae6d43501b30a0c03b526a09e2f6aba806ec563a/.buildkite%2Ftest_areas%2Fdistributed.yaml",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Ftest_areas%2Fdistributed.yaml?ref=ae6d43501b30a0c03b526a09e2f6aba806ec563a",
      "deletions": 4,
      "filename": ".buildkite/test_areas/distributed.yaml",
      "patch": "@@ -511,22 +511,24 @@ steps:\n \n - label: \":nvidia: (H100) [Nightly] Distributed Features\"\n   key: distributed-tests-2xh100-2xmi300\n+  automatic_shard: true\n   timeout_in_minutes: 30\n   device: h100\n   optional: true\n   working_dir: \"/vllm-workspace/\"\n   num_devices: 2\n   commands:\n-    - pytest -v -s tests/distributed/test_context_parallel.py\n-    - pytest -v -s tests/distributed/test_dcp_direct_a2a_lse_reduce.py -k direct_a2a_matches_reference\n     - VLLM_ALLOW_INSECURE_SERIALIZATION=1 python3 examples/rl/rlhf_async_new_apis.py\n     - VLLM_USE_DEEP_GEMM=1 VLLM_LOGGING_LEVEL=DEBUG python3 examples/features/data_parallel/data_parallel_offline.py --model=Qwen/Qwen1.5-MoE-A2.7B -tp=1 -dp=2 --max-model-len=2048 --all2all-backend=deepep_high_throughput\n+    - pytest -v -s tests/distributed/test_context_parallel.py\n+    - pytest -v -s tests/distributed/test_dcp_direct_a2a_lse_reduce.py -k direct_a2a_matches_reference\n     - pytest -v -s tests/v1/distributed/test_dbo.py\n     - VLLM_ALLOW_INSECURE_SERIALIZATION=1 pytest -v -s tests/distributed/test_weight_transfer.py\n     - VLLM_ALLOW_INSECURE_SERIALIZATION=1 pytest -v -s tests/distributed/test_weight_transfer_m2n.py\n     - pytest -v -s tests/distributed/test_packed_tensor.py\n   mirror:\n     amd:\n+      automatic_shard: true\n       label: ':amd: (MI355) Distributed Features'\n       dind: false\n       device: mi355_2\n@@ -565,11 +567,11 @@ steps:\n       - tests/v1/attention/test_rocm_mla_dcp_context.py\n       - vllm/v1/attention/ops/rocm_aiter_mla_prefill.py\n       commands:\n-      - pytest -v -s tests/distributed/test_context_parallel.py\n-      - pytest -v -s tests/v1/attention/test_rocm_mla_dcp_context.py\n       - VLLM_ALLOW_INSECURE_SERIALIZATION=1 python3 examples/rl/rlhf_async_new_apis.py\n       - VLLM_LOGGING_LEVEL=DEBUG python3 examples/features/data_parallel/data_parallel_offline.py --model=Qwen/Qwen1.5-MoE-A2.7B -tp=1 -dp=2 --max-model-len=2048 --all2all-backend=deepep_high_throughput\n       - VLLM_LOGGING_LEVEL=DEBUG python3 examples/features/data_parallel/data_parallel_offline.py --model=Qwen/Qwen1.5-MoE-A2.7B -tp=1 -dp=2 --max-model-len=2048 --all2all-backend=allgather_reducescatter --disable-nccl-for-dp-synchronization\n+      - pytest -v -s tests/distributed/test_context_parallel.py\n+      - pytest -v -s tests/v1/attention/test_rocm_mla_dcp_context.py\n       - pytest -v -s tests/v1/distributed/test_dbo.py\n       - VLLM_ALLOW_INSECURE_SERIALIZATION=1 pytest -v -s tests/distributed/test_weight_transfer.py\n       - pytest -v -s tests/distributed/test_packed_tensor.py",
