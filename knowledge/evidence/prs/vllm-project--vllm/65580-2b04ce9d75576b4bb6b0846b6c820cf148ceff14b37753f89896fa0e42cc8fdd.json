      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/37f513aff11869633cfc4617ca20a69df659d21d/vllm%2Fv1%2Fcore%2Fkv_cache_manager.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fcore%2Fkv_cache_manager.py?ref=37f513aff11869633cfc4617ca20a69df659d21d",
      "deletions": 1,
      "filename": "vllm/v1/core/kv_cache_manager.py",
      "patch": "@@ -560,9 +560,21 @@ def allocate_slots(\n         # Free on the processed-token basis: in-flight steps' attention windows\n         # still read blocks below the optimistic boundary, and rejected spec\n         # tokens can roll it back.\n+        processed_tokens = max(\n+            0, total_computed_tokens - request.num_in_flight_tokens\n+        )\n+        if (\n+            num_external_computed_tokens > 0\n+            and total_computed_tokens == request.num_tokens\n+        ):\n+            # Full-prompt remote KV load: scheduler recomputes the last prompt token\n+            # to sample the first output token. Retain one extra token of history so\n+            # position N - W remains in an allocated block.\n+            processed_tokens = max(0, processed_tokens - 1)\n+\n         self.coordinator.remove_skipped_blocks(\n             request.request_id,\n-            max(0, total_computed_tokens - request.num_in_flight_tokens),\n+            processed_tokens,\n             num_prompt_tokens=request.num_prompt_tokens,\n         )\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/37f513aff11869633cfc4617ca20a69df659d21d/vllm%2Fv1%2Fcore%2Fkv_cache_manager.py",
      "sha": "cc5645d685e6608ef2f803549b2d7786dbf30dc2",
      "status": "modified"
    }
