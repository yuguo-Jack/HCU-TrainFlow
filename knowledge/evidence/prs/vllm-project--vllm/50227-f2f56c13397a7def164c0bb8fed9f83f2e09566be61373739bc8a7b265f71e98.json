      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8d47140484da9ed04c3ddc31e72faaca50ee1107/vllm%2Fmodel_executor%2Fmodels%2Fllama4.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fllama4.py?ref=8d47140484da9ed04c3ddc31e72faaca50ee1107",
      "deletions": 1,
      "filename": "vllm/model_executor/models/llama4.py",
      "patch": "@@ -527,9 +527,13 @@ def load_moe_expert_weights(\n \n             # Load the weight into the module parameter with corresponding\n             # shard id and expert id.\n+            # Ensure the CPU tensor is contiguous before the copy to GPU,\n+            # otherwise the copy from a non-contiguous CPU tensor is extremely\n+            # slow (e.g., 3-4s per weight for ModelOpt Llama-4 checkpoints\n+            # which use fused expert weights with transpose/chunk/indexing).\n             weight_loader(\n                 param,\n-                new_loaded_weight,\n+                new_loaded_weight.contiguous(),\n                 full_param_name,\n                 shard_id=shard_id,\n                 expert_id=expert_id,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8d47140484da9ed04c3ddc31e72faaca50ee1107/vllm%2Fmodel_executor%2Fmodels%2Fllama4.py",
      "sha": "0eb490077e1a1b862ca6666d492ec1febb5d509c",
      "status": "modified"
    }
