      "additions": 55,
      "blob_url": "https://github.com/vllm-project/vllm/blob/b207e36fc67cc1d65957737eeeb566c3d554eaea/tests%2Fentrypoints%2Flaunchers%2Fapi_server%2Ftest_api_server_process_manager.py",
      "changes": 62,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Flaunchers%2Fapi_server%2Ftest_api_server_process_manager.py?ref=b207e36fc67cc1d65957737eeeb566c3d554eaea",
      "deletions": 7,
      "filename": "tests/entrypoints/launchers/api_server/test_api_server_process_manager.py",
      "patch": "@@ -547,6 +547,8 @@ def fake_popen(cmd, **kwargs):\n     output_listener = make_zmq_listener(\"tcp://127.0.0.1:0\", zmq.PULL)\n     input_fd = input_listener.socket.fileno()\n     output_fd = output_listener.socket.fileno()\n+    http_fd = sock.fileno()\n+    grpc_fd = grpc_sock.fileno()\n     try:\n         monkeypatch.setattr(subprocess_mod, \"Popen\", fake_popen)\n         RustFrontendProcessManager(\n@@ -561,20 +563,66 @@ def fake_popen(cmd, **kwargs):\n             grpc_sock=grpc_sock,\n         )\n         [(cmd, kwargs)] = popen_calls\n-        grpc_fd = grpc_sock.fileno()\n         flag_index = cmd.index(\"--grpc-listen-fd\")\n         assert cmd[flag_index + 1] == str(grpc_fd)\n-        assert list(kwargs[\"pass_fds\"]) == [\n-            sock.fileno(),\n-            input_fd,\n-            output_fd,\n-            grpc_fd,\n-        ]\n+        assert list(kwargs[\"pass_fds\"]) == [http_fd, input_fd, output_fd, grpc_fd]\n     finally:\n         sock.close()\n         grpc_sock.close()\n \n \n+def test_rust_frontend_parent_releases_listening_sockets(monkeypatch):\n+    \"\"\"The parent's copies must not keep the ports listening once Rust has them.\"\"\"\n+    import subprocess as subprocess_mod\n+\n+    from vllm.entrypoints.common.cli_args import make_arg_parser\n+    from vllm.utils.argparse_utils import FlexibleArgumentParser\n+    from vllm.v1.utils import RustFrontendProcessManager\n+\n+    args = make_arg_parser(FlexibleArgumentParser()).parse_args(\n+        [\"--model\", \"org/model\", \"--grpc-port\", \"50051\"]\n+    )\n+\n+    class _FakeProc:\n+        pid = 4321\n+        returncode = 0\n+\n+        def poll(self):\n+            return 0\n+\n+        def wait(self, timeout=None):\n+            return 0\n+\n+    listeners = []\n+    for _ in range(2):\n+        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n+        s.bind((\"127.0.0.1\", 0))\n+        s.listen()\n+        listeners.append(s)\n+    addresses = [s.getsockname() for s in listeners]\n+    input_listener = make_zmq_listener(\"tcp://127.0.0.1:0\", zmq.ROUTER)\n+    output_listener = make_zmq_listener(\"tcp://127.0.0.1:0\", zmq.PULL)\n+    try:\n+        monkeypatch.setattr(subprocess_mod, \"Popen\", lambda *a, **kw: _FakeProc())\n+        RustFrontendProcessManager(\n+            binary_path=\"/nonexistent/vllm-rs\",\n+            sock=listeners[0],\n+            args=args,\n+            input_listener=input_listener,\n+            output_listener=output_listener,\n+            engine_start_index=0,\n+            engine_count=1,\n+            data_parallel_size=1,\n+            grpc_sock=listeners[1],\n+        )\n+        for address in addresses:\n+            with pytest.raises(ConnectionRefusedError):\n+                socket.create_connection(address, timeout=1).close()\n+    finally:\n+        for s in listeners:\n+            s.close()\n+\n+\n def test_rust_frontend_spawn_failure_cleans_up_listeners(tmp_path):\n     \"\"\"No child owns the listeners when Popen fails, so the parent removes them.\"\"\"\n     from vllm.entrypoints.common.cli_args import make_arg_parser",
      "raw_url": "https://github.com/vllm-project/vllm/raw/b207e36fc67cc1d65957737eeeb566c3d554eaea/tests%2Fentrypoints%2Flaunchers%2Fapi_server%2Ftest_api_server_process_manager.py",
      "sha": "9e5c8fb0022abe74028f2167c45d25fdc445d783",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/b207e36fc67cc1d65957737eeeb566c3d554eaea/vllm%2Fv1%2Futils.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Futils.py?ref=b207e36fc67cc1d65957737eeeb566c3d554eaea",
      "deletions": 0,
      "filename": "vllm/v1/utils.py",
      "patch": "@@ -380,6 +380,11 @@ def __init__(\n         else:\n             input_listener.close()\n             output_listener.close()\n+            # Rust owns these now; an open copy here keeps the ports listening\n+            # after Rust closes them.\n+            sock.close()\n+            if grpc_sock is not None:\n+                grpc_sock.close()\n \n         # Create a process wrapper with a sentinel fd for monitoring\n         self.processes: list[_SubprocessWrapper] = [",
