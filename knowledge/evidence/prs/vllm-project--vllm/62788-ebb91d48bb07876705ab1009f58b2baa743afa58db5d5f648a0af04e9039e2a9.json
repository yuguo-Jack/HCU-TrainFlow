      "deletions": 0,
      "filename": "tests/entrypoints/openai/completion/test_completion_text_offset.py",
      "patch": "@@ -113,3 +113,39 @@ def test_non_stream_response_omits_null_prompt_tokens_details():\n     )\n \n     assert \"prompt_tokens_details\" not in response.model_dump()[\"usage\"]\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\"return_token_ids\", [False, True])\n+async def test_stream_echo_returns_prompt_token_ids_only_on_request(\n+    return_token_ids: bool,\n+):\n+    async def results():\n+        yield 0, _output(\"\".join(TEXT_DELTAS), [0, 1, 2], finished=True)\n+\n+    request = CompletionRequest(\n+        model=\"m\",\n+        prompt=\"Hi\",\n+        max_tokens=8,\n+        echo=True,\n+        return_token_ids=return_token_ids,\n+        stream=True,\n+    )\n+    chunks = [\n+        json.loads(line.removeprefix(\"data: \"))\n+        async for line in _serving().completion_stream_generator(\n+            request,\n+            [tokens_input([9], prompt=\"Hi\")],\n+            results(),\n+            \"r\",\n+            0,\n+            \"m\",\n+            num_prompts=1,\n+            tokenizer=None,\n+            request_metadata=RequestResponseMetadata(request_id=\"r\"),\n+        )\n+        if \"[DONE]\" not in line\n+    ]\n+\n+    expected = [9] if return_token_ids else None\n+    assert chunks[0][\"choices\"][0][\"prompt_token_ids\"] == expected",
      "raw_url": "https://github.com/vllm-project/vllm/raw/79fcc05ca3829abe32691075b6b728dd4bec6733/tests%2Fentrypoints%2Fopenai%2Fcompletion%2Ftest_completion_text_offset.py",
