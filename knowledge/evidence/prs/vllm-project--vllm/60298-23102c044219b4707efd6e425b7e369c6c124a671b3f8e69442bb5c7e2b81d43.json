      "patch": "@@ -309,6 +309,9 @@ def test_local_multicast_support_rejects_non_cuda(monkeypatch):\n         (4, (10, 3), True, True),\n         (8, (10, 0), True, True),\n         (8, (10, 3), True, True),\n+        (2, (10, 7), True, True),\n+        (4, (10, 7), True, True),\n+        (6, (10, 7), True, False),\n         (6, (10, 3), True, False),\n         (8, (10, 1), True, False),\n         (8, (9, 0), True, False),\n@@ -323,7 +326,7 @@ def test_mnnvl_multimem_reduce_scatter_platform_gate(\n     expected,\n ):\n     def is_device_capability(capability, device_id):\n-        assert capability in ((10, 0), (10, 3))\n+        assert capability in ((10, 0), (10, 3), (10, 7))\n         assert device_id == 3\n         return device_capability == capability\n ",
