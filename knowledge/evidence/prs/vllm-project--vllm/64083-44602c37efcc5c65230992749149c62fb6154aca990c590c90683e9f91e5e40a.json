    {
      "additions": 37,
      "blob_url": "https://github.com/vllm-project/vllm/blob/19dd673bcf80011004772bc3c3085d07d3beccc4/tests%2Ftest_config.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_config.py?ref=19dd673bcf80011004772bc3c3085d07d3beccc4",
      "deletions": 0,
      "filename": "tests/test_config.py",
      "patch": "@@ -2019,6 +2019,43 @@ def test_draft_model_enables_async_scheduling_by_default():\n     assert cfg.scheduler_config.async_scheduling is True\n \n \n+@pytest.mark.skip_global_cleanup\n+@pytest.mark.parametrize(\"model_name\", [\"mtp-dflash2\", \"mtp-eagle3\", \"mtp-dspark\"])\n+def test_explicit_mtp_method_ignores_model_name(tmp_path: Path, model_name: str):\n+    \"\"\"A checkpoint's name must not override explicitly configured MTP.\"\"\"\n+    from transformers import DeepseekV4Config\n+\n+    target_path = tmp_path / model_name\n+    _write_json(\n+        target_path / \"config.json\",\n+        DeepseekV4Config(\n+            architectures=[\"DeepseekV4ForCausalLM\"],\n+            hidden_size=128,\n+            intermediate_size=256,\n+            num_hidden_layers=2,\n+            num_attention_heads=4,\n+            num_key_value_heads=2,\n+            vocab_size=128,\n+            max_position_embeddings=2048,\n+            n_routed_experts=4,\n+            num_experts_per_tok=2,\n+            num_nextn_predict_layers=1,\n+            layer_types=[\"sliding_attention\"] * 2,\n+            head_dim=32,\n+        ).to_dict(),\n+    )\n+    target_config = ModelConfig(\n+        model=str(target_path), tokenizer_mode=\"skip\", max_model_len=2048\n+    )\n+    speculative_config = SpeculativeConfig(\n+        method=\"mtp\",\n+        num_speculative_tokens=1,\n+        target_model_config=target_config,\n+        target_parallel_config=ParallelConfig(distributed_executor_backend=\"uni\"),\n+    )\n+    assert speculative_config.method == \"mtp\"\n+\n+\n def test_dflash_allows_async_scheduling(tmp_path: Path):\n     \"\"\"DFlash must stay async-schedulable: it was the only parallel-drafting\n     method excluded from the allowlist.\"\"\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/19dd673bcf80011004772bc3c3085d07d3beccc4/tests%2Ftest_config.py",
      "sha": "617237865687f6200535bf70fedcb6ae3afb0cce",
      "status": "modified"
    },
    {
