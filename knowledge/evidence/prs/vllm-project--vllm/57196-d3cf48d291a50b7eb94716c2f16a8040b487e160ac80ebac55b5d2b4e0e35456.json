      "deletions": 0,
      "filename": "vllm/platforms/xpu.py",
      "patch": "@@ -3,6 +3,7 @@\n \n import contextlib\n import os\n+from datetime import timedelta\n from typing import TYPE_CHECKING\n \n import torch\n@@ -19,6 +20,8 @@\n from .interface import DeviceCapability, Platform, PlatformEnum\n \n if TYPE_CHECKING:\n+    from torch.distributed import PrefixStore, ProcessGroup\n+\n     from vllm.config import VllmConfig\n     from vllm.config.kernel import IrOpPriorityConfig\n     from vllm.v1.attention.selector import AttentionSelectorConfig\n@@ -633,6 +636,34 @@ def swap_out_blocks_to_host(\n         _src_cache = src_cache[src_block_indices]\n         dst_cache[dst_block_indices] = _src_cache.cpu()\n \n+    @classmethod\n+    def stateless_init_device_torch_dist_pg(\n+        cls,\n+        backend: str,\n+        prefix_store: \"PrefixStore\",\n+        group_rank: int,\n+        group_size: int,\n+        timeout: timedelta,\n+    ) -> \"ProcessGroup\":\n+        assert torch.distributed.is_xccl_available()\n+        from torch.distributed import ProcessGroup\n+        from torch.distributed.distributed_c10d import ProcessGroupXCCL\n+\n+        pg: ProcessGroup = ProcessGroup(prefix_store, group_rank, group_size)\n+\n+        backend_options = ProcessGroupXCCL.Options()\n+        backend_options._timeout = timeout\n+\n+        backend_class = ProcessGroupXCCL(\n+            prefix_store, group_rank, group_size, backend_options\n+        )\n+        backend_type = ProcessGroup.BackendType.XCCL\n+        pg._set_default_backend(backend_type)\n+        backend_class._set_sequence_number_for_group()\n+\n+        pg._register_backend(torch.device(\"xpu\"), backend_type, backend_class)\n+        return pg\n+\n     @classmethod\n     def num_compute_units(cls, device_id: int = 0) -> int:\n         return torch.xpu.get_device_properties(device_id).max_compute_units",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1d272b947e85cae2fa7e055724a892e6f6e58be2/vllm%2Fplatforms%2Fxpu.py",
