      "blob_url": "https://github.com/vllm-project/vllm/blob/83f993b39cce6d80857ca5a135e19250f6bca798/tests%2Fkernels%2Fquantization%2Ftest_rocm_mxfp4.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fquantization%2Ftest_rocm_mxfp4.py?ref=83f993b39cce6d80857ca5a135e19250f6bca798",
      "deletions": 1,
      "filename": "tests/kernels/quantization/test_rocm_mxfp4.py",
      "patch": "@@ -648,13 +648,17 @@ def test_aiter_fp4_gemm_skinny_shapes(M, N, K):\n         ((1280, 80), True),  # gate/up_proj under TP=2 (out sharded)\n         ((2560, 8), True),  # minimal aligned columns\n         ((32, 8), True),  # minimal aligned rows and columns\n+        ((96, 8), False),  # Qwen3.8 TP1 GDN in_proj_ba; ASM is wrong for M<=64\n         ((2560, 20), False),  # shared_expert down_proj (in=640 -> sn=20)\n         ((2560, 10), False),  # down_proj under TP=2 (in 640->320 -> sn=10)\n         ((30, 8), False),  # rows not a multiple of 32\n     ],\n )\n def test_asm_fp4_scale_swizzle_supported_shape_rules(shape, supported):\n-    \"\"\"The ASM swizzle needs rows % 32 == 0 and columns % 8 == 0.\"\"\"\n+    \"\"\"The ASM swizzle needs rows % 32 == 0 and columns % 8 == 0.\n+\n+    96 scale rows are layout-legal and still rejected. That tile stays on Triton.\n+    \"\"\"\n     from vllm.model_executor.kernels.linear.mxfp4.aiter import (\n         _asm_fp4_scale_swizzle_supported,\n     )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/83f993b39cce6d80857ca5a135e19250f6bca798/tests%2Fkernels%2Fquantization%2Ftest_rocm_mxfp4.py",
      "sha": "885ceecca58e24ce9188fe1489226428e0d4e257",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/vllm-project/vllm/blob/83f993b39cce6d80857ca5a135e19250f6bca798/vllm%2Fmodel_executor%2Fkernels%2Flinear%2Fmxfp4%2Faiter.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fkernels%2Flinear%2Fmxfp4%2Faiter.py?ref=83f993b39cce6d80857ca5a135e19250f6bca798",
      "deletions": 2,
      "filename": "vllm/model_executor/kernels/linear/mxfp4/aiter.py",
      "patch": "@@ -19,16 +19,23 @@\n \n _ASM_FP4_SCALE_ROW_MULTIPLE = 32\n _ASM_FP4_SCALE_COL_MULTIPLE = 8\n+_ASM_FP4_FORCE_TRITON_SCALE_ROWS = {96}\n \n \n def _asm_fp4_scale_swizzle_supported(weight_scale: torch.Tensor) -> bool:\n     # The ASM swizzle reshapes weight_scale into a fixed tile layout, requiring\n-    # scale rows divisible by 32 and scale columns divisible by 8\n+    # scale rows divisible by 32 and scale columns divisible by 8. Qwen3.8's\n+    # TP1 GDN in_proj_ba has 96 rows, which is layout-legal, but the default\n+    # ASM dispatch is numerically incorrect for M <= 64. Keep that narrow\n+    # projection on the tuned Triton path.\n+    # https://github.com/ROCm/aiter/issues/5931\n     if weight_scale.ndim != 2:\n         return False\n     sm, sn = weight_scale.shape\n     return (\n-        sm % _ASM_FP4_SCALE_ROW_MULTIPLE == 0 and sn % _ASM_FP4_SCALE_COL_MULTIPLE == 0\n+        sm not in _ASM_FP4_FORCE_TRITON_SCALE_ROWS\n+        and sm % _ASM_FP4_SCALE_ROW_MULTIPLE == 0\n+        and sn % _ASM_FP4_SCALE_COL_MULTIPLE == 0\n     )\n \n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/83f993b39cce6d80857ca5a135e19250f6bca798/vllm%2Fmodel_executor%2Fkernels%2Flinear%2Fmxfp4%2Faiter.py",
      "sha": "3635387d6e10b4aa5c52a32779129bbf9338fd7a",
