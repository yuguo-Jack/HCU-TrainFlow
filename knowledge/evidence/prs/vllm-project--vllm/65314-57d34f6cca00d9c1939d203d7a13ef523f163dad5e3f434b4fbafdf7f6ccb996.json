    {
      "additions": 24,
      "blob_url": "https://github.com/vllm-project/vllm/blob/bf087c415fdd9d2a88b834e5e46c65867b83ebd4/tests%2Fkernels%2Fmoe%2Ftest_cpu_quant_fused_moe.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fmoe%2Ftest_cpu_quant_fused_moe.py?ref=bf087c415fdd9d2a88b834e5e46c65867b83ebd4",
      "deletions": 0,
      "filename": "tests/kernels/moe/test_cpu_quant_fused_moe.py",
      "patch": "@@ -36,6 +36,30 @@ def _prepack_experts(w: torch.Tensor) -> torch.Tensor:\n     return torch.ops._C.convert_weight_packed(w)\n \n \n+def test_cpu_wna16_supports_grouped_int8_weights():\n+    from vllm.model_executor.layers.fused_moe.experts.cpu_moe import (\n+        CPUExpertsWNA16,\n+    )\n+    from vllm.model_executor.layers.quantization.utils.quant_utils import kInt8Static\n+\n+    assert CPUExpertsWNA16._supports_quant_scheme(kInt8Static, None)\n+\n+\n+def test_cpu_wna16_dequantizes_grouped_int8_weights():\n+    from vllm.model_executor.layers.fused_moe.experts.cpu_moe import (\n+        dequantize_int8_moe_weight,\n+    )\n+\n+    weight = torch.tensor([[[1, -2, 3, -4, 5, -6, 7, -8]]], dtype=torch.int8)\n+    scale = torch.tensor([[[2.0, 3.0]]], dtype=torch.float32)\n+    packed_weight = weight.view(torch.int32)\n+\n+    result = dequantize_int8_moe_weight(packed_weight, scale, 4, torch.float32)\n+\n+    expected = torch.tensor([[[2, -4, 6, -8, 15, -18, 21, -24]]], dtype=torch.float32)\n+    torch.testing.assert_close(result, expected)\n+\n+\n def _deterministic_expert_routes(\n     block_sizes: tuple[int, ...],\n ) -> tuple[torch.Tensor, torch.Tensor]:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/bf087c415fdd9d2a88b834e5e46c65867b83ebd4/tests%2Fkernels%2Fmoe%2Ftest_cpu_quant_fused_moe.py",
      "sha": "7c3964a933e7bbc3cfe858b2be2f1aea648309f0",
      "status": "modified"
    },
    {
      "additions": 46,
      "blob_url": "https://github.com/vllm-project/vllm/blob/bf087c415fdd9d2a88b834e5e46c65867b83ebd4/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Fexperts%2Fcpu_moe.py",
      "changes": 46,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Fexperts%2Fcpu_moe.py?ref=bf087c415fdd9d2a88b834e5e46c65867b83ebd4",
      "deletions": 0,
      "filename": "vllm/model_executor/layers/fused_moe/experts/cpu_moe.py",
      "patch": "@@ -44,6 +44,7 @@\n     kFp8Static128BlockSym,\n     kInt4Static,\n     kInt8DynamicTokenSym,\n+    kInt8Static,\n     kInt8StaticChannelSym,\n     kMxfp4Static,\n )\n@@ -1018,6 +1019,51 @@ def apply(\n         )\n \n \n+def dequantize_int8_moe_weight(\n+    weight_packed: torch.Tensor,\n+    weight_scale: torch.Tensor,\n+    group_size: int,\n+    dtype: torch.dtype,\n+) -> torch.Tensor:\n+    \"\"\"Dequantize an N-first grouped INT8 MoE weight tensor.\"\"\"\n+    weight = weight_packed.view(torch.int8).reshape(\n+        weight_packed.shape[0], weight_packed.shape[1], -1\n+    )\n+    scales = torch.repeat_interleave(weight_scale, group_size, dim=2)\n+    return weight.to(dtype) * scales\n+\n+\n+class CPUExpertsWNA16(X86CPUUnquantizedExperts):\n+    \"\"\"CPU fallback for grouped INT8 W8A16 MoE experts.\"\"\"\n+\n+    @staticmethod\n+    def _supports_quant_scheme(\n+        weight_key: QuantKey | None,\n+        activation_key: QuantKey | None,\n+    ) -> bool:\n+        return (weight_key, activation_key) == (kInt8Static, None)\n+\n+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n+        group_size = self.quant_config.block_shape[1]\n+        w13 = dequantize_int8_moe_weight(\n+            layer.w13_weight_packed,\n+            layer.w13_weight_scale,\n+            group_size,\n+            self.moe_config.in_dtype,\n+        )\n+        w2 = dequantize_int8_moe_weight(\n+            layer.w2_weight_packed,\n+            layer.w2_weight_scale,\n+            group_size,\n+            self.moe_config.in_dtype,\n+        )\n+        replace_parameter(layer, \"w13_weight_packed\", w13)\n+        replace_parameter(layer, \"w2_weight_packed\", w2)\n+        layer.w13_weight = layer.w13_weight_packed\n+        layer.w2_weight = layer.w2_weight_packed\n+        super().process_weights_after_loading(layer)\n+\n+\n class CPUExpertsInt8(_CPUPaddedIntermediateMixin, mk.FusedMoEExpertsModular):\n     \"\"\"CPU INT8 W8A8 per-channel weight / dynamic per-token activation\n     modular MoE experts.\"\"\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/bf087c415fdd9d2a88b834e5e46c65867b83ebd4/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Fexperts%2Fcpu_moe.py",
      "sha": "b4983e01a47ec8c638ffd416b5fbf3fb9f059c52",
      "status": "modified"
    },
