      "changes": 9,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/csrc%2Fspinloop.cpp?ref=96361cc37372a3a705118cd7871c5110107bac8c",
      "deletions": 0,
      "filename": "csrc/spinloop.cpp",
      "patch": "@@ -1,5 +1,7 @@\n #include <Python.h>\n \n+#include <atomic>\n+\n extern \"C\" {\n \n #include <stdbool.h>\n@@ -180,9 +182,16 @@ static PyObject* method_spinloop(PyObject* self, PyObject* args,\n   Py_RETURN_FALSE;\n }\n \n+static PyObject* method_memory_fence(PyObject* self, PyObject* args) {\n+  std::atomic_thread_fence(std::memory_order_seq_cst);\n+  Py_RETURN_NONE;\n+}\n+\n static PyMethodDef spinloop_methods[] = {\n     {\"spinloop\", (PyCFunction)method_spinloop, METH_VARARGS | METH_KEYWORDS,\n      \"Wait for store with callback\"},\n+    {\"memory_fence\", method_memory_fence, METH_NOARGS,\n+     \"Issue a sequentially consistent CPU memory fence\"},\n     {NULL, NULL, 0, NULL}};\n \n static struct PyModuleDef spinloop_module = {",
      "raw_url": "https://github.com/vllm-project/vllm/raw/96361cc37372a3a705118cd7871c5110107bac8c/csrc%2Fspinloop.cpp",
      "sha": "7e4d86ffe71b9e5281e74bc12506d5c0ad49cf0a",
      "status": "modified"
    },
    {
      "additions": 2,
