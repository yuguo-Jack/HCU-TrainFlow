      "raw_url": "https://github.com/vllm-project/vllm/raw/30eda95533352836c6c57709dac5d3f2f0d16cc0/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Fexperts%2Fgpt_oss_triton_kernels_moe.py",
