      "patch": "@@ -0,0 +1,4 @@\n+{\n+  \"image\": \"mcr.microsoft.com/devcontainers/universal:2\",\n+  \"features\": {}\n+}",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d1916f3e4d24de1d7b0d4b9ceca89f39406a74d6/.devcontainer%2Fdevcontainer.json",
