      "deletions": 1,
      "filename": "tests/compile/fullgraph/test_basic_correctness.py",
      "patch": "@@ -30,7 +30,9 @@ class TestSetting:\n         # MoE model\n         TestSetting(\n             model=\"ibm-granite/granite-3.0-1b-a400m-instruct\",\n-            model_args=[\"--max-model-len\", \"2048\"],\n+            # Dummy weights give a near-uniform distribution, so top-k logprobs\n+            # are ties and the compared token set is arbitrary.\n+            model_args=[\"--max-model-len\", \"2048\", \"--load-format\", \"auto\"],\n             pp_size=1,\n             tp_size=1,\n             attn_backend=ATTN_BACKEND,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f8660a47b5d31ee8ccf3cea575296c077e02be73/tests%2Fcompile%2Ffullgraph%2Ftest_basic_correctness.py",
      "sha": "b05e42207c5e0028aff10b9e1f4afd83ad418579",
      "status": "modified"
    },
    {
      "additions": 27,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f8660a47b5d31ee8ccf3cea575296c077e02be73/tests%2Futils.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Futils.py?ref=f8660a47b5d31ee8ccf3cea575296c077e02be73",
      "deletions": 0,
      "filename": "tests/utils.py",
      "patch": "@@ -1012,6 +1012,27 @@ def _test_completion(\n     return results\n \n \n+# bf16 noise alone moves top-5 logprobs by up to ~0.5 versus an fp32 reference\n+# (observed on granite-3.0-1b-a400m), so compiled vs eager need not match exactly.\n+_CLOSE_LOGPROB_ATOL = 0.5\n+\n+\n+def _assert_top_logprobs_close(\n+    ref: dict[str, float], other: dict[str, float], model: str\n+) -> None:\n+    ref_top = max(ref, key=ref.__getitem__)\n+    other_top = max(other, key=other.__getitem__)\n+    assert ref_top == other_top, (\n+        f\"Top-1 token for {model=} differs: {ref_top!r} vs {other_top!r}\\n\"\n+        f\"{ref=}\\n{other=}\\n\"\n+    )\n+    for token in ref.keys() & other.keys():\n+        assert abs(ref[token] - other[token]) <= _CLOSE_LOGPROB_ATOL, (\n+            f\"Logprob of {token!r} for {model=} differs: \"\n+            f\"{ref[token]} vs {other[token]}\\n{ref=}\\n{other=}\\n\"\n+        )\n+\n+\n def _test_completion_close(\n     client: openai.OpenAI,\n     model: str,\n@@ -1310,6 +1331,12 @@ def compare_all_settings(\n                         )\n                         del ref_result[\"embedding\"]\n                         del compare_result[\"embedding\"]\n+                    if method == \"generate_close\" and \"logprobs\" in ref_result:\n+                        _assert_top_logprobs_close(\n+                            ref_result.pop(\"logprobs\"),\n+                            compare_result.pop(\"logprobs\"),\n+                            model,\n+                        )\n                     assert ref_result == compare_result, (\n                         f\"Results for {model=} are not the same.\\n\"\n                         f\"{ref_args=} {ref_envs=}\\n\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f8660a47b5d31ee8ccf3cea575296c077e02be73/tests%2Futils.py",
      "sha": "16f8fc1eeaf6460611033a8f6a0d50665a99d9b7",
      "status": "modified"
    }
