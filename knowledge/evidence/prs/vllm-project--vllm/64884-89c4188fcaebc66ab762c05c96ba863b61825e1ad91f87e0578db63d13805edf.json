      "additions": 58,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4bec5cb6c2962778c9ff4df247fccbe00219f725/tests%2Fkernels%2Fmhc%2Ftest_mhc_kernels.py",
      "changes": 58,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fmhc%2Ftest_mhc_kernels.py?ref=4bec5cb6c2962778c9ff4df247fccbe00219f725",
      "deletions": 0,
      "filename": "tests/kernels/mhc/test_mhc_kernels.py",
      "patch": "@@ -52,6 +52,64 @@\n DEVICE = current_platform.device_type\n \n \n+@pytest.mark.parametrize(\"width\", [4096, 16384])\n+def test_hc_prenorm_triton_batch_invariant(width):\n+    from vllm.model_executor.kernels.mhc.triton import (\n+        hc_prenorm_gemm_batch_invariant as hc_prenorm,\n+    )\n+\n+    torch.manual_seed(42)\n+    x = torch.randn((7, width), device=DEVICE, dtype=torch.bfloat16)\n+    fn = torch.randn((24, width), device=DEVICE)\n+    mixes, sq = hc_prenorm(x, fn)\n+    reference = x.double() @ fn.double().T\n+    torch.testing.assert_close(mixes[0].double(), reference, atol=1e-4, rtol=1e-5)\n+    torch.testing.assert_close(\n+        sq[0].double(), x.double().square().sum(-1), atol=0.002, rtol=1e-6\n+    )\n+    for i in (0, 3, 6):\n+        single_mix, single_sq = hc_prenorm(x[i : i + 1], fn)\n+        assert torch.equal(single_mix[0, 0], mixes[0, i])\n+        assert torch.equal(single_sq[0, 0], sq[0, i])\n+\n+\n+def test_mhc_fused_post_pre_batch_invariant(monkeypatch):\n+    from vllm.model_executor.kernels.mhc.tilelang import mhc_fused_post_pre_tilelang\n+\n+    monkeypatch.setenv(\"VLLM_BATCH_INVARIANT\", \"1\")\n+    torch.manual_seed(3)\n+    x = torch.randn((129, 4096), dtype=torch.bfloat16, device=DEVICE)\n+    residual = torch.randn((129, 4, 4096), dtype=torch.bfloat16, device=DEVICE)\n+    post = torch.rand((129, 4, 1), device=DEVICE)\n+    comb = torch.rand((129, 4, 4), device=DEVICE)\n+    fn = torch.randn((24, 16384), device=DEVICE) * 0.01\n+    scale = torch.ones(3, device=DEVICE)\n+    base = torch.zeros(24, device=DEVICE)\n+    norm = torch.ones(4096, dtype=torch.bfloat16, device=DEVICE)\n+    reference = None\n+    for n in (1, 17, 129):\n+        outputs = mhc_fused_post_pre_tilelang(\n+            x[:n],\n+            residual[:n],\n+            post[:n],\n+            comb[:n],\n+            fn,\n+            scale,\n+            base,\n+            1e-6,\n+            1e-6,\n+            1e-6,\n+            2.0,\n+            20,\n+            norm_weight=norm,\n+        )\n+        if reference is None:\n+            reference = outputs\n+        else:\n+            for output, expected in zip(outputs, reference):\n+                assert torch.equal(output[0], expected[0])\n+\n+\n @pytest.mark.parametrize(\n     \"tp,ep,hidden,hc,multicast,expected\",\n     [",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4bec5cb6c2962778c9ff4df247fccbe00219f725/tests%2Fkernels%2Fmhc%2Ftest_mhc_kernels.py",
      "sha": "ebd2985883c86635e73efa803579b35367ae033f",
      "status": "modified"
    },
    {
      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4bec5cb6c2962778c9ff4df247fccbe00219f725/vllm%2Fmodel_executor%2Fkernels%2Fmhc%2Ftilelang.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fkernels%2Fmhc%2Ftilelang.py?ref=4bec5cb6c2962778c9ff4df247fccbe00219f725",
      "deletions": 1,
      "filename": "vllm/model_executor/kernels/mhc/tilelang.py",
      "patch": "@@ -2,6 +2,7 @@\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n import torch\n \n+import vllm.envs as envs\n from vllm.utils.math_utils import cdiv\n from vllm.utils.torch_utils import direct_register_custom_op\n \n@@ -14,6 +15,13 @@ def _hc_prenorm_gemm_outputs(\n     hc_mult: int,\n     use_tilelang_fallback: bool = True,\n ) -> tuple[torch.Tensor, torch.Tensor]:\n+    if envs.VLLM_BATCH_INVARIANT:\n+        from vllm.model_executor.kernels.mhc.triton import (\n+            hc_prenorm_gemm_batch_invariant,\n+        )\n+\n+        return hc_prenorm_gemm_batch_invariant(x, fn)\n+\n     from vllm.model_executor.kernels.mhc.tilelang_kernels import (\n         compute_num_split,\n     )\n@@ -883,7 +891,11 @@ def _mhc_fused_post_pre_tilelang_impl(\n     post_layer_mix_flat = post_layer_mix.view(num_tokens, hc_mult)\n     comb_res_mix_flat = comb_res_mix.view(num_tokens, hc_mult, hc_mult)\n \n-    fused_config = mhc_fused_post_pre_split_config(num_tokens, hidden_size, hc_mult)\n+    fused_config = (\n+        None\n+        if envs.VLLM_BATCH_INVARIANT\n+        else mhc_fused_post_pre_split_config(num_tokens, hidden_size, hc_mult)\n+    )\n \n     post_mix_cur = torch.empty(\n         num_tokens,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4bec5cb6c2962778c9ff4df247fccbe00219f725/vllm%2Fmodel_executor%2Fkernels%2Fmhc%2Ftilelang.py",
      "sha": "65f0421a7434d66d0b1bf0036007ab18f3a20047",
      "status": "modified"
    },
    {
      "additions": 40,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4bec5cb6c2962778c9ff4df247fccbe00219f725/vllm%2Fmodel_executor%2Fkernels%2Fmhc%2Ftriton.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fkernels%2Fmhc%2Ftriton.py?ref=4bec5cb6c2962778c9ff4df247fccbe00219f725",
      "deletions": 0,
      "filename": "vllm/model_executor/kernels/mhc/triton.py",
      "patch": "@@ -8,6 +8,46 @@\n from vllm.utils.torch_utils import direct_register_custom_op\n \n \n+@triton.jit\n+def _hc_prenorm_gemm(\n+    X, FN, OUT, SQ, xs, N: tl.constexpr, K: tl.constexpr, BLOCK: tl.constexpr\n+):\n+    row = tl.program_id(0).to(tl.int64)\n+    n = tl.program_id(1)\n+    k = tl.arange(0, BLOCK)\n+    x = tl.load(X + row * xs + k, k < K, 0).to(tl.float32)\n+    fn = tl.load(FN + n * K + k, k < K, 0)\n+    tl.store(OUT + row * N + n, tl.sum(x * fn, 0))\n+    if n == 0:\n+        tl.store(SQ + row, tl.sum(x * x, 0))\n+\n+\n+def hc_prenorm_gemm_batch_invariant(\n+    x: torch.Tensor, fn: torch.Tensor\n+) -> tuple[torch.Tensor, torch.Tensor]:\n+    \"\"\"Project residual streams and sum their squares without batch-dependent splits.\"\"\"\n+    assert x.ndim == fn.ndim == 2 and x.shape[1] == fn.shape[1]\n+    assert x.stride(1) == 1 and fn.is_contiguous() and fn.dtype == torch.float32\n+    out = torch.empty(\n+        (1, x.shape[0], fn.shape[0]), dtype=torch.float32, device=x.device\n+    )\n+    sq = torch.empty((1, x.shape[0]), dtype=torch.float32, device=x.device)\n+    if x.shape[0]:\n+        _hc_prenorm_gemm[(x.shape[0], fn.shape[0])](\n+            x,\n+            fn,\n+            out,\n+            sq,\n+            x.stride(0),\n+            fn.shape[0],\n+            x.shape[1],\n+            triton.next_power_of_2(x.shape[1]),\n+            num_warps=8,\n+            enable_fp_fusion=False,\n+        )\n+    return out, sq\n+\n+\n @triton.jit\n def _rmsnorm_nw_kernel(\n     x_ptr,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4bec5cb6c2962778c9ff4df247fccbe00219f725/vllm%2Fmodel_executor%2Fkernels%2Fmhc%2Ftriton.py",
      "sha": "e095add9eea5953d143307758c0022086bbe4a72",
      "status": "modified"
    }
