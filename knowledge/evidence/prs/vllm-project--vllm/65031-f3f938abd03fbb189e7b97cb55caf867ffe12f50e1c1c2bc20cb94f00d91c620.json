      "changes": 54,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Frenderers%2Ftest_mistral.py?ref=ca69d7315c746708fd0f6dae87b37a9db746dfcc",
      "deletions": 1,
      "filename": "tests/renderers/test_mistral.py",
      "patch": "@@ -17,7 +17,11 @@\n     ResponseFormat as OpenAIResponseFormat,\n )\n from vllm.renderers import ChatParams\n-from vllm.renderers.mistral import MistralRenderer, safe_apply_chat_template\n+from vllm.renderers.mistral import (\n+    MistralRenderer,\n+    _convert_developer_to_system,\n+    safe_apply_chat_template,\n+)\n from vllm.tokenizers.mistral import MistralTokenizer\n \n MODEL_NAME = \"mistralai/Mistral-7B-Instruct-v0.3\"\n@@ -196,3 +200,51 @@ def test_apply_mistral_chat_template_thinking_chunk():\n     )\n \n     assert string_tokens == expected_tokens\n+\n+\n+def test_convert_developer_to_system():\n+    messages = [\n+        {\"role\": \"developer\", \"content\": \"Be brief.\"},\n+        {\"role\": \"user\", \"content\": \"Hi\"},\n+    ]\n+    converted = _convert_developer_to_system(messages)\n+    assert converted[0][\"role\"] == \"system\"\n+    assert converted[0][\"content\"] == \"Be brief.\"\n+    assert converted[1][\"role\"] == \"user\"\n+    assert messages[0][\"role\"] == \"developer\"\n+\n+\n+def test_developer_role_renders_with_mistral_tokenizer(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    \"\"\"developer messages should be folded into system before tokenization.\"\"\"\n+    captured_messages: list = []\n+\n+    def capturing_apply(*args, **kwargs):\n+        captured_messages.extend(args[0] if args else kwargs.get(\"messages\", []))\n+        return [1, 2, 3]\n+\n+    mock_tokenizer = Mock(spec=MistralTokenizer)\n+    mock_tokenizer.apply_chat_template = capturing_apply\n+\n+    renderer = MistralRenderer(\n+        MockVllmConfig(\n+            MockModelConfig(skip_tokenizer_init=True),\n+            parallel_config=MockParallelConfig(),\n+        ),\n+        tokenizer=mock_tokenizer,\n+    )\n+    monkeypatch.setattr(\n+        \"vllm.renderers.mistral.parse_chat_messages\",\n+        lambda *_args, **_kwargs: ([], None, None),\n+    )\n+\n+    messages = [\n+        {\"role\": \"developer\", \"content\": \"Be brief.\"},\n+        {\"role\": \"user\", \"content\": \"Hello\"},\n+    ]\n+    renderer.render_messages(messages, ChatParams())\n+\n+    assert all(m.get(\"role\") != \"developer\" for m in captured_messages)\n+    assert captured_messages[0][\"role\"] == \"system\"\n+    assert captured_messages[0][\"content\"] == \"Be brief.\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ca69d7315c746708fd0f6dae87b37a9db746dfcc/tests%2Frenderers%2Ftest_mistral.py",
      "sha": "e237f049bcc3b7b23fe5495c9a8a7f6c9e4d2b6a",
      "status": "modified"
    },
    {
      "additions": 34,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ca69d7315c746708fd0f6dae87b37a9db746dfcc/vllm%2Frenderers%2Fmistral.py",
      "changes": 34,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Frenderers%2Fmistral.py?ref=ca69d7315c746708fd0f6dae87b37a9db746dfcc",
      "deletions": 0,
      "filename": "vllm/renderers/mistral.py",
      "patch": "@@ -61,6 +61,26 @@ def _get_chat_template_kwargs(params: ChatParams) -> dict[str, Any]:\n     return kwargs\n \n \n+def _convert_developer_to_system(\n+    messages: list[ChatCompletionMessageParam],\n+) -> list[ChatCompletionMessageParam]:\n+    \"\"\"Map ``developer`` role to ``system`` for mistral-common compatibility.\n+\n+    mistral-common only accepts system/user/assistant/tool roles.  The\n+    ``developer`` role (OpenAI's successor to ``system``) is semantically\n+    equivalent, so we fold it into ``system`` before tokenization.\n+    \"\"\"\n+    converted: list[ChatCompletionMessageParam] = []\n+    for msg in messages:\n+        if msg.get(\"role\") == \"developer\":\n+            new_msg = dict(msg)\n+            new_msg[\"role\"] = \"system\"\n+            converted.append(new_msg)  # type: ignore[arg-type]\n+        else:\n+            converted.append(msg)\n+    return converted\n+\n+\n class MistralRenderer(BaseRenderer[MistralTokenizer]):\n     def __init__(\n         self,\n@@ -78,6 +98,13 @@ def render_messages(\n         messages: list[ChatCompletionMessageParam],\n         params: ChatParams,\n     ) -> tuple[list[ConversationMessage], DictPrompt]:\n+        if any(msg.get(\"role\") == \"developer\" for msg in messages):\n+            messages = _convert_developer_to_system(messages)\n+            logger.info_once(\n+                \"mistral-common does not support the 'developer' message \"\n+                \"role. Converting developer messages to 'system' role.\",\n+            )\n+\n         tokenizer = self.get_tokenizer()\n         conversation, mm_data, mm_uuids = parse_chat_messages(\n             messages,\n@@ -104,6 +131,13 @@ async def render_messages_async(\n         messages: list[ChatCompletionMessageParam],\n         params: ChatParams,\n     ) -> tuple[list[ConversationMessage], DictPrompt]:\n+        if any(msg.get(\"role\") == \"developer\" for msg in messages):\n+            messages = _convert_developer_to_system(messages)\n+            logger.info_once(\n+                \"mistral-common does not support the 'developer' message \"\n+                \"role. Converting developer messages to 'system' role.\",\n+            )\n+\n         tokenizer = self.get_tokenizer()\n         conversation, mm_data, mm_uuids = await parse_chat_messages_async(\n             messages,",
