      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f5129016ec14ddbd7b5bdf6b42dbf697d0166caf/vllm%2Fmodels%2Fdeepseek_v41%2Fnvidia%2Fflashinfer_sparse.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Fdeepseek_v41%2Fnvidia%2Fflashinfer_sparse.py?ref=f5129016ec14ddbd7b5bdf6b42dbf697d0166caf",
      "deletions": 1,
      "filename": "vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py",
      "patch": "@@ -31,6 +31,7 @@\n     DeepseekV4SparseMLAMetadataBuilder,\n     DeepseekV41SparseSWAMetadataBuilder,\n )\n+from vllm.platforms import current_platform\n from vllm.platforms.interface import DeviceCapability\n from vllm.utils.flashinfer import flashinfer_trtllm_batch_decode_sparse_mla_dsv4\n from vllm.v1.attention.backend import (\n@@ -63,7 +64,10 @@ class DeepseekV4FlashInferMLASparseBackend(DeepseekV4SparseMLABackend):\n \n     @staticmethod\n     def get_supported_kernel_block_sizes(kv_cache_spec=None) -> list[int | MultipleOf]:\n-        return [128]\n+        # SM120 (RTX PRO 6000 Blackwell): flashinfer sparse-MLA kernels assert\n+        # block_kv in {32, 64} (same 64-page layout as Hopper, flashinfer#4380);\n+        # 128-page is only valid on the SM100 TRTLLM-gen/FlashMLA path.\n+        return [64 if current_platform.is_device_capability_family(120) else 128]\n \n     @staticmethod\n     def get_name() -> str:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f5129016ec14ddbd7b5bdf6b42dbf697d0166caf/vllm%2Fmodels%2Fdeepseek_v41%2Fnvidia%2Fflashinfer_sparse.py",
      "sha": "07c611526897cbb444ac92402f874a9fd68811e3",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f5129016ec14ddbd7b5bdf6b42dbf697d0166caf/vllm%2Fv1%2Fattention%2Fbackends%2Fmla%2Findexer.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Fmla%2Findexer.py?ref=f5129016ec14ddbd7b5bdf6b42dbf697d0166caf",
      "deletions": 1,
      "filename": "vllm/v1/attention/backends/mla/indexer.py",
      "patch": "@@ -369,7 +369,16 @@ def get_name() -> str:\n \n     @staticmethod\n     def get_supported_kernel_block_sizes(kv_cache_spec=None) -> list[int | MultipleOf]:\n-        return [64 if current_platform.is_device_capability_family(90) else 128]\n+        # SM120 (RTX PRO 6000 Blackwell): the arch-12 fp4/fp8 indexer kernels\n+        # support the same 64-page layout as Hopper; 128 pages is SM100-only.\n+        return [\n+            64\n+            if (\n+                current_platform.is_device_capability_family(90)\n+                or current_platform.is_device_capability_family(120)\n+            )\n+            else 128\n+        ]\n \n \n @dataclass(frozen=True)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f5129016ec14ddbd7b5bdf6b42dbf697d0166caf/vllm%2Fv1%2Fattention%2Fbackends%2Fmla%2Findexer.py",
      "sha": "45a819daa98187bd20ade2738c0ee04aed707448",
      "status": "modified"
    }
