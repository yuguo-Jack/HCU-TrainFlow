      "filename": "tests/model_executor/model_loader/test_reload.py",
      "patch": "@@ -100,7 +100,15 @@ def sink_loader(param, loaded_weight):\n     [\n         (\"deepseek_v4\", \"DeepseekV4Model\", \"attn\", \"attn_sink\"),\n         (\"deepseek_v41\", \"DeepseekV4Model\", \"attn\", \"attn_sink\"),\n-        (\"hy_v4\", \"HYV4Model\", \"self_attn\", \"learnable_sink_param\"),\n+        pytest.param(\n+            \"hy_v4\",\n+            \"HYV4Model\",\n+            \"self_attn\",\n+            \"learnable_sink_param\",\n+            marks=pytest.mark.skipif(\n+                current_platform.is_xpu(), reason=\"hy_v4 does not yet support XPU\"\n+            ),\n+        ),\n     ],\n )\n def test_attention_sink_deepseek_hy_loading_uses_parameter_loader(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/00a41aa63876d29a718097dc2efeacee5b96a974/tests%2Fmodel_executor%2Fmodel_loader%2Ftest_reload.py",
      "sha": "76d1fd1c27eea29e925236e681c66bba52cd069f",
