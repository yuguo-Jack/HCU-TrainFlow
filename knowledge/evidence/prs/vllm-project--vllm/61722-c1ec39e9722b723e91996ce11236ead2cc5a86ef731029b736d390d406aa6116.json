    },
    {
      "additions": 22,
      "blob_url": "https://github.com/vllm-project/vllm/blob/00a41aa63876d29a718097dc2efeacee5b96a974/tests%2Fv1%2Fworker%2Ftest_xpu_model_runner.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fworker%2Ftest_xpu_model_runner.py?ref=00a41aa63876d29a718097dc2efeacee5b96a974",
      "deletions": 0,
      "filename": "tests/v1/worker/test_xpu_model_runner.py",
      "patch": "@@ -44,3 +44,25 @@ def test_torch_cuda_wrapper_allows_dynamo_handler_registration() -> None:\n     # if they are the same object (pre-fix alias), raises Handler already registered.\n     TorchInGraphFunctionVariable._get_handlers.cache_clear()\n     TorchInGraphFunctionVariable._get_handlers()\n+\n+\n+# Child process: patched torch.cuda must not leak to other tests in the session.\n+@pytest.mark.forked\n+def test_torch_cuda_wrapper_leaves_event_usable_as_a_type() -> None:\n+    \"\"\"Guard against the XPU CUDA shim breaking ``torch.cuda.Event | None``\n+    annotations evaluated by unrelated code later in the same process.\n+\n+    ``_torch_cuda_wrapper`` patches ``torch.cuda`` to redirect to\n+    ``torch.xpu`` and never undoes it (by design -- the redirection must\n+    stay in effect for the rest of the worker process, not just during\n+    ``__init__``). Before the fix, ``torch.cuda.Event`` was replaced by a\n+    plain function, which can't be used in ``SomeType | None`` annotations;\n+    any later-imported class with a ``torch.cuda.Event | None`` field\n+    default (e.g. ``vllm.models.deepseek_v41.common.engram.Engram``) raised\n+    ``TypeError: unsupported operand type(s) for |: 'function' and\n+    'NoneType'`` merely from being imported in the same test session.\n+    \"\"\"\n+    with _torch_cuda_wrapper():\n+        pass\n+\n+    assert torch.cuda.Event | None is not None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/00a41aa63876d29a718097dc2efeacee5b96a974/tests%2Fv1%2Fworker%2Ftest_xpu_model_runner.py",
      "sha": "8b812513b96fd21de090e9b48dfc510e55a0d6df",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/00a41aa63876d29a718097dc2efeacee5b96a974/vllm%2Fv1%2Fworker%2Fxpu_model_runner.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fxpu_model_runner.py?ref=00a41aa63876d29a718097dc2efeacee5b96a974",
      "deletions": 3,
      "filename": "vllm/v1/worker/xpu_model_runner.py",
      "patch": "@@ -62,9 +62,13 @@ def _torch_cuda_wrapper():\n     torch.cuda.set_stream = partial(torch.xpu.set_stream)\n \n     # torch.xpu.Event does not accept the ``blocking`` kwarg that\n-    # torch.cuda.Event supports, so drop it here.\n-    def _xpu_event(*args, blocking=None, **kwargs):\n-        return torch.xpu.Event(*args, **kwargs)\n+    # torch.cuda.Event supports, so drop it here. This has to be a class\n+    # (not a plain function): this patch is never undone, so any later\n+    # ``torch.cuda.Event | None`` annotation evaluated elsewhere in the\n+    # process needs torch.cuda.Event to still support ``|``.\n+    class _xpu_event:\n+        def __new__(cls, *args, blocking=None, **kwargs):\n+            return torch.xpu.Event(*args, **kwargs)\n \n     torch.cuda.Event = _xpu_event\n     if supports_xpu_graph():",
      "raw_url": "https://github.com/vllm-project/vllm/raw/00a41aa63876d29a718097dc2efeacee5b96a974/vllm%2Fv1%2Fworker%2Fxpu_model_runner.py",
      "sha": "d4d2b173cd2e43881f04cdd169c9330b0fc02e09",
      "status": "modified"
    }
