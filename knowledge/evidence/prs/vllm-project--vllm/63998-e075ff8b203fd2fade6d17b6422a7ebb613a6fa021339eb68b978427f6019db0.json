  "files": [
    {
      "additions": 9,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c17f23745f1bbf908f1022647acec97ad46092ae/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_mooncake_connector.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_mooncake_connector.py?ref=c17f23745f1bbf908f1022647acec97ad46092ae",
      "deletions": 0,
      "filename": "tests/v1/kv_connector/unit/test_mooncake_connector.py",
      "patch": "@@ -1105,6 +1105,15 @@ def test_scheduler_request_finished():\n     assert \"id-1\" in scheduler_connector._reqs_need_send\n     assert scheduler_connector._reqs_need_send[\"id-1\"][1] == [[10, 11]]\n \n+    # Case: Stop token sampled as the single prefill token (the router\n+    # discards it, so the decoder still needs the KV)\n+    scheduler_connector._reqs_need_send.clear()\n+    request.status = RequestStatus.FINISHED_STOPPED\n+    delay_free, _ = scheduler_connector.request_finished(request, block_ids=([10, 11],))\n+    assert delay_free is True\n+    assert scheduler_connector._reqs_need_send[\"id-1\"][1] == [[10, 11]]\n+    assert \"id-1\" not in scheduler_connector._reqs_not_processed\n+\n     # Case: Aborted (No need to transfer, free blocks immediately)\n     scheduler_connector._reqs_need_send.clear()\n     request.status = RequestStatus.FINISHED_ABORTED",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c17f23745f1bbf908f1022647acec97ad46092ae/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_mooncake_connector.py",
      "sha": "7cfdba2f695c84b4a61a86a93a23b40581bc191c",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c17f23745f1bbf908f1022647acec97ad46092ae/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmooncake%2Fmooncake_connector.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmooncake%2Fmooncake_connector.py?ref=c17f23745f1bbf908f1022647acec97ad46092ae",
      "deletions": 1,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/mooncake/mooncake_connector.py",
      "patch": "@@ -1216,7 +1216,12 @@ def request_finished(\n \n         assert not self.is_kv_consumer\n \n-        if request.status != RequestStatus.FINISHED_LENGTH_CAPPED:\n+        # The sampled token is discarded by the router, so a prefill that ends\n+        # on a stop token (FINISHED_STOPPED) still has KV the decoder needs.\n+        if request.status not in (\n+            RequestStatus.FINISHED_LENGTH_CAPPED,\n+            RequestStatus.FINISHED_STOPPED,\n+        ):\n             # Also include the case of a P/D Prefill request with immediate\n             # block free (eg abort). Stop tracking this request.\n             self._reqs_not_processed.add(params[\"transfer_id\"])",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c17f23745f1bbf908f1022647acec97ad46092ae/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmooncake%2Fmooncake_connector.py",
      "sha": "425168f990993222144cf023b1489565b24b86cc",
      "status": "modified"
    }
