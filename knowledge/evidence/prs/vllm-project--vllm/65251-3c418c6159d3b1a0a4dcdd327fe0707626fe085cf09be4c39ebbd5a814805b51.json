      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fdeterminism%2Ftest_mx_linear_batch_invariant.py?ref=7d5a15a548b7611d5a1adbf38ddf7fa20d1a6ae4",
      "deletions": 3,
      "filename": "tests/v1/determinism/test_mx_linear_batch_invariant.py",
      "patch": "@@ -116,16 +116,15 @@ def _mxfp8_weights(n: int, k: int):\n def test_mxfp4_linear_is_batch_invariant(n: int, k: int, use_asm_gemm: bool):\n     pytest.importorskip(\"aiter\")\n \n-    # Importing the module registers torch.ops.vllm.gemm_with_dynamic_quant.\n-    import vllm.model_executor.kernels.linear.mxfp4.aiter  # noqa: F401\n+    from vllm._aiter_ops import rocm_aiter_ops\n \n     set_random_seed(SEED)\n     weight, weight_scale = _mxfp4_weights(n, k, use_asm_gemm)\n     x = torch.randn(max(MXFP4_TOKEN_COUNTS), k, device=\"cuda\", dtype=torch.bfloat16)\n \n     probes = {\n         num_tokens: _probe(\n-            torch.ops.vllm.gemm_with_dynamic_quant(\n+            rocm_aiter_ops.mxfp4_gemm_dynamic_quant(\n                 x[:num_tokens], weight, weight_scale, use_asm_gemm, torch.bfloat16\n             )\n         )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7d5a15a548b7611d5a1adbf38ddf7fa20d1a6ae4/tests%2Fv1%2Fdeterminism%2Ftest_mx_linear_batch_invariant.py",
      "sha": "e2cb0c1fc60d340f5e2f83c102c73d5b89f3b80c",
      "status": "modified"
    },
    {
      "additions": 125,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7d5a15a548b7611d5a1adbf38ddf7fa20d1a6ae4/vllm%2F_aiter_ops.py",
      "changes": 125,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2F_aiter_ops.py?ref=7d5a15a548b7611d5a1adbf38ddf7fa20d1a6ae4",
      "deletions": 0,
      "filename": "vllm/_aiter_ops.py",
      "patch": "@@ -929,6 +929,110 @@ def _rocm_aiter_w8a8_gemm_fake(\n     return Y\n \n \n+def _rocm_aiter_mxfp4_gemm_dynamic_quant_impl(\n+    x: torch.Tensor,\n+    weight: torch.Tensor,\n+    weight_scale: torch.Tensor,\n+    rocm_use_aiter_fp4_asm_gemm: bool = False,\n+    out_dtype: torch.dtype | None = torch.bfloat16,\n+    x_scales: torch.Tensor | None = None,\n+) -> torch.Tensor:\n+    from aiter.ops.triton.gemm_afp4wfp4 import (\n+        gemm_afp4wfp4,\n+        gemm_afp4wfp4_preshuffle,\n+    )\n+    from aiter.ops.triton.quant import dynamic_mxfp4_quant\n+\n+    if rocm_use_aiter_fp4_asm_gemm:\n+        from aiter import gemm_a4w4, per_1x32_f4_quant_hip\n+\n+    M = x.shape[0]\n+    N = weight.shape[0]\n+    K = weight.shape[1]\n+    if rocm_use_aiter_fp4_asm_gemm:\n+        # The preshuffle kernel's tuned configs split K in some M buckets.\n+        if (\n+            M <= 64\n+            and not envs.VLLM_BATCH_INVARIANT\n+            and rocm_aiter_ops.is_triton_gemm_afp4wfp4_presh_ws_tuned(N, K)\n+        ):\n+            if x_scales is None:\n+                # use hip quant kernel for performance\n+                if M >= 32:\n+                    x_q, x_s = per_1x32_f4_quant_hip(x, shuffle=True)\n+                else:\n+                    x_q, x_s = per_1x32_f4_quant_hip(x, shuffle=False)\n+            else:\n+                x_q = x\n+                x_s = x_scales\n+\n+            if M >= 32:\n+                x_s = x_s.view(torch.uint8).view(x_s.shape[0] // 32, -1)\n+            else:\n+                x_s = x_s[:M, ...].view(torch.uint8)\n+\n+            y = torch.empty(M, N, device=x_q.device, dtype=out_dtype)\n+            gemm_afp4wfp4_preshuffle(\n+                x_q.view(torch.uint8),\n+                weight.view(torch.uint8).view(weight.shape[0] // 16, -1),\n+                x_s,\n+                weight_scale.view(torch.uint8).view(weight_scale.shape[0] // 32, -1),\n+                out_dtype,\n+                y,\n+            )\n+        else:\n+            if x_scales is None:\n+                # use hip quant kernel for performance\n+                x_q, x_s = per_1x32_f4_quant_hip(x, shuffle=True)\n+            else:\n+                x_q = x\n+                x_s = x_scales\n+\n+            y = gemm_a4w4(\n+                x_q,\n+                weight.view(x_q.dtype),\n+                x_s,\n+                weight_scale.view(x_s.dtype),\n+                dtype=out_dtype,\n+                bpreshuffle=True,\n+            )\n+        return y[:M]\n+    else:\n+        if x_scales is None:\n+            x_q, x_s = dynamic_mxfp4_quant(x)\n+        else:\n+            x_q = x\n+            x_s = x_scales\n+        y = torch.empty(\n+            x_q.shape[0], weight.shape[0], device=x_q.device, dtype=out_dtype\n+        )\n+\n+        config = None\n+        if envs.VLLM_BATCH_INVARIANT:\n+            # The configs split K in some M buckets (up to M <= 256 for\n+            # tuned shapes). Keep the tile, drop the split.\n+            from aiter.ops.triton.gemm_afp4wfp4 import _get_config\n+\n+            config, _ = _get_config(M, N, K)\n+            config = dict(config, NUM_KSPLIT=1)\n+\n+        gemm_afp4wfp4(x_q, weight, x_s, weight_scale.T, out_dtype, y, config)\n+        return y\n+\n+\n+def _rocm_aiter_mxfp4_gemm_dynamic_quant_fake(\n+    x: torch.Tensor,\n+    weight: torch.Tensor,\n+    weight_scale: torch.Tensor,\n+    rocm_use_aiter_fp4_asm_gemm: bool = False,\n+    out_dtype: torch.dtype | None = torch.bfloat16,\n+    x_scales: torch.Tensor | None = None,\n+) -> torch.Tensor:\n+    return torch.empty(\n+        (*x.shape[:-1], weight.shape[0]), dtype=out_dtype, device=x.device\n+    )\n+\n+\n def _rocm_aiter_preshuffled_per_token_w8a8_gemm_impl(\n     A: torch.Tensor,\n     B: torch.Tensor,\n@@ -3176,6 +3280,14 @@ def register_ops_once() -> None:\n                 fake_impl=_rocm_aiter_w8a8_gemm_fake,\n             )\n \n+            direct_register_custom_op(\n+                op_name=\"rocm_aiter_mxfp4_gemm_dynamic_quant\",\n+                op_func=_rocm_aiter_mxfp4_gemm_dynamic_quant_impl,\n+                mutates_args=[],\n+                fake_impl=_rocm_aiter_mxfp4_gemm_dynamic_quant_fake,\n+                dispatch_key=current_platform.dispatch_key,\n+            )\n+\n             direct_register_custom_op(\n                 op_name=\"_rocm_aiter_preshuffled_per_token_w8a8_gemm\",\n                 op_func=_rocm_aiter_preshuffled_per_token_w8a8_gemm_impl,\n@@ -3503,6 +3615,19 @@ def w8a8_gemm(\n     ) -> torch.Tensor:\n         return torch.ops.vllm.rocm_aiter_w8a8_gemm(A, B, As, Bs, bias, output_dtype)\n \n+    @staticmethod\n+    def mxfp4_gemm_dynamic_quant(\n+        x: torch.Tensor,\n+        weight: torch.Tensor,\n+        weight_scale: torch.Tensor,\n+        rocm_use_aiter_fp4_asm_gemm: bool = False,\n+        out_dtype: torch.dtype | None = torch.bfloat16,\n+        x_scales: torch.Tensor | None = None,\n+    ) -> torch.Tensor:\n+        return torch.ops.vllm.rocm_aiter_mxfp4_gemm_dynamic_quant(\n+            x, weight, weight_scale, rocm_use_aiter_fp4_asm_gemm, out_dtype, x_scales\n+        )\n+\n     @staticmethod\n     def preshuffled_per_token_w8a8_gemm(\n         A: torch.Tensor,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7d5a15a548b7611d5a1adbf38ddf7fa20d1a6ae4/vllm%2F_aiter_ops.py",
