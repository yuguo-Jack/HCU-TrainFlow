      "additions": 32,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7e4d3c0bab0f2b73797e9b29c41ad068c188663a/tests%2Fmodels%2Fmultimodal%2Fprocessing%2Ftest_unlimited_ocr.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Fmultimodal%2Fprocessing%2Ftest_unlimited_ocr.py?ref=7e4d3c0bab0f2b73797e9b29c41ad068c188663a",
      "deletions": 0,
      "filename": "tests/models/multimodal/processing/test_unlimited_ocr.py",
      "patch": "@@ -0,0 +1,32 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import pytest\n+\n+from vllm.multimodal import MULTIMODAL_REGISTRY\n+from vllm.transformers_utils.processors.deepseek_ocr import calculate_aspect_ratios\n+\n+from ...utils import build_model_context\n+\n+\n+@pytest.mark.usefixtures(\"default_vllm_config\")\n+def test_profiling_tokens_cover_all_crop_grids():\n+    \"\"\"Every supported crop grid fits the profiled image token budget.\"\"\"\n+    ctx = build_model_context(\n+        \"baidu/Unlimited-OCR\",\n+        limit_mm_per_prompt={\"image\": 1},\n+        model_config_kwargs={\"max_model_len\": 8192},\n+    )\n+    mm_processor = MULTIMODAL_REGISTRY.create_processor(ctx.model_config)\n+    hf_processor = mm_processor.info.get_hf_processor()\n+    dummy_inputs = mm_processor.get_dummy_mm_inputs({\"image\": 1})\n+    budget = dummy_inputs[\"mm_placeholders\"][\"image\"][0].get_num_embeds()\n+\n+    for width_tiles, height_tiles in calculate_aspect_ratios(\n+        max_num=hf_processor.max_crops\n+    ):\n+        num_tokens = mm_processor.info.get_num_image_tokens(\n+            image_width=width_tiles * hf_processor.image_size,\n+            image_height=height_tiles * hf_processor.image_size,\n+        )\n+        assert num_tokens <= budget, (width_tiles, height_tiles, num_tokens, budget)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7e4d3c0bab0f2b73797e9b29c41ad068c188663a/tests%2Fmodels%2Fmultimodal%2Fprocessing%2Ftest_unlimited_ocr.py",
      "sha": "3a93fe6f22b6f5291271d4e0268b1ba82c432a9c",
      "status": "added"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7e4d3c0bab0f2b73797e9b29c41ad068c188663a/vllm%2Fmodel_executor%2Fmodels%2Funlimited_ocr.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Funlimited_ocr.py?ref=7e4d3c0bab0f2b73797e9b29c41ad068c188663a",
      "deletions": 4,
      "filename": "vllm/model_executor/models/unlimited_ocr.py",
      "patch": "@@ -162,10 +162,8 @@ def get_num_image_tokens(\n         return global_views_tokens + local_views_tokens + 1\n \n     def get_image_size_with_most_features(self) -> ImageSize:\n-        # With max_crops=32, the widest possible grid is 4×8 (aspect ratio 1:2).\n-        # A 2560×5120 image (4×640 × 8×640) selects exactly 4×8=32 tiles and\n-        # produces the maximum token count.\n-        return ImageSize(width=640 * 4, height=640 * 8)\n+        # A vertical grid maximizes both crop count and newline tokens.\n+        return ImageSize(width=IMAGE_SIZE, height=IMAGE_SIZE * _UNLIMITED_OCR_MAX_CROPS)\n \n \n class UnlimitedOCRMultiModalProcessor(DeepseekOCRMultiModalProcessor):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7e4d3c0bab0f2b73797e9b29c41ad068c188663a/vllm%2Fmodel_executor%2Fmodels%2Funlimited_ocr.py",
      "sha": "1c728d53bb2e486cfc9e1269c00d0ac0db44ceda",
      "status": "modified"
    }
