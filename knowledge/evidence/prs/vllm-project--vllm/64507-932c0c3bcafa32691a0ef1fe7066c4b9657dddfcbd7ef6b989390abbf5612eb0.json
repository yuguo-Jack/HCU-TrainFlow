      "additions": 19,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d4a0dcd44d571b1b01e7a87f63ec49f23f5aead8/tests%2Futils_%2Ftest_cpu_resource_utils.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Futils_%2Ftest_cpu_resource_utils.py?ref=d4a0dcd44d571b1b01e7a87f63ec49f23f5aead8",
      "deletions": 0,
      "filename": "tests/utils_/test_cpu_resource_utils.py",
      "patch": "@@ -230,6 +230,25 @@ def test_visible_memory_node_sim_multi_numa_ignores_assigned_ids(\n     assert cru.get_visible_memory_node([2]) == [0, 1, 2, 3, 4, 5]\n \n \n+def test_visible_memory_node_no_matching_id_falls_back_to_allowed(\n+    six_numa_nodes, monkeypatch\n+):\n+    # DP=2 x TP=2 on a 2-NUMA host: DP rank 1 gets device ids [2, 3], which\n+    # name no NUMA node. Returning an empty list crashes the caller's\n+    # allowed_memory_nodes[0] fallback (#64497).\n+    monkeypatch.setattr(cru, \"get_memory_affinity\", lambda: [0, 1])\n+    assert cru.get_visible_memory_node([2, 3]) == [0, 1]\n+\n+\n+def test_visible_memory_node_partial_match_keeps_only_matches(\n+    six_numa_nodes, monkeypatch\n+):\n+    # A partial overlap still narrows to the matching nodes; only a complete\n+    # miss falls back to the full allowed list.\n+    monkeypatch.setattr(cru, \"get_memory_affinity\", lambda: [0, 1])\n+    assert cru.get_visible_memory_node([1, 2, 3]) == [1]\n+\n+\n def test_omp_manager_binds_each_dp_rank_to_its_assigned_node(monkeypatch):\n     \"\"\"DP ranks with different assigned NUMA nodes get disjoint cores (#47328).\"\"\"\n     # 2 nodes x 4 physical cores x 2 logical CPUs",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d4a0dcd44d571b1b01e7a87f63ec49f23f5aead8/tests%2Futils_%2Ftest_cpu_resource_utils.py",
      "sha": "112b9c12627ec3956cba5b306abd207a611d1256",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d4a0dcd44d571b1b01e7a87f63ec49f23f5aead8/vllm%2Futils%2Fcpu_resource_utils.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Futils%2Fcpu_resource_utils.py?ref=d4a0dcd44d571b1b01e7a87f63ec49f23f5aead8",
      "deletions": 1,
      "filename": "vllm/utils/cpu_resource_utils.py",
      "patch": "@@ -255,6 +255,12 @@ def get_visible_memory_node(assigned_node_ids: list[int] | None = None) -> list[\n     assigned_node_ids is the per-DP-rank list of NUMA node ids from\n     parallel_config.assigned_physical_gpu_ids. It takes priority over the\n     CPU_VISIBLE_MEMORY_NODES env var, which still applies when it is None.\n+\n+    On CPU the ids are logical device indices, which coincide with NUMA\n+    node ids only when the host has at least as many nodes as devices. When\n+    none of the ids names an existing node (e.g. DP=2 x TP=2 on a 2-node\n+    host, where the second DP rank gets device ids [2, 3]), fall back to\n+    the full allowed list instead of returning an empty one (#64497).\n     \"\"\"\n     if sys.platform == \"darwin\":\n         return [0]\n@@ -265,7 +271,10 @@ def get_visible_memory_node(assigned_node_ids: list[int] | None = None) -> list[\n         return allowed_memory_node_list\n \n     if assigned_node_ids is not None:\n-        return [node for node in assigned_node_ids if node in allowed_memory_node_list]\n+        filtered = [\n+            node for node in assigned_node_ids if node in allowed_memory_node_list\n+        ]\n+        return filtered if filtered else allowed_memory_node_list\n \n     env_key = DEVICE_CONTROL_ENV_VAR\n     if env_key in os.environ and os.environ[env_key] != \"\":",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d4a0dcd44d571b1b01e7a87f63ec49f23f5aead8/vllm%2Futils%2Fcpu_resource_utils.py",
      "sha": "98b3ac65cf1044c5f2da601826c7e1d6bf9576a9",
      "status": "modified"
    }
  ],
