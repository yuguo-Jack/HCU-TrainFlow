      "additions": 21,
      "blob_url": "https://github.com/vllm-project/vllm/blob/490ccc831f4cf1fadafc1a8343af1252420ad67f/tests%2Fparser%2Ftest_chat_parsing.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fparser%2Ftest_chat_parsing.py?ref=490ccc831f4cf1fadafc1a8343af1252420ad67f",
      "deletions": 0,
      "filename": "tests/parser/test_chat_parsing.py",
      "patch": "@@ -1563,6 +1563,27 @@ def test_coerce_integer_accepts_whole_number_floats(self):\n         self.assertEqual(_coerce(\"inf\", (\"integer\",)), \"inf\")\n         self.assertEqual(_coerce(\"NaN\", (\"integer\",)), \"NaN\")\n \n+    def test_parse_response_preserves_integer_argument_precision(self):\n+        tools = _set_alarm_tools(record_id={\"type\": \"integer\"})\n+        for raw, expected in [\n+            (\"9223372036854775807.0\", 9223372036854775807),\n+            (\"9.007199254740993e15\", 9007199254740993),\n+            (\"1.0000000000000001\", \"1.0000000000000001\"),\n+            (\"1e-400\", \"1e-400\"),\n+            (\"1e400\", \"1e400\"),\n+            (\"1e-99999999999999999999\", \"1e-99999999999999999999\"),\n+        ]:\n+            with self.subTest(raw=raw):\n+                text = (\n+                    \"<tool_call><function=set_alarm>\"\n+                    f\"<parameter=record_id>{raw}</parameter>\"\n+                    \"</function></tool_call>\"\n+                )\n+                parsed = parse_response(\n+                    text, _XML_STRING_ARGS_TEMPLATE, prefix=\"\", tools=tools\n+                )\n+                self.assertEqual(_first_tool_args(parsed)[\"record_id\"], expected)\n+\n     def test_coerce_handles_any_of_and_null(self):\n         self.assertEqual(_coerce(\"5\", (\"integer\", \"null\")), 5)\n         self.assertIsNone(_coerce(\"null\", (\"integer\", \"null\")))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/490ccc831f4cf1fadafc1a8343af1252420ad67f/tests%2Fparser%2Ftest_chat_parsing.py",
      "sha": "2c5ccbb1aacad5940598f0374b36124a17dbd62b",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/490ccc831f4cf1fadafc1a8343af1252420ad67f/vllm%2Fparser%2Fchat_parsing%2Fresponse_parser.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fparser%2Fchat_parsing%2Fresponse_parser.py?ref=490ccc831f4cf1fadafc1a8343af1252420ad67f",
      "deletions": 2,
      "filename": "vllm/parser/chat_parsing/response_parser.py",
      "patch": "@@ -21,6 +21,7 @@\n \n import copy\n import json\n+from decimal import Decimal, InvalidOperation\n from typing import Any\n \n from .content_parsers import STREAMABLE_PARSERS, process_field\n@@ -57,7 +58,11 @@ def _coerce(raw: str, types: tuple[str, ...]) -> Any:\n                     number = float(raw)\n                     if not number.is_integer():\n                         continue\n-                    return int(number)\n+                    # Preserve decimal precision when converting to an integer.\n+                    decimal_number = Decimal(raw)\n+                    if decimal_number != decimal_number.to_integral_value():\n+                        continue\n+                    return int(decimal_number)\n             if type_name == \"number\":\n                 number = float(raw)\n                 if number != number or number in (float(\"inf\"), float(\"-inf\")):\n@@ -72,7 +77,7 @@ def _coerce(raw: str, types: tuple[str, ...]) -> Any:\n                 decoded = json.loads(raw)\n                 if isinstance(decoded, dict if type_name == \"object\" else list):\n                     return decoded\n-        except ValueError:\n+        except (ValueError, InvalidOperation):\n             continue\n     return raw  # `string` params, unknown types and failed casts all keep the original text\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/490ccc831f4cf1fadafc1a8343af1252420ad67f/vllm%2Fparser%2Fchat_parsing%2Fresponse_parser.py",
