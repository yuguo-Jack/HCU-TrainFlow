      "deletions": 5,
      "filename": ".buildkite/test_areas/models_language.yaml",
      "patch": "@@ -61,9 +61,10 @@ steps:\n       - tests/models/language/pooling/test_classification.py\n       - vllm/_aiter_ops.py\n       - vllm/platforms/rocm.py\n-- label: \":nvidia: (H200 MIG 35GB) Language Models (Hybrid) Shard %N\"\n+- label: \":nvidia: (H200 MIG 35GB) Language Models (Hybrid)\"\n   device: h200_35gb\n   key: language-models-tests-hybrid\n+  automatic_shard: true\n   timeout_in_minutes: 65\n   env:\n     # GitHub intermittently rejects HTTP/2 upload-pack requests from the H200\n@@ -82,11 +83,11 @@ steps:\n     - rm -rf /tmp/mamba-src && git clone --depth 1 --branch v2.3.0 https://github.com/state-spaces/mamba /tmp/mamba-src && sed -i 's/-std=c++17/-std=c++20/g' /tmp/mamba-src/setup.py && MAMBA_FORCE_BUILD=TRUE uv pip install --system --no-build-isolation /tmp/mamba-src\n     - CAUSAL_CONV1D_FORCE_BUILD=TRUE uv pip install --system --no-build-isolation 'git+https://github.com/Dao-AILab/causal-conv1d@v1.6.0'\n     # Shard the hybrid language model tests that are numerically stable on Hopper.\n-    - pytest -v -s models/language/generation -m hybrid_model -k 'not granite-4.0-tiny-preview' --num-shards=$$BUILDKITE_PARALLEL_JOB_COUNT --shard-id=$$BUILDKITE_PARALLEL_JOB\n-  parallelism: 2\n+    - pytest -v -s models/language/generation -m hybrid_model -k 'not granite-4.0-tiny-preview'\n   mirror:\n     amd:\n-      label: \":amd: (MI355 DPX) Language Models (Hybrid) Shard %N\"\n+      automatic_shard: true\n+      label: \":amd: (MI355 DPX) Language Models (Hybrid)\"\n       dind: false\n       device: mi355_dpx\n       timeout_in_minutes: 65\n@@ -95,13 +96,14 @@ steps:\n       commands:\n       - MAMBA_FORCE_BUILD=TRUE uv pip install --system --no-build-isolation 'git+https://github.com/AndreasKaratzas/mamba@fix-rocm-7.0-warp-size-constexpr'\n       - CAUSAL_CONV1D_FORCE_BUILD=TRUE uv pip install --system --no-build-isolation 'git+https://github.com/Dao-AILab/causal-conv1d@v1.6.0'\n-      - pytest -v -s models/language/generation -m hybrid_model -k 'not granite-4.0-tiny-preview' --num-shards=$$BUILDKITE_PARALLEL_JOB_COUNT --shard-id=$$BUILDKITE_PARALLEL_JOB\n+      - pytest -v -s models/language/generation -m hybrid_model -k 'not granite-4.0-tiny-preview'\n \n # Granite 4 hybrid generation is sensitive to hardware-specific Triton SSD\n # autotuning (https://github.com/vllm-project/vllm/issues/25194). Keep this one\n # correctness test on L4 until its H200 output matches the Transformers reference.\n - label: \":nvidia: (L4) Granite Language Model Compatibility\"\n   key: language-models-tests-granite-l4-compatibility\n+  automatic_shard: true\n   device: l4\n   num_devices: 1\n   timeout_in_minutes: 65\n@@ -117,6 +119,7 @@ steps:\n     - pytest -v -s models/language/generation -m hybrid_model -k 'granite-4.0-tiny-preview'\n   mirror:\n     amd:\n+      automatic_shard: true\n       label: \":amd: (MI355 DPX) Granite Language Model Compatibility\"\n       dind: false\n       device: mi355_dpx\n@@ -140,6 +143,7 @@ steps:\n - label: \":nvidia: (H200 MIG 35GB) [Nightly] Language Models (Extended Generation)\"\n   device: h200_35gb\n   key: language-models-test-extended-generation\n+  automatic_shard: true\n   timeout_in_minutes: 80\n   optional: true\n   source_file_dependencies:\n@@ -155,6 +159,7 @@ steps:\n     - pytest -v -s models/language/generation -m '(not core_model) and (not hybrid_model)'\n   mirror:\n     amd:\n+      automatic_shard: true\n       label: \":amd: (MI355 DPX) Language Models (Extended Generation)\"\n       dind: false\n       device: mi355_dpx",
