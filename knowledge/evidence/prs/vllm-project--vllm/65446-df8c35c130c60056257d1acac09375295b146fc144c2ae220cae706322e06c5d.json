    {
      "additions": 46,
      "blob_url": "https://github.com/vllm-project/vllm/blob/acbd577cc28de8f839aef07ad09d9c5c08edef02/tests%2Fcompile%2Ftest_wrapper.py",
      "changes": 46,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fcompile%2Ftest_wrapper.py?ref=acbd577cc28de8f839aef07ad09d9c5c08edef02",
      "deletions": 0,
      "filename": "tests/compile/test_wrapper.py",
      "patch": "@@ -15,6 +15,7 @@\n from vllm.config import (\n     CompilationConfig,\n     CompilationMode,\n+    CUDAGraphMode,\n     VllmConfig,\n     set_current_vllm_config,\n )\n@@ -159,6 +160,51 @@ def forward(self, x: torch.Tensor):\n     assert len(graphs) == 1\n \n \n+class BufferMod(torch.nn.Module):\n+    def __init__(self):\n+        super().__init__()\n+        self.register_buffer(\"buffer\", torch.ones(1))\n+\n+    def forward(self, x: torch.Tensor):\n+        return x + self.buffer\n+\n+\n+class BufferAssignWrapper(MyWrapper):\n+    def forward(self, x: torch.Tensor):  # type: ignore[override]\n+        self.model.buffer = self.model.buffer.to(x.device)\n+        return self.model(x)\n+\n+\n+class KwargsUpdateWrapper(MyWrapper):\n+    def forward(self, x: torch.Tensor, **kwargs):  # type: ignore[override]\n+        kwargs[\"scale\"] = 2\n+        return self.model(x) * kwargs[\"scale\"]\n+\n+\n+@pytest.mark.parametrize(\n+    \"wrapper_cls, raises\",\n+    [(BufferAssignWrapper, True), (KwargsUpdateWrapper, False)],\n+)\n+def test_cudagraph_buffer_assignment_check(wrapper_cls, raises, monkeypatch):\n+    \"\"\"Buffer assignment is rejected under cudagraphs, other `update`s are not.\"\"\"\n+    monkeypatch.setenv(\"VLLM_USE_BYTECODE_HOOK\", \"1\")\n+    monkeypatch.setattr(\"depyf.decompile\", lambda code: \"\")\n+    vllm_config = VllmConfig()\n+    vllm_config.compilation_config = CompilationConfig(\n+        mode=CompilationMode.DYNAMO_TRACE_ONCE,\n+        backend=\"eager\",\n+        cudagraph_mode=CUDAGraphMode.PIECEWISE,\n+    )\n+    torch._dynamo.reset()\n+    with set_current_vllm_config(vllm_config):\n+        wrapper = wrapper_cls(BufferMod())\n+        if raises:\n+            with pytest.raises(Exception, match=\"modifying buffers\"):\n+                wrapper(torch.ones(2))\n+        else:\n+            wrapper(torch.ones(2))\n+\n+\n if __name__ == \"__main__\":\n     # Run with both parameter values\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/acbd577cc28de8f839aef07ad09d9c5c08edef02/tests%2Fcompile%2Ftest_wrapper.py",
      "sha": "88ed63a0751552f305394fcdfa89d128d63eba77",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/vllm-project/vllm/blob/acbd577cc28de8f839aef07ad09d9c5c08edef02/vllm%2Fcompilation%2Fwrapper.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fcompilation%2Fwrapper.py?ref=acbd577cc28de8f839aef07ad09d9c5c08edef02",
      "deletions": 1,
      "filename": "vllm/compilation/wrapper.py",
      "patch": "@@ -1,6 +1,8 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n \n+import dis\n+import itertools\n import os\n import sys\n from abc import abstractmethod\n@@ -29,6 +31,15 @@\n P = ParamSpec(\"P\")\n \n \n+def _updates_module_buffers(code: CodeType) -> bool:\n+    \"\"\"Whether `code` calls `<module>._buffers.update`, which Dynamo emits for\n+    buffers assigned during forward.\"\"\"\n+    return any(\n+        a.argval == \"_buffers\" and b.argval == \"update\"\n+        for a, b in itertools.pairwise(dis.get_instructions(code))\n+    )\n+\n+\n @contextmanager\n def _compilation_context() -> Generator[None, None, None]:\n     \"\"\"Context manager for compilation settings.\n@@ -270,7 +281,7 @@ def bytecode_hook(self, old_code: CodeType, new_code: CodeType) -> None:\n \n         if (\n             self.vllm_config.compilation_config.cudagraph_mode != CUDAGraphMode.NONE\n-            and \"update\" in new_code.co_names\n+            and _updates_module_buffers(new_code)\n         ):\n             import depyf\n ",
