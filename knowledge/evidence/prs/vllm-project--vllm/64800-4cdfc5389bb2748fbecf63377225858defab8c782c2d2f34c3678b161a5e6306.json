      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Frenderers%2Fmistral.py?ref=de54a8c644ffeae710fcb5f0a3f56d53e1a74a2e",
      "deletions": 0,
      "filename": "vllm/renderers/mistral.py",
      "patch": "@@ -22,13 +22,35 @@\n logger = init_logger(__name__)\n \n \n+def _convert_developer_to_system(\n+    messages: list[ChatCompletionMessageParam],\n+) -> list[ChatCompletionMessageParam]:\n+    converted: list[ChatCompletionMessageParam] = []\n+    for msg in messages:\n+        if msg[\"role\"] == \"developer\":\n+            new_msg = dict(msg)\n+            new_msg[\"role\"] = \"system\"\n+            new_msg.pop(\"tools\", None)\n+            converted.append(new_msg)  # type: ignore[arg-type]\n+        else:\n+            converted.append(msg)\n+    return converted\n+\n+\n def safe_apply_chat_template(\n     tokenizer: MistralTokenizer,\n     messages: list[ChatCompletionMessageParam],\n     **kwargs,\n ) -> str | list[int]:\n     from mistral_common.exceptions import MistralCommonException\n \n+    if any(msg[\"role\"] == \"developer\" for msg in messages):\n+        messages = _convert_developer_to_system(messages)\n+        logger.info_once(\n+            \"Mistral chat templates do not support the 'developer' role. \"\n+            \"Converting developer messages to 'system' role.\",\n+        )\n+\n     try:\n         return tokenizer.apply_chat_template(messages, **kwargs)\n     # mistral-common uses assert statements to stop processing of input",
