      "changes": 18,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_parsers%2Ftest_utils.py?ref=8ca07beaba610a3cf2ef503f12edcb291ab10f1d",
      "deletions": 0,
      "filename": "tests/tool_parsers/test_utils.py",
      "patch": "@@ -87,6 +87,20 @@ def test_uint32_alias(self):\n         def test_long_alias(self):\n             assert coerce_to_schema_type(\"100\", \"long\") == 100\n \n+        def test_non_canonical_integer_spellings_stay_strings(self):\n+            # Leading zeros, underscores and a leading '+' are not valid JSON\n+            # numbers; coercing them with int() would silently rewrite a value\n+            # the schema also admits as a string (#62252).\n+            assert coerce_to_schema_type(\"0017\", [\"string\", \"integer\"]) == \"0017\"\n+            assert coerce_to_schema_type(\"1_000\", [\"string\", \"integer\"]) == \"1_000\"\n+            assert coerce_to_schema_type(\"+17\", [\"string\", \"integer\"]) == \"+17\"\n+\n+        def test_non_canonical_integer_not_coerced_even_without_string(self):\n+            assert coerce_to_schema_type(\"0017\", \"integer\") == \"0017\"\n+\n+        def test_canonical_integers_still_coerce_in_mixed_schema(self):\n+            assert coerce_to_schema_type(\"17\", [\"string\", \"integer\"]) == 17\n+\n     class TestNumberType:\n         def test_number_type(self):\n             assert coerce_to_schema_type(\"3.14\", \"number\") == 3.14\n@@ -101,6 +115,10 @@ def test_whole_float_returns_int(self):\n             assert coerce_to_schema_type(\"5.0\", \"number\") == 5\n             assert isinstance(coerce_to_schema_type(\"5.0\", \"number\"), int)\n \n+        def test_non_canonical_number_spellings_stay_strings(self):\n+            assert coerce_to_schema_type(\"0017.5\", [\"string\", \"number\"]) == \"0017.5\"\n+            assert coerce_to_schema_type(\"1_000.5\", [\"string\", \"number\"]) == \"1_000.5\"\n+\n         def test_invalid_number_fallback(self):\n             assert coerce_to_schema_type(\"abc\", \"number\") == \"abc\"\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8ca07beaba610a3cf2ef503f12edcb291ab10f1d/tests%2Ftool_parsers%2Ftest_utils.py",
      "sha": "1bc12e71ac4192ad31740dd9bc5af8ebea60acd9",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8ca07beaba610a3cf2ef503f12edcb291ab10f1d/vllm%2Ftool_parsers%2Futils.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Futils.py?ref=8ca07beaba610a3cf2ef503f12edcb291ab10f1d",
      "deletions": 3,
      "filename": "vllm/tool_parsers/utils.py",
      "patch": "@@ -5,6 +5,7 @@\n import json\n import keyword as _python_keyword\n import math\n+import re\n import warnings\n from collections.abc import Sequence\n from dataclasses import dataclass\n@@ -1150,6 +1151,14 @@ def extract_types_from_schema(schema: Any) -> list[str]:\n }\n \n \n+# JSON number grammar (RFC 8259): int() and float() also accept leading\n+# zeros, underscores and a leading '+', none of which are valid JSON numbers.\n+# Coercing those spellings loses information when the schema also admits a\n+# string (\"0017\" -> 17), so only the canonical forms may coerce (#62252).\n+_JSON_INTEGER_RE = re.compile(r\"-?(0|[1-9][0-9]*)$\")\n+_JSON_NUMBER_RE = re.compile(r\"-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?$\")\n+\n+\n def coerce_to_schema_type(value: str, schema_type: str | list[str]) -> Any:\n     \"\"\"Best-effort coercion of a raw string value to a JSON Schema type.\n \n@@ -1192,11 +1201,16 @@ def coerce_to_schema_type(value: str, schema_type: str | list[str]) -> Any:\n         if candidate_type == \"string\":\n             return value\n         if candidate_type == \"integer\":\n-            try:\n+            # JSON integer literals only: int() also accepts leading zeros,\n+            # underscores and a leading '+', which would silently rewrite a\n+            # string value the schema also admits (#62252).\n+            if _JSON_INTEGER_RE.fullmatch(value.strip()):\n                 return int(value)\n-            except (ValueError, TypeError):\n-                continue\n+            continue\n         if candidate_type == \"number\":\n+            # Same JSON grammar restriction as integer above.\n+            if not _JSON_NUMBER_RE.fullmatch(value.strip()):\n+                continue\n             try:\n                 val = float(value)\n             except (ValueError, TypeError):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8ca07beaba610a3cf2ef503f12edcb291ab10f1d/vllm%2Ftool_parsers%2Futils.py",
