      "deletions": 1,
      "filename": "vllm/_xpu_ops.py",
      "patch": "@@ -1035,14 +1035,14 @@ def flash_attn_varlen_func(\n         cu_seqlens_k: torch.Tensor | None = None,\n         # passed in qwen vl\n         dropout_p: float = 0.0,\n+        num_splits=0,\n         # The following parameters are not used in xpu kernel currently,\n         # we keep API compatible to CUDA's.\n         scheduler_metadata=None,\n         fa_version: int = 2,\n         q_descale=None,\n         k_descale=None,\n         v_descale=None,\n-        num_splits=0,\n         return_softmax_lse: bool | None = False,\n         s_aux: torch.Tensor | None = None,\n         return_attn_probs: bool | None = False,\n@@ -1081,6 +1081,7 @@ def flash_attn_varlen_func(\n             q=q,\n             k=k,\n             v=v,\n+            num_splits_kv=num_splits if num_splits > 0 else None,\n             cu_seqlens_q=cu_seqlens_q,\n             cu_seqlens_k=cu_seqlens_k,\n             seqused_k=seqused_k,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2f127c77d4420b915393829d8ad9836e5e262979/vllm%2F_xpu_ops.py",
