      "deletions": 0,
      "filename": "tests/entrypoints/launchers/test_run_batch.py",
      "patch": "@@ -1177,6 +1177,21 @@ def test_validate_batch_rejects_malformed_request(tmp_path):\n         validate_batch(f)\n \n \n+@pytest.mark.parametrize(\"url_field\", [{}, {\"url\": None}, {\"url\": 5}])\n+def test_validate_batch_reports_a_bad_url_field(tmp_path, url_field):\n+    \"\"\"A missing or non-string url is reported on its line, not as a KeyError.\"\"\"\n+    request = json.loads(INPUT_BATCH.split(\"\\n\")[0])\n+    request.pop(\"url\")\n+    request.update(url_field)\n+    input_path = _write_batch(tmp_path, [json.dumps(request)])\n+\n+    with (\n+        open(input_path, encoding=\"utf-8\") as f,\n+        pytest.raises(ValueError, match=r\"(?s)line 1:.*url\"),\n+    ):\n+        validate_batch(f)\n+\n+\n @pytest.mark.asyncio\n async def test_open_batch_input_keeps_a_carriage_return_inside_a_line(tmp_path):\n     \"\"\"A bare carriage return is JSON whitespace, not a line break.\"\"\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/07921cf0b79bc21c7e745a1721292dee4c8f9b77/tests%2Fentrypoints%2Flaunchers%2Ftest_run_batch.py",
