      "deletions": 1,
      "filename": "tests/v1/worker/test_gpu_gumbel_sample.py",
      "patch": "@@ -532,7 +532,7 @@ def test_logits_cache_narrower_than_logits_is_rejected():\n \n \n @pytest.mark.parametrize(\"dtype\", [torch.bfloat16, torch.float32])\n-@pytest.mark.parametrize(\"vocab\", [4096, 4097, 129280])\n+@pytest.mark.parametrize(\"vocab\", [1000, 4096, 4097, 129280])\n def test_greedy_argmax_matches_torch(dtype, vocab):\n     \"\"\"Random rows, cross-block ties, NaN/inf, masked tails and strided rows.\"\"\"\n     logits = torch.randn(64, vocab + 1, device=DEVICE, dtype=dtype)[:, 1:]",
      "raw_url": "https://github.com/vllm-project/vllm/raw/52793b80166c898ffa862187e6041b63f319a801/tests%2Fv1%2Fworker%2Ftest_gpu_gumbel_sample.py",
      "sha": "081a1502e6eb5fd9d4e56f2568fdc6a3dec1e2b4",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/52793b80166c898ffa862187e6041b63f319a801/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Fgreedy_argmax.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Fgreedy_argmax.py?ref=52793b80166c898ffa862187e6041b63f319a801",
      "deletions": 5,
      "filename": "vllm/v1/worker/gpu/sample/greedy_argmax.py",
      "patch": "@@ -36,10 +36,8 @@ def _argmax_finish(PV, PI, OUT, SPLITS: tl.constexpr, BLOCK: tl.constexpr):\n \n \n def greedy_argmax(logits: torch.Tensor) -> torch.Tensor:\n-    \"\"\"``logits.argmax(dim=-1)`` over a large vocabulary, split across CTAs.\n-\n-    Ties resolve to the first index. NaN logits are treated as -inf, so a row\n-    with NaN may differ from ``torch.argmax``, which returns the NaN's index.\n+    \"\"\"Like ``logits.argmax(dim=-1)``, but treats NaNs as -inf on every path.\n+    Ties resolve to the first index.\n     \"\"\"\n     if (\n         not logits.is_cuda\n@@ -48,7 +46,7 @@ def greedy_argmax(logits: torch.Tensor) -> torch.Tensor:\n         or logits.stride(1) != 1\n         or logits.shape[1] < 4096\n     ):\n-        return logits.argmax(dim=-1)\n+        return logits.masked_fill(logits.isnan(), float(\"-inf\")).argmax(dim=-1)\n     rows, vocab = logits.shape\n     out = torch.empty(rows, dtype=torch.int64, device=logits.device)\n     if rows == 0:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/52793b80166c898ffa862187e6041b63f319a801/vllm%2Fv1%2Fworker%2Fgpu%2Fsample%2Fgreedy_argmax.py",
