      "patch": "@@ -194,6 +194,13 @@ def load_lora_op_config(op_type: str, add_inputs: bool | None) -> dict | None:\n     return config_data\n \n \n+@lru_cache\n+def _is_hopper() -> bool:\n+    return current_platform.is_cuda() and current_platform.is_device_capability_family(\n+        90\n+    )\n+\n+\n @functools.lru_cache\n def get_lora_op_configs(\n     op_type: str,\n@@ -260,9 +267,18 @@ def get_lora_op_configs(\n             \"split_k\": 1,\n         }\n     else:\n+        if num_slices > 1:\n+            block_n = 64\n+        elif _is_hopper():\n+            # block_n=128 triggers a NaN-producing Triton/WGMMA codegen bug\n+            # for the single-slice expand kernel on Hopper (sm_90); see\n+            # https://github.com/vllm-project/vllm/issues/48590\n+            block_n = 32\n+        else:\n+            block_n = 128\n         default = {\n             \"block_m\": 64,\n-            \"block_n\": 64 if num_slices > 1 else 128,\n+            \"block_n\": block_n,\n             \"block_k\": 32,\n             \"num_warps\": 4,\n             \"num_ctas\": 1,",
