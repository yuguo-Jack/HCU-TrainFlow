  "files": [
    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f6dc11d1a44b9177bd378727a19e8ef6eb0407ac/docs%2Fusage%2Ftroubleshooting.md",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Fusage%2Ftroubleshooting.md?ref=f6dc11d1a44b9177bd378727a19e8ef6eb0407ac",
      "deletions": 0,
      "filename": "docs/usage/troubleshooting.md",
      "patch": "@@ -40,6 +40,8 @@ If other strategies don't solve the problem, it's likely that the vLLM instance\n - `export NCCL_DEBUG=TRACE` to turn on more logging for NCCL.\n - `export VLLM_TRACE_FUNCTION=1` to record all function calls for inspection in the log files to tell which function crashes or hangs. (WARNING: This flag will slow down the token generation by **over 100x**. Do not use unless absolutely needed.)\n \n+The DP coordinator's `Received stats for out-of-order step` diagnostic is logged at DEBUG level. Statistics from different engines can arrive in a different step order; this message alone does not indicate a failed request. Set `VLLM_LOGGING_LEVEL=DEBUG` to inspect these reports.\n+\n ## Breakpoints\n \n Setting normal `pdb` breakpoints may not work in vLLM's codebase if they are executed in a subprocess. You will experience something like:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f6dc11d1a44b9177bd378727a19e8ef6eb0407ac/docs%2Fusage%2Ftroubleshooting.md",
      "sha": "0e70923f2c466197f0c32c788502661a1b8261da",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f6dc11d1a44b9177bd378727a19e8ef6eb0407ac/vllm%2Fv1%2Fengine%2Fcoordinator.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Fcoordinator.py?ref=f6dc11d1a44b9177bd378727a19e8ef6eb0407ac",
      "deletions": 1,
      "filename": "vllm/v1/engine/coordinator.py",
      "patch": "@@ -391,7 +391,9 @@ def process_input_socket(\n                             elif stats_wave != last_stats_wave or (\n                                 stats_step != last_stats_step\n                             ):\n-                                logger.warning(\n+                                # Stats from different engines can arrive out of\n+                                # step order even when each engine reports in order.\n+                                logger.debug(\n                                     \"Received stats for out-of-order \"\n                                     \"step (%d, %d) from engine %d (expected \"\n                                     \"> (%d, %d))\",",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f6dc11d1a44b9177bd378727a19e8ef6eb0407ac/vllm%2Fv1%2Fengine%2Fcoordinator.py",
      "sha": "7d2c7106d0494753aa093419ca778f30e8370072",
      "status": "modified"
    }
  ],
