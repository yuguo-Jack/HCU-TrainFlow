      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/99b6fc42cc5c62923470dfe0cba5a3dc74c56533/vllm%2Fmodel_executor%2Fmodel_loader%2Fdefault_loader.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodel_loader%2Fdefault_loader.py?ref=99b6fc42cc5c62923470dfe0cba5a3dc74c56533",
      "deletions": 1,
      "filename": "vllm/model_executor/model_loader/default_loader.py",
      "patch": "@@ -488,6 +488,7 @@ def _init_ep_weight_filter(self, model_config: ModelConfig) -> None:\n \n     @instrument(span_name=\"Load weights\")\n     def load_weights(self, model: nn.Module, model_config: ModelConfig) -> None:\n+        load_weights_start = time.perf_counter()\n         if model_config.quantization == \"torchao\":\n             quant_config = get_quant_config(model_config, self.load_config)\n             if (\n@@ -503,9 +504,14 @@ def load_weights(self, model: nn.Module, model_config: ModelConfig) -> None:\n         loaded_weights = model.load_weights(self.get_all_weights(model_config, model))\n \n         self.counter_after_loading_weights = time.perf_counter()\n+        # `counter_before_loading_weights` is only set when the weights iterator\n+        # is first pulled from. A model whose `load_weights()` never consumes it,\n+        # such as a GGUF path that reads the checkpoint itself, leaves it at 0.0,\n+        # which would report the raw monotonic clock as the duration.\n+        started_at = self.counter_before_loading_weights or load_weights_start\n         logger.info_once(\n             \"Loading weights took %.2f seconds\",\n-            self.counter_after_loading_weights - self.counter_before_loading_weights,\n+            self.counter_after_loading_weights - started_at,\n         )\n         # We only enable strict check for non-quantized models\n         # that have loaded weights tracking by default.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/99b6fc42cc5c62923470dfe0cba5a3dc74c56533/vllm%2Fmodel_executor%2Fmodel_loader%2Fdefault_loader.py",
      "sha": "91dde5782ca9095748b8f267e94d568c379394ee",
      "status": "modified"
    }
