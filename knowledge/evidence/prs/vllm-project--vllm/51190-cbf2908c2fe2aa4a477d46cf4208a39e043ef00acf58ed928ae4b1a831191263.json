      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Fquantization%2Fcompressed_tensors%2Fcompressed_tensors.py?ref=ccc70f6d26a5932826fbf587e319985b3d966e6b",
      "deletions": 1,
      "filename": "vllm/model_executor/layers/quantization/compressed_tensors/compressed_tensors.py",
      "patch": "@@ -286,7 +286,13 @@ def _parse_sparsity_config(\n         sparsity_ignore_list = sparsity_config.ignore or list()\n \n         # Raise DeprecationError if non-empty sparse_scheme_map is detected\n-        if sparse_scheme_map:\n+        # A ``format: dense`` sparsity_config carries only vestigial sparsity\n+        # metadata (weights are stored dense) and loads fine as a normal\n+        # quantized model, so only reject actually-sparse (compressed) formats.\n+        if (\n+            sparse_scheme_map\n+            and sparsity_config.format != CompressionFormat.dense.value\n+        ):\n             raise DeprecationWarning(\n                 \"Sparsity support has been removed from compressed-tensors. \"\n                 \"Please use a model without sparsity configuration.\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ccc70f6d26a5932826fbf587e319985b3d966e6b/vllm%2Fmodel_executor%2Flayers%2Fquantization%2Fcompressed_tensors%2Fcompressed_tensors.py",
