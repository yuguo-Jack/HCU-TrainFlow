    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/16599bd6e74cf6e90549785df741f1762b078089/.buildkite%2Fscripts%2Fhardware_ci%2Frun-cpu-test-arm.sh",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Fscripts%2Fhardware_ci%2Frun-cpu-test-arm.sh?ref=16599bd6e74cf6e90549785df741f1762b078089",
      "deletions": 1,
      "filename": ".buildkite/scripts/hardware_ci/run-cpu-test-arm.sh",
      "patch": "@@ -74,7 +74,9 @@ model_tests() {\n \n   docker exec \"$CONTAINER_NAME\" bash -c \"\n     set -e\n-    pytest -x -v -s tests/quantization/test_compressed_tensors.py::test_compressed_tensors_w8a8_logprobs\"\n+    pytest -x -v -s tests/quantization/test_compressed_tensors.py::test_compressed_tensors_w8a8_logprobs\n+    pytest -x -v -s tests/quantization/test_cpu_int8_w4a8.py\n+  \"\n }\n \n serving_tests() {",
      "raw_url": "https://github.com/vllm-project/vllm/raw/16599bd6e74cf6e90549785df741f1762b078089/.buildkite%2Fscripts%2Fhardware_ci%2Frun-cpu-test-arm.sh",
      "sha": "74f722458cde98c50c900f8c717ca2edb6f631a9",
      "status": "modified"
    },
    {
      "additions": 42,
      "blob_url": "https://github.com/vllm-project/vllm/blob/16599bd6e74cf6e90549785df741f1762b078089/tests%2Fquantization%2Ftest_cpu_int8_w4a8.py",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fquantization%2Ftest_cpu_int8_w4a8.py?ref=16599bd6e74cf6e90549785df741f1762b078089",
      "deletions": 0,
      "filename": "tests/quantization/test_cpu_int8_w4a8.py",
      "patch": "@@ -0,0 +1,42 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import pytest\n+\n+from vllm.assets.audio import AudioAsset\n+from vllm.multimodal.audio import AudioResampler\n+from vllm.platforms import CpuArchEnum, current_platform\n+\n+if (\n+    not current_platform.is_cpu()\n+    or current_platform.get_cpu_architecture() != CpuArchEnum.ARM\n+):\n+    pytest.skip(\"skipping Arm CPU-only tests\", allow_module_level=True)\n+\n+MODEL = \"Arm/whisper-large-v3-quantized.w4a8\"\n+PROMPT = \"<|startoftranscript|><|en|><|transcribe|><|notimestamps|>\"\n+WHISPER_SAMPLE_RATE = 16000\n+\n+\n+def test_cpu_int8_w4a8_whisper(vllm_runner, monkeypatch) -> None:\n+    monkeypatch.setenv(\"VLLM_WORKER_MULTIPROC_METHOD\", \"spawn\")\n+    audio, sample_rate = AudioAsset(\"mary_had_lamb\").audio_and_sample_rate\n+    if sample_rate != WHISPER_SAMPLE_RATE:\n+        audio = AudioResampler(target_sr=WHISPER_SAMPLE_RATE).resample(\n+            audio, orig_sr=sample_rate\n+        )\n+\n+    with vllm_runner(\n+        MODEL,\n+        dtype=\"bfloat16\",\n+        max_model_len=448,\n+        limit_mm_per_prompt={\"audio\": 1},\n+        enforce_eager=True,\n+    ) as llm:\n+        outputs = llm.generate_greedy(\n+            [PROMPT],\n+            max_tokens=8,\n+            audios=[(audio, WHISPER_SAMPLE_RATE)],\n+        )\n+\n+    assert \"the first words\" in outputs[0][1].lower()",
      "raw_url": "https://github.com/vllm-project/vllm/raw/16599bd6e74cf6e90549785df741f1762b078089/tests%2Fquantization%2Ftest_cpu_int8_w4a8.py",
      "sha": "84b45d37bfcae212ff46fcc6eca93b8add861498",
      "status": "added"
    }
  ],
  "inline_comments": [],
  "issue_comments": [
    {
      "body": "@tlrmchlsmth - this addresses your previous request for an e2e test here: https://github.com/vllm-project/vllm/pull/33122#:~:text=in%20the%20code%3F-,In%20addition%20it%27d%20be%20great%20to%20see%20a%20small%20model%20in%20this%20format%20up%20on%20huggingface%20and%20some%20integration%20testing%20in%20place%20for%20it.%20I%27d%20be%20ok%20with%20that%20happening%20in%20a%20followup%20PR,-%F0%9F%91%8D\r\n\r\n@bigPYJ1151 - could you please have a look?",
      "created_at": "2026-11-02T16:32:06Z",
