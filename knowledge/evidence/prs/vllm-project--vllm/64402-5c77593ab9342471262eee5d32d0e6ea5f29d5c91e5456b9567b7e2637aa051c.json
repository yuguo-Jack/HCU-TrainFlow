      "additions": 22,
      "blob_url": "https://github.com/vllm-project/vllm/blob/bdc88b9f1867f97bf31a586135b8caf8c58bf8e8/tests%2Fplatforms%2Ftest_tpu.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fplatforms%2Ftest_tpu.py?ref=bdc88b9f1867f97bf31a586135b8caf8c58bf8e8",
      "deletions": 0,
      "filename": "tests/platforms/test_tpu.py",
      "patch": "@@ -0,0 +1,22 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import importlib\n+import sys\n+\n+import pytest\n+\n+\n+def test_tpu_platform_missing_tpu_inference_raises_helpful_error(monkeypatch):\n+    \"\"\"Importing the TPU platform without tpu_inference must fail fast.\n+\n+    Previously the missing import was only logged and the module was left\n+    without TpuPlatform, so platform resolution later failed with a\n+    confusing AttributeError. Now the import itself raises an ImportError\n+    pointing at the missing package.\n+    \"\"\"\n+    monkeypatch.setitem(sys.modules, \"tpu_inference\", None)\n+    monkeypatch.setitem(sys.modules, \"tpu_inference.platforms\", None)\n+    sys.modules.pop(\"vllm.platforms.tpu\", None)\n+    with pytest.raises(ImportError, match=\"tpu_inference not found\"):\n+        importlib.import_module(\"vllm.platforms.tpu\")",
      "raw_url": "https://github.com/vllm-project/vllm/raw/bdc88b9f1867f97bf31a586135b8caf8c58bf8e8/tests%2Fplatforms%2Ftest_tpu.py",
      "sha": "9e7dc0ece01cb28833f0f7a4263674768c617d92",
      "status": "added"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/bdc88b9f1867f97bf31a586135b8caf8c58bf8e8/vllm%2Fplatforms%2Ftpu.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fplatforms%2Ftpu.py?ref=bdc88b9f1867f97bf31a586135b8caf8c58bf8e8",
      "deletions": 5,
      "filename": "vllm/platforms/tpu.py",
      "patch": "@@ -13,8 +13,8 @@\n \n     TpuPlatform = TpuInferencePlatform  # type: ignore\n     USE_TPU_INFERENCE = True\n-except ImportError:\n-    logger.error(\n-        \"tpu_inference not found, please install tpu_inference to run vllm on TPU\"\n-    )\n-    pass\n+except ImportError as e:\n+    raise ImportError(\n+        \"tpu_inference not found, please install tpu_inference to run \"\n+        \"vLLM on TPU\"\n+    ) from e",
      "raw_url": "https://github.com/vllm-project/vllm/raw/bdc88b9f1867f97bf31a586135b8caf8c58bf8e8/vllm%2Fplatforms%2Ftpu.py",
