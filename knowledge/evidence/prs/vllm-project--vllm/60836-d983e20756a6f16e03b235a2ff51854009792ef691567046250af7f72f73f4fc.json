      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5009fc03f905347da35c248127eeffcfb13cd23d/.buildkite%2Frelease-pipeline.yaml",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Frelease-pipeline.yaml?ref=5009fc03f905347da35c248127eeffcfb13cd23d",
      "deletions": 21,
      "filename": ".buildkite/release-pipeline.yaml",
      "patch": "@@ -1082,37 +1082,27 @@ steps:\n           DOCKER_BUILDKIT: \"1\"\n           DOCKERHUB_USERNAME: \"vllmbot\"\n \n-  - trigger: \"perf-eval\"\n-    label: \"Trigger perf-eval (CUDA)\"\n+  - label: \"Trigger perf-eval (CUDA)\"\n     key: trigger-perf-eval-cuda\n     if: build.env(\"NIGHTLY\") == \"1\" || build.env(\"RUN_PERF_EVAL\") == \"1\"\n     depends_on:\n       - build-release-image-x86\n-    async: true\n     soft_fail: true\n-    build:\n-      branch: \"main\"\n-      message: \"(NIGHTLY=${NIGHTLY:-0}) Evaluate vLLM $BUILDKITE_COMMIT (CUDA)\"\n-      env:\n-        NIGHTLY: 1 # run all perf-eval workloads\n-        VLLM_COMMIT: \"$BUILDKITE_COMMIT\"\n-        VLLM_IMAGE_CUDA: \"public.ecr.aws/q9t5s3a7/vllm-release-repo:$BUILDKITE_COMMIT-x86_64\"\n-\n-  - trigger: \"perf-eval\"\n-    label: \"Trigger perf-eval (ROCm)\"\n+    agents:\n+      queue: small_cpu_queue_release\n+    commands:\n+      - \"bash .buildkite/scripts/trigger-perf-eval.sh cuda\"\n+\n+  - label: \"Trigger perf-eval (ROCm)\"\n     key: trigger-perf-eval-rocm\n     if: build.env(\"NIGHTLY\") == \"1\" || build.env(\"RUN_PERF_EVAL\") == \"1\"\n     depends_on:\n       - build-rocm-release-image\n-    async: true\n     soft_fail: true\n-    build:\n-      branch: \"main\"\n-      message: \"(NIGHTLY=${NIGHTLY:-0}) Evaluate vLLM $BUILDKITE_COMMIT (ROCm)\"\n-      env:\n-        NIGHTLY: 1 # run all perf-eval workloads\n-        VLLM_COMMIT: \"$BUILDKITE_COMMIT\"\n-        VLLM_IMAGE_ROCM: \"public.ecr.aws/q9t5s3a7/vllm-release-repo:$BUILDKITE_COMMIT-rocm\"\n+    agents:\n+      queue: small_cpu_queue_release\n+    commands:\n+      - \"bash .buildkite/scripts/trigger-perf-eval.sh rocm\"\n \n   # =============================================================================\n   # ROCk Release Pipeline (x86_64 only)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5009fc03f905347da35c248127eeffcfb13cd23d/.buildkite%2Frelease-pipeline.yaml",
      "sha": "57765fe1bf2e5f26162bc587bcf26bc2bd0c4c12",
      "status": "modified"
    },
    {
      "additions": 47,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5009fc03f905347da35c248127eeffcfb13cd23d/.buildkite%2Fscripts%2Ftrigger-perf-eval.sh",
      "changes": 47,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Fscripts%2Ftrigger-perf-eval.sh?ref=5009fc03f905347da35c248127eeffcfb13cd23d",
      "deletions": 0,
      "filename": ".buildkite/scripts/trigger-perf-eval.sh",
      "patch": "@@ -0,0 +1,47 @@\n+#!/bin/bash\n+# Upload a trigger step that starts a perf-eval build for this commit.\n+# Generated at runtime so the build title can carry the run date, e.g.\n+#   [Nvidia] Nightly run 2026-10-07: commit <sha>\n+#\n+# Usage: trigger-perf-eval.sh cuda|rocm\n+set -euo pipefail\n+\n+case \"${1:-}\" in\n+  cuda)\n+    vendor=\"Nvidia\"\n+    image_env=\"VLLM_IMAGE_CUDA\"\n+    image_tag=\"${BUILDKITE_COMMIT}-x86_64\"\n+    ;;\n+  rocm)\n+    vendor=\"AMD\"\n+    image_env=\"VLLM_IMAGE_ROCM\"\n+    image_tag=\"${BUILDKITE_COMMIT}-rocm\"\n+    ;;\n+  *)\n+    echo \"Usage: $0 cuda|rocm\" >&2\n+    exit 1\n+    ;;\n+esac\n+\n+if [[ \"${NIGHTLY:-0}\" == \"1\" ]]; then\n+  run_type=\"Nightly run\"\n+else\n+  run_type=\"Manual run\"\n+fi\n+\n+message=\"[${vendor}] ${run_type} $(date -u +%Y-%m-%d): commit ${BUILDKITE_COMMIT}\"\n+\n+buildkite-agent pipeline upload --no-interpolation <<EOF\n+steps:\n+  - trigger: \"perf-eval\"\n+    label: \"perf-eval (${vendor})\"\n+    async: true\n+    soft_fail: true\n+    build:\n+      branch: \"main\"\n+      message: \"${message}\"\n+      env:\n+        NIGHTLY: \"1\" # run all perf-eval workloads\n+        VLLM_COMMIT: \"${BUILDKITE_COMMIT}\"\n+        ${image_env}: \"public.ecr.aws/q9t5s3a7/vllm-release-repo:${image_tag}\"\n+EOF",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5009fc03f905347da35c248127eeffcfb13cd23d/.buildkite%2Fscripts%2Ftrigger-perf-eval.sh",
      "sha": "92058f48d7ccda649a4d9f07be8688944a6db1ca",
      "status": "added"
    }
