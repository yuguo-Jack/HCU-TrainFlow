      "additions": 20,
      "blob_url": "https://github.com/vllm-project/vllm/blob/633a5d62ff81e123a41f9e0032d800f36254ffc9/tests%2Fmodels%2Ftest_jamba_lora.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Ftest_jamba_lora.py?ref=633a5d62ff81e123a41f9e0032d800f36254ffc9",
      "deletions": 0,
      "filename": "tests/models/test_jamba_lora.py",
      "patch": "@@ -0,0 +1,20 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"Tests for LoRA rejection in Jamba model.\"\"\"\n+\n+from unittest.mock import MagicMock\n+\n+import pytest\n+\n+from vllm.model_executor.models.jamba import JambaModel\n+\n+pytestmark = pytest.mark.cpu_test\n+\n+\n+def test_jamba_raises_value_error_when_lora_enabled():\n+    vllm_config = MagicMock()\n+    vllm_config.lora_config = MagicMock()\n+    with pytest.raises(\n+        ValueError, match=\"enable_lora=True is not supported for Jamba\"\n+    ):\n+        JambaModel(vllm_config=vllm_config)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/633a5d62ff81e123a41f9e0032d800f36254ffc9/tests%2Fmodels%2Ftest_jamba_lora.py",
      "sha": "b583f70818d5bd19e21e67d9d159ddf7ef000b45",
      "status": "added"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/633a5d62ff81e123a41f9e0032d800f36254ffc9/vllm%2Fmodel_executor%2Fmodels%2Fjamba.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fjamba.py?ref=633a5d62ff81e123a41f9e0032d800f36254ffc9",
      "deletions": 1,
      "filename": "vllm/model_executor/models/jamba.py",
      "patch": "@@ -301,6 +301,9 @@ class JambaModel(nn.Module):\n     def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\"):\n         super().__init__()\n \n+        if vllm_config.lora_config:\n+            raise ValueError(\"enable_lora=True is not supported for Jamba.\")\n+\n         config = vllm_config.model_config.hf_config\n         model_config = vllm_config.model_config\n         cache_config = vllm_config.cache_config\n@@ -315,7 +318,7 @@ def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\"):\n             config.hidden_size,\n         )\n \n-        extra_kwargs = {\"is_lora_enabled\": bool(vllm_config.lora_config)}\n+        extra_kwargs = {\"is_lora_enabled\": False}\n \n         def get_layer(prefix: str):\n             layer_idx = int(prefix.rsplit(\".\", 1)[1])",
      "raw_url": "https://github.com/vllm-project/vllm/raw/633a5d62ff81e123a41f9e0032d800f36254ffc9/vllm%2Fmodel_executor%2Fmodels%2Fjamba.py",
      "sha": "0bed43b0c021eb53a69ee53ebe63f0c580e1ab8f",
      "status": "modified"
    }
