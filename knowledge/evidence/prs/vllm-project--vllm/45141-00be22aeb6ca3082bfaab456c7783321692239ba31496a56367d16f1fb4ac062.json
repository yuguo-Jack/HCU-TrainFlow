      "additions": 9,
      "blob_url": "https://github.com/vllm-project/vllm/blob/dbdfe33f088a11e1734c26cdfa5d937daa8207da/docker%2FDockerfile",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile?ref=dbdfe33f088a11e1734c26cdfa5d937daa8207da",
      "deletions": 2,
      "filename": "docker/Dockerfile",
      "patch": "@@ -958,6 +958,8 @@ ARG torch_cuda_arch_list='7.5 8.0 8.6 8.9 9.0 10.0 11.0 12.0+PTX'\n ENV TORCH_CUDA_ARCH_LIST=${torch_cuda_arch_list}\n RUN --mount=type=cache,target=/opt/uv/cache \\\n     --mount=type=bind,source=requirements/kv_connectors.txt,target=/tmp/kv_connectors.txt,ro \\\n+    --mount=type=bind,source=requirements/kv_connectors_cu12.txt,target=/tmp/kv_connectors_cu12.txt,ro \\\n+    --mount=type=bind,source=requirements/kv_connectors_cu13.txt,target=/tmp/kv_connectors_cu13.txt,ro \\\n     CUDA_MAJOR=\"${CUDA_VERSION%%.*}\"; \\\n     CUDA_VERSION_DASH=$(echo $CUDA_VERSION | cut -d. -f1,2 | tr '.' '-'); \\\n     CUDA_HOME=/usr/local/cuda; \\\n@@ -966,11 +968,16 @@ RUN --mount=type=cache,target=/opt/uv/cache \\\n                 libcublas-dev-${CUDA_VERSION_DASH} \\\n                 libcusolver-dev-${CUDA_VERSION_DASH}\"; \\\n     if [ \"$INSTALL_KV_CONNECTORS\" = \"true\" ]; then \\\n-        uv pip install --system -r /tmp/kv_connectors.txt --no-build || ( \\\n+        KV_CONNECTORS_FILE=\"/tmp/kv_connectors_cu${CUDA_MAJOR}.txt\"; \\\n+        if [ ! -f \"$KV_CONNECTORS_FILE\" ]; then \\\n+            echo \"Warning: No kv_connectors file for CUDA ${CUDA_MAJOR}, falling back to CUDA 12\"; \\\n+            KV_CONNECTORS_FILE=\"/tmp/kv_connectors_cu12.txt\"; \\\n+        fi; \\\n+        uv pip install --system -r \"$KV_CONNECTORS_FILE\" --no-build || ( \\\n             # if the above fails, install from source\n             apt-get update -y && \\\n             apt-get install -y --no-install-recommends --allow-change-held-packages ${BUILD_PKGS} && \\\n-            uv pip install --system -r /tmp/kv_connectors.txt --no-build-isolation && \\\n+            uv pip install --system -r \"$KV_CONNECTORS_FILE\" --no-build-isolation && \\\n             apt-get purge -y ${BUILD_PKGS} && \\\n             # clean up -dev packages, keep runtime libraries\n             rm -rf /var/lib/apt/lists/* \\",
      "raw_url": "https://github.com/vllm-project/vllm/raw/dbdfe33f088a11e1734c26cdfa5d937daa8207da/docker%2FDockerfile",
      "sha": "a030fdc44ae06b09c11e3f09df4cbd57a5f60a67",
      "status": "modified"
    },
    {
      "additions": 0,
