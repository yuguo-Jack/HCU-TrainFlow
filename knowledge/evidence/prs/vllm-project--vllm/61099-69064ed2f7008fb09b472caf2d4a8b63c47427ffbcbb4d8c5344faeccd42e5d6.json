    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c51f32bbab2748a46fbd199df83a7e553c50a85c/csrc%2Fquickreduce%2Fquick_reduce_impl.cuh",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/csrc%2Fquickreduce%2Fquick_reduce_impl.cuh?ref=c51f32bbab2748a46fbd199df83a7e553c50a85c",
      "deletions": 2,
      "filename": "csrc/quickreduce/quick_reduce_impl.cuh",
      "patch": "@@ -749,7 +749,7 @@ struct AllReduceTwoshot {\n     // rank responsible for this segment.\n     uint32_t comm_data0_offset =\n         data_offset + block_id * Codec::kTransmittedTileSize;\n-    uint32_t comm_data1_offset = data_size_per_phase + comm_data0_offset;\n+    int64_t comm_data1_offset = data_size_per_phase + comm_data0_offset;\n \n     uint32_t comm_flags0_offset = block_id * (kWorldSize * sizeof(uint32_t));\n     uint32_t comm_flags1_offset = (data_offset / 2) + comm_flags0_offset;\n@@ -854,4 +854,4 @@ struct AllReduceTwoshot {\n   }\n };\n \n-}  // namespace quickreduce\n\\ No newline at end of file\n+}  // namespace quickreduce",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c51f32bbab2748a46fbd199df83a7e553c50a85c/csrc%2Fquickreduce%2Fquick_reduce_impl.cuh",
      "sha": "eb883574d788afdc419798c47f7aa7819bc30177",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c51f32bbab2748a46fbd199df83a7e553c50a85c/tests%2Fdistributed%2Ftest_rocm_quick_reduce.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fdistributed%2Ftest_rocm_quick_reduce.py?ref=c51f32bbab2748a46fbd199df83a7e553c50a85c",
      "deletions": 4,
      "filename": "tests/distributed/test_rocm_quick_reduce.py",
      "patch": "@@ -73,9 +73,12 @@ def _quick_allreduce_worker(\n     quant_level: str,\n     dtype_name: str,\n     cast_bf16: bool,\n+    max_size_mb: int | None = None,\n ):\n     os.environ[\"VLLM_ROCM_QUICK_REDUCE_QUANTIZATION\"] = quant_level\n     os.environ[\"VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16\"] = \"1\" if cast_bf16 else \"0\"\n+    if max_size_mb is not None:\n+        os.environ[\"VLLM_ROCM_QUICK_REDUCE_MAX_SIZE_BYTES_MB\"] = str(max_size_mb)\n     _log(\n         f\"worker start: rank={rank} quant={quant_level} \"\n         f\"dtype={dtype_name} cast_bf16={cast_bf16}\"\n@@ -102,14 +105,23 @@ def _quick_allreduce_worker(\n         num_elements = 8 * MB if dtype_name == \"float16\" else 4 * MB\n \n         dtype = getattr(torch, dtype_name)\n-        inp = torch.ones(num_elements, dtype=dtype, device=device)\n+        inp = torch.full((num_elements,), rank + 1, dtype=dtype, device=device)\n \n         assert qar.should_quick_allreduce(inp)\n         if cast_bf16:\n             assert qar.use_fp16_kernels\n \n-        out = qar.quick_all_reduce(inp)\n-        assert torch.allclose(out, inp * WORLD_SIZE, atol=2.5, rtol=0.1)\n+        expected = WORLD_SIZE * (WORLD_SIZE + 1) / 2\n+        for _ in range(20 if max_size_mb is not None else 1):\n+            out = qar.quick_all_reduce(inp)\n+            if max_size_mb is not None:\n+                torch.testing.assert_close(\n+                    out, torch.full_like(inp, expected), atol=0, rtol=0\n+                )\n+            else:\n+                assert torch.allclose(\n+                    out, torch.full_like(inp, expected), atol=2.5, rtol=0.1\n+                )\n         _log(\n             f\"worker complete: rank={rank} quant={quant_level} \"\n             f\"dtype={dtype_name} num_elements={num_elements} \"\n@@ -127,6 +139,7 @@ def _run_two_gpu_quick_allreduce_test(\n     quant_level: str,\n     dtype_name: str,\n     cast_bf16: bool,\n+    max_size_mb: int | None = None,\n ):\n     _log(\n         f\"launch 2-GPU case: quant={quant_level} \"\n@@ -139,7 +152,7 @@ def _run_two_gpu_quick_allreduce_test(\n     for rank in range(WORLD_SIZE):\n         proc = ctx.Process(\n             target=_quick_allreduce_worker,\n-            args=(rank, port, quant_level, dtype_name, cast_bf16),\n+            args=(rank, port, quant_level, dtype_name, cast_bf16, max_size_mb),\n         )\n         proc.start()\n         procs.append(proc)\n@@ -153,6 +166,14 @@ def _run_two_gpu_quick_allreduce_test(\n     )\n \n \n+@multi_gpu_test(num_gpus=2)\n+def test_quick_allreduce_four_gib_phase_stride():\n+    \"\"\"Small reductions must remain correct with a 4 GiB phase capacity.\"\"\"\n+    _run_two_gpu_quick_allreduce_test(\n+        quant_level=\"FP\", dtype_name=\"float16\", cast_bf16=False, max_size_mb=4096\n+    )\n+\n+\n CUDAGRAPH_WORLD_SIZE = 2\n CUDAGRAPH_ROUNDS = 10\n CUDAGRAPH_NUM_ELEMENTS = 1 << 21  # 2M fp16 = 4 MB, above the quick-reduce thresholds",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c51f32bbab2748a46fbd199df83a7e553c50a85c/tests%2Fdistributed%2Ftest_rocm_quick_reduce.py",
      "sha": "572804277b98900585976c0aeb6a7317b37fd5da",
      "status": "modified"
    }
