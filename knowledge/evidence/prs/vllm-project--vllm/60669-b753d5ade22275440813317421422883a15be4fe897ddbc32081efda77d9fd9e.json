      "blob_url": "https://github.com/vllm-project/vllm/blob/ed47cb8e451bd46fc21e0ef0eb123c65e80cbbc6/tests%2Freasoning%2Ftest_olmo3_reasoning_parser.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Freasoning%2Ftest_olmo3_reasoning_parser.py?ref=ed47cb8e451bd46fc21e0ef0eb123c65e80cbbc6",
      "deletions": 0,
      "filename": "tests/reasoning/test_olmo3_reasoning_parser.py",
      "patch": "@@ -161,3 +161,20 @@ def test_reasoning(\n \n     assert reasoning == param_dict[\"reasoning\"]\n     assert content == param_dict[\"content\"]\n+\n+\n+@pytest.mark.parametrize(\n+    (\"text\", \"expected\"),\n+    [\n+        (\"user asks about </think> tags\\nassistant\\n<think>\", False),\n+        (\"user asks about </think> tags\\nassistant <think>\", False),\n+        (\"assistant\\n<think>reasoning</think>\", True),\n+        (\"assistant\\n<think>\", False),\n+        (\"no markers at all\", False),\n+    ],\n+)\n+def test_is_reasoning_end_uses_latest_marker(text: str, expected: bool):\n+    parser_cls = ReasoningParserManager.get_reasoning_parser(parser_name)\n+    parser: ReasoningParser = parser_cls(tokenizer)\n+    input_ids = tokenizer.encode(text, add_special_tokens=False)\n+    assert parser.is_reasoning_end(input_ids) is expected",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ed47cb8e451bd46fc21e0ef0eb123c65e80cbbc6/tests%2Freasoning%2Ftest_olmo3_reasoning_parser.py",
      "sha": "e543ef7489529930482205532a319631b9073b4a",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ed47cb8e451bd46fc21e0ef0eb123c65e80cbbc6/vllm%2Freasoning%2Folmo3_reasoning_parser.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Freasoning%2Folmo3_reasoning_parser.py?ref=ed47cb8e451bd46fc21e0ef0eb123c65e80cbbc6",
      "deletions": 1,
      "filename": "vllm/reasoning/olmo3_reasoning_parser.py",
      "patch": "@@ -219,6 +219,11 @@ class Olmo3ReasoningParser(ReasoningParser):\n     # with an optional leading space, so there are 2 possible tokenizations\n     think_end_first_split: list[str] = [r\"Ġ</\", r\"</\"]\n     think_end_rest_split: list[str] = [r\"think\", r\">\"]\n+    # <think> splits differently depending on what precedes it\n+    think_start_splits: list[list[str]] = [\n+        [r\"<th\", r\"ink\", r\">\"],\n+        [r\"Ġ<\", r\"think\", r\">\"],\n+    ]\n     # notice that the first think is optional; this allows template to\n     # work in cases when we hardcode a <think> at the beginning of the\n     # reasoning template.\n@@ -239,6 +244,9 @@ def __init__(self, tokenizer: \"TokenizerLike\", *args, **kwargs):\n         self.think_end_rest_token_ids: list[int] = [\n             self.vocab[token] for token in self.think_end_rest_split\n         ]\n+        self.think_start_token_ids: list[list[int]] = [\n+            [self.vocab[token] for token in split] for split in self.think_start_splits\n+        ]\n \n     @property\n     def reasoning_start_str(self) -> str:\n@@ -249,9 +257,17 @@ def reasoning_end_str(self) -> str:\n         return self.think_end\n \n     def is_reasoning_end(self, input_ids: Sequence[int]) -> bool:\n+        # Only the latest marker counts: a prompt can contain an earlier\n+        # </think> (in a user message or a prior turn) before the generation\n+        # prompt opens a new <think>.\n         rest_ids = self.think_end_rest_token_ids\n         rest_len = len(rest_ids)\n-        for i in range(len(input_ids) - rest_len, -1, -1):\n+        for i in range(len(input_ids) - 1, -1, -1):\n+            if any(\n+                list(input_ids[i : i + len(start_ids)]) == start_ids\n+                for start_ids in self.think_start_token_ids\n+            ):\n+                return False\n             if (\n                 list(input_ids[i + 1 : i + 1 + rest_len]) == rest_ids\n                 and input_ids[i] in self.think_end_first_token_ids",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ed47cb8e451bd46fc21e0ef0eb123c65e80cbbc6/vllm%2Freasoning%2Folmo3_reasoning_parser.py",
      "sha": "3f6eb54a961c6091120403028193710698b29388",
      "status": "modified"
    }
