      "blob_url": "https://github.com/vllm-project/vllm/blob/331ecb725a8640de50c88d9cdc36be072c1a63d5/vllm%2Fmodels%2Fmuse_spark%2Famd%2Fmodel.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Fmuse_spark%2Famd%2Fmodel.py?ref=331ecb725a8640de50c88d9cdc36be072c1a63d5",
      "deletions": 0,
      "filename": "vllm/models/muse_spark/amd/model.py",
      "patch": "@@ -1210,6 +1210,14 @@ def process_weights_after_loading(self) -> None:\n             \"Materialized residual-path constants for %d gated residual connections\",\n             n_gates,\n         )\n+        # Shared RoPE (get_rope) may leave cos_sin_cache on CPU.\n+        device = next(self.parameters()).device\n+        for layer in self.model.layers:\n+            rope = getattr(layer.self_attn, \"rotary_emb\", None)\n+            if rope is not None and hasattr(rope, \"cos_sin_cache\"):\n+                cache = rope.cos_sin_cache\n+                if not cache.is_cuda or not cache.is_contiguous():\n+                    rope.cos_sin_cache = cache.to(device).contiguous()\n         # The experts are in their kernel layout only after the per-layer\n         # quant finalize, which runs between load_weights and this hook. The\n         # monokernel also needs the cached coefficients and the folded router",
      "raw_url": "https://github.com/vllm-project/vllm/raw/331ecb725a8640de50c88d9cdc36be072c1a63d5/vllm%2Fmodels%2Fmuse_spark%2Famd%2Fmodel.py",
      "sha": "8e7c23f6557e62589dc541234683d65233c11711",
      "status": "modified"
    }
