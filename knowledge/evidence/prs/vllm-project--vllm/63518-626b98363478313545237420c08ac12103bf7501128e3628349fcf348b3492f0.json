  "files": [
    {
      "additions": 38,
      "blob_url": "https://github.com/vllm-project/vllm/blob/899ec70169e04fa5af46853e1783ef219b672dcb/tests%2Fv1%2Fattention%2Ftest_attention_backends.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fattention%2Ftest_attention_backends.py?ref=899ec70169e04fa5af46853e1783ef219b672dcb",
      "deletions": 0,
      "filename": "tests/v1/attention/test_attention_backends.py",
      "patch": "@@ -1975,6 +1975,44 @@ def sliding_window_mask_mod(\n     )\n \n \n+@pytest.mark.skipif(not current_platform.is_rocm(), reason=\"ROCm-specific test\")\n+@pytest.mark.parametrize(\n+    \"batch_spec\",\n+    [\n+        BatchSpec(seq_lens=[24, 40], query_lens=[24, 40]),\n+        BatchSpec(seq_lens=[32, 40, 48, 56], query_lens=[1, 1, 5, 56]),\n+    ],\n+    ids=[\"prefill\", \"mixed\"],\n+)\n+# Head size 128 hits AITER's fmha_v3 ASM dispatch, which ignores `sink_ptr`;\n+# head size 64 stays on the CK kernels, where extends merge partial attentions.\n+@pytest.mark.parametrize(\"model\", [\"Qwen/Qwen3-0.6B\", \"HuggingFaceTB/SmolLM2-135M\"])\n+def test_rocm_aiter_fa_sinks(default_vllm_config, batch_spec: BatchSpec, model: str):\n+    \"\"\"Sinks must be applied exactly once on every ROCM_AITER_FA path.\"\"\"\n+    from vllm._aiter_ops import is_aiter_found_and_supported\n+\n+    if not is_aiter_found_and_supported():\n+        pytest.skip(\"AITER is required\")\n+\n+    def causal_mask_mod(\n+        b: torch.Tensor,\n+        h: torch.Tensor,\n+        q_idx: torch.Tensor,\n+        kv_idx: torch.Tensor,\n+        *,\n+        context_len: int,\n+    ):\n+        return (q_idx + context_len) >= kv_idx\n+\n+    _test_backend_correctness(\n+        batch_spec,\n+        model,\n+        [AttentionBackendEnum.ROCM_AITER_FA],\n+        causal_mask_mod,\n+        use_sinks=True,\n+    )\n+\n+\n @pytest.mark.parametrize(\n     \"batch_spec_name\",\n     [",
      "raw_url": "https://github.com/vllm-project/vllm/raw/899ec70169e04fa5af46853e1783ef219b672dcb/tests%2Fv1%2Fattention%2Ftest_attention_backends.py",
      "sha": "04d86d32dc692bce102372e9c7d3b842bc58fc1c",
      "status": "modified"
    },
    {
      "additions": 115,
      "blob_url": "https://github.com/vllm-project/vllm/blob/899ec70169e04fa5af46853e1783ef219b672dcb/vllm%2Fv1%2Fattention%2Fbackends%2Frocm_aiter_fa.py",
      "changes": 116,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Frocm_aiter_fa.py?ref=899ec70169e04fa5af46853e1783ef219b672dcb",
      "deletions": 1,
      "filename": "vllm/v1/attention/backends/rocm_aiter_fa.py",
      "patch": "@@ -1030,6 +1030,16 @@ def __init__(\n         self.logits_soft_cap = logits_soft_cap\n         self.kv_sharing_target_layer_name = kv_sharing_target_layer_name\n         self.sinks = sinks\n+        from vllm.platforms.rocm import on_gfx942, on_gfx950\n+\n+        # Shape-level part of AITER's fmha_v3 varlen ASM eligibility; see\n+        # _aiter_varlen_drops_sinks for the per-batch part.\n+        self._sinks_may_hit_aiter_asm = (\n+            sinks is not None\n+            and (on_gfx942() or on_gfx950())\n+            and head_size == 128\n+            and alibi_slopes is None\n+        )\n \n         assert self.num_heads % self.num_kv_heads == 0\n         self.num_queries_per_kv = self.num_heads // self.num_kv_heads\n@@ -1057,6 +1067,90 @@ def _get_kv_cache_descales(\n             layer._v_scale.expand(descale_shape),\n         )\n \n+    def _aiter_varlen_drops_sinks(\n+        self, attn_metadata: AiterFlashAttentionMetadata, query: torch.Tensor\n+    ) -> bool:\n+        \"\"\"Whether a flash_attn_varlen_func call with sinks in this batch would be\n+        dispatched to AITER's fmha_v3 ASM kernels, which take no sink argument.\n+\n+        AITER picks them for bf16, head size 128, no ALiBi, on gfx942/gfx950,\n+        when the sliding window is inactive. It treats a window that covers the\n+        whole key range (window >= max_seqlen_k) as no window.\n+        \"\"\"\n+        if not self._sinks_may_hit_aiter_asm or query.dtype != torch.bfloat16:\n+            return False\n+        window_left = self.sliding_window[0]\n+\n+        def window_inactive(max_seqlen_k: int) -> bool:\n+            return window_left == -1 or window_left >= max_seqlen_k\n+\n+        if attn_metadata.num_prefills > 0:\n+            assert attn_metadata.prefill_metadata is not None\n+            if window_inactive(attn_metadata.prefill_metadata.max_seq_len):\n+                return True\n+        if attn_metadata.num_extends > 0:\n+            if window_left == -1:\n+                # The new-token attention in extend_forward has no window.\n+                return True\n+            assert attn_metadata.extend_metadata is not None\n+            swa = attn_metadata.extend_metadata.chunk_context_metadata.swa_metadata\n+            assert swa is not None\n+            if window_inactive(swa.swa_max_seqlens):\n+                return True\n+        return False\n+\n+    def _forward_unified_with_sinks(\n+        self,\n+        layer: AttentionLayer,\n+        query: torch.Tensor,\n+        key_cache: torch.Tensor,\n+        value_cache: torch.Tensor,\n+        output: torch.Tensor,\n+        attn_metadata: AiterFlashAttentionMetadata,\n+    ) -> None:\n+        \"\"\"Attention over the paged KV cache for all requests in the batch.\"\"\"\n+        assert not rocm_aiter_ops.is_shuffle_kv_cache_enabled(), (\n+            \"Shuffle KV cache layout is not supported with attention sinks.\"\n+        )\n+        from aiter.ops.triton.unified_attention import unified_attention\n+\n+        num_reqs = (\n+            attn_metadata.num_decodes\n+            + attn_metadata.num_extends\n+            + attn_metadata.num_prefills\n+        )\n+        max_query_len = max(\n+            md.max_query_len\n+            for md in (\n+                attn_metadata.decode_metadata,\n+                attn_metadata.extend_metadata,\n+                attn_metadata.prefill_metadata,\n+            )\n+            if md is not None\n+        )\n+        num_actual_tokens = attn_metadata.num_actual_tokens\n+        k_descale, v_descale = self._get_kv_cache_descales(layer, num_reqs)\n+        unified_attention(\n+            q=query,\n+            k=key_cache,\n+            v=value_cache,\n+            out=output[:num_actual_tokens],\n+            cu_seqlens_q=attn_metadata.query_start_loc[: num_reqs + 1],\n+            max_seqlen_q=max_query_len,\n+            seqused_k=attn_metadata.seq_lens[:num_reqs],\n+            max_seqlen_k=attn_metadata.max_seq_len,\n+            softmax_scale=self.scale,\n+            causal=True,\n+            alibi_slopes=self.alibi_slopes,\n+            window_size=self.sliding_window,\n+            block_table=attn_metadata.block_table[:num_reqs],\n+            softcap=self.logits_soft_cap,\n+            q_descale=None,\n+            k_descale=k_descale,\n+            v_descale=v_descale,\n+            sinks=self.sinks,\n+        )\n+\n     def extend_for_sliding_window(\n         self,\n         attn_metadata: AiterFlashAttentionMetadata,\n@@ -1214,7 +1308,10 @@ def extend_forward(\n                 window_size=self.sliding_window,\n                 alibi_slopes=self.alibi_slopes,\n                 return_lse=True,\n-                sink_ptr=self.sinks,\n+                # The sink belongs in the softmax denominator once. The\n+                # new-token attention above already includes it in its LSE,\n+                # and merge_attn_states sums the denominators of all partials.\n+                sink_ptr=None,\n             )\n             if chunked_output is None:\n                 chunked_output = suf_out\n@@ -1317,6 +1414,23 @@ def forward(\n \n         num_decode_tokens = attn_metadata.num_decode_tokens\n         num_extend_tokens = attn_metadata.num_extend_tokens\n+\n+        if (\n+            self.sinks is not None\n+            and attn_metadata.causal\n+            and self._aiter_varlen_drops_sinks(attn_metadata, query)\n+        ):\n+            # AITER's flash_attn_varlen_func silently drops sink_ptr when it\n+            # dispatches to the gfx942/gfx950 fmha_v3 ASM kernels, so run the\n+            # batch through unified_attention, which applies sinks.\n+            # TODO: remove this fallback and _aiter_varlen_drops_sinks once\n+            # https://github.com/ROCm/aiter/pull/6906 (route sinks away from\n+            # the ASM kernels) is merged and required by vLLM.\n+            self._forward_unified_with_sinks(\n+                layer, query, key_cache, value_cache, output, attn_metadata\n+            )\n+            return output\n+\n         if (self.kv_sharing_target_layer_name is not None or key is None) and (\n             num_prefills > 0 or num_extends > 0\n         ):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/899ec70169e04fa5af46853e1783ef219b672dcb/vllm%2Fv1%2Fattention%2Fbackends%2Frocm_aiter_fa.py",
      "sha": "0d92a79e07efc3a66e0df1d993b20f9afde8e89f",
      "status": "modified"
