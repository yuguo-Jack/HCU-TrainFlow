  "files": [
    {
      "additions": 18,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9c03229825269c42710b7c295eec03ff6c41a7b2/.buildkite%2Ftest_areas%2Fpytorch.yaml",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Ftest_areas%2Fpytorch.yaml?ref=9c03229825269c42710b7c295eec03ff6c41a7b2",
      "deletions": 8,
      "filename": ".buildkite/test_areas/pytorch.yaml",
      "patch": "@@ -5,6 +5,7 @@ steps:\n - label: \":nvidia: (H200 MIG 35GB) PyTorch Compilation\"\n   device: h200_35gb\n   key: pytorch-compilation-unit-tests\n+  automatic_shard: true\n   timeout_in_minutes: 30\n   source_file_dependencies: &pytorch-compilation-deps\n     - vllm/__init__.py\n@@ -34,16 +35,25 @@ steps:\n     - vllm/v1/\n     - tests/compile\n   commands:\n-  # Run unit tests defined directly under compile/,\n-  # not including subdirectories, which are usually heavier\n-  # tests covered elsewhere.\n-  # Use `find` to launch multiple instances of pytest so that\n-  # they do not suffer from https://github.com/vllm-project/vllm/issues/28965\n-  # However, find does not normally propagate error codes, so we combine it with xargs\n-  # (using -0 for proper path handling)\n-  - \"find compile/ -maxdepth 1 -name 'test_*.py' -print0 | xargs -0 -n1 -I{} pytest -s -v '{}'\"\n+  # One pytest per root-level file: several tests use @pytest.mark.forked,\n+  # which fails once an earlier file has initialized CUDA in the same process.\n+  # Add new root-level test files here; subdirectories run in their own steps.\n+  - pytest -s -v compile/test_aot_compile.py\n+  - pytest -s -v compile/test_codegen.py\n+  - pytest -s -v compile/test_compile_ranges.py\n+  - pytest -s -v compile/test_compiler_interface.py\n+  - pytest -s -v compile/test_config.py\n+  - pytest -s -v compile/test_decorator.py\n+  - pytest -s -v compile/test_deepstack_input_contract.py\n+  - pytest -s -v compile/test_depyf_compat.py\n+  - pytest -s -v compile/test_graph_partition.py\n+  - pytest -s -v compile/test_inductor_operator_str_patch.py\n+  - pytest -s -v compile/test_rotary_embedding_compile.py\n+  - pytest -s -v compile/test_structured_logging.py\n+  - pytest -s -v compile/test_wrapper.py\n   mirror:\n     amd:\n+      automatic_shard: true\n       label: \":amd: (MI300) PyTorch Compilation\"\n       dind: false\n       device: mi300_1",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9c03229825269c42710b7c295eec03ff6c41a7b2/.buildkite%2Ftest_areas%2Fpytorch.yaml",
      "sha": "37d341e2bccaf0a07782335b986209b6451e7580",
      "status": "modified"
    }
