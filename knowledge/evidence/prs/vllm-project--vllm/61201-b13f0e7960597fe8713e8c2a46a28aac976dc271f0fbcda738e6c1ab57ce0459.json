      "filename": ".buildkite/test_areas/pytorch.yaml",
      "patch": "@@ -175,6 +175,7 @@ steps:\n - label: \":nvidia: (H200 MIG 35GB) PyTorch Fullgraph\"\n   device: h200_35gb\n   key: pytorch-fullgraph-test\n+  automatic_shard: true\n   timeout_in_minutes: 90\n   source_file_dependencies:\n   - vllm/__init__.py\n@@ -205,17 +206,20 @@ steps:\n   - tests/compile\n   - csrc/\n   commands:\n-  # Run smoke tests under fullgraph directory, except test_full_cudagraph.py\n-  # as it is a heavy test that is covered in other steps.\n-  # Use `find` to launch multiple instances of pytest so that\n-  # they do not suffer from https://github.com/vllm-project/vllm/issues/28965\n-  - \"find compile/fullgraph/ -name 'test_*.py' -not -name 'test_full_cudagraph.py' -print0 | xargs -0 -n1 -I{} pytest -s -v '{}'\"\n+  # Smoke tests under the fullgraph directory, except test_full_cudagraph.py,\n+  # a heavy test covered in other steps. One plain pytest command, so the\n+  # step can be sharded automatically.\n+  - pytest -s -v compile/fullgraph --ignore=compile/fullgraph/test_full_cudagraph.py\n   mirror:\n     amd:\n       label: \":amd: (MI355 DPX) PyTorch Fullgraph\"\n       dind: false\n       device: mi355_dpx\n       timeout_in_minutes: 90\n+      # A pytest per file, as before the NVIDIA step sharded automatically\n+      # (https://github.com/vllm-project/vllm/issues/28965).\n+      commands:\n+      - \"find compile/fullgraph/ -name 'test_*.py' -not -name 'test_full_cudagraph.py' -print0 | xargs -0 -n1 -I{} pytest -s -v '{}'\"\n       # Remove once the ROCm Triton pin includes triton-lang/triton#11567.\n       # Avoid overlapping LLVM codegen/LLD by disabling background precompilation.\n       env:",
