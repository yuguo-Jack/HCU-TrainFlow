      "deletions": 0,
      "filename": "vllm/v1/worker/gpu/dp_utils.py",
      "patch": "@@ -39,6 +39,8 @@ class DPSyncState:\n     # Agreed upper bound on any rank's request count. Holds the padded count when\n     # a FULL descriptor imposed one, else the most any rank scheduled.\n     num_reqs: int\n+    # DP-wide request maximum before target CUDA graph padding.\n+    max_num_reqs: int\n \n \n def sync_cudagraph_and_dp_padding(\n@@ -82,6 +84,7 @@ def sync_cudagraph_and_dp_padding(\n     max_query_lens_across_dp = tensor[3]\n     allow_ubatching_across_dp = tensor[4]\n     num_reqs_across_dp = tensor[5]\n+    max_num_reqs = int(num_reqs_across_dp.max())\n \n     # If ranks disagree on the uniform token count, or its 0 (means None) set to None\n     synced_uniform_token_count: int | None = int(uniform_token_counts_across_dp[0])\n@@ -150,6 +153,7 @@ def sync_cudagraph_and_dp_padding(\n                 uniform_token_count=synced_uniform_token_count,\n                 eager=ubatch_desc.cg_mode == CUDAGraphMode.NONE,\n                 num_reqs=num_reqs,\n+                max_num_reqs=max_num_reqs,\n             )\n \n     synced_cg_mode = CUDAGraphMode(int(cg_mode_across_dp.min()))\n@@ -168,6 +172,7 @@ def sync_cudagraph_and_dp_padding(\n                 uniform_token_count=synced_uniform_token_count,\n                 eager=True,\n                 num_reqs=int(num_reqs_across_dp.max()),\n+                max_num_reqs=max_num_reqs,\n             ),\n         )\n \n@@ -207,6 +212,7 @@ def sync_cudagraph_and_dp_padding(\n             and synced_desc.num_reqs is not None\n             else int(num_reqs_across_dp.max())\n         ),\n+        max_num_reqs=max_num_reqs,\n     )\n \n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4afa1bfcec2624ac8693f97a93fd440c5f7cd417/vllm%2Fv1%2Fworker%2Fgpu%2Fdp_utils.py",
      "sha": "453ab46ad08195eeae6b0b90c600293eaaa3ee37",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4afa1bfcec2624ac8693f97a93fd440c5f7cd417/vllm%2Fv1%2Fworker%2Fgpu%2Fspec_decode%2Fdflash%2Fspeculator.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu%2Fspec_decode%2Fdflash%2Fspeculator.py?ref=4afa1bfcec2624ac8693f97a93fd440c5f7cd417",
      "deletions": 2,
      "filename": "vllm/v1/worker/gpu/spec_decode/dflash/speculator.py",
      "patch": "@@ -369,6 +369,9 @@ def propose(\n         num_speculative_tokens: int | None = None,\n     ) -> torch.Tensor:\n         num_reqs = input_batch.num_reqs\n+        if dummy_run and dp_sync_state is not None:\n+            # The target dummy batch may already carry its graph request capacity.\n+            num_reqs = min(num_reqs, dp_sync_state.max_num_reqs)\n         num_target_tokens = input_batch.num_tokens\n         num_query_tokens = num_reqs * self.num_query_per_req\n         max_seq_len = input_batch.seq_lens_cpu_upper_bound[:num_reqs].max().item()\n@@ -449,11 +452,15 @@ def propose(\n                 self.max_num_tokens,\n                 self.max_model_len,\n                 self.sample_from_anchor,\n+                num_reqs=num_reqs,\n             )\n \n         batch_sync, num_batch_tokens = (\n             self._build_uniform_batch_dp_sync(\n-                dp_sync_state, num_reqs, self.num_query_per_req\n+                dp_sync_state,\n+                num_reqs,\n+                self.num_query_per_req,\n+                max_num_reqs=dp_sync_state.max_num_reqs,\n             )\n             if dp_sync_state is not None\n             else (None, num_query_tokens)\n@@ -766,8 +773,9 @@ def prepare_dflash_inputs(\n     max_num_tokens: int,\n     max_model_len: int,\n     sample_from_anchor: bool = False,\n+    *,\n+    num_reqs: int,\n ) -> None:\n-    num_reqs = input_batch.num_reqs\n     assert num_reqs > 0\n     # Cover the longest possible per-request span (ctx + query). Use the max\n     # per-request query length, not the total token count across the batch.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4afa1bfcec2624ac8693f97a93fd440c5f7cd417/vllm%2Fv1%2Fworker%2Fgpu%2Fspec_decode%2Fdflash%2Fspeculator.py",
      "sha": "4e829b2e31772b694c9c01ef8796df659dc60509",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4afa1bfcec2624ac8693f97a93fd440c5f7cd417/vllm%2Fv1%2Fworker%2Fgpu%2Fspec_decode%2Fspeculator.py",
      "changes": 5,
