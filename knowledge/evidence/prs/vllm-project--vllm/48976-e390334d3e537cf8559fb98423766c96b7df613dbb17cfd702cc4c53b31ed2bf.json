      "additions": 18,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7cd70d1b249a0b9575bca2c6adb6b958213493d2/tests%2Ftool_parsers%2Ftest_mistral_tool_parser.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_parsers%2Ftest_mistral_tool_parser.py?ref=7cd70d1b249a0b9575bca2c6adb6b958213493d2",
      "deletions": 0,
      "filename": "tests/tool_parsers/test_mistral_tool_parser.py",
      "patch": "@@ -526,6 +526,24 @@ def test_extract_tool_calls_v11_without_args_skipped(mistral_tool_parser):\n     )\n \n \n+def test_extract_tool_calls_v11_ignores_trailing_text():\n+    mock_tokenizer = MagicMock()\n+    mock_tokenizer.get_vocab.return_value = {\"[TOOL_CALLS]\": 1, \"[ARGS]\": 2}\n+    parser = MistralToolParser(mock_tokenizer)\n+\n+    result = parser.extract_tool_calls(\n+        '[TOOL_CALLS]get_weather{\"city\":\"San Francisco\"}Estimating the weather...',\n+        request=_DUMMY_REQUEST,\n+    )\n+\n+    assert result.tools_called\n+    assert len(result.tool_calls) == 1\n+    assert result.tool_calls[0].function.name == \"get_weather\"\n+    assert result.tool_calls[0].function.arguments == json.dumps(\n+        {\"city\": \"San Francisco\"}\n+    )\n+\n+\n def _test_extract_tool_calls_streaming(\n     tool_parser, tokenizer, model_output, tools, expected_tool_calls, expected_content\n ):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7cd70d1b249a0b9575bca2c6adb6b958213493d2/tests%2Ftool_parsers%2Ftest_mistral_tool_parser.py",
      "sha": "4f77fda661cf5552b1a7a14138056cfd4c1618ad",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7cd70d1b249a0b9575bca2c6adb6b958213493d2/vllm%2Ftool_parsers%2Fmistral_tool_parser.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fmistral_tool_parser.py?ref=7cd70d1b249a0b9575bca2c6adb6b958213493d2",
      "deletions": 4,
      "filename": "vllm/tool_parsers/mistral_tool_parser.py",
      "patch": "@@ -304,10 +304,14 @@ def extract_tool_calls(\n                     continue\n \n                 end_name = raw_tool_call.find(\"{\")\n-                tool_name, args = (\n-                    raw_tool_call[:end_name],\n-                    raw_tool_call[end_name:],\n-                )\n+                tool_name = raw_tool_call[:end_name]\n+                args = raw_tool_call[end_name:]\n+                try:\n+                    parsed_args, _ = json.JSONDecoder().raw_decode(args)\n+                except json.JSONDecodeError:\n+                    pass\n+                else:\n+                    args = json.dumps(parsed_args, ensure_ascii=False)\n \n                 # HF tokenizers may include [ARGS] in the text\n                 tool_name = tool_name.replace(\"[ARGS]\", \"\")",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7cd70d1b249a0b9575bca2c6adb6b958213493d2/vllm%2Ftool_parsers%2Fmistral_tool_parser.py",
      "sha": "68271edf09f9a7f9f8eab472fbafba08590e4bbe",
      "status": "modified"
    }
  ],
