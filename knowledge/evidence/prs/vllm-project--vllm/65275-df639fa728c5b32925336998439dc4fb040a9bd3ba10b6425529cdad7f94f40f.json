    {
      "additions": 54,
      "blob_url": "https://github.com/vllm-project/vllm/blob/58d3261b481de9ad447dca586136e3c3b042d8b9/tests%2Fv1%2Fcudagraph%2Ftest_encoder_only_full_cudagraph.py",
      "changes": 54,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fcudagraph%2Ftest_encoder_only_full_cudagraph.py?ref=58d3261b481de9ad447dca586136e3c3b042d8b9",
      "deletions": 0,
      "filename": "tests/v1/cudagraph/test_encoder_only_full_cudagraph.py",
      "patch": "@@ -0,0 +1,54 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"Encoder-only (non-causal) attention under FULL CUDA graphs: a single prompt\n+replayed through a graph captured on a many-request dummy batch must give the\n+same result as eager execution.\"\"\"\n+\n+import pytest\n+import torch\n+\n+from vllm import LLM, SamplingParams\n+from vllm.platforms import current_platform\n+\n+MODEL = \"hmellor/tiny-random-LlamaForCausalLM\"\n+\n+\n+def _last_logprobs(cudagraph_mode: str, prompts: list[list[int]]) -> list[list[float]]:\n+    llm = LLM(\n+        MODEL,\n+        hf_overrides={\"is_causal\": False},\n+        max_model_len=2048,\n+        max_num_batched_tokens=4096,\n+        enable_prefix_caching=False,\n+        gpu_memory_utilization=0.3,\n+        dtype=\"float32\",\n+        compilation_config={\n+            \"cudagraph_mode\": cudagraph_mode,\n+            \"max_cudagraph_capture_size\": 1024,\n+        },\n+    )\n+    params = SamplingParams(\n+        max_tokens=1, temperature=0.0, logprob_token_ids=list(range(100, 132))\n+    )\n+    out = []\n+    for prompt in prompts:  # one request per step: each replays a FULL graph\n+        (result,) = llm.generate([{\"prompt_token_ids\": prompt}], params, use_tqdm=False)\n+        out.append([lp.logprob for lp in result.outputs[0].logprobs[0].values()])\n+    del llm\n+    torch.cuda.empty_cache()\n+    return out\n+\n+\n+@pytest.mark.skipif(not current_platform.is_cuda(), reason=\"CUDA graphs need CUDA\")\n+def test_encoder_only_full_cudagraph_matches_eager():\n+    generator = torch.Generator().manual_seed(0)\n+    prompts = [\n+        torch.randint(100, 30000, (n,), generator=generator).tolist()\n+        for n in (23, 150, 600, 1000)\n+    ]\n+    expected = _last_logprobs(\"NONE\", prompts)\n+    actual = _last_logprobs(\"FULL\", prompts)\n+    for exp, act in zip(expected, actual):\n+        torch.testing.assert_close(\n+            torch.tensor(act), torch.tensor(exp), atol=1e-4, rtol=1e-4\n+        )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/58d3261b481de9ad447dca586136e3c3b042d8b9/tests%2Fv1%2Fcudagraph%2Ftest_encoder_only_full_cudagraph.py",
      "sha": "b55a9f08242fd9289337feea8b3d1d5ef9bb2387",
      "status": "added"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/58d3261b481de9ad447dca586136e3c3b042d8b9/vllm%2Fv1%2Fworker%2Fgpu%2Fmodel_states%2Fencoder_only.py",
      "changes": 8,
