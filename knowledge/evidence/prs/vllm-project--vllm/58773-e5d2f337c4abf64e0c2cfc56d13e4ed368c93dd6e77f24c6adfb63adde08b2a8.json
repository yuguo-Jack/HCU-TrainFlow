      "patch": "@@ -609,7 +609,7 @@ def build(owned=True):\n                 get_vocab_size=lambda: 64,\n             ),\n             attention_config=SimpleNamespace(),\n-            cache_config=SimpleNamespace(),\n+            cache_config=SimpleNamespace(cache_dtype=\"auto\"),\n             load_config=LoadConfig(),\n         )\n         with set_current_vllm_config(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/417b0b6aa2894f95f9170a1f1f0c9255ab48a66c/tests%2Fv1%2Fspec_decode%2Ftest_lilicorr.py",
      "sha": "aae22eec9e1f7882f03236a5152fc7a0a1107e4a",
