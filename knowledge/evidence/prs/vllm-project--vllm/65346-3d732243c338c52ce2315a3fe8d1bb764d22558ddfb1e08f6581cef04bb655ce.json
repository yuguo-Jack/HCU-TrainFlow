      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/e9dd4408e62f2cedafb43aebdd61bbfcdd8f6769/vllm%2Ftool_parsers%2Fernie45_tool_parser.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fernie45_tool_parser.py?ref=e9dd4408e62f2cedafb43aebdd61bbfcdd8f6769",
      "deletions": 0,
      "filename": "vllm/tool_parsers/ernie45_tool_parser.py",
      "patch": "@@ -99,6 +99,11 @@ def extract_tool_calls(\n                         )\n                     )\n \n+                if not tool_calls:\n+                    return ExtractedToolCallInformation(\n+                        tools_called=False, tool_calls=[], content=model_output\n+                    )\n+\n                 content = model_output[\n                     : model_output.find(self.tool_calls_start_token)\n                 ].rstrip(\"\\n\")",
      "raw_url": "https://github.com/vllm-project/vllm/raw/e9dd4408e62f2cedafb43aebdd61bbfcdd8f6769/vllm%2Ftool_parsers%2Fernie45_tool_parser.py",
