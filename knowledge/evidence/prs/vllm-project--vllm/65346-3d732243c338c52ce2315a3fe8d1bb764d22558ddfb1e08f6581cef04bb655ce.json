      "deletions": 0,
      "filename": "tests/tool_parsers/test_ernie45_moe_tool_parser.py",
      "patch": "@@ -60,6 +60,20 @@ def test_extract_tool_calls_no_tools(ernie45_tool_parser):\n     assert extracted_tool_calls.content == model_output\n \n \n+def test_extract_tool_calls_truncated_keeps_content(ernie45_tool_parser):\n+    # Output cut off (e.g. by max_tokens) before </tool_call> has no complete call,\n+    # so it must be returned as content instead of being dropped.\n+    model_output = (\n+        'Sure.\\n<tool_call>\\n{\"name\": \"get_weather\", \"arguments\": {\"city\": \"Par'\n+    )\n+    extracted_tool_calls = ernie45_tool_parser.extract_tool_calls(\n+        model_output, request=None\n+    )\n+    assert not extracted_tool_calls.tools_called\n+    assert extracted_tool_calls.tool_calls == []\n+    assert extracted_tool_calls.content == model_output\n+\n+\n @pytest.mark.parametrize(\n     ids=[\n         \"single_tool_call\",",
      "raw_url": "https://github.com/vllm-project/vllm/raw/e9dd4408e62f2cedafb43aebdd61bbfcdd8f6769/tests%2Ftool_parsers%2Ftest_ernie45_moe_tool_parser.py",
      "sha": "83045fba4ff61c5caa43dab174de586e1c0571fb",
      "status": "modified"
    },
