      "deletions": 0,
      "filename": ".buildkite/test_areas/entrypoints.yaml",
      "patch": "@@ -2,6 +2,35 @@ group: Entrypoints\n depends_on: \n   - image-build\n steps:\n+- label: \":computer: (CPU) Anthropic Contracts\"\n+  key: cpu-anthropic-contracts\n+  depends_on:\n+  - image-build-cpu\n+  device: cpu-small\n+  timeout_in_minutes: 15\n+  working_dir: \"/vllm-workspace/tests\"\n+  env:\n+    VLLM_TARGET_DEVICE: \"cpu\"\n+  source_file_dependencies:\n+  - vllm/entrypoints/\n+  - vllm/config/\n+  - vllm/exceptions.py\n+  - vllm/envs.py\n+  - vllm/platforms/\n+  - vllm/renderers/\n+  - vllm/tokenizers/\n+  - tests/conftest.py\n+  - tests/entrypoints/anthropic/\n+  - requirements/common.txt\n+  - requirements/cpu.txt\n+  - requirements/test/cpu.txt\n+  commands:\n+  - >-\n+    pytest -v -s\n+    entrypoints/anthropic/test_protocol_exports.py\n+    entrypoints/anthropic/test_error_type_mapping.py\n+    entrypoints/anthropic/test_anthropic_messages_conversion.py\n+\n - label: \":nvidia: (H200) [Nightly] Initialized Snapshot E2E\"\n   key: initialized-snapshot-e2e\n   device: h200",
