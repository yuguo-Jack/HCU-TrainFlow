  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c135c141abc4f5860549ded71148b3e5d35ddbee/rust%2Fsrc%2Fserver%2Fsrc%2Fgrpc%2Fcontrol.rs",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/rust%2Fsrc%2Fserver%2Fsrc%2Fgrpc%2Fcontrol.rs?ref=c135c141abc4f5860549ded71148b3e5d35ddbee",
      "deletions": 0,
      "filename": "rust/src/server/src/grpc/control.rs",
      "patch": "@@ -377,6 +377,9 @@ impl pb::control_server::Control for ControlServiceImpl {\n         let request = request.into_inner();\n         let mode = pause_mode(request.mode)?;\n         let level = request.level.unwrap_or(1);\n+        if level > 2 {\n+            return Err(Status::invalid_argument(\"level must be between 0 and 2\"));\n+        }\n         let _guard = self.rl_lock.lock().await;\n         self.client()\n             .sleep(level, mode)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c135c141abc4f5860549ded71148b3e5d35ddbee/rust%2Fsrc%2Fserver%2Fsrc%2Fgrpc%2Fcontrol.rs",
      "sha": "324457416f79d9c166086be0b06e55e1fa7ae83e",
      "status": "modified"
    },
    {
      "additions": 74,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c135c141abc4f5860549ded71148b3e5d35ddbee/rust%2Fsrc%2Fserver%2Fsrc%2Fgrpc%2Ftests.rs",
      "changes": 74,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/rust%2Fsrc%2Fserver%2Fsrc%2Fgrpc%2Ftests.rs?ref=c135c141abc4f5860549ded71148b3e5d35ddbee",
      "deletions": 0,
      "filename": "rust/src/server/src/grpc/tests.rs",
      "patch": "@@ -2101,6 +2101,80 @@ async fn control_reports_server_and_model_info() {\n     server_task.abort();\n }\n \n+#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\n+#[serial]\n+async fn control_sleep_rejects_level_above_two_before_engine_call() {\n+    let mut ready = default_ready_response();\n+    ready.enable_sleep_mode = true;\n+    let (level_tx, level_rx) = tokio::sync::oneshot::channel();\n+    let (inference_service, control_service, engine_health, engine_task) =\n+        setup_grpc_service_with_engine_script(\n+            b\"engine-grpc-sleep-level\".to_vec(),\n+            ready,\n+            Arc::new(FakeTextBackend),\n+            None,\n+            move |dealer, push| {\n+                boxed_test_future(async move {\n+                    let frames = recv_engine_message(dealer).await;\n+                    assert_eq!(frames[0].as_ref(), &[0x03]);\n+                    let payload = decode_value(&frames[1]).expect(\"decode utility payload\");\n+                    let fields = payload.as_array().expect(\"utility payload array\");\n+                    let call_id = fields[1].as_u64().expect(\"utility call id\");\n+                    assert_eq!(fields[2].as_str(), Some(\"sleep\"));\n+                    let args = fields[3].as_array().expect(\"sleep arguments\");\n+                    level_tx.send(args[0].as_u64()).expect(\"report sleep level\");\n+                    send_outputs(\n+                        push,\n+                        UtilityCallOutput {\n+                            output: UtilityOutput {\n+                                call_id: call_id.into(),\n+                                failure_message: None,\n+                                result: Some(UtilityResultEnvelope::without_type_info(Value::Nil)),\n+                            },\n+                            ..Default::default()\n+                        }\n+                        .into(),\n+                    )\n+                    .await;\n+                })\n+            },\n+        )\n+        .await;\n+    let (channel, server_task) = start_grpc_test_server(\n+        inference_service,\n+        control_service,\n+        engine_health,\n+        tokio_util::sync::CancellationToken::new(),\n+    )\n+    .await;\n+    let mut client = ControlClient::new(channel);\n+\n+    let status = client\n+        .sleep(pb::SleepRequest {\n+            level: Some(3),\n+            ..Default::default()\n+        })\n+        .await\n+        .expect_err(\"unsupported sleep level should be rejected\");\n+    assert_eq!(status.code(), tonic::Code::InvalidArgument);\n+    assert_eq!(status.message(), \"level must be between 0 and 2\");\n+\n+    client\n+        .sleep(pb::SleepRequest {\n+            level: Some(2),\n+            ..Default::default()\n+        })\n+        .await\n+        .expect(\"level 2 sleep should reach the engine\");\n+    assert_eq!(\n+        level_rx.await.expect(\"receive forwarded sleep level\"),\n+        Some(2)\n+    );\n+\n+    engine_task.await.expect(\"mock engine task\");\n+    server_task.abort();\n+}\n+\n #[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\n #[serial]\n async fn control_lora_lifecycle_selects_adapter_for_generation() {",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c135c141abc4f5860549ded71148b3e5d35ddbee/rust%2Fsrc%2Fserver%2Fsrc%2Fgrpc%2Ftests.rs",
