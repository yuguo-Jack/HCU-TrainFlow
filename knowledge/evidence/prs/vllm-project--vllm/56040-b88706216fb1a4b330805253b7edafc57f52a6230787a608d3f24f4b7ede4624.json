      "additions": 50,
      "blob_url": "https://github.com/vllm-project/vllm/blob/28525d092df3f1db9f76feee8bc65004d8861f08/tests%2Fv1%2Fattention%2Ftest_rocm_attention_backends_selection.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fattention%2Ftest_rocm_attention_backends_selection.py?ref=28525d092df3f1db9f76feee8bc65004d8861f08",
      "deletions": 0,
      "filename": "tests/v1/attention/test_rocm_attention_backends_selection.py",
      "patch": "@@ -145,6 +145,56 @@ def test_standard_attention_backend_selection(\n     assert backend_path == expected_backend_path\n \n \n+@pytest.mark.parametrize(\n+    \"unified_attn_env, expect_selected\",\n+    [\n+        # Unset: RDNA keeps ROCM_AITER_UNIFIED_ATTN as the default with aiter.\n+        (None, True),\n+        # Explicit opt-out drops only this kernel (see #56021).\n+        (\"0\", False),\n+        (\"1\", True),\n+    ],\n+)\n+def test_rdna_unified_attn_backend_opt_out(\n+    monkeypatch, unified_attn_env, expect_selected\n+):\n+    \"\"\"On RDNA, VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=0 must opt out of\n+    ROCM_AITER_UNIFIED_ATTN without changing the default when it is unset.\"\"\"\n+    from vllm._aiter_ops import rocm_aiter_ops\n+    from vllm.envs import disable_envs_cache\n+    from vllm.platforms.rocm import _get_backend_priorities\n+\n+    try:\n+        with monkeypatch.context() as m:\n+            if unified_attn_env is None:\n+                m.delenv(\"VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION\", raising=False)\n+            else:\n+                m.setenv(\"VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION\", unified_attn_env)\n+            disable_envs_cache()\n+            rocm_aiter_ops.refresh_env_variables()\n+\n+            with (\n+                patch(\n+                    \"vllm._aiter_ops.is_aiter_found_and_supported\", return_value=False\n+                ),\n+                patch(\n+                    \"vllm._aiter_ops.rocm_aiter_ops.is_mha_enabled\", return_value=False\n+                ),\n+                patch(\n+                    \"vllm._aiter_ops.rocm_aiter_ops.is_rdna_aiter_enabled\",\n+                    return_value=True,\n+                ),\n+            ):\n+                backends = _get_backend_priorities(use_mla=False, use_sparse=False)\n+    finally:\n+        rocm_aiter_ops.refresh_env_variables()\n+\n+    if expect_selected:\n+        assert backends[0] == AttentionBackendEnum.ROCM_AITER_UNIFIED_ATTN\n+    else:\n+        assert AttentionBackendEnum.ROCM_AITER_UNIFIED_ATTN not in backends\n+\n+\n @pytest.mark.parametrize(\n     \"env_vars, selected_backend, block_size, expected_backend_path, should_raise\",\n     [",
      "raw_url": "https://github.com/vllm-project/vllm/raw/28525d092df3f1db9f76feee8bc65004d8861f08/tests%2Fv1%2Fattention%2Ftest_rocm_attention_backends_selection.py",
      "sha": "297046a4c8a832322816829cc6a7dd4fca6596d4",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/vllm-project/vllm/blob/28525d092df3f1db9f76feee8bc65004d8861f08/vllm%2F_aiter_ops.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2F_aiter_ops.py?ref=28525d092df3f1db9f76feee8bc65004d8861f08",
      "deletions": 0,
      "filename": "vllm/_aiter_ops.py",
      "patch": "@@ -1735,6 +1735,18 @@ def is_rdna_linear_enabled(cls) -> bool:\n         \"\"\"RDNA4 (gfx12) analog of is_linear_enabled() (aiter Triton blockscale).\"\"\"\n         return cls.is_rdna_aiter_enabled() and cls._LINEAR_ENABLED\n \n+    @classmethod\n+    def is_rdna_unified_attn_enabled(cls) -> bool:\n+        \"\"\"RDNA4 (gfx12) analog of is_triton_unified_attn_enabled(). On by\n+        default with aiter, but an explicit\n+        VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION=0 opts out of this kernel while\n+        keeping aiter's other Triton paths, e.g. linear GEMM.\"\"\"\n+        opted_out = (\n+            envs.is_set(\"VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION\")\n+            and not cls._TRITON_UNIFIED_ATTN_ENABLED\n+        )\n+        return cls.is_rdna_aiter_enabled() and not opted_out\n+\n     @classmethod\n     @if_aiter_supported\n     def is_linear_enabled(cls) -> bool:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/28525d092df3f1db9f76feee8bc65004d8861f08/vllm%2F_aiter_ops.py",
      "sha": "1245e84695c62d4a4947574ccfece25fbdb0ded7",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/28525d092df3f1db9f76feee8bc65004d8861f08/vllm%2Fplatforms%2Frocm.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fplatforms%2Frocm.py?ref=28525d092df3f1db9f76feee8bc65004d8861f08",
      "deletions": 1,
      "filename": "vllm/platforms/rocm.py",
      "patch": "@@ -476,7 +476,7 @@ def _get_backend_priorities(\n         backends.append(AttentionBackendEnum.ROCM_AITER_FA)\n     if is_aiter_found_and_supported():\n         backends.append(AttentionBackendEnum.ROCM_AITER_UNIFIED_ATTN)\n-    elif rocm_aiter_ops.is_rdna_aiter_enabled():\n+    elif rocm_aiter_ops.is_rdna_unified_attn_enabled():\n         backends.insert(0, AttentionBackendEnum.ROCM_AITER_UNIFIED_ATTN)\n     backends.append(AttentionBackendEnum.TRITON_ATTN)\n     backends.append(AttentionBackendEnum.TURBOQUANT)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/28525d092df3f1db9f76feee8bc65004d8861f08/vllm%2Fplatforms%2Frocm.py",
      "sha": "c8f2ae0e94bcfcccc940b41033fc70d5f0124d94",
      "status": "modified"
    }
