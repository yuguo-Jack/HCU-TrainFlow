      "additions": 51,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ffc2c31c19178eb1a981130006cd10097ae24166/tests%2Fv1%2Fengine%2Ftest_kv_cache_group_metadata.py",
      "changes": 51,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fengine%2Ftest_kv_cache_group_metadata.py?ref=ffc2c31c19178eb1a981130006cd10097ae24166",
      "deletions": 0,
      "filename": "tests/v1/engine/test_kv_cache_group_metadata.py",
      "patch": "@@ -3,16 +3,20 @@\n \n from types import SimpleNamespace\n \n+import msgspec\n import pytest\n import torch\n \n from vllm.v1.core.kv_cache_manager import KVCacheManager\n from vllm.v1.engine.core import EngineCore\n from vllm.v1.kv_cache_interface import (\n+    KpoolTailSpec,\n     KVCacheConfig,\n     KVCacheGroupSpec,\n     MambaSpec,\n     MLAAttentionSpec,\n+    SlidingWindowMLASpec,\n+    UniformTypeKVCacheSpecs,\n )\n \n pytestmark = pytest.mark.cpu_test\n@@ -63,8 +67,55 @@ def test_kv_cache_group_metadata_uses_effective_dcp_block_sizes() -> None:\n     # DCP scales attention blocks but does not scale replicated Mamba state.\n     assert [item[\"block_size\"] for item in metadata] == [12288, 1536]\n     assert [item[\"kind\"] for item in metadata] == [\"mla_attention\", \"mamba\"]\n+    assert [item[\"prefix_cacheable\"] for item in metadata] == [True, True]\n+    assert [item[\"prefix_replay_tokens\"] for item in metadata] == [0, 0]\n \n     managers = engine_core.scheduler.kv_cache_manager.coordinator.single_type_managers\n     assert [item[\"block_size\"] for item in metadata] == [\n         manager.block_size for manager in managers\n     ]\n+\n+\n+@pytest.mark.parametrize(\n+    \"spec_type,bounded_replay,wrapped,cacheable,replay_tokens\",\n+    [\n+        pytest.param(KpoolTailSpec, False, False, False, 0, id=\"kpool-tail\"),\n+        pytest.param(SlidingWindowMLASpec, False, False, True, 0, id=\"sliding-mla\"),\n+        pytest.param(SlidingWindowMLASpec, True, False, False, 128, id=\"replay\"),\n+        pytest.param(SlidingWindowMLASpec, True, True, False, 128, id=\"wrapped-replay\"),\n+    ],\n+)\n+def test_kv_cache_group_metadata_reports_prefix_policy(\n+    spec_type, bounded_replay, wrapped, cacheable, replay_tokens\n+) -> None:\n+    \"\"\"The same attention kind can require a different prefix reuse policy.\"\"\"\n+    kwargs = dict(\n+        block_size=16,\n+        num_kv_heads=1,\n+        head_size=64,\n+        dtype=torch.bfloat16,\n+        sliding_window=128,\n+    )\n+    if spec_type is SlidingWindowMLASpec:\n+        kwargs[\"bounded_replay\"] = bounded_replay\n+    spec = spec_type(**kwargs)\n+    if wrapped:\n+        spec = UniformTypeKVCacheSpecs(block_size=16, kv_cache_specs={\"layer\": spec})\n+    engine_core = object.__new__(EngineCore)\n+    engine_core.scheduler = SimpleNamespace(\n+        kv_cache_config=SimpleNamespace(\n+            kv_cache_groups=[KVCacheGroupSpec([\"layer\"], spec)]\n+        ),\n+        kv_cache_manager=SimpleNamespace(\n+            coordinator=SimpleNamespace(\n+                single_type_managers=[SimpleNamespace(block_size=16)]\n+            )\n+        ),\n+    )\n+\n+    metadata = msgspec.msgpack.decode(\n+        msgspec.msgpack.encode(engine_core.get_kv_cache_group_metadata())\n+    )\n+\n+    assert metadata[0][\"prefix_cacheable\"] is cacheable\n+    assert metadata[0][\"prefix_replay_tokens\"] == replay_tokens",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ffc2c31c19178eb1a981130006cd10097ae24166/tests%2Fv1%2Fengine%2Ftest_kv_cache_group_metadata.py",
      "sha": "e49edaab05d30a6392079a382c0cfd3b34d1a976",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ffc2c31c19178eb1a981130006cd10097ae24166/vllm%2Fv1%2Fengine%2Fcore.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Fcore.py?ref=ffc2c31c19178eb1a981130006cd10097ae24166",
      "deletions": 2,
      "filename": "vllm/v1/engine/core.py",
      "patch": "@@ -474,7 +474,7 @@ def log_field(name: str, field: str) -> str:\n             supported_pooling_tasks,\n         )\n \n-    def get_kv_cache_group_metadata(self) -> list[dict[str, int | str | None]]:\n+    def get_kv_cache_group_metadata(self) -> list[dict[str, int | str | bool | None]]:\n         \"\"\"Return serializable KV cache metadata for external event consumers\n         (e.g., Dynamo). This function has no call sites within vLLM but needs to\n         be kept.\n@@ -485,7 +485,7 @@ def get_kv_cache_group_metadata(self) -> list[dict[str, int | str | None]]:\n \n         kv_cache_manager = cast(Any, self.scheduler).kv_cache_manager\n         managers = kv_cache_manager.coordinator.single_type_managers\n-        metadata: list[dict[str, int | str | None]] = []\n+        metadata: list[dict[str, int | str | bool | None]] = []\n         for group_idx, (group, manager) in enumerate(\n             zip(kv_cache_config.kv_cache_groups, managers, strict=True)\n         ):\n@@ -496,6 +496,8 @@ def get_kv_cache_group_metadata(self) -> list[dict[str, int | str | None]]:\n                     \"kind\": get_kv_cache_spec_kind(spec).value,\n                     \"block_size\": manager.block_size,\n                     \"sliding_window\": getattr(spec, \"sliding_window\", None),\n+                    \"prefix_cacheable\": spec.prefix_cacheable,\n+                    \"prefix_replay_tokens\": spec.prefix_replay_tokens,\n                 }\n             )\n         return metadata",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ffc2c31c19178eb1a981130006cd10097ae24166/vllm%2Fv1%2Fengine%2Fcore.py",
      "sha": "5835a7e97235c65c17c841b2058e9579a608760d",
      "status": "modified"
    }
