      "blob_url": "https://github.com/vllm-project/vllm/blob/55643cf2851e28f22404c82e9723b55b91fe67d9/tests%2Fbenchmarks%2Ftest_forward_cli.py",
      "changes": 58,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fbenchmarks%2Ftest_forward_cli.py?ref=55643cf2851e28f22404c82e9723b55b91fe67d9",
      "deletions": 1,
      "filename": "tests/benchmarks/test_forward_cli.py",
      "patch": "@@ -1,17 +1,20 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+import gzip\n import json\n import subprocess\n+from contextlib import nullcontext\n from dataclasses import replace\n from pathlib import Path\n from types import SimpleNamespace\n \n import numpy as np\n import pytest\n \n+from vllm.benchmarks.forward import profile as forward_profile\n from vllm.benchmarks.forward.batch import build_batch\n from vllm.benchmarks.forward.main import run_case\n-from vllm.benchmarks.forward.profile import summarize\n+from vllm.benchmarks.forward.profile import profile_graph, summarize\n from vllm.benchmarks.forward.shapes import jitter_kv_lens, parse_case\n from vllm.platforms import current_platform\n \n@@ -128,6 +131,59 @@ def act(name, ts, dur, cat=\"kernel\"):\n         summarize(events[:-1], replays=2, skip=1)\n \n \n+def test_torch_profile_does_not_toggle_cuda_profiler(tmp_path, monkeypatch):\n+    \"\"\"torch.profiler and cudaProfilerStart must not own CUPTI together.\"\"\"\n+\n+    class FakeGraph:\n+        def __init__(self):\n+            self.replays = 0\n+\n+        def replay(self):\n+            self.replays += 1\n+\n+    class FakeProfiler:\n+        def __enter__(self):\n+            return self\n+\n+        def __exit__(self, *_):\n+            return False\n+\n+        def export_chrome_trace(self, path):\n+            events = [\n+                {\"cat\": \"kernel\", \"name\": \"kernel\", \"ts\": i * 10, \"dur\": 1}\n+                for i in range(3)\n+            ]\n+            with gzip.open(path, \"wt\") as f:\n+                json.dump({\"traceEvents\": events}, f)\n+\n+    def unexpected_cuda_profiler_call():\n+        pytest.fail(\"cudaProfilerStart/Stop must not run under torch.profiler\")\n+\n+    monkeypatch.setattr(\n+        forward_profile.torch.profiler, \"profile\", lambda activities: FakeProfiler()\n+    )\n+    monkeypatch.setattr(\n+        forward_profile.torch.cuda.nvtx, \"range\", lambda _: nullcontext()\n+    )\n+    monkeypatch.setattr(forward_profile.torch.accelerator, \"synchronize\", lambda: None)\n+    monkeypatch.setattr(\n+        forward_profile.torch.cuda.profiler,\n+        \"start\",\n+        unexpected_cuda_profiler_call,\n+    )\n+    monkeypatch.setattr(\n+        forward_profile.torch.cuda.profiler,\n+        \"stop\",\n+        unexpected_cuda_profiler_call,\n+    )\n+\n+    graph = FakeGraph()\n+    summary = profile_graph(graph, \"test\", str(tmp_path / \"profile\"), skip=0)\n+\n+    assert graph.replays == 3\n+    assert summary is not None and summary[\"activities\"] == 1\n+\n+\n @pytest.mark.benchmark\n # TODO(woosuk): Support ROCm and re-enable this test there.\n @pytest.mark.skipif(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/55643cf2851e28f22404c82e9723b55b91fe67d9/tests%2Fbenchmarks%2Ftest_forward_cli.py",
      "sha": "fe9f89876d07350937bdc5cd579f377fb11cd355",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/vllm-project/vllm/blob/55643cf2851e28f22404c82e9723b55b91fe67d9/vllm%2Fbenchmarks%2Fforward%2Fprofile.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fbenchmarks%2Fforward%2Fprofile.py?ref=55643cf2851e28f22404c82e9723b55b91fe67d9",
      "deletions": 12,
      "filename": "vllm/benchmarks/forward/profile.py",
      "patch": "@@ -9,8 +9,9 @@\n Summarize one file or compare two (e.g. before/after a change):\n `python -m vllm.benchmarks.forward.profile A.kernels.json [B.kernels.json]`.\n \n-The same replays run between `cudaProfilerStart`/`Stop` in an NVTX range per\n-case (with or without `--profile-dir`), so Nsight Systems can record just them:\n+Without `--profile-dir`, the same replays run between\n+`cudaProfilerStart`/`Stop` in an NVTX range per case, so Nsight Systems can\n+record just them:\n `nsys profile --capture-range=cudaProfilerApi --capture-range-end=repeat\n --cuda-graph-trace=node vllm bench forward ...`.\n \"\"\"\n@@ -157,27 +158,33 @@ def profile_graph(\n     this (replays may contain collectives).\n     \"\"\"\n \n-    def run() -> None:\n-        # `cudaProfilerStart`/`Stop` and NVTX ranges are CUDA-only (for\n-        # Nsight Systems); other accelerators just replay.\n+    def run(mark_for_nsys: bool) -> None:\n+        # cudaProfilerStart/Stop controls CUPTI collection for nsys. Do not\n+        # nest it inside torch.profiler, which also owns CUPTI and may then\n+        # produce an empty trace with \"bufferCompleted called with unknown\n+        # buffer\" errors.\n+        # The profiler controls and NVTX ranges are CUDA-only; XPU just\n+        # replays the graph for torch.profiler to observe.\n         if current_platform.is_xpu():\n             for _ in range(replays):\n                 graph.replay()\n                 torch.accelerator.synchronize()\n-        else:\n+            return\n+        if mark_for_nsys:\n             torch.cuda.profiler.start()\n-            with torch.cuda.nvtx.range(f\"forward/{name}\"):\n-                for _ in range(replays):\n-                    graph.replay()\n-                    torch.accelerator.synchronize()\n+        with torch.cuda.nvtx.range(f\"forward/{name}\"):\n+            for _ in range(replays):\n+                graph.replay()\n+                torch.accelerator.synchronize()\n+        if mark_for_nsys:\n             torch.cuda.profiler.stop()\n \n     if prefix is None:\n-        run()\n+        run(mark_for_nsys=True)\n         return None\n     activities = get_default_torch_profiler_activities()\n     with torch.profiler.profile(activities=activities) as prof:\n-        run()\n+        run(mark_for_nsys=False)\n     trace = f\"{prefix}.trace.json.gz\"\n     prof.export_chrome_trace(trace)\n     with gzip.open(trace, \"rt\") as f:",
