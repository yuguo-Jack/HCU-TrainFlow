  "files": [
    {
      "additions": 16,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7f13428f8e9d16d8e37a4335b69a8e5b30e57567/.buildkite%2Fscripts%2Finstall-kv-connectors.sh",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Fscripts%2Finstall-kv-connectors.sh?ref=7f13428f8e9d16d8e37a4335b69a8e5b30e57567",
      "deletions": 0,
      "filename": ".buildkite/scripts/install-kv-connectors.sh",
      "patch": "@@ -44,6 +44,22 @@ PY\n read -r CUDA_MAJOR NIXL_VERSION MOONCAKE_VERSION <<<\"${KV_METADATA}\"\n MOONCAKE_VERSION=\"${MOONCAKE_VERSION:-}\"\n \n+# The lmcache wheel targets one torch release; its CUDA extension fails to load\n+# against any other. Rebuild it against the installed torch if so.\n+if ! python3 -c \"import torch, lmcache.cuda_ops\" 2>/dev/null; then\n+    LMCACHE_VERSION=$(python3 -c \"import importlib.metadata as m; print(m.version('lmcache'))\")\n+    GRPCIO_VERSION=$(python3 -c \"import importlib.metadata as m; print(m.version('grpcio'))\")\n+    CUDA_VERSION_DASH=$(python3 -c 'import torch; print(torch.version.cuda.replace(\".\", \"-\"))')\n+    LMCACHE_BUILD_PKGS=(\"libcusparse-dev-${CUDA_VERSION_DASH}\" \"libcusolver-dev-${CUDA_VERSION_DASH}\")\n+    apt-get update -y\n+    apt-get install -y --no-install-recommends --allow-change-held-packages \"${LMCACHE_BUILD_PKGS[@]}\"\n+    uv pip install --system -c \"${CONSTRAINTS_DIR}/constraints.txt\" \"grpcio-tools==${GRPCIO_VERSION}\" setuptools-scm\n+    BUILD_WITH_CUDA=1 LMCACHE_CUDA_MAJOR=\"${CUDA_MAJOR}\" \\\n+        uv pip install --system --no-cache --no-deps --no-build-isolation \\\n+        --no-binary lmcache --reinstall-package lmcache \"lmcache==${LMCACHE_VERSION}\"\n+    python3 -c \"import torch, lmcache.cuda_ops\"\n+fi\n+\n # nixl>=1.1.0 can install multiple CUDA wheel variants. Keep only the variant\n # matching this CI image so nixl_ep_cpp links against the available libcudart.\n uv pip uninstall --system nixl-cu12 nixl-cu13 2>/dev/null || true",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7f13428f8e9d16d8e37a4335b69a8e5b30e57567/.buildkite%2Fscripts%2Finstall-kv-connectors.sh",
      "sha": "b58547fa7bca51827e931f84b8b97fda4d90a8bb",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7f13428f8e9d16d8e37a4335b69a8e5b30e57567/docker%2FDockerfile",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile?ref=7f13428f8e9d16d8e37a4335b69a8e5b30e57567",
      "deletions": 0,
      "filename": "docker/Dockerfile",
      "patch": "@@ -1226,6 +1226,22 @@ RUN --mount=type=cache,target=/opt/uv/cache \\\n             # clean up -dev packages, keep runtime libraries\n             rm -rf /var/lib/apt/lists/* \\\n         ); \\\n+        # The lmcache wheel targets one torch release; its CUDA extension fails to\n+        # load against any other. Rebuild it against the installed torch if so.\n+        if ! python3 -c \"import torch, lmcache.cuda_ops\" 2>/dev/null; then \\\n+            LMCACHE_VERSION=$(python3 -c \"import importlib.metadata as m; print(m.version('lmcache'))\"); \\\n+            GRPCIO_VERSION=$(python3 -c \"import importlib.metadata as m; print(m.version('grpcio'))\"); \\\n+            LMCACHE_BUILD_PKGS=\"libcusparse-dev-${CUDA_VERSION_DASH} libcusolver-dev-${CUDA_VERSION_DASH}\"; \\\n+            apt-get update -y; \\\n+            apt-get install -y --no-install-recommends --allow-change-held-packages ${LMCACHE_BUILD_PKGS}; \\\n+            uv pip install --system -c /tmp/kv-constraints.txt \"grpcio-tools==${GRPCIO_VERSION}\" setuptools-scm; \\\n+            BUILD_WITH_CUDA=1 LMCACHE_CUDA_MAJOR=\"${CUDA_MAJOR}\" \\\n+                uv pip install --system --no-cache --no-deps --no-build-isolation \\\n+                --no-binary lmcache --reinstall-package lmcache \"lmcache==${LMCACHE_VERSION}\"; \\\n+            python3 -c \"import torch, lmcache.cuda_ops\"; \\\n+            apt-get purge -y ${LMCACHE_BUILD_PKGS}; \\\n+            rm -rf /var/lib/apt/lists/*; \\\n+        fi; \\\n         # The default mooncake wheel links libcudart.so.12, so on CUDA 13 swap in the\n         # cuda13 variant. Uninstall first; both ship the `mooncake` package.\n         # Mirrors .buildkite/scripts/install-kv-connectors.sh.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7f13428f8e9d16d8e37a4335b69a8e5b30e57567/docker%2FDockerfile",
      "sha": "9075d2b9cf5fbe19fabffdf3f1af9a3283bc1346",
      "status": "modified"
    }
  ],
