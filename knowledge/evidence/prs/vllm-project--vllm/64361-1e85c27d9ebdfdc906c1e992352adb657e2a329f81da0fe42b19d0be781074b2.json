  "files": [
    {
      "additions": 16,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7c6f6934b05a650f46d50f5d9ed743ff68f2fb27/tests%2Ftest_sampling_params.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_sampling_params.py?ref=7c6f6934b05a650f46d50f5d9ed743ff68f2fb27",
      "deletions": 0,
      "filename": "tests/test_sampling_params.py",
      "patch": "@@ -56,6 +56,22 @@ def test_non_diffusion_models_unaffected():\n     params.verify(MockModelConfig(), None, None, None)\n \n \n+class _SmallVocab(MockModelConfig):\n+    def get_vocab_size(self) -> int:\n+        return 10\n+\n+\n+def test_logprobs_above_vocab_size_are_rejected():\n+    # max_logprobs can be larger than the vocab. torch.topk then crashes\n+    # in the worker, so validation has to reject the request first.\n+    cfg = _SmallVocab(max_logprobs=20)\n+    with pytest.raises(VLLMValidationError, match=\"vocab\"):\n+        SamplingParams(logprobs=20)._validate_logprobs(cfg)\n+    with pytest.raises(VLLMValidationError, match=\"vocab\"):\n+        SamplingParams(prompt_logprobs=20)._validate_logprobs(cfg)\n+    SamplingParams(logprobs=10)._validate_logprobs(cfg)\n+\n+\n def test_verify_leaves_logits_processors_to_admission():\n     \"\"\"verify() is runner-agnostic; LP validation lives in the admission\n     layer, so an unimportable FQCN must not fail verify().\"\"\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7c6f6934b05a650f46d50f5d9ed743ff68f2fb27/tests%2Ftest_sampling_params.py",
      "sha": "322c722b66c20b0ab3e214ed89af6390a13919d4",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7c6f6934b05a650f46d50f5d9ed743ff68f2fb27/vllm%2Fsampling_params.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fsampling_params.py?ref=7c6f6934b05a650f46d50f5d9ed743ff68f2fb27",
      "deletions": 3,
      "filename": "vllm/sampling_params.py",
      "patch": "@@ -925,8 +925,13 @@ def verify(\n \n     def _validate_logprobs(self, model_config: ModelConfig) -> None:\n         max_logprobs = model_config.max_logprobs\n+        vocab_size = model_config.get_vocab_size()\n         if max_logprobs == -1:\n-            max_logprobs = model_config.get_vocab_size()\n+            max_logprobs = vocab_size\n+        elif vocab_size > 0:\n+            # max_logprobs is not capped by the vocab at config time, and\n+            # torch.topk rejects a k larger than the vocab dimension.\n+            max_logprobs = min(max_logprobs, vocab_size)\n \n         # Validate sample logprobs.\n         if num_logprobs := self.logprobs:\n@@ -935,7 +940,8 @@ def _validate_logprobs(self, model_config: ModelConfig) -> None:\n             if num_logprobs > max_logprobs:\n                 raise VLLMValidationError(\n                     f\"Requested sample logprobs of {num_logprobs}, \"\n-                    f\"which is greater than max allowed: {max_logprobs}\",\n+                    f\"which is greater than max allowed: {max_logprobs} \"\n+                    f\"(vocabulary size {vocab_size})\",\n                     parameter=\"logprobs\",\n                     value=num_logprobs,\n                 )\n@@ -980,7 +986,8 @@ def _validate_logprobs(self, model_config: ModelConfig) -> None:\n             if num_prompt_logprobs > max_logprobs:\n                 raise VLLMValidationError(\n                     f\"Requested prompt logprobs of {num_prompt_logprobs}, \"\n-                    f\"which is greater than max allowed: {max_logprobs}\",\n+                    f\"which is greater than max allowed: {max_logprobs} \"\n+                    f\"(vocabulary size {vocab_size})\",\n                     parameter=\"prompt_logprobs\",\n                     value=num_prompt_logprobs,\n                 )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7c6f6934b05a650f46d50f5d9ed743ff68f2fb27/vllm%2Fsampling_params.py",
      "sha": "24220cd1c5d620ff254755b183d0a870336fe0ed",
      "status": "modified"
    }
