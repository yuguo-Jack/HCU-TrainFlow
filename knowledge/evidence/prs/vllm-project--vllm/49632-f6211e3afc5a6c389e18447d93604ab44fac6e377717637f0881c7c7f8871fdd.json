  "files": [
    {
      "additions": 27,
      "blob_url": "https://github.com/vllm-project/vllm/blob/0872997b3c3e51d8c0076cbfa5e35ffec9124f26/tests%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Ftest_data_transport.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Ftest_data_transport.py?ref=0872997b3c3e51d8c0076cbfa5e35ffec9124f26",
      "deletions": 0,
      "filename": "tests/v1/kv_offload/tiering/p2p/test_data_transport.py",
      "patch": "@@ -166,6 +166,33 @@ def test_poll_returns_failed_for_error_state(self):\n         assert result.done == ()\n         assert tid in result.failed\n \n+    def test_poll_marks_failed_when_check_xfer_state_raises(self):\n+        \"\"\"A check_xfer_state exception marks the transfer as failed.\n+\n+        Regression: poll() used to log a warning and continue without\n+        recording the failure, so the transfer stayed in _inflight forever,\n+        was re-polled (and re-warned) every cycle, and its handle was never\n+        released.\n+        \"\"\"\n+        transport = self._make_transport()\n+        transport.add_remote_peer(\"peer:1\", b\"meta\", 0x1000, 8, 1024)\n+\n+        tid = transport.write_blocks(\"peer:1\", [0], [1])\n+        assert tid in transport._inflight\n+\n+        transport._agent.check_xfer_state.side_effect = RuntimeError(\"nixl boom\")\n+        result = transport.poll()\n+\n+        assert result.done == ()\n+        assert tid in result.failed\n+        # Cleaned up: no longer inflight, handle release attempted.\n+        assert tid not in transport._inflight\n+        transport._agent.release_xfer_handle.assert_called()\n+\n+        # Later polls no longer see (or re-warn about) the dead transfer.\n+        result = transport.poll()\n+        assert result == PollResult(done=(), failed=())\n+\n     def test_poll_ignores_in_progress(self):\n         \"\"\"Transfers in PROC/PEND state stay inflight.\"\"\"\n         transport = self._make_transport()",
      "raw_url": "https://github.com/vllm-project/vllm/raw/0872997b3c3e51d8c0076cbfa5e35ffec9124f26/tests%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Ftest_data_transport.py",
      "sha": "a05ced5ac35ebcdcb01ec19079d8706aecf70513",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/0872997b3c3e51d8c0076cbfa5e35ffec9124f26/vllm%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Fdata%2Fnixl.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Fdata%2Fnixl.py?ref=0872997b3c3e51d8c0076cbfa5e35ffec9124f26",
      "deletions": 0,
      "filename": "vllm/v1/kv_offload/tiering/p2p/data/nixl.py",
      "patch": "@@ -215,7 +215,14 @@ def poll(self, peer_id: str | None = None) -> PollResult:\n                     self._agent_name,\n                     transfer_id,\n                     exc,\n+                    exc_info=True,\n                 )\n+                # Treat the transfer as failed so the post-loop cleanup\n+                # removes it from _inflight and releases its handle\n+                # (mirrors obj/manager.py:_poll_active_transfers).\n+                if failed_ids is None:\n+                    failed_ids = []\n+                failed_ids.append(transfer_id)\n                 continue\n             if state == \"DONE\":\n                 if done_ids is None:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/0872997b3c3e51d8c0076cbfa5e35ffec9124f26/vllm%2Fv1%2Fkv_offload%2Ftiering%2Fp2p%2Fdata%2Fnixl.py",
      "sha": "79ce0aea22b4bb1f1d398d9b45d76d456c596abe",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "With `exc_info=True` added, the exception is now logged twice — once formatted via\nthe `: %s` / `exc` pair on lines 214 and 217, and once as a traceback. Dropping the\ntrailing `: %s` from the format string and the `exc` argument would be cleaner.",
      "created_at": "2026-09-16T11:36:37Z",
      "diff_hunk": "@@ -215,7 +215,14 @@ def poll(self, peer_id: str | None = None) -> PollResult:\n                     self._agent_name,\n                     transfer_id,\n                     exc,\n+                    exc_info=True,",
      "html_url": "https://github.com/vllm-project/vllm/pull/49632#discussion_r4025532851",
      "id": 4025532851,
      "line": 218,
      "original_line": 218,
