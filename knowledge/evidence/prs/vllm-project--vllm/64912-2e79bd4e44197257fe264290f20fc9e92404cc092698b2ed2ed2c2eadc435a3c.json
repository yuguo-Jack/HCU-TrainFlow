  "issue_comments": [
    {
      "body": "@liulanze @bnellnm @mgoin This PR fixes issue #63943 (Triton MoE naive block assignment causing 8-52% decode slowdown on bandwidth-limited GPUs). The fix is a minimal one-line change: only use naive assignment at batch=1 to avoid repeated reads of shared expert weights. Could a maintainer add the 'verified' label so CI runs? (Author has <4 merged PRs, so pre-run-check requires it.)",
      "created_at": "2026-11-01T02:47:09Z",
      "html_url": "https://github.com/vllm-project/vllm/pull/64912#issuecomment-6552502184",
      "id": 6552502184,
      "updated_at": "2026-11-01T02:47:09Z",
      "user": {
        "login": "YuvrajSinghBhadoria2"
      }
    },
