      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Ffused_moe.py?ref=23910de05fca96195c5826f01f8bf5d32f0256fa",
      "deletions": 1,
      "filename": "vllm/model_executor/layers/fused_moe/fused_moe.py",
      "patch": "@@ -1632,10 +1632,13 @@ def _prepare_expert_assignment(\n     # path of the fused_moe_kernel kernel, which reads an expert's weights once\n     # per (token, expert) pair. Not for weights in host memory: there every\n     # repeated read crosses PCIe, so group each expert's tokens instead.\n+    # Only use naive assignment when num_tokens == 1 to avoid repeated reads\n+    # of shared expert weights when multiple tokens route to the same expert.\n+    # See https://github.com/vllm-project/vllm/issues/63943\n     naive_block_assignment = (\n         expert_map is None\n         and not weights_host_resident\n-        and num_tokens * top_k_num * 4 <= global_num_experts\n+        and num_tokens == 1\n         and not (\n             (use_int8_w8a16 or use_int4_w4a16)\n             and block_shape is not None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/23910de05fca96195c5826f01f8bf5d32f0256fa/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Ffused_moe.py",
      "sha": "11de8ba8c62a797bf7baf346b252e43b32cb2c27",
      "status": "modified"
    }
