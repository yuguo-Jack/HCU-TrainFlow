      "changes": 29,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Fserve%2Fexception_handling%2Ftest_error_sanitization.py?ref=cb3ef60e6979f16c840a23f111d7b88b41bdd01e",
      "deletions": 1,
      "filename": "tests/entrypoints/serve/exception_handling/test_error_sanitization.py",
      "patch": "@@ -9,6 +9,7 @@\n \"\"\"\n \n import pytest\n+from PIL import Image\n \n from vllm.entrypoints.serve.exception_handling.utils import sanitize_message\n \n@@ -82,7 +83,7 @@ class TestSanitizeMessageCoversLeakPatterns:\n             ),\n             (\n                 \"<PIL.PngImagePlugin.PngImageFile image mode=RGB \"\n-                \"size=8x8 at 0x7f3c1a2b4d90>\",\n+                \"size=8x8 at 0x7F3C1A2B4D90>\",\n                 \"<PIL.PngImagePlugin.PngImageFile image mode=RGB size=8x8>\",\n             ),\n             (\n@@ -109,6 +110,32 @@ def test_multiple_addresses_stripped(self):\n         result = sanitize_message(raw)\n         assert \"0x\" not in result\n \n+    def test_strips_address_from_live_pil_image_repr(self):\n+        \"\"\"Pillow formats id() as uppercase hex; use a real repr().\"\"\"\n+        kept: list[Image.Image] = []\n+        raw = None\n+        for _ in range(10_000):\n+            img = Image.new(\"RGB\", (1, 1))\n+            kept.append(img)\n+            candidate = repr(img)\n+            hex_part = candidate.rsplit(\" at 0x\", 1)[1].rstrip(\">\")\n+            if any(ch in hex_part for ch in \"ABCDEF\"):\n+                raw = candidate\n+                break\n+        assert raw is not None\n+        result = sanitize_message(raw)\n+        assert \"0x\" not in result\n+\n+    def test_strips_address_from_processor_failure_message(self):\n+        img = Image.new(\"RGB\", (8, 8))\n+        raw = (\n+            f\"Failed to apply FooProcessor on data={{'image': {img!r}}} \"\n+            \"with kwargs={}\"\n+        )\n+        result = sanitize_message(raw)\n+        assert \"0x\" not in result\n+        assert \"FooProcessor\" in result\n+\n \n class TestAffectedModulesUseSanitize:\n     \"\"\"Verify that affected modules call sanitize_message (source-level).\"\"\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cb3ef60e6979f16c840a23f111d7b88b41bdd01e/tests%2Fentrypoints%2Fserve%2Fexception_handling%2Ftest_error_sanitization.py",
      "sha": "8c165c44d594c8d9004690fc30c63b6895989188",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/cb3ef60e6979f16c840a23f111d7b88b41bdd01e/vllm%2Fentrypoints%2Fserve%2Fexception_handling%2Futils.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fentrypoints%2Fserve%2Fexception_handling%2Futils.py?ref=cb3ef60e6979f16c840a23f111d7b88b41bdd01e",
      "deletions": 1,
      "filename": "vllm/entrypoints/serve/exception_handling/utils.py",
      "patch": "@@ -6,7 +6,7 @@\n \n def sanitize_message(message: str) -> str:\n     \"\"\"Strip memory addresses, tracebacks, and file paths from error messages.\"\"\"\n-    message = re.sub(r\" at 0x[0-9a-f]+>\", \">\", message)\n+    message = re.sub(r\" at 0x[0-9a-fA-F]+>\", \">\", message)\n     message = re.sub(r'\\n?\\s*File \"[^\"]+\", line \\d+, in \\S+(\\n\\s+.*)?', \"\", message)\n     message = re.sub(\n         r\"/(?:home|usr|opt|var|tmp|root|lib|mnt|srv)(?:/[\\w.\\-]+)+\", \"<path>\", message",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cb3ef60e6979f16c840a23f111d7b88b41bdd01e/vllm%2Fentrypoints%2Fserve%2Fexception_handling%2Futils.py",
      "sha": "6c1dd205167c673ef5c5830551c9e8d20c1bafb2",
      "status": "modified"
    }
