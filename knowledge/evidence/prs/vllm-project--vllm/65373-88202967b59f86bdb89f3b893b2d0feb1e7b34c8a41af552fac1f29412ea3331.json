      "blob_url": "https://github.com/vllm-project/vllm/blob/1d160042449ba003186fb341ee711983e7a5b4c2/tests%2Fmodels%2Ftest_deepseek_v41_pcp.py",
      "changes": 34,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Ftest_deepseek_v41_pcp.py?ref=1d160042449ba003186fb341ee711983e7a5b4c2",
      "deletions": 0,
      "filename": "tests/models/test_deepseek_v41_pcp.py",
      "patch": "@@ -9,6 +9,7 @@\n \n from vllm.forward_context import ForwardContext, override_forward_context\n from vllm.models.deepseek_v41 import attention as attention_module\n+from vllm.models.deepseek_v41.compressor import CompressorStateCache\n from vllm.models.deepseek_v41.decoder_replay_layers import (\n     DecoderReplayLayers,\n     ReplayBatch,\n@@ -17,6 +18,39 @@\n from vllm.platforms import current_platform\n \n \n+@pytest.mark.parametrize(\n+    \"cache_cls\",\n+    [\n+        attention_module.DeepseekV4Attention,\n+        attention_module.DeepseekV4IndexerCache,\n+        CompressorStateCache,\n+    ],\n+)\n+def test_cache_specs_declare_tp_replication(cache_cls):\n+    cache_config = SimpleNamespace(block_size=64, cache_dtype=\"fp8_ds_mla\")\n+    state = SimpleNamespace(\n+        cache_config=cache_config,\n+        is_kv_source=True,\n+        kv_cache_dtype=\"fp8_ds_mla\",\n+        head_dim=512,\n+        kv_cache_torch_dtype=torch.uint8,\n+        dtype=torch.uint8,\n+        compress_ratio=2,\n+        kv_page_alignment=576,\n+        compressed_bytes_per_token=584,\n+        sparse_logits=True,\n+        rocm_mxfp4=False,\n+        block_size=8,\n+        state_dim=1024,\n+    )\n+    if cache_cls is CompressorStateCache:\n+        state.dtype = torch.float32\n+    spec = cache_cls.get_kv_cache_spec(\n+        state, SimpleNamespace(cache_config=cache_config)\n+    )\n+    assert spec.max_tp_shards == 1\n+\n+\n @pytest.mark.distributed(num_gpus=8)\n @pytest.mark.skipif(\n     not current_platform.is_cuda() or current_platform.device_count() < 8,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1d160042449ba003186fb341ee711983e7a5b4c2/tests%2Fmodels%2Ftest_deepseek_v41_pcp.py",
      "sha": "e65e845b272c8fbe5af11585773491c494e59279",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1d160042449ba003186fb341ee711983e7a5b4c2/vllm%2Fmodels%2Fdeepseek_v41%2Fattention.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Fdeepseek_v41%2Fattention.py?ref=1d160042449ba003186fb341ee711983e7a5b4c2",
      "deletions": 0,
      "filename": "vllm/models/deepseek_v41/attention.py",
      "patch": "@@ -1312,6 +1312,7 @@ def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec | None:\n         return MLAAttentionSpec(\n             block_size=vllm_config.cache_config.block_size,\n             num_kv_heads=1,\n+            max_tp_shards=1,\n             head_size=self.head_dim,\n             dtype=torch.uint8 if uses_fp8_ds_mla_layout else self.kv_cache_torch_dtype,\n             tokens_per_state=self.compress_ratio,\n@@ -1382,6 +1383,7 @@ def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec:\n         return MLAAttentionSpec(\n             block_size=self.cache_config.block_size,\n             num_kv_heads=1,\n+            max_tp_shards=1,\n             head_size=self.head_dim,\n             dtype=self.dtype,\n             tokens_per_state=self.compress_ratio,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1d160042449ba003186fb341ee711983e7a5b4c2/vllm%2Fmodels%2Fdeepseek_v41%2Fattention.py",
      "sha": "23d097a8e9d9f67b36b3014cdd734e5876ade1d6",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1d160042449ba003186fb341ee711983e7a5b4c2/vllm%2Fmodels%2Fdeepseek_v41%2Fcompressor.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Fdeepseek_v41%2Fcompressor.py?ref=1d160042449ba003186fb341ee711983e7a5b4c2",
      "deletions": 0,
