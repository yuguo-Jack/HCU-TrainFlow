      "patch": "@@ -260,6 +260,7 @@ def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec:\n         return CircularBufferSpec(\n             block_size=self.block_size,\n             num_kv_heads=1,\n+            max_tp_shards=1,\n             head_size=self.state_dim,\n             head_size_v=0,\n             dtype=self.dtype,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1d160042449ba003186fb341ee711983e7a5b4c2/vllm%2Fmodels%2Fdeepseek_v41%2Fcompressor.py",
