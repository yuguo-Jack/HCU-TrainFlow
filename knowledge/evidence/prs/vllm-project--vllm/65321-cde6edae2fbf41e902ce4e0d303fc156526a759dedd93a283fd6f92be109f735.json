      "additions": 16,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f38469f98a831767082078febafbbbb0a8598044/docs%2Ftraining%2Frouted_experts.md",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Ftraining%2Frouted_experts.md?ref=f38469f98a831767082078febafbbbb0a8598044",
      "deletions": 0,
      "filename": "docs/training/routed_experts.md",
      "patch": "@@ -23,6 +23,22 @@ Rejected at startup: adaptive speculative verification, PP > 1, DCP/PCP > 1, and\n \n Routing is stored by the aux output connector (`vllm/distributed/aux_output_connector/`, configured via `--aux-output-config`), keyed by KV block hash and shared with prefix caching, which is why prefix caching is required. `max_bytes` is its host-memory LRU capacity (default: derived from KV cache capacity). If a prefix-cache hit needs evicted rows, the worker raises `BlockObjectStoreError`; increase `max_bytes`.\n \n+### Backend row restoration\n+\n+A backend's `MoERunner` or `RoutedExpertsCaptureSource` can optionally implement\n+`restore_routed_experts_rows(topk_ids, ctx) -> Tensor`. During binding, the capturer\n+selects the first such module in `model.modules()` order and uses its callback\n+for every captured layer. Without a provider, the existing DP/TP recovery is used.\n+Existing capture sources need no changes.\n+\n+The callback must restore this DP rank's token-ordered logical expert IDs for all\n+captured layers, using the supplied `ForwardContext` rather than the provider's\n+layer-specific state. It must preserve the input, device, dtype and top-k width,\n+and keep collective participation consistent across ranks, including empty\n+ranks. Operations must support graph replay. Models requiring different per-layer\n+restorers cannot use this hook. Repeated layer IDs do not select a different\n+restorer; the existing buffer-write semantics are unchanged.\n+\n ## Output format\n \n | API | Field |",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f38469f98a831767082078febafbbbb0a8598044/docs%2Ftraining%2Frouted_experts.md",
      "sha": "a5a2350c333b92abab9930f342a1f859134bf860",
      "status": "modified"
    },
    {
      "additions": 78,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f38469f98a831767082078febafbbbb0a8598044/tests%2Fmodel_executor%2Ftest_routed_experts_capture.py",
      "changes": 79,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodel_executor%2Ftest_routed_experts_capture.py?ref=f38469f98a831767082078febafbbbb0a8598044",
      "deletions": 1,
      "filename": "tests/model_executor/test_routed_experts_capture.py",
      "patch": "@@ -7,14 +7,15 @@\n import pytest\n import torch\n \n-from vllm.config import CUDAGraphMode, VllmConfig\n+from vllm.config import CUDAGraphMode, DeviceConfig, ModelConfig, VllmConfig\n from vllm.config.compilation import CompilationMode\n from vllm.distributed.eplb.eplb_state import EplbLayerState\n from vllm.forward_context import (\n     BatchDescriptor,\n     DPMetadata,\n     ForwardContext,\n     get_forward_context,\n+    override_forward_context,\n     set_forward_context,\n )\n from vllm.model_executor.layers.fused_moe.config import RoutingMethodType\n@@ -64,6 +65,7 @@ def _capturer_with_buffer(\n     c = RoutedExpertsCapturer.__new__(RoutedExpertsCapturer)\n     c.dp_rank = dp_rank\n     c.tp_size = tp_size\n+    c.restore_rows = c._restore_local_topk_ids\n     c.output_dtype = torch.uint8\n     c.device_buffer = torch.full(\n         (max_tokens, num_layers, num_experts_per_tok),\n@@ -122,6 +124,29 @@ def _full_attention_kv_group(\n     )\n \n \n+class _CaptureSource(torch.nn.Module):\n+    def __init__(self, layer_id):\n+        super().__init__()\n+        self.layer_id = layer_id\n+        self.capture_fn = None\n+\n+    def forward(self, ids):\n+        assert self.capture_fn is not None\n+        self.capture_fn(ids)\n+\n+\n+class _CaptureRestorer(_CaptureSource):\n+    def __init__(self, layer_id):\n+        super().__init__(layer_id)\n+        self.restore_calls = 0\n+\n+    def restore_routed_experts_rows(self, ids, ctx):\n+        self.restore_calls += 1\n+        assert ctx.batch_descriptor is not None\n+        start = ctx.additional_kwargs[\"start\"]\n+        return ids[start : start + ctx.batch_descriptor.num_tokens]\n+\n+\n @pytest.mark.parametrize(\"eplb_enabled\", [False, True])\n def test_base_router_capture_pre_eplb_mapping(eplb_enabled):\n     eplb_state = None\n@@ -195,6 +220,58 @@ def __init__(self):\n     assert calls == [(3, topk_ids)]\n \n \n+@pytest.mark.parametrize(\"custom\", [False, True])\n+def test_capture_uses_one_model_wide_restorer(custom, tmp_path, monkeypatch):\n+    from transformers import MixtralConfig\n+\n+    from vllm.platforms.cpu import CpuPlatform\n+\n+    MixtralConfig(\n+        architectures=[\"MixtralForCausalLM\"],\n+        num_hidden_layers=4,\n+        num_local_experts=16,\n+        num_experts_per_tok=2,\n+    ).save_pretrained(tmp_path)\n+    config = VllmConfig(\n+        model_config=ModelConfig(\n+            model=str(tmp_path),\n+            dtype=\"float32\",\n+            max_model_len=32,\n+            enforce_eager=True,\n+            skip_tokenizer_init=True,\n+        ),\n+        device_config=DeviceConfig(device=\"cpu\"),\n+    )\n+    monkeypatch.setattr(f\"{_REC_MODULE}.current_platform\", CpuPlatform())\n+    capturer = RoutedExpertsCapturer(8, config)\n+    provider = _CaptureRestorer if custom else _CaptureSource\n+    model = torch.nn.ModuleList([_CaptureSource(0), provider(2), provider(2)])\n+    bind_routed_experts_capturer(model, capturer)\n+\n+    for start, rows in ((1, 2), (2, 1), (0, 0)):\n+        capturer.device_buffer.fill_(-1)\n+        expected = torch.full_like(capturer.device_buffer, -1)\n+        ctx = _forward_context(\n+            batch_descriptor=BatchDescriptor(num_tokens=rows),\n+            additional_kwargs={\"start\": start},\n+        )\n+        with override_forward_context(ctx):\n+            for i, source in enumerate(model):\n+                ids = torch.arange(12, dtype=torch.int32).reshape(6, 2) + i\n+                if not custom:\n+                    ids = ids[:rows]\n+                original = ids.clone()\n+                source(ids)\n+                expected[:rows, source.layer_id] = (\n+                    original[start : start + rows] if custom else original\n+                )\n+                torch.testing.assert_close(ids, original)\n+                torch.testing.assert_close(capturer.device_buffer, expected)\n+    if custom:\n+        assert model[1].restore_calls == 9\n+        assert model[2].restore_calls == 0\n+\n+\n _SINK_CONFIG = SimpleNamespace(\n     use_ep=False,\n     dp_size=1,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f38469f98a831767082078febafbbbb0a8598044/tests%2Fmodel_executor%2Ftest_routed_experts_capture.py",
      "sha": "99638c3142b57f7615ec4d63fb05748247392f8d",
      "status": "modified"
