    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f38469f98a831767082078febafbbbb0a8598044/tests%2Fv1%2Fworker%2Ftest_gpu_ubatch_slicing.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fworker%2Ftest_gpu_ubatch_slicing.py?ref=f38469f98a831767082078febafbbbb0a8598044",
      "deletions": 0,
      "filename": "tests/v1/worker/test_gpu_ubatch_slicing.py",
      "patch": "@@ -624,6 +624,7 @@ def _make_capturer(num_tokens: int, device: torch.device) -> RoutedExpertsCaptur\n     capturer = RoutedExpertsCapturer.__new__(RoutedExpertsCapturer)\n     capturer.dp_rank = 0\n     capturer.tp_size = 1\n+    capturer.restore_rows = capturer._restore_local_topk_ids\n     capturer.device_buffer = torch.full(\n         (num_tokens, 1, 1), -1, dtype=torch.int32, device=device\n     )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f38469f98a831767082078febafbbbb0a8598044/tests%2Fv1%2Fworker%2Ftest_gpu_ubatch_slicing.py",
      "sha": "99d5f80b3bac30772b6739cde0626c5c78bcbd08",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f38469f98a831767082078febafbbbb0a8598044/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Frouted_experts_capturer.py",
      "changes": 28,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Frouted_experts_capturer.py?ref=f38469f98a831767082078febafbbbb0a8598044",
      "deletions": 3,
      "filename": "vllm/model_executor/layers/fused_moe/routed_experts_capturer.py",
      "patch": "@@ -28,6 +28,21 @@ class RoutedExpertsCaptureSource(Protocol):\n     capture_fn: Callable[[torch.Tensor], None] | None\n \n \n+@runtime_checkable\n+class RoutedExpertsRowRestorer(Protocol):\n+    def restore_routed_experts_rows(\n+        self, topk_ids: torch.Tensor, ctx: ForwardContext\n+    ) -> torch.Tensor:\n+        \"\"\"Restore local token-ordered logical IDs for all captured MoE layers.\n+\n+        Binding selects the first provider. Read current metadata from ``ctx``;\n+        do not depend on the provider's layer-specific state or modify input.\n+        Return a 2-D tensor with the input device, dtype and top-k width.\n+        Collectives must be rank-consistent and graph-replay safe.\n+        \"\"\"\n+        ...\n+\n+\n def _get_routed_experts_shape(vllm_config: VllmConfig) -> tuple[int, int, int]:\n     model_config = vllm_config.model_config\n     num_layers = model_config.get_total_num_hidden_layers()\n@@ -84,6 +99,9 @@ def __init__(\n         )\n         self.dp_rank = vllm_config.parallel_config.data_parallel_rank\n         self.tp_size = vllm_config.parallel_config.tensor_parallel_size\n+        self.restore_rows: Callable[[torch.Tensor, ForwardContext], torch.Tensor] = (\n+            self._restore_local_topk_ids\n+        )\n \n     def capture(self, layer_id: int, topk_ids: torch.Tensor) -> None:\n         if not 0 <= layer_id < self.device_buffer.shape[1]:\n@@ -93,7 +111,7 @@ def capture(self, layer_id: int, topk_ids: torch.Tensor) -> None:\n             )\n \n         ctx = get_forward_context()\n-        local_topk_ids = self._restore_local_topk_ids(topk_ids, ctx)\n+        local_topk_ids = self.restore_rows(topk_ids, ctx)\n         offset = dbo_current_ubatch_token_offset()\n         self.device_buffer[offset : offset + len(local_topk_ids), layer_id] = (\n             local_topk_ids\n@@ -192,13 +210,17 @@ def bind_routed_experts_capturer(\n     from vllm.model_executor.layers.fused_moe.router.base_router import BaseRouter\n \n     num_bound = 0\n+    restorer_bound = False\n     for module in model.modules():\n+        if not isinstance(module, (MoERunner, RoutedExpertsCaptureSource)):\n+            continue\n+        if not restorer_bound and isinstance(module, RoutedExpertsRowRestorer):\n+            capturer.restore_rows = module.restore_routed_experts_rows\n+            restorer_bound = True\n         if isinstance(module, RoutedExpertsCaptureSource):\n             module.capture_fn = partial(capturer.capture, module.layer_id)\n             num_bound += 1\n             continue\n-        if not isinstance(module, MoERunner):\n-            continue\n         capture_fn = partial(capturer.capture, module.layer_id)\n         quant_method = module._quant_method\n         if quant_method.is_monolithic:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f38469f98a831767082078febafbbbb0a8598044/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Frouted_experts_capturer.py",
