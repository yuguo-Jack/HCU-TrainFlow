      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Fmamba%2Fgdn%2Fqwen_gdn_linear_attn.py?ref=8e27491010d37c804c71d67bc2394f4bdc1e13aa",
