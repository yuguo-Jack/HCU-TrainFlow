    {
      "additions": 31,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8e27491010d37c804c71d67bc2394f4bdc1e13aa/tests%2Fkernels%2Fmamba%2Ftest_gdn_input_mutation.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fmamba%2Ftest_gdn_input_mutation.py?ref=8e27491010d37c804c71d67bc2394f4bdc1e13aa",
      "deletions": 0,
      "filename": "tests/kernels/mamba/test_gdn_input_mutation.py",
      "patch": "@@ -0,0 +1,31 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"GDN input mutations must survive graph export and functionalization.\"\"\"\n+\n+import pytest\n+import torch\n+\n+# Register the real GDN custom ops; export uses their registered fake kernels.\n+import vllm.model_executor.layers.mamba.gdn.qwen_gdn_linear_attn  # noqa: F401\n+\n+\n+class GDNExport(torch.nn.Module):\n+    def __init__(self, packed: bool):\n+        super().__init__()\n+        self.packed = packed\n+\n+    def forward(self, qkv, b, a, out):\n+        if self.packed:\n+            torch.ops.vllm.qwen_gdn_attention_core_fused_norm_packed(\n+                qkv, b, out, \"layers.0\"\n+            )\n+        else:\n+            torch.ops.vllm.qwen_gdn_attention_core(qkv, b, a, out, \"layers.0\")\n+        return qkv + 1, out + 1\n+\n+\n+@pytest.mark.parametrize(\"packed\", [False, True])\n+def test_export_preserves_qkv_mutation(packed):\n+    inputs = tuple(torch.zeros(2, 4) for _ in range(4))\n+    exported = torch.export.export(GDNExport(packed), inputs).run_decompositions()\n+    assert \"qkv\" in exported.graph_signature.user_inputs_to_mutate.values()",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8e27491010d37c804c71d67bc2394f4bdc1e13aa/tests%2Fkernels%2Fmamba%2Ftest_gdn_input_mutation.py",
      "sha": "becd9b8d8a1638b0191bc1e373844ea0891816ad",
      "status": "added"
    },
