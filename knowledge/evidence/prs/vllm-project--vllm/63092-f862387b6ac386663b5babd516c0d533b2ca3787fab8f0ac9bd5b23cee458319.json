      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8e27491010d37c804c71d67bc2394f4bdc1e13aa/vllm%2Fmodel_executor%2Flayers%2Fmamba%2Fgdn%2Fqwen_gdn_linear_attn.py",
