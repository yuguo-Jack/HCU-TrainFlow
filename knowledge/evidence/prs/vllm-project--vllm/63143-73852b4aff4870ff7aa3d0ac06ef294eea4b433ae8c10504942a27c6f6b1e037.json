      "deletions": 3,
      "filename": "tests/v1/attention/test_attention_backends.py",
      "patch": "@@ -1716,16 +1716,16 @@ def causal_mask_mod(\n \n @pytest.mark.skipif(\n     AttentionBackendEnum.FLASHINFER not in BACKENDS_TO_TEST\n-    or not any(current_platform.is_device_capability_family(f) for f in (80, 120)),\n-    reason=\"FlashInfer decodes an NVFP4 cache with XQA on SM12x and fa2 on SM8x.\",\n+    or not any(current_platform.is_device_capability_family(f) for f in (80, 90, 120)),\n+    reason=\"FlashInfer decodes an NVFP4 cache with XQA on SM12x and fa2 on SM8x/SM90.\",\n )\n @pytest.mark.parametrize(\"use_cuda_graph\", [False, True])\n @pytest.mark.parametrize(\"q_len\", [1, 4])\n def test_flashinfer_nvfp4_decode_correctness(\n     default_vllm_config, q_len, use_cuda_graph\n ):\n     \"\"\"Single-token and spec-decode queries over an NVFP4 cache decode with\n-    XQA on SM12x and fa2 on SM8x, eager and replayed, and match the fa2\n+    XQA on SM12x and fa2 on SM8x/SM90, eager and replayed, and match the fa2\n     prefill that wrote the cache.\"\"\"\n     import unittest.mock\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d1dd00d0e3ad11d7d7b4b4382a1bf4eac65242f4/tests%2Fv1%2Fattention%2Ftest_attention_backends.py",
      "sha": "cdfa61d7155e7233c10df0fa21129d4ea2087179",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d1dd00d0e3ad11d7d7b4b4382a1bf4eac65242f4/vllm%2Fv1%2Fattention%2Fbackends%2Fflashinfer.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Fflashinfer.py?ref=d1dd00d0e3ad11d7d7b4b4382a1bf4eac65242f4",
      "deletions": 5,
      "filename": "vllm/v1/attention/backends/flashinfer.py",
      "patch": "@@ -111,9 +111,12 @@ def _nvfp4_kv_on_fa2() -> bool:\n     return any(current_platform.is_device_capability_family(f) for f in (80, 90, 120))\n \n \n-def _use_fa2_native_decode() -> bool:\n-    # Below SM90, native decode runs fa2, which takes uniform multi-token queries.\n-    return not current_platform.has_device_capability(90)\n+def _use_fa2_native_decode(is_nvfp4: bool = False) -> bool:\n+    # Below SM90, and on SM90 for an NVFP4 cache, native decode runs fa2, which\n+    # takes uniform multi-token queries.\n+    return not current_platform.has_device_capability(90) or (\n+        is_nvfp4 and current_platform.is_device_capability(90)\n+    )\n \n \n _KVPair = tuple[torch.Tensor, torch.Tensor]\n@@ -1026,7 +1029,7 @@ def __init__(\n             == FlashInferDecodeKernel.TRTLLM_GEN\n             and not self.use_dcp\n         )\n-        self.use_fa2_native_decode = _use_fa2_native_decode()\n+        self.use_fa2_native_decode = _use_fa2_native_decode(self.is_kvcache_nvfp4)\n         self._init_reorder_batch_threshold(\n             1,\n             supports_spec_as_decode=(\n@@ -1160,7 +1163,11 @@ def get_cudagraph_support(\n             return AttentionCGSupport.UNIFORM_SINGLE_TOKEN_DECODE\n \n         kv_specs = iter_layer_specs(kv_cache_spec)\n-        if _use_fa2_native_decode():\n+        if all(\n+            _use_fa2_native_decode(spec.kv_quant_mode.is_nvfp4)\n+            for spec in kv_specs\n+            if isinstance(spec, AttentionSpec)\n+        ):\n             # fa2 decodes uniform causal spec queries.\n             if kv_specs and not vllm_config.attention_config.use_non_causal:\n                 return AttentionCGSupport.UNIFORM_BATCH",
