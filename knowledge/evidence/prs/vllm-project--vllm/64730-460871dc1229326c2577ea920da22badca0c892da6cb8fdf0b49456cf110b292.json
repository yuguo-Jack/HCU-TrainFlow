  "files": [
    {
      "additions": 43,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4eeca134a28665fabd72fdc30ec9b8532c50b8e1/tests%2Ftransformers_utils%2Ftest_config.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftransformers_utils%2Ftest_config.py?ref=4eeca134a28665fabd72fdc30ec9b8532c50b8e1",
      "deletions": 0,
      "filename": "tests/transformers_utils/test_config.py",
      "patch": "@@ -18,6 +18,7 @@\n from vllm.tokenizers import get_tokenizer\n from vllm.transformers_utils import config as config_module\n from vllm.transformers_utils.config import (\n+    checkpoint_has_lm_head,\n     get_safetensors_params_metadata,\n     mrope_num_dims,\n     patch_legacy_rope_type,\n@@ -323,3 +324,45 @@ def test_mrope_num_dims_from_nested_rope_parameters():\n \n def test_mrope_num_dims_without_mrope():\n     assert mrope_num_dims(PreTrainedConfig()) == 0\n+\n+\n+def test_checkpoint_has_lm_head_pytorch_bin(tmp_path):\n+    import torch\n+\n+    checkpoint_has_lm_head.cache_clear()\n+\n+    # Case 1: Sharded PyTorch index with lm_head\n+    sharded_dir = tmp_path / \"sharded\"\n+    sharded_dir.mkdir()\n+    (sharded_dir / \"pytorch_model.bin.index.json\").write_text(\n+        json.dumps({\"weight_map\": {\"lm_head.weight\": \"model-00001.bin\"}})\n+    )\n+    assert checkpoint_has_lm_head(str(sharded_dir)) is True\n+\n+    # Case 2: Sharded PyTorch index without lm_head\n+    sharded_no_head_dir = tmp_path / \"sharded_no_head\"\n+    sharded_no_head_dir.mkdir()\n+    (sharded_no_head_dir / \"pytorch_model.bin.index.json\").write_text(\n+        json.dumps({\"weight_map\": {\"model.embed_tokens.weight\": \"model-00001.bin\"}})\n+    )\n+    assert checkpoint_has_lm_head(str(sharded_no_head_dir)) is False\n+\n+    # Case 3: Single .bin file with lm_head\n+    single_dir = tmp_path / \"single\"\n+    single_dir.mkdir()\n+    torch.save({\"lm_head.weight\": torch.ones(2, 2)}, single_dir / \"pytorch_model.bin\")\n+    assert checkpoint_has_lm_head(str(single_dir)) is True\n+\n+    # Case 4: Single .bin file without lm_head\n+    single_no_head_dir = tmp_path / \"single_no_head\"\n+    single_no_head_dir.mkdir()\n+    torch.save(\n+        {\"model.embed_tokens.weight\": torch.ones(2, 2)},\n+        single_no_head_dir / \"pytorch_model.bin\",\n+    )\n+    assert checkpoint_has_lm_head(str(single_no_head_dir)) is False\n+\n+    # Case 5: Empty directory -> returns None\n+    empty_dir = tmp_path / \"empty\"\n+    empty_dir.mkdir()\n+    assert checkpoint_has_lm_head(str(empty_dir)) is None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4eeca134a28665fabd72fdc30ec9b8532c50b8e1/tests%2Ftransformers_utils%2Ftest_config.py",
      "sha": "c3298b9ef6f83d254f4458dd296373a80f6738a0",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4eeca134a28665fabd72fdc30ec9b8532c50b8e1/vllm%2Ftransformers_utils%2Fconfig.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftransformers_utils%2Fconfig.py?ref=4eeca134a28665fabd72fdc30ec9b8532c50b8e1",
      "deletions": 4,
      "filename": "vllm/transformers_utils/config.py",
      "patch": "@@ -1546,13 +1546,28 @@ def checkpoint_has_lm_head(model: str, *, revision: str | None = None) -> bool |\n \n     Returns:\n         `None` if the checkpoint contents could not be determined, for example\n-        because it is not stored as safetensors.\n+        because it is not stored as safetensors or PyTorch bin.\n \n     \"\"\"\n     metadata = get_safetensors_params_metadata(model, revision=revision)\n-    if not metadata:\n-        return None\n-    return any(name.endswith(\"lm_head.weight\") for name in metadata)\n+    if metadata:\n+        return any(name.endswith(\"lm_head.weight\") for name in metadata)\n+\n+    index_dict = get_hf_file_to_dict(\n+        \"pytorch_model.bin.index.json\", model, revision=revision\n+    )\n+    if index_dict is not None and \"weight_map\" in index_dict:\n+        return any(name.endswith(\"lm_head.weight\") for name in index_dict[\"weight_map\"])\n+\n+    bin_file = try_get_local_file(model, \"pytorch_model.bin\", revision=revision)\n+    if isinstance(bin_file, (Path, str)) and Path(bin_file).is_file():\n+        try:\n+            state_dict = torch.load(bin_file, map_location=\"meta\", weights_only=True)\n+            return any(name.endswith(\"lm_head.weight\") for name in state_dict)\n+        except Exception as e:\n+            logger.debug(\"Could not read state dict keys from %s: %s\", bin_file, e)\n+\n+    return None\n \n \n def _download_mistral_config_file(model, revision) -> dict:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4eeca134a28665fabd72fdc30ec9b8532c50b8e1/vllm%2Ftransformers_utils%2Fconfig.py",
      "sha": "4caae79f1a5c5d3b6cf296caa7524133ccb2a2d1",
      "status": "modified"
    }
