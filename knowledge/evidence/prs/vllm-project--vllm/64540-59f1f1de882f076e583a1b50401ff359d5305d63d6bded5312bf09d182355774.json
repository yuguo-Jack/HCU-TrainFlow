      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/149b57945ae0926b8cd9f455215181a7c1b57d76/tests%2Futils_%2Ftest_cpu_resource_utils.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Futils_%2Ftest_cpu_resource_utils.py?ref=149b57945ae0926b8cd9f455215181a7c1b57d76",
      "deletions": 0,
      "filename": "tests/utils_/test_cpu_resource_utils.py",
      "patch": "@@ -223,6 +223,16 @@ def test_visible_memory_node_assigned_ids_are_limited_to_allowed_nodes(\n     assert cru.get_visible_memory_node([1, 4]) == [1]\n \n \n+def test_visible_memory_node_falls_back_when_device_ids_are_not_numa_nodes(\n+    monkeypatch,\n+):\n+    \"\"\"DP×TP device ranks past the last NUMA node must not yield an empty list.\"\"\"\n+    monkeypatch.setattr(cru, \"get_memory_affinity\", lambda: [0, 1])\n+    monkeypatch.delenv(\"VLLM_CPU_SIM_MULTI_NUMA\", raising=False)\n+    monkeypatch.delenv(cru.DEVICE_CONTROL_ENV_VAR, raising=False)\n+    assert cru.get_visible_memory_node([2, 3]) == [0, 1]\n+\n+\n def test_visible_memory_node_sim_multi_numa_ignores_assigned_ids(\n     six_numa_nodes, monkeypatch\n ):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/149b57945ae0926b8cd9f455215181a7c1b57d76/tests%2Futils_%2Ftest_cpu_resource_utils.py",
      "sha": "16db9075088df36abe8be40bdfa17cb384240dd0",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/149b57945ae0926b8cd9f455215181a7c1b57d76/vllm%2Futils%2Fcpu_resource_utils.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Futils%2Fcpu_resource_utils.py?ref=149b57945ae0926b8cd9f455215181a7c1b57d76",
      "deletions": 1,
      "filename": "vllm/utils/cpu_resource_utils.py",
      "patch": "@@ -265,7 +265,14 @@ def get_visible_memory_node(assigned_node_ids: list[int] | None = None) -> list[\n         return allowed_memory_node_list\n \n     if assigned_node_ids is not None:\n-        return [node for node in assigned_node_ids if node in allowed_memory_node_list]\n+        # DP×TP on CPU hands out device ranks (for example [2, 3] on DP rank 1\n+        # with TP=2). Those are not NUMA node ids. Dropping every id leaves an\n+        # empty list and CPUWorker then indexes [0].\n+        assigned_nodes = [\n+            node for node in assigned_node_ids if node in allowed_memory_node_list\n+        ]\n+        if assigned_nodes:\n+            return assigned_nodes\n \n     env_key = DEVICE_CONTROL_ENV_VAR\n     if env_key in os.environ and os.environ[env_key] != \"\":",
      "raw_url": "https://github.com/vllm-project/vllm/raw/149b57945ae0926b8cd9f455215181a7c1b57d76/vllm%2Futils%2Fcpu_resource_utils.py",
      "sha": "2be2dd060941b3b4ec84868a1918b42ea05828c2",
      "status": "modified"
    }
