      "deletions": 1,
      "filename": "vllm/transformers_utils/processors/kimi_k25_vision_fused.py",
      "patch": "@@ -155,7 +155,10 @@ def _to_pil(data: Any) -> Image.Image:\n         if data.startswith(\"data:\"):\n             raw_base64 = data.split(\",\", 1)[1]\n             return open_image(io.BytesIO(base64.b64decode(raw_base64))).convert(\"RGB\")\n-        return open_image(data).convert(\"RGB\")\n+        raise ValueError(\n+            \"Local image paths and URLs must be resolved by \"\n+            \"MediaConnector before they reach the processor.\"\n+        )\n     if isinstance(data, bytes):\n         return open_image(io.BytesIO(data)).convert(\"RGB\")\n     raise ValueError(f\"Unsupported data type: {type(data)}\")",
      "raw_url": "https://github.com/vllm-project/vllm/raw/990b66632f00c010bdd0617b64936057c8b7f8c1/vllm%2Ftransformers_utils%2Fprocessors%2Fkimi_k25_vision_fused.py",
