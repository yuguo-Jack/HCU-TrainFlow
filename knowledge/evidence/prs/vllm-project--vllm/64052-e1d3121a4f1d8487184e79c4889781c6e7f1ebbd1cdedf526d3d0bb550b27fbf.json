    {
      "additions": 21,
      "blob_url": "https://github.com/vllm-project/vllm/blob/61fd6312417f9fcc6b1b0346c51413c33fb5a688/tests%2Ftest_config.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_config.py?ref=61fd6312417f9fcc6b1b0346c51413c33fb5a688",
      "deletions": 0,
      "filename": "tests/test_config.py",
      "patch": "@@ -2977,6 +2977,27 @@ def test_s3_url_different_model_and_tokenizer(mock_pull_files):\n     assert mock_pull_files.call_args_list[1][0][0] == tokenizer_url\n \n \n+@patch(\"vllm.transformers_utils.runai_utils.ObjectStorageModel.pull_files\")\n+def test_s3_url_same_uri_pulls_files_once(mock_pull_files):\n+    \"\"\"Test that when the tokenizer URI equals the model URI, the files are\n+    pulled from object storage in a single pass (the weight-ignore pull is a\n+    superset of the config-only allow-pattern pull).\"\"\"\n+    s3_url = \"s3://example-bucket-1/model/\"\n+    config = MockConfig(model=s3_url, tokenizer=s3_url)\n+    ModelConfig.maybe_pull_model_tokenizer_for_runai(config, s3_url, s3_url)\n+\n+    assert mock_pull_files.call_count == 1, (\n+        f\"Expected a single pull_files call for identical model/tokenizer \"\n+        f\"URIs, got {mock_pull_files.call_count}\"\n+    )\n+    # The surviving pull must be the ignore-pattern (superset) variant\n+    assert mock_pull_files.call_args[1].get(\"ignore_pattern\") is not None\n+\n+    assert os.path.exists(config.model) and os.path.isdir(config.model)\n+    assert os.path.exists(config.tokenizer) and os.path.isdir(config.tokenizer)\n+    assert config.model == config.tokenizer\n+\n+\n @pytest.mark.parametrize(\n     (\"model_id\", \"expected_attn_type\", \"expected_result\", \"reason\"),\n     [",
      "raw_url": "https://github.com/vllm-project/vllm/raw/61fd6312417f9fcc6b1b0346c51413c33fb5a688/tests%2Ftest_config.py",
      "sha": "d846d9ca454d00838ca4cee8b87abedb24cd3e39",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/vllm-project/vllm/blob/61fd6312417f9fcc6b1b0346c51413c33fb5a688/vllm%2Fconfig%2Fmodel.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fconfig%2Fmodel.py?ref=61fd6312417f9fcc6b1b0346c51413c33fb5a688",
      "deletions": 6,
      "filename": "vllm/config/model.py",
      "patch": "@@ -1226,13 +1226,11 @@ def maybe_pull_model_tokenizer_for_runai(self, model: str, tokenizer: str) -> No\n \n         if is_runai_obj_uri(model):\n             object_storage_model = ObjectStorageModel(url=model)\n-            object_storage_model.pull_files(\n-                model, allow_pattern=[\"*.model\", \"*.py\", \"*.json\"]\n-            )\n-            self.model_weights = model\n-            self.model = object_storage_model.dir\n \n-            # If tokenizer is same as model, download to same directory\n+            # When the tokenizer URI is the same as the model URI, a single\n+            # pull with the weight-ignore pattern already downloads a\n+            # superset of the config-only allow-pattern pull, so skip the\n+            # redundant second pass over the same bucket.\n             if model == tokenizer:\n                 object_storage_model.pull_files(\n                     model,\n@@ -1244,9 +1242,17 @@ def maybe_pull_model_tokenizer_for_runai(self, model: str, tokenizer: str) -> No\n                         \"*.pth\",\n                     ],\n                 )\n+                self.model_weights = model\n+                self.model = object_storage_model.dir\n                 self.tokenizer = object_storage_model.dir\n                 return\n \n+            object_storage_model.pull_files(\n+                model, allow_pattern=[\"*.model\", \"*.py\", \"*.json\"]\n+            )\n+            self.model_weights = model\n+            self.model = object_storage_model.dir\n+\n         # Only download tokenizer if needed and not already handled\n         if is_runai_obj_uri(tokenizer):\n             object_storage_tokenizer = ObjectStorageModel(url=tokenizer)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/61fd6312417f9fcc6b1b0346c51413c33fb5a688/vllm%2Fconfig%2Fmodel.py",
      "sha": "531df208d43475b35b7f76aabafe83ae8358e37a",
      "status": "modified"
    }
