      "blob_url": "https://github.com/vllm-project/vllm/blob/a06bea8690118d7ec07b57002b52b563b58ce2b0/tests%2Fbenchmarks%2Ftest_serve_result_serialization.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fbenchmarks%2Ftest_serve_result_serialization.py?ref=a06bea8690118d7ec07b57002b52b563b58ce2b0",
      "deletions": 0,
      "filename": "tests/benchmarks/test_serve_result_serialization.py",
      "patch": "@@ -0,0 +1,35 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import argparse\n+from unittest.mock import patch\n+\n+from vllm.benchmarks.serve import save_to_pytorch_benchmark_format\n+\n+\n+def test_pooling_e2el_is_tracked_without_per_request_arrays() -> None:\n+    results = {\n+        \"mean_e2el_ms\": 12.0,\n+        \"median_e2el_ms\": 11.0,\n+        \"std_e2el_ms\": 2.0,\n+        \"p99_e2el_ms\": 16.0,\n+        \"failed\": 2,\n+        \"latencies\": [0.01, 0.02],\n+        \"queue_times\": [0.001, 0.002],\n+    }\n+    args = argparse.Namespace(model=\"test-model\")\n+\n+    with (\n+        patch(\"vllm.benchmarks.serve.convert_to_pytorch_benchmark_format\") as convert,\n+        patch(\"vllm.benchmarks.serve.write_to_json\"),\n+    ):\n+        convert.return_value = [{\"benchmark\": {}}]\n+        save_to_pytorch_benchmark_format(args, results, \"result.json\")\n+\n+    assert convert.call_args.kwargs[\"metrics\"] == {\n+        \"median_e2el_ms\": [11.0],\n+        \"mean_e2el_ms\": [12.0],\n+        \"std_e2el_ms\": [2.0],\n+        \"p99_e2el_ms\": [16.0],\n+    }\n+    assert convert.call_args.kwargs[\"extra_info\"] == {\"failed\": 2}",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a06bea8690118d7ec07b57002b52b563b58ce2b0/tests%2Fbenchmarks%2Ftest_serve_result_serialization.py",
      "sha": "5fad67869f9127e2e389fca507f27cf2303ddda4",
      "status": "added"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/a06bea8690118d7ec07b57002b52b563b58ce2b0/tests%2Fbenchmarks%2Ftest_skip_tokenizer_init.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fbenchmarks%2Ftest_skip_tokenizer_init.py?ref=a06bea8690118d7ec07b57002b52b563b58ce2b0",
      "deletions": 1,
      "filename": "tests/benchmarks/test_skip_tokenizer_init.py",
      "patch": "@@ -152,6 +152,8 @@ def test_main_async_skip_tokenizer_init_does_not_raise(tmp_path: Path) -> None:\n         \"output_lens\": [],\n         \"ttfts\": [],\n         \"itls\": [],\n+        \"latencies\": [0.25],\n+        \"queue_times\": [0.05],\n         \"generated_texts\": [],\n         \"errors\": [],\n         \"duration\": 1.0,\n@@ -160,4 +162,8 @@ def test_main_async_skip_tokenizer_init_does_not_raise(tmp_path: Path) -> None:\n         serve_module, \"benchmark\", new=AsyncMock(return_value=mock_result)\n     ):\n         # Must NOT raise AssertionError\n-        asyncio.run(serve_module.main_async(args))\n+        result = asyncio.run(serve_module.main_async(args))\n+\n+    assert result[\"num_warmups\"] == 0\n+    assert \"latencies\" not in result\n+    assert \"queue_times\" not in result",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a06bea8690118d7ec07b57002b52b563b58ce2b0/tests%2Fbenchmarks%2Ftest_skip_tokenizer_init.py",
      "sha": "d777b76cdc67aea20da62c5de6c11e6f60ffa6a6",
