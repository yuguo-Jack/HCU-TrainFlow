  "files": [
    {
      "additions": 22,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c8a50938fef73e4f145a1eb08b002258393f35fb/tests%2Freasoning%2Ftest_gemma4_reasoning_parser.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Freasoning%2Ftest_gemma4_reasoning_parser.py?ref=c8a50938fef73e4f145a1eb08b002258393f35fb",
      "deletions": 2,
      "filename": "tests/reasoning/test_gemma4_reasoning_parser.py",
      "patch": "@@ -86,14 +86,18 @@ def generic_tokenizer():\n     \"content\": None,\n     \"is_reasoning_end\": True,\n }\n+# Non-streaming parsing sees the complete output and can reattribute text\n+# before an explicit reasoning opener. Streaming parsing cannot retroactively\n+# retract a prefix that was already emitted as content.\n NEW_LINE_NONSTREAMING = {\n     \"output\": (\n         \"Before\\n<|channel>This is a reasoning section<channel|>\\nThis is the rest\"\n     ),\n-    \"reasoning\": \"This is a reasoning section\",\n-    \"content\": \"Before\\n\\nThis is the rest\",\n+    \"reasoning\": \"Before\\nThis is a reasoning section\",\n+    \"content\": \"\\nThis is the rest\",\n     \"is_reasoning_end\": True,\n }\n+\n NEW_LINE_STREAMING = {\n     \"output\": (\n         \"Before\\n<|channel>This is a reasoning section<channel|>\\nThis is the rest\"\n@@ -103,6 +107,17 @@ def generic_tokenizer():\n     \"is_reasoning_end\": True,\n }\n \n+PREAMBLE_BEFORE_REASONING_NONSTREAMING = {\n+    \"output\": (\n+        \"---\\n\"\n+        \"<|channel>thought\\nActual reasoning here\"\n+        '<channel|>{\"ok\": true}'\n+    ),\n+    \"reasoning\": \"---\\nActual reasoning here\",\n+    \"content\": '{\"ok\": true}',\n+    \"is_reasoning_end\": True,\n+}\n+\n THOUGHT_PREFIX = {\n     \"output\": \"<|channel>thought\\nActual reasoning here<channel|>Final answer\",\n     \"reasoning\": \"Actual reasoning here\",\n@@ -156,6 +171,11 @@ def generic_tokenizer():\n     pytest.param(False, EMPTY, id=\"empty\"),\n     pytest.param(False, NEW_LINE_NONSTREAMING, id=\"new_line\"),\n     pytest.param(True, NEW_LINE_STREAMING, id=\"new_line_streaming\"),\n+    pytest.param(\n+        False,\n+        PREAMBLE_BEFORE_REASONING_NONSTREAMING,\n+        id=\"preamble_before_reasoning\",\n+    ),\n     pytest.param(False, THOUGHT_PREFIX, id=\"thought_prefix\"),\n     pytest.param(True, THOUGHT_PREFIX, id=\"thought_prefix_streaming\"),\n     pytest.param(False, THOUGHT_PREFIX_ONLY, id=\"thought_prefix_only\"),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c8a50938fef73e4f145a1eb08b002258393f35fb/tests%2Freasoning%2Ftest_gemma4_reasoning_parser.py",
      "sha": "dfbdc7600d434ff281b27d5170e79236d59e3030",
      "status": "modified"
    },
    {
      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c8a50938fef73e4f145a1eb08b002258393f35fb/vllm%2Fparser%2Fgemma4.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fparser%2Fgemma4.py?ref=c8a50938fef73e4f145a1eb08b002258393f35fb",
      "deletions": 0,
      "filename": "vllm/parser/gemma4.py",
      "patch": "@@ -574,10 +574,23 @@ def extract_reasoning(\n         model_output: str,\n         request: ChatCompletionRequest | ResponsesRequest,\n     ) -> tuple[str | None, str | None]:\n+        # In non-streaming mode, an explicit reasoning opener lets us\n+        # identify preceding text as a reasoning preamble. Outputs without\n+        # an opener remain plain content.\n+        reasoning_start = model_output.find(CHANNEL_START)\n+        preamble = \"\"\n+        if reasoning_start > 0:\n+            preamble = model_output[:reasoning_start]\n+            model_output = model_output[reasoning_start:]\n+\n         reasoning, content = super().extract_reasoning(model_output, request)\n         if reasoning:\n             if reasoning.startswith(_GEMMA4_THOUGHT_PREFIX):\n                 reasoning = reasoning[len(_GEMMA4_THOUGHT_PREFIX) :]\n             elif reasoning == _GEMMA4_THOUGHT_PREFIX.rstrip():\n                 reasoning = None\n+\n+        if preamble:\n+            reasoning = preamble + (reasoning or \"\")\n+\n         return reasoning or None, content",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c8a50938fef73e4f145a1eb08b002258393f35fb/vllm%2Fparser%2Fgemma4.py",
      "sha": "b68653e71395136967867a7775066016097d6997",
      "status": "modified"
    }
  ],
