      "additions": 40,
      "blob_url": "https://github.com/vllm-project/vllm/blob/41fbae1243072a90950fde5a75560531392ca1aa/tests%2Fconfig%2Ftest_model_arch_config.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fconfig%2Ftest_model_arch_config.py?ref=41fbae1243072a90950fde5a75560531392ca1aa",
      "deletions": 0,
      "filename": "tests/config/test_model_arch_config.py",
      "patch": "@@ -17,8 +17,10 @@\n from vllm.config.model_arch import ModelArchitectureConfig\n from vllm.transformers_utils.configs.gemma4 import gemma4_layer_config\n from vllm.transformers_utils.model_arch_config_convertor import (\n+    MODEL_ARCH_CONFIG_CONVERTORS,\n     Gemma4ModelArchConfigConvertor,\n     ModelArchConfigConvertorBase,\n+    register_model_arch_config_convertor,\n )\n \n BASE_TRUST_REMOTE_CODE_MODELS = {\n@@ -496,3 +498,41 @@ def test_deepseek_v4_convertor_splits_vision_architecture():\n         conv = DeepseekV4ModelArchConfigConvertor(draft_cfg, draft_cfg)\n         assert conv.get_architectures() == [draft_arch]\n         assert draft_cfg.architectures == [draft_arch]\n+\n+\n+def test_register_model_arch_config_convertor(monkeypatch: pytest.MonkeyPatch):\n+    model_type = \"custom_mla_model\"\n+    monkeypatch.delitem(MODEL_ARCH_CONFIG_CONVERTORS, model_type, raising=False)\n+    hf_config = PretrainedConfig.from_dict(\n+        {\n+            \"model_type\": model_type,\n+            \"hidden_size\": 1024,\n+            \"num_attention_heads\": 16,\n+            \"num_key_value_heads\": 16,\n+            \"kv_lora_rank\": 512,\n+            \"qk_nope_head_dim\": 128,\n+            \"qk_rope_head_dim\": 64,\n+            \"v_head_dim\": 128,\n+        }\n+    )\n+    assert not ModelArchConfigConvertorBase(hf_config, hf_config).is_deepseek_mla()\n+\n+    @register_model_arch_config_convertor(model_type)\n+    class CustomMLAModelArchConfigConvertor(ModelArchConfigConvertorBase):\n+        def is_deepseek_mla(self) -> bool:\n+            return True\n+\n+    convertor_cls = MODEL_ARCH_CONFIG_CONVERTORS[model_type]\n+    assert convertor_cls is CustomMLAModelArchConfigConvertor\n+    model_arch_config = convertor_cls(hf_config, hf_config).convert()\n+\n+    assert model_arch_config.is_deepseek_mla\n+    assert model_arch_config.head_size == 512 + 64\n+\n+\n+def test_invalid_model_arch_config_convertor():\n+    with pytest.raises(ValueError):\n+\n+        @register_model_arch_config_convertor(\"invalid_model_type\")\n+        class InvalidModelArchConfigConvertor:\n+            pass",
      "raw_url": "https://github.com/vllm-project/vllm/raw/41fbae1243072a90950fde5a75560531392ca1aa/tests%2Fconfig%2Ftest_model_arch_config.py",
      "sha": "d8c3d5cd73a2c2a6ca497dc1959aef45f1ac41c9",
      "status": "modified"
    },
    {
      "additions": 43,
      "blob_url": "https://github.com/vllm-project/vllm/blob/41fbae1243072a90950fde5a75560531392ca1aa/vllm%2Ftransformers_utils%2Fmodel_arch_config_convertor.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftransformers_utils%2Fmodel_arch_config_convertor.py?ref=41fbae1243072a90950fde5a75560531392ca1aa",
      "deletions": 0,
      "filename": "vllm/transformers_utils/model_arch_config_convertor.py",
      "patch": "@@ -845,3 +845,46 @@ def derive_max_model_len_and_key(self) -> tuple[float, str | None]:\n     \"timm_wrapper\": TerratorchModelArchConfigConvertor,\n     \"zamba2\": Zamba2ModelArchConfigConvertor,\n }\n+\n+\n+def register_model_arch_config_convertor(model_type: str):\n+    \"\"\"Register a model arch config convertor for an HF `model_type`.\n+\n+    vLLM derives architecture facts that are not plain HF config fields, such\n+    as whether a model uses MLA (`is_deepseek_mla`), from built-in model type\n+    lists. Out-of-tree models with their own `model_type` can register a\n+    convertor to report these facts instead of reusing a built-in model type.\n+\n+    Args:\n+        model_type: The HF config `model_type` the convertor handles.\n+\n+    Examples:\n+\n+        >>> from vllm.transformers_utils.model_arch_config_convertor import (\n+        ...     ModelArchConfigConvertorBase,\n+        ...     register_model_arch_config_convertor,\n+        ... )\n+        >>>\n+        >>> @register_model_arch_config_convertor(\"my_mla_model\")\n+        ... class MyMLAModelArchConfigConvertor(ModelArchConfigConvertorBase):\n+        ...     def is_deepseek_mla(self) -> bool:\n+        ...         return True\n+    \"\"\"\n+\n+    def _wrapper(convertor_cls):\n+        if not issubclass(convertor_cls, ModelArchConfigConvertorBase):\n+            raise ValueError(\n+                \"The model arch config convertor must be a subclass of \"\n+                \"`ModelArchConfigConvertorBase`.\"\n+            )\n+        if model_type in MODEL_ARCH_CONFIG_CONVERTORS:\n+            logger.warning(\n+                \"Model type `%s` already has a model arch config convertor, \"\n+                \"which will be overwritten by `%s`.\",\n+                model_type,\n+                convertor_cls,\n+            )\n+        MODEL_ARCH_CONFIG_CONVERTORS[model_type] = convertor_cls\n+        return convertor_cls\n+\n+    return _wrapper",
      "raw_url": "https://github.com/vllm-project/vllm/raw/41fbae1243072a90950fde5a75560531392ca1aa/vllm%2Ftransformers_utils%2Fmodel_arch_config_convertor.py",
      "sha": "e6db39f643a166b0f0deed6a95e57f87b90eaf7d",
      "status": "modified"
    }
