      "filename": "docker/Dockerfile.rocm_base_gfx1250",
      "patch": "@@ -12,6 +12,7 @@ ARG FA_BRANCH=\"jpvillam/gfx1250_wip\"\n ARG FA_REPO=\"https://github.com/jpvillam-amd/flash-attention.git\"\n ARG AITER_BRANCH=\"main\"\n ARG AITER_REPO=\"https://github.com/ROCm/aiter.git\"\n+ARG AITER_COMMIT=\"dca178b4b858146ff71b21c7897c54e234a1ffd3\"\n ARG MORI_BRANCH=\"v1.1.0\"\n ARG MORI_REPO=\"https://github.com/ROCm/mori.git\"\n \n@@ -252,9 +253,11 @@ RUN mkdir -p /app/install; \\\n FROM base AS build_aiter\n ARG AITER_BRANCH\n ARG AITER_REPO\n+ARG AITER_COMMIT\n ARG USE_SCCACHE\n RUN git clone --recursive --branch ${AITER_BRANCH} ${AITER_REPO}\n RUN cd aiter \\\n+    && git checkout ${AITER_COMMIT} \\\n     && git submodule update --init --recursive \\\n     && pip install -r requirements.txt\n RUN pip install pyyaml && cd aiter \\\n@@ -309,6 +312,7 @@ ARG FA_BRANCH\n ARG FA_REPO\n ARG AITER_BRANCH\n ARG AITER_REPO\n+ARG AITER_COMMIT\n ARG MORI_BRANCH\n ARG MORI_REPO\n RUN echo \"BASE_IMAGE: ${BASE_IMAGE}\" > /app/versions.txt \\\n@@ -321,5 +325,6 @@ RUN echo \"BASE_IMAGE: ${BASE_IMAGE}\" > /app/versions.txt \\\n     && echo \"FA_REPO: ${FA_REPO}\" >> /app/versions.txt \\\n     && echo \"AITER_BRANCH: ${AITER_BRANCH}\" >> /app/versions.txt \\\n     && echo \"AITER_REPO: ${AITER_REPO}\" >> /app/versions.txt \\\n+    && echo \"AITER_COMMIT: ${AITER_COMMIT}\" >> /app/versions.txt \\\n     && echo \"MORI_BRANCH: ${MORI_BRANCH}\" >> /app/versions.txt \\\n     && echo \"MORI_REPO: ${MORI_REPO}\" >> /app/versions.txt",
