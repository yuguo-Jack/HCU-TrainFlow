      "blob_url": "https://github.com/vllm-project/vllm/blob/1bfbfeb4d93a1d7bd50c5884036e42996f931b7f/tests%2Ftest_zen_cpu_platform_detection.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_zen_cpu_platform_detection.py?ref=1bfbfeb4d93a1d7bd50c5884036e42996f931b7f",
      "deletions": 0,
      "filename": "tests/test_zen_cpu_platform_detection.py",
      "patch": "@@ -143,6 +143,27 @@ def failing_plugin():\n     assert \"RuntimeError: plugin exploded\" in caplog_vllm.text\n \n \n+def test_rocm_platform_falls_back_when_amdsmi_fails(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    from vllm.platforms import rocm as rocm_module\n+    from vllm.platforms.rocm import RocmPlatform\n+\n+    def _raise_amdsmi() -> None:\n+        raise RuntimeError(\"AmdSmiLibraryException(34)\")\n+\n+    monkeypatch.setattr(rocm_module, \"amdsmi_init\", _raise_amdsmi)\n+    monkeypatch.setattr(\n+        torch.cuda, \"get_device_name\", lambda device_id=0: \"AMD Radeon RX 9060 XT\"\n+    )\n+    RocmPlatform.get_device_name.cache_clear()\n+\n+    assert RocmPlatform.get_device_name(0) == \"AMD Radeon RX 9060 XT\"\n+    assert RocmPlatform.get_device_uuid(0) == \"rocm:0\"\n+    assert not RocmPlatform.is_fully_connected([0, 1])\n+\n+\n+\n @pytest.mark.parametrize(\"fp16_supported\", [True, False])\n def test_zen_cpu_supported_dtypes_track_fp16_capability(fp16_supported):\n     from vllm.platforms.zen_cpu import ZenCpuPlatform",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1bfbfeb4d93a1d7bd50c5884036e42996f931b7f/tests%2Ftest_zen_cpu_platform_detection.py",
      "sha": "1340fa0a6089eaef30c655265622839ffabc5ffb",
      "status": "modified"
    },
    {
      "additions": 60,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1bfbfeb4d93a1d7bd50c5884036e42996f931b7f/vllm%2Fplatforms%2Frocm.py",
      "changes": 92,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fplatforms%2Frocm.py?ref=1bfbfeb4d93a1d7bd50c5884036e42996f931b7f",
      "deletions": 32,
      "filename": "vllm/platforms/rocm.py",
      "patch": "@@ -197,6 +197,47 @@ def _query_total_memory_from_amdsmi(physical_device_id: int) -> int:\n     return amdsmi_get_gpu_memory_total(handle, AmdSmiMemoryType.VRAM)\n \n \n+@with_amdsmi_context\n+def _query_is_fully_connected_from_amdsmi(physical_device_ids: list[int]) -> bool:\n+    handles = [amdsmi_get_processor_handles()[i] for i in physical_device_ids]\n+    for i, handle in enumerate(handles):\n+        for j, peer_handle in enumerate(handles):\n+            if i < j:\n+                try:\n+                    link_type = amdsmi_topo_get_link_type(handle, peer_handle)\n+                    # type is 2 for XGMI\n+                    if link_type[\"hops\"] != 1 or link_type[\"type\"] != 2:\n+                        return False\n+                except AmdSmiException as error:\n+                    logger.error(\"AMD 1 hop XGMI detection failed.\", exc_info=error)\n+                    return False\n+    return True\n+\n+\n+@with_amdsmi_context\n+def _query_device_name_from_amdsmi(physical_device_id: int) -> str:\n+    handle = amdsmi_get_processor_handles()[physical_device_id]\n+    asic_info = amdsmi_get_gpu_asic_info(handle)\n+    asic_info_device_id: str = asic_info[\"device_id\"]\n+    if asic_info_device_id in _ROCM_DEVICE_ID_NAME_MAP:\n+        return _ROCM_DEVICE_ID_NAME_MAP[asic_info_device_id]\n+    return asic_info[\"market_name\"]\n+\n+\n+@with_amdsmi_context\n+def _query_device_uuid_from_amdsmi(device_id: int) -> str:\n+    try:\n+        device = amdsmi_get_processor_handles()[device_id]\n+    except AmdSmiException as error:\n+        logger.error(\"amdsmi device query failed \", exc_info=error)\n+        return \"\"\n+    try:\n+        return amdsmi_get_gpu_device_uuid(device)\n+    except AmdSmiException as error:\n+        logger.error(\"amdsmi device uuid query failed \", exc_info=error)\n+        return \"\"\n+\n+\n def _get_gcn_arch() -> str:\n     \"\"\"Get GCN arch via amdsmi (no CUDA init), fallback to torch.cuda.\n     Called once at module level; result stored in _GCN_ARCH.\n@@ -1045,48 +1086,35 @@ def get_device_capability(cls, device_id: int = 0) -> DeviceCapability | None:\n         return DeviceCapability(major=major, minor=minor)\n \n     @classmethod\n-    @with_amdsmi_context\n     def is_fully_connected(cls, physical_device_ids: list[int]) -> bool:\n         \"\"\"Query if the set of gpus are fully connected by xgmi (1 hop).\"\"\"\n-        handles = [amdsmi_get_processor_handles()[i] for i in physical_device_ids]\n-        for i, handle in enumerate(handles):\n-            for j, peer_handle in enumerate(handles):\n-                if i < j:\n-                    try:\n-                        link_type = amdsmi_topo_get_link_type(handle, peer_handle)\n-                        # type is 2 for XGMI\n-                        if link_type[\"hops\"] != 1 or link_type[\"type\"] != 2:\n-                            return False\n-                    except AmdSmiException as error:\n-                        logger.error(\"AMD 1 hop XGMI detection failed.\", exc_info=error)\n-                        return False\n-        return True\n+        try:\n+            return _query_is_fully_connected_from_amdsmi(physical_device_ids)\n+        except Exception as e:\n+            logger.debug(\"Failed to query XGMI topology via amdsmi: %s\", e)\n+            return False\n \n     @classmethod\n-    @with_amdsmi_context\n     @lru_cache(maxsize=8)\n     def get_device_name(cls, device_id: int = 0) -> str:\n-        physical_device_id = cls.device_id_to_physical_device_id(device_id)\n-        handle = amdsmi_get_processor_handles()[physical_device_id]\n-        asic_info = amdsmi_get_gpu_asic_info(handle)\n-        asic_info_device_id: str = asic_info[\"device_id\"]\n-        if asic_info_device_id in _ROCM_DEVICE_ID_NAME_MAP:\n-            return _ROCM_DEVICE_ID_NAME_MAP[asic_info_device_id]\n-        return asic_info[\"market_name\"]\n+        try:\n+            physical_device_id = cls.device_id_to_physical_device_id(device_id)\n+            return _query_device_name_from_amdsmi(physical_device_id)\n+        except Exception as e:\n+            logger.debug(\"Failed to get device name via amdsmi: %s\", e)\n+            logger.warning_once(\n+                \"Failed to get device name via amdsmi, falling back to \"\n+                \"torch.cuda. This will initialize CUDA.\"\n+            )\n+            return torch.cuda.get_device_name(device_id)\n \n     @classmethod\n-    @with_amdsmi_context\n     def get_device_uuid(cls, device_id: int = 0) -> str:\n         try:\n-            device = amdsmi_get_processor_handles()[device_id]\n-        except AmdSmiException as error:\n-            logger.error(\"amdsmi device query failed \", exc_info=error)\n-            return \"\"\n-        try:\n-            device_uuid = amdsmi_get_gpu_device_uuid(device)\n-        except AmdSmiException as error:\n-            logger.error(\"amdsmi device uuid query failed \", exc_info=error)\n-        return device_uuid\n+            return _query_device_uuid_from_amdsmi(device_id)\n+        except Exception as e:\n+            logger.debug(\"Failed to get device uuid via amdsmi: %s\", e)\n+            return f\"rocm:{device_id}\"\n \n     @classmethod\n     def get_device_total_memory(cls, device_id: int = 0) -> int:",
