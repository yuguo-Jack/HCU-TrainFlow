    {
      "additions": 20,
      "blob_url": "https://github.com/vllm-project/vllm/blob/10400389c2896426fd4cd05a15620528cedd3bb1/tests%2Ftest_sampling_params.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_sampling_params.py?ref=10400389c2896426fd4cd05a15620528cedd3bb1",
      "deletions": 0,
      "filename": "tests/test_sampling_params.py",
      "patch": "@@ -280,3 +280,23 @@ def test_extra_args_preserves_custom_objects_and_shared_containers():\n     params = SamplingParams(extra_args=extra_args)\n     assert params.extra_args[\"first\"][0] is custom\n     assert params.extra_args[\"first\"] is params.extra_args[\"second\"]\n+\n+\n+@pytest.mark.parametrize(\n+    \"logit_bias\",\n+    [\n+        {7: 1.0, 5: float(\"nan\")},\n+        # Also covers the slow path taken for a non-integer key.\n+        {\"bad\": 1.0, 5: float(\"nan\")},\n+    ],\n+)\n+def test_logit_bias_rejects_nan(logit_bias):\n+    # NaN used to clamp to -100, silently banning the token.\n+    with pytest.raises(VLLMValidationError, match=\"NaN\") as exc_info:\n+        SamplingParams.from_optional(logit_bias=logit_bias)\n+    assert exc_info.value.parameter == \"logit_bias\"\n+\n+\n+def test_logit_bias_clamps_infinite_values():\n+    params = SamplingParams.from_optional(logit_bias={1: float(\"inf\"), \"2\": -1e9})\n+    assert params.logit_bias == {1: 100.0, 2: -100.0}",
      "raw_url": "https://github.com/vllm-project/vllm/raw/10400389c2896426fd4cd05a15620528cedd3bb1/tests%2Ftest_sampling_params.py",
      "sha": "4b1ab2e5ca866bce681fdc23cb79300477a5a4ff",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/10400389c2896426fd4cd05a15620528cedd3bb1/vllm%2Fsampling_params.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fsampling_params.py?ref=10400389c2896426fd4cd05a15620528cedd3bb1",
      "deletions": 2,
      "filename": "vllm/sampling_params.py",
      "patch": "@@ -43,6 +43,15 @@\n tag structure (up to 15 levels for tool-call tags generated by tool parsers).\"\"\"\n \n \n+def _clamp_logit_bias(bias: float) -> float:\n+    # min/max would turn NaN into -100 and silently ban the token.\n+    if math.isnan(bias):\n+        raise VLLMValidationError(\n+            \"logit_bias values must not be NaN.\", parameter=\"logit_bias\"\n+        )\n+    return min(100.0, max(-100.0, bias))\n+\n+\n def _verify_num_sequences(value: int, parameter_name: str) -> None:\n     if not isinstance(value, int):\n         raise VLLMValidationError(\n@@ -490,7 +499,7 @@ def from_optional(\n             # to identify the exact offending entry for the error message.\n             try:\n                 logit_bias = {\n-                    int(token): min(100.0, max(-100.0, bias))\n+                    int(token): _clamp_logit_bias(bias)\n                     for token, bias in logit_bias.items()\n                 }\n             except (ValueError, TypeError):\n@@ -502,7 +511,7 @@ def from_optional(\n                     except (ValueError, TypeError):\n                         invalid_keys.append(token)\n                         continue\n-                    converted_logit_bias[token_id] = min(100.0, max(-100.0, bias))\n+                    converted_logit_bias[token_id] = _clamp_logit_bias(bias)\n                 if invalid_keys:\n                     raise VLLMValidationError(\n                         f\"logit_bias contains key(s) that cannot be \"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/10400389c2896426fd4cd05a15620528cedd3bb1/vllm%2Fsampling_params.py",
      "sha": "21d313b69904b8c432f8eb3f2a2cf17f10faf6fa",
      "status": "modified"
