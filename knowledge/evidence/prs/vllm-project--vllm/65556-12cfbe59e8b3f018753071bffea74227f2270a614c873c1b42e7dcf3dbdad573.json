      "deletions": 0,
      "filename": "tests/tool_parsers/test_llama4_pythonic_tool_parser.py",
      "patch": "@@ -200,6 +200,14 @@ def test_no_tool_call(streaming: bool, default_tokenizer: TokenizerLike):\n         ],\n         id=\"parallel_calls_nonstreaming\",\n     ),\n+    pytest.param(\n+        False,\n+        # <|python_end|> emitted without a leading <|python_start|> must still\n+        # be stripped; otherwise ast.parse fails and the call is dropped.\n+        \"[get_weather(city='LA', metric='C')]<|python_end|>\",\n+        [SIMPLE_FUNCTION_CALL],\n+        id=\"end_token_without_start_nonstreaming\",\n+    ),\n ]\n \n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8e2a39d54952895721e634f0e8ca9afab7ee131a/tests%2Ftool_parsers%2Ftest_llama4_pythonic_tool_parser.py",
      "sha": "9f03cc700673c800eff9c859163478771dbf09ec",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8e2a39d54952895721e634f0e8ca9afab7ee131a/vllm%2Ftool_parsers%2Fllama4_pythonic_tool_parser.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fllama4_pythonic_tool_parser.py?ref=8e2a39d54952895721e634f0e8ca9afab7ee131a",
      "deletions": 1,
      "filename": "vllm/tool_parsers/llama4_pythonic_tool_parser.py",
      "patch": "@@ -71,7 +71,11 @@ def extract_tool_calls(\n         # as Llama 4 model sometime will output those tokens\n         if model_output.startswith(\"<|python_start|>\"):\n             model_output = model_output[len(\"<|python_start|>\") :]\n-            model_output = model_output.replace(\"<|python_end|>\", \"\")\n+        # Strip <|python_end|> regardless of the start token: Llama 4 may emit\n+        # the end token without a leading start token, and the streaming path\n+        # strips it unconditionally. Leaving it in makes ast.parse raise and the\n+        # whole tool call is silently dropped.\n+        model_output = model_output.replace(\"<|python_end|>\", \"\")\n \n         is_tool_call_pattern = False\n         try:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8e2a39d54952895721e634f0e8ca9afab7ee131a/vllm%2Ftool_parsers%2Fllama4_pythonic_tool_parser.py",
      "sha": "372967cf20adf61b1c86a9a94f0436a0b2f749c4",
      "status": "modified"
    }
