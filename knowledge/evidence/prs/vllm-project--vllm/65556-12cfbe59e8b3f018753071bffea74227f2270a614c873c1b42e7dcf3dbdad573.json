      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8e2a39d54952895721e634f0e8ca9afab7ee131a/tests%2Ftool_parsers%2Ftest_llama4_pythonic_tool_parser.py",
