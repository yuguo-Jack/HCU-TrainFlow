      "additions": 29,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5bc9fa9b698d49b092f0edafb89d8a527529f3d2/tests%2Fkernels%2Fmoe%2Ftest_moe.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fmoe%2Ftest_moe.py?ref=5bc9fa9b698d49b092f0edafb89d8a527529f3d2",
      "deletions": 0,
      "filename": "tests/kernels/moe/test_moe.py",
      "patch": "@@ -975,6 +975,35 @@ def make(\n         )\n \n \n+\n+@pytest.mark.skipif(current_platform.is_rocm(), reason=\"moe_wna16 CUDA kernel needs CUDA\")\n+def test_moe_wna16_cuda_disabled_for_batch_invariant(monkeypatch):\n+    \"\"\"VLLM_BATCH_INVARIANT must disable the nondeterministic split-K CUDA kernel\n+    and fall through to the existing Triton WNA16 path.\n+    \"\"\"\n+    from vllm.model_executor.layers.fused_moe.fused_moe import (\n+        should_moe_wna16_use_cuda,\n+    )\n+    import vllm.envs as envs\n+\n+    monkeypatch.setattr(current_platform, \"is_cuda\", lambda: True)\n+\n+    monkeypatch.setattr(envs, \"VLLM_BATCH_INVARIANT\", False)\n+    assert should_moe_wna16_use_cuda(\n+        num_valid_tokens=32,\n+        group_size=128,\n+        num_experts=8,\n+        bit=4,\n+    ), \"CUDA WNA16 kernel should be selected in normal mode\"\n+\n+    monkeypatch.setattr(envs, \"VLLM_BATCH_INVARIANT\", True)\n+    assert not should_moe_wna16_use_cuda(\n+        num_valid_tokens=32,\n+        group_size=128,\n+        num_experts=8,\n+        bit=4,\n+    ), \"CUDA WNA16 kernel must NOT be selected when VLLM_BATCH_INVARIANT=1\"\n+\n @pytest.mark.flaky(reruns=2)\n @pytest.mark.parametrize(\n     (\"a_type, b_type, c_type, group_blocks,m, n, k, e, topk, ep_size\"),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5bc9fa9b698d49b092f0edafb89d8a527529f3d2/tests%2Fkernels%2Fmoe%2Ftest_moe.py",
      "sha": "92dfe53588333bbd454b5fcd245cf65ab39daa66",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5bc9fa9b698d49b092f0edafb89d8a527529f3d2/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Ffused_moe.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Ffused_moe.py?ref=5bc9fa9b698d49b092f0edafb89d8a527529f3d2",
      "deletions": 0,
      "filename": "vllm/model_executor/layers/fused_moe/fused_moe.py",
      "patch": "@@ -1287,6 +1287,7 @@ def should_moe_wna16_use_cuda(\n ):\n     return (\n         current_platform.is_cuda()\n+        and not envs.VLLM_BATCH_INVARIANT\n         and bit == 4\n         and group_size in [32, 64, 128]\n         and num_valid_tokens / num_experts <= 6",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5bc9fa9b698d49b092f0edafb89d8a527529f3d2/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Ffused_moe.py",
      "sha": "8ac2612c00d770970221cf10262edfb58ebf6ec9",
      "status": "modified"
    }
