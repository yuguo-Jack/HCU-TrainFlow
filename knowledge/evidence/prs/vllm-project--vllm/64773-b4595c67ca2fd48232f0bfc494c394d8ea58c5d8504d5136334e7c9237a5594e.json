      "changes": 3,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2Fzai-org%2FGLM-5.2.yaml?ref=6b108c27c0c3dfe9ca3c5b5151b0dd372d4fffb6",
      "deletions": 1,
      "filename": "recipes/models/zai-org/GLM-5.2.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"GLM (Z-AI)\"\n   description: \"GLM-5.2 — frontier-scale MoE language model (~743B total parameters, 39B active) with up to 5-token MTP speculative decoding and thinking mode\"\n   date_added: 2026-06-16\n-  date_updated: 2026-10-03\n+  date_updated: 2026-10-30\n   tasks:\n     - text\n   performance_headline: \"Latest GLM-5 series MoE with extended MTP (5 draft tokens), improved reasoning and agentic performance\"\n@@ -466,6 +466,7 @@ guide: |\n   ## References\n \n   - [Model card](https://huggingface.co/zai-org/GLM-5.2)\n+  - [RedHatAI NVFP4-FP8 MTP supplement](https://huggingface.co/RedHatAI/GLM-5.2-NVFP4-FP8-mtp-FP8) — contains supplemental MTP shards only; merge them into the matching base checkpoint as described on the card before serving.\n   - [FP8 checkpoint](https://huggingface.co/zai-org/GLM-5.2-FP8)\n   - [MXFP4 checkpoint](https://huggingface.co/amd/GLM-5.2-MXFP4)\n   - [NVFP4 checkpoint (NVIDIA)](https://huggingface.co/nvidia/GLM-5.2-NVFP4)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6b108c27c0c3dfe9ca3c5b5151b0dd372d4fffb6/recipes%2Fmodels%2Fzai-org%2FGLM-5.2.yaml",
      "sha": "c9160942056d2f3af6d0b1defb2bdc2248748105",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/vllm-project/vllm/blob/6b108c27c0c3dfe9ca3c5b5151b0dd372d4fffb6/recipes%2Fmodels%2Fzai-org%2FGLM-5.3-Flash.yaml",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2Fzai-org%2FGLM-5.3-Flash.yaml?ref=6b108c27c0c3dfe9ca3c5b5151b0dd372d4fffb6",
      "deletions": 2,
      "filename": "recipes/models/zai-org/GLM-5.3-Flash.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"GLM (Z-AI)\"\n   description: \"GLM-5.3-Flash is a 320B-total / 18B-active multimodal MoE with hybrid KDA and sparse MLA attention, native FP8 weights, MTP, and a 1M-token context window.\"\n   date_added: 2026-08-27\n-  date_updated: 2026-10-19\n+  date_updated: 2026-10-30\n   tasks:\n     - text\n     - multimodal\n@@ -53,7 +53,7 @@ features:\n       - \"--reasoning-parser\"\n       - \"glm47\"\n   spec_decoding:\n-    description: \"Built-in MTP or an external DFlash2 drafter. Pick one method — only that --speculative-config is emitted.\"\n+    description: \"Built-in MTP, an external DFlash2 drafter, or the preview RedHatAI DSpark draft. Pick one method — only that --speculative-config is emitted.\"\n     default_mode: mtp\n     modes:\n       mtp:\n@@ -70,6 +70,17 @@ features:\n         args:\n           - \"--speculative-config\"\n           - '{\"method\":\"dflash\",\"model\":\"incoai/GLM-5.3-Flash-DFlash2\",\"num_speculative_tokens\":7}'\n+      dspark_preview:\n+        label: \"DSpark Preview (RedHatAI)\"\n+        description: \"Preview RedHatAI DSpark draft with 8 tokens. The card reports testing on vLLM 0.28.1rc1 plus Speculators 0.7.0.dev174 and does not claim compatibility with an unmodified stable build.\"\n+        variants: [default]\n+        args:\n+          - \"--max-model-len\"\n+          - \"16384\"\n+          - \"--kv-cache-dtype\"\n+          - \"fp8\"\n+          - \"--speculative-config\"\n+          - '{\"model\":\"RedHatAI/GLM-5.3-Flash-speculator.dspark-preview\",\"num_speculative_tokens\":8,\"method\":\"dspark\"}'\n \n opt_in_features:\n   - spec_decoding\n@@ -530,6 +541,7 @@ guide: |\n   ## References\n \n   - [Model card](https://huggingface.co/zai-org/GLM-5.3-Flash)\n+  - [RedHatAI DSpark preview speculator](https://huggingface.co/RedHatAI/GLM-5.3-Flash-speculator.dspark-preview)\n   - [vLLM](https://github.com/vllm-project/vllm)\n   - [ROCm MTP sparse-MLA fix](https://github.com/vllm-project/vllm/pull/55239)\n   - **FlashInfer:** 0.6.17 or newer is required for NoPE sparse MLA",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6b108c27c0c3dfe9ca3c5b5151b0dd372d4fffb6/recipes%2Fmodels%2Fzai-org%2FGLM-5.3-Flash.yaml",
      "sha": "391153f643abe51e9958bf99bc9c07ddb69b2faf",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/vllm-project/vllm/blob/6b108c27c0c3dfe9ca3c5b5151b0dd372d4fffb6/recipes%2Fmodels%2Fzai-org%2FGLM-5.3.yaml",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/recipes%2Fmodels%2Fzai-org%2FGLM-5.3.yaml?ref=6b108c27c0c3dfe9ca3c5b5151b0dd372d4fffb6",
      "deletions": 1,
      "filename": "recipes/models/zai-org/GLM-5.3.yaml",
      "patch": "@@ -4,7 +4,7 @@ meta:\n   provider: \"GLM (Z-AI)\"\n   description: \"GLM-5.3 — Frontier Coding with Emergent Cyber Capabilities\"\n   date_added: 2026-08-28\n-  date_updated: 2026-10-19\n+  date_updated: 2026-10-30\n   tasks:\n     - text\n   performance_headline: \"Latest GLM-5 series MoE — native FP8 by default, 5-token MTP, 1M context\"\n@@ -178,6 +178,22 @@ variants:\n           - \"--kv-cache-dtype\"\n           - \"fp8_ds_mla\"\n     description: \"GPUStack Hopper-native W4A8 (gpustack/GLM-5.3-W4A8). Routed experts are INT4 group-128; non-expert layers stay FP8. Weights drop from 704 GB to 372 GB, roughly doubling KV cache on 8×H200/H20 with no measurable accuracy drop vs official FP8. CUTLASS W4A8 is SM90-only — H100/H200/H20; Blackwell and AMD are unsupported.\"\n+  redhat_mxfp4:\n+    model_id: \"RedHatAI/GLM-5.3-MXFP4\"\n+    precision: mxfp4\n+    label: \"MXFP4 (RedHatAI)\"\n+    vram_minimum_gb: 447\n+    supported_hardware: [arch:sm100, arch:sm103]\n+    description: \"RedHatAI OCP MXFP4 weights and dynamic FP4 activations; evaluated on 4x B200\"\n+  redhat_nvfp4:\n+    model_id: \"RedHatAI/GLM-5.3-NVFP4\"\n+    precision: nvfp4\n+    label: \"NVFP4 (RedHatAI)\"\n+    vram_minimum_gb: 558\n+    supported_hardware: [arch:sm100, arch:sm103]\n+    description: \"RedHatAI NVFP4 weights and activations on routed experts; non-expert layers retain higher precision\"\n+    extra_args:\n+      - \"--trust-remote-code\"\n   bf16:\n     model_id: \"zai-org/GLM-5.3-BF16\"\n     precision: bf16\n@@ -481,6 +497,8 @@ guide: |\n   ## References\n \n   - [Model card](https://huggingface.co/zai-org/GLM-5.3)\n+  - [RedHatAI MXFP4 checkpoint](https://huggingface.co/RedHatAI/GLM-5.3-MXFP4)\n+  - [RedHatAI NVFP4 checkpoint](https://huggingface.co/RedHatAI/GLM-5.3-NVFP4)\n   - [BF16 checkpoint](https://huggingface.co/zai-org/GLM-5.3-BF16)\n   - [NVFP4 checkpoint (Inferact)](https://huggingface.co/Inferact/GLM-5.3-NVFP4)\n   - [DSpark draft](https://huggingface.co/RedHatAI/GLM-5.3-speculator.dspark)",
