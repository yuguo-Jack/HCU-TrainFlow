      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ecc6dcf0b801f11db7b491e6254d996f8263a147/tests%2Fparser%2Ftest_chat_parsing.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fparser%2Ftest_chat_parsing.py?ref=ecc6dcf0b801f11db7b491e6254d996f8263a147",
      "deletions": 0,
      "filename": "tests/parser/test_chat_parsing.py",
      "patch": "@@ -1563,6 +1563,11 @@ def test_coerce_integer_accepts_whole_number_floats(self):\n         self.assertEqual(_coerce(\"inf\", (\"integer\",)), \"inf\")\n         self.assertEqual(_coerce(\"NaN\", (\"integer\",)), \"NaN\")\n \n+    def test_coerce_number_keeps_large_integers_exact(self):\n+        self.assertEqual(_coerce(\"9223372036854775807\", (\"number\",)), 9223372036854775807)\n+        self.assertEqual(_coerce(\"1e3\", (\"number\",)), 1000)\n+        self.assertEqual(_coerce(\"2.5\", (\"number\",)), 2.5)\n+\n     def test_coerce_handles_any_of_and_null(self):\n         self.assertEqual(_coerce(\"5\", (\"integer\", \"null\")), 5)\n         self.assertIsNone(_coerce(\"null\", (\"integer\", \"null\")))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ecc6dcf0b801f11db7b491e6254d996f8263a147/tests%2Fparser%2Ftest_chat_parsing.py",
      "sha": "89431c5f82979c7b098de20dd7229ed03ac007b4",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ecc6dcf0b801f11db7b491e6254d996f8263a147/vllm%2Fparser%2Fchat_parsing%2Fresponse_parser.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fparser%2Fchat_parsing%2Fresponse_parser.py?ref=ecc6dcf0b801f11db7b491e6254d996f8263a147",
      "deletions": 0,
      "filename": "vllm/parser/chat_parsing/response_parser.py",
      "patch": "@@ -59,6 +59,10 @@ def _coerce(raw: str, types: tuple[str, ...]) -> Any:\n                         continue\n                     return int(number)\n             if type_name == \"number\":\n+                try:\n+                    return int(raw)  # float() would round integers above 2**53\n+                except ValueError:\n+                    pass\n                 number = float(raw)\n                 if number != number or number in (float(\"inf\"), float(\"-inf\")):\n                     continue  # NaN / inf are not valid JSON numbers",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ecc6dcf0b801f11db7b491e6254d996f8263a147/vllm%2Fparser%2Fchat_parsing%2Fresponse_parser.py",
