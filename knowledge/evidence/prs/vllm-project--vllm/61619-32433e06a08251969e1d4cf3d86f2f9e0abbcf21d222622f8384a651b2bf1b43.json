      "additions": 47,
      "blob_url": "https://github.com/vllm-project/vllm/blob/e425b97e0ff3059d0987fcfb0fafbc2cb5d12c80/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_nixl_connector.py",
      "changes": 47,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_nixl_connector.py?ref=e425b97e0ff3059d0987fcfb0fafbc2cb5d12c80",
      "deletions": 0,
      "filename": "tests/v1/kv_connector/unit/test_nixl_connector.py",
      "patch": "@@ -72,6 +72,7 @@\n     KVCacheConfig,\n     KVCacheGroupSpec,\n     KVCacheLayout,\n+    MambaSpec,\n     MLAAttentionSpec,\n     compute_layer_kv_cache_shape_bytes,\n )\n@@ -648,6 +649,52 @@ def _nixl_handshake(\n         return remote_agents, 0.0\n \n \n+def test_build_fa_remote_ssm_only_emits_padding_slots():\n+    \"\"\"SSM-only models have no attention KV group.\n+\n+    _build_fa_remote must still emit the per-region FA slot padding that the\n+    producer registers (_build_fa_local) and that _compute_desc_ids offsets\n+    SSM desc ids past; before the fix a bare next() raised StopIteration and\n+    aborted the whole handshake (issue #61617).\n+    \"\"\"\n+    worker = object.__new__(NixlConnectorWorker)\n+    worker._group_spec_types = (MambaSpec,)\n+    worker._region_is_mla = [False]\n+    worker._transfer_layer_region_indices = None\n+    worker.block_len_per_layer = [58368]\n+    worker.transfer_topo = SimpleNamespace()\n+    plan = SimpleNamespace(source_ranks_per_group=((0,),), rank_offset_factor=0)\n+    meta = SimpleNamespace(\n+        kv_caches_base_addr=[0x100000],\n+        region_num_blocks=[8],\n+        block_strides=[58368],\n+        device_id=0,\n+        num_blocks=8,\n+    )\n+    descs = worker._build_fa_remote(plan, meta, 1)\n+    # One padding descriptor per region block, page-sized.\n+    assert descs.shape == (8, 3)\n+    assert descs.dtype == np.uint64\n+    assert (descs[:, 1] == 58368).all()\n+\n+\n+def test_build_local_splits_from_plan_ssm_only_yields_nothing():\n+    \"\"\"SSM-only models take the padding-slot split path without a FA group.\"\"\"\n+    worker = object.__new__(NixlConnectorWorker)\n+    worker._group_spec_types = (MambaSpec,)\n+    worker.transfer_topo = SimpleNamespace()\n+    worker.block_len_per_layer = []\n+    worker.num_regions = 0\n+    worker._ple_region_index = None\n+    worker._logical_num_blocks = 0\n+    plan = SimpleNamespace(\n+        all_source_ranks=(),\n+        rank_to_attention_slot={},\n+        source_ranks_per_group=((0,),),\n+    )\n+    assert list(worker._build_local_splits_from_plan(plan, np.empty((0, 3)), 0)) == []\n+\n+\n class TestNixlHandshake:\n     @pytest.mark.parametrize(\n         (\"pcp_rank\", \"pcp_size\", \"dcp_size\", \"expected_tracked\"),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/e425b97e0ff3059d0987fcfb0fafbc2cb5d12c80/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_nixl_connector.py",
      "sha": "ea94c5024fce0a9bdf50859b8bab09828100f95e",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/vllm-project/vllm/blob/e425b97e0ff3059d0987fcfb0fafbc2cb5d12c80/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fbase_worker.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fbase_worker.py?ref=e425b97e0ff3059d0987fcfb0fafbc2cb5d12c80",
      "deletions": 2,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/nixl/base_worker.py",
      "patch": "@@ -286,8 +286,13 @@ def _build_local_splits_from_plan(\n         SSM uses the rank's positional index.\n         \"\"\"\n         fa_idx = next(\n-            i for i, t in enumerate(self._group_spec_types) if _is_attention_spec(t)\n+            (i for i, t in enumerate(self._group_spec_types) if _is_attention_spec(t)),\n+            None,\n         )\n+        if fa_idx is None:\n+            # SSM-only models: their FA slots are layout padding; split them\n+            # with the sole non-attention group's source ranks.\n+            fa_idx = 0\n         fa_num_splits = len(plan.source_ranks_per_group[fa_idx])\n \n         has_ssm_descs = num_fa_descs < len(src_blocks_data)\n@@ -2014,8 +2019,15 @@ def _build_fa_remote(\n             \"Remote KV cache base addresses must not be empty.\"\n         )\n         fa_group_idx = next(\n-            i for i, t in enumerate(self._group_spec_types) if _is_attention_spec(t)\n+            (i for i, t in enumerate(self._group_spec_types) if _is_attention_spec(t)),\n+            None,\n         )\n+        # SSM-only models have no attention group, but the descriptor layout\n+        # still reserves the per-region FA slots that the producer registers\n+        # (_build_fa_local) and that _compute_desc_ids offsets SSM desc ids\n+        # past. Emit those slots using the sole non-attention group's ranks.\n+        if fa_group_idx is None:\n+            fa_group_idx = 0\n         # SPLIT regions read their head slice from this many remote ranks at a\n         # per-rank offset; REPLICATE regions read the whole block once.\n         split_reads = len(plan.source_ranks_per_group[fa_group_idx])",
      "raw_url": "https://github.com/vllm-project/vllm/raw/e425b97e0ff3059d0987fcfb0fafbc2cb5d12c80/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fbase_worker.py",
      "sha": "31f8c54705121ba13150a98cd162f1a2d7d6c0ea",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "question on the hetero-TP case: with TP1 split_reads is 1 and rank_offset is 0, so these padding descriptors are good. With hetero TP, the addresses and lengths would be derived from the SSM group's plan. Do you know if they still stay within the remote registered region? Asking because `prep_xfer_dlist` registers the whole list even though nothing reads these slots.",
      "created_at": "2026-10-14T14:56:46Z",
      "diff_hunk": "@@ -2014,8 +2019,15 @@ def _build_fa_remote(\n             \"Remote KV cache base addresses must not be empty.\"\n         )\n         fa_group_idx = next(\n-            i for i, t in enumerate(self._group_spec_types) if _is_attention_spec(t)\n+            (i for i, t in enumerate(self._group_spec_types) if _is_attention_spec(t)),\n+            None,\n         )\n+        # SSM-only models have no attention group, but the descriptor layout\n+        # still reserves the per-region FA slots that the producer registers\n+        # (_build_fa_local) and that _compute_desc_ids offsets SSM desc ids\n+        # past. Emit those slots using the sole non-attention group's ranks.\n+        if fa_group_idx is None:\n+            fa_group_idx = 0",
      "html_url": "https://github.com/vllm-project/vllm/pull/61619#discussion_r4272441865",
