      "deletions": 2,
      "filename": "vllm/benchmarks/forward/capture.py",
      "patch": "@@ -20,6 +20,7 @@\n from vllm.config.compilation import CUDAGraphMode\n from vllm.distributed.parallel_state import get_world_group, graph_capture\n from vllm.forward_context import get_forward_context\n+from vllm.platforms import current_platform\n from vllm.v1.worker.gpu.input_batch import InputBatch\n \n \n@@ -157,9 +158,16 @@ def restore() -> None:\n         flag = torch.zeros(1, device=self.device)\n         # TODO(woosuk): Support ROCm. The bench hangs there, likely on these\n         # in-graph events.\n+        # `external=True` lets the event be queried outside the graph without\n+        # being captured itself; CUDA-only, XPU graphs don't need it.\n+        event_kwargs = (\n+            {\"enable_timing\": True, \"external\": True}\n+            if current_platform.is_cuda_alike()\n+            else {\"enable_timing\": True}\n+        )\n         self._events = (\n-            torch.cuda.Event(enable_timing=True, external=True),\n-            torch.cuda.Event(enable_timing=True, external=True),\n+            torch.cuda.Event(**event_kwargs),\n+            torch.cuda.Event(**event_kwargs),\n         )\n         if world.world_size > 1:\n             # Initialize the communicator outside capture.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fbenchmarks%2Fforward%2Fcapture.py",
      "sha": "0dedde2963106e6a0436cd1997043e9c07c025aa",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/vllm-project/vllm/blob/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fbenchmarks%2Fforward%2Fprofile.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fbenchmarks%2Fforward%2Fprofile.py?ref=2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8",
      "deletions": 4,
      "filename": "vllm/benchmarks/forward/profile.py",
      "patch": "@@ -25,6 +25,9 @@\n import regex as re\n import torch\n \n+from vllm.platforms import current_platform\n+from vllm.profiler.wrapper import get_default_torch_profiler_activities\n+\n _GPU_CATEGORIES = (\"kernel\", \"gpu_memcpy\", \"gpu_memset\")\n # Kernels named after a generic launcher are identified by their first\n # template argument instead.\n@@ -155,17 +158,24 @@ def profile_graph(\n     \"\"\"\n \n     def run() -> None:\n-        torch.cuda.profiler.start()\n-        with torch.cuda.nvtx.range(f\"forward/{name}\"):\n+        # `cudaProfilerStart`/`Stop` and NVTX ranges are CUDA-only (for\n+        # Nsight Systems); other accelerators just replay.\n+        if current_platform.is_xpu():\n             for _ in range(replays):\n                 graph.replay()\n                 torch.accelerator.synchronize()\n-        torch.cuda.profiler.stop()\n+        else:\n+            torch.cuda.profiler.start()\n+            with torch.cuda.nvtx.range(f\"forward/{name}\"):\n+                for _ in range(replays):\n+                    graph.replay()\n+                    torch.accelerator.synchronize()\n+            torch.cuda.profiler.stop()\n \n     if prefix is None:\n         run()\n         return None\n-    activities = [torch.profiler.ProfilerActivity.CUDA]\n+    activities = get_default_torch_profiler_activities()\n     with torch.profiler.profile(activities=activities) as prof:\n         run()\n     trace = f\"{prefix}.trace.json.gz\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fbenchmarks%2Fforward%2Fprofile.py",
