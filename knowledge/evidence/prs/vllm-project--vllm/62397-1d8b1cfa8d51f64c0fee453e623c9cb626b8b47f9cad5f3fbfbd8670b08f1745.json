    {
      "additions": 33,
      "blob_url": "https://github.com/vllm-project/vllm/blob/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fv1%2Fworker%2Fxpu_worker.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fxpu_worker.py?ref=2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8",
      "deletions": 0,
      "filename": "vllm/v1/worker/xpu_worker.py",
      "patch": "@@ -1,7 +1,10 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+import faulthandler\n import gc\n+import glob\n import os\n+import time\n \n import torch\n \n@@ -22,6 +25,19 @@\n logger = init_logger(__name__)\n \n \n+def _xccl_diag(rank: int, msg: str) -> None:\n+    \"\"\"Temporary diagnostics for intermittent TP=2 XCCL startup hangs.\"\"\"\n+    logger.info(\n+        \"[xccl-diag] rank=%d pid=%d fds=%d shm=%d tmp_dist=%d: %s\",\n+        rank,\n+        os.getpid(),\n+        len(os.listdir(\"/proc/self/fd\")),\n+        len(glob.glob(\"/dev/shm/*\")),\n+        len(glob.glob(\"/tmp/vllm_dist_*\")),\n+        msg,\n+    )\n+\n+\n class XPUWorker(Worker):\n     \"\"\"A XPU worker class.\"\"\"\n \n@@ -177,13 +193,21 @@ def init_device(self):\n         os.environ[\"LOCAL_WORLD_SIZE\"] = ENV_LOCAL_WORLD_SIZE\n         os.environ[\"LOCAL_RANK\"] = str(self.local_rank)\n \n+        _xccl_diag(self.rank, \"init_worker_distributed_environment start\")\n+        t0 = time.monotonic()\n+        faulthandler.dump_traceback_later(60, repeat=True)\n         init_worker_distributed_environment(\n             self.vllm_config,\n             self.rank,\n             self.distributed_init_method,\n             self.local_rank,\n             current_platform.dist_backend,\n         )\n+        faulthandler.cancel_dump_traceback_later()\n+        _xccl_diag(\n+            self.rank,\n+            f\"init_worker_distributed_environment done in {time.monotonic() - t0:.2f}s\",\n+        )\n \n         # oneCCL warm-up; only meaningful for multi-device runs. Requiring it\n         # with a single worker breaks platforms where oneCCL cannot enumerate\n@@ -192,7 +216,16 @@ def init_device(self):\n             self.parallel_config.world_size > 1\n             and torch.distributed.is_xccl_available()\n         ):\n+            _xccl_diag(self.rank, \"warm-up all_reduce start\")\n+            t0 = time.monotonic()\n+            faulthandler.dump_traceback_later(60, repeat=True)\n             torch.distributed.all_reduce(torch.zeros(1).xpu())\n+            torch.accelerator.synchronize()\n+            faulthandler.cancel_dump_traceback_later()\n+            _xccl_diag(\n+                self.rank,\n+                f\"warm-up all_reduce done in {time.monotonic() - t0:.2f}s\",\n+            )\n \n         if self.use_v2_model_runner:\n             logger.info_once(\"Using V2 Model Runner\")",
