      "blob_url": "https://github.com/vllm-project/vllm/blob/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fv1%2Fexecutor%2Fmultiproc_executor.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fexecutor%2Fmultiproc_executor.py?ref=2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8",
      "deletions": 0,
      "filename": "vllm/v1/executor/multiproc_executor.py",
      "patch": "@@ -1,5 +1,6 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+import faulthandler\n import multiprocessing\n import os\n import pickle\n@@ -828,8 +829,12 @@ def shutdown(self):\n         self.worker.shutdown()\n         self.rpc_broadcast_mq = None\n         self.worker_response_mq = None\n+        logger.warning(\"[sigdiag] pid=%d destroy_model_parallel start\", os.getpid())\n         destroy_model_parallel()\n         destroy_distributed_environment()\n+        logger.warning(\n+            \"[sigdiag] pid=%d destroy_distributed_environment done\", os.getpid()\n+        )\n \n     def monitor_death_pipe(self, death_pipe, shutdown_requested: threading.Event):\n         if death_pipe is None:\n@@ -872,6 +877,10 @@ def signal_handler(signum, frame):\n             nonlocal shutdown_requested\n             if not shutdown_requested.is_set():\n                 shutdown_requested.set()\n+                logger.warning(\n+                    \"[sigdiag] pid=%d got signal %d; stacks:\", os.getpid(), signum\n+                )\n+                faulthandler.dump_traceback(all_threads=True)\n                 logger.debug(\n                     \"WorkerProc handling signal %d, raising SystemExit\", signum\n                 )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fv1%2Fexecutor%2Fmultiproc_executor.py",
