    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fprofiler%2Fwrapper.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fprofiler%2Fwrapper.py?ref=2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8",
      "deletions": 0,
      "filename": "vllm/profiler/wrapper.py",
      "patch": "@@ -696,6 +696,14 @@ def annotate_context_manager(self, name: str):\n }\n \n \n+def get_default_torch_profiler_activities() -> list[torch.profiler.ProfilerActivity]:\n+    \"\"\"Default torch profiler activities for the current platform.\"\"\"\n+    return [\n+        TorchProfilerActivityMap[activity]\n+        for activity in _DEFAULT_TORCH_PROFILER_ACTIVITIES[current_platform.device_type]\n+    ]\n+\n+\n def validate_worker_profiler_config(profiler_config: ProfilerConfig) -> None:\n     \"\"\"Validate profiler selections against the worker's capabilities.\"\"\"\n     profiler_type = profiler_config.profiler",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/vllm%2Fprofiler%2Fwrapper.py",
