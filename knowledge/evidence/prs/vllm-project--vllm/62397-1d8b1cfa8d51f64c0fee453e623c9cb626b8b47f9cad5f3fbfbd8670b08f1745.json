      "deletions": 0,
      "filename": ".buildkite/scripts/hardware_ci/shutdown-loop.sh",
      "patch": "@@ -0,0 +1,9 @@\n+#!/bin/bash\n+# TEMPORARY: repeat v1/shutdown to reproduce the XPU TP=2 startup hang.\n+cd tests || exit 1\n+rc=0\n+for i in 1 2 3 4 5 6 7 8; do\n+  echo \"=== shutdown iter ${i} psm=$(find /dev/shm -maxdepth 1 -name 'psm_*' | wc -l) tmp_dist=$(find /tmp -maxdepth 1 -name 'vllm_dist_*' | wc -l) ===\"\n+  pytest -v -s v1/shutdown || rc=1\n+done\n+exit ${rc}",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2ebd1466c4d5c50fe0a042c04a17b9cf45dfddd8/.buildkite%2Fscripts%2Fhardware_ci%2Fshutdown-loop.sh",
      "sha": "24a9170d502a8890352a4cc768b06ef076fc96e0",
      "status": "added"
    },
    {
      "additions": 10,
