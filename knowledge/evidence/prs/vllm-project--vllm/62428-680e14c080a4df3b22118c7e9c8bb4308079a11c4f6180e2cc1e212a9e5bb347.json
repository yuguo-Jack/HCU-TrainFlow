  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ce7ec57561d34748a269d50d4e2ef8259b6494fe/rust%2Fsrc%2Fserver%2Fsrc%2Froutes%2Fopenai%2Fchat_completions%2Ftypes.rs",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/rust%2Fsrc%2Fserver%2Fsrc%2Froutes%2Fopenai%2Fchat_completions%2Ftypes.rs?ref=ce7ec57561d34748a269d50d4e2ef8259b6494fe",
      "deletions": 2,
      "filename": "rust/src/server/src/routes/openai/chat_completions/types.rs",
      "patch": "@@ -457,8 +457,10 @@ pub(super) struct ChatMessageDelta {\n fn validate_chat_cross_parameters(\n     req: &ChatCompletionRequest,\n ) -> Result<(), validator::ValidationError> {\n-    // 1. Validate logprobs dependency\n-    if req.top_logprobs.is_some() && !req.logprobs {\n+    // 1. Validate logprobs dependency. Like Python, `top_logprobs: 0` (the\n+    // OpenAI default) does not request any alternatives, so it is allowed\n+    // without `logprobs`.\n+    if req.top_logprobs.is_some_and(|n| n != 0) && !req.logprobs {\n         let mut e = validator::ValidationError::new(\"top_logprobs_requires_logprobs\");\n         e.message = Some(\"top_logprobs is only allowed when logprobs is enabled\".into());\n         return Err(e);",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ce7ec57561d34748a269d50d4e2ef8259b6494fe/rust%2Fsrc%2Fserver%2Fsrc%2Froutes%2Fopenai%2Fchat_completions%2Ftypes.rs",
      "sha": "a1d78ac6e889bb1c2f792379f08f1a9f368ccd56",
      "status": "modified"
    },
    {
      "additions": 20,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ce7ec57561d34748a269d50d4e2ef8259b6494fe/rust%2Fsrc%2Fserver%2Fsrc%2Froutes%2Fopenai%2Fchat_completions%2Fvalidate.rs",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/rust%2Fsrc%2Fserver%2Fsrc%2Froutes%2Fopenai%2Fchat_completions%2Fvalidate.rs?ref=ce7ec57561d34748a269d50d4e2ef8259b6494fe",
      "deletions": 2,
      "filename": "rust/src/server/src/routes/openai/chat_completions/validate.rs",
      "patch": "@@ -28,7 +28,7 @@ pub(super) fn validate_request_compat(\n         bail_invalid_request!(param = \"n\", \"Only n=1 is supported.\");\n     }\n \n-    if request.top_logprobs.is_some() && !request.logprobs {\n+    if request.top_logprobs.is_some_and(|n| n != 0) && !request.logprobs {\n         bail_invalid_request!(\n             param = \"top_logprobs\",\n             \"top_logprobs can only be used when logprobs=true.\"\n@@ -134,6 +134,7 @@ mod tests {\n \n     use crate::routes::openai::utils::types::ReasoningEffort;\n     use serde_json::json;\n+    use validator::Validate as _;\n \n     use super::validate_request_compat;\n     use crate::routes::openai::chat_completions::types::ChatCompletionRequest;\n@@ -295,11 +296,28 @@ mod tests {\n \n     #[test]\n     fn validate_request_compat_rejects_top_logprobs_without_logprobs() {\n+        for top_logprobs in [-1, 1] {\n+            let request = ChatCompletionRequest {\n+                top_logprobs: Some(top_logprobs),\n+                ..base_request()\n+            };\n+            assert!(request.validate().is_err(), \"{top_logprobs}\");\n+            assert!(\n+                validate_request_compat(&request, &served(&[\"Qwen/Qwen1.5-0.5B-Chat\"])).is_err(),\n+                \"{top_logprobs}\"\n+            );\n+        }\n+    }\n+\n+    #[test]\n+    fn validate_request_compat_accepts_zero_top_logprobs_without_logprobs() {\n         let request = ChatCompletionRequest {\n             top_logprobs: Some(0),\n             ..base_request()\n         };\n-        assert!(validate_request_compat(&request, &served(&[\"Qwen/Qwen1.5-0.5B-Chat\"])).is_err());\n+        request.validate().expect(\"schema validation accepts top_logprobs=0\");\n+        validate_request_compat(&request, &served(&[\"Qwen/Qwen1.5-0.5B-Chat\"]))\n+            .expect(\"top_logprobs=0 does not request alternatives\");\n     }\n \n     #[test]",
