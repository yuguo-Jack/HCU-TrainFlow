      "deletions": 1,
      "filename": "vllm/v1/attention/ops/rocm_aiter_mla_sparse.py",
      "patch": "@@ -923,8 +923,23 @@ def rocm_fp8_mqa_logits(\n     if _ON_GFX942 and rocm_aiter_ops.is_enabled():\n         from aiter.ops.flydsl import flydsl_fp8_mqa_logits\n \n+        seq_len = q.shape[0]\n+        seq_len_kv = k_fp8.shape[0]\n+        # gfx942 auto-selects mfma_r4_w2 once both lengths are in this\n+        # range. Four waves is faster there. The KV tile stays 128.\n+        variant = (\n+            \"mfma_r4_w4\"\n+            if seq_len >= 2048 and seq_len_kv >= 8192\n+            else None\n+        )\n         return flydsl_fp8_mqa_logits(\n-            q, k_fp8, scale, weights, cu_seqlen_ks, cu_seqlen_ke\n+            q,\n+            k_fp8,\n+            scale,\n+            weights,\n+            cu_seqlen_ks,\n+            cu_seqlen_ke,\n+            variant=variant,\n         )\n \n     aiter_mqa_logits_module = None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/02fbbde690a5bf850af5076dac8378898ab4ece7/vllm%2Fv1%2Fattention%2Fops%2Frocm_aiter_mla_sparse.py",
