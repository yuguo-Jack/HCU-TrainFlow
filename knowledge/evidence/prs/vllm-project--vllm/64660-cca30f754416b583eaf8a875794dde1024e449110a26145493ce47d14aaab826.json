      "deletions": 0,
      "filename": "rust/src/server/src/routes.rs",
      "patch": "@@ -141,6 +141,13 @@ fn build_router_with_gates(state: Arc<AppState>, gates: RouteGates) -> Router {\n         .route(\"/load\", get(load::load))\n         .route(\"/version\", get(version::version))\n         .route(\"/kv_event_sources\", get(kv_event_sources::kv_event_sources))\n+        // SageMaker\n+        .route(\"/ping\", get(health::health).post(health::health))\n+        // TODO: SageMaker sends every inference request to `/invocations`. Python\n+        // dispatches the body to the first endpoint whose request type it parses\n+        // as (chat completions, then completions, then pooling) and returns 400\n+        // if none match. Port that routing; until then this returns 501.\n+        .route(\"/invocations\", post(not_supported))\n         // OpenAI-compatible endpoints\n         .route(\"/v1/models\", get(openai::list_models))\n         .route(\"/v1/completions\", post(openai::completions))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/63326f78eea5a4ad1fa3d13b90b809d3f65b177d/rust%2Fsrc%2Fserver%2Fsrc%2Froutes.rs",
      "sha": "046aa97e5e676ea9c5d685642c1e7aa7773b8ed1",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/vllm-project/vllm/blob/63326f78eea5a4ad1fa3d13b90b809d3f65b177d/rust%2Fsrc%2Fserver%2Fsrc%2Froutes%2Ftests.rs",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/rust%2Fsrc%2Fserver%2Fsrc%2Froutes%2Ftests.rs?ref=63326f78eea5a4ad1fa3d13b90b809d3f65b177d",
      "deletions": 9,
      "filename": "rust/src/server/src/routes/tests.rs",
      "patch": "@@ -951,6 +951,7 @@ async fn unimplemented_python_routes_return_not_implemented() {\n         (\"POST\", \"/scale_elastic_ep\"),\n         (\"POST\", \"/is_scaling_elastic_ep\"),\n         (\"POST\", \"/generative_scoring\"),\n+        (\"POST\", \"/invocations\"),\n     ] {\n         assert_route_not_supported(&app, method, uri, uri).await;\n     }\n@@ -1648,13 +1649,16 @@ async fn server_load(app: &axum::Router) -> u64 {\n     value[\"server_load\"].as_u64().expect(\"server_load\")\n }\n \n-async fn health_status(app: &axum::Router) -> (StatusCode, Bytes) {\n+/// `/health` and SageMaker's `/ping`, which Python serves with the same handler.\n+const HEALTH_ROUTES: [(&str, &str); 3] = [(\"GET\", \"/health\"), (\"GET\", \"/ping\"), (\"POST\", \"/ping\")];\n+\n+async fn health_status(app: &axum::Router, method: &str, uri: &str) -> (StatusCode, Bytes) {\n     let response = app\n         .clone()\n         .call(\n             Request::builder()\n-                .method(\"GET\")\n-                .uri(\"/health\")\n+                .method(method)\n+                .uri(uri)\n                 .body(Body::empty())\n                 .expect(\"build request\"),\n         )\n@@ -4862,9 +4866,11 @@ async fn health_endpoint_returns_ok_with_empty_body_when_client_is_healthy() {\n     let (app, _state, engine_task) =\n         test_health_app_with_engine_script(|_push| boxed_test_future(async move {})).await;\n \n-    let (status, body) = health_status(&app).await;\n-    assert_eq!(status, StatusCode::OK);\n-    assert!(body.is_empty(), \"expected empty body, got {:?}\", body);\n+    for (method, uri) in HEALTH_ROUTES {\n+        let (status, body) = health_status(&app, method, uri).await;\n+        assert_eq!(status, StatusCode::OK, \"{method} {uri}\");\n+        assert!(body.is_empty(), \"{method} {uri}: {body:?}\");\n+    }\n \n     engine_task.await.expect(\"mock engine task\");\n }\n@@ -4889,9 +4895,11 @@ async fn health_endpoint_returns_503_after_engine_core_dead_sentinel() {\n     .await\n     .expect(\"wait for unhealthy client\");\n \n-    let (status, body) = health_status(&app).await;\n-    assert_eq!(status, StatusCode::SERVICE_UNAVAILABLE);\n-    assert!(body.is_empty(), \"expected empty body, got {:?}\", body);\n+    for (method, uri) in HEALTH_ROUTES {\n+        let (status, body) = health_status(&app, method, uri).await;\n+        assert_eq!(status, StatusCode::SERVICE_UNAVAILABLE, \"{method} {uri}\");\n+        assert!(body.is_empty(), \"{method} {uri}: {body:?}\");\n+    }\n     assert!(matches!(\n         state.chat.engine_core_client().health_error().as_deref(),\n         Some(vllm_engine_core_client::Error::EngineCoreDead)",
