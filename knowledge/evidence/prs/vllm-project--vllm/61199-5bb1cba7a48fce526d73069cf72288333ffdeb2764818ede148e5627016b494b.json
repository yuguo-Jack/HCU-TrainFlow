      "changes": 62,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Fanthropic%2Ftest_anthropic_messages_conversion.py?ref=957e1e9b484fb50698ad0e9232e5e9bd29327f75",
      "deletions": 0,
      "filename": "tests/entrypoints/anthropic/test_anthropic_messages_conversion.py",
      "patch": "@@ -475,6 +475,68 @@ def test_system_string_unchanged(self):\n         assert system_msg[\"content\"] == \"You are a helpful assistant.\"\n \n \n+class TestUnsupportedSystemContentWarning:\n+    \"\"\"Unsupported (non-text) Anthropic system content blocks are dropped\n+    for backward compatibility, but must not be dropped silently.\"\"\"\n+\n+    def test_top_level_image_block_warns_and_ignored(self, caplog):\n+        \"\"\"An image block in the top-level system field is ignored with a\n+        warning, while text blocks are preserved.\"\"\"\n+        request = _make_request(\n+            [{\"role\": \"user\", \"content\": \"Hello\"}],\n+            system=[\n+                {\"type\": \"text\", \"text\": \"You are a helpful assistant.\"},\n+                {\n+                    \"type\": \"image\",\n+                    \"source\": {\n+                        \"type\": \"base64\",\n+                        \"media_type\": \"image/jpeg\",\n+                        \"data\": \"iVBORw0KGgo=\",\n+                    },\n+                },\n+            ],\n+        )\n+        result = _convert(request)\n+        system_msg = result.messages[0]\n+        assert system_msg[\"role\"] == \"system\"\n+        assert system_msg[\"content\"] == \"You are a helpful assistant.\"\n+        assert any(\n+            \"should only contain text content\" in r.message and \"image\" in r.message\n+            for r in caplog.records\n+        )\n+\n+    def test_inline_system_image_block_warns_and_ignored(self, caplog):\n+        \"\"\"An image block in an inline system message is ignored with a\n+        warning instead of being silently dropped.\"\"\"\n+        request = _make_request(\n+            [\n+                {\n+                    \"role\": \"system\",\n+                    \"content\": [\n+                        {\"type\": \"text\", \"text\": \"Be concise.\"},\n+                        {\n+                            \"type\": \"image\",\n+                            \"source\": {\n+                                \"type\": \"base64\",\n+                                \"media_type\": \"image/png\",\n+                                \"data\": \"aGVsbG8=\",\n+                            },\n+                        },\n+                    ],\n+                },\n+                {\"role\": \"user\", \"content\": \"Hello\"},\n+            ],\n+        )\n+        result = _convert(request)\n+        system_msgs = [m for m in result.messages if m[\"role\"] == \"system\"]\n+        assert system_msgs\n+        assert all(m[\"content\"] == \"Be concise.\" for m in system_msgs)\n+        assert any(\n+            \"should only contain text content\" in r.message and \"image\" in r.message\n+            for r in caplog.records\n+        )\n+\n+\n # ======================================================================\n # Thinking block conversion (Anthropic → OpenAI)\n # ======================================================================",
      "raw_url": "https://github.com/vllm-project/vllm/raw/957e1e9b484fb50698ad0e9232e5e9bd29327f75/tests%2Fentrypoints%2Fanthropic%2Ftest_anthropic_messages_conversion.py",
      "sha": "0fedb38b7570d185845393c5345fb64abc3c1b1e",
      "status": "modified"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/vllm-project/vllm/blob/957e1e9b484fb50698ad0e9232e5e9bd29327f75/vllm%2Fentrypoints%2Fanthropic%2Fserving.py",
      "changes": 20,
