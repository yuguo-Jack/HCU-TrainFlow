      "deletions": 2,
      "filename": "vllm/entrypoints/anthropic/serving.py",
      "patch": "@@ -365,7 +365,15 @@ def _convert_system_message(\n                 system_parts.append(anthropic_request.system)\n             else:\n                 for block in anthropic_request.system:\n-                    if block.type == \"text\" and block.text:\n+                    if block.type != \"text\":\n+                        logger.warning_once(\n+                            \"Anthropic system messages should only contain \"\n+                            \"text content. Found content type: '%s'; it will \"\n+                            \"be ignored.\",\n+                            block.type,\n+                        )\n+                        continue\n+                    if block.text:\n                         # Strip Claude Code's attribution header which contains\n                         # a per-request hash that defeats prefix caching.\n                         if block.text.startswith(\"x-anthropic-billing-header\"):\n@@ -396,7 +404,15 @@ def _extract_system_text(cls, msg) -> str | None:\n             return text\n         parts: list[str] = []\n         for block in msg.content:\n-            if block.type == \"text\" and block.text:\n+            if block.type != \"text\":\n+                logger.warning_once(\n+                    \"Anthropic system messages should only contain \"\n+                    \"text content. Found content type: '%s'; it will \"\n+                    \"be ignored.\",\n+                    block.type,\n+                )\n+                continue\n+            if block.text:\n                 if block.text.startswith(\"x-anthropic-billing-header\"):\n                     continue\n                 parts.append(block.text)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/957e1e9b484fb50698ad0e9232e5e9bd29327f75/vllm%2Fentrypoints%2Fanthropic%2Fserving.py",
