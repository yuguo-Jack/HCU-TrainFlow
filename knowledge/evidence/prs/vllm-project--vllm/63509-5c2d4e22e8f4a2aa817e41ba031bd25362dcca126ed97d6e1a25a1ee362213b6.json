  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/aea7eab40d89c374673c0bc5847b62f60317ec64/docs%2Fmodels%2Fstructured_decisions_models.md",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Fmodels%2Fstructured_decisions_models.md?ref=aea7eab40d89c374673c0bc5847b62f60317ec64",
      "deletions": 0,
      "filename": "docs/models/structured_decisions_models.md",
      "patch": "@@ -54,6 +54,10 @@ log probabilities.\n \n Thinking is off unless `chat_template_kwargs` turns it on.\n \n+Some models have `<think>` in their template, and it cannot be disabled,\n+causing the next-token read to fail. The endpoint returns 501 in these\n+cases.\n+\n Probabilities can differ between identical requests. They depend on which\n requests share a batch and on whether a read hits the prefix cache. Set\n `VLLM_BATCH_INVARIANT=1` for reads that repeat exactly, at a cost in",
      "raw_url": "https://github.com/vllm-project/vllm/raw/aea7eab40d89c374673c0bc5847b62f60317ec64/docs%2Fmodels%2Fstructured_decisions_models.md",
      "sha": "e774e9c8be8fca1f312c9a7f6f80fdad605a5ace",
      "status": "modified"
    },
    {
      "additions": 56,
      "blob_url": "https://github.com/vllm-project/vllm/blob/aea7eab40d89c374673c0bc5847b62f60317ec64/tests%2Fentrypoints%2Fgenerate%2Fstructured_decisions%2Ftest_structured_decisions_e2e.py",
      "changes": 56,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Fgenerate%2Fstructured_decisions%2Ftest_structured_decisions_e2e.py?ref=aea7eab40d89c374673c0bc5847b62f60317ec64",
      "deletions": 0,
      "filename": "tests/entrypoints/generate/structured_decisions/test_structured_decisions_e2e.py",
      "patch": "@@ -258,3 +258,59 @@ def test_validation_errors(server, questions, match):\n     response = post(server, {\"model\": MODEL_NAME, \"state\": \"x\", \"questions\": questions})\n     assert response.status_code == 400\n     assert match in response.json()[\"error\"][\"message\"]\n+\n+\n+@pytest.fixture(scope=\"module\")\n+def thinking_template_server(tmp_path_factory):\n+    template = tmp_path_factory.mktemp(\"thinking-template\") / \"chat.jinja\"\n+    template.write_text(\n+        \"{% for message in messages %}\"\n+        \"{{ '<|im_start|>' + message['role'] + '\\n' \"\n+        \"+ message['content'] + '<|im_end|>\\n' }}\"\n+        \"{% endfor %}\"\n+        \"{% if add_generation_prompt %}\"\n+        \"{{ '<|im_start|>assistant\\n' }}\"\n+        \"{{ thought_prefix | default('<think>\\n\\n') }}\"\n+        \"{% endif %}\"\n+    )\n+    with RemoteOpenAIServer(\n+        MODEL_NAME,\n+        [\n+            \"--chat-template\",\n+            str(template),\n+            \"--max-model-len\",\n+            \"1024\",\n+            \"--gpu-memory-utilization\",\n+            \"0.9\",\n+            \"--enforce-eager\",\n+            \"--logprobs-mode\",\n+            \"raw_logprobs\",\n+        ],\n+    ) as remote_server:\n+        yield remote_server\n+\n+\n+@pytest.mark.parametrize(\n+    \"suffix,status\",\n+    [(\"<think>\\n\\n\", 501), (\"<think>\\n\\n</think>\\n\\n\", 200)],\n+)\n+def test_next_token_requires_answer_outside_thinking(\n+    thinking_template_server, suffix, status\n+):\n+    \"\"\"Only an open thought in the generation suffix makes reads unsupported.\"\"\"\n+    response = post(\n+        thinking_template_server,\n+        {\n+            \"state\": \"The user wrote <think> in their message.\",\n+            \"questions\": {\"q\": choice(\"Which label?\", \"a\", \"b\")},\n+            \"chat_template_kwargs\": {\"thought_prefix\": suffix},\n+        },\n+    )\n+    assert response.status_code == status, response.text\n+    body = response.json()\n+    if status == 501:\n+        assert body[\"error\"][\"type\"] == \"NotImplementedError\"\n+        assert \"requires an immediate answer label\" in body[\"error\"][\"message\"]\n+        assert \"unreliable answer probabilities\" in body[\"error\"][\"message\"]\n+    else:\n+        assert set(body[\"answers\"][\"q\"][\"probabilities\"]) == {\"a\", \"b\"}",
      "raw_url": "https://github.com/vllm-project/vllm/raw/aea7eab40d89c374673c0bc5847b62f60317ec64/tests%2Fentrypoints%2Fgenerate%2Fstructured_decisions%2Ftest_structured_decisions_e2e.py",
      "sha": "44d0827475a60fee664493678f14e9595c42635d",
      "status": "modified"
    },
    {
      "additions": 35,
      "blob_url": "https://github.com/vllm-project/vllm/blob/aea7eab40d89c374673c0bc5847b62f60317ec64/vllm%2Fentrypoints%2Fgenerate%2Fstructured_decisions%2Fserving.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fentrypoints%2Fgenerate%2Fstructured_decisions%2Fserving.py?ref=aea7eab40d89c374673c0bc5847b62f60317ec64",
