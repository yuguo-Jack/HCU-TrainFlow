    {
      "additions": 34,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ca09894a328421736184308329c15152dfe2e8e1/tests%2Fkernels%2Fmoe%2Ftest_nvfp4_moe_quant_config_reload.py",
      "changes": 34,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fmoe%2Ftest_nvfp4_moe_quant_config_reload.py?ref=ca09894a328421736184308329c15152dfe2e8e1",
      "deletions": 0,
      "filename": "tests/kernels/moe/test_nvfp4_moe_quant_config_reload.py",
      "patch": "@@ -0,0 +1,34 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import torch\n+\n+from vllm.model_executor.layers.fused_moe.oracle.nvfp4 import (\n+    NvFp4MoeBackend,\n+    make_nvfp4_moe_quant_config,\n+)\n+\n+\n+def test_input_gscale_storage_is_stable_across_rebuilds():\n+    \"\"\"Rebuilding the quant config (as every reload does) must update the input\n+    global scales in the storage captured by the first config.\"\"\"\n+    layer = torch.nn.Module()\n+    scale = torch.ones(4, 4, 4, dtype=torch.float8_e4m3fn)\n+\n+    def build(input_scale):\n+        return make_nvfp4_moe_quant_config(\n+            backend=NvFp4MoeBackend.FLASHINFER_TRTLLM,\n+            w13_scale=scale,\n+            w2_scale=scale,\n+            w13_scale_2=torch.ones(4),\n+            w2_scale_2=torch.ones(4),\n+            a13_scale=torch.full((4,), input_scale),\n+            a2_scale=torch.full((4,), input_scale),\n+            layer=layer,\n+        )\n+\n+    first = build(2.0)\n+    second = build(8.0)\n+    assert second.a1_gscale.data_ptr() == first.a1_gscale.data_ptr()\n+    assert second.a2_gscale.data_ptr() == first.a2_gscale.data_ptr()\n+    torch.testing.assert_close(first.a1_gscale, torch.full((4,), 1 / 8.0))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ca09894a328421736184308329c15152dfe2e8e1/tests%2Fkernels%2Fmoe%2Ftest_nvfp4_moe_quant_config_reload.py",
      "sha": "673ee959d0429e17b1c8c74c2d682a5eaab5e58d",
      "status": "added"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ca09894a328421736184308329c15152dfe2e8e1/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Foracle%2Fnvfp4.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Foracle%2Fnvfp4.py?ref=ca09894a328421736184308329c15152dfe2e8e1",
      "deletions": 2,
      "filename": "vllm/model_executor/layers/fused_moe/oracle/nvfp4.py",
      "patch": "@@ -36,6 +36,7 @@\n from vllm.model_executor.layers.quantization.utils.quant_utils import (\n     QuantKey,\n )\n+from vllm.model_executor.utils import replace_parameter\n \n logger = init_logger(__name__)\n \n@@ -584,11 +585,17 @@ def make_nvfp4_moe_quant_config(\n     # The expert's process_weights_after_loading will fuse activation\n     # scales in-place. Since the quant config references the same tensor\n     # as the registered parameter, EPLB rearrangement stays in sync.\n+    a1_gscale, a2_gscale = 1.0 / a13_scale, 1.0 / a2_scale\n+    if layer is not None:\n+        # Graph-visible: keep them as layer parameters so reload restores them in place.\n+        replace_parameter(layer, \"moe_a1_gscale\", a1_gscale, prefer_copy=True)\n+        replace_parameter(layer, \"moe_a2_gscale\", a2_gscale, prefer_copy=True)\n+        a1_gscale, a2_gscale = layer.moe_a1_gscale, layer.moe_a2_gscale\n     return nvfp4_moe_quant_config(\n         g1_alphas=w13_scale_2,\n         g2_alphas=w2_scale_2,\n-        a1_gscale=(1.0 / a13_scale),\n-        a2_gscale=(1.0 / a2_scale),\n+        a1_gscale=a1_gscale,\n+        a2_gscale=a2_gscale,\n         w1_scale=w13_scale,\n         w2_scale=w2_scale,\n         # NOTE(rob): this is a hack until the MoE kernels",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ca09894a328421736184308329c15152dfe2e8e1/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Foracle%2Fnvfp4.py",
      "sha": "ec2c6a9dee354d6f79dbde196176fc55d890785b",
      "status": "modified"
    }
