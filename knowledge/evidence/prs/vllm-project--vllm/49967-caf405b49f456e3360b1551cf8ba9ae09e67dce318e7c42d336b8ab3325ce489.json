      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/38a44b6bee014d021ffa7aef2c13468a571d2a23/tests%2Fentrypoints%2Fopenai%2Fresponses%2Ftest_parsable_context_unit.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Fopenai%2Fresponses%2Ftest_parsable_context_unit.py?ref=38a44b6bee014d021ffa7aef2c13468a571d2a23",
      "deletions": 0,
      "filename": "tests/entrypoints/openai/responses/test_parsable_context_unit.py",
      "patch": "@@ -6,6 +6,7 @@\n Parser (via parse) and properly builds response output items.\n \"\"\"\n \n+import asyncio\n import json\n from collections.abc import Sequence\n from types import SimpleNamespace\n@@ -480,3 +481,15 @@ def test_length_truncation_marks_last_item_incomplete():\n     ctx.append_output(_make_request_output(text=\"cut mid sen\", finish_reason=\"length\"))\n     assert ctx.response_messages[-1].type == \"message\"\n     assert ctx.response_messages[-1].status == \"incomplete\"\n+\n+\n+def test_call_python_tool_missing_code_raises_value_error():\n+    \"\"\"code_interpreter args that omit 'code' must raise a controlled\n+    ValueError, not an uncaught KeyError -> HTTP 500 (issue #49954).\"\"\"\n+    ctx = _make_context(None)\n+    # Valid JSON, but no required \"code\" field.\n+    last_msg = FunctionCall(\n+        id=\"call_1\", name=\"code_interpreter\", arguments='{\"language\": \"python\"}'\n+    )\n+    with pytest.raises(ValueError, match=\"code\"):\n+        asyncio.run(ctx.call_python_tool(MagicMock(), last_msg))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/38a44b6bee014d021ffa7aef2c13468a571d2a23/tests%2Fentrypoints%2Fopenai%2Fresponses%2Ftest_parsable_context_unit.py",
      "sha": "a3222e4e6fecf173996ebfaf2f7690d62ff7389f",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/38a44b6bee014d021ffa7aef2c13468a571d2a23/vllm%2Fentrypoints%2Fopenai%2Fresponses%2Fcontext.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fentrypoints%2Fopenai%2Fresponses%2Fcontext.py?ref=38a44b6bee014d021ffa7aef2c13468a571d2a23",
      "deletions": 0,
      "filename": "vllm/entrypoints/openai/responses/context.py",
      "patch": "@@ -454,6 +454,10 @@ async def call_python_tool(\n         if isinstance(tool_session, Tool):\n             return await tool_session.get_result_parsable_context(self)\n         args = json.loads(last_msg.arguments)\n+        if \"code\" not in args:\n+            raise ValueError(\n+                \"code_interpreter tool call is missing the required 'code' field.\"\n+            )\n         param = {\n             \"code\": args[\"code\"],\n         }",
      "raw_url": "https://github.com/vllm-project/vllm/raw/38a44b6bee014d021ffa7aef2c13468a571d2a23/vllm%2Fentrypoints%2Fopenai%2Fresponses%2Fcontext.py",
