      "deletions": 5,
      "filename": ".buildkite/test_areas/kernels.yaml",
      "patch": "@@ -524,8 +524,9 @@ steps:\n       - pytest -v -s tests/kernels/attention/test_rocm_aiter_mla_op_registration.py\n       - pytest -v -s tests/kernels/attention/test_rocm_triton_attn_dsv4.py::test_dsv41_adaptive_mla_swa_metadata_graph_replay\n \n-- label: \":nvidia: (L4) Quantization Kernels Shard %N\"\n+- label: \":nvidia: (L4) Quantization Kernels\"\n   key: kernels-quantization-test\n+  automatic_shard: true\n   device: l4\n   num_devices: 1\n   timeout_in_minutes: 30\n@@ -534,11 +535,16 @@ steps:\n   - vllm/model_executor/layers/quantization\n   - tests/kernels/quantization\n   commands:\n-    - pytest -v -s kernels/quantization --shard-id=$$BUILDKITE_PARALLEL_JOB --num-shards=$$BUILDKITE_PARALLEL_JOB_COUNT\n-  parallelism: 6\n+    # test_cutlass_scaled_mm.py and test_fp8_quant.py each run in their own\n+    # pytest: test_fp8_quant.py ran 2.4x slower after test_cutlass_scaled_mm.py\n+    # in one process.\n+    - pytest -v -s kernels/quantization --ignore=kernels/quantization/test_cutlass_scaled_mm.py --ignore=kernels/quantization/test_fp8_quant.py\n+    - pytest -v -s kernels/quantization/test_cutlass_scaled_mm.py\n+    - pytest -v -s kernels/quantization/test_fp8_quant.py\n   mirror:\n     amd:\n-      label: \":amd: (MI300) Quantization Kernels Shard %N\"\n+      automatic_shard: true\n+      label: \":amd: (MI300) Quantization Kernels\"\n       dind: false\n       device: mi300_1\n       timeout_in_minutes: 120\n@@ -561,7 +567,7 @@ steps:\n       depends_on:\n       - image-build-amd\n       commands:\n-      - pytest -v -s kernels/quantization -k \"not test_nvfp4_dense_emulation\" --shard-id=$$BUILDKITE_PARALLEL_JOB --num-shards=$$BUILDKITE_PARALLEL_JOB_COUNT\n+      - pytest -v -s kernels/quantization -k \"not test_nvfp4_dense_emulation\"\n \n - label: \":nvidia: (L4) MoE Kernels\"\n   key: kernels-moe-test",
      "raw_url": "https://github.com/vllm-project/vllm/raw/3a3180dc5284b9395f784b0e1efb0e862a76be4c/.buildkite%2Ftest_areas%2Fkernels.yaml",
