      "blob_url": "https://github.com/vllm-project/vllm/blob/cc93cc86c5c4ead18830e4c4610d6b7f7c6b8339/tests%2Ftool_parsers%2Ftest_structural_tag_registry.py",
      "changes": 63,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_parsers%2Ftest_structural_tag_registry.py?ref=cc93cc86c5c4ead18830e4c4610d6b7f7c6b8339",
      "deletions": 0,
      "filename": "tests/tool_parsers/test_structural_tag_registry.py",
      "patch": "@@ -56,6 +56,7 @@\n from vllm.tool_parsers.step3p5_tool_parser import Step3p5ToolParser\n from vllm.tool_parsers.structural_tag_registry import (\n     SUPPORTED_STRUCTURAL_TAG_MODELS,\n+    TOOL_CALL_MAX_WHITESPACE_CNT,\n     VLLM_BUILTIN_STRUCTURAL_TAG_MODELS,\n     XGRAMMAR_BUILTIN_STRUCTURAL_TAG_MODELS,\n     ToolChoice,\n@@ -1798,6 +1799,7 @@ def test_glm47_strict_only_matches_xgrammar_builtin(tool_choice: str, reasoning:\n         tools=dumped,\n         tool_choice=builtin_choice,\n         reasoning=reasoning,\n+        max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n     )\n \n     assert isinstance(ours, StructuralTag)\n@@ -1829,6 +1831,7 @@ def test_glm47_parameter_level_pins_schemas_like_the_builtin(\n         ],\n         tool_choice=\"required\",\n         reasoning=False,\n+        max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n     )\n \n     assert isinstance(ours, StructuralTag)\n@@ -2222,3 +2225,63 @@ def test_responses_parallel_tool_calls_false_limits_grammar_to_one_call():\n     assert grammar is not None\n     assert _is_grammar_accept_string(grammar, call)\n     assert not _is_grammar_accept_string(grammar, call * 2)\n+\n+\n+@pytest.mark.parametrize(\"strict\", [False, True])\n+def test_glm47_tool_call_whitespace_is_bounded(strict: bool):\n+    \"\"\"Whitespace runs inside a tool call are capped, so a model whose preferred\n+    token is masked out cannot spin on whitespace until ``max_tokens`` (#55541).\"\"\"\n+    tool = ChatCompletionToolsParam(\n+        type=\"function\",\n+        function={\n+            \"name\": \"create_job_posting\",\n+            \"strict\": strict,\n+            \"parameters\": {\n+                \"type\": \"object\",\n+                \"properties\": {\n+                    \"title\": {\"type\": \"string\"},\n+                    \"salary\": {\n+                        \"type\": \"object\",\n+                        \"properties\": {\"min\": {\"type\": \"integer\"}},\n+                    },\n+                },\n+                \"required\": [\"title\", \"salary\"],\n+            },\n+        },\n+    )\n+    tag = get_model_structural_tag(\n+        \"glm_4_7\",\n+        [tool],\n+        ChatCompletionNamedToolChoiceParam(\n+            function=ChatCompletionNamedFunction(name=\"create_job_posting\")\n+        ),\n+        reasoning=False,\n+    )\n+    grammar = Grammar.from_structural_tag(tag)\n+\n+    def call(gap: str) -> str:\n+        return (\n+            \"<tool_call>create_job_posting\"\n+            \"<arg_key>title</arg_key><arg_value>Engineer</arg_value>\"\n+            f'<arg_key>salary</arg_key><arg_value>{{{gap}\"min\": 1}}</arg_value>'\n+            \"</tool_call>\"\n+        )\n+\n+    assert _is_grammar_accept_string(grammar, call(\"\\n    \"))\n+    assert not _is_grammar_accept_string(grammar, call(\"\\n\" * 100))\n+\n+\n+def test_hermes_tool_call_whitespace_is_bounded(sample_tools_strict):\n+    tag = get_model_structural_tag(\n+        \"hermes\", sample_tools_strict, \"required\", reasoning=False\n+    )\n+    grammar = Grammar.from_structural_tag(tag)\n+\n+    def call(gap: str) -> str:\n+        return (\n+            '<tool_call>{\"name\": \"get_weather\", \"arguments\": {'\n+            f'{gap}\"city\": \"Paris\"}}}}</tool_call>'\n+        )\n+\n+    assert _is_grammar_accept_string(grammar, call(\"\\n  \"))\n+    assert not _is_grammar_accept_string(grammar, call(\" \" * 100))",
      "raw_url": "https://github.com/vllm-project/vllm/raw/cc93cc86c5c4ead18830e4c4610d6b7f7c6b8339/tests%2Ftool_parsers%2Ftest_structural_tag_registry.py",
      "sha": "f63bc053df6412a7928d9cdfaf04a0588b8a9fba",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/vllm-project/vllm/blob/cc93cc86c5c4ead18830e4c4610d6b7f7c6b8339/vllm%2Ftool_parsers%2Fstructural_tag_registry.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fstructural_tag_registry.py?ref=cc93cc86c5c4ead18830e4c4610d6b7f7c6b8339",
      "deletions": 5,
      "filename": "vllm/tool_parsers/structural_tag_registry.py",
      "patch": "@@ -45,6 +45,13 @@\n     require_function_tools,\n )\n \n+# Longest run of consecutive whitespace characters allowed inside a tool call.\n+# Every value boundary in a structural tag otherwise admits unbounded\n+# whitespace, so a model whose preferred next token is masked out can spin on\n+# whitespace tokens until ``max_tokens`` (#55541). 64 characters still covers\n+# any pretty-printed arguments a model actually emits.\n+TOOL_CALL_MAX_WHITESPACE_CNT = 64\n+\n ToolChoice: TypeAlias = (\n     Literal[\"none\", \"auto\", \"required\"]\n     | ChatCompletionNamedToolChoiceParam\n@@ -247,6 +254,7 @@ def get_model_structural_tag(\n         tools=dumped_tools,\n         tool_choice=dumped_tool_choice,\n         reasoning=reasoning,\n+        max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n     )\n \n \n@@ -374,7 +382,8 @@ def _hermes_tool_tags(\n         TagFormat(\n             begin=begin + tool.function.name + arguments_field_prefix,\n             content=JSONSchemaFormat(\n-                json_schema=get_function_parameters(tool.function)\n+                json_schema=get_function_parameters(tool.function),\n+                max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n             ),\n             end=end,\n         )\n@@ -448,6 +457,7 @@ def _minimax_tool_tags(tools: list[FunctionToolParam]) -> list[TagFormat]:\n             content=JSONSchemaFormat(\n                 json_schema=get_function_parameters(tool.function),\n                 style=\"minimax_xml\",\n+                max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n             ),\n             end=\"</invoke>\\n\",\n         )\n@@ -554,7 +564,8 @@ def get_plamo3_structural_tag(\n                 + _PLAMO3_BEGIN_TOOL_ARGUMENTS\n             ),\n             content=JSONSchemaFormat(\n-                json_schema=get_function_parameters(tool.function)\n+                json_schema=get_function_parameters(tool.function),\n+                max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n             ),\n             end=_PLAMO3_END_TOOL_ARGUMENTS + _PLAMO3_END_TOOL_REQUEST,\n         )\n@@ -716,7 +727,9 @@ def _k3_argument_tag(\n             embedded = dict(prop)\n             for defs_key, defs_value in root_defs.items():\n                 embedded.setdefault(defs_key, defs_value)\n-        content = JSONSchemaFormat(json_schema=embedded)\n+        content = JSONSchemaFormat(\n+            json_schema=embedded, max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT\n+        )\n     return TagFormat(begin=begin, content=content, end=_K3_ARG_CLOSE)\n \n \n@@ -1025,7 +1038,9 @@ def _glm_4_7_value_format(prop: dict[str, Any]) -> Any:\n         return formats[0] if len(formats) == 1 else OrFormat(elements=formats)\n     if prop_type in (None, \"string\"):\n         return AnyTextFormat(excludes=_GLM_4_7_VALUE_EXCLUDES)\n-    return JSONSchemaFormat(json_schema={\"type\": prop_type})\n+    return JSONSchemaFormat(\n+        json_schema={\"type\": prop_type}, max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT\n+    )\n \n \n def _glm_4_7_plain_properties(params: dict[str, Any]) -> dict[str, Any] | None:\n@@ -1051,7 +1066,10 @@ def _glm_4_7_tool_tag(tool: FunctionToolParam) -> TagFormat:\n         return TagFormat(\n             begin=f\"<tool_call>{tool.function.name}\",\n             content=JSONSchemaFormat(\n-                json_schema=True, style=\"glm_xml\", any_order=False\n+                json_schema=True,\n+                style=\"glm_xml\",\n+                any_order=False,\n+                max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n             ),\n             end=\"</tool_call>\",\n         )\n@@ -1087,6 +1105,7 @@ def _glm_4_7_strict_tool_tag(tool: FunctionToolParam) -> TagFormat:\n             else True,\n             style=\"glm_xml\",\n             any_order=False,\n+            max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n         ),\n         end=\"</tool_call>\",\n     )\n@@ -1134,6 +1153,7 @@ def get_glm_4_7_structural_tag(\n             tools=dumped_tools,\n             tool_choice=dumped_choice,\n             reasoning=reasoning,\n+            max_whitespace_cnt=TOOL_CALL_MAX_WHITESPACE_CNT,\n         )\n \n     tags = [",
