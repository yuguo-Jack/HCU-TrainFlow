  "files": [
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/470547f9d79355d09dd4597f21c4ba2b039ae4ad/docs%2Ffeatures%2Fmultimodal_inputs.md",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Ffeatures%2Fmultimodal_inputs.md?ref=470547f9d79355d09dd4597f21c4ba2b039ae4ad",
      "deletions": 0,
      "filename": "docs/features/multimodal_inputs.md",
      "patch": "@@ -644,6 +644,13 @@ Our OpenAI-compatible server accepts multi-modal data via the [Chat Completions\n     For certain models, we provide alternative chat templates inside [examples](../../examples).\n     For example, VLM2Vec uses [examples/pooling/embed/template/vlm2vec_phi3v.jinja](../../examples/pooling/embed/template/vlm2vec_phi3v.jinja) which is different from the default one for Phi-3-Vision.\n \n+### Media Download Cache\n+\n+Set `VLLM_MEDIA_CACHE` to a directory to cache media downloaded from URLs on disk.\n+This cache is disabled by default. If another request evicts an entry while it\n+is being read, vLLM downloads the media again. The source URL must still be\n+accessible when this happens.\n+\n ### Image Inputs\n \n Image input is supported according to [OpenAI Vision API](https://platform.openai.com/docs/guides/vision).",
      "raw_url": "https://github.com/vllm-project/vllm/raw/470547f9d79355d09dd4597f21c4ba2b039ae4ad/docs%2Ffeatures%2Fmultimodal_inputs.md",
      "sha": "68b23597925ee194c9933fc55ee88eab980889ee",
      "status": "modified"
    },
    {
      "additions": 110,
      "blob_url": "https://github.com/vllm-project/vllm/blob/470547f9d79355d09dd4597f21c4ba2b039ae4ad/tests%2Fmultimodal%2Fmedia%2Ftest_connector.py",
      "changes": 110,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmultimodal%2Fmedia%2Ftest_connector.py?ref=470547f9d79355d09dd4597f21c4ba2b039ae4ad",
      "deletions": 0,
      "filename": "tests/multimodal/media/test_connector.py",
      "patch": "@@ -4,7 +4,10 @@\n import mimetypes\n import os\n import shutil\n+import threading\n import time\n+from concurrent.futures import ThreadPoolExecutor\n+from contextlib import contextmanager\n from io import BytesIO\n from tempfile import NamedTemporaryFile, TemporaryDirectory\n \n@@ -21,6 +24,7 @@\n from vllm.multimodal.image import convert_image_mode\n from vllm.multimodal.inputs import PlaceholderRange\n from vllm.multimodal.media import MediaConnector\n+from vllm.sampling_params import SamplingParams\n \n # Test different image extensions (JPG/PNG) and formats (gray/RGB/RGBA)\n TEST_IMAGE_ASSETS = [\n@@ -579,3 +583,109 @@ def test_get_cached_bytes_file_deleted_before_read():\n         connector._media_cache_path(url).unlink()\n \n         assert connector._get_cached_bytes(url) is None\n+\n+\n+@pytest.fixture\n+def cached_image_eviction(local_asset_server, tmp_path, monkeypatch):\n+    monkeypatch.setenv(\"VLLM_MEDIA_CACHE\", str(tmp_path))\n+    # Each write keeps only its own entry, so a second image evicts the first.\n+    monkeypatch.setenv(\"VLLM_MEDIA_CACHE_MAX_SIZE_MB\", \"0\")\n+    monkeypatch.setenv(\"VLLM_MEDIA_CACHE_TTL_HOURS\", \"24\")\n+    reader = MediaConnector()\n+    writer = MediaConnector()\n+    url = local_asset_server.url_for(\"RGBA_comp.png\")\n+    other_url = local_asset_server.url_for(\"Grayscale_8bits_palette_sample_image.png\")\n+    writer.fetch_image(other_url)\n+\n+    cache_path = reader._media_cache_path(url)\n+\n+    @contextmanager\n+    def evict_after_stat():\n+        stat_done = threading.Event()\n+        eviction_done = threading.Event()\n+        original_stat = os.stat\n+\n+        def stat_then_wait(path, *args, **kwargs):\n+            result = original_stat(path, *args, **kwargs)\n+            if path == cache_path and not stat_done.is_set():\n+                stat_done.set()\n+                assert eviction_done.wait(timeout=10)\n+            return result\n+\n+        def evict():\n+            try:\n+                assert stat_done.wait(timeout=10)\n+                writer.fetch_image(other_url)\n+                assert not cache_path.exists()\n+            finally:\n+                eviction_done.set()\n+\n+        with monkeypatch.context() as patch, ThreadPoolExecutor(max_workers=1) as pool:\n+            patch.setattr(os, \"stat\", stat_then_wait)\n+            eviction = pool.submit(evict)\n+            try:\n+                yield\n+            finally:\n+                eviction.result(timeout=10)\n+        assert stat_done.is_set()\n+\n+    return reader, url, evict_after_stat\n+\n+\n+@pytest.mark.asyncio\n+@pytest.mark.parametrize(\"use_async\", [False, True], ids=[\"sync\", \"async\"])\n+async def test_fetch_image_cache_evicted_after_stat(cached_image_eviction, use_async):\n+    \"\"\"Concurrent eviction must fall back to downloading a valid image.\"\"\"\n+    reader, url, evict_after_stat = cached_image_eviction\n+    expected = reader.fetch_image(url)\n+    cache_path = reader._media_cache_path(url)\n+    cached_bytes = cache_path.read_bytes()\n+    old_time = time.time() - 60\n+    os.utime(cache_path, (old_time, old_time))\n+    assert _image_equals(reader.fetch_image(url), expected)\n+    assert cache_path.stat().st_mtime > old_time\n+\n+    with evict_after_stat():\n+        image = (\n+            await reader.fetch_image_async(url)\n+            if use_async\n+            else reader.fetch_image(url)\n+        )\n+\n+    assert _image_equals(image, expected)\n+    assert cache_path.read_bytes() == cached_bytes\n+    assert _image_equals(reader.fetch_image(url), expected)\n+\n+\n+def test_chat_cache_evicted_after_stat(cached_image_eviction, vllm_runner):\n+    \"\"\"A chat request must survive media eviction and preserve its output.\"\"\"\n+    reader, url, evict_after_stat = cached_image_eviction\n+    messages = [\n+        {\n+            \"role\": \"user\",\n+            \"content\": [\n+                {\"type\": \"image_url\", \"image_url\": {\"url\": url}},\n+                {\"type\": \"text\", \"text\": \"Describe this image.\"},\n+            ],\n+        }\n+    ]\n+    sampling_params = SamplingParams(temperature=0, max_tokens=1)\n+    with vllm_runner(\n+        \"HuggingFaceTB/SmolVLM-256M-Instruct\",\n+        enforce_eager=True,\n+        max_model_len=8192,\n+        max_num_seqs=1,\n+        mm_processor_cache_gb=0,\n+        enable_prefix_caching=False,\n+    ) as runner:\n+        expected = runner.llm.chat(messages, sampling_params=sampling_params)[0]\n+        cache_path = reader._media_cache_path(url)\n+        cached_bytes = cache_path.read_bytes()\n+\n+        with evict_after_stat():\n+            output = runner.llm.chat(messages, sampling_params=sampling_params)[0]\n+\n+        assert output.prompt_token_ids == expected.prompt_token_ids\n+        assert output.outputs[0].token_ids\n+        assert output.outputs[0].token_ids == expected.outputs[0].token_ids\n+        assert cache_path.read_bytes() == cached_bytes",
      "raw_url": "https://github.com/vllm-project/vllm/raw/470547f9d79355d09dd4597f21c4ba2b039ae4ad/tests%2Fmultimodal%2Fmedia%2Ftest_connector.py",
      "sha": "d1ba1112c6a9f21fe41b7799ebe1fcdcafab57a9",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/470547f9d79355d09dd4597f21c4ba2b039ae4ad/vllm%2Fmultimodal%2Fmedia%2Fconnector.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmultimodal%2Fmedia%2Fconnector.py?ref=470547f9d79355d09dd4597f21c4ba2b039ae4ad",
      "deletions": 1,
      "filename": "vllm/multimodal/media/connector.py",
      "patch": "@@ -259,7 +259,7 @@ def _get_cached_bytes(self, url: str) -> bytes | None:\n             return None\n         # Touch mtime for LRU ordering\n         try:\n-            cache_path.touch()\n+            os.utime(cache_path, None)\n             return cache_path.read_bytes()\n         except OSError:\n             return None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/470547f9d79355d09dd4597f21c4ba2b039ae4ad/vllm%2Fmultimodal%2Fmedia%2Fconnector.py",
