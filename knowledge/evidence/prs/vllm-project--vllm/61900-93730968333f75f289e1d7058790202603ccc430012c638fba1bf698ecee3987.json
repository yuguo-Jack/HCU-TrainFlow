      "filename": "vllm/distributed/device_communicators/all2all.py",
      "patch": "@@ -269,6 +269,7 @@ class DeepEPHTAll2AllManager(DeepEPAll2AllManagerBase):\n \n     def __init__(self, cpu_group, tcp_store_group=None):\n         super().__init__(cpu_group, tcp_store_group)\n+        self.num_sms = envs.VLLM_DEEPEP_HIGH_THROUGHPUT_NUM_SMS\n \n     def _make_all2all_kwargs(self) -> dict[Any, Any]:\n         # Defaults for internode and intranode are taken from DeepEP tests.\n@@ -310,6 +311,8 @@ def get_handle(self, kwargs):\n         handle: deep_ep.Buffer = self.handle_cache.get_or_create(\n             buffer_kwargs, deep_ep.Buffer\n         )\n+        # DeepEP's SM count is global; without DBO nothing else sets it.\n+        deep_ep.Buffer.set_num_sms(self.num_sms)\n         return handle\n \n     def set_num_sms(self, num_sms: int):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5e1111d27d35715e1bcf469d1a9a9c380011b619/vllm%2Fdistributed%2Fdevice_communicators%2Fall2all.py",
