      "filename": "vllm/envs.py",
      "patch": "@@ -288,6 +288,7 @@\n     VLLM_OBJECT_STORAGE_SHM_BUFFER_NAME: str = \"VLLM_OBJECT_STORAGE_SHM_BUFFER\"\n     VLLM_DEEPEP_BUFFER_SIZE_MB: int = 1024\n     VLLM_DEEPEP_HIGH_THROUGHPUT_FORCE_INTRA_NODE: bool = False\n+    VLLM_DEEPEP_HIGH_THROUGHPUT_NUM_SMS: int = 20\n     VLLM_DEEPEP_LOW_LATENCY_USE_MNNVL: bool = False\n     VLLM_DEEPEP_V2_ALLOW_HYBRID_MODE: bool = True\n     VLLM_DEEPEP_V2_PREFER_OVERLAP: bool = False\n@@ -2034,6 +2035,12 @@ def _resolve_rust_cli_path() -> str | None:\n     \"VLLM_DEEPEP_HIGH_THROUGHPUT_FORCE_INTRA_NODE\": lambda: bool(\n         int(os.getenv(\"VLLM_DEEPEP_HIGH_THROUGHPUT_FORCE_INTRA_NODE\", \"0\"))\n     ),\n+    # Number of SMs DeepEP high-throughput dispatch/combine kernels use.\n+    # 20 is DeepEP's default. GPUs with more SMs can benefit from a higher\n+    # value; larger values may need a larger VLLM_DEEPEP_BUFFER_SIZE_MB.\n+    \"VLLM_DEEPEP_HIGH_THROUGHPUT_NUM_SMS\": lambda: int(\n+        os.getenv(\"VLLM_DEEPEP_HIGH_THROUGHPUT_NUM_SMS\", \"20\")\n+    ),\n     # Allow DeepEP to use MNNVL (multi-node nvlink) for internode_ll kernel,\n     # turn this for better latency on GB200 like system\n     \"VLLM_DEEPEP_LOW_LATENCY_USE_MNNVL\": lambda: bool(",
