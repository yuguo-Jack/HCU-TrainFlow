      "blob_url": "https://github.com/vllm-project/vllm/blob/9f50ba4958232451851f27ae4c3157a5c8c8b1a3/.buildkite%2Ftest-amd.yaml",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/.buildkite%2Ftest-amd.yaml?ref=9f50ba4958232451851f27ae4c3157a5c8c8b1a3",
      "deletions": 1,
      "filename": ".buildkite/test-amd.yaml",
      "patch": "@@ -1527,7 +1527,55 @@ steps:\n   commands:\n   - pytest -v -s kernels/moe --ignore=kernels/moe/test_modular_oai_triton_moe.py --ignore=kernels/moe/test_modular_kernel_combinations.py --shard-id=$$BUILDKITE_PARALLEL_JOB --num-shards=$$BUILDKITE_PARALLEL_JOB_COUNT\n   - pytest -v -s kernels/moe/test_modular_oai_triton_moe.py --shard-id=$$BUILDKITE_PARALLEL_JOB --num-shards=$$BUILDKITE_PARALLEL_JOB_COUNT\n-  - VLLM_ROCM_USE_AITER=1 VLLM_ROCM_USE_AITER_MOE=1 pytest -v -s kernels/moe/test_modular_kernel_combinations.py -k \"not multigpu\" --shard-id=$$BUILDKITE_PARALLEL_JOB --num-shards=$$BUILDKITE_PARALLEL_JOB_COUNT\n+\n+# Not hash-sharded: fp8 per-tensor CK MoE kernels JIT-compile (~10 min each, ROCm/aiter#5766), so their tests share one job.\n+- label: \":amd: (MI300) MoE Kernels AITER FP8 Per-Tensor\" # TBD\n+  timeout_in_minutes: 60\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx942nightly, amdmi300]\n+  dind: false\n+  agent_pool: mi300_1\n+  optional: true\n+  working_dir: \"/vllm-workspace/tests\"\n+  source_file_dependencies:\n+  - csrc/quantization/w8a8/cutlass/moe/\n+  - csrc/moe/\n+  - csrc/rocm/\n+  - tests/kernels/moe\n+  - tests/kernels/utils.py\n+  - vllm/model_executor/layers/fused_moe/\n+  - vllm/model_executor/layers/quantization/mxfp4.py\n+  - vllm/model_executor/layers/quantization/utils/quant_utils.py\n+  - vllm/distributed/device_communicators/\n+  - vllm/envs.py\n+  - vllm/config\n+  - vllm/_aiter_ops.py\n+  - vllm/platforms/rocm.py\n+  commands:\n+  - VLLM_ROCM_USE_AITER=1 VLLM_ROCM_USE_AITER_MOE=1 pytest -v -s kernels/moe/test_modular_kernel_combinations.py -k \"not multigpu and (fp8_tensor or AiterFp8TensorExperts)\"\n+\n+- label: \":amd: (MI300) MoE Kernels AITER Other\" # TBD\n+  timeout_in_minutes: 60\n+  mirror_hardwares: [amdexperimental, amdproduction, amdgfx942nightly, amdmi300]\n+  dind: false\n+  agent_pool: mi300_1\n+  optional: true\n+  working_dir: \"/vllm-workspace/tests\"\n+  source_file_dependencies:\n+  - csrc/quantization/w8a8/cutlass/moe/\n+  - csrc/moe/\n+  - csrc/rocm/\n+  - tests/kernels/moe\n+  - tests/kernels/utils.py\n+  - vllm/model_executor/layers/fused_moe/\n+  - vllm/model_executor/layers/quantization/mxfp4.py\n+  - vllm/model_executor/layers/quantization/utils/quant_utils.py\n+  - vllm/distributed/device_communicators/\n+  - vllm/envs.py\n+  - vllm/config\n+  - vllm/_aiter_ops.py\n+  - vllm/platforms/rocm.py\n+  commands:\n+  - VLLM_ROCM_USE_AITER=1 VLLM_ROCM_USE_AITER_MOE=1 pytest -v -s kernels/moe/test_modular_kernel_combinations.py -k \"not multigpu and not (fp8_tensor or AiterFp8TensorExperts)\"\n \n - label: \":amd: (MI300) MoE Kernels Multi-GPU\" # TBD\n   timeout_in_minutes: 30",
