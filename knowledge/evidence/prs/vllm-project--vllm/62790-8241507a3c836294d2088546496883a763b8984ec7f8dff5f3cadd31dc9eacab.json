      "additions": 33,
      "blob_url": "https://github.com/vllm-project/vllm/blob/3015bb2fdb984d23039c71124e9eaea8f9d55588/tests%2Fv1%2Fworker%2Ftest_gpu_row_offsets_i64.py",
      "changes": 34,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fworker%2Ftest_gpu_row_offsets_i64.py?ref=3015bb2fdb984d23039c71124e9eaea8f9d55588",
      "deletions": 1,
      "filename": "tests/v1/worker/test_gpu_row_offsets_i64.py",
      "patch": "@@ -1,6 +1,7 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n-\"\"\"int64 row offsets in the MRV2 staged-write and idx-mapping kernels.\n+\"\"\"int64 row offsets in the MRV2 staged-write, idx-mapping and grammar-bitmask\n+kernels.\n \n With int32 request-slot indices, `slot * stride` wraps once the product\n crosses 2**31 (issue #57030): at max_model_len=1M from row 2148, and from\n@@ -12,6 +13,7 @@\n \n from types import SimpleNamespace\n \n+import numpy as np\n import pytest\n import torch\n \n@@ -21,6 +23,7 @@\n from vllm.v1.worker.gpu.input_batch import post_update\n from vllm.v1.worker.gpu.mm.rope import RopeState\n from vllm.v1.worker.gpu.sample.penalties import bincount\n+from vllm.v1.worker.gpu.structured_outputs import StructuredOutputsWorker\n \n STRIDE = 1_000_000  # max_model_len\n ROW = 2559  # ROW * STRIDE > 2**31 (first overflowing row at 1M: 2148)\n@@ -201,3 +204,32 @@ def test_rope_positions_high_row():\n     assert torch.equal(rope.positions[:, PREFILL_LEN : 2 * PREFILL_LEN], expect_target)\n     # Padding column stays zero.\n     assert bool((rope.positions[:, 2 * PREFILL_LEN :] == 0).all())\n+\n+\n+def test_grammar_bitmask_high_row():\n+    \"\"\"The grammar bitmask must mask its logits row past the int32 offset limit,\n+    e.g. under wide spec-decode verification with a large batch.\"\"\"\n+    device = torch.device(\"cuda:0\")\n+    high_row = 2**31 // VOCAB_SIZE + 1  # high_row * VOCAB_SIZE > 2**31\n+    logits = torch.zeros(high_row + 1, VOCAB_SIZE, dtype=torch.bfloat16, device=device)\n+    allowed_token = 5\n+    bitmask = np.zeros((2, VOCAB_SIZE // 32), dtype=np.int32)\n+    bitmask[:, 0] = 1 << allowed_token\n+    # Request \"low\" owns rows [0, high_row), request \"high\" owns row high_row.\n+    input_batch = SimpleNamespace(\n+        req_ids=[\"low\", \"high\"],\n+        cu_num_logits=torch.tensor(\n+            [0, high_row, high_row + 1], dtype=torch.int32, device=device\n+        ),\n+    )\n+\n+    worker = StructuredOutputsWorker(\n+        max_num_logits=2, vocab_size=VOCAB_SIZE, device=device, mask_stride=1\n+    )\n+    worker.apply_grammar_bitmask(logits, input_batch, [\"low\", \"high\"], bitmask)\n+    torch.accelerator.synchronize()\n+\n+    for row in (0, high_row):\n+        masked = logits[row].isinf()\n+        assert not masked[allowed_token]\n+        assert int(masked.sum()) == VOCAB_SIZE - 1",
      "raw_url": "https://github.com/vllm-project/vllm/raw/3015bb2fdb984d23039c71124e9eaea8f9d55588/tests%2Fv1%2Fworker%2Ftest_gpu_row_offsets_i64.py",
      "sha": "61cb0db9be1ef1518ef60b4c4c6fb55996ced66c",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/3015bb2fdb984d23039c71124e9eaea8f9d55588/vllm%2Fv1%2Fworker%2Fgpu%2Fstructured_outputs.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu%2Fstructured_outputs.py?ref=3015bb2fdb984d23039c71124e9eaea8f9d55588",
      "deletions": 1,
      "filename": "vllm/v1/worker/gpu/structured_outputs.py",
      "patch": "@@ -143,7 +143,7 @@ def _apply_grammar_bitmask_kernel(\n     mapping_idx = tl.load(logits_indices_ptr + bitmask_idx)\n     req_idx = mapping_idx // MASK_STRIDE\n     position_idx = mapping_idx % MASK_STRIDE\n-    logits_idx = tl.load(cu_num_logits_ptr + req_idx)\n+    logits_idx = tl.load(cu_num_logits_ptr + req_idx).to(tl.int64)\n     num_req_logits = tl.load(cu_num_logits_ptr + req_idx + 1) - logits_idx\n     logits_idx += position_idx\n     position_is_active = position_idx < num_req_logits",
      "raw_url": "https://github.com/vllm-project/vllm/raw/3015bb2fdb984d23039c71124e9eaea8f9d55588/vllm%2Fv1%2Fworker%2Fgpu%2Fstructured_outputs.py",
      "sha": "0d804f7f0ee1a0615bd3db64b8915259153f601e",
      "status": "modified"
    }
