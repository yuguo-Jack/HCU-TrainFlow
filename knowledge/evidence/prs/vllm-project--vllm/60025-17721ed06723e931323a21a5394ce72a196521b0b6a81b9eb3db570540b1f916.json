  "files": [
    {
      "additions": 18,
      "blob_url": "https://github.com/vllm-project/vllm/blob/43439ad6a8f4858ec3cc262a4769beec4147cb76/docker%2FDockerfile.xpu",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile.xpu?ref=43439ad6a8f4858ec3cc262a4769beec4147cb76",
      "deletions": 5,
      "filename": "docker/Dockerfile.xpu",
      "patch": "@@ -170,7 +170,7 @@ FROM vllm-base AS ucx-nixl-build\n # Keep UCX_VERSION aligned with the UCX that NIXL itself builds against for this\n # NIXL_VERSION (nixl contrib/Dockerfile.manylinux: ARG UCX_REF), so XPU runs the\n # same UCX commit as the released nixl-cu* wheels rather than an untested pairing.\n-ARG UCX_VERSION=v1.23.x\n+ARG UCX_VERSION=90c8961021dcf72357e076845857d7a235e2bb88\n ARG NIXL_VERSION=v1.5.0\n \n # Build-time only: compiler, autotools, and verbs dev headers\n@@ -188,11 +188,24 @@ RUN apt-get update -y && apt-get install -y --no-install-recommends \\\n # patchelf (installed via uv) is used by the NIXL wheel build to rewrite\n # RPATH entries, making the wheel portable across stages.\n RUN --mount=type=cache,target=/root/.cache/uv \\\n-    git clone --depth 1 --branch \"${UCX_VERSION}\" https://github.com/openucx/ucx /tmp/ucx_source && \\\n-    cd /tmp/ucx_source && \\\n+    git clone https://github.com/openucx/ucx /tmp/ucx_source && \\\n+    cd /tmp/ucx_source && git checkout \"${UCX_VERSION}\" && \\\n     bash autogen.sh && \\\n-    ./configure --prefix=/opt/ucx --with-ze=yes --enable-examples --enable-mt && \\\n-    make CFLAGS=\"-Wno-error=incompatible-pointer-types\" -j\"$(nproc)\" && make install && \\\n+    ./contrib/configure-release \\\n+        --prefix=/opt/ucx \\\n+        --with-ze \\\n+        --enable-shared \\\n+        --disable-static \\\n+        --disable-doxygen-doc \\\n+        --enable-optimizations \\\n+        --enable-cma \\\n+        --enable-devel-headers \\\n+        --with-verbs \\\n+        --with-dm \\\n+        --with-efa \\\n+        --without-cuda \\\n+        --enable-mt && \\\n+    make -j\"$(nproc)\" && make install && \\\n     git clone --depth 1 --branch \"${NIXL_VERSION}\" https://github.com/ai-dynamo/nixl /tmp/nixl_source && \\\n     cd /tmp/nixl_source && \\\n     uv pip install --upgrade meson pybind11 patchelf && \\",
      "raw_url": "https://github.com/vllm-project/vllm/raw/43439ad6a8f4858ec3cc262a4769beec4147cb76/docker%2FDockerfile.xpu",
      "sha": "897a2682cf8f21abfa663c6173debe0f6fe24138",
