      "deletions": 1,
      "filename": "vllm/v1/attention/backends/triton_flash_attn.py",
      "patch": "@@ -5,6 +5,7 @@\n import torch\n \n from vllm.config.cache import CacheDType\n+from vllm.platforms import current_platform\n from vllm.platforms.interface import DeviceCapability\n from vllm.v1.attention.backends.composite import (\n     MMPrefixAttentionRouting,\n@@ -16,6 +17,13 @@\n \n \n class _FABackend(FlashAttentionBackend):\n+    @classmethod\n+    def supports_compute_capability(cls, capability: DeviceCapability) -> bool:\n+        if current_platform.is_xpu():\n+            return True\n+        # CUDA: Hopper only; Blackwell uses the Triton/FlashInfer composite.\n+        return capability.major == 9 and super().supports_compute_capability(capability)\n+\n     @classmethod\n     def supports_combination(\n         cls,\n@@ -42,6 +50,8 @@ def supports_combination(\n         )\n         if reason is not None:\n             return reason\n+        if current_platform.is_xpu():\n+            return None\n         fa_version = get_flash_attn_version(\n             head_size=head_size,\n             has_sinks=has_sink,\n@@ -61,5 +71,4 @@ def supports_combination(\n     module=__name__,\n     routing_policy=MMPrefixAttentionRouting,\n     head_sizes=(256, 512),\n-    device_major=9,\n )",
