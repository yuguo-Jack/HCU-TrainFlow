      "deletions": 0,
      "filename": "vllm/v1/attention/backends/flash_attn.py",
      "patch": "@@ -425,6 +425,9 @@ def supports_head_size(cls, head_size: int) -> bool:\n             return False\n         if head_size <= 256:\n             return True\n+        if current_platform.is_xpu():\n+            # The XPU SYCL kernels support head sizes up to 512.\n+            return head_size <= 512\n         if is_fa_version_supported(4):\n             return head_size <= 512\n         return False",
      "raw_url": "https://github.com/vllm-project/vllm/raw/73bf07f70a72f54a573bcbea9e5b0d0a7bfa2f6d/vllm%2Fv1%2Fattention%2Fbackends%2Fflash_attn.py",
