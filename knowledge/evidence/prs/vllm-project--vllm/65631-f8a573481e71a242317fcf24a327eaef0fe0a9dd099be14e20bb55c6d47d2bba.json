      "changes": 54,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_connector%2Funit%2Foffloading_connector%2Ftest_scheduler.py?ref=c435cde07a19893e9f61ddc7ede91bd8d90a5786",
      "deletions": 0,
      "filename": "tests/v1/kv_connector/unit/offloading_connector/test_scheduler.py",
      "patch": "@@ -782,6 +782,60 @@ def test_max_load_tokens_rounds_down_without_partial_tail():\n     assert scheduler.get_num_new_matched_tokens(request, 0) == (16, True)\n \n \n+@pytest.mark.parametrize(\n+    (\"cap_chunks\", \"expected_tokens\"),\n+    [\n+        pytest.param(1, 16, id=\"one-chunk-cap\"),\n+        pytest.param(2, 32, id=\"two-chunk-cap\"),\n+        pytest.param(None, 64, id=\"uncapped-preserves-prompt-end-rule\"),\n+    ],\n+)\n+def test_max_load_tokens_preserves_aligned_sliding_window_chunk(\n+    request_runner, cap_chunks, expected_tokens\n+):\n+    \"\"\"A whole-chunk cap with sliding window groups loads exactly that many\n+    chunks.\"\"\"\n+    block_size = 4\n+    blocks_per_chunk = 4\n+    tokens_per_chunk = block_size * blocks_per_chunk\n+    spec_kwargs: dict[str, Any] = dict(\n+        block_size=block_size, num_kv_heads=1, head_size=1, dtype=torch.float32\n+    )\n+    kv_cache_groups = [\n+        KVCacheGroupSpec([\"full\"], FullAttentionSpec(**spec_kwargs)),\n+        KVCacheGroupSpec(\n+            [\"sliding\"],\n+            SlidingWindowSpec(\n+                **spec_kwargs,\n+                sliding_window=2 * tokens_per_chunk,\n+            ),\n+        ),\n+    ]\n+    runner = request_runner(\n+        block_size=block_size,\n+        blocks_per_chunk=blocks_per_chunk,\n+        num_gpu_blocks=100,\n+        async_scheduling=False,\n+        kv_cache_groups=kv_cache_groups,\n+    )\n+    kv_transfer_params = (\n+        None\n+        if cap_chunks is None\n+        else {\"max_load_tokens\": cap_chunks * tokens_per_chunk}\n+    )\n+    runner.new_request(\n+        token_ids=[0] * (4 * tokens_per_chunk + 1),\n+        kv_transfer_params=kv_transfer_params,\n+    )\n+    request = runner.scheduler.requests[str(runner.req_id)]\n+    runner.manager.lookup.return_value = LookupResult.HIT\n+\n+    assert runner.connector_scheduler.get_num_new_matched_tokens(request, 0) == (\n+        expected_tokens,\n+        True,\n+    )\n+\n+\n @pytest.mark.parametrize(\"value\", [\"8\", 8.5, -1, True])\n def test_invalid_max_load_tokens_is_ignored(value):\n     scheduler = _make_partial_tail_scheduler()",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c435cde07a19893e9f61ddc7ede91bd8d90a5786/tests%2Fv1%2Fkv_connector%2Funit%2Foffloading_connector%2Ftest_scheduler.py",
      "sha": "cbf871e7c5c4ca0f54cce2c9eeae6a7f52a40f72",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c435cde07a19893e9f61ddc7ede91bd8d90a5786/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Foffloading%2Fscheduler.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Foffloading%2Fscheduler.py?ref=c435cde07a19893e9f61ddc7ede91bd8d90a5786",
      "deletions": 10,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py",
      "patch": "@@ -919,6 +919,12 @@ def _lookup_complete_chunks(\n         \"\"\"\n         num_computed_tokens = req_status.num_locally_computed_tokens\n         max_hit_size_tokens: int = req_status.req.num_tokens\n+        if self._sliding_window_groups:\n+            # the last prompt token has to be recomputed to get the logprobs\n+            # for sliding window attention, we must reduce by 1 to make sure\n+            # we still have a hit after reduction. Tighter caps below are\n+            # already supported boundaries and are not reduced.\n+            max_hit_size_tokens -= 1\n         if max_num_new_tokens is not None:\n             max_hit_size_tokens = min(\n                 max_hit_size_tokens, num_computed_tokens + max_num_new_tokens\n@@ -928,16 +934,11 @@ def _lookup_complete_chunks(\n                 max_hit_size_tokens,\n                 num_computed_tokens + req_status.max_load_tokens,\n             )\n-        if self._sliding_window_groups:\n-            # the last prompt token has to be recomputed to get the logprobs\n-            # for sliding window attention, we must reduce by 1 to make sure\n-            # we still have a hit after reduction\n-            max_hit_size_tokens -= 1\n-            if self._mamba_align_size is not None:\n-                # Constrain hit-window to the mamba block size.\n-                max_hit_size_tokens = round_down(\n-                    max_hit_size_tokens, self._mamba_align_size\n-                )\n+        if self._sliding_window_groups and self._mamba_align_size is not None:\n+            # Constrain hit-window to the mamba block size.\n+            max_hit_size_tokens = round_down(\n+                max_hit_size_tokens, self._mamba_align_size\n+            )\n \n         num_hit_tokens: int = 0\n         defer_lookup = False",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c435cde07a19893e9f61ddc7ede91bd8d90a5786/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Foffloading%2Fscheduler.py",
      "sha": "566e7abe5b0a9317f924edff52c339f806d18a32",
