      "blob_url": "https://github.com/vllm-project/vllm/blob/6d9082eb6cd69c50085731620ee951a88e6aa3c6/vllm%2Fdistributed%2Feplb%2Feplb_communicator.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Feplb%2Feplb_communicator.py?ref=6d9082eb6cd69c50085731620ee951a88e6aa3c6",
      "deletions": 1,
      "filename": "vllm/distributed/eplb/eplb_communicator.py",
      "patch": "@@ -689,6 +689,9 @@ def add_send(\n     ) -> None:\n         self._ensure_group_started()\n         for tensor in tensors:\n+            # NCCL has no UE8M0 dtype; P2P byte views preserve every scale bit.\n+            if tensor.dtype == torch.float8_e8m0fnu:\n+                tensor = tensor.view(torch.uint8)\n             self._pynccl_comm.send(tensor, dst_rank, stream=self._stream)\n \n     def add_recv(\n@@ -699,6 +702,8 @@ def add_recv(\n     ) -> None:\n         self._ensure_group_started()\n         for tensor in tensors:\n+            if tensor.dtype == torch.float8_e8m0fnu:\n+                tensor = tensor.view(torch.uint8)\n             self._pynccl_comm.recv(tensor, src_rank, stream=self._stream)\n \n     def execute(self) -> None:\n@@ -752,7 +757,8 @@ def _create_pynccl() -> EplbCommunicator:\n             {\n                 tensor.dtype\n                 for tensor in first_layer\n-                if not ncclDataTypeEnum.supports_torch_dtype(tensor.dtype)\n+                if tensor.dtype != torch.float8_e8m0fnu\n+                and not ncclDataTypeEnum.supports_torch_dtype(tensor.dtype)\n             },\n             key=str,\n         )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6d9082eb6cd69c50085731620ee951a88e6aa3c6/vllm%2Fdistributed%2Feplb%2Feplb_communicator.py",
