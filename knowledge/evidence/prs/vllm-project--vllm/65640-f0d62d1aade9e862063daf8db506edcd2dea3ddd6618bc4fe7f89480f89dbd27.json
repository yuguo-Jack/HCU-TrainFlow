      "additions": 32,
      "blob_url": "https://github.com/vllm-project/vllm/blob/20e3356120512908ccf538b4650152ebb0599f96/tests%2Fv1%2Fkv_connector%2Funit%2Foffloading_connector%2Ftest_scheduler.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_connector%2Funit%2Foffloading_connector%2Ftest_scheduler.py?ref=20e3356120512908ccf538b4650152ebb0599f96",
      "deletions": 0,
      "filename": "tests/v1/kv_connector/unit/offloading_connector/test_scheduler.py",
      "patch": "@@ -147,6 +147,38 @@ def __iter__(self):\n                 assert context.get_offload_key_position(key) == chunk_idx * stride * 16\n \n \n+def test_streaming_resume_refreshes_recomputed_offload_keys():\n+    scheduler = _make_partial_tail_scheduler()\n+    scheduler.use_lookahead_block_hashes = True\n+    request = _make_partial_tail_request(scheduler, num_tokens=160)\n+    request.resumable = True\n+    state = scheduler._req_status[request.request_id]\n+    state.update_offload_keys()\n+    old_keys = [list(group.offload_keys) for group in state.group_states]\n+\n+    # Core recomputes the hashes after the request loses its resident KV.\n+    request.block_hashes[16:] = [\n+        BlockHash(f\"new{i}\".encode()) for i in range(len(request.block_hashes) - 16)\n+    ]\n+    scheduler._lookup = MagicMock(return_value=0)\n+    assert scheduler.get_num_new_matched_tokens(request, 0) == (0, False)\n+\n+    for config, group, old in zip(\n+        scheduler.config.kv_group_configs, state.group_states, old_keys\n+    ):\n+        expected = [\n+            make_offload_key(block_hash, config.group_idx)\n+            for block_hash in request.block_hashes[\n+                config.hashes_per_chunk - 1 :: config.hashes_per_chunk\n+            ]\n+        ]\n+        unchanged_chunks = 16 // config.hashes_per_chunk\n+        assert 0 < unchanged_chunks < len(old)\n+        assert group.offload_keys[:unchanged_chunks] == old[:unchanged_chunks]\n+        assert group.offload_keys[unchanged_chunks:] != old[unchanged_chunks:]\n+        assert group.offload_keys == expected\n+\n+\n @pytest.mark.parametrize(\n     \"window,extra_retained\", [(128, 0), (128, 3), (256, 1), (256, 3)]\n )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/20e3356120512908ccf538b4650152ebb0599f96/tests%2Fv1%2Fkv_connector%2Funit%2Foffloading_connector%2Ftest_scheduler.py",
      "sha": "69d5c24f1b9f9d85fe84fc84755dfdcae455ffde",
      "status": "modified"
    },
    {
      "additions": 29,
      "blob_url": "https://github.com/vllm-project/vllm/blob/20e3356120512908ccf538b4650152ebb0599f96/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Foffloading%2Fscheduler.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Foffloading%2Fscheduler.py?ref=20e3356120512908ccf538b4650152ebb0599f96",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/offloading/scheduler.py",
      "patch": "@@ -425,6 +425,33 @@ def update_offload_keys(self) -> None:\n                     len(group_state.offload_keys) * group_config.tokens_per_chunk,\n                 )\n \n+    def refresh_recomputed_offload_keys(self) -> None:\n+        # Chained hashes make matching keys a prefix, so find the first\n+        # changed chunk without scanning or rebuilding the unchanged prefix.\n+        for group_config, group_state in zip(\n+            self.config.kv_group_configs, self.group_states\n+        ):\n+            keys = group_state.offload_keys\n+            if not keys:\n+                continue\n+            hashes = self.req.block_hashes\n+            stride = group_config.hashes_per_chunk\n+            available = min(len(keys), len(hashes) // stride)\n+            if available == len(keys) and keys[-1] == make_offload_key(\n+                hashes[available * stride - 1], group_config.group_idx\n+            ):\n+                continue\n+            lo, hi = 0, available\n+            while lo < hi:\n+                mid = (lo + hi) // 2\n+                if keys[mid] == make_offload_key(\n+                    hashes[(mid + 1) * stride - 1], group_config.group_idx\n+                ):\n+                    lo = mid + 1\n+                else:\n+                    hi = mid\n+            del keys[lo:]\n+\n     def update_block_id_groups(\n         self, new_block_id_groups: tuple[list[int], ...] | None\n     ) -> None:\n@@ -1399,6 +1426,8 @@ def get_num_new_matched_tokens(\n             )\n             return None, False\n \n+        if request.resumable and self.use_lookahead_block_hashes:\n+            req_status.refresh_recomputed_offload_keys()\n         req_status.update_offload_keys()\n         req_status.num_locally_computed_tokens = num_computed_tokens\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/20e3356120512908ccf538b4650152ebb0599f96/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Foffloading%2Fscheduler.py",
      "sha": "76d5c193ad0fdac3b3824d1c91d2b6b314cae3e5",
      "status": "modified"
    }
