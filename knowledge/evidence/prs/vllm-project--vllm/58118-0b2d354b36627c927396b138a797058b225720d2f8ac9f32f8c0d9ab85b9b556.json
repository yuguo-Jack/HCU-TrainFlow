  "files": [
    {
      "additions": 23,
      "blob_url": "https://github.com/vllm-project/vllm/blob/14a652d46f6d4c03872486b9b362169b522618b6/vllm%2Fmodel_executor%2Flayers%2Flayernorm.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Flayernorm.py?ref=14a652d46f6d4c03872486b9b362169b522618b6",
      "deletions": 0,
      "filename": "vllm/model_executor/layers/layernorm.py",
      "patch": "@@ -331,6 +331,29 @@ def forward_cuda(\n     def forward_xpu(\n         self, x: torch.Tensor, z: torch.Tensor | None = None\n     ) -> torch.Tensor:\n+        if (\n+            not torch.compiler.is_compiling()\n+            and not torch.is_grad_enabled()\n+            and x.shape in ((16, 128), (24, 128))\n+            and x.dtype == torch.float16\n+            and x.is_contiguous()\n+            and z is not None\n+            and z.shape == x.shape\n+            and z.dtype == x.dtype\n+            and z.device == x.device\n+            and z.is_contiguous()\n+            and self.weight.shape == (128,)\n+            and self.weight.dtype == x.dtype\n+            and self.weight.device == x.device\n+            and self.weight.is_contiguous()\n+            and self.bias is None\n+            and self.group_size is None\n+            and self.norm_before_gate\n+            and self.activation in (\"silu\", \"swish\")\n+        ):\n+            out = torch.empty_like(x)\n+            torch.ops._C.rms_norm_gated_decode(out, x, z, self.weight, self.eps)\n+            return out\n         return self.forward_cuda(x, z)\n \n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/14a652d46f6d4c03872486b9b362169b522618b6/vllm%2Fmodel_executor%2Flayers%2Flayernorm.py",
      "sha": "126e854334dce424bf0f41a4ffad41b18df74b1c",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "What kind of benefit using this kernel? seems it's not a good idea to adopt under such a strict check and it may break xpu graph.",
      "created_at": "2026-09-27T06:43:20Z",
      "diff_hunk": "@@ -349,11 +331,36 @@ def forward_cuda(\n     def forward_xpu(\n         self, x: torch.Tensor, z: torch.Tensor | None = None\n     ) -> torch.Tensor:\n+        if (\n+            not torch.compiler.is_compiling()\n+            and not torch.is_grad_enabled()\n+            and x.shape in ((16, 128), (24, 128))\n+            and x.dtype == torch.float16\n+            and x.is_contiguous()\n+            and z is not None\n+            and z.shape == x.shape\n+            and z.dtype == x.dtype\n+            and z.device == x.device\n+            and z.is_contiguous()\n+            and self.weight.shape == (128,)\n+            and self.weight.dtype == x.dtype\n+            and self.weight.device == x.device\n+            and self.weight.is_contiguous()\n+            and self.bias is None\n+            and self.group_size is None\n+            and self.norm_before_gate\n+            and self.activation in (\"silu\", \"swish\")\n+        ):\n+            out = torch.empty_like(x)",
      "html_url": "https://github.com/vllm-project/vllm/pull/58118#discussion_r4114368049",
      "id": 4114368049,
      "line": 354,
      "original_line": 354,
      "path": "vllm/model_executor/layers/layernorm.py",
      "updated_at": "2026-09-27T06:43:20Z",
      "user": {
        "login": "yma11"
      }
    },
    {
      "body": "The kernel is in [#608](https://github.com/vllm-project/vllm-xpu-kernels/pull/608 )\r\nThis is to replace native ops to the sycltla fused kernel when torch compile is not activated.\r\nThe e2e time (including host) of kernel in decode side for Qwen35BA3B drop from 200+us to 9us.  This benefit is coming from submit overhead reduction.\r\nEven compile is on,  the kernel is triton kernel. The E2E drop still from 50us to 9us, since triton kernel submit overhead is higher.\r\nThe E2E TPOT will drop about ~5ms in TP2.   @xiangyuT has more details about this kernel's benefit.",
      "created_at": "2026-09-27T13:13:09Z",
      "diff_hunk": "@@ -349,11 +331,36 @@ def forward_cuda(\n     def forward_xpu(\n         self, x: torch.Tensor, z: torch.Tensor | None = None\n     ) -> torch.Tensor:\n+        if (\n+            not torch.compiler.is_compiling()\n+            and not torch.is_grad_enabled()\n+            and x.shape in ((16, 128), (24, 128))\n+            and x.dtype == torch.float16\n+            and x.is_contiguous()\n+            and z is not None\n+            and z.shape == x.shape\n+            and z.dtype == x.dtype\n+            and z.device == x.device\n+            and z.is_contiguous()\n+            and self.weight.shape == (128,)\n+            and self.weight.dtype == x.dtype\n+            and self.weight.device == x.device\n+            and self.weight.is_contiguous()\n+            and self.bias is None\n+            and self.group_size is None\n+            and self.norm_before_gate\n+            and self.activation in (\"silu\", \"swish\")\n+        ):\n+            out = torch.empty_like(x)",
      "html_url": "https://github.com/vllm-project/vllm/pull/58118#discussion_r4115479206",
      "id": 4115479206,
      "line": 354,
