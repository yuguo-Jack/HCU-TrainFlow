      "blob_url": "https://github.com/vllm-project/vllm/blob/f85e13e976dc217462c1890fd72fb64c7c46184a/tests%2Flora%2Ftest_lora_manager.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Flora%2Ftest_lora_manager.py?ref=f85e13e976dc217462c1890fd72fb64c7c46184a",
      "deletions": 0,
      "filename": "tests/lora/test_lora_manager.py",
      "patch": "@@ -1062,6 +1062,42 @@ def test_packed_loras(default_vllm_config, dist_init, dummy_model_gate_up, devic\n     )\n \n \n+@pytest.mark.parametrize(\"device\", DEVICES)\n+def test_packed_loras_repeated_submodule(\n+    default_vllm_config, dist_init, dummy_model_gate_up, device\n+):\n+    model = dummy_model_gate_up\n+    model.packed_modules_mapping = {\"gate_up_proj\": [\"gate_proj\", \"gate_proj\"]}\n+    model_lora = create_packed_lora(\n+        1,\n+        model,\n+        module_name=\"gate_up_proj\",\n+        replaced_module_names=[\"gate_proj\", \"up_proj\"],\n+        device=device,\n+        empty_replaced_module_name=\"up_proj\",\n+    )\n+    gate_lora = model_lora.get_lora(\"gate_proj\")\n+\n+    manager = LoRAModelManager(\n+        model,\n+        2,\n+        2,\n+        2,\n+        LoRAConfig(\n+            max_lora_rank=8, max_cpu_loras=2, max_loras=2, lora_dtype=DEFAULT_DTYPE\n+        ),\n+        device=device,\n+        vllm_config=default_vllm_config,\n+    )\n+    assert manager.add_adapter(model_lora)\n+\n+    packed_lora = model_lora.get_lora(\"gate_up_proj\")\n+    assert isinstance(packed_lora, PackedLoRALayerWeights)\n+    for i in range(2):\n+        torch.testing.assert_close(packed_lora.lora_a[i], gate_lora.lora_a)\n+        torch.testing.assert_close(packed_lora.lora_b[i], gate_lora.lora_b)\n+\n+\n def _test_target_modules(\n     model,\n     target_modules: list[str] | None,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f85e13e976dc217462c1890fd72fb64c7c46184a/tests%2Flora%2Ftest_lora_manager.py",
      "sha": "699397be46dde40e3c90509fd262fd99914161ee",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f85e13e976dc217462c1890fd72fb64c7c46184a/tests%2Fmodels%2Flanguage%2Fgeneration%2Ftest_gemma.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Flanguage%2Fgeneration%2Ftest_gemma.py?ref=f85e13e976dc217462c1890fd72fb64c7c46184a",
      "deletions": 7,
      "filename": "tests/models/language/generation/test_gemma.py",
      "patch": "@@ -125,10 +125,10 @@ def __init__(self, *, vllm_config, prefix):\n @pytest.mark.cpu_test\n def test_gemma4_attention_mapper() -> None:\n     \"\"\"Layers with a qkv_proj pack q/k/v; `attention_k_eq_v` full-attention\n-    layers also load K as the V shard, and leave any v_proj such a checkpoint\n-    ships unmapped so it fails the load rather than silently overwriting V;\n-    KV-shared layers keep q_proj and drop the K/V tensors original checkpoints\n-    still ship for them.\"\"\"\n+    layers pack into qkk_proj, also loading K as the V shard, and leave any\n+    v_proj such a checkpoint ships unmapped so it fails the load rather than\n+    silently overwriting V; KV-shared layers keep q_proj and drop the K/V\n+    tensors original checkpoints still ship for them.\"\"\"\n     config = SimpleNamespace(\n         num_hidden_layers=3,\n         num_kv_shared_layers=1,\n@@ -151,9 +151,9 @@ def test_gemma4_attention_mapper() -> None:\n         (\"model.layers.0.self_attn.qkv_proj.weight\", \"q\"),\n         (\"model.layers.0.self_attn.qkv_proj.weight\", \"k\"),\n         (\"model.layers.0.self_attn.k_norm.weight\", None),\n-        (\"model.layers.1.self_attn.qkv_proj.weight\", \"q\"),\n-        (\"model.layers.1.self_attn.qkv_proj.weight\", \"k\"),\n-        (\"model.layers.1.self_attn.qkv_proj.weight\", \"v\"),\n+        (\"model.layers.1.self_attn.qkk_proj.weight\", \"q\"),\n+        (\"model.layers.1.self_attn.qkk_proj.weight\", \"k\"),\n+        (\"model.layers.1.self_attn.qkk_proj.weight\", \"v\"),\n         (\"model.layers.1.self_attn.k_norm.weight\", None),\n         (\"model.layers.2.self_attn.q_proj.weight\", None),\n         (\"model.layers.0.mlp.gate_up_proj.weight\", 1),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f85e13e976dc217462c1890fd72fb64c7c46184a/tests%2Fmodels%2Flanguage%2Fgeneration%2Ftest_gemma.py",
      "sha": "899a993933f579fa49ef278329ea61e0dc2c68de",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f85e13e976dc217462c1890fd72fb64c7c46184a/vllm%2Fmodel_executor%2Fmodels%2Fdiffusion_gemma.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fdiffusion_gemma.py?ref=f85e13e976dc217462c1890fd72fb64c7c46184a",
      "deletions": 0,
      "filename": "vllm/model_executor/models/diffusion_gemma.py",
      "patch": "@@ -166,6 +166,7 @@ class DiffusionGemmaForConditionalGeneration(\n \n     packed_modules_mapping = {\n         \"qkv_proj\": [\"q_proj\", \"k_proj\", \"v_proj\"],\n+        \"qkk_proj\": [\"q_proj\", \"k_proj\", \"k_proj\"],\n         \"gate_up_proj\": [\"gate_proj\", \"up_proj\"],\n     }\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/f85e13e976dc217462c1890fd72fb64c7c46184a/vllm%2Fmodel_executor%2Fmodels%2Fdiffusion_gemma.py",
      "sha": "272942b719802f01feec9c3db6d50e3969c4b0f5",
      "status": "modified"
    },
    {
      "additions": 27,
      "blob_url": "https://github.com/vllm-project/vllm/blob/f85e13e976dc217462c1890fd72fb64c7c46184a/vllm%2Fmodel_executor%2Fmodels%2Fgemma4.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fgemma4.py?ref=f85e13e976dc217462c1890fd72fb64c7c46184a",
      "deletions": 12,
      "filename": "vllm/model_executor/models/gemma4.py",
      "patch": "@@ -87,10 +87,10 @@ def _gemma4_layer_weights_mapper(config) -> WeightsMapper:\n     \"\"\"Stack each decoder layer's projections the way its modules are built.\n \n     gate/up pack into `mlp.gate_up_proj`. Layers with a qkv_proj pack q/k/v\n-    into it; `attention_k_eq_v` full-attention layers ship k_proj only, so K\n-    is loaded into both the K and V shards and no v_proj is expected. KV-shared\n-    layers only have q_proj; the K/V tensors original checkpoints still ship\n-    for them are dropped.\n+    into it; `attention_k_eq_v` full-attention layers ship k_proj only, so\n+    their `qkk_proj` loads K into both the K and V shards and no v_proj is\n+    expected. KV-shared layers only have q_proj; the K/V tensors original\n+    checkpoints still ship for them are dropped.\n     \"\"\"\n     num_layers = config.num_hidden_layers\n     first_kv_shared = num_layers - getattr(config, \"num_kv_shared_layers\", 0)\n@@ -111,7 +111,7 @@ def _gemma4_layer_weights_mapper(config) -> WeightsMapper:\n     }\n     stacked |= {\n         f\"layers.{i}.self_attn.{shard}_proj.\": (\n-            f\"layers.{i}.self_attn.qkv_proj.\",\n+            f\"layers.{i}.self_attn.{'qkk' if i in k_eq_v_layers else 'qkv'}_proj.\",\n             shard_id,\n         )\n         for i in range(first_kv_shared)\n@@ -400,11 +400,17 @@ def __init__(\n         self.scaling = 1.0\n \n         layer_idx = extract_layer_index(prefix)\n+        layer_type = config.layer_types[layer_idx]\n         num_kv_shared_layers = getattr(config, \"num_kv_shared_layers\", 0)\n         first_kv_shared_layer_idx = config.num_hidden_layers - num_kv_shared_layers\n         self.is_kv_shared_layer = (\n             num_kv_shared_layers > 0 and layer_idx >= first_kv_shared_layer_idx\n         )\n+        self.is_k_eq_v = (\n+            not self.is_kv_shared_layer\n+            and getattr(config, \"attention_k_eq_v\", False)\n+            and layer_type == \"full_attention\"\n+        )\n \n         if self.is_kv_shared_layer:\n             # K/V come from the target layer's cache, so like HF this layer\n@@ -420,15 +426,20 @@ def __init__(\n             # QKVParallelLinear handles GQA correctly for all layer types.\n             # k_eq_v layers load K weights into both K and V slots via\n             # hf_to_vllm_mapper — no structural difference needed.\n-            self.qkv_proj = QKVParallelLinear(\n+            proj_name = \"qkk_proj\" if self.is_k_eq_v else \"qkv_proj\"\n+            qkv_proj = QKVParallelLinear(\n                 hidden_size,\n                 self.head_dim,\n                 self.total_num_heads,\n                 self.total_num_kv_heads,\n                 bias=config.attention_bias,\n                 quant_config=quant_config,\n-                prefix=f\"{prefix}.qkv_proj\",\n+                prefix=f\"{prefix}.{proj_name}\",\n             )\n+            if self.is_k_eq_v:\n+                self.qkk_proj = qkv_proj\n+            else:\n+                self.qkv_proj = qkv_proj\n             self.k_norm = RMSNorm(self.head_dim, eps=config.rms_norm_eps)\n             # V norm: no learnable scale (pure normalization only)\n             self.v_norm = RMSNorm(\n@@ -445,8 +456,6 @@ def __init__(\n         # Q norm: output = norm(x) * weight (learnable per-head scale)\n         self.q_norm = RMSNorm(self.head_dim, eps=config.rms_norm_eps)\n \n-        # Determine layer type and sliding window\n-        layer_type = config.layer_types[layer_idx]\n         self.is_sliding = layer_type == \"sliding_attention\"\n         sliding_window = config.sliding_window if self.is_sliding else None\n \n@@ -534,8 +543,9 @@ def forward(\n             attn_output = self.attn(q, None, None)\n         else:\n             # For k_eq_v, K weights are loaded into both K and V slots of\n-            # qkv_proj, so V == K automatically.\n-            qkv, _ = self.qkv_proj(hidden_states)\n+            # qkk_proj, so V == K automatically.\n+            qkv_proj = self.qkk_proj if self.is_k_eq_v else self.qkv_proj\n+            qkv, _ = qkv_proj(hidden_states)\n             q, k, v = qkv.split([self.q_size, self.kv_size, self.kv_size], dim=-1)\n \n             q = q.unflatten(-1, (self.num_heads, self.head_dim))\n@@ -1419,13 +1429,18 @@ class Gemma4ForCausalLM(\n         },\n     )\n     # KV-shared layers only have q_proj, so qkv_proj packing applies to\n-    # the other layers.\n+    # the other layers. `attention_k_eq_v` full-attention layers use V = K.\n     packed_modules_mapping = {\n         \"qkv_proj\": [\n             \"q_proj\",\n             \"k_proj\",\n             \"v_proj\",\n         ],\n+        \"qkk_proj\": [\n+            \"q_proj\",\n+            \"k_proj\",\n+            \"k_proj\",\n+        ],\n         \"gate_up_proj\": [\n             \"gate_proj\",\n             \"up_proj\",",
