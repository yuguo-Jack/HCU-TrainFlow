      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/78f0c6a463de6f1388ae853666ab8fa03653dee6/tests%2Fkernels%2Ftest_bf16_skinny_gemm.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Ftest_bf16_skinny_gemm.py?ref=78f0c6a463de6f1388ae853666ab8fa03653dee6",
      "deletions": 1,
      "filename": "tests/kernels/test_bf16_skinny_gemm.py",
      "patch": "@@ -562,7 +562,7 @@ def __init__(\n     root.wrong_shape.fused_qkv_a_proj = FakeLinearBase(\n         qkv_a.n + 1, qkv_a.k, glm52_gemm.UnquantizedLinearMethod()\n     )\n-    # o_proj at TP4 is only in the SM107 table.\n+    # o_proj at TP4 is in the SM103 and SM107 tables.\n     root.attn.o_proj = FakeLinearBase(6144, 4096, glm52_gemm.UnquantizedLinearMethod())\n     monkeypatch.setattr(glm52_gemm, \"LinearBase\", FakeLinearBase)\n     monkeypatch.setattr(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/78f0c6a463de6f1388ae853666ab8fa03653dee6/tests%2Fkernels%2Ftest_bf16_skinny_gemm.py",
