      "patch": "@@ -252,6 +252,7 @@ steps:\n   - tests/models/test_vision.py\n   - tests/models/test_adapters.py\n   - tests/models/test_qwen3_5_mtp_config.py\n+  - tests/models/test_cohere2_moe.py\n   - tests/models/transformers/fusers/\n   - tests/models/transformers/test_dynamic_rope.py\n   - tests/model_executor/layers/test_activation.py\n@@ -262,7 +263,7 @@ steps:\n   - tests/models/transformers/test_layer_registry.py\n   device: cpu-small\n   commands:\n-    - pytest -v -s models/test_utils.py models/test_vision.py models/test_adapters.py models/test_qwen3_5_mtp_config.py models/transformers/fusers/ models/transformers/test_dynamic_rope.py model_executor/layers/test_activation.py models/test_language_model_cache_is_weak.py models/deepseek_v32/test_sequence_parallel.py models/test_deepseek_v4_fi_moe_ep.py models/test_dspark_mla.py models/transformers/test_layer_registry.py\n+    - pytest -v -s models/test_utils.py models/test_vision.py models/test_adapters.py models/test_qwen3_5_mtp_config.py models/test_cohere2_moe.py models/transformers/fusers/ models/transformers/test_dynamic_rope.py model_executor/layers/test_activation.py models/test_language_model_cache_is_weak.py models/deepseek_v32/test_sequence_parallel.py models/test_deepseek_v4_fi_moe_ep.py models/test_dspark_mla.py models/transformers/test_layer_registry.py\n \n - label: ':amd: (MI355) DeepSeek-V4.1 Mono Decode Numerics'\n   key: dsv41-mono-decode-numerics-amd",
      "raw_url": "https://github.com/vllm-project/vllm/raw/16d0ff44cdbe1c99e5248b58794d655fec751d9a/.buildkite%2Ftest_areas%2Fmodels_basic.yaml",
