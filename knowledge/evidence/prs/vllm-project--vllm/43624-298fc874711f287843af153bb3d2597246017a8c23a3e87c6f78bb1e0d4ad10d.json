  "files": [
    {
      "additions": 30,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9913a204f745b4b643750f25a7829d83c577531a/tests%2Fconfig%2Ftest_cache_config.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fconfig%2Ftest_cache_config.py?ref=9913a204f745b4b643750f25a7829d83c577531a",
      "deletions": 0,
      "filename": "tests/config/test_cache_config.py",
      "patch": "@@ -0,0 +1,30 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import pytest\n+from pydantic import ValidationError\n+\n+from vllm.config import CacheConfig\n+\n+\n+@pytest.mark.parametrize(\"mamba_block_size\", [8, 16, 512])\n+def test_mamba_block_size_multiple_of_eight_accepted(\n+    mamba_block_size: int,\n+) -> None:\n+    cfg = CacheConfig(mamba_block_size=mamba_block_size)\n+    assert cfg.mamba_block_size == mamba_block_size\n+    assert cfg.user_specified_mamba_block_size is True\n+\n+\n+def test_mamba_block_size_none_accepted() -> None:\n+    cfg = CacheConfig()\n+    assert cfg.mamba_block_size is None\n+    assert cfg.user_specified_mamba_block_size is False\n+\n+\n+@pytest.mark.parametrize(\"mamba_block_size\", [1, 7, 12, 15])\n+def test_mamba_block_size_not_multiple_of_eight_rejected(\n+    mamba_block_size: int,\n+) -> None:\n+    with pytest.raises(ValidationError, match=\"multiple of 8\"):\n+        CacheConfig(mamba_block_size=mamba_block_size)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9913a204f745b4b643750f25a7829d83c577531a/tests%2Fconfig%2Ftest_cache_config.py",
      "sha": "7dffb4608c80137da2ac88a7a5ff2e10213d9675",
      "status": "added"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9913a204f745b4b643750f25a7829d83c577531a/vllm%2Fconfig%2Fcache.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fconfig%2Fcache.py?ref=9913a204f745b4b643750f25a7829d83c577531a",
      "deletions": 0,
      "filename": "vllm/config/cache.py",
      "patch": "@@ -247,6 +247,16 @@ def _warn_deprecated_calculate_kv_scales(cls, calculate_kv_scales: bool) -> bool\n             )\n         return calculate_kv_scales\n \n+    @field_validator(\"mamba_block_size\", mode=\"after\")\n+    @classmethod\n+    def _validate_mamba_block_size(cls, mamba_block_size: int | None) -> int | None:\n+        if mamba_block_size is not None and mamba_block_size % 8 != 0:\n+            raise ValueError(\n+                f\"mamba_block_size ({mamba_block_size}) must be a multiple of 8 \"\n+                \"to align with the causal_conv1d kernel.\"\n+            )\n+        return mamba_block_size\n+\n     @field_validator(\"cache_dtype\", mode=\"after\")\n     @classmethod\n     def _validate_cache_dtype(cls, cache_dtype: CacheDType) -> CacheDType:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9913a204f745b4b643750f25a7829d83c577531a/vllm%2Fconfig%2Fcache.py",
      "sha": "f62dafa0ca858a368645ec7aec71155ea9ad6373",
      "status": "modified"
    }
  ],
