      "deletions": 0,
      "filename": ".github/mergify.yml",
      "patch": "@@ -334,6 +334,33 @@ pull_request_rules:\n       add:\n         - minimax\n \n+- name: label-m3\n+  description: Automatically apply M3 label\n+  conditions:\n+    - label != stale\n+    - or:\n+      # M3 and M3.1 share the minimax_m3 implementation.\n+      - files~=(?i)minimax[-_]m3(?![._]\\d)(?:[^a-z0-9]|$)\n+      - title~=(?i)\\bminimax[-\\s_]?m3\\b(?![._]\\d)\n+  actions:\n+    label:\n+      add:\n+        - M3\n+        - minimax\n+\n+- name: label-m3-1\n+  description: Automatically apply M3.1 label\n+  conditions:\n+    - label != stale\n+    - or:\n+      - files~=(?i)minimax[-_]m3(?:[._]1)?(?![._]\\d)(?:[^a-z0-9]|$)\n+      - title~=(?i)\\bminimax[-\\s_]?m3[._]1\\b(?![._]\\d)\n+  actions:\n+    label:\n+      add:\n+        - M3.1\n+        - minimax\n+\n - name: label-inkling\n   description: Automatically apply inkling label\n   conditions:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c5bf40254d9ab2b76f6804ce2159087e417337db/.github%2Fmergify.yml",
