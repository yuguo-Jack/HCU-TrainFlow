      "patch": "@@ -232,6 +232,12 @@ jobs:\n               minimax: {\n                 substrings: [{ term: \"minimax\", searchIn: \"title\" }],\n               },\n+              M3: {\n+                regexPatterns: [{ pattern: \"\\\\bminimax[-\\\\s_]?m3\\\\b(?![._]\\\\d)\", flags: \"gi\", searchIn: \"title\" }],\n+              },\n+              \"M3.1\": {\n+                regexPatterns: [{ pattern: \"\\\\bminimax[-\\\\s_]?m3[._]1\\\\b(?![._]\\\\d)\", flags: \"gi\", searchIn: \"title\" }],\n+              },\n               inkling: {\n                 keywords: [{ term: \"Inkling\", searchIn: \"title\" }],\n               },",
