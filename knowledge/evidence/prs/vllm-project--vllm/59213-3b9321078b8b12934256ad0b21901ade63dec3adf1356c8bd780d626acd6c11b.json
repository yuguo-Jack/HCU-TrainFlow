    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/0be9144a893e2d68bc9d01c352cfdf5975af04f9/vllm%2Frenderers%2Fonline_renderer.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Frenderers%2Fonline_renderer.py?ref=0be9144a893e2d68bc9d01c352cfdf5975af04f9",
      "deletions": 1,
      "filename": "vllm/renderers/online_renderer.py",
      "patch": "@@ -256,7 +256,7 @@ async def render_chat(\n             # because of issues with pydantic we need to potentially\n             # re-serialize the tool_calls field of the request\n             _mt.maybe_serialize_tool_calls(request)  # type: ignore[arg-type]\n-            _mt.truncate_tool_call_ids(request)  # type: ignore[arg-type]\n+            _mt.normalize_tool_call_ids(request)  # type: ignore[arg-type]\n             _mt.validate_request_params(request)\n \n         # Check if tool parsing is unavailable (common condition)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/0be9144a893e2d68bc9d01c352cfdf5975af04f9/vllm%2Frenderers%2Fonline_renderer.py",
      "sha": "7ea032e3bf3570d6de70a214b4c27b33808dd23e",
