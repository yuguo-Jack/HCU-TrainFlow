  "files": [
    {
      "additions": 66,
      "blob_url": "https://github.com/vllm-project/vllm/blob/892453b8f6d4f74ee3e267445ba55967838b7c14/tests%2Fv1%2Fengine%2Ftest_engine_status_cache.py",
      "changes": 66,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fengine%2Ftest_engine_status_cache.py?ref=892453b8f6d4f74ee3e267445ba55967838b7c14",
      "deletions": 0,
      "filename": "tests/v1/engine/test_engine_status_cache.py",
      "patch": "@@ -0,0 +1,66 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"The client's FT status cache has two writers; a push must not drop either.\"\"\"\n+\n+from vllm.v1.engine.core_client import _update_engine_status\n+\n+\n+def test_push_replaces_engine_owned_keys():\n+    cache: dict[int, dict] = {0: {\"id\": 0, \"status\": \"unhealthy\", \"fault_info\": \"RE\"}}\n+\n+    _update_engine_status(cache, 0, {\"id\": 0, \"status\": \"healthy\"})\n+\n+    assert cache[0] == {\"id\": 0, \"status\": \"healthy\"}, (\n+        \"a recovery push must clear the stale fault_info it no longer sends\"\n+    )\n+\n+\n+def test_push_keeps_the_client_side_ft_apply_outcome():\n+    \"\"\"handle_fault() records why an FT apply failed, for GET /status.\n+\n+    The engine core knows nothing about those keys and does not resend them,\n+    so replacing the entry wholesale loses the operator's only record of the\n+    failed recovery attempt.\n+    \"\"\"\n+    cache: dict[int, dict] = {\n+        1: {\n+            \"id\": 1,\n+            \"status\": \"dead\",\n+            \"last_ft_request_id\": \"req-1\",\n+            \"ft_error\": \"status is DEAD\",\n+        }\n+    }\n+\n+    _update_engine_status(cache, 1, {\"id\": 1, \"status\": \"unhealthy\"})\n+\n+    assert cache[1][\"status\"] == \"unhealthy\"\n+    assert cache[1][\"last_ft_request_id\"] == \"req-1\"\n+    assert cache[1][\"ft_error\"] == \"status is DEAD\"\n+\n+\n+def test_a_push_for_an_unseen_engine_seeds_the_entry():\n+    cache: dict[int, dict] = {}\n+\n+    _update_engine_status(cache, 2, {\"id\": 2, \"status\": \"healthy\"})\n+\n+    assert cache == {2: {\"id\": 2, \"status\": \"healthy\"}}\n+\n+\n+def test_a_push_that_carries_the_keys_itself_wins():\n+    \"\"\"The engine core is still authoritative for anything it does send.\"\"\"\n+    cache: dict[int, dict] = {0: {\"id\": 0, \"ft_error\": \"old\"}}\n+\n+    _update_engine_status(cache, 0, {\"id\": 0, \"status\": \"healthy\", \"ft_error\": \"new\"})\n+\n+    assert cache[0][\"ft_error\"] == \"new\"\n+\n+\n+def test_entries_for_other_engines_are_untouched():\n+    cache: dict[int, dict] = {\n+        0: {\"id\": 0, \"status\": \"healthy\"},\n+        1: {\"id\": 1, \"status\": \"unhealthy\", \"ft_error\": \"boom\"},\n+    }\n+\n+    _update_engine_status(cache, 0, {\"id\": 0, \"status\": \"unhealthy\"})\n+\n+    assert cache[1] == {\"id\": 1, \"status\": \"unhealthy\", \"ft_error\": \"boom\"}",
      "raw_url": "https://github.com/vllm-project/vllm/raw/892453b8f6d4f74ee3e267445ba55967838b7c14/tests%2Fv1%2Fengine%2Ftest_engine_status_cache.py",
      "sha": "c0cdc15720a72d33c666b62bac81e7db5f0a8d45",
      "status": "added"
    },
    {
      "additions": 28,
      "blob_url": "https://github.com/vllm-project/vllm/blob/892453b8f6d4f74ee3e267445ba55967838b7c14/vllm%2Fv1%2Fengine%2Fcore_client.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Fcore_client.py?ref=892453b8f6d4f74ee3e267445ba55967838b7c14",
      "deletions": 2,
      "filename": "vllm/v1/engine/core_client.py",
      "patch": "@@ -948,6 +948,30 @@ def _process_utility_output(\n             )\n \n \n+# Keys in an _engine_status entry that the client writes itself rather than\n+# receiving from the engine core (see AsyncMPClient.handle_fault).\n+_CLIENT_OWNED_STATUS_KEYS = (\"last_ft_request_id\", \"ft_error\")\n+\n+\n+def _update_engine_status(\n+    engine_status: dict[int, dict], engine_index: int, payload: dict\n+) -> None:\n+    \"\"\"Apply an FT status push to the client's per-engine status cache.\n+\n+    The engine core republishes its whole payload on every push, so the\n+    engine-owned keys are replaced. The client also writes its own diagnostics\n+    into the same entry, and those are not in the push, so carry them over\n+    instead of dropping them.\n+    \"\"\"\n+    previous = engine_status.get(engine_index)\n+    entry = dict(payload)\n+    if previous is not None:\n+        for key in _CLIENT_OWNED_STATUS_KEYS:\n+            if key in previous:\n+                entry.setdefault(key, previous[key])\n+    engine_status[engine_index] = entry\n+\n+\n class SyncMPClient(MPClient):\n     \"\"\"Synchronous client for multi-proc EngineCore.\"\"\"\n \n@@ -1233,8 +1257,10 @@ async def process_outputs_socket():\n                             if not _self:\n                                 return\n                             if outputs.utility_output.result is not None:\n-                                _self._engine_status[outputs.engine_index] = (\n-                                    outputs.utility_output.result.result\n+                                _update_engine_status(\n+                                    _self._engine_status,\n+                                    outputs.engine_index,\n+                                    outputs.utility_output.result.result,\n                                 )\n                         else:\n                             _process_utility_output(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/892453b8f6d4f74ee3e267445ba55967838b7c14/vllm%2Fv1%2Fengine%2Fcore_client.py",
      "sha": "4309e530c123f2b6e171e1be50c47214f7a7ef34",
      "status": "modified"
    }
