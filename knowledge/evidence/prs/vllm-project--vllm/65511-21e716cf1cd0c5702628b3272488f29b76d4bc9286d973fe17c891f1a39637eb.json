    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/36f4feb00bf2b3a107d6acc81a3282ace542ca5c/cmake%2Fexternal_projects%2Fdeepgemm.cmake",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/cmake%2Fexternal_projects%2Fdeepgemm.cmake?ref=36f4feb00bf2b3a107d6acc81a3282ace542ca5c",
      "deletions": 1,
      "filename": "cmake/external_projects/deepgemm.cmake",
      "patch": "@@ -69,7 +69,7 @@ endif()\n # and 12.8+ for SM120 / SM12x. CUDA 13+ can use the family-specific SM12x\n # arch; CUDA 12.x builds the arch-specific SM120/SM121 variants.\n set(DEEPGEMM_SUPPORT_ARCHS)\n-if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.3)\n+if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.9)\n   list(APPEND DEEPGEMM_SUPPORT_ARCHS \"9.0a\")\n endif()\n if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 12.8)",
