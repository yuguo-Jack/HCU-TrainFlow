  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/57797883998a2f5136d2983df1353ec75be85057/csrc%2Frocm%2Fskinny_gemms.cu",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/csrc%2Frocm%2Fskinny_gemms.cu?ref=57797883998a2f5136d2983df1353ec75be85057",
      "deletions": 0,
      "filename": "csrc/rocm/skinny_gemms.cu",
      "patch": "@@ -1239,11 +1239,15 @@ torch::Tensor wvSplitK(const at::Tensor& in_a, const at::Tensor& in_b,\n                                        CuCount);                              \\\n   }\n \n+// On wave64, N == 5 stays at YTILE 2: larger tiles exceed the 128-VGPR\n+// budget of a 16-wave block and spill.\n #define WVSPLIT_TILE_CFG(_THRDS, _WVPRGRP, _sYT, __N)     \\\n   {                                                       \\\n     bool fit_lds = (Kbp_in * N_in <= max_lds_len);        \\\n     if (_sYT <= 1)                                        \\\n       WVSPLITK_CFG(_THRDS, _WVPRGRP, 1, 4, __N)           \\\n+    else if (_THRDS == 64 && __N == 5)                    \\\n+      WVSPLITK_CFG(_THRDS, _WVPRGRP, 2, 2, __N)           \\\n     else if ((__N == 1) || (!fit_lds) || (_sYT <= 4 * 2)) \\\n       WVSPLITK_CFG(_THRDS, _WVPRGRP, 2, 2, __N)           \\\n     else if (_sYT <= 4 * 3)                               \\",
      "raw_url": "https://github.com/vllm-project/vllm/raw/57797883998a2f5136d2983df1353ec75be85057/csrc%2Frocm%2Fskinny_gemms.cu",
      "sha": "5eb8047a287b80c8945720b0cda96e8d7715b48f",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/57797883998a2f5136d2983df1353ec75be85057/tests%2Fkernels%2Fquantization%2Ftest_rocm_skinny_gemms.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fquantization%2Ftest_rocm_skinny_gemms.py?ref=57797883998a2f5136d2983df1353ec75be85057",
      "deletions": 0,
      "filename": "tests/kernels/quantization/test_rocm_skinny_gemms.py",
      "patch": "@@ -97,6 +97,11 @@\n     (4, 16384 * 2, 8192 + 1),\n     (4, 16384 * 2 + 16, 8192),\n     (4, 16384 * 2 + 16, 8192 + 1),\n+    # N = 5, also with wide M\n+    (5, 4096, 4096),\n+    (5, 5120, 51200),\n+    (5, 5120, 51200 + 1),\n+    (5, 16384 * 2, 8192),\n     # Minimum M constraint validation (m >= 8)\n     (1, 64, 8),\n     (2, 128, 8),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/57797883998a2f5136d2983df1353ec75be85057/tests%2Fkernels%2Fquantization%2Ftest_rocm_skinny_gemms.py",
