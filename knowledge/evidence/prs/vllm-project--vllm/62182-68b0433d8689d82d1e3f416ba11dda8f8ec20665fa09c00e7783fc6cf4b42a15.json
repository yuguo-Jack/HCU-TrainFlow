      "changes": 19,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_parsers%2Ftest_utils.py?ref=3e858235cc2ca0413b08bad13412405a296961f4",
      "deletions": 0,
      "filename": "tests/tool_parsers/test_utils.py",
      "patch": "@@ -13,6 +13,7 @@\n     escape_ctrl_chars_in_strings,\n     escape_nested_quotes_in_strings,\n     extract_types_from_schema,\n+    find_common_prefix,\n     get_parameter_value,\n     handle_single_tool,\n     make_valid_python,\n@@ -764,3 +765,21 @@ def test_restore_leaves_normal_names_alone(self):\n             \"path\": \"x\",\n             \"from\": 1,\n         }\n+\n+\n+@pytest.mark.parametrize(\n+    \"s1, s2, expected\",\n+    [\n+        (\"\", \"\", \"\"),\n+        (\"\", \"abc\", \"\"),\n+        (\"abc\", \"abc\", \"abc\"),\n+        (\"abc\", \"abcdef\", \"abc\"),\n+        (\"abcdef\", \"abc\", \"abc\"),\n+        ('{\"fruit\": \"ap\"}', '{\"fruit\": \"apple\"}', '{\"fruit\": \"ap'),\n+        (\"xbc\", \"abc\", \"\"),\n+        (\"abcx\", \"abcy\", \"abc\"),\n+        (\"日本語x\", \"日本語y\", \"日本語\"),\n+    ],\n+)\n+def test_find_common_prefix(s1, s2, expected):\n+    assert find_common_prefix(s1, s2) == expected",
      "raw_url": "https://github.com/vllm-project/vllm/raw/3e858235cc2ca0413b08bad13412405a296961f4/tests%2Ftool_parsers%2Ftest_utils.py",
