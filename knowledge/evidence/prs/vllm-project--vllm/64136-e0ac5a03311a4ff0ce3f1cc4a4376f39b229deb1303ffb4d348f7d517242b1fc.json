      "filename": ".buildkite/test_areas/kernels.yaml",
      "patch": "@@ -437,6 +437,8 @@ steps:\n       - image-build-amd\n       source_file_dependencies:\n       - vllm/models/deepseek_v41/amd/rocm.py\n+      - vllm/v1/attention/ops/rocm_paged_mxfp4_indexer.py\n+      - tests/kernels/attention/test_rocm_paged_mxfp4_indexer.py\n       - vllm/models/deepseek_v41/sparse_mla.py\n       - vllm/v1/attention/backends/mla/rocm_aiter_mla.py\n       - vllm/v1/attention/ops/rocm_aiter_mla_sparse.py\n@@ -455,6 +457,7 @@ steps:\n       - pytest -v -s tests/kernels/attention/test_rocm_aiter_mla_fp8_support.py\n       - pytest -v -s tests/kernels/attention/test_rocm_aiter_mla_op_registration.py\n       - pytest -v -s tests/kernels/attention/test_rocm_triton_attn_dsv4.py::test_dsv41_adaptive_mla_swa_metadata_graph_replay\n+      - pytest -v -s tests/kernels/attention/test_rocm_paged_mxfp4_indexer.py\n \n - label: \":nvidia: (L4) Quantization Kernels Shard %N\"\n   key: kernels-quantization-test",
