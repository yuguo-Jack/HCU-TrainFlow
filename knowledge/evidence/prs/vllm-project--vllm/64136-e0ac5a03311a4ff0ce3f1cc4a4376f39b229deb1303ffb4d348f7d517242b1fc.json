    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ba11a6a32677e18553870c59fc9a810c5c425856/docs%2Fdesign%2Fattention_backends.md",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Fdesign%2Fattention_backends.md?ref=ba11a6a32677e18553870c59fc9a810c5c425856",
      "deletions": 0,
      "filename": "docs/design/attention_backends.md",
      "patch": "@@ -241,3 +241,8 @@ default on NVIDIA is `FLASHINFER_MLA_SPARSE_DSV4` on SM12x and\n `FLASHMLA_SPARSE_DSV4` on other supported CUDA architectures.\n \n --8<-- \"gen:table-mla-v4-decode\"\n+\n+On gfx950, Flash's top-512 MXFP4 indexer preserves six-query speculative\n+grouping for candidate-gather launches with at least 128 query rows and\n+16K candidate tokens. Candidate slots and causal bounds remain per query;\n+other shapes keep their existing launch grouping.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ba11a6a32677e18553870c59fc9a810c5c425856/docs%2Fdesign%2Fattention_backends.md",
      "sha": "925d572d9164432eda9010595c5b4a994c54fa38",
      "status": "modified"
    },
    {
      "additions": 21,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ba11a6a32677e18553870c59fc9a810c5c425856/tests%2Fkernels%2Fattention%2Ftest_rocm_paged_mxfp4_indexer.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fattention%2Ftest_rocm_paged_mxfp4_indexer.py?ref=ba11a6a32677e18553870c59fc9a810c5c425856",
      "deletions": 0,
      "filename": "tests/kernels/attention/test_rocm_paged_mxfp4_indexer.py",
      "patch": "@@ -445,6 +445,27 @@ def test_decode_layers_match_reference(monkeypatch, block, query_lens):\n     )\n \n \n+@BLOCKS\n+def test_speculative_gather_grouping_preserves_per_row_candidates(monkeypatch, block):\n+    \"\"\"Six-query launch tuning retains causal bounds and handles padding.\"\"\"\n+    monkeypatch.setitem(globals(), \"POOL_BLOCKS\", 2048)\n+    monkeypatch.setitem(globals(), \"TOPK\", 512)\n+    set_random_seed(0)\n+    query_lens = [6] * 23 + [0]\n+    case = _Case([900, 333, 610] * 7 + [1200, 700, 0], block)\n+    rows = [\n+        (req, n - q + j if q else -1)\n+        for req, (n, q) in enumerate(zip(case.seq_lens, query_lens))\n+        for j in range(q or 6)\n+    ]\n+    _run_layers(\n+        monkeypatch,\n+        case,\n+        rows,\n+        lambda r, gather=False: _decode_metadata(case, rows, r, query_lens),\n+    )\n+\n+\n @pytest.mark.parametrize(\n     \"seq_lens,new_tokens,chunks\",\n     [",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ba11a6a32677e18553870c59fc9a810c5c425856/tests%2Fkernels%2Fattention%2Ftest_rocm_paged_mxfp4_indexer.py",
      "sha": "6b261fe2ee749aa123120e310d6b918ddea09639",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ba11a6a32677e18553870c59fc9a810c5c425856/vllm%2Fv1%2Fattention%2Fops%2Frocm_paged_mxfp4_indexer.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fops%2Frocm_paged_mxfp4_indexer.py?ref=ba11a6a32677e18553870c59fc9a810c5c425856",
      "deletions": 2,
      "filename": "vllm/v1/attention/ops/rocm_paged_mxfp4_indexer.py",
      "patch": "@@ -611,13 +611,27 @@ def _gather_decode(layer: _Layer, num_cols: int) -> None:\n     (compact,) = current_workspace_manager().get_simultaneous(\n         ((rows, num_cols), torch.float32)\n     )\n-    q, q_scale, weights = layer.decode_rows(rows)\n+    native = metadata.decode_native\n+    if (\n+        native is not None\n+        and layer.num_heads == 32\n+        and num_cols == 16384\n+        and rows >= 128\n+        and rows == 6 * native.context_lens.shape[0]\n+    ):\n+        # Preserve the speculative query grouping for AITER's launch tuning.\n+        # Gather slots and row ends remain per query, including causal bounds.\n+        q, q_scale, weights = layer.rows(0, rows, native.context_lens.shape[0])\n+        context_lens, block_table = native.context_lens, native.block_table\n+    else:\n+        q, q_scale, weights = layer.decode_rows(rows)\n+        context_lens = lengths\n     pa.paged_mxfp4_mqa_logits(\n         q,\n         q_scale,\n         layer.kv,\n         weights,\n-        lengths,\n+        context_lens,\n         block_table,\n         num_cols,\n         out_logits=compact,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ba11a6a32677e18553870c59fc9a810c5c425856/vllm%2Fv1%2Fattention%2Fops%2Frocm_paged_mxfp4_indexer.py",
      "sha": "fbf133c09445afe336229c42298347fe9bff061f",
      "status": "modified"
    }
