    {
      "additions": 28,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ff9b2809013c880e6fa515b1cabae808677dd7d5/vllm%2Fmodel_executor%2Fdeterminism%2Fscope.py",
      "changes": 28,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fdeterminism%2Fscope.py?ref=ff9b2809013c880e6fa515b1cabae808677dd7d5",
      "deletions": 0,
      "filename": "vllm/model_executor/determinism/scope.py",
      "patch": "@@ -0,0 +1,28 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"Which modules must be built from batch-invariant kernels.\"\"\"\n+\n+from collections.abc import Iterator\n+from contextlib import contextmanager\n+from contextvars import ContextVar\n+\n+import vllm.envs as envs\n+\n+_exempt: ContextVar[bool] = ContextVar(\"batch_invariance_exempt\", default=False)\n+\n+\n+@contextmanager\n+def batch_invariance_exempt() -> Iterator[None]:\n+    \"\"\"Build modules that need not be batch invariant, e.g. a speculative\n+    drafter: its tokens are only proposals, and the target's verification,\n+    which is batch invariant, decides every output token and logprob.\"\"\"\n+    token = _exempt.set(True)\n+    try:\n+        yield\n+    finally:\n+        _exempt.reset(token)\n+\n+\n+def requires_batch_invariant_kernels() -> bool:\n+    \"\"\"Whether kernels chosen now must be batch invariant.\"\"\"\n+    return envs.VLLM_BATCH_INVARIANT and not _exempt.get()",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ff9b2809013c880e6fa515b1cabae808677dd7d5/vllm%2Fmodel_executor%2Fdeterminism%2Fscope.py",
      "sha": "71ed3cc6a74decbb446abea376208721f00fbe87",
      "status": "added"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ff9b2809013c880e6fa515b1cabae808677dd7d5/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Fmodular_kernel.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Fmodular_kernel.py?ref=ff9b2809013c880e6fa515b1cabae808677dd7d5",
      "deletions": 2,
      "filename": "vllm/model_executor/layers/fused_moe/modular_kernel.py",
      "patch": "@@ -9,8 +9,8 @@\n \n import torch\n \n-import vllm.envs as envs\n from vllm.logger import init_logger\n+from vllm.model_executor.determinism.scope import requires_batch_invariant_kernels\n from vllm.model_executor.layers.fused_moe.activation import (\n     ApplyMoEActivationConfig,\n     MoEActivation,\n@@ -604,7 +604,9 @@ def _make_reason(reason: str) -> str:\n             )\n         elif activation_format != cls.activation_format():\n             return False, _make_reason(f\"{activation_format.value} activation format\")\n-        elif envs.VLLM_BATCH_INVARIANT and not cls._supports_batch_invariance():\n+        elif (\n+            requires_batch_invariant_kernels() and not cls._supports_batch_invariance()\n+        ):\n             return False, _make_reason(\"batch invariance\")\n         elif moe_config.is_lora_enabled and not cls.supports_lora():\n             return False, _make_reason(\"LoRA\")",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ff9b2809013c880e6fa515b1cabae808677dd7d5/vllm%2Fmodel_executor%2Flayers%2Ffused_moe%2Fmodular_kernel.py",
      "sha": "2ce72437dcbc7a0e31fbc92f4e82b99e0a3a7683",
      "status": "modified"
    },
