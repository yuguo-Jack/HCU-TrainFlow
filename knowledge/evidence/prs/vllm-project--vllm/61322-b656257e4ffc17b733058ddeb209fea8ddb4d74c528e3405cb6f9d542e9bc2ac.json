      "additions": 13,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d9cf4fb2f2aed65c27be775608a8ffb31f52ce06/tests%2Ftest_config.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_config.py?ref=d9cf4fb2f2aed65c27be775608a8ffb31f52ce06",
      "deletions": 0,
      "filename": "tests/test_config.py",
      "patch": "@@ -239,6 +239,19 @@ def test_sampling_replay_config(config, message):\n             VllmConfig._verify_sampling_replay_config(config)\n \n \n+def test_sampling_replay_config_warns_about_request_preconditions(caplog, monkeypatch):\n+    \"\"\"Startup surfaces the per-request temperature/top_k contract (#61318).\"\"\"\n+    import logging\n+\n+    monkeypatch.setattr(logging.getLogger(\"vllm\"), \"propagate\", True)\n+    with caplog.at_level(logging.WARNING, logger=\"vllm.config.vllm\"):\n+        VllmConfig._verify_sampling_replay_config(_sampling_replay_config())\n+    assert any(\n+        \"temperature > 0\" in record.getMessage() and \"top_k > 0\" in record.getMessage()\n+        for record in caplog.records\n+    )\n+\n+\n def test_kda_recoverssm_derivation_is_revalidated():\n     config = SimpleNamespace(\n         cache_config=SimpleNamespace(",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d9cf4fb2f2aed65c27be775608a8ffb31f52ce06/tests%2Ftest_config.py",
      "sha": "64a4dcdbd00328bf2594b0e4d0396afc0ce34871",
      "status": "modified"
    },
    {
      "additions": 42,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d9cf4fb2f2aed65c27be775608a8ffb31f52ce06/tests%2Ftest_sampling_params.py",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftest_sampling_params.py?ref=d9cf4fb2f2aed65c27be775608a8ffb31f52ce06",
      "deletions": 0,
      "filename": "tests/test_sampling_params.py",
      "patch": "@@ -2,6 +2,7 @@\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n from dataclasses import dataclass\n from types import SimpleNamespace\n+from unittest.mock import patch\n \n import pytest\n \n@@ -18,11 +19,31 @@ class MockModelConfig:\n     max_logprobs: int = 20\n     logits_processors: list | None = None\n     return_sampling_mask: bool = False\n+    enable_trace_replay: bool = False\n \n     def get_vocab_size(self) -> int:\n         return 1024\n \n \n+def _validate_sampling_mask_params(params: SamplingParams) -> None:\n+    \"\"\"Run admission validation for return_sampling_mask with verify stubbed.\"\"\"\n+    processor = SimpleNamespace(\n+        model_config=MockModelConfig(return_sampling_mask=True),\n+        vllm_config=SimpleNamespace(\n+            reasoning_config=None,\n+            _check_supports_watermarking=lambda params: False,\n+        ),\n+        resolve_watermarking=lambda params: False,\n+        speculative_config=None,\n+        structured_outputs_config=None,\n+        diffusion_config=None,\n+        tokenizer=None,\n+        validate_logits_processors_params=lambda params: None,\n+    )\n+    with patch.object(SamplingParams, \"verify\"):\n+        InputProcessor._validate_params(processor, params, (\"generate\",))\n+\n+\n @pytest.mark.parametrize(\n     \"kwargs\",\n     [\n@@ -280,3 +301,24 @@ def test_extra_args_preserves_custom_objects_and_shared_containers():\n     params = SamplingParams(extra_args=extra_args)\n     assert params.extra_args[\"first\"][0] is custom\n     assert params.extra_args[\"first\"] is params.extra_args[\"second\"]\n+\n+\n+@pytest.mark.cpu_test\n+def test_return_sampling_mask_reports_all_unmet_preconditions():\n+    \"\"\"Both temperature and top_k failures are listed in one ValueError (#61318).\"\"\"\n+    with pytest.raises(ValueError, match=r\"(?s)temperature > 0.*top_k > 0\"):\n+        _validate_sampling_mask_params(SamplingParams(temperature=0.0, max_tokens=16))\n+\n+\n+@pytest.mark.cpu_test\n+def test_return_sampling_mask_reports_top_k_alone():\n+    with pytest.raises(ValueError, match=r\"top_k > 0\") as exc_info:\n+        _validate_sampling_mask_params(SamplingParams(temperature=0.7, max_tokens=16))\n+    assert \"temperature > 0\" not in str(exc_info.value)\n+\n+\n+@pytest.mark.cpu_test\n+def test_return_sampling_mask_accepts_valid_params():\n+    _validate_sampling_mask_params(\n+        SamplingParams(temperature=0.7, top_k=50, max_tokens=16)\n+    )",
