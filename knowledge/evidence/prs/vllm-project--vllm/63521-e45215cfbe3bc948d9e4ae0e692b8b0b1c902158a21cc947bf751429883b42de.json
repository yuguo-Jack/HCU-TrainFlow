      "deletions": 1,
      "filename": "vllm/entrypoints/serve/utils/orca_metrics.py",
      "patch": "@@ -33,7 +33,7 @@ def create_orca_header(\n     if metrics_format.lower() not in [\"text\", \"json\"]:\n         logger.warning(\n             \"Warning: `%s` format is not supported in the ORCA response header\",\n-            format,\n+            metrics_format,\n         )\n         return None\n ",
