      "additions": 95,
      "blob_url": "https://github.com/vllm-project/vllm/blob/a98c46da5071c673628c46c30d5fb273eede135f/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_moriio_handshake_compat.py",
      "changes": 95,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_moriio_handshake_compat.py?ref=a98c46da5071c673628c46c30d5fb273eede135f",
      "deletions": 0,
      "filename": "tests/v1/kv_connector/unit/test_moriio_handshake_compat.py",
      "patch": "@@ -0,0 +1,95 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\"\"\"Tests for MoRIIO handshake compatibility checks (Gap 12).\"\"\"\n+import msgspec\n+import pytest\n+\n+from vllm.distributed.kv_transfer.kv_connector.v1.moriio.moriio_common import (\n+    MORIIO_HANDSHAKE_VERSION,\n+    HandshakeError,\n+    MoRIIOAgentMetadata,\n+    MoRIIOMode,\n+)\n+\n+\n+class TestMoRIIOAgentMetadataCompat:\n+    \"\"\"Verify that the new compatibility fields exist and serialize correctly.\"\"\"\n+\n+    def test_handshake_version_default(self):\n+        meta = MoRIIOAgentMetadata(\n+            engine_id=\"e1\",\n+            agent_metadata=b\"\",\n+            kv_caches_base_addr=[0],\n+            num_blocks=1,\n+            block_len=128,\n+            attn_backend_name=\"flash_attn\",\n+        )\n+        assert meta.handshake_version == MORIIO_HANDSHAKE_VERSION\n+        assert MORIIO_HANDSHAKE_VERSION >= 1\n+\n+    def test_mode_field_default(self):\n+        meta = MoRIIOAgentMetadata(\n+            engine_id=\"e1\",\n+            agent_metadata=b\"\",\n+            kv_caches_base_addr=[0],\n+            num_blocks=1,\n+            block_len=128,\n+            attn_backend_name=\"flash_attn\",\n+        )\n+        assert meta.mode == \"\"\n+\n+    def test_mode_field_set(self):\n+        meta = MoRIIOAgentMetadata(\n+            engine_id=\"e1\",\n+            agent_metadata=b\"\",\n+            kv_caches_base_addr=[0],\n+            num_blocks=1,\n+            block_len=128,\n+            attn_backend_name=\"flash_attn\",\n+            mode=MoRIIOMode.WRITE.value,\n+        )\n+        assert meta.mode == \"write\"\n+\n+    def test_msgspec_roundtrip_preserves_new_fields(self):\n+        orig = MoRIIOAgentMetadata(\n+            engine_id=\"e1\",\n+            agent_metadata=b\"\\x01\\x02\",\n+            kv_caches_base_addr=[100, 200],\n+            num_blocks=10,\n+            block_len=256,\n+            attn_backend_name=\"flash_attn\",\n+            handshake_version=MORIIO_HANDSHAKE_VERSION,\n+            mode=\"write\",\n+        )\n+        encoder = msgspec.msgpack.Encoder()\n+        decoder = msgspec.msgpack.Decoder(MoRIIOAgentMetadata)\n+        data = encoder.encode(orig)\n+        decoded = decoder.decode(data)\n+\n+        assert decoded.handshake_version == MORIIO_HANDSHAKE_VERSION\n+        assert decoded.mode == \"write\"\n+        assert decoded.engine_id == \"e1\"\n+        assert decoded.block_len == 256\n+\n+    def test_legacy_peer_missing_new_fields(self):\n+        \"\"\"A legacy peer that omits handshake_version/mode should decode\n+        with defaults (0 and \"\" respectively) thanks to omit_defaults.\"\"\"\n+        legacy_data = {\n+            \"engine_id\": \"legacy\",\n+            \"agent_metadata\": b\"\",\n+            \"kv_caches_base_addr\": [0],\n+            \"num_blocks\": 1,\n+            \"block_len\": 128,\n+            \"attn_backend_name\": \"flash_attn\",\n+        }\n+        encoder = msgspec.msgpack.Encoder()\n+        raw = encoder.encode(legacy_data)\n+        decoder = msgspec.msgpack.Decoder(MoRIIOAgentMetadata)\n+        meta = decoder.decode(raw)\n+\n+        assert meta.handshake_version == MORIIO_HANDSHAKE_VERSION\n+        assert meta.mode == \"\"\n+\n+    def test_handshake_version_constant(self):\n+        assert isinstance(MORIIO_HANDSHAKE_VERSION, int)\n+        assert MORIIO_HANDSHAKE_VERSION >= 1",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a98c46da5071c673628c46c30d5fb273eede135f/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_moriio_handshake_compat.py",
      "sha": "ffbe481a6007d1cafd8085bea87463256ae18b2a",
      "status": "added"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/a98c46da5071c673628c46c30d5fb273eede135f/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_common.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_common.py?ref=a98c46da5071c673628c46c30d5fb273eede135f",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/moriio/moriio_common.py",
      "patch": "@@ -127,6 +127,9 @@ class ROLE(Enum):\n     NOTINIT = \"notinit\"\n \n \n+MORIIO_HANDSHAKE_VERSION = 1\n+\n+\n class MoRIIOAgentMetadata(\n     msgspec.Struct,\n     omit_defaults=True,  # type: ignore[call-arg]\n@@ -146,6 +149,11 @@ class MoRIIOAgentMetadata(\n     # Tokens per block of each attention layer. Hybrid models size attention\n     # blocks to the recurrent-state page, which depends on the TP size.\n     attention_block_sizes: dict[str, int] = {}\n+    # Handshake compatibility fields (Gap 12).\n+    # 0 means legacy/unset (accepted with warning for rolling upgrades).\n+    handshake_version: int = MORIIO_HANDSHAKE_VERSION\n+    # \"read\" or \"write\" — the MoRIIOMode this agent is running in.\n+    mode: str = \"\"\n \n \n class RoleManager:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/a98c46da5071c673628c46c30d5fb273eede135f/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_common.py",
      "sha": "3873e9c9b62e28794b588e73cc3e5901c50585ce",
      "status": "modified"
    },
    {
      "additions": 52,
      "blob_url": "https://github.com/vllm-project/vllm/blob/a98c46da5071c673628c46c30d5fb273eede135f/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_connector.py",
      "changes": 52,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_connector.py?ref=a98c46da5071c673628c46c30d5fb273eede135f",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/moriio/moriio_connector.py",
      "patch": "@@ -30,6 +30,7 @@\n     SupportsHMA,\n )\n from vllm.distributed.kv_transfer.kv_connector.v1.moriio.moriio_common import (\n+    MORIIO_HANDSHAKE_VERSION,\n     ROLE,\n     EngineId,\n     HandshakeError,\n@@ -2234,6 +2235,8 @@ def _moriio_handshake(\n                 got_metadata_time - start_time,\n             )\n \n+            self._validate_handshake_compat(metadata, expected_engine_id)\n+\n             self.moriio_wrapper.remote_engine_ip = host\n             remote_agent_name = self.moriio_wrapper.register_remote_engine(\n                 metadata.agent_metadata\n@@ -2278,6 +2281,53 @@ def _moriio_handshake(\n \n         return {remote_agent_name}\n \n+    def _validate_handshake_compat(\n+        self,\n+        remote: MoRIIOAgentMetadata,\n+        remote_engine_id: str,\n+    ) -> None:\n+        \"\"\"Reject an incompatible peer up front (Gap 12).\"\"\"\n+        remote_version = getattr(remote, \"handshake_version\", 0)\n+        if remote_version == 0:\n+            logger.warning(\n+                \"Remote engine %s has handshake_version=0; \"\n+                \"assuming legacy peer — skipping strict compatibility checks\",\n+                remote_engine_id,\n+            )\n+            return\n+\n+        if remote_version != MORIIO_HANDSHAKE_VERSION:\n+            raise HandshakeError(\n+                f\"Handshake version mismatch with {remote_engine_id}: \"\n+                f\"local={MORIIO_HANDSHAKE_VERSION}, remote={remote_version}\"\n+            )\n+\n+        remote_mode = getattr(remote, \"mode\", \"\")\n+        local_mode = self.mode.value\n+        if remote_mode and local_mode and remote_mode != local_mode:\n+            logger.warning(\n+                \"Remote engine %s mode (%s) differs from local (%s); \"\n+                \"both sides of a transfer must use the same mode\",\n+                remote_engine_id,\n+                remote_mode,\n+                local_mode,\n+            )\n+\n+        if remote.block_len != self.block_len:\n+            raise HandshakeError(\n+                f\"Block length mismatch with {remote_engine_id}: \"\n+                f\"local={self.block_len}, remote={remote.block_len}\"\n+            )\n+\n+        if remote.attn_backend_name != self.backend_name:\n+            logger.warning(\n+                \"Remote engine %s uses attention backend %r \"\n+                \"while local uses %r\",\n+                remote_engine_id,\n+                remote.attn_backend_name,\n+                self.backend_name,\n+            )\n+\n     def _remote_tp_rank(self, remote_tp_size: int) -> int:\n         # 0/unknown remote TP == homogeneous (avoids collapsing all ranks to 0).\n         if remote_tp_size == 0:\n@@ -2763,6 +2813,8 @@ def register_kv_caches(self, kv_caches: dict[str, torch.Tensor]):\n                 for name, layout in self.mamba_state_layouts.items()\n             },\n             attention_block_sizes=self.attention_block_sizes,\n+            handshake_version=MORIIO_HANDSHAKE_VERSION,\n+            mode=self.mode.value,\n         )\n         ready_event = threading.Event()\n         self._moriio_handshake_listener_t = threading.Thread(",
