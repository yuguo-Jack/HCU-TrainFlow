      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftransformers_utils%2Fconfigs%2Fqwen3_5.py?ref=d3c85ecd492d0ddd37791fad1ba9a7403a0352a1",
