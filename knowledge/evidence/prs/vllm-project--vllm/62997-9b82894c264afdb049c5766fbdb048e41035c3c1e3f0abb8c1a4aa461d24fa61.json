    {
      "additions": 30,
      "blob_url": "https://github.com/vllm-project/vllm/blob/708802d965453ec11fecbefd4927134096ff0a8c/vllm%2Fmultimodal%2Fvideo_prune%2Fevs.py",
      "changes": 41,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmultimodal%2Fvideo_prune%2Fevs.py?ref=708802d965453ec11fecbefd4927134096ff0a8c",
      "deletions": 11,
      "filename": "vllm/multimodal/video_prune/evs.py",
      "patch": "@@ -159,6 +159,8 @@ def recompute_mrope_positions(\n     vision_start_token_id: int,\n     image_token_id: int,\n     video_token_id: int,\n+    placeholder_offset: int | None = None,\n+    start_idx: int | None = None,\n ) -> tuple[torch.LongTensor, int]:\n     \"\"\"Update part of input mrope positions.\n     Original mrope_positions are computed incorrectly, so once we prune media\n@@ -200,6 +202,10 @@ def recompute_mrope_positions(\n         vision_start_token_id: Token indicating start of vision media.\n         image_token_id: Image token id\n         video_token_id: Video token id\n+        placeholder_offset: Offset of the placeholder in the full sequence (for 5-channel placeholders).\n+            If None, the function will use the original logic.\n+        start_idx: Start index of the slice within the placeholder (for 5-channel placeholders).\n+            If None, the function will use the original logic.\n \n     Returns:\n         Tuple of (mrope_positions, mrope_position_delta).\n@@ -226,9 +232,11 @@ def recompute_mrope_positions(\n \n     # Early exit: we've updated positions for all media tokens\n     # (and consequently - for all remaining text tokens)\n-    if seen_mm_tokens == total_mm_tokens:\n-        delta = int((positions.max().item() + 1) - N) if positions.numel() else -N\n-        return positions, delta\n+    # This early exit is removed because it prevents writing positions for later frames\n+    # when chunked prefill splits a video placeholder inside the placeholder.\n+    # if seen_mm_tokens == total_mm_tokens:\n+    #     delta = int((positions.max().item() + 1) - N) if positions.numel() else -N\n+    #     return positions, delta\n \n     vision_start_indices = (input_ids == vision_start_token_id).nonzero(as_tuple=True)[\n         0\n@@ -323,15 +331,26 @@ def recompute_mrope_positions(\n             global_mm_start -= num_timestamp_tokens\n             adjusted_for_timestamps = True\n \n-        # Offset calculation depends on whether we adjusted for timestamp tokens\n-        if adjusted_for_timestamps:\n-            # Start from position before the first timestamp token\n-            base = positions[-1, global_mm_start - 1] + 1\n-            local_start = global_mm_start + mm_embeddings_seen\n+        # Check if we're inside a 5-channel placeholder and have the offset and start_idx\n+        if (\n+            mm_pos.shape[0] == 5\n+            and placeholder_offset is not None\n+            and start_idx is not None\n+        ):\n+            # We're inside a 5-channel placeholder (EVS path)\n+            # Use the placeholder offset and start_idx to correctly calculate anchor and write offset\n+            base = positions[-1, placeholder_offset - 1] + 1\n+            local_start = placeholder_offset + start_idx\n         else:\n-            # Original logic: start after vision_start_token\n-            base = positions[-1, global_mm_start] + 1\n-            local_start = global_mm_start + 1 + mm_embeddings_seen\n+            # Offset calculation depends on whether we adjusted for timestamp tokens\n+            if adjusted_for_timestamps:\n+                # Start from position before the first timestamp token\n+                base = positions[-1, global_mm_start - 1] + 1\n+                local_start = global_mm_start + mm_embeddings_seen\n+            else:\n+                # Original logic: start after vision_start_token\n+                base = positions[-1, global_mm_start] + 1\n+                local_start = global_mm_start + 1 + mm_embeddings_seen\n \n         local_end = local_start + mm_pos.shape[1]\n         positions[:, local_start:local_end] = mm_pos[0:3] + base",
      "raw_url": "https://github.com/vllm-project/vllm/raw/708802d965453ec11fecbefd4927134096ff0a8c/vllm%2Fmultimodal%2Fvideo_prune%2Fevs.py",
      "sha": "6e942a441b408e9c7540159412bdc6c18065a57b",
      "status": "modified"
    },
    {
      "additions": 27,
      "blob_url": "https://github.com/vllm-project/vllm/blob/708802d965453ec11fecbefd4927134096ff0a8c/vllm%2Fv1%2Fworker%2Fgpu%2Fmodel_states%2Fmm_pruning.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu%2Fmodel_states%2Fmm_pruning.py?ref=708802d965453ec11fecbefd4927134096ff0a8c",
      "deletions": 3,
      "filename": "vllm/v1/worker/gpu/model_states/mm_pruning.py",
      "patch": "@@ -77,16 +77,40 @@ def recompute(\n             pos += num_req_embeds\n \n             req_idx = req_idx_list[batch_idx]\n-            prefill_len = prefill_lens_list[batch_idx]\n-            input_ids = req_states.all_token_ids.gpu[req_idx, :prefill_len]\n+            prefilled_len = prefill_lens_list[batch_idx]\n+            input_ids = req_states.all_token_ids.gpu[req_idx, :prefilled_len]\n             mrope_positions = self.rope_state.read_prefill_positions(\n-                req_idx, prefill_len\n+                req_idx, prefilled_len\n             ).long()\n+            # Get the placeholder offset and start_idx for 5-channel placeholders\n+            # This is needed to correctly calculate M-RoPE positions when chunked prefill\n+            # splits a video placeholder inside the placeholder\n+            placeholder_offset = None\n+            start_idx = None\n+            \n+            # Check if this is a 5-channel placeholder (EVS path)\n+            # We need to determine if we're inside a placeholder and get its offset and start_idx\n+            # This logic is similar to what's in _num_window_embeds but simplified\n+            for mm_feature in self.encoder_cache.mm_features[req_id]:\n+                pos_info = mm_feature.mm_position\n+                # Check if this media item is in the current window\n+                start_idx_in_window = max(num_computed - pos_info.offset, 0)\n+                end_idx_in_window = min(prefilled_len - pos_info.offset, pos_info.length)\n+                if start_idx_in_window < end_idx_in_window:\n+                    # This media item is in the current window\n+                    # For 5-channel placeholders, we need the placeholder offset and start_idx\n+                    if mm_feature.mm_position.length > 0:  # Has video tokens\n+                        placeholder_offset = pos_info.offset\n+                        start_idx = start_idx_in_window\n+                        break\n+            \n             req_cleaned, new_positions, delta = self.model.recompute_mrope_positions(\n                 input_ids=input_ids,\n                 multimodal_embeddings=req_embeds,\n                 mrope_positions=mrope_positions,\n                 num_computed_tokens=num_computed,\n+                placeholder_offset=placeholder_offset,\n+                start_idx=start_idx,\n             )\n             self.rope_state.update_prefill_positions(req_idx, new_positions, delta)\n             cleaned.extend(",
