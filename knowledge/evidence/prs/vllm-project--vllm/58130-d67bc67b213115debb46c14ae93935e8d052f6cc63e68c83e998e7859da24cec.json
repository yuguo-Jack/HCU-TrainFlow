      "additions": 46,
      "blob_url": "https://github.com/vllm-project/vllm/blob/2e1f9f60be2c362c032c8b2a5f87965624b8f1da/tests%2Freasoning%2Ftest_hunyuan_reasoning_parser.py",
      "changes": 46,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Freasoning%2Ftest_hunyuan_reasoning_parser.py?ref=2e1f9f60be2c362c032c8b2a5f87965624b8f1da",
      "deletions": 0,
      "filename": "tests/reasoning/test_hunyuan_reasoning_parser.py",
      "patch": "@@ -5,7 +5,10 @@\n from transformers import AutoTokenizer\n \n from tests.reasoning.utils import run_reasoning_extraction\n+from vllm.entrypoints.openai.chat_completion.protocol import ChatCompletionRequest\n+from vllm.parser.abstract_parser import DelegatingParser\n from vllm.reasoning import ReasoningParser, ReasoningParserManager\n+from vllm.reasoning.hunyuan_a13b_reasoning_parser import HunyuanA13BReasoningParser\n \n parser_name = \"hunyuan_a13b\"\n START_REASONING = \"<think>\\n\"\n@@ -166,3 +169,46 @@ def test_reasoning(\n \n     assert reasoning == param_dict[\"reasoning\"]\n     assert content == param_dict[\"content\"]\n+\n+\n+class _HunyuanReasoningOnlyParser(DelegatingParser):\n+    reasoning_parser_cls = HunyuanA13BReasoningParser\n+    tool_parser_cls = None\n+\n+\n+def test_delegating_streaming_strips_answer_end():\n+    \"\"\"Regression for #58127: DelegatingParser must not leak </answer>.\n+\n+    ``is_reasoning_end`` flips True when the answer section starts so structured\n+    output can constrain content, but the closing ``\\\\n</answer>`` must still be\n+    consumed by the Hunyuan state machine instead of passthrough.\n+    \"\"\"\n+    text = f\"{START_REASONING}ink{START_RESPONSE}answer{END_RESPONSE}\"\n+    token_ids = tokenizer.encode(text, add_special_tokens=False)\n+    parser = _HunyuanReasoningOnlyParser(tokenizer)\n+    request = ChatCompletionRequest(\n+        model=\"test-model\",\n+        messages=[{\"role\": \"user\", \"content\": \"hi\"}],\n+    )\n+\n+    reasoning_parts: list[str] = []\n+    content_parts: list[str] = []\n+    for tid in token_ids:\n+        delta_text = tokenizer.decode([tid])\n+        delta = parser.parse_delta(\n+            delta_text,\n+            [tid],\n+            request,\n+            finished=False,\n+        )\n+        if delta and delta.reasoning:\n+            reasoning_parts.append(delta.reasoning)\n+        if delta and delta.content:\n+            content_parts.append(delta.content)\n+\n+    reasoning = \"\".join(reasoning_parts)\n+    content = \"\".join(content_parts)\n+    assert reasoning == \"ink\"\n+    assert content == \"answer\"\n+    assert \"</answer>\" not in content\n+    assert END_RESPONSE not in content",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2e1f9f60be2c362c032c8b2a5f87965624b8f1da/tests%2Freasoning%2Ftest_hunyuan_reasoning_parser.py",
      "sha": "fda73c7f04ba5e3b98beb67d3f829550c1dccdd8",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/vllm-project/vllm/blob/2e1f9f60be2c362c032c8b2a5f87965624b8f1da/vllm%2Fparser%2Fabstract_parser.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fparser%2Fabstract_parser.py?ref=2e1f9f60be2c362c032c8b2a5f87965624b8f1da",
      "deletions": 1,
      "filename": "vllm/parser/abstract_parser.py",
      "patch": "@@ -796,7 +796,23 @@ def parse_delta(\n             and not self._in_reasoning_phase(state)\n             and not self._in_tool_call_phase(state)\n         ):\n-            delta_message = DeltaMessage(content=delta_text)\n+            # Some envelope parsers (e.g. Hunyuan A13B) end reasoning when the\n+            # answer section starts, but still must see later deltas to strip\n+            # a closing marker. Opt in via post_reasoning_stream_filter.\n+            reasoning_parser = self._reasoning_parser\n+            if reasoning_parser is not None and getattr(\n+                reasoning_parser, \"post_reasoning_stream_filter\", False\n+            ):\n+                delta_message = self.extract_reasoning_streaming(\n+                    previous_text=state.previous_text,\n+                    current_text=current_text,\n+                    delta_text=delta_text,\n+                    previous_token_ids=state.previous_token_ids,\n+                    current_token_ids=current_token_ids,\n+                    delta_token_ids=delta_token_ids,\n+                )\n+            else:\n+                delta_message = DeltaMessage(content=delta_text)\n \n         state.commit(current_text, current_token_ids)\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2e1f9f60be2c362c032c8b2a5f87965624b8f1da/vllm%2Fparser%2Fabstract_parser.py",
      "sha": "5c2a600b9794991098cbd918fd288ee60da07228",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/2e1f9f60be2c362c032c8b2a5f87965624b8f1da/vllm%2Freasoning%2Fhunyuan_a13b_reasoning_parser.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Freasoning%2Fhunyuan_a13b_reasoning_parser.py?ref=2e1f9f60be2c362c032c8b2a5f87965624b8f1da",
      "deletions": 0,
      "filename": "vllm/reasoning/hunyuan_a13b_reasoning_parser.py",
      "patch": "@@ -76,6 +76,10 @@ def __init__(self, tokenizer: PreTrainedTokenizerBase, *args, **kwargs):\n         self.sequence_index = 0\n         self.token_buffer: list[int] = []\n         self.text_buffer = \"\"\n+        # DelegatingParser treats response-state as reasoning_ended so structured\n+        # output can constrain the answer; keep routing deltas through this\n+        # parser afterward so response_end_ids (\"\\n</answer>\") are stripped.\n+        self.post_reasoning_stream_filter = True\n \n     def is_reasoning_end(self, input_ids: Sequence[int]) -> bool:\n         return self.current_state == \"response\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2e1f9f60be2c362c032c8b2a5f87965624b8f1da/vllm%2Freasoning%2Fhunyuan_a13b_reasoning_parser.py",
