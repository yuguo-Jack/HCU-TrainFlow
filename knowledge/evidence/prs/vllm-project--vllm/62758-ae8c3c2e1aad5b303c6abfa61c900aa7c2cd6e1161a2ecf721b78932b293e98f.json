      "changes": 3,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docker%2FDockerfile.rocm?ref=279cba1efdbbc52f4caa1f818a9283307916e186",
      "deletions": 1,
      "filename": "docker/Dockerfile.rocm",
      "patch": "@@ -930,13 +930,14 @@ RUN --mount=type=cache,target=/root/.cache/uv \\\n # Install vLLM using uv (inherited from base stage)\n # Note: No -U flag to avoid upgrading PyTorch ROCm to CUDA version\n # Keep OpenTelemetry within LMCache's cap.\n+ARG VLLM_ROUTER_VERSION=0.1.16\n RUN --mount=type=bind,from=export_vllm,src=/,target=/install \\\n     --mount=type=cache,target=/root/.cache/uv \\\n     cd /install \\\n     && echo \"opentelemetry-api<=1.40.0\" > /tmp/otel-constraints.txt \\\n     && uv pip install --system -c /etc/rocm-constraints.txt -c /tmp/otel-constraints.txt -r requirements/rocm.txt \\\n     && pip uninstall -y vllm \\\n-    && uv pip install --system -c /etc/rocm-constraints.txt -c /tmp/otel-constraints.txt *.whl \\\n+    && uv pip install --system -c /etc/rocm-constraints.txt -c /tmp/otel-constraints.txt *.whl \"vllm-router==${VLLM_ROUTER_VERSION}\" \\\n     && rm /tmp/otel-constraints.txt\n \n # Install NIXL ROCm wheel",
      "raw_url": "https://github.com/vllm-project/vllm/raw/279cba1efdbbc52f4caa1f818a9283307916e186/docker%2FDockerfile.rocm",
