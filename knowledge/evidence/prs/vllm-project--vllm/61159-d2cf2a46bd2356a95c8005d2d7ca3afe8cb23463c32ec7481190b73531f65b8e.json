  "files": [
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9514ca0741b411388de3d25bf1e57f4253e8c6ff/docs%2Fmodels%2Fsupported_models.md",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/docs%2Fmodels%2Fsupported_models.md?ref=9514ca0741b411388de3d25bf1e57f4253e8c6ff",
      "deletions": 0,
      "filename": "docs/models/supported_models.md",
      "patch": "@@ -634,6 +634,7 @@ These models primarily accept the [`LLM.generate`](./generative_models.md#llmgen\n | `Step3VLForConditionalGeneration` | Step3-VL | T + I<sup>+</sup> | `stepfun-ai/step3` | | ✅︎ |\n | `StepVLForConditionalGeneration` | Step3-VL-10B | T + I<sup>+</sup> | `stepfun-ai/Step3-VL-10B` | | ✅︎ |\n | `Step3p7ForConditionalGeneration` | Step-3.7-Flash | T + I<sup>+</sup> | `stepfun-ai/Step-3.7-Flash` | | ✅︎ |\n+| `TeleOCRForConditionalGeneration` | TeleOCR | T + I | `XingChen-AGI/TeleOCR` | | |\n | `UltravoxModel` | Ultravox | T + A<sup>E+</sup> | `fixie-ai/ultravox-v0_5-llama-3_2-1b` | ✅︎ | ✅︎ |\n | `UnlimitedOCRForCausalLM` | Unlimited-OCR | T + I<sup>+</sup> | `baidu/Unlimited-OCR`, etc. | ✅︎ | ✅︎ |\n \n@@ -712,6 +713,13 @@ Some models are supported only via the [Transformers modeling backend](#transfor\n     The official `openbmb/MiniCPM-V-2` doesn't work yet, so we need to use a fork (`HwwwH/MiniCPM-V-2`) for now.\n     For more details, please see: <https://github.com/vllm-project/vllm/pull/4087#issuecomment-2250397630>\n \n+!!! note\n+    TeleOCR's published configuration uses the Qwen2.5-VL architecture name,\n+    but its text decoder uses Qwen3 attention, including Q/K normalization.\n+    Select the TeleOCR implementation with\n+    `--hf-overrides '{\"architectures\": [\"TeleOCRForConditionalGeneration\"]}'`.\n+    The official model-specific vLLM plugin is not required for this implementation.\n+\n #### Transcription\n \n Speech2Text models trained specifically for Automatic Speech Recognition.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9514ca0741b411388de3d25bf1e57f4253e8c6ff/docs%2Fmodels%2Fsupported_models.md",
      "sha": "ba1f33fbfb8977cc7f825739fee39c0d7252686f",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9514ca0741b411388de3d25bf1e57f4253e8c6ff/tests%2Fmodels%2Fregistry.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Fregistry.py?ref=9514ca0741b411388de3d25bf1e57f4253e8c6ff",
      "deletions": 0,
      "filename": "tests/models/registry.py",
      "patch": "@@ -1405,6 +1405,11 @@ def check_available_online(\n         # ``dummy_hf_overrides``) to avoid OOM during init.\n         hf_overrides={\"text_config\": {\"num_hidden_layers\": 4, \"moe_num_experts\": 8}},\n     ),\n+    \"TeleOCRForConditionalGeneration\": _HfExamplesInfo(\n+        \"XingChen-AGI/TeleOCR\",\n+        hf_overrides={\"architectures\": [\"TeleOCRForConditionalGeneration\"]},\n+        max_model_len=4096,\n+    ),\n     \"UltravoxModel\": _HfExamplesInfo(\n         \"fixie-ai/ultravox-v0_5-llama-3_2-1b\",\n         trust_remote_code=True,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9514ca0741b411388de3d25bf1e57f4253e8c6ff/tests%2Fmodels%2Fregistry.py",
      "sha": "afd1d2fbf7c0cdd7d1fae302339127b18078401e",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9514ca0741b411388de3d25bf1e57f4253e8c6ff/vllm%2Fmodel_executor%2Fmodels%2Fqwen2_5_vl.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fqwen2_5_vl.py?ref=9514ca0741b411388de3d25bf1e57f4253e8c6ff",
      "deletions": 5,
      "filename": "vllm/model_executor/models/qwen2_5_vl.py",
      "patch": "@@ -1441,16 +1441,19 @@ def __init__(self, *, vllm_config: VllmConfig, prefix: str = \"\"):\n             )\n \n         with self._mark_language_model(vllm_config):\n-            self.language_model = init_vllm_registered_model(\n-                vllm_config=vllm_config,\n-                prefix=maybe_prefix(prefix, \"language_model\"),\n-                architectures=[\"Qwen2ForCausalLM\"],\n-            )\n+            self.language_model = self._init_language_model(vllm_config, prefix)\n \n         self.make_empty_intermediate_tensors = (\n             self.language_model.make_empty_intermediate_tensors\n         )\n \n+    def _init_language_model(self, vllm_config: VllmConfig, prefix: str) -> nn.Module:\n+        return init_vllm_registered_model(\n+            vllm_config=vllm_config,\n+            prefix=maybe_prefix(prefix, \"language_model\"),\n+            architectures=[\"Qwen2ForCausalLM\"],\n+        )\n+\n     def _parse_and_validate_image_input(\n         self, **kwargs: object\n     ) -> Qwen2_5_VLImageInputs | None:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9514ca0741b411388de3d25bf1e57f4253e8c6ff/vllm%2Fmodel_executor%2Fmodels%2Fqwen2_5_vl.py",
      "sha": "bfe989260b23fb68b8ef939d362252c7df70cb16",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9514ca0741b411388de3d25bf1e57f4253e8c6ff/vllm%2Fmodel_executor%2Fmodels%2Fregistry.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fregistry.py?ref=9514ca0741b411388de3d25bf1e57f4253e8c6ff",
      "deletions": 0,
      "filename": "vllm/model_executor/models/registry.py",
      "patch": "@@ -605,6 +605,7 @@\n     \"StepVLForConditionalGeneration\": (\"step_vl\", \"StepVLForConditionalGeneration\"),\n     \"Step3VLForConditionalGeneration\": (\"step3_vl\", \"Step3VLForConditionalGeneration\"),\n     \"Step3p7ForConditionalGeneration\": (\"step3p7\", \"Step3p7ForConditionalGeneration\"),\n+    \"TeleOCRForConditionalGeneration\": (\"teleocr\", \"TeleOCRForConditionalGeneration\"),\n     \"UltravoxModel\": (\"ultravox\", \"UltravoxModel\"),\n     \"VoxtralForConditionalGeneration\": (\"voxtral\", \"VoxtralForConditionalGeneration\"),\n     \"VoxtralRealtimeGeneration\": (\"voxtral_realtime\", \"VoxtralRealtimeGeneration\"),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9514ca0741b411388de3d25bf1e57f4253e8c6ff/vllm%2Fmodel_executor%2Fmodels%2Fregistry.py",
      "sha": "db2a2d67797617f23a0448d4c4dc742a3c35fd2b",
      "status": "modified"
    },
    {
      "additions": 20,
      "blob_url": "https://github.com/vllm-project/vllm/blob/9514ca0741b411388de3d25bf1e57f4253e8c6ff/vllm%2Fmodel_executor%2Fmodels%2Fteleocr.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Fmodels%2Fteleocr.py?ref=9514ca0741b411388de3d25bf1e57f4253e8c6ff",
      "deletions": 0,
      "filename": "vllm/model_executor/models/teleocr.py",
      "patch": "@@ -0,0 +1,20 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+from torch import nn\n+\n+from vllm.config import VllmConfig\n+from vllm.model_executor.models.qwen2_5_vl import Qwen2_5_VLForConditionalGeneration\n+from vllm.model_executor.models.utils import init_vllm_registered_model, maybe_prefix\n+\n+\n+class TeleOCRForConditionalGeneration(Qwen2_5_VLForConditionalGeneration):\n+    \"\"\"TeleOCR combines a Qwen2.5-VL vision tower with a Qwen3 decoder.\"\"\"\n+\n+    def _init_language_model(self, vllm_config: VllmConfig, prefix: str) -> nn.Module:\n+        return init_vllm_registered_model(\n+            vllm_config=vllm_config,\n+            hf_config=vllm_config.model_config.hf_text_config,\n+            prefix=maybe_prefix(prefix, \"language_model\"),\n+            architectures=[\"Qwen3ForCausalLM\"],\n+        )",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9514ca0741b411388de3d25bf1e57f4253e8c6ff/vllm%2Fmodel_executor%2Fmodels%2Fteleocr.py",
      "sha": "68d8e43ab840c4a5134e45963831e344d1af95d7",
      "status": "added"
    }
  ],
