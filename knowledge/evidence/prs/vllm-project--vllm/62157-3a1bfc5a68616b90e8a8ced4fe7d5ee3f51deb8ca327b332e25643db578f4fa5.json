      "blob_url": "https://github.com/vllm-project/vllm/blob/1114a745f608563cd427ad3d92a10248a861e59b/vllm%2Fengine%2Farg_utils.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fengine%2Farg_utils.py?ref=1114a745f608563cd427ad3d92a10248a861e59b",
      "deletions": 0,
      "filename": "vllm/engine/arg_utils.py",
      "patch": "@@ -2618,6 +2618,21 @@ def create_engine_config(\n             target_model_config=model_config,\n             target_parallel_config=parallel_config,\n         )\n+\n+        # Validate ngram_gpu compatibility with disabled compilation\n+        if (\n+            speculative_config is not None\n+            and getattr(speculative_config, \"method\", None) == \"ngram_gpu\"\n+            and self.compilation_config is not None\n+            and getattr(self.compilation_config, \"mode\", None) == \"NONE\"\n+        ):\n+            raise ValueError(\n+                'speculative_config.method=\"ngram_gpu\" requires torch.compile / '\n+                'CUDA graph support, but compilation_config.mode=\"NONE\" disables '\n+                'it. Use method=\"ngram\" with compilation_config.mode=\"NONE\", '\n+                \"or enable compilation.\"\n+            )\n+\n         diffusion_config = self.create_diffusion_config()\n         watermark_config = self.create_watermark_config()\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1114a745f608563cd427ad3d92a10248a861e59b/vllm%2Fengine%2Farg_utils.py",
      "sha": "ad38f39df5bc590272ed3520db8d85356e8ff501",
      "status": "modified"
    }
