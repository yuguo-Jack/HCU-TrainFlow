    {
      "additions": 17,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d79dd051a5f3f52fd1134b57ed3fd55c122ae001/tests%2Fv1%2Fworker%2Ftest_gpu_input_batch_v2.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fworker%2Ftest_gpu_input_batch_v2.py?ref=d79dd051a5f3f52fd1134b57ed3fd55c122ae001",
      "deletions": 0,
      "filename": "tests/v1/worker/test_gpu_input_batch_v2.py",
      "patch": "@@ -59,6 +59,23 @@ def test_make_dummy_distributes_remainder(num_reqs: int, num_tokens: int):\n     )\n \n \n+@pytest.mark.parametrize(\"num_tokens\", [1536, 1537, 2046, 8190])\n+def test_make_dummy_dp_padding_respects_max_model_len(num_tokens: int):\n+    \"\"\"An idle DP rank's single dummy request is padded to the busiest rank's\n+    token count. Kept as one request past max_model_len, its prefill gathers\n+    read past the block table: a BI DSv4.1 rank hung there while its peers\n+    timed out in the MegaMoE barrier.\"\"\"\n+    max_model_len = 1536\n+    buffers = InputBuffers(\n+        max_num_reqs=32, max_num_tokens=num_tokens, device=torch.device(DEVICE)\n+    )\n+    batch = InputBatch.make_dummy(1, num_tokens, buffers, max_model_len=max_model_len)\n+\n+    assert batch.num_scheduled_tokens.sum() == num_tokens\n+    assert batch.num_reqs == -(-num_tokens // max_model_len)\n+    assert int(batch.seq_lens.max()) <= max_model_len\n+\n+\n @pytest.mark.skipif(not current_platform.is_cuda(), reason=\"Requires CUDA top-k.\")\n @pytest.mark.parametrize(\"is_padding\", [True, False])\n def test_make_dummy_padding_controls_moe_routing(monkeypatch, is_padding: bool):",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d79dd051a5f3f52fd1134b57ed3fd55c122ae001/tests%2Fv1%2Fworker%2Ftest_gpu_input_batch_v2.py",
      "sha": "a0266d690f5dcdfece85ee8989dffaeaa15c5b46",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d79dd051a5f3f52fd1134b57ed3fd55c122ae001/vllm%2Fv1%2Fworker%2Fgpu%2Finput_batch.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu%2Finput_batch.py?ref=d79dd051a5f3f52fd1134b57ed3fd55c122ae001",
      "deletions": 0,
      "filename": "vllm/v1/worker/gpu/input_batch.py",
      "patch": "@@ -139,7 +139,11 @@ def make_dummy(\n         input_buffers: InputBuffers,\n         max_query_len: int | None = None,\n         is_padding: bool = True,\n+        max_model_len: int | None = None,\n     ) -> \"InputBatch\":\n+        if max_model_len is not None:\n+            # Block tables back at most max_model_len tokens per request.\n+            num_reqs = max(num_reqs, cdiv(num_tokens, max_model_len))\n         assert 0 < num_reqs <= num_tokens\n         device = input_buffers.device\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d79dd051a5f3f52fd1134b57ed3fd55c122ae001/vllm%2Fv1%2Fworker%2Fgpu%2Finput_batch.py",
      "sha": "9f34c018774f1b41010850b7a3772420a736de2b",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d79dd051a5f3f52fd1134b57ed3fd55c122ae001/vllm%2Fv1%2Fworker%2Fgpu%2Fmodel_runner.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu%2Fmodel_runner.py?ref=d79dd051a5f3f52fd1134b57ed3fd55c122ae001",
      "deletions": 0,
      "filename": "vllm/v1/worker/gpu/model_runner.py",
      "patch": "@@ -1921,6 +1921,9 @@ def execute_model(\n                 # Profiling and warmup must route the dummy tokens to experts\n                 # so MoE memory is measured and MoE kernels are exercised.\n                 is_padding=not is_profile,\n+                # An idle DP rank pads its one dummy request to the busiest\n+                # rank's token count, which can exceed max_model_len.\n+                max_model_len=self.max_model_len,\n             )\n             if randomize_inputs:\n                 # All-zero input_ids route every token to the same experts.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d79dd051a5f3f52fd1134b57ed3fd55c122ae001/vllm%2Fv1%2Fworker%2Fgpu%2Fmodel_runner.py",
