      "additions": 16,
      "blob_url": "https://github.com/vllm-project/vllm/blob/126ae9fb5744d559010012cdff683d5d1f17bd8b/tests%2Fentrypoints%2Fopenai%2Fresponses%2Ftest_protocol.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fentrypoints%2Fopenai%2Fresponses%2Ftest_protocol.py?ref=126ae9fb5744d559010012cdff683d5d1f17bd8b",
      "deletions": 0,
      "filename": "tests/entrypoints/openai/responses/test_protocol.py",
      "patch": "@@ -37,3 +37,19 @@ def test_serialize_messages() -> None:\n     }\n     msg = Message.from_dict(msg_value)\n     assert serialize_messages([msg, dict_value]) == [msg_value, dict_value]\n+\n+\n+def test_chat_message_reasoning_content_serialization() -> None:\n+    from vllm.entrypoints.openai.chat_completion.protocol import ChatMessage\n+\n+    msg = ChatMessage(role=\"assistant\", content=\"Answer\", reasoning_content=\"Thinking process\")\n+    dumped = msg.model_dump()\n+    assert dumped[\"role\"] == \"assistant\"\n+    assert dumped[\"content\"] == \"Answer\"\n+    assert dumped[\"reasoning_content\"] == \"Thinking process\"\n+    assert \"tool_calls\" not in dumped\n+\n+    msg_none = ChatMessage(role=\"assistant\", content=\"Answer\")\n+    dumped_none = msg_none.model_dump()\n+    assert \"reasoning_content\" not in dumped_none\n+",
      "raw_url": "https://github.com/vllm-project/vllm/raw/126ae9fb5744d559010012cdff683d5d1f17bd8b/tests%2Fentrypoints%2Fopenai%2Fresponses%2Ftest_protocol.py",
      "sha": "5f67becd31f7c564280677ad483ac07a39a5791d",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/126ae9fb5744d559010012cdff683d5d1f17bd8b/vllm%2Fentrypoints%2Fopenai%2Fchat_completion%2Fprotocol.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fentrypoints%2Fopenai%2Fchat_completion%2Fprotocol.py?ref=126ae9fb5744d559010012cdff683d5d1f17bd8b",
      "deletions": 2,
      "filename": "vllm/entrypoints/openai/chat_completion/protocol.py",
      "patch": "@@ -70,12 +70,16 @@ class ChatMessage(OpenAIBaseModel):\n \n     # vLLM-specific fields that are not in OpenAI spec\n     reasoning: str | None = None\n+    reasoning_content: str | None = None\n \n     @model_serializer(mode=\"wrap\")\n     def _serialize(self, handler):\n         data = handler(self)\n-        if len(data.get(\"tool_calls\", [])) == 0:\n-            data.pop(\"tool_calls\", None)\n+        if isinstance(data, dict):\n+            if len(data.get(\"tool_calls\", [])) == 0:\n+                data.pop(\"tool_calls\", None)\n+            if data.get(\"reasoning_content\") is None:\n+                data.pop(\"reasoning_content\", None)\n         return data\n \n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/126ae9fb5744d559010012cdff683d5d1f17bd8b/vllm%2Fentrypoints%2Fopenai%2Fchat_completion%2Fprotocol.py",
      "sha": "3f20000d72f1238b0f55c68f17dc00d20fcde620",
      "status": "modified"
    }
