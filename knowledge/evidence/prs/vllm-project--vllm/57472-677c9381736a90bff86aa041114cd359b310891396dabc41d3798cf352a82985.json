      "blob_url": "https://github.com/vllm-project/vllm/blob/1f23b540ebf991cb807c603d8ef874cf13d5e18f/tests%2Fbasic_correctness%2Fcpu_offload%2Ftest_cpu_offload.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fbasic_correctness%2Fcpu_offload%2Ftest_cpu_offload.py?ref=1f23b540ebf991cb807c603d8ef874cf13d5e18f",
      "deletions": 0,
      "filename": "tests/basic_correctness/cpu_offload/test_cpu_offload.py",
      "patch": "@@ -87,6 +87,29 @@ def test_mrv2_weight_offloading(\n         envs.disable_envs_cache()\n \n \n+def test_cpu_offload_respects_byte_budget(vllm_runner, monkeypatch):\n+    \"\"\"The real model-loading path must respect the configured byte budget.\"\"\"\n+    monkeypatch.setenv(\"VLLM_ENABLE_V1_MULTIPROCESSING\", \"0\")\n+    envs.disable_envs_cache()\n+    original_offloader = get_offloader()\n+\n+    try:\n+        with vllm_runner(\n+            \"hmellor/tiny-random-LlamaForCausalLM\",\n+            enforce_eager=True,\n+            gpu_memory_utilization=0.1,\n+            max_model_len=128,\n+            max_num_seqs=1,\n+            cpu_offload_gb=1 / (1024**3),\n+        ):\n+            offloader = get_offloader()\n+            assert isinstance(offloader, UVAOffloader)\n+            assert offloader.cpu_offload_bytes <= offloader.cpu_offload_max_bytes\n+    finally:\n+        set_offloader(original_offloader)\n+        envs.disable_envs_cache()\n+\n+\n def _is_offloaded(p: nn.Parameter) -> bool:\n     return p.device.type == \"cpu\" or getattr(p, \"_vllm_is_uva_offloaded\", False)\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1f23b540ebf991cb807c603d8ef874cf13d5e18f/tests%2Fbasic_correctness%2Fcpu_offload%2Ftest_cpu_offload.py",
      "sha": "4bb057b3e7992e190886f568bf6a972861e35f37",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/vllm-project/vllm/blob/1f23b540ebf991cb807c603d8ef874cf13d5e18f/vllm%2Fmodel_executor%2Foffloader%2Fuva.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Foffloader%2Fuva.py?ref=1f23b540ebf991cb807c603d8ef874cf13d5e18f",
      "deletions": 6,
      "filename": "vllm/model_executor/offloader/uva.py",
      "patch": "@@ -88,11 +88,6 @@ def _maybe_offload_to_cpu(self, module: nn.Module, prefix: str = \"\") -> nn.Modul\n         # use pin_memory if possible, which helps cudagraph capture speed\n         offloaded_parameters = False\n         for name, p in module.named_parameters():\n-            if self.cpu_offload_bytes >= self.cpu_offload_max_bytes:\n-                # we use per-parameter offloading\n-                # one module might have some parameters offloaded and some not\n-                break\n-\n             # Skip parameters an earlier wrap_modules call already offloaded.\n             # The UVA path leaves p.device as the accelerator (a view of CPU\n             # memory), so the marker is the only way to recognize those.\n@@ -111,6 +106,11 @@ def _maybe_offload_to_cpu(self, module: nn.Module, prefix: str = \"\") -> nn.Modul\n                 if not should_offload:\n                     continue\n \n+            parameter_bytes = p.data.numel() * p.data.element_size()\n+            if self.cpu_offload_bytes + parameter_bytes > self.cpu_offload_max_bytes:\n+                # One module might have some parameters offloaded and some not.\n+                break\n+\n             cpu_data = p.data.to(device=\"cpu\")\n             if self.pin_memory:\n                 cpu_data = cpu_data.pin_memory()\n@@ -121,7 +121,7 @@ def _maybe_offload_to_cpu(self, module: nn.Module, prefix: str = \"\") -> nn.Modul\n                 p.data = get_accelerator_view_from_cpu_tensor(cpu_data)\n                 p._vllm_is_uva_offloaded = True\n \n-            self.cpu_offload_bytes += p.data.numel() * p.data.element_size()\n+            self.cpu_offload_bytes += parameter_bytes\n             offloaded_parameters = True\n \n         if offloaded_parameters and not self.uva_offloading:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/1f23b540ebf991cb807c603d8ef874cf13d5e18f/vllm%2Fmodel_executor%2Foffloader%2Fuva.py",
