  "files": [
    {
      "additions": 15,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5c142e4e8e73fa43e069a3f4733fd7d10b6ee8c8/tests%2Fmodels%2Fflint%2Ftest_flint_ops.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fmodels%2Fflint%2Ftest_flint_ops.py?ref=5c142e4e8e73fa43e069a3f4733fd7d10b6ee8c8",
      "deletions": 0,
      "filename": "tests/models/flint/test_flint_ops.py",
      "patch": "@@ -202,3 +202,18 @@ def test_silu_and_mul_matches_reference(m):\n     ref = _silu_and_mul_ref(x)\n     assert (out == ref).float().mean() > 0.999\n     torch.testing.assert_close(out, ref, rtol=2**-7, atol=1e-6)\n+\n+\n+@pytest.mark.parametrize(\"d\", [3072, 1536, 768])\n+@torch.inference_mode()\n+def test_silu_and_mul_tp_sharded_widths(d):\n+    \"\"\"TP shards the dense 6144 intermediate to widths that are not\n+    1024-divisible (TP4: 1536) or not powers of two (TP8: 768).\"\"\"\n+    from vllm.models.flint.ops import norm\n+\n+    gen = torch.Generator(device=\"cuda\").manual_seed(d)\n+    x = (torch.randn(5, 2 * d, device=\"cuda\", generator=gen) * 3).bfloat16()\n+    out = norm.silu_and_mul(x)\n+    ref = _silu_and_mul_ref(x)\n+    assert (out == ref).float().mean() > 0.999\n+    torch.testing.assert_close(out, ref, rtol=2**-7, atol=1e-6)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5c142e4e8e73fa43e069a3f4733fd7d10b6ee8c8/tests%2Fmodels%2Fflint%2Ftest_flint_ops.py",
      "sha": "301e8fab12287dc7308a34b857972571d8451153",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5c142e4e8e73fa43e069a3f4733fd7d10b6ee8c8/vllm%2Fmodels%2Fflint%2Fops%2Fnorm.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Fflint%2Fops%2Fnorm.py?ref=5c142e4e8e73fa43e069a3f4733fd7d10b6ee8c8",
      "deletions": 2,
      "filename": "vllm/models/flint/ops/norm.py",
      "patch": "@@ -105,8 +105,7 @@ def silu_and_mul(x: torch.Tensor) -> torch.Tensor:\n     m, d2 = x.shape\n     d = d2 // 2\n     assert x.dtype == torch.bfloat16 and x.stride(-1) == 1\n-    bd = min(d, 1024)\n-    assert d % bd == 0\n+    bd = min(d & -d, 1024)  # largest pow2 divisor of d; TP shards 6144 to 1536/768\n     out = torch.empty(m, d, dtype=x.dtype, device=x.device)\n     if m > 0:\n         _silu_and_mul_kernel[(m, d // bd)](x, out, x.stride(0), D=d, BD=bd, num_warps=4)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5c142e4e8e73fa43e069a3f4733fd7d10b6ee8c8/vllm%2Fmodels%2Fflint%2Fops%2Fnorm.py",
      "sha": "7e45dcdeb4771e494b0a018320ad284b9d02f8b9",
      "status": "modified"
    }
