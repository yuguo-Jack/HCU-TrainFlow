      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/examples%2Fdeployment%2Fchart-helm%2Fvalues.schema.json?ref=19808bd387eb3f05150d4d8dbedc9768e77af1bc",
      "deletions": 0,
