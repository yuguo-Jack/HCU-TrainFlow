    {
      "additions": 35,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7e10831b0afdf6d57e26641baf2831770c5245c8/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_mooncake_store_worker.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_mooncake_store_worker.py?ref=7e10831b0afdf6d57e26641baf2831770c5245c8",
      "deletions": 0,
      "filename": "tests/v1/kv_connector/unit/test_mooncake_store_worker.py",
      "patch": "@@ -5192,3 +5192,38 @@ def test_blob_block_hashes_empty():\n     view = BlobBlockHashes(memoryview(b\"\"), 0)\n     assert len(view) == 0\n     assert list(view) == []\n+\n+\n+def _run_reset_message(monkeypatch, store_worker):\n+    socket = MagicMock()\n+    monkeypatch.setattr(worker.zmq, \"Context\", MagicMock())\n+    monkeypatch.setattr(worker, \"get_zmq_rpc_path_lookup\", lambda _: \"inproc://reset\")\n+    monkeypatch.setattr(worker, \"make_zmq_socket\", lambda *args, **kwargs: socket)\n+    with patch.object(worker.threading, \"Thread\") as thread:\n+        server = worker.LookupKeyServer(store_worker, MagicMock())\n+        process_request = thread.call_args.kwargs[\"target\"]\n+    socket.recv_multipart.return_value = [worker.RESET_MSG]\n+    socket.send.side_effect = lambda _: setattr(server, \"running\", False)\n+    process_request()\n+    return socket.send.call_args.args[0]\n+\n+\n+@pytest.mark.parametrize(\n+    (\"result\", \"expected\"),\n+    [\n+        (-1, worker.RESP_ERR),\n+        (0, worker.RESP_OK),\n+        (7, worker.RESP_OK),\n+        (RuntimeError(\"master unavailable\"), worker.RESP_ERR),\n+    ],\n+)\n+def test_reset_reports_removal_result(monkeypatch, result, expected):\n+    w = worker.MooncakeStoreWorker.__new__(worker.MooncakeStoreWorker)\n+    w.kv_send_thread = None\n+    w.store = MagicMock(spec=[\"remove_all\"])\n+    if isinstance(result, Exception):\n+        w.store.remove_all.side_effect = result\n+    else:\n+        w.store.remove_all.return_value = result\n+    assert _run_reset_message(monkeypatch, w) == expected\n+    w.store.remove_all.assert_called_once_with(force=True)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7e10831b0afdf6d57e26641baf2831770c5245c8/tests%2Fv1%2Fkv_connector%2Funit%2Ftest_mooncake_store_worker.py",
      "sha": "cd217d103b06a271e573d63eda2134037dfcc360",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7e10831b0afdf6d57e26641baf2831770c5245c8/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmooncake%2Fstore%2Fworker.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmooncake%2Fstore%2Fworker.py?ref=7e10831b0afdf6d57e26641baf2831770c5245c8",
      "deletions": 3,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/mooncake/store/worker.py",
      "patch": "@@ -2349,9 +2349,18 @@ def process_request():\n                         # flat key space, clearing every (group_id, hash) entry.\n                         if self.store_worker.kv_send_thread is not None:\n                             self.store_worker.kv_send_thread.request_queue.join()\n-                        self.store_worker.store.remove_all(force=True)\n-                        logger.info(\"Mooncake store reset via remove_all succeeded.\")\n-                        self.socket.send(RESP_OK)\n+                        removed = self.store_worker.store.remove_all(force=True)\n+                        if removed < 0:\n+                            logger.error(\n+                                \"Mooncake remove_all failed with error code %d.\",\n+                                removed,\n+                            )\n+                            self.socket.send(RESP_ERR)\n+                        else:\n+                            logger.info(\n+                                \"Mooncake store reset via remove_all succeeded.\"\n+                            )\n+                            self.socket.send(RESP_OK)\n                     except Exception as e:\n                         logger.error(\"Mooncake remove_all failed: %s\", e)\n                         self.socket.send(RESP_ERR)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7e10831b0afdf6d57e26641baf2831770c5245c8/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmooncake%2Fstore%2Fworker.py",
      "sha": "cf8ca873ebc1f65911af929d447cfb098aa6b140",
      "status": "modified"
    }
