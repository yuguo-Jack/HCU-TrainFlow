      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fkernels%2Fcore%2Ftest_vit_fp8_scaling.py?ref=c84db03fd33d11247215a7b5ca14b0eedd56098b",
      "deletions": 2,
      "filename": "tests/kernels/core/test_vit_fp8_scaling.py",
      "patch": "@@ -125,12 +125,14 @@ def test_dynamic_scaling_updates_scales(_make_attention) -> None:\n \n     S, H, D = 32, NUM_HEADS, HEAD_DIM\n     q = torch.full((S, H, D), 2.0, device=\"cuda\", dtype=torch.bfloat16)\n-    k = torch.full((S, H, D), 3.0, device=\"cuda\", dtype=torch.bfloat16)\n+    k = torch.full((S, H, D), -3.0, device=\"cuda\", dtype=torch.bfloat16)\n     v = torch.full((S, H, D), 4.0, device=\"cuda\", dtype=torch.bfloat16)\n \n+    # Include a larger negative outlier, an all-negative tensor, and positives.\n+    q.flatten()[0] = -8.0\n     attn._record_amax_and_update_scales(q, k, v)\n \n-    expected_q_scale = 2.0 / _FP8_MAX\n+    expected_q_scale = 8.0 / _FP8_MAX\n     expected_k_scale = 3.0 / _FP8_MAX\n     expected_v_scale = 4.0 / _FP8_MAX\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c84db03fd33d11247215a7b5ca14b0eedd56098b/tests%2Fkernels%2Fcore%2Ftest_vit_fp8_scaling.py",
      "sha": "0e01d93f7af4c4c3cc09e4c37c73cd7a1836b751",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c84db03fd33d11247215a7b5ca14b0eedd56098b/vllm%2Fmodel_executor%2Flayers%2Fattention%2Fmm_encoder_attention.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodel_executor%2Flayers%2Fattention%2Fmm_encoder_attention.py?ref=c84db03fd33d11247215a7b5ca14b0eedd56098b",
      "deletions": 1,
