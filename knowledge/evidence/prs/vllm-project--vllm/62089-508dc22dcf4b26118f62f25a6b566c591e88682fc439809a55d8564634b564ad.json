  "inline_comments": [
    {
      "body": "dataset_name is the loader type, not the dataset. Every --dataset-name hf run records \"hf\" whatever --dataset-path points at (VisionArena, AIMO, MT-Bench...), and custom and sharegpt runs record the same value for any input file. Grouping results by this key therefore merges different workloads, which is what the description says it enables. Suggest recording the path next to it: result_json[\"dataset_path\"] = args.dataset_path",
      "created_at": "2026-10-23T21:53:27Z",
      "diff_hunk": "@@ -2305,6 +2262,7 @@ async def main_async(args: argparse.Namespace) -> dict[str, Any]:\n     current_dt = datetime.now().strftime(\"%Y%m%d-%H%M%S\")\n     result_json[\"date\"] = current_dt\n     result_json[\"endpoint_type\"] = args.backend  # for backward compatibility\n+    result_json[\"dataset_name\"] = args.dataset_name",
