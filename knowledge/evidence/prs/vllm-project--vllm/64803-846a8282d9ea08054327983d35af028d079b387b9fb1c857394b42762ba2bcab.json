    {
      "additions": 84,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4fa2999187ae7417c1267d708503486f66e49174/vllm%2Fcompilation%2Fdepyf_compat.py",
      "changes": 84,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fcompilation%2Fdepyf_compat.py?ref=4fa2999187ae7417c1267d708503486f66e49174",
      "deletions": 0,
      "filename": "vllm/compilation/depyf_compat.py",
      "patch": "@@ -0,0 +1,84 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import contextlib\n+import inspect\n+import os\n+from collections.abc import Generator\n+from typing import Any\n+from unittest.mock import patch\n+\n+\n+def _patched_load_by_key_path(\n+    key: str,\n+    path: str,\n+    linemap: list[tuple[int, str]] | None = None,\n+    attrs: dict[str, Any] | None = None,\n+    *,\n+    set_sys_modules: bool | None = None,\n+    **kwargs: Any,\n+):\n+    \"\"\"Load an Inductor module while retaining its source for depyf.\n+\n+    depyf 0.20.0 predates the ``set_sys_modules`` keyword added to\n+    ``PyCodeCache.load_by_key_path``. This is the depyf hook with the newer\n+    Torch arguments forwarded to the original loader.\n+    \"\"\"\n+    from depyf.explain.global_variables import data\n+    from depyf.explain.utils import (\n+        get_current_compiled_fn_name,\n+        write_code_to_file_template,\n+    )\n+\n+    dump_src_dir = data[\"dump_src_dir\"]\n+    unpatched_load_by_key_path = data[\"unpatched_load_by_key_path\"]\n+\n+    with open(path) as source_file:\n+        src = source_file.read()\n+\n+    func_name = get_current_compiled_fn_name()\n+    new_filepath = write_code_to_file_template(\n+        src, os.path.join(dump_src_dir, func_name + \".kernel_\" + \"%s\" + \".py\")\n+    )\n+    return unpatched_load_by_key_path(\n+        key,\n+        new_filepath,\n+        linemap,\n+        attrs,\n+        set_sys_modules=set_sys_modules,\n+        **kwargs,\n+    )\n+\n+\n+def _needs_loader_compat(torch_loader: Any, depyf_loader: Any) -> bool:\n+    torch_parameters = inspect.signature(torch_loader).parameters\n+    depyf_parameters = inspect.signature(depyf_loader).parameters\n+    if \"set_sys_modules\" not in torch_parameters:\n+        return False\n+    return \"set_sys_modules\" not in depyf_parameters and not any(\n+        parameter.kind == inspect.Parameter.VAR_KEYWORD\n+        for parameter in depyf_parameters.values()\n+    )\n+\n+\n+@contextlib.contextmanager\n+def prepare_debug(dump_src_dir: str) -> Generator[None, None, None]:\n+    \"\"\"Prepare depyf debugging with compatibility for Torch loader changes.\"\"\"\n+    import depyf\n+    from depyf.explain import enable_debugging\n+    from torch._inductor import codecache\n+\n+    torch_loader = codecache.PyCodeCache.load_by_key_path\n+    depyf_loader = enable_debugging.patched_load_by_key_path\n+    if not _needs_loader_compat(torch_loader, depyf_loader):\n+        with depyf.prepare_debug(dump_src_dir):\n+            yield\n+        return\n+\n+    with (\n+        patch.object(\n+            enable_debugging, \"patched_load_by_key_path\", _patched_load_by_key_path\n+        ),\n+        depyf.prepare_debug(dump_src_dir),\n+    ):\n+        yield",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4fa2999187ae7417c1267d708503486f66e49174/vllm%2Fcompilation%2Fdepyf_compat.py",
      "sha": "97cd2e7a3031f70b923c8806fa4bcd7ffa840329",
      "status": "added"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/4fa2999187ae7417c1267d708503486f66e49174/vllm%2Fcompilation%2Fmonitor.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fcompilation%2Fmonitor.py?ref=4fa2999187ae7417c1267d708503486f66e49174",
      "deletions": 3,
      "filename": "vllm/compilation/monitor.py",
      "patch": "@@ -8,6 +8,8 @@\n from vllm.config import CompilationMode, VllmConfig\n from vllm.logger import init_logger\n \n+from .depyf_compat import prepare_debug\n+\n logger = init_logger(__name__)\n \n # Shared global so backends.py can read the start time for Dynamo timing.\n@@ -41,11 +43,9 @@ def monitor_torch_compile(\n     depyf_cm = None\n     path = vllm_config.compile_debug_dump_path()\n     if compilation_config.mode == CompilationMode.VLLM_COMPILE and path:\n-        import depyf\n-\n         path.mkdir(parents=True, exist_ok=True)\n         logger.debug(\"Dumping depyf output to %s\", path)\n-        depyf_cm = depyf.prepare_debug(path.as_posix())\n+        depyf_cm = prepare_debug(path.as_posix())\n         depyf_cm.__enter__()\n \n     try:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4fa2999187ae7417c1267d708503486f66e49174/vllm%2Fcompilation%2Fmonitor.py",
