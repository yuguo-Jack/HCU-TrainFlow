      "changes": 69,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Futils_%2Ftest_math_utils.py?ref=4018f7f2e55c7c089bd554a597a2f3e8fa90b67e",
      "deletions": 0,
      "filename": "tests/utils_/test_math_utils.py",
      "patch": "@@ -0,0 +1,69 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import pytest\n+\n+from vllm.utils.math_utils import (\n+    largest_power_of_2_divisor,\n+    prev_power_of_2,\n+    round_up_to,\n+)\n+\n+\n+@pytest.mark.parametrize(\n+    \"n,expected\",\n+    [\n+        (0, 0),\n+        (-3, 0),\n+        (1, 1),\n+        (2, 2),\n+        (3, 2),\n+        (4, 4),\n+        (7, 4),\n+        (8, 8),\n+        (9, 8),\n+        (16, 16),\n+        (100, 64),\n+        (1024, 1024),\n+        (1025, 1024),\n+    ],\n+)\n+def test_prev_power_of_2(n, expected):\n+    assert prev_power_of_2(n) == expected\n+\n+\n+@pytest.mark.parametrize(\n+    \"n,expected\",\n+    [\n+        (0, 0),\n+        (1, 1),\n+        (2, 2),\n+        (3, 1),\n+        (4, 4),\n+        (6, 2),\n+        (7, 1),\n+        (12, 4),\n+        (16, 16),\n+        (24, 8),\n+    ],\n+)\n+def test_largest_power_of_2_divisor(n, expected):\n+    assert largest_power_of_2_divisor(n) == expected\n+\n+\n+@pytest.mark.parametrize(\n+    \"values,n,expected\",\n+    [\n+        ([2, 4, 8], 1, 2),\n+        ([2, 4, 8], 2, 2),\n+        ([2, 4, 8], 3, 4),\n+        ([2, 4, 8], 8, 8),\n+        ([2, 4, 8], 9, None),\n+        ([], 5, None),\n+        ([5], 5, 5),\n+        ([5], 6, None),\n+        ([1, 3, 6, 10], 7, 10),\n+    ],\n+)\n+def test_round_up_to(values, n, expected):\n+    assert round_up_to(values, n) == expected",
      "raw_url": "https://github.com/vllm-project/vllm/raw/4018f7f2e55c7c089bd554a597a2f3e8fa90b67e/tests%2Futils_%2Ftest_math_utils.py",
