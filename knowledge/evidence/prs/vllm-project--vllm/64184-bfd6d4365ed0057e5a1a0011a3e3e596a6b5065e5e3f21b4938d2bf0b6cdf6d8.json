      "blob_url": "https://github.com/vllm-project/vllm/blob/77318aaa0c4b5d8e250dcc40d6d6200cbe5d8a94/tests%2Fv1%2Fengine%2Ftest_engine_core.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fengine%2Ftest_engine_core.py?ref=77318aaa0c4b5d8e250dcc40d6d6200cbe5d8a94",
      "deletions": 0,
      "filename": "tests/v1/engine/test_engine_core.py",
      "patch": "@@ -752,6 +752,7 @@ def _pausable_engine_core_proc() -> EngineCoreProc:\n     \"\"\"A bare EngineCoreProc holding just the state pause_scheduler touches.\"\"\"\n     core = object.__new__(EngineCoreProc)\n     core.model_executor = MagicMock()\n+    core.model_executor.is_sleeping = False\n     core.scheduler = MagicMock()\n     core.scheduler.has_requests.return_value = False\n     core.batch_queue = None\n@@ -760,6 +761,16 @@ def _pausable_engine_core_proc() -> EngineCoreProc:\n     return core\n \n \n+def test_sleep_resume_rejection_preserves_request_policy():\n+    core = _pausable_engine_core_proc()\n+    core.model_executor.is_sleeping = True\n+    core.reject_new_requests = True\n+    with pytest.raises(RuntimeError, match=\"sleeping\"):\n+        core.resume_scheduler()\n+    assert core.reject_new_requests\n+    core.scheduler.set_pause_state.assert_not_called()\n+\n+\n @pytest.mark.parametrize(\n     \"mode,user_pause,kind,rejected\",\n     [",
      "raw_url": "https://github.com/vllm-project/vllm/raw/77318aaa0c4b5d8e250dcc40d6d6200cbe5d8a94/tests%2Fv1%2Fengine%2Ftest_engine_core.py",
      "sha": "a28b69a2f760e5a7528fcb4709d37c904b4fc2ac",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/77318aaa0c4b5d8e250dcc40d6d6200cbe5d8a94/vllm%2Fv1%2Fengine%2Fcore.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Fcore.py?ref=77318aaa0c4b5d8e250dcc40d6d6200cbe5d8a94",
      "deletions": 0,
      "filename": "vllm/v1/engine/core.py",
      "patch": "@@ -1008,6 +1008,10 @@ def resume_scheduler(self) -> None:\n                 f\"Cannot resume scheduling while the checkpoint state is \"\n                 f\"{self._checkpoint_state}\"\n             )\n+        if self.model_executor.is_sleeping:\n+            raise RuntimeError(\n+                \"Cannot resume with sleeping memory; wake all tags first\"\n+            )\n         self.scheduler.set_pause_state(PauseState.UNPAUSED)\n         if self._checkpoint_state == CheckpointState.RESTORING:\n             self._checkpoint_state = CheckpointState.RUNNING",
      "raw_url": "https://github.com/vllm-project/vllm/raw/77318aaa0c4b5d8e250dcc40d6d6200cbe5d8a94/vllm%2Fv1%2Fengine%2Fcore.py",
