  "files": [
    {
      "additions": 1,
      "blob_url": "https://github.com/vllm-project/vllm/blob/3f6aeaa6a88c0ac307ee127cc34285d609fde080/CMakeLists.txt",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/CMakeLists.txt?ref=3f6aeaa6a88c0ac307ee127cc34285d609fde080",
      "deletions": 1,
      "filename": "CMakeLists.txt",
      "patch": "@@ -371,7 +371,7 @@ if(VLLM_GPU_LANG STREQUAL \"HIP\")\n   # Octave KV cache (store, decode, rotation, prefill): only built for the\n   # validated architectures, gfx1100 (RDNA3) and gfx942 (MI300).\n   set(VLLM_OCTAVE_KV OFF)\n-  if(VLLM_GPU_ARCHES MATCHES \"gfx942|gfx1100\")\n+  if(VLLM_GPU_ARCHES MATCHES \"gfx942|gfx1100|gfx1151\")\n     set(VLLM_OCTAVE_KV ON)\n     list(APPEND VLLM_EXT_SRC\n       \"csrc/attention/octave_torch_bindings.cpp\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/3f6aeaa6a88c0ac307ee127cc34285d609fde080/CMakeLists.txt",
      "sha": "9931264e57c840be36ac58392e7f4a3a7b53858a",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/vllm-project/vllm/blob/3f6aeaa6a88c0ac307ee127cc34285d609fde080/csrc%2Fattention%2Foctave_decode_wmma_rdna3.cu",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/csrc%2Fattention%2Foctave_decode_wmma_rdna3.cu?ref=3f6aeaa6a88c0ac307ee127cc34285d609fde080",
      "deletions": 2,
