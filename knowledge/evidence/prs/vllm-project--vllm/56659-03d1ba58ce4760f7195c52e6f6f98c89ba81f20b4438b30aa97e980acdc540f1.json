      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/csrc%2Flibtorch_stable%2Fquantization%2Fw8a8%2Fcutlass%2Fc3x%2Fscaled_mm_blockwise_sm120_fp8_dispatch.cuh?ref=b89d84a94cf54984ff42df69f0ce6bd242a5af0f",
      "deletions": 0,
      "filename": "csrc/libtorch_stable/quantization/w8a8/cutlass/c3x/scaled_mm_blockwise_sm120_fp8_dispatch.cuh",
      "patch": "@@ -204,6 +204,14 @@ void cutlass_gemm_caller_blockwise(torch::stable::Tensor& out, torch::stable::Te\n   c_stride =\n       cutlass::make_cute_packed_stride(StrideC{}, swap_ab ? cute::make_shape(n, m, 1) : cute::make_shape(m, n, 1));\n \n+  // Preserve the runtime leading strides of valid padded tensor views instead\n+  // of the packed values reconstructed from shape. The swapped epilogue views\n+  // the row-major output as its column-major transpose, so its leading stride\n+  // belongs in the second stride component.\n+  cute::get<0>(a_stride) = a.stride(0);\n+  cute::get<0>(b_stride) = b.stride(1);\n+  cute::get<swap_ab ? 1 : 0>(c_stride) = out.stride(0);\n+\n   LayoutSFA layout_SFA = swap_ab ?\n       ScaleConfig::tile_atom_to_shape_SFA(make_shape(n, m, k, 1)) :\n       ScaleConfig::tile_atom_to_shape_SFA(make_shape(m, n, k, 1));",
      "raw_url": "https://github.com/vllm-project/vllm/raw/b89d84a94cf54984ff42df69f0ce6bd242a5af0f/csrc%2Flibtorch_stable%2Fquantization%2Fw8a8%2Fcutlass%2Fc3x%2Fscaled_mm_blockwise_sm120_fp8_dispatch.cuh",
      "sha": "00fb4080212ad9663f877a19a7621b72baaa22d2",
      "status": "modified"
    },
