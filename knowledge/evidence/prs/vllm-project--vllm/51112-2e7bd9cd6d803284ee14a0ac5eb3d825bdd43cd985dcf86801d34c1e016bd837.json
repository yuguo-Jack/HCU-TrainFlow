    {
      "additions": 10,
      "blob_url": "https://github.com/vllm-project/vllm/blob/ed445dfb039ad37485a9b30b3378542fabe3d0fd/cmake%2Fexternal_projects%2Fqutlass.cmake",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/cmake%2Fexternal_projects%2Fqutlass.cmake?ref=ed445dfb039ad37485a9b30b3378542fabe3d0fd",
      "deletions": 1,
      "filename": "cmake/external_projects/qutlass.cmake",
      "patch": "@@ -32,7 +32,16 @@ else()\n   set(_qutlass_bin \"${_qutlass_fc_root}/qutlass-build\")\n   set(_qutlass_sub \"${_qutlass_fc_root}/qutlass-subbuild\")\n \n-  if(EXISTS \"${_qutlass_src}/qutlass/csrc/bindings.cpp\")\n+  find_package(Git REQUIRED)\n+  execute_process(\n+    COMMAND \"${GIT_EXECUTABLE}\" -C \"${_qutlass_src}\" rev-parse HEAD\n+    RESULT_VARIABLE _qutlass_git_result\n+    OUTPUT_VARIABLE _qutlass_git_revision\n+    ERROR_QUIET\n+    OUTPUT_STRIP_TRAILING_WHITESPACE)\n+\n+  if(_qutlass_git_result EQUAL 0 AND\n+     _qutlass_git_revision STREQUAL _QUTLASS_UPSTREAM_TAG)\n     set(qutlass_SOURCE_DIR \"${_qutlass_src}\")\n     set(qutlass_BINARY_DIR \"${_qutlass_bin}\")\n   else()",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ed445dfb039ad37485a9b30b3378542fabe3d0fd/cmake%2Fexternal_projects%2Fqutlass.cmake",
      "sha": "0131968029bb447805b89f41f2cec37b7ce3bf55",
      "status": "modified"
    }
