      "changes": 127,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fworker%2Ftest_gpu_target_dependent_ar_speculator.py?ref=59a6b29361ab5e794354414882a701281dd796c8",
      "deletions": 0,
      "filename": "tests/v1/worker/test_gpu_target_dependent_ar_speculator.py",
      "patch": "@@ -631,3 +631,130 @@ def test_decode_metadata_update_needs_draft_decode_steps(\n     speculator._configure_decode_metadata_update()\n \n     assert speculator.supports_decode_metadata_update is expected\n+\n+\n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"requires CUDA\")\n+@pytest.mark.parametrize(\"num_reqs_padded\", [5, 8])\n+@pytest.mark.parametrize(\"use_pcp\", [False, True])\n+@pytest.mark.parametrize(\"fused\", [False, True])\n+@pytest.mark.parametrize(\"dummy_state\", [None, \"null\", \"valid\"])\n+def test_propose_clears_stale_block_rows_before_draft_decode(\n+    monkeypatch, num_reqs_padded, use_pcp, fused, dummy_state\n+):\n+    \"\"\"Draft graph padding must not write another request's circular KV block.\"\"\"\n+    from vllm.v1.attention.backends.mla.indexer import (\n+        compute_kpool_tail_slot_mapping,\n+    )\n+    from vllm.v1.worker.gpu.block_table import BlockTables\n+\n+    device = torch.device(\"cuda\")\n+    tables = BlockTables([8], 8, 8, [1], device, slot_mapping_enabled=[False])\n+    for req_index in range(5):\n+        tables.append_block_ids(req_index, ([req_index + 1],), overwrite=True)\n+    tables.apply_staged_writes()\n+    idx_mapping = torch.tensor([2, 0, 4, 1, 3], dtype=torch.int32, device=device)\n+    dummy_run = dummy_state is not None\n+    tables.input_block_tables[0].fill_(7)\n+    tables.gather_block_tables(idx_mapping, num_reqs_padded=5)\n+    if dummy_run:\n+        tables.get_dummy_block_tables(5)\n+        if dummy_state == \"valid\":\n+            tables.input_block_tables[0][:5, 0].copy_(\n+                torch.arange(1, 6, dtype=torch.int32, device=device)\n+            )\n+        monkeypatch.setattr(\n+            tables, \"gather_block_tables\", Mock(side_effect=AssertionError)\n+        )\n+    table_ptr = tables.input_block_tables[0].data_ptr()\n+    seq_lens = torch.full((5,), 20, dtype=torch.int32)\n+    batch = SimpleNamespace(\n+        num_reqs=5,\n+        num_tokens=8,\n+        num_tokens_after_padding=8,\n+        num_scheduled_tokens=torch.tensor([1, 1, 2, 2, 2]).numpy(),\n+        seq_lens_cpu_upper_bound=seq_lens,\n+        seq_lens=seq_lens.to(device),\n+        idx_mapping=idx_mapping,\n+        decode_graph_eligible=False,\n+    )\n+    speculator = object.__new__(_TestSpeculator)\n+    speculator.num_speculative_steps = 3\n+    speculator.max_model_len = 64\n+    speculator.max_num_reqs = 8\n+    speculator.dp_size = 1\n+    speculator.dp_rank = 0\n+    speculator.block_tables = tables\n+    speculator.hidden_states = torch.zeros(8, 1, device=device)\n+    speculator.draft_tokens = torch.zeros(8, 3, dtype=torch.int64, device=device)\n+    speculator.last_token_indices = speculator.sample_src_positions = None\n+    speculator.current_draft_step = None\n+    speculator.input_buffers = SimpleNamespace(input_ids=torch.zeros(8))\n+    speculator._copy_request_inputs = Mock()\n+    speculator._prepare_eplb_forward = Mock()\n+    speculator._prefill = Mock()\n+    speculator.prefill_cudagraph_manager = None\n+    speculator.pcp_manager = (\n+        SimpleNamespace(prepare_draft_prefill=Mock(), draft_prefill_batch=None)\n+        if use_pcp\n+        else None\n+    )\n+    prefill_desc = BatchExecutionDescriptor(\n+        cg_mode=CUDAGraphMode.NONE, num_tokens=8, num_reqs=5\n+    )\n+    decode_desc = BatchExecutionDescriptor(\n+        cg_mode=CUDAGraphMode.FULL,\n+        num_tokens=num_reqs_padded,\n+        num_reqs=num_reqs_padded,\n+    )\n+    speculator.decode_cudagraph_manager = SimpleNamespace(\n+        specialize_spec_tokens=lambda desc, _: desc\n+    )\n+    speculator.supports_decode_metadata_update = fused\n+    monkeypatch.setattr(spec_module, \"prepare_prefill_inputs\", Mock())\n+    monkeypatch.setattr(spec_module, \"prepare_decode_inputs\", Mock())\n+    monkeypatch.setattr(\n+        spec_module,\n+        \"dispatch_cg_and_sync_dp\",\n+        Mock(side_effect=[(prefill_desc, None), (decode_desc, None)]),\n+    )\n+    observed_slots = []\n+\n+    def decode(*args):\n+        # The final padded row absorbs the remaining graph tokens.\n+        query_start_loc = torch.arange(\n+            num_reqs_padded + 1, dtype=torch.int32, device=device\n+        ).clamp_max_(5)\n+        slots = compute_kpool_tail_slot_mapping(\n+            torch.full((num_reqs_padded,), -1, dtype=torch.int64, device=device),\n+            tables.input_block_tables[0][:num_reqs_padded],\n+            query_start_loc,\n+            torch.arange(num_reqs_padded, dtype=torch.int64, device=device),\n+            num_actual_tokens=num_reqs_padded,\n+            num_reqs=num_reqs_padded,\n+            kpool=8,\n+        )\n+        observed_slots.extend(slots.tolist())\n+\n+    speculator._multi_step_decode = speculator._fused_multi_step_decode = decode\n+    unused = torch.zeros(5, device=device)\n+    speculator.propose(\n+        batch,\n+        {},\n+        {},\n+        speculator.hidden_states.clone(),\n+        None,\n+        unused,\n+        unused,\n+        unused,\n+        unused,\n+        unused,\n+        unused,\n+        dummy_run=dummy_run,\n+    )\n+    expected = [-1] * num_reqs_padded\n+    if not dummy_run:\n+        expected[:5] = [24, 9, 42, 19, 36]\n+    elif dummy_state == \"valid\":\n+        expected[:5] = [8, 17, 26, 35, 44]\n+    assert observed_slots == expected\n+    assert tables.input_block_tables[0].data_ptr() == table_ptr",
      "raw_url": "https://github.com/vllm-project/vllm/raw/59a6b29361ab5e794354414882a701281dd796c8/tests%2Fv1%2Fworker%2Ftest_gpu_target_dependent_ar_speculator.py",
