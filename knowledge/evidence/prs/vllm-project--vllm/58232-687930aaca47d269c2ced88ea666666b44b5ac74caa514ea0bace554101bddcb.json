  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/7f7a9dfa55c4d5152e12ccd70a58a6a4706ee1ca/tests%2Fevals%2Fgpt_oss%2Fconfigs%2Fgpt-oss-20b-sm120.yaml",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fevals%2Fgpt_oss%2Fconfigs%2Fgpt-oss-20b-sm120.yaml?ref=7f7a9dfa55c4d5152e12ccd70a58a6a4706ee1ca",
      "deletions": 0,
      "filename": "tests/evals/gpt_oss/configs/gpt-oss-20b-sm120.yaml",
      "patch": "@@ -1,5 +1,9 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n model_name: \"openai/gpt-oss-20b\"\n+# DGX Spark's GPU memory is unified with system RAM, so free memory on startup\n+# is never close to the reported total. The default utilization of 0.92 asks for\n+# more than is ever available and the engine refuses to start.\n+server_args: \"--gpu-memory-utilization 0.6\"\n metric_threshold: 0.568\n reasoning_effort: \"low\"",
      "raw_url": "https://github.com/vllm-project/vllm/raw/7f7a9dfa55c4d5152e12ccd70a58a6a4706ee1ca/tests%2Fevals%2Fgpt_oss%2Fconfigs%2Fgpt-oss-20b-sm120.yaml",
      "sha": "3aea07ccf66840dec5f4c41f6c0379aeb1e7ea15",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "Minor: on the CI node free memory is 110 to 114 GiB of 121.7, and `MemorySnapshot` already reads `psutil.virtual_memory().available` on integrated GPUs, so page cache is counted as free. Could you reword this to the actual reason, e.g. \"free memory on the CI Spark varies by a few GiB around the 0.92 request (111.95 GiB)\"? Same for the description.",
      "created_at": "2026-10-13T04:39:40Z",
      "diff_hunk": "@@ -1,5 +1,9 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n model_name: \"openai/gpt-oss-20b\"\n+# DGX Spark's GPU memory is unified with system RAM, so free memory on startup\n+# is never close to the reported total. The default utilization of 0.92 asks for\n+# more than is ever available and the engine refuses to start.",
      "html_url": "https://github.com/vllm-project/vllm/pull/58232#discussion_r4254789666",
      "id": 4254789666,
      "line": 6,
      "original_line": 6,
      "path": "tests/evals/gpt_oss/configs/gpt-oss-20b-sm120.yaml",
      "updated_at": "2026-10-13T04:39:40Z",
      "user": {
        "login": "stecasta"
      }
    },
    {
      "body": "Minor: the MI355 GPQA step in `lm_eval.yaml` mirrors this step and runs the same `models-spark.txt`, so it picks up 0.6 too. Fine for a 20B model, but worth a line in the comment so nobody tunes this value for Spark alone later.",
      "created_at": "2026-10-13T04:39:40Z",
      "diff_hunk": "@@ -1,5 +1,9 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n model_name: \"openai/gpt-oss-20b\"\n+# DGX Spark's GPU memory is unified with system RAM, so free memory on startup\n+# is never close to the reported total. The default utilization of 0.92 asks for\n+# more than is ever available and the engine refuses to start.\n+server_args: \"--gpu-memory-utilization 0.6\"",
      "html_url": "https://github.com/vllm-project/vllm/pull/58232#discussion_r4254789671",
      "id": 4254789671,
      "line": 7,
      "original_line": 7,
      "path": "tests/evals/gpt_oss/configs/gpt-oss-20b-sm120.yaml",
      "updated_at": "2026-10-13T04:39:40Z",
      "user": {
        "login": "stecasta"
      }
    }
  ],
