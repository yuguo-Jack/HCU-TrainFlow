      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_transfer_state.py?ref=533e525b72bf3293955e88f4bad25562676734bf",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_transfer_state.py",
      "patch": "@@ -53,10 +53,12 @@ def _sync_engine_id_across_tp(vllm_config: \"VllmConfig\") -> None:\n     \"\"\"Broadcast engine_id from TP rank 0 so all workers in a\n     multi-node TP group share the same value.\n \n+    When PCP is enabled, also broadcast across PCP ranks.\n     When PP is enabled, also broadcast across PP ranks so all workers in\n     the same model-parallel engine share the same value.\n     \"\"\"\n     from vllm.distributed.parallel_state import (\n+        get_pcp_group,\n         get_pp_group,\n         get_tp_group,\n     )\n@@ -65,6 +67,8 @@ def _sync_engine_id_across_tp(vllm_config: \"VllmConfig\") -> None:\n     synced_id = get_tp_group().broadcast_object(\n         vllm_config.kv_transfer_config.engine_id, src=0\n     )\n+    if vllm_config.parallel_config.prefill_context_parallel_size > 1:\n+        synced_id = get_pcp_group().broadcast_object(synced_id, src=0)\n     if vllm_config.parallel_config.pipeline_parallel_size > 1:\n         synced_id = get_pp_group().broadcast_object(synced_id, src=0)\n     vllm_config.kv_transfer_config.engine_id = synced_id",
      "raw_url": "https://github.com/vllm-project/vllm/raw/533e525b72bf3293955e88f4bad25562676734bf/vllm%2Fdistributed%2Fkv_transfer%2Fkv_transfer_state.py",
