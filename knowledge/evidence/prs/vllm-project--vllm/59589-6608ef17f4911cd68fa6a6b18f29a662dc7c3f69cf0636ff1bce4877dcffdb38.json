    {
      "additions": 37,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d995db49cad72e219783b536a65fbd4a2af601ec/tests%2Ftool_parsers%2Ftest_deepseekv31_tool_parser.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_parsers%2Ftest_deepseekv31_tool_parser.py?ref=d995db49cad72e219783b536a65fbd4a2af601ec",
      "deletions": 2,
      "filename": "tests/tool_parsers/test_deepseekv31_tool_parser.py",
      "patch": "@@ -3,6 +3,7 @@\n \n import pytest\n \n+from tests.tool_parsers.utils import run_tool_extraction\n from vllm.tokenizers import get_tokenizer\n from vllm.tool_parsers.deepseekv31_tool_parser import (\n     DeepSeekV31ToolParser,\n@@ -57,5 +58,39 @@ def test_extract_tool_calls_with_multiple_tools(parser):\n     assert result.tool_calls[1].function.name == \"bar\"\n     assert result.tool_calls[1].function.arguments == '{\"y\":2}'\n \n-    # prefix is content\n-    assert result.content == \"some prefix text\"\n+    # Text before the block and text after it are both content.\n+    assert result.content == \"some prefix text some suffix text\"\n+\n+\n+@pytest.mark.parametrize(\"streaming\", [False, True])\n+def test_preserves_text_after_tool_call(\n+    parser,\n+    streaming: bool,\n+) -> None:\n+    \"\"\"PR 59589 regression test\"\"\"\n+    # Note(arpera):\n+    # This is basically copypaste of the same test\n+    # test_preserves_text_after_tool_call for DSv3 parser\n+    # The only difference is that DSv3.1 parser does NOT\n+    # use function<｜tool▁sep｜> substring due to different\n+    # markup formats.\n+    model_output = (\n+        \"let me check the weather.\"\n+        \"<｜tool▁calls▁begin｜>\"\n+        \"<｜tool▁call▁begin｜>get_weather<｜tool▁sep｜>\"\n+        '{\"city\":\"Paris\"}'\n+        \"<｜tool▁call▁end｜>\"\n+        \"<｜tool▁calls▁end｜>\"\n+        \"It is 30 degrees.\"\n+    )\n+\n+    content, tool_calls = run_tool_extraction(\n+        parser,\n+        model_output,\n+        streaming=streaming,\n+    )\n+\n+    assert content == \"let me check the weather.It is 30 degrees.\"\n+    assert len(tool_calls) == 1\n+    assert tool_calls[0].function.name == \"get_weather\"\n+    assert tool_calls[0].function.arguments == '{\"city\":\"Paris\"}'",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d995db49cad72e219783b536a65fbd4a2af601ec/tests%2Ftool_parsers%2Ftest_deepseekv31_tool_parser.py",
      "sha": "2674512ccfd5ca62fd208068ca39f0fd9e440f57",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/d995db49cad72e219783b536a65fbd4a2af601ec/vllm%2Ftool_parsers%2Fdeepseekv31_tool_parser.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fdeepseekv31_tool_parser.py?ref=d995db49cad72e219783b536a65fbd4a2af601ec",
      "deletions": 1,
      "filename": "vllm/tool_parsers/deepseekv31_tool_parser.py",
      "patch": "@@ -106,7 +106,13 @@ def extract_tool_calls(\n                         )\n                     )\n \n-                content = model_output[: model_output.find(self.tool_calls_start_token)]\n+                tool_calls_start = model_output.find(self.tool_calls_start_token)\n+                tool_calls_end = model_output.rfind(self.tool_calls_end_token)\n+                content = model_output[:tool_calls_start]\n+                if tool_calls_end != -1:\n+                    content += model_output[\n+                        tool_calls_end + len(self.tool_calls_end_token) :\n+                    ]\n                 return ExtractedToolCallInformation(\n                     tools_called=True,\n                     tool_calls=tool_calls,",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d995db49cad72e219783b536a65fbd4a2af601ec/vllm%2Ftool_parsers%2Fdeepseekv31_tool_parser.py",
      "sha": "f18fda9a15b66351b3a1ffa1f8f42c04ff15ec7e",
      "status": "modified"
    }
