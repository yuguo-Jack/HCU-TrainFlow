      "blob_url": "https://github.com/vllm-project/vllm/blob/d50e9f3cca79a5004ce95105e46f80c46f115937/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fbase_worker.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fbase_worker.py?ref=d50e9f3cca79a5004ce95105e46f80c46f115937",
      "deletions": 1,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/nixl/base_worker.py",
      "patch": "@@ -252,8 +252,14 @@ def __init__(\n             raise ValueError(\"kv_transfer_config must be set for NixlConnector\")\n         self.kv_transfer_config = vllm_config.kv_transfer_config\n \n+        # On ROCm/AMD platforms the NIXL package ships without UCX support and\n+        # only provides the `cuda_ipc` backend.  Fall back to `cuda_ipc` unless\n+        # the user has explicitly set a backend via kv_connector_extra_config.\n+        _default_nixl_backends = (\n+            [\"cuda_ipc\"] if current_platform.is_rocm() else [\"UCX\"]\n+        )\n         self.nixl_backends = vllm_config.kv_transfer_config.get_from_extra_config(\n-            \"backends\", [\"UCX\"]\n+            \"backends\", _default_nixl_backends\n         )\n         kv_lease_duration: int = vllm_config.kv_transfer_config.get_from_extra_config(\n             \"kv_lease_duration\", 30",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d50e9f3cca79a5004ce95105e46f80c46f115937/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fnixl%2Fbase_worker.py",
