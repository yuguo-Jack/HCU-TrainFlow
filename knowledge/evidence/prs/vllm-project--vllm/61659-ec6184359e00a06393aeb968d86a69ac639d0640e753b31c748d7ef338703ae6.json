      "blob_url": "https://github.com/vllm-project/vllm/blob/98506b5bd6dac6db89c2c621543ce2a1a289b674/tests%2Fv1%2Fattention%2Ftest_sparse_mla_backends.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fattention%2Ftest_sparse_mla_backends.py?ref=98506b5bd6dac6db89c2c621543ce2a1a289b674",
      "deletions": 0,
      "filename": "tests/v1/attention/test_sparse_mla_backends.py",
      "patch": "@@ -3531,6 +3531,33 @@ def test_hisparse_gather_prefill_cache_prefers_resident_rows():\n         torch.testing.assert_close(staged_flat[i], expected)\n \n \n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"requires CUDA\")\n+def test_hisparse_staged_prefill_cache_backs_min_attention_rows():\n+    \"\"\"A staged cache of a few blocks still has 256 allocated rows behind it.\n+\n+    trtllm-gen sparse MLA reads ~200 rows from the start of its KV cache\n+    whatever its size, faulting when a smaller cache ends at an unmapped page.\n+    \"\"\"\n+    if not _has_hisparse_ops():\n+        pytest.skip(\"hisparse CUDA ops unavailable\")\n+    device = torch.device(\"cuda\")\n+    block_size, row_width = 64, 16\n+    block_table = torch.tensor([[3, 1]], dtype=torch.int32, device=device)\n+    seq_lens = torch.tensor([100], dtype=torch.int32, device=device)\n+    plan = build_hisparse_prefill_staging_plan(\n+        block_table, seq_lens, block_size, staging_block_capacity=2\n+    )\n+    host_cache = torch.zeros(4, block_size, row_width).pin_memory()\n+\n+    staged = HiSparseRuntime.gather_prefill_cache(None, host_cache, plan)\n+\n+    assert staged.shape[0] * block_size < 256\n+    backing_rows = staged.untyped_storage().nbytes() // (\n+        row_width * staged.element_size()\n+    )\n+    assert backing_rows >= 256\n+\n+\n def test_hisparse_fp8_decode_resolves_rows_once_then_runs_batched_attention():\n     \"\"\"Verification rows resolve in one swap_in; FP8 attention sees them batched.\"\"\"\n     device = torch.device(\"cpu\")",
      "raw_url": "https://github.com/vllm-project/vllm/raw/98506b5bd6dac6db89c2c621543ce2a1a289b674/tests%2Fv1%2Fattention%2Ftest_sparse_mla_backends.py",
      "sha": "59a36fea4d3dd08f7089bd34f0f8064be0af4ee8",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/98506b5bd6dac6db89c2c621543ce2a1a289b674/vllm%2Fv1%2Fhisparse%2Fruntime.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fhisparse%2Fruntime.py?ref=98506b5bd6dac6db89c2c621543ce2a1a289b674",
      "deletions": 6,
      "filename": "vllm/v1/hisparse/runtime.py",
      "patch": "@@ -39,6 +39,9 @@\n # fp8_ds_mla KV row: 512 B quantized NoPE + 16 B scales + 128 B RoPE.\n FP8_DS_MLA_ROW_BYTES = 656\n HiSparseTopKResult: TypeAlias = torch.Tensor | tuple[torch.Tensor, torch.Tensor]\n+# trtllm-gen sparse MLA reads ~200 rows from the start of its KV cache\n+# whatever the cache's size: https://github.com/flashinfer-ai/flashinfer/issues/6484\n+_MIN_STAGED_PREFILL_KV_ROWS = 256\n \n \n def is_hisparse_decode_batch(attn_metadata: Any | None) -> bool:\n@@ -829,15 +832,13 @@ def gather_prefill_cache(\n             )\n         row_width = kv_cache.shape[-1]\n \n+        num_blocks = plan.row_ids.shape[1] // plan.block_size\n+        min_blocks = cdiv(_MIN_STAGED_PREFILL_KV_ROWS, plan.block_size)\n         staged = torch.empty(\n-            (\n-                plan.row_ids.shape[1] // plan.block_size,\n-                plan.block_size,\n-                row_width,\n-            ),\n+            (max(num_blocks, min_blocks), plan.block_size, row_width),\n             dtype=kv_cache.dtype,\n             device=plan.block_table.device,\n-        )\n+        )[:num_blocks]\n         if plan.gpu_row_ids is not None and resident_cache is not None:\n             gpu_rows = plan.gpu_row_ids[0].to(torch.long)\n             src = gpu_rows.clamp_min(0)",
      "raw_url": "https://github.com/vllm-project/vllm/raw/98506b5bd6dac6db89c2c621543ce2a1a289b674/vllm%2Fv1%2Fhisparse%2Fruntime.py",
      "sha": "2fa8de39f750856f938af7fdf7940c64f6b564a9",
      "status": "modified"
    }
