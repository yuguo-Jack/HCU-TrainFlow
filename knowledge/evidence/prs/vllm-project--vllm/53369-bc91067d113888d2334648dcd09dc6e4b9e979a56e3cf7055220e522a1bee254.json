      "deletions": 1,
      "filename": "vllm/entrypoints/serve/engine/serving.py",
      "patch": "@@ -163,7 +163,11 @@ def _get_message_types(self, request: AnyRequest | AnyPoolingRequest) -> set[str\n             ):\n                 for content_dict in message[\"content\"]:\n                     if \"type\" in content_dict:\n-                        message_types.add(content_dict[\"type\"].split(\"_\")[0])\n+                        content_type = content_dict[\"type\"]\n+                        if content_type.startswith(\"input_\"):\n+                            message_types.add(content_type.removeprefix(\"input_\"))\n+                        else:\n+                            message_types.add(content_type.split(\"_\")[0])\n         return message_types\n \n     def _get_active_default_mm_loras(",
