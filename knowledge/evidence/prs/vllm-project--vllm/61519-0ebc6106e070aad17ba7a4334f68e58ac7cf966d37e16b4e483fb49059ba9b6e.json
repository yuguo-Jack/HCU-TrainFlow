      "deletions": 1,
      "filename": "vllm/transformers_utils/processors/pixtral.py",
      "patch": "@@ -1,5 +1,8 @@\n # SPDX-License-Identifier: Apache-2.0\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+from types import SimpleNamespace\n+from typing import cast\n+\n import torch\n from mistral_common.protocol.instruct.chunk import ImageChunk\n from mistral_common.tokens.tokenizers.multimodal import ImageEncoder\n@@ -41,7 +44,8 @@ def get_number_of_image_patches(\n         height: int,\n         width: int,\n     ) -> tuple[int, int, int]:\n-        image = Image.new(\"RGB\", (width, height))\n+        # The encoder's sizing routine only reads size, not pixel data.\n+        image = cast(Image.Image, SimpleNamespace(size=(width, height)))\n         ncols, nrows = self.mm_encoder._image_to_num_tokens(image)\n         return ncols * nrows, nrows, ncols\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/d47888ecfea272e30e5874c7777b77dd2e69f6de/vllm%2Ftransformers_utils%2Fprocessors%2Fpixtral.py",
