  "files": [
    {
      "additions": 5,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c614edcc63d32ee1f32758f7d052a99f8c1ca175/tests%2Fdistributed%2Ftest_pipeline_parallel.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fdistributed%2Ftest_pipeline_parallel.py?ref=c614edcc63d32ee1f32758f7d052a99f8c1ca175",
      "deletions": 0,
      "filename": "tests/distributed/test_pipeline_parallel.py",
      "patch": "@@ -16,6 +16,7 @@\n \n from vllm.config.model import _FLOAT16_NOT_SUPPORTED_MODELS, RunnerOption\n from vllm.logger import init_logger\n+from vllm.platforms import current_platform\n from vllm.transformers_utils.config import get_config\n \n from ..models.registry import HF_EXAMPLE_MODELS\n@@ -293,6 +294,10 @@ def _compare_tp(\n         )\n     if max_num_seqs:\n         common_args.extend([\"--max-num-seqs\", f\"{max_num_seqs}\"])\n+    if current_platform.is_rocm():\n+        # MI250 reports ~2.7 GiB in use per idle GPU, which leaves too little\n+        # headroom for the default 0.92 utilization once workers start.\n+        common_args.extend([\"--gpu-memory-utilization\", \"0.85\"])\n \n     pp_env = None\n     tp_env = None",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c614edcc63d32ee1f32758f7d052a99f8c1ca175/tests%2Fdistributed%2Ftest_pipeline_parallel.py",
      "sha": "16de96423a3c50261ef11bd5015912845c84f3b8",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/c614edcc63d32ee1f32758f7d052a99f8c1ca175/tests%2Fdistributed%2Ftest_pp_cudagraph.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fdistributed%2Ftest_pp_cudagraph.py?ref=c614edcc63d32ee1f32758f7d052a99f8c1ca175",
      "deletions": 0,
      "filename": "tests/distributed/test_pp_cudagraph.py",
      "patch": "@@ -44,6 +44,10 @@ def test_pp_cudagraph(\n         \"--distributed-executor-backend\",\n         \"mp\",\n     ]\n+    if current_platform.is_rocm():\n+        # MI250 reports ~2.7 GiB in use per idle GPU, which leaves too little\n+        # headroom for the default 0.92 utilization once workers start.\n+        cudagraph_args += [\"--gpu-memory-utilization\", \"0.85\"]\n     # On ROCm, defer to the platform attention selector instead of forcing a backend.\n     if ATTN_BACKEND is not None:\n         cudagraph_args.append(f\"--attention-backend={ATTN_BACKEND}\")",
      "raw_url": "https://github.com/vllm-project/vllm/raw/c614edcc63d32ee1f32758f7d052a99f8c1ca175/tests%2Fdistributed%2Ftest_pp_cudagraph.py",
      "sha": "8b0708519edbf1e1e185da3cf1bdbc14caf272e7",
      "status": "modified"
    }
  ],
