      "additions": 4,
      "blob_url": "https://github.com/vllm-project/vllm/blob/6acf0c21a7fdac47e7781c7cf626830540ea485f/vllm%2Fparser%2Fglm47_moe.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fparser%2Fglm47_moe.py?ref=6acf0c21a7fdac47e7781c7cf626830540ea485f",
      "deletions": 0,
      "filename": "vllm/parser/glm47_moe.py",
      "patch": "@@ -178,6 +178,10 @@ def glm47_moe_config(thinking: bool = True) -> ParserEngineConfig:\n                 ParserState.TOOL_NAME,\n                 (EventType.TOOL_CALL_START,),\n             ),\n+            (ParserState.TOOL_NAME, \"TOOL_START\"): Transition(\n+                ParserState.TOOL_NAME,\n+                (EventType.TOOL_CALL_END, EventType.TOOL_CALL_START),\n+            ),\n             (ParserState.TOOL_NAME, \"ARG_KEY_START\"): Transition(\n                 ParserState.TOOL_ARGS,\n                 (EventType.ARG_VALUE_CHUNK,),",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6acf0c21a7fdac47e7781c7cf626830540ea485f/vllm%2Fparser%2Fglm47_moe.py",
      "sha": "025fbae8aa45bf04a91c0ff306ed13aed61b3ae1",
      "status": "modified"
    }
