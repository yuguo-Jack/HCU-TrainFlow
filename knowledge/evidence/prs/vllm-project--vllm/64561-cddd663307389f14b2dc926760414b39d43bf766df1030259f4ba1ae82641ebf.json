      "deletions": 13,
      "filename": ".buildkite/test_areas/spec_decode.yaml",
      "patch": "@@ -617,32 +617,22 @@ steps:\n \n - label: \":nvidia: (H200 MIG 35GB) [Nightly] Spec Decode AL MTP + Other Acceptance\"\n   key: spec-decode-mtp-other-acceptance-nightly\n+  automatic_shard: true\n   timeout_in_minutes: 35\n   device: h200_35gb\n   optional: true\n-  parallelism: 3\n   source_file_dependencies:\n     - vllm/v1/spec_decode/\n     - vllm/v1/worker/gpu/spec_decode/\n     - tests/v1/e2e/spec_decode/conftest.py\n     - tests/v1/e2e/spec_decode/\n   commands:\n-    # Each Gemma4 parametrization is an indivisible ~23m floor. Keep them in\n-    # separate shards and put the remaining tests in shard 0, where new tests\n-    # land by default.\n-    - >-\n-      if [ \"$$BUILDKITE_PARALLEL_JOB\" = \"0\" ]; then\n-      pytest -v -s\n-      v1/e2e/spec_decode/acceptance_rates/mtp_other/\n-      --deselect \"tests/v1/e2e/spec_decode/acceptance_rates/mtp_other/test_mtp.py::test_gemma4_mtp_acceptance_lengths[False]\"\n-      --deselect \"tests/v1/e2e/spec_decode/acceptance_rates/mtp_other/test_mtp.py::test_gemma4_mtp_acceptance_lengths[True]\";\n-      fi\n-    - if [ \"$$BUILDKITE_PARALLEL_JOB\" = \"1\" ]; then pytest -v -s \"v1/e2e/spec_decode/acceptance_rates/mtp_other/test_mtp.py::test_gemma4_mtp_acceptance_lengths[False]\"; fi\n-    - if [ \"$$BUILDKITE_PARALLEL_JOB\" = \"2\" ]; then pytest -v -s \"v1/e2e/spec_decode/acceptance_rates/mtp_other/test_mtp.py::test_gemma4_mtp_acceptance_lengths[True]\"; fi\n+    - pytest -v -s v1/e2e/spec_decode/acceptance_rates/mtp_other/\n   mirror:\n     amd:\n       label: \":amd: (MI355 DPX) Spec Decode AL MTP + Other Acceptance Nightly\"\n       dind: false\n+      automatic_shard: true\n       device: mi355_dpx\n       timeout_in_minutes: 55\n       depends_on:",
      "raw_url": "https://github.com/vllm-project/vllm/raw/ab89f0b971017a422b1b19a8874b230c4709ecf4/.buildkite%2Ftest_areas%2Fspec_decode.yaml",
