      "blob_url": "https://github.com/vllm-project/vllm/blob/951da224dd83b28c59ca7b0c9174225c1de2f58a/tests%2Ftool_parsers%2Ftest_dots_tool_parser.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Ftool_parsers%2Ftest_dots_tool_parser.py?ref=951da224dd83b28c59ca7b0c9174225c1de2f58a",
      "deletions": 0,
      "filename": "tests/tool_parsers/test_dots_tool_parser.py",
      "patch": "@@ -275,3 +275,40 @@ def test_streaming_emits_complete_json_before_end_marker_without_duplication(\n         '{\"query\": \"chairs\"}'\n     )\n     assert messages[-1].tool_calls == calls\n+\n+\n+def test_non_stream_keeps_text_after_tool_call(parser: DotsToolParser) -> None:\n+    request = _request([_tool(\"get_weather\", {\"city\": {\"type\": \"string\"}})])\n+    model_output = (\n+        \"let me check the weather.\"\n+        \"<dots_function_call>\"\n+        '<invoke name=\"get_weather\"><parameter name=\"city\">Paris</parameter></invoke>'\n+        \"</dots_function_call>\"\n+        \"It is 30 degrees.\"\n+    )\n+    result = parser.extract_tool_calls(model_output, request)\n+    assert result.content == \"let me check the weather.It is 30 degrees.\"\n+    assert result.tool_calls[0].function.name == \"get_weather\"\n+    assert json.loads(result.tool_calls[0].function.arguments) == {\"city\": \"Paris\"}\n+\n+\n+def test_stream_keeps_text_after_tool_call(parser: DotsToolParser) -> None:\n+    request = _request([_tool(\"get_weather\", {\"city\": {\"type\": \"string\"}})])\n+    model_output = (\n+        \"let me check the weather.\"\n+        \"<dots_function_call>\"\n+        '<invoke name=\"get_weather\"><parameter name=\"city\">Paris</parameter></invoke>'\n+        \"</dots_function_call>\"\n+        \"It is 30 degrees.\"\n+    )\n+    messages = _stream(\n+        parser,\n+        [model_output[i : i + 7] for i in range(0, len(model_output), 7)],\n+        request,\n+    )\n+    content = \"\".join(m.content or \"\" for m in messages)\n+    calls = [c for m in messages for c in m.tool_calls]\n+    assert content == \"let me check the weather.It is 30 degrees.\"\n+    assert get_function_delta(calls[0]).name == \"get_weather\"\n+    streamed_args = \"\".join(get_function_delta(c).arguments or \"\" for c in calls)\n+    assert streamed_args == '{\"city\": \"Paris\"}'",
      "raw_url": "https://github.com/vllm-project/vllm/raw/951da224dd83b28c59ca7b0c9174225c1de2f58a/tests%2Ftool_parsers%2Ftest_dots_tool_parser.py",
      "sha": "9afe36e6e3b0fcbd6f148def06a306c7a712fbec",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/951da224dd83b28c59ca7b0c9174225c1de2f58a/vllm%2Ftool_parsers%2Fdots_tool_parser.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Ftool_parsers%2Fdots_tool_parser.py?ref=951da224dd83b28c59ca7b0c9174225c1de2f58a",
      "deletions": 1,
      "filename": "vllm/tool_parsers/dots_tool_parser.py",
      "patch": "@@ -247,7 +247,13 @@ def extract_tool_calls(\n             except (json.JSONDecodeError, TypeError, ValueError) as exc:\n                 logger.warning(\"Failed to parse Dots tool call: %s\", exc)\n \n-        normal_text = model_output[:marker_index].strip()\n+        tool_calls_end = model_output.rfind(self.tool_call_end_token)\n+        normal_text = model_output[:marker_index]\n+        if tool_calls_end != -1:\n+            normal_text += model_output[\n+                tool_calls_end + len(self.tool_call_end_token) :\n+            ]\n+        normal_text = normal_text.strip()\n         if not tool_calls:\n             return ExtractedToolCallInformation(\n                 tools_called=False,",
