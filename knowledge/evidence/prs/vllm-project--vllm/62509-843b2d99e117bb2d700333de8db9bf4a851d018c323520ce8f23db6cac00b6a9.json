      "deletions": 0,
      "filename": "vllm/envs.py",
      "patch": "@@ -152,6 +152,7 @@\n     VLLM_ROCM_USE_AITER_FP4BMM: bool = False\n     VLLM_ROCM_USE_AITER_UNIFIED_ATTENTION: bool = False\n     VLLM_ROCM_USE_AITER_FUSION_SHARED_EXPERTS: bool = False\n+    VLLM_MINIMAX_M3_FP8_ATTN_PROJ: bool = False\n     VLLM_ROCM_AITER_MEGA_MOE_FUSE_SHARED_EXPERTS: bool = False\n     VLLM_ROCM_USE_AITER_TRITON_GEMM: bool = True\n     VLLM_ROCM_USE_SKINNY_GEMM: bool = True\n@@ -1370,6 +1371,11 @@ def _resolve_rust_cli_path() -> str | None:\n         os.getenv(\"VLLM_ROCM_USE_AITER_FUSION_SHARED_EXPERTS\", \"False\").lower()\n         in (\"true\", \"1\")\n     ),\n+    # MiniMax-M3 (ROCm): quantize the bf16 attention q/k/v/o projections online\n+    # to FP8 (per-channel weights, dynamic per-token activations). Changes numerics.\n+    \"VLLM_MINIMAX_M3_FP8_ATTN_PROJ\": lambda: (\n+        os.getenv(\"VLLM_MINIMAX_M3_FP8_ATTN_PROJ\", \"False\").lower() in (\"true\", \"1\")\n+    ),\n     # Fuse DeepSeek-V4's shared expert into AITER MegaMoE (requantized to\n     # MXFP4). By default is disabled.\n     \"VLLM_ROCM_AITER_MEGA_MOE_FUSE_SHARED_EXPERTS\": lambda: (",
      "raw_url": "https://github.com/vllm-project/vllm/raw/70a2b0a8f81fe77dcd39c081c6812c9b42c982ab/vllm%2Fenvs.py",
      "sha": "99e1dd11536f0259c31ac31174b1afa87f502803",
      "status": "modified"
    },
    {
      "additions": 50,
      "blob_url": "https://github.com/vllm-project/vllm/blob/70a2b0a8f81fe77dcd39c081c6812c9b42c982ab/vllm%2Fmodels%2Fminimax_m3%2Famd%2Fmodel.py",
      "changes": 54,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fmodels%2Fminimax_m3%2Famd%2Fmodel.py?ref=70a2b0a8f81fe77dcd39c081c6812c9b42c982ab",
      "deletions": 4,
      "filename": "vllm/models/minimax_m3/amd/model.py",
      "patch": "@@ -138,6 +138,52 @@\n logger = init_logger(__name__)\n \n \n+class _Mm3AttnPtpcFp8Config(QuantizationConfig):\n+    \"\"\"Online PTPC FP8 for the attention projections (VLLM_MINIMAX_M3_FP8_ATTN_PROJ).\n+\n+    The checkpoint keeps q/k/v/o in bf16 (Quark excludes them); this quantizes\n+    them at load time to per-output-channel FP8 weights with dynamic per-token\n+    FP8 activations. The routed experts keep the checkpoint's MXFP4 config.\n+    \"\"\"\n+\n+    def get_name(self) -> str:\n+        return \"mm3_attn_ptpc_fp8\"\n+\n+    def get_supported_act_dtypes(self) -> list[torch.dtype]:\n+        return [torch.bfloat16, torch.half]\n+\n+    @classmethod\n+    def get_min_capability(cls) -> int:\n+        return 0\n+\n+    @staticmethod\n+    def get_config_filenames() -> list[str]:\n+        return []\n+\n+    @classmethod\n+    def from_config(cls, config: dict) -> \"_Mm3AttnPtpcFp8Config\":\n+        return cls()\n+\n+    def get_quant_method(self, layer: torch.nn.Module, prefix: str):\n+        from vllm.model_executor.layers.linear import LinearBase\n+        from vllm.model_executor.layers.quantization.online.fp8 import (\n+            Fp8PtpcOnlineLinearMethod,\n+        )\n+\n+        if isinstance(layer, LinearBase):\n+            return Fp8PtpcOnlineLinearMethod()\n+        return None\n+\n+\n+def _attn_proj_quant_config(\n+    quant_config: QuantizationConfig | None,\n+) -> QuantizationConfig | None:\n+    if envs.VLLM_MINIMAX_M3_FP8_ATTN_PROJ:\n+        logger.info_once(\"MiniMax-M3: online PTPC FP8 attention q/k/v/o projections\")\n+        return _Mm3AttnPtpcFp8Config()\n+    return quant_config\n+\n+\n def _sparse_attention_layer_ids(config: PreTrainedConfig) -> set[int]:\n     \"\"\"Layer ids whose attention runs the extra sparse \"index\" branch.\"\"\"\n     cfg = getattr(config, \"sparse_attention_config\", None)\n@@ -523,7 +569,7 @@ def __init__(\n             self.total_num_heads,\n             self.total_num_kv_heads,\n             bias=False,\n-            quant_config=quant_config,\n+            quant_config=_attn_proj_quant_config(quant_config),\n             prefix=f\"{prefix}.qkv_proj\",\n         )\n         # reduce_results=False: the attention all-reduce is fused with the\n@@ -534,7 +580,7 @@ def __init__(\n             self.hidden_size,\n             bias=False,\n             reduce_results=False,\n-            quant_config=quant_config,\n+            quant_config=_attn_proj_quant_config(quant_config),\n             prefix=f\"{prefix}.o_proj\",\n         )\n \n@@ -678,7 +724,7 @@ def __init__(\n             self.total_idx_heads,\n             self.idx_head_dim,\n             bias=False,\n-            quant_config=quant_config,\n+            quant_config=_attn_proj_quant_config(quant_config),\n             prefix=f\"{prefix}.qkv_proj\",\n         )\n         # reduce_results=False: the attention all-reduce is fused with the\n@@ -689,7 +735,7 @@ def __init__(\n             self.hidden_size,\n             bias=False,\n             reduce_results=False,\n-            quant_config=quant_config,\n+            quant_config=_attn_proj_quant_config(quant_config),\n             prefix=f\"{prefix}.o_proj\",\n         )\n ",
