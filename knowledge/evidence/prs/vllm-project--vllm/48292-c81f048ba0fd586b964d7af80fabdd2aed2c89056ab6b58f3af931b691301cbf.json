      "additions": 36,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8b80a8e41854eba76bd5de811cf42bdd45d057cc/tests%2Fv1%2Fengine%2Ftest_iteration_details_logging.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fv1%2Fengine%2Ftest_iteration_details_logging.py?ref=8b80a8e41854eba76bd5de811cf42bdd45d057cc",
      "deletions": 0,
      "filename": "tests/v1/engine/test_iteration_details_logging.py",
      "patch": "@@ -0,0 +1,36 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+import logging\n+from types import SimpleNamespace\n+from unittest.mock import MagicMock\n+\n+import vllm.v1.engine.core as core_module\n+from vllm.v1.engine.core import EngineCore\n+from vllm.v1.utils import IterationDetails\n+\n+\n+def test_iteration_details_logs_result_wait_time(caplog, monkeypatch):\n+    engine = EngineCore.__new__(EngineCore)\n+    engine.vllm_config = SimpleNamespace(\n+        observability_config=SimpleNamespace(enable_logging_iteration_details=True)\n+    )\n+    engine._iteration_index = 0\n+\n+    scheduler_output = MagicMock()\n+    scheduler_output.total_num_scheduled_tokens = 1\n+\n+    monkeypatch.setattr(\n+        core_module,\n+        \"compute_iteration_details\",\n+        lambda _: IterationDetails(1, 2, 3, 4),\n+    )\n+\n+    caplog.set_level(logging.INFO, logger=core_module.__name__)\n+\n+    with engine.log_iteration_details(scheduler_output) as timing:\n+        assert timing is not None\n+        timing[\"result_wait_time\"] = 0.01234\n+\n+    assert \"iteration elapsed time:\" in caplog.text\n+    assert \"result wait time: 12.34 ms\" in caplog.text",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8b80a8e41854eba76bd5de811cf42bdd45d057cc/tests%2Fv1%2Fengine%2Ftest_iteration_details_logging.py",
      "sha": "dff1a2894091564cf6894edc11d3176b228f1fff",
      "status": "added"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/vllm-project/vllm/blob/8b80a8e41854eba76bd5de811cf42bdd45d057cc/vllm%2Fv1%2Fengine%2Fcore.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fengine%2Fcore.py?ref=8b80a8e41854eba76bd5de811cf42bdd45d057cc",
      "deletions": 3,
      "filename": "vllm/v1/engine/core.py",
      "patch": "@@ -448,7 +448,14 @@ def log_iteration_details(self, scheduler_output: SchedulerOutput | None):\n             iteration_details = compute_iteration_details(scheduler_output)\n             is_dummy = False\n         before = time.monotonic()\n-        yield\n+        timing: dict[str, float] = {}\n+        yield timing\n+        result_wait_time = timing.get(\"result_wait_time\")\n+        result_wait_detail = (\n+            f\", result wait time: {result_wait_time * 1000:.2f} ms\"\n+            if result_wait_time is not None\n+            else \"\"\n+        )\n         logger.info(\n             \"\".join(\n                 [\n@@ -465,6 +472,7 @@ def log_iteration_details(self, scheduler_output: SchedulerOutput | None):\n                     \" generation tokens, iteration elapsed time: \",\n                     format((time.monotonic() - before) * 1000, \".2f\"),\n                     \" ms\",\n+                    result_wait_detail,\n                     \" (dummy)\" if is_dummy else \"\",\n                 ]\n             )\n@@ -492,9 +500,12 @@ def step(self) -> tuple[dict[int, EngineCoreOutputs], bool]:\n         grammar_output = self.scheduler.get_grammar_bitmask(scheduler_output)\n         with (\n             self.log_error_detail(scheduler_output),\n-            self.log_iteration_details(scheduler_output),\n+            self.log_iteration_details(scheduler_output) as timing,\n         ):\n+            result_wait_start = time.monotonic() if timing is not None else 0.0\n             model_output = future.result()\n+            if timing is not None:\n+                timing[\"result_wait_time\"] = time.monotonic() - result_wait_start\n             if model_output is None:\n                 model_output = self.model_executor.sample_tokens(grammar_output)\n \n@@ -590,9 +601,12 @@ def step_with_batch_queue(\n         future, scheduler_output, exec_model_fut = batch_queue.pop()\n         with (\n             self.log_error_detail(scheduler_output),\n-            self.log_iteration_details(scheduler_output),\n+            self.log_iteration_details(scheduler_output) as timing,\n         ):\n+            result_wait_start = time.monotonic() if timing is not None else 0.0\n             model_output = future.result()\n+            if timing is not None:\n+                timing[\"result_wait_time\"] = time.monotonic() - result_wait_start\n             if model_output is None:\n                 # None from sample_tokens() implies that the original execute_model()\n                 # call failed - raise that exception.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/8b80a8e41854eba76bd5de811cf42bdd45d057cc/vllm%2Fv1%2Fengine%2Fcore.py",
      "sha": "6795c2c14ef5f07a8aed2362a151e506648b5360",
      "status": "modified"
    }
