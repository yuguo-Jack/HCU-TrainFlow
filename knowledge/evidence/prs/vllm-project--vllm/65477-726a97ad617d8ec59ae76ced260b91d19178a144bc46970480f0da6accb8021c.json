      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fenvs.py?ref=dfefc794857dbf50f512248968834f2c1ba4c6d4",
      "deletions": 2,
      "filename": "vllm/envs.py",
      "patch": "@@ -652,12 +652,13 @@ def _resolve_rust_cli_path() -> str | None:\n     ),\n     # Controls PyTorch float32 matmul precision mode within vLLM workers.\n     # Valid options mirror torch.set_float32_matmul_precision\n-    \"VLLM_FLOAT32_MATMUL_PRECISION\": env_with_choices(\n+    # Lowercased because torch ignores any other casing.\n+    \"VLLM_FLOAT32_MATMUL_PRECISION\": lambda: env_with_choices(\n         \"VLLM_FLOAT32_MATMUL_PRECISION\",\n         \"highest\",\n         [\"highest\", \"high\", \"medium\"],\n         case_sensitive=False,\n-    ),\n+    )().lower(),\n     # Enable batch-invariant mode: deterministic results regardless of\n     # batch composition. Requires NVIDIA GPU with compute capability >= 9.0.\n     \"VLLM_BATCH_INVARIANT\": lambda: bool(int(os.getenv(\"VLLM_BATCH_INVARIANT\", \"0\"))),",
