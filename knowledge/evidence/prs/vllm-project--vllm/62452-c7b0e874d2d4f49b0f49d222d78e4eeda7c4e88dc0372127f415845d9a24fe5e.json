      "additions": 22,
      "blob_url": "https://github.com/vllm-project/vllm/blob/54cb316e7652ce9391ea31ab5549026facb05a64/tests%2Fcompile%2Ftest_graph_partition.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/tests%2Fcompile%2Ftest_graph_partition.py?ref=54cb316e7652ce9391ea31ab5549026facb05a64",
      "deletions": 0,
      "filename": "tests/compile/test_graph_partition.py",
      "patch": "@@ -689,6 +689,28 @@ def test_decompose_size_with_getitem_user():\n             )\n \n \n+@pytest.mark.parametrize(\"use_keyword\", [False, True])\n+def test_decompose_size_preserves_reshape_shape(use_keyword):\n+    \"\"\"Shape tuples must survive Dynamo graph splitting in args and kwargs.\"\"\"\n+\n+    def model(x):\n+        shape = x.size()\n+        x = torch.ops.aten.sigmoid.default(x)\n+        if use_keyword:\n+            return torch.reshape(x, shape=shape)\n+        return torch.reshape(x, shape)\n+\n+    def backend(graph, example_inputs):\n+        split_gm, split_items = split_graph(graph, [\"aten::sigmoid\"])\n+        assert len(split_items) == 3\n+        return split_gm\n+\n+    compiled = torch.compile(model, backend=backend, dynamic=True, fullgraph=True)\n+    for batch_size in (4, 8):\n+        x = torch.randn(batch_size, 3)\n+        torch.testing.assert_close(compiled(x), model(x))\n+\n+\n def test_decompose_size_leaves_scalar_size_with_dim():\n     \"\"\"Regression test: _decompose_size_nodes must leave x.size(dim) alone.\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/54cb316e7652ce9391ea31ab5549026facb05a64/tests%2Fcompile%2Ftest_graph_partition.py",
      "sha": "ae7726fa380a34af5b3153728d3334647394e5b9",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/vllm-project/vllm/blob/54cb316e7652ce9391ea31ab5549026facb05a64/vllm%2Fcompilation%2Fbackends.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fcompilation%2Fbackends.py?ref=54cb316e7652ce9391ea31ab5549026facb05a64",
      "deletions": 10,
      "filename": "vllm/compilation/backends.py",
      "patch": "@@ -544,7 +544,7 @@ def _decompose_size_nodes(graph: fx.GraphModule) -> None:\n                         f\"'{node.name}'\"\n                     )\n \n-        # Replace size node in each user's args.\n+        # Replace size nodes throughout positional and keyword arguments.\n         for user in list(node.users):\n             if (\n                 user.op == \"call_function\"\n@@ -561,15 +561,12 @@ def _decompose_size_nodes(graph: fx.GraphModule) -> None:\n                 user.replace_all_uses_with(dims[idx])\n                 graph.graph.erase_node(user)\n             else:\n-                # User consumes the full size tuple (e.g. view(clone, size))\n-                # → view(clone, d0, d1, ...)\n-                new_args = []\n-                for arg in user.args:\n-                    if arg is node:\n-                        new_args.extend(dims)\n-                    else:\n-                        new_args.append(arg)\n-                user.args = tuple(new_args)\n+                user.args, user.kwargs = fx.map_arg(\n+                    (user.args, user.kwargs),\n+                    lambda arg, node=node, dims=tuple(dims): dims\n+                    if arg is node\n+                    else arg,\n+                )\n         graph.graph.erase_node(node)\n \n ",
