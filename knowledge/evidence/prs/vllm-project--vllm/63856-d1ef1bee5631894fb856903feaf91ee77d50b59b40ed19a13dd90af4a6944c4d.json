      "changes": 5,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_common.py?ref=2b7605a5ac9337b295080396276383f8b27c9e23",
      "deletions": 0,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/moriio/moriio_common.py",
      "patch": "@@ -431,6 +431,11 @@ class MoRIIOConstants:\n \n     VLLM_MORI_READ_ABORT_REQUEST_TIMEOUT = 3600\n \n+    # Handshake recv timeout (ms) and retry parameters (Gap 3).\n+    HANDSHAKE_RECV_TIMEOUT_MS = 5000\n+    HANDSHAKE_MAX_RETRIES = 5\n+    HANDSHAKE_BACKOFF_BASE = 1.0  # seconds; doubled each retry\n+\n     # Timeout (seconds) for waiting_for_transfer_complete before raising TransferError.\n     # Overridable via kv_connector_extra_config[\"transfer_timeout\"].\n     DEFAULT_TRANSFER_TIMEOUT = 30.0",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2b7605a5ac9337b295080396276383f8b27c9e23/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_common.py",
      "sha": "1741cfa98d854966680c0b832c98d04a0eca927d",
      "status": "modified"
    },
    {
      "additions": 96,
      "blob_url": "https://github.com/vllm-project/vllm/blob/2b7605a5ac9337b295080396276383f8b27c9e23/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_connector.py",
      "changes": 150,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_connector.py?ref=2b7605a5ac9337b295080396276383f8b27c9e23",
      "deletions": 54,
      "filename": "vllm/distributed/kv_transfer/kv_connector/v1/moriio/moriio_connector.py",
      "patch": "@@ -2217,66 +2217,108 @@ def _moriio_handshake(\n         path = make_zmq_path(\"tcp\", host, port + port_offset)\n         logger.debug(\"handshake Querying metadata on path: %s\", path)\n \n-        # Send query for the request.\n-        with zmq_ctx(zmq.DEALER, path) as sock:\n-            logger.debug(\"prepare send msg INSTAZNCE: %s\", path)\n-            sock.send(MoRIIOConstants.GET_META_MSG)\n-            received_frame = sock.recv_multipart()\n-            if len(received_frame) != 2 or received_frame[0] != b\"\":\n-                raise HandshakeError(f\"Unexpected frame! {received_frame = }\")\n-\n-            metadata_bytes = received_frame[1]\n-            decoder = msgspec.msgpack.Decoder(MoRIIOAgentMetadata)\n-            metadata = decoder.decode(metadata_bytes)\n-            got_metadata_time = time.perf_counter()\n-            logger.info(\n-                \"MoRIIO handshake: get metadata took: %s\",\n-                got_metadata_time - start_time,\n-            )\n+        # Send query with receive timeout and retry with backoff (Gap 3).\n+        max_retries = MoRIIOConstants.HANDSHAKE_MAX_RETRIES\n+        recv_timeout_ms = MoRIIOConstants.HANDSHAKE_RECV_TIMEOUT_MS\n+        backoff = MoRIIOConstants.HANDSHAKE_BACKOFF_BASE\n+        last_err: Exception | None = None\n+\n+        for attempt in range(max_retries + 1):\n+            if attempt > 0:\n+                sleep_s = backoff * (2 ** (attempt - 1))\n+                logger.warning(\n+                    \"Handshake attempt %d/%d to %s (backoff %.1fs)\",\n+                    attempt + 1,\n+                    max_retries + 1,\n+                    path,\n+                    sleep_s,\n+                )\n+                time.sleep(sleep_s)\n \n-            self.moriio_wrapper.remote_engine_ip = host\n-            remote_agent_name = self.moriio_wrapper.register_remote_engine(\n-                metadata.agent_metadata\n-            )\n+            try:\n+                with zmq_ctx(zmq.DEALER, path) as sock:\n+                    sock.setsockopt(zmq.RCVTIMEO, recv_timeout_ms)\n+                    sock.setsockopt(zmq.SNDTIMEO, recv_timeout_ms)\n+                    sock.send(MoRIIOConstants.GET_META_MSG)\n+                    received_frame = sock.recv_multipart()\n+                    if len(received_frame) != 2 or received_frame[0] != b\"\":\n+                        raise HandshakeError(\n+                            f\"Unexpected frame! {received_frame = }\"\n+                        )\n \n-            logger.debug(\n-                \"MoRIIO handshake: registered\"\n-                \"remote agent %s for engine ID %s, path = %s\",\n-                remote_agent_name,\n-                expected_engine_id,\n-                path,\n-            )\n+                    metadata_bytes = received_frame[1]\n+                    decoder = msgspec.msgpack.Decoder(MoRIIOAgentMetadata)\n+                    metadata = decoder.decode(metadata_bytes)\n+                    got_metadata_time = time.perf_counter()\n+                    logger.info(\n+                        \"MoRIIO handshake: get metadata took: %s\",\n+                        got_metadata_time - start_time,\n+                    )\n \n-            if len(self.local_kv_cache_metadata) > 0:\n-                logger.warning(\n-                    \"len(self.local_kv_cache_metadata) = %s,\"\n-                    \"maybe you didnt clear this buffer correctly\",\n-                    len(self.local_kv_cache_metadata),\n-                )\n-                self.local_kv_cache_metadata = []\n-            if len(self.remote_kv_cache_metadata) > 0:\n+                    self.moriio_wrapper.remote_engine_ip = host\n+                    remote_agent_name = (\n+                        self.moriio_wrapper.register_remote_engine(\n+                            metadata.agent_metadata\n+                        )\n+                    )\n+\n+                    logger.debug(\n+                        \"MoRIIO handshake: registered\"\n+                        \"remote agent %s for engine ID %s, path = %s\",\n+                        remote_agent_name,\n+                        expected_engine_id,\n+                        path,\n+                    )\n+\n+                    if len(self.local_kv_cache_metadata) > 0:\n+                        logger.warning(\n+                            \"len(self.local_kv_cache_metadata) = %s,\"\n+                            \"maybe you didnt clear this buffer correctly\",\n+                            len(self.local_kv_cache_metadata),\n+                        )\n+                        self.local_kv_cache_metadata = []\n+                    if len(self.remote_kv_cache_metadata) > 0:\n+                        logger.warning(\n+                            \"len(self.remote_kv_cache_metadata) = %s,\"\n+                            \"maybe you didnt clear this buffer correctly\",\n+                            len(self.remote_kv_cache_metadata),\n+                        )\n+                        self.remote_kv_cache_metadata = []\n+\n+                    received_frame = sock.recv_multipart()\n+                    if len(received_frame) != 2 or received_frame[0] != b\"\":\n+                        raise HandshakeError(\n+                            f\"unexpected frame! {received_frame = }\"\n+                        )\n+                    buf = received_frame[1]\n+                    self.layer_name_to_remote_kv_cache_metadata[\n+                        expected_engine_id\n+                    ] = msgpack.loads(buf)\n+                    self.remote_moriio_metadata[expected_engine_id] = metadata\n+                    setup_agent_time = time.perf_counter()\n+                    logger.debug(\n+                        \"MoRIIO handshake: add agent took: %s\",\n+                        setup_agent_time - got_metadata_time,\n+                    )\n+\n+                return {remote_agent_name}\n+\n+            except zmq.Again as e:\n+                last_err = e\n                 logger.warning(\n-                    \"len(self.remote_kv_cache_metadata) = %s,\"\n-                    \"maybe you didnt clear this buffer correctly\",\n-                    len(self.remote_kv_cache_metadata),\n+                    \"Handshake recv timed out after %dms on attempt %d/%d \"\n+                    \"to %s\",\n+                    recv_timeout_ms,\n+                    attempt + 1,\n+                    max_retries + 1,\n+                    path,\n                 )\n-                self.remote_kv_cache_metadata = []\n-\n-            received_frame = sock.recv_multipart()\n-            if len(received_frame) != 2 or received_frame[0] != b\"\":\n-                raise HandshakeError(f\"unexpected frame! {received_frame = }\")\n-            buf = received_frame[1]\n-            self.layer_name_to_remote_kv_cache_metadata[expected_engine_id] = (\n-                msgpack.loads(buf)\n-            )\n-            self.remote_moriio_metadata[expected_engine_id] = metadata\n-            setup_agent_time = time.perf_counter()\n-            logger.debug(\n-                \"MoRIIO handshake: add agent took: %s\",\n-                setup_agent_time - got_metadata_time,\n-            )\n+                continue\n \n-        return {remote_agent_name}\n+        raise HandshakeError(\n+            f\"Handshake to {path} failed after {max_retries + 1} attempts \"\n+            f\"(recv timeout {recv_timeout_ms}ms): {last_err}\"\n+        )\n \n     def _remote_tp_rank(self, remote_tp_size: int) -> int:\n         # 0/unknown remote TP == homogeneous (avoids collapsing all ranks to 0).",
      "raw_url": "https://github.com/vllm-project/vllm/raw/2b7605a5ac9337b295080396276383f8b27c9e23/vllm%2Fdistributed%2Fkv_transfer%2Fkv_connector%2Fv1%2Fmoriio%2Fmoriio_connector.py",
      "sha": "161b157d076766418652af32a55eb880c3f3c73e",
      "status": "modified"
