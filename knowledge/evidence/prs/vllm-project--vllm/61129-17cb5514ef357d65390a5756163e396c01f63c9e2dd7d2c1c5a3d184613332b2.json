      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Fflash_attn.py?ref=5ab7ecb547b5ee8e940ca35d00faedb887d4da37",
      "deletions": 19,
      "filename": "vllm/v1/attention/backends/flash_attn.py",
      "patch": "@@ -1228,6 +1228,37 @@ def __init__(\n                 vllm_config.scheduler_config.max_num_batched_tokens\n             )\n \n+        # Cache for transpose+split+canonicalize KV cache views. The KV cache\n+        # tensor is bound once via bind_kv_cache() and never reallocated during\n+        # serving, so its data_ptr() is stable. Key on data_ptr() to detect the\n+        # initial call (or a rebind) and reuse the pre-computed views on\n+        # subsequent forward / do_kv_cache_update calls.\n+        # Stores: (data_ptr, key_cache_view, value_cache_view)\n+        self._kv_cache_view_cache: tuple[int, torch.Tensor, torch.Tensor] | None = None\n+\n+    def _get_kv_cache_views(\n+        self, kv_cache: torch.Tensor\n+    ) -> tuple[torch.Tensor, torch.Tensor]:\n+        \"\"\"Return transposed+split+canonicalized key/value cache views.\n+\n+        kv_cache has shape (num_blocks, num_kv_heads, block_size, 2*head_size).\n+        Compute transpose(1, 2).split(head_size, dim=-1) and apply\n+        canonicalize_singleton_dim_strides once, then cache the result keyed on\n+        data_ptr(). Reuse across forward() and do_kv_cache_update() calls.\n+        \"\"\"\n+        cache = self._kv_cache_view_cache\n+        ptr = kv_cache.data_ptr()\n+        if cache is not None and cache[0] == ptr:\n+            return cache[1], cache[2]\n+        # (B, H, N, 2*D) -> ((B, N, H, D), (B, N, H, D))\n+        key_cache, value_cache = kv_cache.transpose(1, 2).split(self.head_size, dim=-1)\n+        # Fix degenerate strides on size-1 dims (e.g. num_kv_heads=1 with TP).\n+        # FA3/4 on H100+ uses TMA, which requires >=16-byte stride alignment.\n+        key_cache = canonicalize_singleton_dim_strides(key_cache)\n+        value_cache = canonicalize_singleton_dim_strides(value_cache)\n+        self._kv_cache_view_cache = (ptr, key_cache, value_cache)\n+        return key_cache, value_cache\n+\n     def forward(\n         self,\n         layer: torch.nn.Module,\n@@ -1303,24 +1334,8 @@ def forward(\n             )\n \n         # (B, H, N, 2*D) -> ((B, N, H, D), (B, N, H, D))\n-        key_cache, value_cache = kv_cache.transpose(1, 2).split(self.head_size, dim=-1)\n-        # Fix degenerate strides on size-1 dims (e.g. num_kv_heads=1 with TP).\n-        # FA3/4 on H100+ uses TMA, which requires ≥16-byte stride alignment.\n-        # See vllm.utils.torch_utils.canonicalize_singleton_dim_strides.\n-        fixed_k = canonicalize_singleton_dim_strides(key_cache)\n-        fixed_v = canonicalize_singleton_dim_strides(value_cache)\n-        if fixed_k is not key_cache or fixed_v is not value_cache:\n-            logger.debug(\n-                \"Canonicalized degenerate KV cache strides (FlashAttention): \"\n-                \"shape=%s, key strides before=%s after=%s, \"\n-                \"value strides before=%s after=%s\",\n-                key_cache.shape,\n-                key_cache.stride(),\n-                fixed_k.stride(),\n-                value_cache.stride(),\n-                fixed_v.stride(),\n-            )\n-        key_cache, value_cache = fixed_k, fixed_v\n+        # Views are pre-canonicalized in _get_kv_cache_views for TMA.\n+        key_cache, value_cache = self._get_kv_cache_views(kv_cache)\n \n         if is_quantized_kv_cache(self.kv_cache_dtype):\n             # queries are quantized in the attention layer\n@@ -1524,7 +1539,7 @@ def do_kv_cache_update(\n         # Scatter write into the KV cache using slot_mapping indices.\n         # No TMA kernel is invoked here, so stride canonicalization is not needed.\n         # (B, H, N, 2*D) -> ((B, N, H, D), (B, N, H, D))\n-        key_cache, value_cache = kv_cache.transpose(1, 2).split(self.head_size, dim=-1)\n+        key_cache, value_cache = self._get_kv_cache_views(kv_cache)\n \n         # Reshape the input keys and values and store them in the cache.\n         # Skip this if sharing KV cache with an earlier attention layer.",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5ab7ecb547b5ee8e940ca35d00faedb887d4da37/vllm%2Fv1%2Fattention%2Fbackends%2Fflash_attn.py",
      "sha": "3657ff7559ec705ed28e8890781607ed81eea0ed",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/vllm-project/vllm/blob/5ab7ecb547b5ee8e940ca35d00faedb887d4da37/vllm%2Fv1%2Fattention%2Fbackends%2Fflash_attn_diffkv.py",
      "changes": 28,
      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fattention%2Fbackends%2Fflash_attn_diffkv.py?ref=5ab7ecb547b5ee8e940ca35d00faedb887d4da37",
      "deletions": 25,
      "filename": "vllm/v1/attention/backends/flash_attn_diffkv.py",
      "patch": "@@ -4,12 +4,8 @@\n \n import torch\n \n-from vllm.logger import init_logger\n from vllm.platforms import current_platform\n-from vllm.utils.torch_utils import (\n-    canonicalize_singleton_dim_strides,\n-    is_quantized_kv_cache,\n-)\n+from vllm.utils.torch_utils import is_quantized_kv_cache\n from vllm.v1.attention.backend import AttentionType\n from vllm.v1.attention.backends.fa_utils import (\n     get_flash_attn_version,\n@@ -29,8 +25,6 @@\n     cascade_attention,\n )\n \n-logger = init_logger(__name__)\n-\n \n class FlashAttentionDiffKVBackend(FlashAttentionBackend):\n     # Default to 128 for this backend\n@@ -191,24 +185,8 @@ def forward(\n             )\n \n         # (B, H, N, 2*hs) -> ((B, N, H, hs), (B, N, H, hs))\n-        key_cache, value_cache = kv_cache.transpose(1, 2).split(self.head_size, dim=-1)\n-        # Fix degenerate strides on size-1 dims (e.g. num_kv_heads=1 with TP).\n-        # FA3/4 on H100+ uses TMA, which requires ≥16-byte stride alignment.\n-        # See vllm.utils.torch_utils.canonicalize_singleton_dim_strides.\n-        fixed_k = canonicalize_singleton_dim_strides(key_cache)\n-        fixed_v = canonicalize_singleton_dim_strides(value_cache)\n-        if fixed_k is not key_cache or fixed_v is not value_cache:\n-            logger.debug(\n-                \"Canonicalized degenerate KV cache strides (FlashAttentionDiffKV): \"\n-                \"shape=%s, key strides before=%s after=%s, \"\n-                \"value strides before=%s after=%s\",\n-                key_cache.shape,\n-                key_cache.stride(),\n-                fixed_k.stride(),\n-                value_cache.stride(),\n-                fixed_v.stride(),\n-            )\n-        key_cache, value_cache = fixed_k, fixed_v\n+        # Views are pre-canonicalized in _get_kv_cache_views for TMA.\n+        key_cache, value_cache = self._get_kv_cache_views(kv_cache)\n \n         if is_quantized_kv_cache(self.kv_cache_dtype):\n             # queries are quantized in the attention layer",
      "raw_url": "https://github.com/vllm-project/vllm/raw/5ab7ecb547b5ee8e940ca35d00faedb887d4da37/vllm%2Fv1%2Fattention%2Fbackends%2Fflash_attn_diffkv.py",
