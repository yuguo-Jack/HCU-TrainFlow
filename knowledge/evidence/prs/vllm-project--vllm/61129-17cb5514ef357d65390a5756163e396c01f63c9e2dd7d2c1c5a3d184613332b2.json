      "contents_url": "https://api.github.com/repos/vllm-project/vllm/contents/vllm%2Fv1%2Fworker%2Fgpu_model_runner.py?ref=5ab7ecb547b5ee8e940ca35d00faedb887d4da37",
      "deletions": 0,
      "filename": "vllm/v1/worker/gpu_model_runner.py",
      "patch": "@@ -6532,6 +6532,8 @@ def _cleanup_profiling_kv_cache(self) -> None:\n                     layer.impl._k_scale_cache = None\n                 if hasattr(layer.impl, \"_v_scale_cache\"):\n                     layer.impl._v_scale_cache = None\n+                if hasattr(layer.impl, \"_kv_cache_view_cache\"):\n+                    layer.impl._kv_cache_view_cache = None\n \n         gc.collect()\n         torch.accelerator.empty_cache()",
