      "deletions": 1,
      "filename": "docker/entrypoints/test_vllm_nonroot_entrypoint.sh",
      "patch": "@@ -20,7 +20,7 @@ if [ ! -x \"$WRAPPER\" ]; then\n     exit 1\n fi\n \n-WORKDIR=\"$(mktemp -d)\"\n+WORKDIR=\"$(cd \"$(mktemp -d)\" && pwd -P)\"\n trap 'rm -rf \"$WORKDIR\"' EXIT\n \n # Stub `vllm` on PATH. It dumps env + argv + cwd to stdout so we can assert.\n@@ -60,6 +60,8 @@ expect_default_home() {\n         expected_home=\"/tmp/vllm-home.XXXXXX\"\n         grep -Eq '^HOME=/tmp/vllm-home\\.[^/]+$' \"$_out\" \\\n             || fail \"$_out\" \"$_case: HOME not set to $expected_home\"\n+        created_home=\"$(sed -n 's/^HOME=//p' \"$_out\")\"\n+        rm -rf \"$created_home\"\n     fi\n }\n ",
      "raw_url": "https://github.com/vllm-project/vllm/raw/6d303cac9c80717a7d0caa6835fc11c4d456e9a0/docker%2Fentrypoints%2Ftest_vllm_nonroot_entrypoint.sh",
