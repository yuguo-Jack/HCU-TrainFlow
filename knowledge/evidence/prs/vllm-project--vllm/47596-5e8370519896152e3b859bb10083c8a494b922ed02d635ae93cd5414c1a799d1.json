      "deletions": 0,
      "filename": "vllm/v1/worker/gpu/spec_decode/autoregressive/speculator.py",
      "patch": "@@ -149,7 +149,19 @@ def capture(self) -> None:\n         # Reset indices to zeros to prevent stale values from prior\n         # dummy runs to cause out-of-bounds indexing during capture.\n         self.last_token_indices.zero_()\n+        self.current_draft_step.zero_()\n+        self.hidden_states.zero_()\n+        if (\n+            getattr(self, \"supports_mm_inputs\", False)\n+            and self.inputs_embeds is not None\n+        ):\n+            self.inputs_embeds.zero_()\n         self.idx_mapping.zero_()\n+        self.temperature.zero_()\n+        self.seeds.zero_()\n+        self.draft_tokens.zero_()\n+        if self.draft_logits is not None:\n+            self.draft_logits.zero_()\n \n         # Capture the prefill routine (model forward + compute_logits +\n         # sample).",
      "raw_url": "https://github.com/vllm-project/vllm/raw/9928029d0d07c79014530c13d0272a77b140a207/vllm%2Fv1%2Fworker%2Fgpu%2Fspec_decode%2Fautoregressive%2Fspeculator.py",
