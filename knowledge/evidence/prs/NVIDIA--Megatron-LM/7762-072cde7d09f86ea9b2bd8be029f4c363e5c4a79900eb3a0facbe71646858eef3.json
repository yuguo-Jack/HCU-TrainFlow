      "additions": 16,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/bda9c5d3935943b56ced4e0242fb3792744b445c/megatron%2Fcore%2Futils.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Futils.py?ref=bda9c5d3935943b56ced4e0242fb3792744b445c",
      "deletions": 0,
      "filename": "megatron/core/utils.py",
      "patch": "@@ -727,6 +727,22 @@ def get_model_config(model):\n     return get_attr_wrapped_model(model, \"config\", allow_none=False)\n \n \n+def get_cpu_resident_parameter_ids(module: torch.nn.Module) -> set[int]:\n+    \"\"\"Return parameters owned by modules that intentionally keep weights on CPU.\n+\n+    Modules opt in through their existing ``cpu_lookup`` behavior.  Keeping this\n+    policy at the module boundary avoids attaching storage-policy flags to\n+    individual parameters and makes generic device-management code consistent.\n+    \"\"\"\n+    return {\n+        id(parameter)\n+        for submodule in module.modules()\n+        if getattr(submodule, \"cpu_lookup\", False)\n+        for parameter in submodule.parameters(recurse=False)\n+        if parameter.device.type == \"cpu\"\n+    }\n+\n+\n class GlobalMemoryBuffer:\n     \"\"\"Global buffer to avoid dynamic memory allocations.\n     Caller should ensure that buffers of the same name",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/bda9c5d3935943b56ced4e0242fb3792744b445c/megatron%2Fcore%2Futils.py",
      "sha": "13e2a4b30e805f7a16d0c05871dcd743212b6e32",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/bda9c5d3935943b56ced4e0242fb3792744b445c/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_deepseek_v41_kernels.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_deepseek_v41_kernels.py?ref=bda9c5d3935943b56ced4e0242fb3792744b445c",
      "deletions": 0,
      "filename": "tests/unit_tests/determinism/kernels/test_deepseek_v41_kernels.py",
      "patch": "@@ -118,3 +118,22 @@ def test_engram_duplicate_rows_replay(groups):\n     ids = torch.tensor([[[1, 3], [1, 3], [5, 2], [1, 3]]], device=\"cuda\")\n     with deterministic_algorithms(True):\n         assert_module_replays_bit_exact(module, (ids,))\n+\n+\n+def test_engram_cpu_lookup_replay(groups):\n+    \"\"\"Pinned CPU Engram rows replay deterministically after the GPU index transfer.\"\"\"\n+    seeded()\n+    config = tiny_config()\n+    config.engram_cpu_lookup = True\n+    module = EPShardedMultiTableEmbedding(\n+        config,\n+        (11, 13),\n+        8,\n+        config.init_method,\n+        ep_group=groups.ep,\n+        tp_group=groups.tp,\n+        expt_dp_group=groups.expt_dp,\n+    )\n+    ids = torch.tensor([[[1, 3], [1, 3], [5, 2], [1, 3]]], device=\"cuda\")\n+    with deterministic_algorithms(True):\n+        assert_module_replays_bit_exact(module, (ids,), backward=False, what=\"Engram CPU lookup\")",
