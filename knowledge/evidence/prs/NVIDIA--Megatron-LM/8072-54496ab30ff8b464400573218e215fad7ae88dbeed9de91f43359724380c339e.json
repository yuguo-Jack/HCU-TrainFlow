      "filename": "tests/test_utils/python_scripts/download_coverage_results.py",
      "patch": "@@ -27,11 +27,12 @@ def main(pipeline_id: int):\n \n     project = gl.projects.get(PROJECT_ID)\n     pipeline = project.pipelines.get(pipeline_id)\n-    print(pipeline.bridges.list())\n+    bridges = pipeline.bridges.list(get_all=True)\n+    print(bridges)\n \n     pipeline_bridges = [\n         pipeline_bridge\n-        for pipeline_bridge in pipeline.bridges.list()\n+        for pipeline_bridge in bridges\n         if pipeline_bridge.name.startswith(\"test:unit_tests\")\n         and pipeline_bridge.downstream_pipeline is not None\n     ]",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5dfa28998ba5910c468fa9bb0af62b023ea9188a/tests%2Ftest_utils%2Fpython_scripts%2Fdownload_coverage_results.py",
      "sha": "e3d9288663996200e7646fe87e1e793394bc801d",
      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/5dfa28998ba5910c468fa9bb0af62b023ea9188a/tests%2Ftest_utils%2Fpython_scripts%2Ftest_download_coverage_results.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ftest_utils%2Fpython_scripts%2Ftest_download_coverage_results.py?ref=5dfa28998ba5910c468fa9bb0af62b023ea9188a",
      "deletions": 0,
      "filename": "tests/test_utils/python_scripts/test_download_coverage_results.py",
      "patch": "@@ -0,0 +1,33 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+\n+import unittest\n+from types import SimpleNamespace\n+from unittest.mock import MagicMock, patch\n+\n+from tests.test_utils.python_scripts import download_coverage_results\n+\n+\n+class TestCoverageBridgePagination(unittest.TestCase):\n+    def test_downloads_unit_test_bridges_beyond_the_first_page(self):\n+        project = MagicMock()\n+        parent_pipeline = MagicMock()\n+        downstream = MagicMock()\n+        downstream.jobs.list.return_value = []\n+        first_page = [SimpleNamespace(name=\"build\", downstream_pipeline=None)]\n+        later_bridge = SimpleNamespace(name=\"test:unit_tests_dev\", downstream_pipeline={\"id\": 456})\n+        parent_pipeline.bridges.list.side_effect = lambda **kwargs: (\n+            first_page + [later_bridge] if kwargs.get(\"get_all\") else first_page\n+        )\n+        project.pipelines.get.side_effect = lambda pipeline_id: (\n+            parent_pipeline if pipeline_id == 123 else downstream\n+        )\n+        with patch.object(download_coverage_results.gitlab, \"Gitlab\") as gitlab_handle:\n+            gitlab_handle.return_value.projects.get.return_value = project\n+            download_coverage_results.main.callback(123)\n+\n+        project.pipelines.get.assert_any_call(456)\n+        parent_pipeline.bridges.list.assert_called_once_with(get_all=True)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5dfa28998ba5910c468fa9bb0af62b023ea9188a/tests%2Ftest_utils%2Fpython_scripts%2Ftest_download_coverage_results.py",
      "sha": "f11cf78ad12fa33a9232d49d17cca5d741703d06",
      "status": "added"
    }
