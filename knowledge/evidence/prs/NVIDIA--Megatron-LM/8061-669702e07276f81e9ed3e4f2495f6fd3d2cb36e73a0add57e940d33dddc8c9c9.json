    {
      "additions": 40,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/51b6c99dcd928a2c87f1c433c2b21da5c0922bbe/.github%2Fscripts%2Ftest_oncall_handover_failure.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/.github%2Fscripts%2Ftest_oncall_handover_failure.py?ref=51b6c99dcd928a2c87f1c433c2b21da5c0922bbe",
      "deletions": 0,
      "filename": ".github/scripts/test_oncall_handover_failure.py",
      "patch": "@@ -0,0 +1,40 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+import unittest\n+from unittest import mock\n+\n+import oncall_manager as oncall\n+\n+\n+class TestHandover(unittest.TestCase):\n+    def test_failed_add_keeps_existing_members_and_slack_unchanged(self):\n+        with (\n+            mock.patch.object(oncall, 'get_team_members', return_value={'old'}),\n+            mock.patch.object(oncall, 'get_headers', return_value={}),\n+            mock.patch.object(\n+                oncall.requests, 'put', return_value=mock.Mock(status_code=403, text='denied')\n+            ),\n+            mock.patch.object(oncall.requests, 'delete') as delete,\n+            mock.patch.object(oncall, 'update_slack_usergroup') as slack,\n+        ):\n+            with self.assertRaises(SystemExit):\n+                oncall.update_active_oncall_team('NVIDIA', 'new')\n+            delete.assert_not_called()\n+            slack.assert_not_called()\n+\n+    def test_successful_add_still_retires_previous_oncall(self):\n+        with (\n+            mock.patch.object(oncall, 'get_team_members', return_value={'old'}),\n+            mock.patch.object(oncall, 'get_headers', return_value={}),\n+            mock.patch.object(oncall.requests, 'put', return_value=mock.Mock(status_code=200)),\n+            mock.patch.object(\n+                oncall.requests, 'delete', return_value=mock.Mock(status_code=204)\n+            ) as delete,\n+            mock.patch.object(oncall, 'update_slack_usergroup') as slack,\n+        ):\n+            oncall.update_active_oncall_team('NVIDIA', 'new')\n+            delete.assert_called_once()\n+            slack.assert_called_once_with('new', ['old'])\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/51b6c99dcd928a2c87f1c433c2b21da5c0922bbe/.github%2Fscripts%2Ftest_oncall_handover_failure.py",
      "sha": "72559af081af668ec1378e6146d2a8b34a8ec790",
      "status": "added"
    }
