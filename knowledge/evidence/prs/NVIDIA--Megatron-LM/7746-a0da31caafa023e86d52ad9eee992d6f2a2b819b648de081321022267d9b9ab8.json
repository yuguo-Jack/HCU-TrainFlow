      "additions": 6,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/megatron%2Fcore%2Finference%2Fsampling%2Ftorch_sampling.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Finference%2Fsampling%2Ftorch_sampling.py?ref=8d4c6507fc06bf32d0e5bc6d855d924d3a240d42",
      "deletions": 7,
      "filename": "megatron/core/inference/sampling/torch_sampling.py",
      "patch": "@@ -39,14 +39,13 @@ def _modify_logits_for_top_k_filtering(logits: Tensor, top_k: int) -> None:\n     @staticmethod\n     def _modify_logits_for_top_p_filtering(logits: Tensor, top_p: float) -> None:\n         \"\"\"In-place: set logits outside the top-p (nucleus) set to -inf.\"\"\"\n-        sorted_logits, sorted_indices = torch.sort(logits, descending=True)\n+        # Match the low-probability-tail convention used by NeMo-RL policy\n+        # recomputation and vLLM. Descending cumulative mass with a shifted\n+        # cutoff disagrees at exact thresholds and chooses different tied tokens.\n+        sorted_logits, sorted_indices = torch.sort(logits, descending=False)\n         cumulative_probs = sorted_logits.softmax(dim=-1, dtype=torch.float32).cumsum(dim=-1)\n-\n-        filter_ = cumulative_probs > top_p\n-        # Clone needed: filter_[:, 1:] and filter_[:, :-1] are overlapping views;\n-        # without clone, each write would corrupt the next read during the shift.\n-        filter_[:, 1:] = filter_[:, :-1].clone()\n-        filter_[..., 0] = 0\n+        filter_ = cumulative_probs <= 1.0 - top_p\n+        filter_[..., -1] = False\n \n         filter_ = filter_.scatter(1, sorted_indices, filter_)\n         logits.masked_fill_(filter_, float(\"-Inf\"))",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/megatron%2Fcore%2Finference%2Fsampling%2Ftorch_sampling.py",
      "sha": "bdce30fc061d48b3d1b5a5ce85c87faacadd0739",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Fmanifest.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Fmanifest.py?ref=8d4c6507fc06bf32d0e5bc6d855d924d3a240d42",
      "deletions": 0,
      "filename": "tests/unit_tests/determinism/kernels/manifest.py",
      "patch": "@@ -719,6 +719,14 @@ class KernelEntry:\n         \"test_mxfp8_quantize_replays) or FlashInfer mxfp8_quantize / mm_mxfp8 / fused MoE, which need \"\n         \"flashinfer on Blackwell and are not replayed in CI.\",\n     ),\n+    KernelEntry(\n+        name=\"inference_torch_sampling\",\n+        sources=(\"megatron/core/inference/sampling/torch_sampling.py\",),\n+        tests=(K + \"test_torch_sampling_support.py\",),\n+        kind=\"dispatch\",\n+        training_path=False,\n+        notes=\"Top-p tail-cutoff parity and exact replay on tied logits.\",\n+    ),\n     KernelEntry(\n         name=\"inference_request_seed_sampling\",\n         sources=(",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Fmanifest.py",
      "sha": "9f29e0730f4d085f53822b6ce50c549cdfb365b9",
      "status": "modified"
    },
    {
      "additions": 38,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_request_seed_sampling.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_request_seed_sampling.py?ref=8d4c6507fc06bf32d0e5bc6d855d924d3a240d42",
      "deletions": 0,
      "filename": "tests/unit_tests/determinism/kernels/test_request_seed_sampling.py",
      "patch": "@@ -8,6 +8,7 @@\n     _request_seed_noise_kernel,\n     fill_request_seed_noise,\n )\n+from megatron.core.inference.sampling.torch_sampling import TorchSampling\n from tests.unit_tests.determinism.kernels.harness import assert_replays_bit_exact\n \n \n@@ -50,3 +51,40 @@ def noise():\n     fill_request_seed_noise(changed, [0, 0, 0, None, 123], [19] * 5)\n     for row in (0, 1, 2):\n         assert not torch.equal(full[row], changed[row])\n+\n+\n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA required\")\n+def test_seeded_top_p_replays_across_batch_layouts_at_exact_cutoff():\n+    logits = torch.zeros(16, 16, device=\"cuda\")\n+    seeds = list(range(16))\n+    generator = torch.Generator(device=\"cuda\").manual_seed(42)\n+    initial_state = generator.get_state().clone()\n+\n+    def draw(rows, row_seeds):\n+        return TorchSampling.sample_from_logits(\n+            rows,\n+            temperature=1.0,\n+            top_k=0,\n+            top_p=0.5,\n+            generator=generator,\n+            row_seeds=row_seeds,\n+            row_positions=[23] * len(row_seeds),\n+        )\n+\n+    reference, _ = assert_replays_bit_exact(\n+        lambda: draw(logits, seeds),\n+        (),\n+        backward=False,\n+        contention=True,\n+        what=\"seeded top-p at an exact cutoff\",\n+    )\n+    full = reference[\"out\"]\n+    # Uniform logits put exactly half the mass in the removed lower tail.\n+    # Match the policy's ascending-sort tie order and exclude the cutoff token.\n+    indices = logits.sort(dim=-1, descending=False).indices\n+    support = indices[:, 8:]\n+    assert (full[:, None] == support).any(dim=-1).all()\n+    assert torch.equal(full, draw(logits.flip(0), seeds[::-1]).flip(0))\n+    for row, seed in enumerate(seeds):\n+        assert torch.equal(full[row : row + 1], draw(logits[row : row + 1], [seed]))\n+    assert torch.equal(initial_state, generator.get_state())",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_request_seed_sampling.py",
      "sha": "f6245b30c6bd69cc28cf8531461779a10407868d",
      "status": "modified"
    },
    {
      "additions": 42,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_torch_sampling_support.py",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_torch_sampling_support.py?ref=8d4c6507fc06bf32d0e5bc6d855d924d3a240d42",
      "deletions": 0,
      "filename": "tests/unit_tests/determinism/kernels/test_torch_sampling_support.py",
      "patch": "@@ -0,0 +1,42 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+\n+\"\"\"Nucleus support parity and same-input replay at exact cutoffs and ties.\"\"\"\n+\n+import pytest\n+import torch\n+\n+from megatron.core.inference.sampling.torch_sampling import TorchSampling\n+from tests.unit_tests.determinism.kernels.harness import assert_replays_bit_exact\n+\n+\n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA unavailable\")\n+@pytest.mark.parametrize(\"top_p\", [0.1, 0.5, 0.9])\n+@pytest.mark.parametrize(\"tied\", [False, True])\n+def test_top_p_matches_training_tail_cutoff(top_p, tied):\n+    device = \"cuda\"\n+    logits = torch.zeros(3, 16, device=device)\n+    if not tied:\n+        logits[:] = torch.arange(16, device=device).float() / 4\n+    # Explicit policy-recomputation reference: retain mass above the removed\n+    # lower tail, including its exact-threshold convention.\n+    values, indices = logits.sort(dim=-1, descending=False)\n+    keep = values.softmax(dim=-1).cumsum(dim=-1) > 1 - top_p\n+    keep[:, -1] = True\n+    expected = values.masked_fill(~keep, -torch.inf).scatter(\n+        -1, indices, values.masked_fill(~keep, -torch.inf)\n+    )\n+    actual = TorchSampling.filter_logits(logits, 1.0, 0, top_p)\n+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)\n+    if tied and top_p == 0.5:\n+        assert torch.isfinite(actual).sum(dim=-1).tolist() == [8, 8, 8]\n+\n+\n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA unavailable\")\n+def test_torch_top_p_filter_replays():\n+    logits = torch.zeros(4, 128, device=\"cuda\")\n+    assert_replays_bit_exact(\n+        lambda x: TorchSampling.filter_logits(x, 1.0, 0, 0.5),\n+        (logits,),\n+        backward=False,\n+        what=\"torch top-p support\",\n+    )",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/8d4c6507fc06bf32d0e5bc6d855d924d3a240d42/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_torch_sampling_support.py",
      "sha": "c357409c5581faa81f2197b16fa3e5c74b939513",
      "status": "added"
    }
