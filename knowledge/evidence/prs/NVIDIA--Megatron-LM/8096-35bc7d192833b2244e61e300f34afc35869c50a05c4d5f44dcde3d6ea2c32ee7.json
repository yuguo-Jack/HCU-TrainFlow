    {
      "additions": 36,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/5d31c918ec8338c949bacf6ceafb319562b549d6/tests%2Funit_tests%2Ftest_common_pile_setup_script_dir.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftest_common_pile_setup_script_dir.py?ref=5d31c918ec8338c949bacf6ceafb319562b549d6",
      "deletions": 0,
      "filename": "tests/unit_tests/test_common_pile_setup_script_dir.py",
      "patch": "@@ -0,0 +1,36 @@\n+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.\n+\n+import subprocess\n+import tempfile\n+import unittest\n+from pathlib import Path\n+\n+\n+class TestSetupScriptDirectory(unittest.TestCase):\n+    def test_relative_invocation_finds_adjacent_dataset_script(self):\n+        source = Path(\"tools/common_pile_dataset/setup_common_pile_dataset.sh\").read_text()\n+        # Run the actual directory-discovery phase, excluding HPC prerequisites\n+        # and the subsequent network/download/preprocessing phases.\n+        phase = source.split(\"# Create work directory\", 1)[1].split(\"# Clone Megatron-LM\", 1)[0]\n+        with tempfile.TemporaryDirectory() as tmp:\n+            root = Path(tmp)\n+            scripts = root / \"scripts\"\n+            scripts.mkdir()\n+            dataset_script = scripts / \"create_common_pile_ci_dataset.py\"\n+            dataset_script.touch()\n+            setup = scripts / \"setup.sh\"\n+            setup.write_text(\n+                \"#!/bin/bash\\nset -euo pipefail\\n\"\n+                f\"WORK_DIR='{root / 'work'}'\\n\" + phase + '\\nprintf \"%s\\\\n\" \"${DATASET_SCRIPT}\"\\n'\n+            )\n+            result = subprocess.run(\n+                [\"bash\", \"scripts/setup.sh\"], cwd=root, text=True, capture_output=True\n+            )\n+            self.assertEqual(result.returncode, 0, result.stderr)\n+            self.assertEqual(\n+                Path(result.stdout.splitlines()[-1]).resolve(), dataset_script.resolve()\n+            )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5d31c918ec8338c949bacf6ceafb319562b549d6/tests%2Funit_tests%2Ftest_common_pile_setup_script_dir.py",
      "sha": "bfa58618f13d760046085e8f182f1571157412bc",
      "status": "added"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/5d31c918ec8338c949bacf6ceafb319562b549d6/tools%2Fcommon_pile_dataset%2Fsetup_common_pile_dataset.sh",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tools%2Fcommon_pile_dataset%2Fsetup_common_pile_dataset.sh?ref=5d31c918ec8338c949bacf6ceafb319562b549d6",
      "deletions": 1,
      "filename": "tools/common_pile_dataset/setup_common_pile_dataset.sh",
      "patch": "@@ -44,11 +44,12 @@ echo \"HF cache:   ${HF_HOME}\"\n echo \"============================================================\"\n \n # Create work directory\n+# Resolve the script location before changing the working directory.\n+SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n mkdir -p \"${WORK_DIR}\"\n cd \"${WORK_DIR}\"\n \n # Check if create_common_pile_ci_dataset.py was scp'd alongside this script\n-SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n if [ -f \"${SCRIPT_DIR}/create_common_pile_ci_dataset.py\" ]; then\n     DATASET_SCRIPT=\"${SCRIPT_DIR}/create_common_pile_ci_dataset.py\"\n     echo \"Found dataset script at: ${DATASET_SCRIPT}\"",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5d31c918ec8338c949bacf6ceafb319562b549d6/tools%2Fcommon_pile_dataset%2Fsetup_common_pile_dataset.sh",
      "sha": "7523622d3f6501c60b30087dc256b2089873139a",
      "status": "modified"
    }
