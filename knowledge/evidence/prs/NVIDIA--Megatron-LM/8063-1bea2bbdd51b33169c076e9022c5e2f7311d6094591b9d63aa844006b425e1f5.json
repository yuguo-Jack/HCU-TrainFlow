    {
      "additions": 26,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/f7ab0d0ff7ed5a883823602a598196b0bc1da073/tools%2Ftest_linter_command.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tools%2Ftest_linter_command.py?ref=f7ab0d0ff7ed5a883823602a598196b0bc1da073",
      "deletions": 0,
      "filename": "tools/test_linter_command.py",
      "patch": "@@ -0,0 +1,26 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+import unittest\n+from unittest import mock\n+\n+import linter\n+\n+\n+class TestLinter(unittest.TestCase):\n+    def test_formatter_receives_a_literal_filename_argument(self):\n+        with (\n+            mock.patch.dict('sys.modules', {'autopep8': mock.Mock()}),\n+            mock.patch.object(linter.os, 'listdir', return_value=['model file.py']),\n+            mock.patch.object(linter.os, 'walk', return_value=[]),\n+            mock.patch.object(linter.subprocess, 'check_call') as call,\n+        ):\n+            linter.recursively_lint_files()\n+            args = call.call_args.args[0]\n+            self.assertIsInstance(args, list)\n+            self.assertEqual(\n+                args[:-1], ['autopep8', '--max-line-length', '100', '--aggressive', '--in-place']\n+            )\n+            self.assertTrue(args[-1].endswith('/model file.py'))\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/f7ab0d0ff7ed5a883823602a598196b0bc1da073/tools%2Ftest_linter_command.py",
      "sha": "8322dea2aa3b6a4c49f1fecee88f820e8e8cef97",
      "status": "added"
    }
  ],
