      "patch": "@@ -220,6 +220,7 @@ def update_active_oncall_team(org, new_oncall):\n             print(\n                 f\"Failed to add {new_oncall} to {ACTIVE_ONCALL_TEAM_SLUG}: {resp.status_code} {resp.text}\"\n             )\n+            sys.exit(1)\n \n     # 3. Remove everyone else\n     old_members = []",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/51b6c99dcd928a2c87f1c433c2b21da5c0922bbe/.github%2Fscripts%2Foncall_manager.py",
      "sha": "54a833740f74ae0d208288c40c721d6f041f94ea",
