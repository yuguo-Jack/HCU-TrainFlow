      "additions": 4,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/2f7d8533a73439f16ec1e0ae11584b7fde0c32fa/megatron%2Fcore%2Ftransformer%2Fmoe%2Frouter.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fmoe%2Frouter.py?ref=2f7d8533a73439f16ec1e0ae11584b7fde0c32fa",
      "deletions": 2,
      "filename": "megatron/core/transformer/moe/router.py",
      "patch": "@@ -791,8 +791,10 @@ def attach_and_log_load_balancing_loss(\n                         device=activation.device\n                     )\n                 else:\n-                    aux_loss_scale_num_tokens = torch.tensor(\n-                        num_local_tokens, device=activation.device\n+                    # torch.full is a device-side fill; torch.tensor(int, device=cuda) does a\n+                    # pageable H2D copy that fails inside the moe_router CUDA graph capture.\n+                    aux_loss_scale_num_tokens = torch.full(\n+                        (), num_local_tokens, dtype=torch.int64, device=activation.device\n                     )\n                 if aux_loss_scale_reduce_groups is None:\n                     assert reduce_group is not None, \"reduce_group is required for aux-loss scaling\"",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/2f7d8533a73439f16ec1e0ae11584b7fde0c32fa/megatron%2Fcore%2Ftransformer%2Fmoe%2Frouter.py",
      "sha": "99814faf982ab4f730825c12802ca740a11a3fcf",
      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/2f7d8533a73439f16ec1e0ae11584b7fde0c32fa/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_moe_kernels.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_moe_kernels.py?ref=2f7d8533a73439f16ec1e0ae11584b7fde0c32fa",
      "deletions": 0,
      "filename": "tests/unit_tests/determinism/kernels/test_moe_kernels.py",
      "patch": "@@ -457,6 +457,39 @@ def test_topk_router_replays(self, balancing, score, expert_bias, hash_routing):\n             what=f\"TopKRouter[{balancing}, hash={hash_routing}]\",\n         )\n \n+    def test_topk_router_per_token_loss_replays_and_captures(self):\n+        \"\"\"seq_aux_loss with per-token-loss scaling replays bit-exactly and its scale tensor can\n+        be created inside CUDA graph capture (a pageable H2D copy there fails the capture).\"\"\"\n+        self._init()\n+        seeded()\n+        config = _moe_config(\n+            num_moe_experts=64,\n+            moe_router_topk=8,\n+            moe_router_load_balancing_type=\"seq_aux_loss\",\n+            moe_router_score_function=\"sigmoid\",\n+            moe_aux_loss_coeff=0.01,\n+            calculate_per_token_loss=True,\n+        )\n+        router = TopKRouter(\n+            config, pg_collection=ProcessGroupCollection.use_mpu_process_groups()\n+        ).cuda()\n+        router.set_layer_number(0)\n+        hidden = torch.randn(2048, 4, 1024, device=\"cuda\", dtype=torch.bfloat16, requires_grad=True)\n+        assert_module_replays_bit_exact(\n+            router, (hidden,), replays=3, what=\"TopKRouter[seq_aux_loss, per_token_loss]\"\n+        )\n+        side_stream = torch.cuda.Stream()\n+        side_stream.wait_stream(torch.cuda.current_stream())\n+        with torch.cuda.stream(side_stream):\n+            router(hidden)\n+        torch.cuda.current_stream().wait_stream(side_stream)\n+        graph = torch.cuda.CUDAGraph()\n+        with torch.cuda.graph(graph):\n+            router(hidden)\n+        graph.replay()\n+        torch.cuda.synchronize()\n+        moe_utils.get_moe_metrics_tracker().clear()\n+\n     @pytest.mark.skipif(\n         not (HAVE_TE_ROUTER and moe_utils.fused_topk_with_score_function_supports_topk_indices),\n         reason=\"TE dense fused router output is not available\",",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/2f7d8533a73439f16ec1e0ae11584b7fde0c32fa/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_moe_kernels.py",
      "sha": "899f72a4297328e94cdac8ea6e74f50f95199709",
      "status": "modified"
    }
