      "changes": 29,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fattention.py?ref=ee7c8497c8ad5daa85e943bb853809f3c0fcfb2a",
      "deletions": 2,
      "filename": "megatron/core/transformer/attention.py",
      "patch": "@@ -131,8 +131,12 @@\n     from transformer_engine.pytorch.attention.rope import apply_fused_qkv_rotary_pos_emb\n \n     HAVE_FUSED_QKV_ROPE = True\n+    HAVE_FUSED_QKV_ROPE_FP8_ATTENTION = (\n+        \"defer_for_fp8_attention\" in inspect.signature(apply_fused_qkv_rotary_pos_emb).parameters\n+    )\n except ImportError:\n     HAVE_FUSED_QKV_ROPE = False\n+    HAVE_FUSED_QKV_ROPE_FP8_ATTENTION = False\n \n \n class LinearQkvInterface(Protocol):\n@@ -1605,9 +1609,30 @@ def forward_pre_attn_and_core_attn(\n                         max_seqlen=rope_freqs_max_seqlen,\n                     )\n             else:\n-                query, key, value = apply_fused_qkv_rotary_pos_emb(\n-                    mixed_qkv, q_pos_emb, k_pos_emb, qkv_split_arg_list\n+                # The FP8 attention fusion hands TE placeholders that its core attention fills\n+                # (or fuses with the FP8 quantization), so they must not be offloaded or\n+                # recomputed from.\n+                defer_for_fp8_attention = (\n+                    self.config.fused_qkv_rope_fp8_attention\n+                    and not (self.checkpoint_core_attention and self.training)\n+                    and not (self.offload_core_attention and self.training)\n                 )\n+                if defer_for_fp8_attention:\n+                    assert HAVE_FUSED_QKV_ROPE_FP8_ATTENTION, (\n+                        \"fused_qkv_rope_fp8_attention requires a TransformerEngine version whose \"\n+                        \"apply_fused_qkv_rotary_pos_emb supports defer_for_fp8_attention.\"\n+                    )\n+                    query, key, value = apply_fused_qkv_rotary_pos_emb(\n+                        mixed_qkv,\n+                        q_pos_emb,\n+                        k_pos_emb,\n+                        qkv_split_arg_list,\n+                        defer_for_fp8_attention=True,\n+                    )\n+                else:\n+                    query, key, value = apply_fused_qkv_rotary_pos_emb(\n+                        mixed_qkv, q_pos_emb, k_pos_emb, qkv_split_arg_list\n+                    )\n \n             # TODO, can apply positional embedding to value_layer so it has\n             # absolute positional embedding.",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/ee7c8497c8ad5daa85e943bb853809f3c0fcfb2a/megatron%2Fcore%2Ftransformer%2Fattention.py",
      "sha": "0b66c226b4c75970da87d319932e25b7df064a94",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/ee7c8497c8ad5daa85e943bb853809f3c0fcfb2a/megatron%2Fcore%2Ftransformer%2Ftransformer_config.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Ftransformer_config.py?ref=ee7c8497c8ad5daa85e943bb853809f3c0fcfb2a",
      "deletions": 0,
      "filename": "megatron/core/transformer/transformer_config.py",
      "patch": "@@ -591,6 +591,12 @@ class TransformerConfig(ModelParallelConfig):\n     fused_single_qkv_rope: bool = False\n     \"\"\"If set, avoid splitting QKV before ROPE forward and avoid concatenating ROPE dgrads.\"\"\"\n \n+    fused_qkv_rope_fp8_attention: bool = False\n+    \"\"\"If set, let TransformerEngine fuse the RoPE of the single QKV tensor with the FP8\n+    current-scaling quantization of Q/K/V inside core attention (falls back to the regular fused\n+    RoPE whenever attention does not run FP8 current-scaling fused attention). Requires\n+    fused_single_qkv_rope and is disabled for checkpointed or offloaded core attention.\"\"\"\n+\n     fused_residual_rmsnorm: bool = False\n     \"\"\"If True, fuses residual connection and RMSNorm backward pass when TE is used.\"\"\"\n \n@@ -3104,6 +3110,9 @@ def __post_init__(self):\n             if self.attention_output_gate:\n                 raise ValueError(\"fused_single_qkv_rope does not support gated attention for now.\")\n \n+        if self.fused_qkv_rope_fp8_attention and not self.fused_single_qkv_rope:\n+            raise ValueError(\"fused_qkv_rope_fp8_attention requires fused_single_qkv_rope.\")\n+\n         if self.multi_latent_attention and self.rotary_interleaved:\n             raise ValueError(\"rotary_interleaved does not work with multi_latent_attention.\")\n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/ee7c8497c8ad5daa85e943bb853809f3c0fcfb2a/megatron%2Fcore%2Ftransformer%2Ftransformer_config.py",
      "sha": "4ccaeb32645f595b12ac8e97b1b32469e8131760",
      "status": "modified"
    }
