  "files": [
    {
      "additions": 2,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/695d66f55deeb8e1373b0cf8ce38d83c38c45e24/megatron%2Fcore%2Fdist_checkpointing%2Fdict_utils.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fdist_checkpointing%2Fdict_utils.py?ref=695d66f55deeb8e1373b0cf8ce38d83c38c45e24",
      "deletions": 2,
      "filename": "megatron/core/dist_checkpointing/dict_utils.py",
      "patch": "@@ -93,8 +93,8 @@ def diff(x1: Any, x2: Any, prefix: Tuple = ()) -> Tuple[list, list, list]:\n             mismatch.extend(_mismatch)\n     elif isinstance(x1, list) or isinstance(x1, tuple) or isinstance(x1, np.ndarray):\n         assert type(x1) == type(x2)\n-        only_left = list(range(len(x1) - 1, len(x2) - 1, -1))\n-        only_right = list(range(len(x2) - 1, len(x1) - 1, -1))\n+        only_left = [prefix + (i,) for i in range(len(x1) - 1, len(x2) - 1, -1)]\n+        only_right = [prefix + (i,) for i in range(len(x2) - 1, len(x1) - 1, -1)]\n         for i, (v1, v2) in enumerate(zip(x1, x2)):\n             _left, _right, _mismatch = diff(v1, v2, prefix + (i,))\n             only_left.extend(_left)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/695d66f55deeb8e1373b0cf8ce38d83c38c45e24/megatron%2Fcore%2Fdist_checkpointing%2Fdict_utils.py",
      "sha": "4d8ff8b44a9e56fd7f90ad17d6f37c96485b50b9",
      "status": "modified"
    },
    {
      "additions": 38,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/695d66f55deeb8e1373b0cf8ce38d83c38c45e24/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_dict_utils.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_dict_utils.py?ref=695d66f55deeb8e1373b0cf8ce38d83c38c45e24",
      "deletions": 0,
      "filename": "tests/unit_tests/dist_checkpointing/test_dict_utils.py",
      "patch": "@@ -0,0 +1,38 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+\n+import numpy as np\n+import pytest\n+\n+from megatron.core.dist_checkpointing.dict_utils import diff\n+\n+\n+@pytest.mark.parametrize(\"sequence_type\", [list, tuple, np.array])\n+@pytest.mark.parametrize(\"extra_on_left\", [True, False])\n+def test_diff_sequence_length_reports_nested_paths(sequence_type, extra_on_left):\n+    \"\"\"Missing sequence elements carry the same path prefix as mismatched values.\"\"\"\n+    shorter = {\"layers\": [sequence_type([1])]}\n+    longer = {\"layers\": [sequence_type([1, 2, 3])]}\n+    left, right = (longer, shorter) if extra_on_left else (shorter, longer)\n+\n+    only_left, only_right, mismatch = diff(left, right, prefix=(\"checkpoint\",))\n+\n+    expected = [(\"checkpoint\", \"layers\", 0, 2), (\"checkpoint\", \"layers\", 0, 1)]\n+    assert only_left == (expected if extra_on_left else [])\n+    assert only_right == ([] if extra_on_left else expected)\n+    assert not mismatch\n+\n+\n+def test_diff_empty_sequence_reports_index_paths():\n+    \"\"\"Root-level missing elements use tuple paths too, preserving index order.\"\"\"\n+    assert diff([1, 2], []) == ([(1,), (0,)], [], [])\n+    assert diff([], [1, 2]) == ([], [(1,), (0,)], [])\n+    assert diff([], []) == ([], [], [])\n+\n+\n+def test_diff_sequence_mismatch_preserves_paths():\n+    \"\"\"Shared elements still report their recursive path rather than a missing key.\"\"\"\n+    only_left, only_right, mismatch = diff({\"layers\": [1, 2]}, {\"layers\": [1, 3]})\n+\n+    assert not only_left\n+    assert not only_right\n+    assert mismatch == [((\"layers\", 1), int, int)]",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/695d66f55deeb8e1373b0cf8ce38d83c38c45e24/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_dict_utils.py",
      "sha": "7a08a0740cc1a47717b4c6e6b49e57975ece5f8c",
      "status": "added"
    }
  ],
