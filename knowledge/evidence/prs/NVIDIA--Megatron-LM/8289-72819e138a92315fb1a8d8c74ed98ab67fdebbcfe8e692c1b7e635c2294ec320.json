    {
      "additions": 23,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/57f8bf2d22a1e2cea0bf6b7bcd4d513fea56ca2b/.github%2Fworkflows%2Fcicd-main.yml",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/.github%2Fworkflows%2Fcicd-main.yml?ref=57f8bf2d22a1e2cea0bf6b7bcd4d513fea56ca2b",
      "deletions": 0,
      "filename": ".github/workflows/cicd-main.yml",
      "patch": "@@ -657,6 +657,9 @@ jobs:\n       - name: Test DCO gate publisher\n         run: python3 .github/scripts/test_dco_gate.py\n \n+      - name: Test merge-group testing notification wiring\n+        run: python3 .github/scripts/test_ci_notifications.py\n+\n       - name: Test superseded merge-group cleanup\n         run: python3 .github/scripts/test_cancel_superseded_merge_group_runs.py\n \n@@ -1512,6 +1515,26 @@ jobs:\n             exit 1\n           fi\n \n+  notify-merge-group-failure:\n+    name: Notify merge-group testing failure\n+    runs-on: ubuntu-latest\n+    environment: main\n+    needs: [cicd-unit-tests-latest, cicd-unit-tests-latest-gb200, cicd-integration-tests-latest-h100, cicd-integration-tests-latest-gb200]\n+    permissions: {}\n+    # Report test failures, not failed ancestors or build-cache population.\n+    # Queue runs use a synthetic head ref; check the target branch instead.\n+    if: >-\n+      ${{ always() && !cancelled() && contains(needs.*.result, 'failure') &&\n+          github.repository == 'NVIDIA/Megatron-LM' &&\n+          github.event_name == 'merge_group' &&\n+          github.event.merge_group.base_ref == format('refs/heads/{0}', github.event.repository.default_branch) }}\n+    steps:\n+      - name: Notify CI alerts channel\n+        uses: NVIDIA-NeMo/FW-CI-templates/.github/actions/notify-ci-failure@631c404d00a9e60afc591cd071d35d2e18f82fc6\n+        with:\n+          needs-json: ${{ toJSON(needs) }}\n+          webhook: ${{ secrets.SLACK_WEBHOOK }}\n+\n   Coverage_Fake:\n     runs-on: ubuntu-latest\n     needs: [Nemo_CICD_Test, pre-flight]",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/57f8bf2d22a1e2cea0bf6b7bcd4d513fea56ca2b/.github%2Fworkflows%2Fcicd-main.yml",
      "sha": "cc4160fa6a63349b8e458731f5edb6deb2b48dd9",
      "status": "modified"
    }
