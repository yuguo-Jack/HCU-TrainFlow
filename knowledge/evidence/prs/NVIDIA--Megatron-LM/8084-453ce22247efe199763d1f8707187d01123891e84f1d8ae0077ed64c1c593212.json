    {
      "additions": 31,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/7966a3d8999cd2c3efea7df36352364dd28d39b5/tests%2Ftest_utils%2Fpython_scripts%2Ftest_check_status_terminal.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ftest_utils%2Fpython_scripts%2Ftest_check_status_terminal.py?ref=7966a3d8999cd2c3efea7df36352364dd28d39b5",
      "deletions": 0,
      "filename": "tests/test_utils/python_scripts/test_check_status_terminal.py",
      "patch": "@@ -0,0 +1,31 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+\n+import unittest\n+from types import SimpleNamespace\n+from unittest.mock import patch\n+\n+from tests.test_utils.python_scripts import check_status_of_main\n+\n+\n+class TestMainPipelineTerminalStatus(unittest.TestCase):\n+    def test_terminal_statuses_do_not_keep_the_continuous_poll_running(self):\n+        for status in ('success', 'failed', 'canceled', 'skipped'):\n+            with self.subTest(status=status):\n+                pipeline = SimpleNamespace(id=1, attributes={'status': status})\n+                with patch.object(\n+                    check_status_of_main, 'most_recent_pipeline', return_value=pipeline\n+                ):\n+                    self.assertFalse(check_status_of_main.is_pending('main'))\n+\n+    def test_active_statuses_still_wait(self):\n+        for status in ('created', 'waiting_for_resource', 'preparing', 'pending', 'running'):\n+            with self.subTest(status=status):\n+                pipeline = SimpleNamespace(id=1, attributes={'status': status})\n+                with patch.object(\n+                    check_status_of_main, 'most_recent_pipeline', return_value=pipeline\n+                ):\n+                    self.assertTrue(check_status_of_main.is_pending('main'))\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/7966a3d8999cd2c3efea7df36352364dd28d39b5/tests%2Ftest_utils%2Fpython_scripts%2Ftest_check_status_terminal.py",
      "sha": "2ea84f411d2f64b5c8621fc2f7dedbba6f54f649",
      "status": "added"
    }
