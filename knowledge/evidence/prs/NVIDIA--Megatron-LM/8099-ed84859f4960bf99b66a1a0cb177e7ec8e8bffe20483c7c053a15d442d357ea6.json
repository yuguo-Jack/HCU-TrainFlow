      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4e9517283e2d6f6161e2da7bad8fe6e1dfdc0328/.github%2Fscripts%2Ftest_assignment_finite_confidence.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/.github%2Fscripts%2Ftest_assignment_finite_confidence.py?ref=4e9517283e2d6f6161e2da7bad8fe6e1dfdc0328",
      "deletions": 0,
      "filename": ".github/scripts/test_assignment_finite_confidence.py",
      "patch": "@@ -0,0 +1,18 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+import unittest\n+\n+import community_request_assignee as assignment\n+\n+\n+class TestConfidence(unittest.TestCase):\n+    def test_nonfinite_values_cannot_authorize_automatic_assignment(self):\n+        for value in [float('inf'), float('-inf'), float('nan'), 'Infinity', '-Infinity', 'NaN']:\n+            with self.subTest(value=value):\n+                self.assertEqual(assignment.confidence_value(value), 0.0)\n+\n+    def test_valid_confidence_is_preserved(self):\n+        self.assertEqual(assignment.confidence_value(0.9), 0.9)\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4e9517283e2d6f6161e2da7bad8fe6e1dfdc0328/.github%2Fscripts%2Ftest_assignment_finite_confidence.py",
      "sha": "6174c1d70548d959660f0fc439afbd02b0474187",
      "status": "added"
    }
