      "changes": 16,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Finference%2Fengines%2Ftest_dynamic_engine.py?ref=f13d8338ca61db2ddf1dd1d89649ffa07223c6e7",
      "deletions": 0,
      "filename": "tests/unit_tests/inference/engines/test_dynamic_engine.py",
      "patch": "@@ -3213,6 +3213,22 @@ def test_stop_word_checkpoint_boundary_preserves_result_alignment(\n     assert serialized_event_tokens == merged.generated_tokens\n \n \n+@pytest.mark.asyncio\n+async def test_run_coroutine_sync_preserves_runtime_error_from_running_loop():\n+    engine = object.__new__(DynamicInferenceEngine)\n+    engine._loop = asyncio.get_running_loop()\n+    call_count = 0\n+\n+    async def fail_from_engine():\n+        nonlocal call_count\n+        call_count += 1\n+        raise RuntimeError(\"original engine failure\")\n+\n+    with pytest.raises(RuntimeError, match=\"original engine failure\"):\n+        engine._run_coroutine_sync(fail_from_engine())\n+    assert call_count == 1\n+\n+\n class TestDynamicInferenceEngine(DynamicInferenceEngineTestBase):\n \n     @classmethod",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/f13d8338ca61db2ddf1dd1d89649ffa07223c6e7/tests%2Funit_tests%2Finference%2Fengines%2Ftest_dynamic_engine.py",
