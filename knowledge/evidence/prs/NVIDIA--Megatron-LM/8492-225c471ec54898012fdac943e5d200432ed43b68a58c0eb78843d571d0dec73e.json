      "changes": 14,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Finference%2Fengines%2Fdynamic_engine.py?ref=f13d8338ca61db2ddf1dd1d89649ffa07223c6e7",
      "deletions": 6,
      "filename": "megatron/core/inference/engines/dynamic_engine.py",
      "patch": "@@ -4552,16 +4552,18 @@ def _run_coroutine_sync(self, coro):\n         frameworks like pytriton).\n         \"\"\"\n         try:\n-            # Check if there's already a running event loop\n             asyncio.get_running_loop()\n-            # We're inside a running loop - run in a separate thread\n-            with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:\n-                future = executor.submit(asyncio.run, coro)\n-                return future.result()\n         except RuntimeError:\n-            # No running loop - safe to use run_until_complete\n+            # No running loop - safe to use run_until_complete.\n             return self._loop.run_until_complete(coro)\n \n+        # We're inside a running loop - run in a separate thread. Keep this\n+        # outside the exception handler so a RuntimeError raised by the\n+        # coroutine is propagated instead of being mistaken for a missing loop.\n+        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:\n+            future = executor.submit(asyncio.run, coro)\n+            return future.result()\n+\n     def step_modern(self) -> DynamicInferenceEngineStepResult:\n         \"\"\"Synchronous wrapper for `self.async_step`.\"\"\"\n         return self._run_coroutine_sync(self.async_step())",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/f13d8338ca61db2ddf1dd1d89649ffa07223c6e7/megatron%2Fcore%2Finference%2Fengines%2Fdynamic_engine.py",
