  "files": [
    {
      "additions": 5,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/f2465ccbb1246fe6e555ba043258b56715d8c84a/megatron%2Fcore%2Ffusions%2Ffused_mhc_kernels.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ffusions%2Ffused_mhc_kernels.py?ref=f2465ccbb1246fe6e555ba043258b56715d8c84a",
      "deletions": 1,
      "filename": "megatron/core/fusions/fused_mhc_kernels.py",
      "patch": "@@ -2505,7 +2505,11 @@ def _cutile_fused_compute_h_proj_rms_bwd(\n             )\n \n         # 2. Separate lightweight kernel for scalar gradients (grad_alpha, grad_bias)\n-        tile_m_scalar = min(128, M)\n+        # cuTile requires constant tile shapes to be powers of two. For M < 128 that is\n+        # not a power of two (e.g. a 112-token SFT micro-batch) `min(128, M)` fails at\n+        # compile time with \"Dimension #0 of shape (M, TILE_N) is not a power of two\".\n+        # Round up instead; the loads use PAD_ZERO so the overhang adds nothing.\n+        tile_m_scalar = min(128, _next_power_of_2(M))\n         num_m_blocks = math.ceil(M / tile_m_scalar)\n         grad_alpha_pre_partials = torch.empty(num_m_blocks, 1, dtype=torch.float32, device=dev)\n         grad_alpha_post_partials = torch.empty(num_m_blocks, 1, dtype=torch.float32, device=dev)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/f2465ccbb1246fe6e555ba043258b56715d8c84a/megatron%2Fcore%2Ffusions%2Ffused_mhc_kernels.py",
      "sha": "70e3097373292027a86aae9f08d763bea2035e20",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/f2465ccbb1246fe6e555ba043258b56715d8c84a/tests%2Funit_tests%2Ffusions%2Ftest_fused_mhc_kernels.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ffusions%2Ftest_fused_mhc_kernels.py?ref=f2465ccbb1246fe6e555ba043258b56715d8c84a",
      "deletions": 1,
      "filename": "tests/unit_tests/fusions/test_fused_mhc_kernels.py",
      "patch": "@@ -687,7 +687,10 @@ def test_fwd_bwd_vs_torch_reference(self, M, N, K):\n class TestFusedProjRmsComputeH:\n     \"\"\"Public fused proj_rms_compute_h dispatch/fallback plus numerical correctness.\"\"\"\n \n-    @pytest.mark.parametrize(\"M,n,K\", [(256, 4, 4096), (64, 2, 512), (128, 4, 2048)])\n+    # 112 and 21 tokens: M < 128 and not a power of two, the variable-length SFT micro-batch case\n+    @pytest.mark.parametrize(\n+        \"M,n,K\", [(256, 4, 4096), (64, 2, 512), (128, 4, 2048), (112, 4, 2048), (21, 2, 512)]\n+    )\n     def test_fwd_bwd_vs_reference(self, M, n, K):\n         \"\"\"E2E: public fused fwd output and bwd grads must match the PyTorch reference.\"\"\"\n         from megatron.core.fusions.fused_mhc_kernels import fused_proj_rms_compute_h",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/f2465ccbb1246fe6e555ba043258b56715d8c84a/tests%2Funit_tests%2Ffusions%2Ftest_fused_mhc_kernels.py",
      "sha": "17aae1c3b4240392a13ddbf42309626897a89eb0",
      "status": "modified"
    }
  ],
