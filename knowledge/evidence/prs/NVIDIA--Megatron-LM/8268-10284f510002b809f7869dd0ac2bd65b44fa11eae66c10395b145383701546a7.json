      "additions": 18,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/7a1c89dd11573f637226854975bfa225ed625905/megatron%2Fcore%2Finference%2Ftext_generation_server%2Fdynamic_text_gen_server%2Fincremental_detokenizer.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Finference%2Ftext_generation_server%2Fdynamic_text_gen_server%2Fincremental_detokenizer.py?ref=7a1c89dd11573f637226854975bfa225ed625905",
      "deletions": 7,
      "filename": "megatron/core/inference/text_generation_server/dynamic_text_gen_server/incremental_detokenizer.py",
      "patch": "@@ -6,6 +6,8 @@\n import logging\n from typing import Any\n \n+from megatron.core.inference.utils import model_eos_token_ids\n+\n logger = logging.getLogger(__name__)\n \n _INVALID_PREFIX_ERROR = \"Invalid prefix encountered\"\n@@ -41,24 +43,33 @@ def __init__(self, tokenizer: Any, prompt_token_ids: list[int]) -> None:\n             )\n \n         self._native_tokenizer = huggingface_tokenizer._tokenizer\n-        # Final inference decoding always strips special tokens. Streaming must\n-        # make the same choice or its concatenated deltas can differ from\n-        # ``generated_text`` in the non-streaming response.\n-        self._skip_special_tokens = True\n+        # Streaming must drop exactly what the non-streaming response drops, or its\n+        # concatenated deltas differ from `generated_text`. That is the tokens in the\n+        # tokenizer's special-tokens map (`all_special_ids`) and the trailing EOS ids\n+        # (`remove_EOD`), not every added token flagged `special`: chat models flag\n+        # their reasoning and tool-call markers (`<think>`, `</think>`,\n+        # `<tool_call>`) as special, and the reasoning and tool parsers need them.\n+        # `DecodeStream(skip_special_tokens=True)` would drop those markers too.\n+        self._skipped_token_ids = frozenset(huggingface_tokenizer.all_special_ids) | (\n+            model_eos_token_ids(tokenizer)\n+        )\n         self._decode_stream = self._new_decode_stream(prompt_token_ids)\n         self._text_fragments: list[str] = []\n         self._text_length = 0\n \n     def _new_decode_stream(self, prompt_token_ids: list[int] | None = None):\n-        kwargs = {\"skip_special_tokens\": self._skip_special_tokens}\n+        kwargs = {\"skip_special_tokens\": False}\n         if prompt_token_ids is not None:\n-            kwargs[\"ids\"] = list(prompt_token_ids)\n+            kwargs[\"ids\"] = self._kept(prompt_token_ids)\n         return self._tokenizers.decoders.DecodeStream(**kwargs)\n \n+    def _kept(self, token_ids: list[int]) -> list[int]:\n+        return [token_id for token_id in token_ids if token_id not in self._skipped_token_ids]\n+\n     def update(self, token_ids: list[int]) -> str:\n         \"\"\"Decode token IDs and return only newly stable text.\"\"\"\n         fragments = []\n-        for token_id in token_ids:\n+        for token_id in self._kept(token_ids):\n             fragment = self._decode_next(token_id)\n             if fragment:\n                 fragments.append(fragment)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/7a1c89dd11573f637226854975bfa225ed625905/megatron%2Fcore%2Finference%2Ftext_generation_server%2Fdynamic_text_gen_server%2Fincremental_detokenizer.py",
      "sha": "d7aed6044a853dd807e55d0ae0ac21086d84ecb9",
      "status": "modified"
    },
    {
      "additions": 48,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/7a1c89dd11573f637226854975bfa225ed625905/tests%2Funit_tests%2Finference%2Ftest_openai_streaming.py",
      "changes": 48,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Finference%2Ftest_openai_streaming.py?ref=7a1c89dd11573f637226854975bfa225ed625905",
      "deletions": 0,
      "filename": "tests/unit_tests/inference/test_openai_streaming.py",
      "patch": "@@ -455,6 +455,54 @@ def test_huggingface_fast_incremental_detokenizer_skips_special_tokens():\n     assert streamed_text == \"ab\"\n \n \n+def _with_chat_markers(eos_marker=None):\n+    \"\"\"A byte-level tokenizer whose chat markers are added tokens flagged `special` but kept out\n+    of the special-tokens map, as in chat tokenizers that mark reasoning and tool calls.\"\"\"\n+    from tokenizers import AddedToken\n+\n+    tokenizer = _make_byte_level_fast_tokenizer()\n+    huggingface_tokenizer = tokenizer._tokenizer.tokenizer\n+    markers = [\"<think>\", \"</think>\", \"<tool_call>\", \"</tool_call>\", \"<|im_end|>\"]\n+    huggingface_tokenizer.add_tokens([AddedToken(marker, special=True) for marker in markers])\n+    if eos_marker is not None:\n+        tokenizer.eod = huggingface_tokenizer.convert_tokens_to_ids(eos_marker)\n+    return tokenizer, huggingface_tokenizer\n+\n+\n+def _non_streaming_text(huggingface_tokenizer, token_ids):\n+    \"\"\"What the non-streaming response decodes: the special-tokens map is removed, nothing else.\"\"\"\n+    tokens = huggingface_tokenizer.convert_ids_to_tokens(token_ids)\n+    kept = [token for token in tokens if token not in huggingface_tokenizer.all_special_tokens]\n+    return huggingface_tokenizer.convert_tokens_to_string(kept)\n+\n+\n+def test_huggingface_fast_incremental_detokenizer_keeps_chat_markers():\n+    tokenizer, huggingface_tokenizer = _with_chat_markers()\n+    text = \"<think>plan</think>answer<tool_call>call</tool_call>\"\n+    token_ids = huggingface_tokenizer.encode(text, add_special_tokens=False)\n+    detokenizer = HuggingFaceFastIncrementalDetokenizer(tokenizer, [])\n+\n+    streamed_text = \"\".join(detokenizer.update([token_id]) for token_id in token_ids)\n+\n+    # The reasoning and tool parsers see their markers, as they do without streaming.\n+    assert streamed_text == text\n+    assert streamed_text == _non_streaming_text(huggingface_tokenizer, token_ids)\n+\n+\n+def test_huggingface_fast_incremental_detokenizer_drops_eos_and_special_map_tokens():\n+    tokenizer, huggingface_tokenizer = _with_chat_markers(eos_marker=\"<|im_end|>\")\n+    huggingface_tokenizer.add_special_tokens({\"additional_special_tokens\": [\"<special>\"]})\n+    token_ids = huggingface_tokenizer.encode(\n+        \"<think>x</think>a<special>b<|im_end|>\", add_special_tokens=False\n+    )\n+    prompt_ids = huggingface_tokenizer.encode(\"<special>hi<|im_end|>\", add_special_tokens=False)\n+    detokenizer = HuggingFaceFastIncrementalDetokenizer(tokenizer, prompt_ids)\n+\n+    streamed_text = \"\".join(detokenizer.update([token_id]) for token_id in token_ids)\n+\n+    assert streamed_text == \"<think>x</think>ab\"\n+\n+\n def test_incremental_detokenizer_rejects_unsupported_tokenizer():\n     with pytest.raises(\n         ValueError, match=\"Streaming is currently supported only for Hugging Face fast tokenizers\"",
