      "changes": 5,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fdist_checkpointing%2Fstrategies%2Ffully_parallel.py?ref=a91d4ce46104663f882936329e83ed4b9a207e02",
      "deletions": 0,
      "filename": "megatron/core/dist_checkpointing/strategies/fully_parallel.py",
      "patch": "@@ -100,6 +100,9 @@ def __init__(\n         self.pg_cache_create = pg_cache_create\n \n         self.cached_distribution: Optional[ShardDistribution] = None\n+        # A singleton group legitimately caches None. Track global validation\n+        # separately so it is skipped on the same save calls on every rank.\n+        self._access_integrity_validated = False\n \n     def async_save(self, sharded_state_dict: ShardedStateDict, checkpoint_dir: Path):\n         \"\"\" \"\"\"\n@@ -149,11 +152,13 @@ def apply_saving_parallelization(self, sharded_state_dict: ShardedStateDict) ->\n         pg_cache_read = self.pg_cache_path is not None and not self.pg_cache_create\n         if (\n             self.cached_distribution is None\n+            and (not self.do_cache_distribution or not self._access_integrity_validated)\n             and not pg_cache_read\n             and self.validate_access_integrity\n         ):\n             # First time applying the parallelization\n             validate_sharding_integrity(determine_global_metadata(sharded_state_dict)[1])\n+            self._access_integrity_validated = True\n         if self.do_cache_distribution:\n             self.cached_distribution = precomputed_distribution\n         end = time()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a91d4ce46104663f882936329e83ed4b9a207e02/megatron%2Fcore%2Fdist_checkpointing%2Fstrategies%2Ffully_parallel.py",
      "sha": "70717a66b77e9d4becf1aa941b99a43981221b0d",
      "status": "modified"
    },
    {
      "additions": 62,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a91d4ce46104663f882936329e83ed4b9a207e02/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_fully_parallel.py",
      "changes": 62,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_fully_parallel.py?ref=a91d4ce46104663f882936329e83ed4b9a207e02",
      "deletions": 0,
      "filename": "tests/unit_tests/dist_checkpointing/test_fully_parallel.py",
      "patch": "@@ -93,6 +93,68 @@ def setup_method(self, method):\n     def teardown_method(self, method):\n         Utils.destroy_model_parallel()\n \n+    @pytest.mark.parametrize('cache_distribution', [False, True])\n+    @pytest.mark.parametrize('validate_access_integrity', [False, True])\n+    @pytest.mark.parametrize('save_method', ['save', 'async_save'])\n+    def test_repeated_save_validation_with_mixed_group_sizes(\n+        self, cache_distribution, validate_access_integrity, save_method\n+    ):\n+        \"\"\"All ranks must agree on global validation, including singleton groups.\"\"\"\n+        Utils.initialize_model_parallel(1, 1)\n+        if Utils.world_size < 4:\n+            pytest.skip('Mixed checkpoint groups require at least four ranks')\n+        split = Utils.world_size // 2\n+        memberships = [list(range(split))] + [[rank] for rank in range(split, Utils.world_size)]\n+        for members in memberships:\n+            group = torch.distributed.new_group(members)\n+            if Utils.rank in members:\n+                local_group = group\n+\n+        def state_dict():\n+            if Utils.rank < split:\n+                tensor = ShardedTensor.from_rank_offsets(\n+                    'encoder', torch.ones(4), replica_id=Utils.rank\n+                )\n+            else:\n+                tensor = ShardedTensor.from_rank_offsets(\n+                    'language',\n+                    torch.ones(4),\n+                    (0, Utils.rank - split, Utils.world_size - split),\n+                    replica_id=0,\n+                )\n+            return {'weight': tensor}\n+\n+        module = inspect.getmodule(FullyParallelSaveStrategyWrapper)\n+        original = module.determine_global_metadata\n+        validation_calls = 0\n+        first_metadata = None\n+\n+        def count_validation(sharded_state_dict):\n+            nonlocal validation_calls, first_metadata\n+            validation_calls += 1\n+            if first_metadata is None:\n+                first_metadata = original(sharded_state_dict)\n+            # Count a repeated global gather without entering it: the original\n+            # bug makes only singleton-group ranks participate and would hang.\n+            return first_metadata\n+\n+        strategy = FullyParallelSaveStrategyWrapper(\n+            mock.Mock(),\n+            local_group,\n+            do_cache_distribution=cache_distribution,\n+            validate_access_integrity=validate_access_integrity,\n+        )\n+        try:\n+            with mock.patch.object(module, 'determine_global_metadata', count_validation):\n+                for iteration in (1, 2):\n+                    getattr(strategy, save_method)(state_dict(), Path(str(iteration)))\n+            per_rank_calls = [None] * Utils.world_size\n+            torch.distributed.all_gather_object(per_rank_calls, validation_calls)\n+            expected = 0 if not validate_access_integrity else (1 if cache_distribution else 2)\n+            assert per_rank_calls == [expected] * Utils.world_size\n+        finally:\n+            torch.distributed.destroy_process_group(local_group)\n+\n     @staticmethod\n     def get_sharded_state_dict():\n         return {",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a91d4ce46104663f882936329e83ed4b9a207e02/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_fully_parallel.py",
