      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/89d40fa27f2a7657c8fc547dc034a6a018d9e4ed/megatron%2Fcore%2Fssm%2Fgated_delta_net%2Fcommon.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fssm%2Fgated_delta_net%2Fcommon.py?ref=89d40fa27f2a7657c8fc547dc034a6a018d9e4ed",
      "deletions": 4,
      "filename": "megatron/core/ssm/gated_delta_net/common.py",
      "patch": "@@ -676,6 +676,29 @@ def _build_head_perm_for_split_sections(\n     return torch.cat(parts, dim=-1).view(-1)\n \n \n+@lru_cache(maxsize=8)\n+def _build_head_perm_and_inverse_for_split_sections(\n+    split_sections: tuple[int, ...], cp_size: int, device: torch.device\n+) -> tuple[torch.Tensor, torch.Tensor]:\n+    perm = _build_head_perm_for_split_sections(split_sections, cp_size, device)\n+    return perm, torch.argsort(perm)\n+\n+\n+class _PermuteAlongDim(torch.autograd.Function):\n+    \"\"\"``index_select`` by a permutation; backward gathers by the inverse, not scatter-add.\"\"\"\n+\n+    @staticmethod\n+    def forward(ctx, x, perm, inverse_perm, dim):\n+        ctx.dim = dim\n+        ctx.save_for_backward(inverse_perm)\n+        return x.index_select(dim, perm)\n+\n+    @staticmethod\n+    def backward(ctx, grad):\n+        (inverse_perm,) = ctx.saved_tensors\n+        return grad.index_select(ctx.dim, inverse_perm), None, None, None\n+\n+\n ####################\n # Context parallel utilities\n ####################\n@@ -879,10 +902,10 @@ def a2a_cp_to_hp(\n     \"\"\"\n     if cp_size > 1:\n         # Pre-permute head dim so a single unsectioned a2a is equivalent to per-section a2a.\n-        head_perm = _build_head_perm_for_split_sections(\n+        head_perm, head_perm_inv = _build_head_perm_and_inverse_for_split_sections(\n             in_proj_split_sections, cp_size, qkvzba.device\n         )\n-        qkvzba = qkvzba.index_select(-1, head_perm)\n+        qkvzba = _PermuteAlongDim.apply(qkvzba, head_perm, head_perm_inv, -1)\n \n     thd_cp_a2a_inv = None\n     if packed_seq_params is not None and packed_seq_params.qkv_format == 'thd':\n@@ -894,7 +917,7 @@ def a2a_cp_to_hp(\n             # is equivalent to per-sequence a2a.\n             # This also folds the ``_undo_attention_load_balancing`` step.\n             thd_cp_a2a_idx, thd_cp_a2a_inv = _build_thd_cp_a2a_perm(cu_seqlens_q, cp_size, seq_len)\n-            qkvzba = qkvzba.index_select(0, thd_cp_a2a_idx)\n+            qkvzba = _PermuteAlongDim.apply(qkvzba, thd_cp_a2a_idx, thd_cp_a2a_inv, 0)\n     else:\n         qkvzba = tensor_a2a_cp2hp(qkvzba, seq_dim=0, head_dim=-1, cp_group=cp_group)\n \n@@ -925,7 +948,11 @@ def a2a_hp_to_cp(\n     if packed_seq_params is not None and packed_seq_params.qkv_format == 'thd':\n         if cp_size > 1:\n             assert thd_cp_a2a_inv is not None\n-            norm_out = norm_out.index_select(0, thd_cp_a2a_inv)\n+            thd_cp_a2a_idx = torch.empty_like(thd_cp_a2a_inv)\n+            thd_cp_a2a_idx[thd_cp_a2a_inv] = torch.arange(\n+                thd_cp_a2a_inv.numel(), device=thd_cp_a2a_inv.device\n+            )\n+            norm_out = _PermuteAlongDim.apply(norm_out, thd_cp_a2a_inv, thd_cp_a2a_idx, 0)\n         norm_out = tensor_a2a_hp2cp(\n             norm_out, seq_dim=0, head_dim=-1, cp_group=cp_group, redo_attention_load_balancing=False\n         )",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/89d40fa27f2a7657c8fc547dc034a6a018d9e4ed/megatron%2Fcore%2Fssm%2Fgated_delta_net%2Fcommon.py",
      "sha": "e175841db6287a354b4587c5aa80c009ed593eb1",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/89d40fa27f2a7657c8fc547dc034a6a018d9e4ed/tests%2Funit_tests%2Fssm%2Ftest_gdn_permute_along_dim.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fssm%2Ftest_gdn_permute_along_dim.py?ref=89d40fa27f2a7657c8fc547dc034a6a018d9e4ed",
      "deletions": 0,
      "filename": "tests/unit_tests/ssm/test_gdn_permute_along_dim.py",
      "patch": "@@ -0,0 +1,44 @@\n+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.\n+\n+import pytest\n+import torch\n+\n+from megatron.core.ssm.gated_delta_net.common import (\n+    _build_head_perm_and_inverse_for_split_sections,\n+    _build_thd_cp_a2a_perm,\n+    _PermuteAlongDim,\n+)\n+\n+DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n+\n+\n+def _assert_matches_index_select(x, perm, inverse_perm, dim):\n+    reference_input = x.clone().requires_grad_(True)\n+    permuted_input = x.clone().requires_grad_(True)\n+    grad_output = torch.randn_like(x.index_select(dim, perm))\n+\n+    reference = reference_input.index_select(dim, perm)\n+    permuted = _PermuteAlongDim.apply(permuted_input, perm, inverse_perm, dim)\n+    reference.backward(grad_output)\n+    permuted.backward(grad_output)\n+\n+    assert torch.equal(permuted, reference)\n+    assert torch.equal(permuted_input.grad, reference_input.grad)\n+\n+\n+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])\n+def test_head_perm_matches_index_select(dtype):\n+    perm, inverse_perm = _build_head_perm_and_inverse_for_split_sections(\n+        (64, 64, 32, 8), 4, torch.device(DEVICE)\n+    )\n+    x = torch.randn(96, 2, perm.numel(), device=DEVICE, dtype=dtype)\n+    _assert_matches_index_select(x, perm, inverse_perm, -1)\n+\n+\n+@pytest.mark.parametrize(\"dtype\", [torch.float32, torch.bfloat16])\n+def test_thd_cp_perm_matches_index_select(dtype):\n+    cu_seqlens = torch.tensor([0, 64, 192, 256], device=DEVICE, dtype=torch.int32)\n+    idx, inv = _build_thd_cp_a2a_perm(cu_seqlens, 4, int(cu_seqlens[-1]))\n+    x = torch.randn(idx.numel(), 1, 48, device=DEVICE, dtype=dtype)\n+    _assert_matches_index_select(x, idx, inv, 0)\n+    _assert_matches_index_select(x, inv, idx, 0)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/89d40fa27f2a7657c8fc547dc034a6a018d9e4ed/tests%2Funit_tests%2Fssm%2Ftest_gdn_permute_along_dim.py",
      "sha": "35725542c8c3940c7f6263b1d01dad088d9bc0f4",
      "status": "added"
    }
