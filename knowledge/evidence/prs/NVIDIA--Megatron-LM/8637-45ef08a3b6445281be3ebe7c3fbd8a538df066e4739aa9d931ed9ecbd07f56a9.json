      "changes": 5,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fmodule_utils.py?ref=38b8ab8fe5a534bd5c9af11e8b2c0eea9d653c89",
      "deletions": 0,
      "filename": "megatron/core/distributed/fsdp/src/megatron_fsdp/experimental/module_utils.py",
      "patch": "@@ -37,11 +37,16 @@ def get_parameter_owner(root_module: nn.Module, parameter_fqn: str) -> tuple[nn.\n #   weights. The Muon optimizer needs to exclude these weights.\n # - is_wide_residual_retention_parameter enforces weight decay, which is disabled\n #   by default for 1-D parameters (see megatron.core.optimizer.get_standard_config_overrides).\n+# - skip_backward_post_hook is Transformer Engine's delayed-wgrad marker: those weights\n+#   receive gradients from backward_dw(), so FsdpModule must register wgrad hooks rather\n+#   than AccumulateGrad hooks. Losing it during meta materialization makes the gradient\n+#   countdown complete before backward_dw() runs.\n _PARAMETER_ATTRIBUTES_TO_PRESERVE = (\n     \"is_embedding_or_output_parameter\",\n     \"is_embedding_parameter\",\n     \"use_muon\",\n     \"is_wide_residual_retention_parameter\",\n+    \"skip_backward_post_hook\",\n )\n \n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/38b8ab8fe5a534bd5c9af11e8b2c0eea9d653c89/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fmodule_utils.py",
      "sha": "9e78745d0169e585fc20d45795880fc5893289e8",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/38b8ab8fe5a534bd5c9af11e8b2c0eea9d653c89/tests%2Funit_tests%2Fdistributed%2Fmfsdp_v2%2Ftest_mcore_dense.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdistributed%2Fmfsdp_v2%2Ftest_mcore_dense.py?ref=38b8ab8fe5a534bd5c9af11e8b2c0eea9d653c89",
      "deletions": 7,
      "filename": "tests/unit_tests/distributed/mfsdp_v2/test_mcore_dense.py",
      "patch": "@@ -373,27 +373,45 @@ def forward():\n         graph.replay()\n \n \n-def test_delayed_wgrad_matches_immediate(process_group_collection, distributed_setup):\n+@pytest.mark.parametrize(\"init_model_with_meta_device\", [False, True], ids=[\"cuda\", \"meta\"])\n+def test_delayed_wgrad_matches_immediate(\n+    process_group_collection, distributed_setup, init_model_with_meta_device\n+):\n     \"\"\"Delaying weight gradients preserves training losses with microbatch accumulation.\"\"\"\n     num_microbatches = 3\n     config = TransformerConfig(\n-        num_layers=1, hidden_size=16, num_attention_heads=4, bf16=True, params_dtype=torch.bfloat16\n+        num_layers=1,\n+        hidden_size=16,\n+        num_attention_heads=4,\n+        bf16=True,\n+        params_dtype=torch.bfloat16,\n+        init_model_with_meta_device=init_model_with_meta_device,\n     )\n+    # Every rank initializes both layers with the same weights, also when the adapter\n+    # materializes the delayed layer from the meta device.\n+    initial_weight = torch.randn(16, 16, generator=torch.Generator().manual_seed(0))\n+\n+    @torch.no_grad()\n+    def init_method(weight):\n+        weight.copy_(initial_weight)\n \n-    def build_layer(delay_wgrad_compute):\n+    def build_layer(delay_wgrad_compute, device):\n         return te.Linear(\n             16,\n             16,\n             bias=False,\n+            init_method=init_method,\n             params_dtype=config.params_dtype,\n-            device=distributed_setup.device,\n+            device=device,\n             delay_wgrad_compute=delay_wgrad_compute,\n             fuse_wgrad_accumulation=False,\n         )\n \n-    immediate_layer = build_layer(delay_wgrad_compute=False)\n-    delayed_layer = build_layer(delay_wgrad_compute=True)\n-    delayed_layer.load_state_dict(immediate_layer.state_dict())\n+    immediate_layer = build_layer(delay_wgrad_compute=False, device=distributed_setup.device)\n+    delayed_layer = build_layer(\n+        delay_wgrad_compute=True,\n+        device=\"meta\" if init_model_with_meta_device else distributed_setup.device,\n+    )\n     # Both runs see the same inputs, with distinct data on each rank and microbatch.\n     batches = [\n         [",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/38b8ab8fe5a534bd5c9af11e8b2c0eea9d653c89/tests%2Funit_tests%2Fdistributed%2Fmfsdp_v2%2Ftest_mcore_dense.py",
      "sha": "7ad6ca385b780787a17dfeae586dd772c9e9d60e",
