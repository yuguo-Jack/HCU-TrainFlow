      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/docker%2FDockerfile.ci.dev?ref=6a2b3b40db688dab55772e08e083a378e5d6cf08",
      "deletions": 0,
      "filename": "docker/Dockerfile.ci.dev",
      "patch": "@@ -121,6 +121,10 @@ COPY megatron/core/package_info.py /workspace/megatron/core/\n ARG IMAGE_TYPE=dev\n ENV IMAGE_TYPE=${IMAGE_TYPE}\n ENV NVTE_BUILD_NUM_PHILOX_ROUNDS=3\n+# cuDNN Frontend is replaced after the sync below with this ref of NVIDIA/cudnn-frontend\n+# (feat/1.29.0-megatron). Docker-only: outside pyproject.toml and uv.lock. Set empty to keep the\n+# locked PyPI wheel. Skipped for the LTS image.\n+ARG CUDNN_FRONTEND_GIT_REF=8924d4b41fd678ba1b98cd7f98bb78b222637573\n # Preserve Ampere support unless a caller selects narrower TE build targets.\n ARG NVTE_CUDA_ARCHS=\"80;90;100\"\n # TE compiles each source's GPU targets one after another by default (nvcc --threads 1), so\n@@ -209,6 +213,10 @@ RUN --mount=type=cache,id=uv-${TARGETARCH}-${NVTE_CUDA_ARCHS},target=/root/.cach\n     rm -rf \"${MAMBA_BUILD_DIR}\"\n     trap - EXIT\n \n+    if [ -n \"$CUDNN_FRONTEND_GIT_REF\" ] && [ \"$IMAGE_TYPE\" != \"lts\" ]; then\n+        uv pip install --no-deps --reinstall \\\n+            \"nvidia-cudnn-frontend @ git+https://github.com/NVIDIA/cudnn-frontend.git@${CUDNN_FRONTEND_GIT_REF}\"\n+    fi\n EOF\n \n # Reuse the wheel without copying a second archive into the final image.",
