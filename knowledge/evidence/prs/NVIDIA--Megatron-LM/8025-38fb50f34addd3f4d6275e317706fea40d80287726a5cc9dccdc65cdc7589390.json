      "additions": 1,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/2bc5176cb416c9c5cf0b62ae19f909a42a01053a/megatron%2Fcore%2Fmodels%2Fmultimodal%2Fllava_model.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fmodels%2Fmultimodal%2Fllava_model.py?ref=2bc5176cb416c9c5cf0b62ae19f909a42a01053a",
      "deletions": 1,
      "filename": "megatron/core/models/multimodal/llava_model.py",
      "patch": "@@ -1169,7 +1169,7 @@ def _process_embedding_token_parallel(\n \n         if self.sequence_parallel_lm and self.pre_process:\n             combined_embeddings = tensor_parallel.scatter_to_sequence_parallel_region(\n-                combined_embeddings\n+                combined_embeddings, group=self.pg_collection.tp\n             )  # [S/(CP*TP),B,H]\n \n         return combined_embeddings, expanded_labels, expanded_loss_mask, packed_seq_params",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/2bc5176cb416c9c5cf0b62ae19f909a42a01053a/megatron%2Fcore%2Fmodels%2Fmultimodal%2Fllava_model.py",
