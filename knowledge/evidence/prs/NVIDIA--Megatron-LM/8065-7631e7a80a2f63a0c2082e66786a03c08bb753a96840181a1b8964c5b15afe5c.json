  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/5a588638c96a52d524a12d138ca6a46e68f37cbd/tools%2Fcheck_copyright.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tools%2Fcheck_copyright.py?ref=5a588638c96a52d524a12d138ca6a46e68f37cbd",
      "deletions": 0,
      "filename": "tools/check_copyright.py",
      "patch": "@@ -17,6 +17,9 @@ def has_correct_header(file_path):\n         with open(file_path, 'r', encoding='utf-8') as f:\n             content = f.read()\n \n+        # Executable scripts keep their shebang as the first line.\n+        if content.startswith('#!'):\n+            content = content.partition('\\n')[2]\n         # Check if the expected header is at the start of the file\n         return content.startswith(EXPECTED_HEADER.format(str(datetime.now().year)))\n     except Exception as e:",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5a588638c96a52d524a12d138ca6a46e68f37cbd/tools%2Fcheck_copyright.py",
      "sha": "0acaeafffed3e1885a03ab77444ac8795c35b2d3",
      "status": "modified"
    },
    {
      "additions": 26,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/5a588638c96a52d524a12d138ca6a46e68f37cbd/tools%2Ftest_copyright_shebang.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tools%2Ftest_copyright_shebang.py?ref=5a588638c96a52d524a12d138ca6a46e68f37cbd",
      "deletions": 0,
      "filename": "tools/test_copyright_shebang.py",
      "patch": "@@ -0,0 +1,26 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+import tempfile\n+import unittest\n+from datetime import datetime\n+from pathlib import Path\n+\n+import check_copyright\n+\n+\n+class TestCopyright(unittest.TestCase):\n+    def test_header_can_follow_a_shebang(self):\n+        header = check_copyright.EXPECTED_HEADER.format(datetime.now().year)\n+        with tempfile.TemporaryDirectory() as tmp:\n+            path = Path(tmp) / 'script.py'\n+            for prefix, expected in [\n+                ('#!/usr/bin/env python3\\n', True),\n+                ('', True),\n+                ('print(1)\\n', False),\n+            ]:\n+                with self.subTest(prefix=prefix):\n+                    path.write_text(prefix + header + '\\n', encoding='utf-8')\n+                    self.assertEqual(check_copyright.has_correct_header(path), expected)\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5a588638c96a52d524a12d138ca6a46e68f37cbd/tools%2Ftest_copyright_shebang.py",
      "sha": "5318568dd056ef26e38ec24c15c5615b322dc812",
      "status": "added"
    }
