      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/2f23f6610e54f690b6748ce4f2eb0dbfafde82f6/tests%2Ftest_utils%2Fpython_scripts%2Fdownload_coverage_results.py",
