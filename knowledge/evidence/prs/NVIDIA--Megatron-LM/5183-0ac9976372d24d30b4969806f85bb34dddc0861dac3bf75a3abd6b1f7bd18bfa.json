      "additions": 10,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/69ca4b46e2a205e9a80540a9d28afb4533bac0b5/tests%2Funit_tests%2Felastification%2Ftest_hybrid_flex_router.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Felastification%2Ftest_hybrid_flex_router.py?ref=69ca4b46e2a205e9a80540a9d28afb4533bac0b5",
      "deletions": 9,
      "filename": "tests/unit_tests/elastification/test_hybrid_flex_router.py",
      "patch": "@@ -10,6 +10,7 @@\n     torchrun --nproc_per_node=1 -m pytest tests/unit_tests/elastification/test_hybrid_flex_router.py\n \"\"\"\n \n+import random\n from argparse import Namespace\n \n import pytest\n@@ -157,16 +158,9 @@ def test_emb_output_shape_matches_choice_count(self):\n         assert logits.numel() == len(config.emb_int_list)\n         assert choice in config.emb_int_list\n \n-    @pytest.mark.flaky_in_dev\n     def test_gumbel_determinism(self):\n         \"\"\"Two routers at the same config + iteration + fwd_pass_count should\n         produce identical Gumbel-softmax samples.\n-\n-        Quarantined as flaky_in_dev (#5155): ``FlextronRouter.forward`` draws\n-        ``hard_sample`` from Python's un-seeded global ``random``, which is not\n-        covered by the Gumbel ``torch.manual_seed``, so the two routers\n-        intermittently disagree on the hard/soft branch and the bit-exact\n-        ``assert_close`` fails.\n         \"\"\"\n         config = _router_config()\n         config.curr_iteration = 0\n@@ -177,8 +171,15 @@ def test_gumbel_determinism(self):\n         # determinism check is about the Gumbel RNG, not init noise.\n         router_b.load_state_dict(router_a.state_dict())\n \n-        out_a = router_a(1.0)\n-        out_b = router_b(1.0)\n+        random_state = random.getstate()\n+        try:\n+            # forward() samples hard_sample from Python random outside the torch-seeded Gumbel path.\n+            random.seed(0)\n+            out_a = router_a(1.0)\n+            random.seed(0)\n+            out_b = router_b(1.0)\n+        finally:\n+            random.setstate(random_state)\n         for axis_a, axis_b in zip(out_a, out_b):\n             if axis_a is None:\n                 assert axis_b is None",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/69ca4b46e2a205e9a80540a9d28afb4533bac0b5/tests%2Funit_tests%2Felastification%2Ftest_hybrid_flex_router.py",
      "sha": "d825eb05e4fd4fdb9bd8ad6bd4b8406eda4e228d",
      "status": "modified"
    }
