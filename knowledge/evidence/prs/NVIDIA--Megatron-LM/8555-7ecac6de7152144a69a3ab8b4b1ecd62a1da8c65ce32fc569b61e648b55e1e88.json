      "changes": 10,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fcuda_graphs.py?ref=5df3661919c5119830d089fb6f8aa0cc5e0d14d8",
      "deletions": 0,
      "filename": "megatron/core/transformer/cuda_graphs.py",
      "patch": "@@ -2468,6 +2468,16 @@ def get_rotary_pos_emb(transformer_module, transformer_input):\n                         uses_mla = False\n                     elif config_type in (MLALayerConfig, DSALayerConfig, CSALayerConfig):\n                         uses_mla = True\n+                if transformer_module.position_embedding_type == 'mrope' and not uses_mla:\n+                    # Capture the tensor input; replay provides the actual position embeddings.\n+                    position_ids = torch.zeros(\n+                        (3, self.micro_batch_size, self.seq_length),\n+                        device=transformer_input.device,\n+                        dtype=torch.long,\n+                    )\n+                    return transformer_module.rotary_pos_emb(\n+                        position_ids, transformer_module.mrope_section\n+                    )\n                 if transformer_module.position_embedding_type == 'rope' and not uses_mla:\n                     rotary_seq_len = transformer_module.rotary_pos_emb.get_rotary_seq_len(\n                         None, transformer_module.decoder, transformer_input, self.config, None",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5df3661919c5119830d089fb6f8aa0cc5e0d14d8/megatron%2Fcore%2Ftransformer%2Fcuda_graphs.py",
      "sha": "4f65ed6abdb1bf5329da77463771b3d25ed9baea",
      "status": "modified"
    },
    {
      "additions": 66,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/5df3661919c5119830d089fb6f8aa0cc5e0d14d8/tests%2Funit_tests%2Ftransformer%2Ftest_cuda_graphs.py",
      "changes": 66,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftransformer%2Ftest_cuda_graphs.py?ref=5df3661919c5119830d089fb6f8aa0cc5e0d14d8",
      "deletions": 0,
      "filename": "tests/unit_tests/transformer/test_cuda_graphs.py",
      "patch": "@@ -1257,6 +1257,72 @@ def teardown_method(self, method):\n         # Note: _unique_buffer_counts is intentionally NOT cleared here so we can\n         # compare values across parametrized test runs\n \n+    def test_mrope_replay_uses_current_positions(self):\n+        \"\"\"Graph replay must preserve position-dependent mRoPE forward and gradients.\"\"\"\n+        Utils.initialize_model_parallel()\n+        init_num_microbatches_calculator(\n+            rank=0,\n+            global_batch_size=1,\n+            micro_batch_size=1,\n+            data_parallel_size=1,\n+            decrease_batch_size_if_needed=False,\n+        )\n+        config = TransformerConfig(\n+            num_layers=2,\n+            hidden_size=64,\n+            num_attention_heads=4,\n+            bf16=True,\n+            params_dtype=torch.bfloat16,\n+            attention_dropout=0.0,\n+            hidden_dropout=0.0,\n+            cuda_graph_impl=\"transformer_engine\",\n+            use_te_rng_tracker=True,\n+            mrope_section=[2, 3, 3],\n+        )\n+        torch.manual_seed(123)\n+        model_parallel_cuda_manual_seed(123)\n+        current_stream = torch.cuda.current_stream()\n+        init_stream = torch.cuda.Stream()\n+        init_stream.wait_stream(current_stream)\n+        with torch.cuda.stream(init_stream):\n+            raw_model = GPTModel(\n+                config=config,\n+                transformer_layer_spec=get_gpt_layer_with_transformer_engine_spec(),\n+                vocab_size=128,\n+                max_sequence_length=128,\n+                position_embedding_type=\"mrope\",\n+            ).cuda()\n+            model = DistributedDataParallel(\n+                config, DistributedDataParallelConfig(grad_reduce_in_fp32=True), raw_model\n+            )\n+        current_stream.wait_stream(init_stream)\n+        tokens = torch.arange(128, device=\"cuda\").unsqueeze(0)\n+        positions = tokens.unsqueeze(0).expand(3, -1, -1).contiguous()\n+        shifted = positions * torch.tensor([1, 2, 3], device=\"cuda\").view(3, 1, 1)\n+\n+        def train_step(position_ids):\n+            model.zero_grad_buffer()\n+            model.set_is_first_microbatch()\n+            losses = model(tokens, position_ids, None, labels=tokens)\n+            losses.mean().backward()\n+            model.finish_grad_sync()\n+            return losses.detach().clone(), [p.main_grad.clone() for p in model.parameters()]\n+\n+        eager = [train_step(position_ids) for position_ids in (positions, shifted)]\n+        assert not torch.equal(eager[0][0], eager[1][0])\n+        helper = TECudaGraphHelper(\n+            model=[model], config=config, seq_length=128, micro_batch_size=1, optimizers=[]\n+        )\n+        try:\n+            helper.create_cudagraphs()\n+            assert helper.graphs_created()\n+            replay = [train_step(position_ids) for position_ids in (positions, shifted)]\n+            for expected, actual in zip(eager, replay):\n+                torch.testing.assert_close(actual, expected, rtol=1e-5, atol=1e-6)\n+        finally:\n+            if helper.graphs_created():\n+                helper.delete_cuda_graphs()\n+\n     @pytest.mark.parametrize(\"num_microbatches\", [16, 64, 256])\n     @pytest.mark.parametrize(\"pp_size\", [1, 2, 4])\n     @pytest.mark.parametrize(\"vpp_size\", [None, 2])",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/5df3661919c5119830d089fb6f8aa0cc5e0d14d8/tests%2Funit_tests%2Ftransformer%2Ftest_cuda_graphs.py",
      "sha": "c31ee17f645cc43a3b512c6bb127bc75edab8810",
      "status": "modified"
    }
