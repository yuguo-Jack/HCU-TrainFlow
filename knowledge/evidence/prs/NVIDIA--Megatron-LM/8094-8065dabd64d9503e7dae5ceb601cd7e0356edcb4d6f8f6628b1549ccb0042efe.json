      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ftest_utils%2Fpython_scripts%2Fdownload_golden_values.py?ref=2ea586f36e2ae03671020dbb53ca51cd6076b85a",
      "deletions": 1,
      "filename": "tests/test_utils/python_scripts/download_golden_values.py",
      "patch": "@@ -243,7 +243,7 @@ def _create_job_name_map(cicd_jobs: list) -> dict:\n \n def _match_artifact_to_job(artifact: dict, workflow_id: int, job_name_map: dict) -> dict:\n     \"\"\"Match an artifact to a job from the job name map.\"\"\"\n-    artifact_job_name = artifact[\"name\"].lower().replace(\"logs-\", \"\").split(f\"-{workflow_id}\")[0]\n+    artifact_job_name = artifact[\"name\"].lower().removeprefix(\"logs-\").split(f\"-{workflow_id}\")[0]\n     for normalized_job_name, job in job_name_map.items():\n         if normalized_job_name == artifact_job_name:\n             logger.info(\"Artifact '%s' matched to job '%s'\", artifact[\"name\"], job[\"name\"])",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/2ea586f36e2ae03671020dbb53ca51cd6076b85a/tests%2Ftest_utils%2Fpython_scripts%2Fdownload_golden_values.py",
      "sha": "b04339e992d69df27c2e4bf533a03e038f48921e",
      "status": "modified"
    },
    {
      "additions": 21,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/2ea586f36e2ae03671020dbb53ca51cd6076b85a/tests%2Ftest_utils%2Fpython_scripts%2Ftest_golden_artifact_prefix.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ftest_utils%2Fpython_scripts%2Ftest_golden_artifact_prefix.py?ref=2ea586f36e2ae03671020dbb53ca51cd6076b85a",
      "deletions": 0,
      "filename": "tests/test_utils/python_scripts/test_golden_artifact_prefix.py",
      "patch": "@@ -0,0 +1,21 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+\n+import unittest\n+\n+from tests.test_utils.python_scripts import download_golden_values\n+\n+\n+class TestGoldenArtifactPrefix(unittest.TestCase):\n+    def test_preserves_logs_inside_the_test_case_name(self):\n+        for test_name in ('logs-resume', 'restore-logs-state', 'ordinary-test'):\n+            with self.subTest(test_name=test_name):\n+                job = {'id': 1, 'name': 'gpt/' + test_name}\n+                artifact = {'name': f'logs-{test_name}-123-uuid'}\n+                self.assertIs(\n+                    download_golden_values._match_artifact_to_job(artifact, 123, {test_name: job}),\n+                    job,\n+                )\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/2ea586f36e2ae03671020dbb53ca51cd6076b85a/tests%2Ftest_utils%2Fpython_scripts%2Ftest_golden_artifact_prefix.py",
      "sha": "f4b6d6c9a091ba6cb95ff857294807453d7853d2",
      "status": "added"
    }
  ],
