      "changes": 6,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Foptimizer%2Fdistrib_optimizer.py?ref=3c08784b5cd243c1ccf1fc5eb26c32d050b199d7",
      "deletions": 1,
      "filename": "megatron/core/optimizer/distrib_optimizer.py",
      "patch": "@@ -1139,7 +1139,7 @@ def make_needed_groups(param_group):\n \n             for s in state_dict_state.values():\n                 # Native PyTorch state dict requires step (i.e., iteration).\n-                s[\"step\"] = step\n+                s[\"step\"] = step.detach().clone()\n         elif isinstance(self.optimizer, HybridDeviceOptimizer):\n             # Handle Torch AdamW special case, which, unlike FusedAdam, Torch AdamW\n             # has an extra optimizer state \"step\".\n@@ -1334,6 +1334,10 @@ def _set_main_param_and_optimizer_states(self, model_param, tensors):\n                 if isinstance(v, torch.Tensor):\n                     dst_tensors[k] = v\n             for key in dst_tensors:\n+                if not HAVE_APEX_OR_TE and key == \"step\":\n+                    # Native Adam restores this scalar from param_groups. DP-reshardable\n+                    # templates carry a local, nonpersistent step that must not overwrite it.\n+                    continue\n                 if not isinstance(tensors[key], torch.Tensor):\n                     continue\n                 dst_tensors[key].copy_(tensors[key])",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/3c08784b5cd243c1ccf1fc5eb26c32d050b199d7/megatron%2Fcore%2Foptimizer%2Fdistrib_optimizer.py",
      "sha": "e44462f615c3d03ab6cb757ce2689ffac8430dbf",
