      "filename": "megatron/core/datasets/indexed_dataset.py",
      "patch": "@@ -906,7 +906,7 @@ def sequence_modes(self) -> numpy.ndarray:\n         Returns:\n             numpy.ndarray: The sequence modes\n         \"\"\"\n-        assert self.index.sequence_modes\n+        assert self.index.sequence_modes is not None\n         return self.index.sequence_modes\n \n     @staticmethod",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/c10a2fda2e043e9937c853e10c536ec8695827c6/megatron%2Fcore%2Fdatasets%2Findexed_dataset.py",
