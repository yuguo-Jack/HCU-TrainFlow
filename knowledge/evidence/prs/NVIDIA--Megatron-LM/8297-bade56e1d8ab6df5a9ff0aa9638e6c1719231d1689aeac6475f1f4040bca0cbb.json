  "files": [
    {
      "additions": 8,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/d3d3e71e39e0094f1825b56fb38db891a9f838d8/megatron%2Fcore%2Ftransformer%2Fmoe%2Ftoken_dispatcher.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fmoe%2Ftoken_dispatcher.py?ref=d3d3e71e39e0094f1825b56fb38db891a9f838d8",
      "deletions": 1,
      "filename": "megatron/core/transformer/moe/token_dispatcher.py",
      "patch": "@@ -884,7 +884,8 @@ def combine_postprocess(self, permutated_local_input_tokens):\n \n         This method un-permutes the tokens back to their original order,\n         reshapes the tensor to its original shape, and adds the shared\n-        expert output if enabled.\n+        expert output if enabled. It then releases the router probabilities\n+        stored by `dispatch_preprocess`, which this forward no longer needs.\n \n         Args:\n             permutated_local_input_tokens (torch.Tensor): Permuted hidden states from token combine.\n@@ -911,6 +912,12 @@ def combine_postprocess(self, permutated_local_input_tokens):\n         if self.shared_experts is not None:\n             shared_expert_output = self.shared_experts.get_output()\n             output += shared_expert_output\n+\n+        # Drop the reference to the router probs stored in `dispatch_preprocess`. Only this\n+        # forward reads them (in `combine_preprocess`); kept until the next forward through the\n+        # layer, they pin this forward's autograd graph. Under full activation recompute that is\n+        # every MoE layer's recomputed graph for the rest of the backward pass.\n+        self.probs = None\n         return output\n \n     def _maybe_update_cuda_sync_point(self, point: str):",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/d3d3e71e39e0094f1825b56fb38db891a9f838d8/megatron%2Fcore%2Ftransformer%2Fmoe%2Ftoken_dispatcher.py",
      "sha": "3eb880d4b2ff8841bd8b1489596a714493090f73",
      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/d3d3e71e39e0094f1825b56fb38db891a9f838d8/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_token_dispatcher.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_token_dispatcher.py?ref=d3d3e71e39e0094f1825b56fb38db891a9f838d8",
      "deletions": 0,
      "filename": "tests/unit_tests/transformer/moe/test_token_dispatcher.py",
      "patch": "@@ -1,6 +1,7 @@\n # Copyright (c) 2023, NVIDIA CORPORATION. All rights reserved.\n \n import dataclasses\n+import weakref\n from types import SimpleNamespace\n \n import pytest\n@@ -26,6 +27,7 @@\n from megatron.core.transformer.moe.moe_layer import MoELayer, MoESubmodules\n from megatron.core.transformer.moe.moe_utils import get_capacity, pad_routing_map\n from megatron.core.transformer.moe.token_dispatcher import (\n+    MoEAlltoAllTokenDispatcher,\n     MoEFlexTokenDispatcher,\n     _DeepepManager,\n     _HybridEPManager,\n@@ -699,6 +701,37 @@ def dispatch_preprocess(self, hidden_states, routing_map, probs):\n         assert calls == [\"no-mask\"]\n \n \n+def test_alltoall_combine_postprocess_releases_router_probs():\n+    \"\"\"combine_postprocess drops the dispatcher's reference to the router probs, so their\n+    autograd graph is not kept alive until the next forward (under full recompute, through\n+    the rest of backward). The combined output is unchanged.\"\"\"\n+    dispatcher = object.__new__(MoEAlltoAllTokenDispatcher)\n+    dispatcher.config = SimpleNamespace(moe_permute_fusion=False)\n+    dispatcher.drop_and_pad = False\n+    dispatcher.batch_invariant_inverse_permutation_mapping = None\n+    dispatcher.shared_experts = None\n+    num_tokens, hidden, topk, num_experts = 3, 4, 2, 2\n+    dispatcher.hidden_shape = torch.Size([num_tokens, 1, hidden])\n+    dispatcher.hidden_shape_before_permute = torch.Size([num_tokens, hidden])\n+    dispatcher.routing_map = torch.ones(num_tokens, num_experts, dtype=torch.bool)\n+    # Permuted rows are grouped by expert: expert 0 gets tokens [0, 1, 2], then expert 1.\n+    dispatcher.reversed_local_input_permutation_mapping = torch.tensor([0, 1, 2, 0, 1, 2])\n+\n+    logits = torch.randn(num_tokens, num_experts, requires_grad=True)\n+    probs = torch.softmax(logits, dim=-1)  # non-leaf, carries the router's grad_fn\n+    probs_ref = weakref.ref(probs)\n+    dispatcher.probs = probs\n+    del probs\n+\n+    permuted = torch.arange(num_tokens * topk * hidden, dtype=torch.float32).view(-1, hidden)\n+    output = dispatcher.combine_postprocess(permuted)\n+\n+    expected = (permuted[:num_tokens] + permuted[num_tokens:]).view(num_tokens, 1, hidden)\n+    torch.testing.assert_close(output, expected)\n+    assert dispatcher.probs is None\n+    assert probs_ref() is None, \"the router probs (and their graph) are still referenced\"\n+\n+\n def test_hybridep_dropless_excludes_padding_rows(monkeypatch):\n     \"\"\"Dropless HybridEP drops padded tokens in the dispatcher (the router keeps them routed):\n     padding rows lose their routes and weights, valid rows are untouched. The mask arrives",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/d3d3e71e39e0094f1825b56fb38db891a9f838d8/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_token_dispatcher.py",
      "sha": "e8c71872ee8605e7a399ff564464db029c17f35f",
      "status": "modified"
    }
