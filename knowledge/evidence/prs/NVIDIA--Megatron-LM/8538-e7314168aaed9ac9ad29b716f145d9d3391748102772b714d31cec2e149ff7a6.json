      "deletions": 1,
      "filename": "megatron/core/distributed/finalize_model_grads.py",
      "patch": "@@ -540,7 +540,8 @@ def _allreduce_non_tensor_model_parallel_grads(\n                         grad = _unshard_if_dtensor(grad)\n                         grads_avg.append(grad.data)\n                 # Check if this param needs sum reduction (sequence parallel or qk_layernorm)\n-                elif (config.sequence_parallel and getattr(param, \"sequence_parallel\", False)) or (\n+                # Submodules may enable SP independently of the root model config.\n+                elif getattr(param, \"sequence_parallel\", False) or (\n                     config.qk_layernorm and (\"q_layernorm\" in name or \"k_layernorm\" in name)\n                 ):\n                     grad_attr = _get_main_grad_attr(param)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/8c3106ca33d4a1b6d7bc09098221cd29be1cf68f/megatron%2Fcore%2Fdistributed%2Ffinalize_model_grads.py",
