      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fcontext.py?ref=581479ce4a415ddfed0737327cdd0e22eb3d2002",
      "deletions": 2,
      "filename": "megatron/core/distributed/fsdp/src/megatron_fsdp/experimental/context.py",
      "patch": "@@ -31,6 +31,7 @@ class FsdpContext:\n \n     allgather_stream: torch.cuda.Stream\n     reduce_scatter_stream: torch.cuda.Stream\n+    outer_reduce_scatter_stream: torch.cuda.Stream\n     # HFSDP/HSDP need explicit last-microbatch state. First-microbatch state is\n     # unnecessary because each parameter group tracks whether model_weight is stale\n     # after syncing from main_weight.\n@@ -72,8 +73,9 @@ def __init__(\n                 the current CUDA device.\n             use_symmetric_memory: Whether modules constructed in this context allocate\n                 communication staging buffers from PyTorch's NCCL symmetric-memory pool.\n-            unify_communication_stream: Whether all-gathers and reduce-scatters share one\n-                communication stream to reduce peak transient memory. See\n+            unify_communication_stream: Whether all-gathers and inner reduce-scatters share\n+                one communication stream to reduce peak transient memory. Outer reductions\n+                use a separate stream. See\n                 https://github.com/NVIDIA/Megatron-LM/issues/6471.\n             parameter_to_owner: Construction-time owner assignments for TensorAtomic\n                 parameters, keyed by the original parameters before sharding. Owners are\n@@ -116,6 +118,7 @@ def __init__(\n             self.reduce_scatter_stream = self.allgather_stream\n         else:\n             self.reduce_scatter_stream = torch.cuda.Stream(device)\n+        self.outer_reduce_scatter_stream = torch.cuda.Stream(device)\n \n     def __enter__(self) -> \"FsdpContext\":\n         \"\"\"Activate this context for FSDP module construction.\"\"\"\n@@ -211,6 +214,7 @@ def finish_grad_sync(self) -> None:\n         it does not block the CPU or wait for reductions that have not yet been launched.\n         \"\"\"\n         self.current_stream().wait_stream(self.reduce_scatter_stream)\n+        self.current_stream().wait_stream(self.outer_reduce_scatter_stream)\n \n     def post_backward(self) -> None:\n         \"\"\"Finish backward cleanup and automatically synchronize the last microbatch.\"\"\"",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/581479ce4a415ddfed0737327cdd0e22eb3d2002/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fcontext.py",
      "sha": "85c43c3de53e75596508a9c70b4caf7d1074c557",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/581479ce4a415ddfed0737327cdd0e22eb3d2002/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fmodule.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fmodule.py?ref=581479ce4a415ddfed0737327cdd0e22eb3d2002",
      "deletions": 0,
      "filename": "megatron/core/distributed/fsdp/src/megatron_fsdp/experimental/module.py",
      "patch": "@@ -432,6 +432,8 @@ def pre_backward(self) -> None:\n             # illegal during capture. Later modules are covered by the post-copy\n             # fork each preceding module issues before its collective.\n             context.reduce_scatter_stream.wait_stream(current_stream)\n+            # finish_grad_sync() joins outer RS even when this backward has no outer work.\n+            context.outer_reduce_scatter_stream.wait_stream(current_stream)\n \n         self.unshard(prefetch=\"backward\")\n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/581479ce4a415ddfed0737327cdd0e22eb3d2002/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fmodule.py",
