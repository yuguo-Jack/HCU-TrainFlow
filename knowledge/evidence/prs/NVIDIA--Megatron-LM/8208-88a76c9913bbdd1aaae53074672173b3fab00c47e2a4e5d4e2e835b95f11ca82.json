  "files": [
    {
      "additions": 26,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/2c1c4994eacbe8ce2aea49595604cd5c7a86643b/docker%2FDockerfile.ci.dev",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/docker%2FDockerfile.ci.dev?ref=2c1c4994eacbe8ce2aea49595604cd5c7a86643b",
      "deletions": 0,
      "filename": "docker/Dockerfile.ci.dev",
      "patch": "@@ -88,6 +88,32 @@ RUN --mount=type=bind,source=docker/common/install_nccl.sh,target=/opt/install_n\n     esac\n EOF\n \n+ARG CUBLAS_VERSION=13.8.1.7\n+RUN bash -euxo pipefail <<\"EOF\"\n+    # cuBLAS 13.8.1 includes the grouped GEMM correctness fix.\n+    case \"${TARGETARCH}\" in\n+        amd64)\n+            CUBLAS_ARCH=x86_64\n+            ;;\n+        arm64)\n+            CUBLAS_ARCH=sbsa\n+            ;;\n+        *) echo \"Unsupported TARGETARCH for cuBLAS: ${TARGETARCH}\" >&2; exit 1 ;;\n+    esac\n+    CUBLAS_ARCHIVE=\"libcublas-linux-${CUBLAS_ARCH}-${CUBLAS_VERSION}_cuda13-archive\"\n+    CUBLAS_TMP=$(mktemp -d)\n+    curl -fLSs --retry 3 -o \"${CUBLAS_TMP}/cublas.tar.xz\" \\\n+        \"https://developer.download.nvidia.com/compute/cublas/redist/libcublas/linux-${CUBLAS_ARCH}/${CUBLAS_ARCHIVE}.tar.xz\"\n+    tar -xJf \"${CUBLAS_TMP}/cublas.tar.xz\" -C \"${CUBLAS_TMP}\"\n+    # Replace the toolkit copies so existing linker paths pick up both cuBLAS and cuBLASLt.\n+    CUDA_ROOT=\"${CUDA_HOME:-/usr/local/cuda}\"\n+    cp -a \"${CUBLAS_TMP}/${CUBLAS_ARCHIVE}/include/.\" \"${CUDA_ROOT}/include/\"\n+    cp -a \"${CUBLAS_TMP}/${CUBLAS_ARCHIVE}/lib/.\" \"${CUDA_ROOT}/lib64/\"\n+    install -Dm644 \"${CUBLAS_TMP}/${CUBLAS_ARCHIVE}/LICENSE\" \"${CUDA_ROOT}/doc/cublas/LICENSE\"\n+    ldconfig\n+    rm -rf \"${CUBLAS_TMP}\"\n+EOF\n+\n COPY pyproject.toml uv.lock /workspace/\n COPY docker/patches/mamba-cxx20.patch /workspace/mamba-cxx20.patch\n COPY megatron/core/__init__.py /workspace/megatron/core/",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/2c1c4994eacbe8ce2aea49595604cd5c7a86643b/docker%2FDockerfile.ci.dev",
      "sha": "d2aa7d26a50ae225cf2d31c276a796c83d82092e",
      "status": "modified"
    }
