      "deletions": 0,
      "filename": ".github/workflows/process-group-usage-check.yml",
      "patch": "@@ -52,5 +52,9 @@ jobs:\n         run: python tests/unit_tests/test_check_process_group_usage.py\n \n       # No third-party dependencies: the checker and its tests are stdlib-only.\n+      # Report-only: new reads are listed in the log but do not fail the job. Whether new code may\n+      # fall back to parallel_state is still to be decided, see\n+      # https://github.com/NVIDIA/Megatron-LM/issues/6307.\n       - name: Check for new global process-group reads in megatron/core\n+        continue-on-error: true\n         run: python tools/check_process_group_usage.py",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/152a08cca3ec5c43bec9f0d53655df11d21182a0/.github%2Fworkflows%2Fprocess-group-usage-check.yml",
