      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/e8ffb18cf28f4b173f63a724d8327cc2a0f5c2be/megatron%2Fcore%2Fresharding%2FREADME.md",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fresharding%2FREADME.md?ref=e8ffb18cf28f4b173f63a724d8327cc2a0f5c2be",
      "deletions": 1,
      "filename": "megatron/core/resharding/README.md",
      "patch": "@@ -292,7 +292,7 @@ attribute with the following groups:\n | Field | Required | Purpose |\n |-------|----------|---------|\n | `tp` | Yes | Tensor parallelism sharding |\n-| `dp` | Yes (auto-filled on source from `parallel_state` if missing) | Data parallelism routing |\n+| `dp` | Yes | Data parallelism routing |\n | `pp` | If PP > 1 | Pipeline stage / layer index remapping |\n | `ep` | If MoE | Expert parallelism routing |\n | `expt_tp` | If expert TP | Expert-specific tensor parallelism |",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/e8ffb18cf28f4b173f63a724d8327cc2a0f5c2be/megatron%2Fcore%2Fresharding%2FREADME.md",
