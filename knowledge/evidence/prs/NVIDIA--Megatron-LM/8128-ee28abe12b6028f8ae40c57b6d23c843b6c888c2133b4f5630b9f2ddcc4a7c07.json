      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/9f03a26ce7b5dc16af867d68eeb95cf3c828dcc2/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py?ref=9f03a26ce7b5dc16af867d68eeb95cf3c828dcc2",
      "deletions": 5,
      "filename": "megatron/core/transformer/moe/moe_utils.py",
      "patch": "@@ -1450,16 +1450,25 @@ def backward(\n             grad_input = te_general_gemm(\n                 weight.to(ctx.router_dtype), grad_output, ctx.router_dtype, layout=\"NN\", grad=True\n             )\n-            grad_weight = te_general_gemm(\n-                inp.to(ctx.router_dtype), grad_output, ctx.router_dtype, layout=\"NT\", grad=True\n-            )\n+            # With a bias, the wgrad GEMM's cuBLASLt BGRAD epilogue reduces grad_output over\n+            # its K dimension (the tokens) into the bias gradient, in place of a separate sum.\n+            grad_weight, grad_bias = te_general_gemm(\n+                inp.to(ctx.router_dtype),\n+                grad_output,\n+                ctx.router_dtype,\n+                layout=\"NT\",\n+                grad=True,\n+                bias=bias,\n+            )[:2]\n             grad_input = grad_input[0].to(ctx.input_dtype)\n-            grad_weight = grad_weight[0].to(ctx.weight_dtype)\n+            grad_weight = grad_weight.to(ctx.weight_dtype)\n+            if grad_bias is not None:\n+                grad_bias = grad_bias.to(ctx.weight_dtype)\n         else:\n             grad_input = torch.mm(grad_output, weight.to(ctx.router_dtype)).to(ctx.input_dtype)\n             grad_weight = torch.mm(grad_output.t(), inp.to(ctx.router_dtype)).to(ctx.weight_dtype)\n+            grad_bias = grad_output.sum(dim=0).to(ctx.weight_dtype) if bias is not None else None\n \n-        grad_bias = grad_output.sum(dim=0).to(ctx.weight_dtype) if bias is not None else None\n         grad_input = grad_input.view(*inp_shape)\n         return grad_input, grad_weight, grad_bias, None\n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/9f03a26ce7b5dc16af867d68eeb95cf3c828dcc2/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py",
      "sha": "5b36ef7ba2a297969d10eb5ba6801aa139e345bb",
      "status": "modified"
    },
    {
      "additions": 21,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/9f03a26ce7b5dc16af867d68eeb95cf3c828dcc2/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_routers.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_routers.py?ref=9f03a26ce7b5dc16af867d68eeb95cf3c828dcc2",
      "deletions": 0,
      "filename": "tests/unit_tests/transformer/moe/test_routers.py",
      "patch": "@@ -841,6 +841,27 @@ def test_router_gating_linear_bias(router_dtype):\n     assert torch.allclose(bias.grad, ref_bias.grad, **tols)\n \n \n+@pytest.mark.internal\n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA not available\")\n+@pytest.mark.parametrize(\"router_dtype\", [torch.bfloat16, torch.float32])\n+@pytest.mark.parametrize(\"num_tokens\", [1, 4096])\n+def test_router_gating_linear_bias_grad(router_dtype, num_tokens):\n+    \"\"\"The bias gradient from the wgrad GEMM's BGRAD epilogue matches the column sum of the\n+    output gradient for bf16 parameters with a higher-precision router.\"\"\"\n+    torch.manual_seed(0)\n+    inp = torch.randn((num_tokens, 1024), dtype=torch.bfloat16, device=\"cuda\", requires_grad=True)\n+    weight = torch.randn((32, 1024), dtype=torch.bfloat16, device=\"cuda\", requires_grad=True)\n+    bias = torch.randn((32,), dtype=torch.bfloat16, device=\"cuda\", requires_grad=True)\n+    grad_output = torch.randn((num_tokens, 32), dtype=router_dtype, device=\"cuda\")\n+\n+    router_gating_linear(inp, weight, bias, router_dtype).backward(grad_output)\n+\n+    ref_grad_bias = grad_output.float().sum(dim=0).to(bias.dtype)\n+    assert bias.grad.dtype == bias.dtype\n+    # fp32 accumulation on both sides; only the summation order differs before the bf16 cast.\n+    torch.testing.assert_close(bias.grad, ref_grad_bias, rtol=1e-2, atol=1e-2)\n+\n+\n @pytest.mark.internal\n @pytest.mark.parametrize(\"score_function\", [\"softmax\", \"sigmoid\", \"sqrtsoftplus\"])\n @pytest.mark.parametrize(\"use_pre_softmax\", [True, False])",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/9f03a26ce7b5dc16af867d68eeb95cf3c828dcc2/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_routers.py",
      "sha": "72be129faefece8dfa6ef4adb5b43c8953fb8529",
      "status": "modified"
    }
