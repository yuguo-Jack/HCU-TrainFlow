  "reviews": [
    {
      "body": "Grouping all fused-MLA-only Transformer Engine symbols under one compatibility boundary is the right fix: partial guarding still allowed module import to fail before runtime feature selection. Treating tensors as non-quantized when `QuantizedTensor` itself is unavailable is conservative and preserves the older-TE path without inventing type information. The subprocess regression is valuable because it validates a fresh import graph rather than relying on already-imported modules. No blocker.",
      "html_url": "https://github.com/NVIDIA/Megatron-LM/pull/7088#pullrequestreview-5117587852",
      "id": 5117587852,
      "state": "COMMENTED",
