  "files": [
    {
      "additions": 7,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4f5ae72f7159a98b024b082a90eae58b324688e9/megatron%2Fcore%2Ftokenizers%2Ftext%2Flibraries%2Fbytelevel_tokenizer.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftokenizers%2Ftext%2Flibraries%2Fbytelevel_tokenizer.py?ref=4f5ae72f7159a98b024b082a90eae58b324688e9",
      "deletions": 2,
      "filename": "megatron/core/tokenizers/text/libraries/bytelevel_tokenizer.py",
      "patch": "@@ -80,8 +80,13 @@ def ids_to_text(self, ids):\n         \"\"\"\n         Convert a list of IDs to a text.\n         \"\"\"\n-        # remove special tokens.\n-        ids = [x for x in ids if x < self.special_start]\n+        # Preserve byte-range decoding, including the default EOS/PAD byte values.\n+        special_ids = {\n+            token_id\n+            for token_id in (self.bos_id, self.eos_id, self.pad_id)\n+            if token_id is not None and token_id >= 256\n+        }\n+        ids = [x for x in ids if x < self.special_start and x not in special_ids]\n         return bytes(ids).decode('utf-8', errors='ignore').rstrip()\n \n     def tokens_to_ids(self, tokens):",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4f5ae72f7159a98b024b082a90eae58b324688e9/megatron%2Fcore%2Ftokenizers%2Ftext%2Flibraries%2Fbytelevel_tokenizer.py",
      "sha": "7ad86cad8830111fd9d1c67cf3b013069a50bfad",
      "status": "modified"
    },
    {
      "additions": 52,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4f5ae72f7159a98b024b082a90eae58b324688e9/tests%2Funit_tests%2Ftokenizers%2Ftest_bytelevel_tokenizer.py",
      "changes": 52,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftokenizers%2Ftest_bytelevel_tokenizer.py?ref=4f5ae72f7159a98b024b082a90eae58b324688e9",
      "deletions": 0,
      "filename": "tests/unit_tests/tokenizers/test_bytelevel_tokenizer.py",
      "patch": "@@ -0,0 +1,52 @@\n+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.\n+\n+import pytest\n+\n+from megatron.core.tokenizers.text.libraries.bytelevel_tokenizer import ByteLevelTokenizer\n+\n+\n+@pytest.mark.parametrize(\"special_name\", [\"bos\", \"eos\", \"pad\"])\n+@pytest.mark.parametrize(\"special_id\", [256, 257, 511])\n+@pytest.mark.parametrize(\"method\", [\"ids_to_text\", \"tokens_to_text\"])\n+def test_configured_nonbyte_special_tokens(special_name, special_id, method):\n+    \"\"\"Configured special IDs outside the byte range are removed during decoding.\"\"\"\n+    tokenizer = ByteLevelTokenizer(**{f\"_{special_name}_id\": special_id})\n+    text = \"Hello, 世界 🌍\"\n+    ids = tokenizer.text_to_ids(text)\n+    decode = getattr(tokenizer, method)\n+\n+    assert decode([special_id, *ids[:9], special_id, *ids[9:], special_id]) == text\n+    assert decode([special_id, special_id]) == \"\"\n+\n+\n+def test_configured_and_additional_special_tokens():\n+    \"\"\"Configured special IDs and appended special tokens can appear together.\"\"\"\n+    tokenizer = ByteLevelTokenizer(\n+        _bos_id=256, _eos_id=257, _pad_id=511, special_tokens=[\"<extra>\"]\n+    )\n+    ids = [\n+        tokenizer.bos_id,\n+        65,\n+        tokenizer.token_to_id(\"<extra>\"),\n+        tokenizer.eos_id,\n+        tokenizer.pad_id,\n+    ]\n+\n+    assert tokenizer.ids_to_text(ids) == \"A\"\n+\n+\n+@pytest.mark.parametrize(\"text\", [\"\", \"Hello\", \"世界 🌍\", \"\\x00\\x01A\", \"\\x03A\"])\n+def test_byte_range_round_trip(text):\n+    \"\"\"Existing byte-range decoding remains unchanged, including configured byte IDs.\"\"\"\n+    tokenizer = ByteLevelTokenizer(_bos_id=3)\n+\n+    assert tokenizer.ids_to_text(tokenizer.text_to_ids(text)) == text\n+\n+\n+@pytest.mark.parametrize(\"token_id\", [-1, 256, 511])\n+def test_unregistered_nonbyte_ids_remain_invalid(token_id):\n+    \"\"\"An unknown non-byte ID is not silently discarded as a special token.\"\"\"\n+    tokenizer = ByteLevelTokenizer()\n+\n+    with pytest.raises(ValueError, match=\"bytes must be in range\"):\n+        tokenizer.ids_to_text([65, token_id])",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4f5ae72f7159a98b024b082a90eae58b324688e9/tests%2Funit_tests%2Ftokenizers%2Ftest_bytelevel_tokenizer.py",
      "sha": "2136ad6d0370ee8c8a3f556188ea994e445d5862",
      "status": "added"
    }
