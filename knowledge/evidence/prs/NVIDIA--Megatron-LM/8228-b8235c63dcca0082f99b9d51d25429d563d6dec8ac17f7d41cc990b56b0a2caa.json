      "filename": "pyproject.toml",
      "patch": "@@ -213,6 +213,8 @@ link-mode = \"copy\"\n # For instance, when installing into a PyTorch base image, we don't want to install torch,\n # torchvision, and triton.\n override-dependencies = [\n+    # LeptonAI caps AnyIO at 4.9.0; override it for the CVE-2026-63374 fix.\n+    \"anyio>=4.14.2\",\n     \"torch; sys_platform == 'never'\",\n     \"torchvision; sys_platform == 'never'\",\n     \"triton; sys_platform == 'never'\",",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/6b092dc0e602ecbbccd8638b7010be6301ef831a/pyproject.toml",
