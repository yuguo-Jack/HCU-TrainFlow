    {
      "body": "Hi @guihong-nv @janEbert, could one of you `/ok to test` and take a look when you get a chance? Thanks!",
      "created_at": "2026-10-09T13:25:30Z",
      "html_url": "https://github.com/NVIDIA/Megatron-LM/pull/7973#issuecomment-6081811499",
      "id": 6081811499,
      "updated_at": "2026-10-09T13:25:30Z",
