  "files": [
    {
      "additions": 7,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/807e5bf4f3f60fdde9a98eb19d6f03d2c039a18e/megatron%2Fcore%2Fdist_checkpointing%2Fdict_utils.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Fdist_checkpointing%2Fdict_utils.py?ref=807e5bf4f3f60fdde9a98eb19d6f03d2c039a18e",
      "deletions": 1,
      "filename": "megatron/core/dist_checkpointing/dict_utils.py",
      "patch": "@@ -104,7 +104,13 @@ def diff(x1: Any, x2: Any, prefix: Tuple = ()) -> Tuple[list, list, list]:\n         only_left = []\n         only_right = []\n         mismatch_debug_data = [prefix, type(x1), type(x2)]\n-        if isinstance(x1, torch.Tensor) and isinstance(x2, torch.Tensor):\n+        tensors = isinstance(x1, torch.Tensor) and isinstance(x2, torch.Tensor)\n+        if tensors and x1.shape != x2.shape:\n+            # Elementwise comparison would broadcast e.g. [1, n] against [m, n]\n+            # and wrongly report the tensors as equal.\n+            _is_mismatch = True\n+            mismatch_debug_data.extend([x1.shape, x2.shape])\n+        elif tensors:\n             try:\n                 if x1.device != x2.device:\n                     _is_mismatch = not torch.all(x1.cpu() == x2.cpu())",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/807e5bf4f3f60fdde9a98eb19d6f03d2c039a18e/megatron%2Fcore%2Fdist_checkpointing%2Fdict_utils.py",
      "sha": "85669a992097d5fe59b412d154ed209b4abb02a3",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/807e5bf4f3f60fdde9a98eb19d6f03d2c039a18e/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_validation.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_validation.py?ref=807e5bf4f3f60fdde9a98eb19d6f03d2c039a18e",
      "deletions": 0,
      "filename": "tests/unit_tests/dist_checkpointing/test_validation.py",
      "patch": "@@ -4,6 +4,7 @@\n \n import torch\n \n+from megatron.core.dist_checkpointing.dict_utils import diff\n from megatron.core.dist_checkpointing.validation import determine_global_metadata\n \n \n@@ -25,3 +26,19 @@ def test_determine_global_metadata_uses_explicit_process_group(monkeypatch):\n     assert global_metadata == [None, None]\n     get_world_size.assert_called_once_with(group=process_group)\n     all_gather_object.assert_called_once_with(global_metadata, local_metadata, group=process_group)\n+\n+\n+def test_diff_reports_tensors_with_broadcastable_shapes_as_mismatched():\n+    \"\"\"Tensors whose shapes differ must not be compared through broadcasting.\"\"\"\n+    for left, right in [\n+        (torch.ones(1, 4), torch.ones(8, 4)),\n+        (torch.zeros(4), torch.zeros(4, 1)),\n+        (torch.zeros(()), torch.zeros(3)),\n+    ]:\n+        only_left, only_right, mismatch = diff({\"w\": left}, {\"w\": right})\n+\n+        assert not only_left\n+        assert not only_right\n+        assert mismatch == [((\"w\",), torch.Tensor, torch.Tensor, left.shape, right.shape)]\n+\n+    assert diff({\"w\": torch.ones(2, 3)}, {\"w\": torch.ones(2, 3)}) == ([], [], [])",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/807e5bf4f3f60fdde9a98eb19d6f03d2c039a18e/tests%2Funit_tests%2Fdist_checkpointing%2Ftest_validation.py",
      "sha": "73bb607dd1cc3560488d8b17fc890db15956bd64",
      "status": "modified"
    }
  ],
