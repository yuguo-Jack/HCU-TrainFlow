      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/19222fdbdfe20d6573818207df8f29b9152bd367/tools%2Ftest_copyright_missing.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tools%2Ftest_copyright_missing.py?ref=19222fdbdfe20d6573818207df8f29b9152bd367",
      "deletions": 0,
      "filename": "tools/test_copyright_missing.py",
      "patch": "@@ -0,0 +1,21 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+import tempfile\n+import unittest\n+from pathlib import Path\n+from unittest import mock\n+\n+import check_copyright\n+\n+\n+class TestCopyright(unittest.TestCase):\n+    def test_invalid_input_paths_fail_the_check(self):\n+        with tempfile.TemporaryDirectory() as tmp:\n+            for path in [tmp, str(Path(tmp) / 'missing.py')]:\n+                with self.subTest(path=path), mock.patch('sys.argv', ['check_copyright.py', path]):\n+                    with self.assertRaises(SystemExit) as result:\n+                        check_copyright.main()\n+                    self.assertEqual(result.exception.code, 1)\n+\n+\n+if __name__ == '__main__':\n+    unittest.main()",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/19222fdbdfe20d6573818207df8f29b9152bd367/tools%2Ftest_copyright_missing.py",
      "sha": "bec32a7bddc2c7a0a3b813bf3857a6d7392bbf24",
      "status": "added"
    }
