      "filename": "megatron/core/models/common/embeddings/rotary_pos_embedding.py",
      "patch": "@@ -461,12 +461,8 @@ def forward(\n         if self.seq_len_interpolation_factor is not None:\n             seq *= 1 / self.seq_len_interpolation_factor\n \n-        # shape (3, bs, dim, 1)\n-        inv_freq_expanded = self.inv_freq[None, None, :, None].expand(3, seq.shape[1], -1, 1)\n-        # shape (3, bs, 1, seq_length)\n-        seq_expanded = seq[:, :, None, :].float()\n         # shape (3, bs, seq_length, dim)\n-        freqs = (inv_freq_expanded @ seq_expanded).transpose(2, 3)\n+        freqs = seq[..., None].float() * self.inv_freq\n         # first part even vector components, second part odd vector components,\n         #  2 * dim in dimension size\n         if not self.rotary_interleaved:",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4eff4d5ad5709b4ba244a8be1f1af03f03cc953d/megatron%2Fcore%2Fmodels%2Fcommon%2Fembeddings%2Frotary_pos_embedding.py",
