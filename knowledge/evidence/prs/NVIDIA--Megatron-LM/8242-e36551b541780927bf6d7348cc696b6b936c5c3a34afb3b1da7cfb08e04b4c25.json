  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a0e2e9dcf009d234aa7b0a62187b1c0efe94841f/megatron%2Fcore%2Ftransformer%2Fcustom_layers%2Fbatch_invariant_kernels.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fcustom_layers%2Fbatch_invariant_kernels.py?ref=a0e2e9dcf009d234aa7b0a62187b1c0efe94841f",
      "deletions": 0,
      "filename": "megatron/core/transformer/custom_layers/batch_invariant_kernels.py",
      "patch": "@@ -582,6 +582,9 @@ def _log_softmax_batch_invariant(input, dim, _half_to_float):\n def mean_batch_invariant(input, dim, keepdim=False, dtype: torch.dtype | None = None):\n     \"\"\"Batch-invariant replacement for `aten::mean.dim` over one or more dimensions.\"\"\"\n     assert dtype is None or dtype == torch.float32, f\"unsupported dtype: {dtype}\"\n+    # A full reduction (`x.mean()`, `torch.mean(x)`) arrives with an empty dim list.\n+    if dim is None or len(dim) == 0:\n+        dim = list(range(input.ndim))\n     if len(dim) == 1:\n         return mean_dim(input, dim[0], keepdim=keepdim)\n     else:",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a0e2e9dcf009d234aa7b0a62187b1c0efe94841f/megatron%2Fcore%2Ftransformer%2Fcustom_layers%2Fbatch_invariant_kernels.py",
      "sha": "e37c6ced8d120de49df6dc2f721811fe770b9cba",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a0e2e9dcf009d234aa7b0a62187b1c0efe94841f/tests%2Funit_tests%2Ftransformer%2Ftest_te_layers_batch_invariant.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftransformer%2Ftest_te_layers_batch_invariant.py?ref=a0e2e9dcf009d234aa7b0a62187b1c0efe94841f",
      "deletions": 0,
      "filename": "tests/unit_tests/transformer/test_te_layers_batch_invariant.py",
      "patch": "@@ -19,6 +19,7 @@\n from megatron.core.transformer.custom_layers.batch_invariant_kernels import (\n     HAVE_DEEPGEMM_BF16,\n     assert_te_supports_batch_invariant_attention,\n+    mean_batch_invariant,\n     set_batch_invariant_mode,\n     te_supports_batch_invariant_attention,\n )\n@@ -65,6 +66,29 @@ def test_batch_invariant_rejects_incompatible_te(monkeypatch):\n         assert_te_supports_batch_invariant_attention()\n \n \n+@pytest.mark.parametrize(\"dim\", ([], (), None))\n+@pytest.mark.parametrize(\"keepdim\", (False, True))\n+def test_mean_batch_invariant_full_reduction(dim, keepdim):\n+    \"\"\"An empty (or None) dim list reduces over every dimension, as aten::mean does.\"\"\"\n+    x = torch.arange(24, dtype=torch.float32).reshape(2, 3, 4)\n+    out = mean_batch_invariant(x, dim, keepdim=keepdim)\n+    torch.testing.assert_close(out, x.mean(dim=(0, 1, 2), keepdim=keepdim))\n+\n+\n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA is required\")\n+def test_full_mean_under_batch_invariant_mode():\n+    \"\"\"`x.mean()` / `torch.mean(x)` dispatch to aten::mean.dim with dim=[].\"\"\"\n+    x = torch.randn(4, 8, device=\"cuda\", requires_grad=True)\n+    ref = x.detach().sum() / x.numel()\n+    with set_batch_invariant_mode(True):\n+        out = x.mean()\n+        out_fn = torch.mean(x)\n+        out.backward()\n+    torch.testing.assert_close(out.detach(), ref)\n+    torch.testing.assert_close(out_fn.detach(), ref)\n+    torch.testing.assert_close(x.grad, torch.full_like(x, 1.0 / x.numel()))\n+\n+\n # ============================================================================\n # Batch-Invariant test helpers\n # ============================================================================",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a0e2e9dcf009d234aa7b0a62187b1c0efe94841f/tests%2Funit_tests%2Ftransformer%2Ftest_te_layers_batch_invariant.py",
      "sha": "75f03205f652ffab4b1b9985baa07ee0dae0aeec",
      "status": "modified"
    }
