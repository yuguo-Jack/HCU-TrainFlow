  "files": [
    {
      "additions": 12,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/b03197dbd8eaacfb778c70051108e254d8895454/megatron%2Fcore%2Ftransformer%2Fexperimental_attention_variant%2Fabsorbed_mla.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fexperimental_attention_variant%2Fabsorbed_mla.py?ref=b03197dbd8eaacfb778c70051108e254d8895454",
      "deletions": 1,
      "filename": "megatron/core/transformer/experimental_attention_variant/absorbed_mla.py",
      "patch": "@@ -197,7 +197,18 @@ def __init__(\n         self.qkv_up_checkpoint = None\n \n         mscale = _yarn_get_mscale(self.config.rotary_scaling_factor, self.config.mscale_all_dim)\n-        self.softmax_scale = mscale * mscale / math.sqrt(self.q_head_dim)\n+        # Must match MultiLatentAttention's softmax_scale exactly (this class is documented as\n+        # mathematically equivalent to it): an explicit config.softmax_scale override -- e.g. the\n+        # one TransformerConfig.__post_init__ derives for muP training -- was silently dropped here.\n+        self.softmax_scale = (\n+            mscale\n+            * mscale\n+            * (\n+                (1 / math.sqrt(self.q_head_dim))\n+                if self.config.softmax_scale is None\n+                else self.config.softmax_scale\n+            )\n+        )\n         self.cache_mla_latents = self.config.cache_mla_latents\n         assert not self.cache_mla_latents, \"cache_mla_latents is not supported for AbsorbedMLA\"\n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/b03197dbd8eaacfb778c70051108e254d8895454/megatron%2Fcore%2Ftransformer%2Fexperimental_attention_variant%2Fabsorbed_mla.py",
      "sha": "61174710b3debd8b9490578c15d0058cc9f2f524",
      "status": "modified"
    },
    {
      "additions": 40,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/b03197dbd8eaacfb778c70051108e254d8895454/tests%2Funit_tests%2Ftransformer%2Fexperimental_attention_variant%2Ftest_absorbed_mla.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftransformer%2Fexperimental_attention_variant%2Ftest_absorbed_mla.py?ref=b03197dbd8eaacfb778c70051108e254d8895454",
      "deletions": 0,
      "filename": "tests/unit_tests/transformer/experimental_attention_variant/test_absorbed_mla.py",
      "patch": "@@ -388,6 +388,46 @@ def fake_super_load(self, state_dict, *args, **kwargs):\n     assert f\"{prefix}linear_v_up_proj._extra_state\" not in captured_state_dict\n \n \n+def test_softmax_scale_respects_explicit_config_override():\n+    \"\"\"AbsorbedMLA is documented as mathematically equivalent to standard MLA, so an\n+    explicit config.softmax_scale (e.g. the one TransformerConfig derives for muP\n+    training) must produce the same softmax_scale on both, not just the implicit\n+    1/sqrt(q_head_dim) default.\"\"\"\n+    Utils.initialize_model_parallel(tensor_model_parallel_size=1, context_parallel_size=1)\n+    model_parallel_cuda_manual_seed(123)\n+\n+    qk_layernorm = True\n+    config = get_mock_mla_config(\n+        tensor_model_parallel_size=1, context_parallel_size=1, qk_layernorm=qk_layernorm\n+    )\n+    config.softmax_scale = 1.0 / 128  # an arbitrary non-default override, e.g. from muP\n+    absorbed_submodules = get_absorbed_mla_submodules(\n+        down_proj_use_column_parallel=False, qk_layernorm=qk_layernorm, rms_norm=True\n+    )\n+    standard_submodules = get_mla_submodules(\n+        down_proj_use_column_parallel=False, qk_layernorm=qk_layernorm, rms_norm=True\n+    )\n+    absorbed_mla = AbsorbedMLASelfAttention(\n+        config=config,\n+        submodules=absorbed_submodules,\n+        layer_number=0,\n+        attn_mask_type=AttnMaskType.causal,\n+        cp_comm_type=None,\n+        pg_collection=None,\n+    )\n+    standard_mla = MLASelfAttention(\n+        config=config,\n+        submodules=standard_submodules,\n+        layer_number=0,\n+        attn_mask_type=AttnMaskType.causal,\n+        cp_comm_type=None,\n+        pg_collection=None,\n+    )\n+\n+    assert absorbed_mla.softmax_scale == standard_mla.softmax_scale\n+    Utils.destroy_model_parallel()\n+\n+\n @pytest.mark.parametrize(\"tp_cp\", [[1, 1], [2, 1], [1, 2], [2, 2]])\n @pytest.mark.parametrize(\"qkv_format\", ['sbhd', 'thd'])\n @pytest.mark.parametrize(\"down_proj_use_column_parallel\", [False, True])",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/b03197dbd8eaacfb778c70051108e254d8895454/tests%2Funit_tests%2Ftransformer%2Fexperimental_attention_variant%2Ftest_absorbed_mla.py",
      "sha": "402fbb4c0bc9d9455a4adea775c5b1848abf3c75",
      "status": "modified"
    }
  ],
