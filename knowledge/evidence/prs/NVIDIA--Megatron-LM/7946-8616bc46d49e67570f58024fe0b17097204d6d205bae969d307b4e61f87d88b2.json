      "additions": 22,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/547fb48571c23f5f0b3e8dc614b820464f23dc77/.github%2Fworkflows%2Fcicd-main.yml",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/.github%2Fworkflows%2Fcicd-main.yml?ref=547fb48571c23f5f0b3e8dc614b820464f23dc77",
      "deletions": 0,
      "filename": ".github/workflows/cicd-main.yml",
      "patch": "@@ -482,6 +482,9 @@ jobs:\n       - name: Test DCO gate publisher\n         run: python3 .github/scripts/test_dco_gate.py\n \n+      - name: Test nightly testing notification wiring\n+        run: python3 .github/scripts/test_ci_notifications.py\n+\n       - name: Test superseded merge-group cleanup\n         run: python3 .github/scripts/test_cancel_superseded_merge_group_runs.py\n \n@@ -1315,6 +1318,25 @@ jobs:\n             exit 1\n           fi\n \n+  notify-nightly-failure:\n+    name: Notify nightly testing failure\n+    runs-on: ubuntu-latest\n+    needs: [cicd-unit-tests-latest, cicd-unit-tests-latest-gb200, cicd-integration-tests-latest-h100, cicd-integration-tests-latest-gb200]\n+    permissions: {}\n+    # Report test failures, not failed ancestors or build-cache population.\n+    # Main's nightly CI is dispatched; keep the workflow triggers unchanged.\n+    if: >-\n+      ${{ always() && !cancelled() && contains(needs.*.result, 'failure') &&\n+          github.repository == 'NVIDIA/Megatron-LM' &&\n+          (github.event_name == 'schedule' || github.event_name == 'workflow_dispatch') &&\n+          github.ref_name == github.event.repository.default_branch }}\n+    steps:\n+      - name: Notify CI alerts channel\n+        uses: NVIDIA-NeMo/FW-CI-templates/.github/actions/notify-ci-failure@631c404d00a9e60afc591cd071d35d2e18f82fc6\n+        with:\n+          needs-json: ${{ toJSON(needs) }}\n+          webhook: ${{ secrets.SLACK_WEBHOOK }}\n+\n   Coverage_Fake:\n     runs-on: ubuntu-latest\n     needs: [Nemo_CICD_Test, pre-flight]",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/547fb48571c23f5f0b3e8dc614b820464f23dc77/.github%2Fworkflows%2Fcicd-main.yml",
      "sha": "8f7b5176c2f108a9587d182768468009c1344340",
