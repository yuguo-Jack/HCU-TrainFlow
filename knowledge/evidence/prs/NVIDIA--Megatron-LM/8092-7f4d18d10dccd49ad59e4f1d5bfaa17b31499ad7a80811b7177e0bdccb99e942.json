      "additions": 26,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4e7e3369a306e5fb1445c5d5b06fdc6dee73057b/tests%2Ftest_utils%2Fpython_scripts%2Ftest_merge_datasets_output_prefix.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ftest_utils%2Fpython_scripts%2Ftest_merge_datasets_output_prefix.py?ref=4e7e3369a306e5fb1445c5d5b06fdc6dee73057b",
      "deletions": 0,
      "filename": "tests/test_utils/python_scripts/test_merge_datasets_output_prefix.py",
      "patch": "@@ -0,0 +1,26 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+import importlib.util\n+import sys\n+from pathlib import Path\n+from types import ModuleType\n+\n+import pytest\n+\n+\n+@pytest.mark.parametrize('output_prefix', ['merged', './merged'])\n+def test_accepts_output_prefix_in_current_directory(tmp_path, monkeypatch, output_prefix):\n+    # Dataset storage is outside this argument-parsing test; keep it CPU-only.\n+    dataset_module = ModuleType('megatron.core.datasets.indexed_dataset')\n+    for symbol in ['IndexedDataset', 'IndexedDatasetBuilder', 'get_bin_path', 'get_idx_path']:\n+        setattr(dataset_module, symbol, None)\n+    monkeypatch.setitem(sys.modules, dataset_module.__name__, dataset_module)\n+    source = Path(__file__).resolve().parents[3] / 'tools' / 'merge_datasets.py'\n+    module_spec = importlib.util.spec_from_file_location('merge_datasets', source)\n+    module = importlib.util.module_from_spec(module_spec)\n+    module_spec.loader.exec_module(module)\n+    monkeypatch.chdir(tmp_path)\n+    monkeypatch.setattr(\n+        sys, 'argv', ['merge_datasets', '--input', str(tmp_path), '--output-prefix', output_prefix]\n+    )\n+\n+    assert module.get_args().output_prefix == output_prefix",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4e7e3369a306e5fb1445c5d5b06fdc6dee73057b/tests%2Ftest_utils%2Fpython_scripts%2Ftest_merge_datasets_output_prefix.py",
      "sha": "7bfdd71aac6014b4ca044165e68821d47c2a58be",
      "status": "added"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4e7e3369a306e5fb1445c5d5b06fdc6dee73057b/tools%2Fmerge_datasets.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tools%2Fmerge_datasets.py?ref=4e7e3369a306e5fb1445c5d5b06fdc6dee73057b",
      "deletions": 1,
      "filename": "tools/merge_datasets.py",
      "patch": "@@ -48,7 +48,7 @@ def get_args():\n     ), f\"ERROR: {args.input} is not a directory or does not exist\"\n \n     assert os.path.isdir(\n-        os.path.dirname(args.output_prefix)\n+        os.path.dirname(args.output_prefix) or \".\"\n     ), f\"ERROR: {os.path.dirname(args.output_prefix)} is not a directory or does not exist\"\n \n     return args",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4e7e3369a306e5fb1445c5d5b06fdc6dee73057b/tools%2Fmerge_datasets.py",
