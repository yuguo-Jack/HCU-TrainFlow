      "deletions": 0,
      "filename": ".github/workflows/cicd-main.yml",
      "patch": "@@ -532,6 +532,17 @@ jobs:\n         run: |\n           uv sync --locked --only-group linting\n \n+      - name: Check core does not import training\n+        # Resolve relative imports through the megatron namespace package.\n+        run: >-\n+          .venv/bin/ruff check megatron/core\n+          --isolated\n+          --select TID251\n+          --ignore-noqa\n+          --output-format github\n+          --config 'namespace-packages = [\"megatron\"]'\n+          --config 'lint.flake8-tidy-imports.banned-api = {\"megatron.training\" = {msg = \"megatron.core must not depend on megatron.training.\"}}'\n+\n       - name: Test CI cache keys\n         run: .github/scripts/test_cache_keys.sh\n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/0b0c5d6e5793c821ec58b9bbc3ad5dc563c0650b/.github%2Fworkflows%2Fcicd-main.yml",
