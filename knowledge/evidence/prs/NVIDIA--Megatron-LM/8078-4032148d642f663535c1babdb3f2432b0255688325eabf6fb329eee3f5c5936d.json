      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ffunctional_tests%2Fpython_test_utils%2Fcommon.py?ref=8bbed73ba3a0a60d6b3d2e90a1b1accc386b059d",
      "deletions": 1,
      "filename": "tests/functional_tests/python_test_utils/common.py",
      "patch": "@@ -168,7 +168,7 @@ def read_tb_logs_as_list(\n         logger.error(f\"File not found matching: {path}/events* || {path}/results/events*\")\n         return None\n \n-    files.sort(key=lambda x: os.path.getmtime(os.path.join(path, pathlib.Path(x).name)))\n+    files.sort(key=os.path.getmtime)\n \n     accumulators = _load_event_accumulators_with_scalars(files)\n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/8bbed73ba3a0a60d6b3d2e90a1b1accc386b059d/tests%2Ffunctional_tests%2Fpython_test_utils%2Fcommon.py",
      "sha": "df438d76dd6e72d82ebfec90f1f3969bd5af1129",
      "status": "modified"
    },
    {
      "additions": 36,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/8bbed73ba3a0a60d6b3d2e90a1b1accc386b059d/tests%2Ffunctional_tests%2Fpython_test_utils%2Ftest_tensorboard_results_paths.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ffunctional_tests%2Fpython_test_utils%2Ftest_tensorboard_results_paths.py?ref=8bbed73ba3a0a60d6b3d2e90a1b1accc386b059d",
      "deletions": 0,
      "filename": "tests/functional_tests/python_test_utils/test_tensorboard_results_paths.py",
      "patch": "@@ -0,0 +1,36 @@\n+# Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\n+import os\n+\n+from tensorboard.compat.proto.event_pb2 import Event\n+from tensorboard.compat.proto.summary_pb2 import Summary\n+from tensorboard.summary.writer.event_file_writer import EventFileWriter\n+\n+from tests.functional_tests.python_test_utils.common import read_tb_logs_as_list\n+\n+\n+def test_reads_event_files_from_results_subdirectory(tmp_path):\n+    results = tmp_path / 'results'\n+    writer = EventFileWriter(str(results))\n+    writer.add_event(\n+        Event(step=1, summary=Summary(value=[Summary.Value(tag='lm loss', simple_value=1.25)]))\n+    )\n+    writer.close()\n+\n+    metrics = read_tb_logs_as_list(str(tmp_path), train_iters=1)\n+\n+    assert metrics['lm loss'].values == {1: 1.25}\n+\n+\n+def test_sorts_root_and_results_events_by_their_actual_paths(tmp_path):\n+    for directory, value, timestamp in [(tmp_path, 2.0, 20), (tmp_path / 'results', 1.0, 10)]:\n+        writer = EventFileWriter(str(directory))\n+        writer.add_event(\n+            Event(step=1, summary=Summary(value=[Summary.Value(tag='lm loss', simple_value=value)]))\n+        )\n+        writer.close()\n+        for event_file in directory.glob('events*tfevents*'):\n+            os.utime(event_file, (timestamp, timestamp))\n+\n+    metrics = read_tb_logs_as_list(str(tmp_path), train_iters=1, index=0)\n+\n+    assert metrics['lm loss'].values == {1: 1.0}",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/8bbed73ba3a0a60d6b3d2e90a1b1accc386b059d/tests%2Ffunctional_tests%2Fpython_test_utils%2Ftest_tensorboard_results_paths.py",
      "sha": "6a6df38d69e486e37011ca64be79a098e4f768f1",
      "status": "added"
    }
