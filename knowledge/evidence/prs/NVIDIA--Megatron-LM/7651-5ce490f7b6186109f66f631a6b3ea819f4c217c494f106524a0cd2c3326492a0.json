      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Finference%2Fmoe%2Fbatch_invariant.py?ref=a9f073f846d1b93c1b56c995bd02f5af2033cf37",
      "deletions": 1,
      "filename": "megatron/core/inference/moe/batch_invariant.py",
      "patch": "@@ -214,7 +214,7 @@ def _weighted_silu_mul_bounded_kernel(\n     \"\"\"\n     xbound = tl.load(bound_ptr)\n     num_progs = tl.num_programs(0)\n-    xoffset = tl.program_id(0) * XBLOCK\n+    xoffset = tl.program_id(0).to(tl.int64) * XBLOCK\n     while xoffset < xbound:\n         xindex = xoffset + tl.arange(0, XBLOCK)[:]\n         xmask = (xindex < xbound) & (xindex < xnumel)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a9f073f846d1b93c1b56c995bd02f5af2033cf37/megatron%2Fcore%2Finference%2Fmoe%2Fbatch_invariant.py",
      "sha": "6a7bd75f5389792b276a443e188cda5282c4d3f3",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a9f073f846d1b93c1b56c995bd02f5af2033cf37/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_inference_kernels.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_inference_kernels.py?ref=a9f073f846d1b93c1b56c995bd02f5af2033cf37",
      "deletions": 0,
      "filename": "tests/unit_tests/determinism/kernels/test_inference_kernels.py",
      "patch": "@@ -214,6 +214,14 @@ def live(out):\n         backward=False,\n         what=\"weighted_silu_mul_bounded\",\n     )\n+    assert_replays_bit_exact(\n+        lambda x: batch_invariant.weighted_silu_mul_bounded(x, probs, bound_elems, xblock=2048)[\n+            :n_used\n+        ],\n+        (x2,),\n+        backward=False,\n+        what=\"weighted_silu_mul_bounded (larger block)\",\n+    )\n \n \n @pytest.mark.skipif(not hasattr(torch, \"float8_e8m0fnu\"), reason=\"needs torch float8 e8m0 dtype\")",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a9f073f846d1b93c1b56c995bd02f5af2033cf37/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Ftest_inference_kernels.py",
