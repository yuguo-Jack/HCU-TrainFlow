      "deletions": 1,
      "filename": ".github/scripts/oncall_manager.py",
      "patch": "@@ -249,7 +249,7 @@ def rotate_schedule(repo_owner, dry_run=False):\n \n     # 1. Rotate (Remove past week)\n     # Only if schedule is not empty.\n-    if schedule:\n+    while schedule:\n         # Check date of first entry\n         first_entry = schedule[0]\n         try:\n@@ -269,6 +269,7 @@ def rotate_schedule(repo_owner, dry_run=False):\n                 print(\n                     f\"First entry {first_entry} has not ended yet (Ends {end_date}). Not removing.\"\n                 )\n+                break\n         except ValueError:\n             # Fallback if date is invalid, rotate anyway\n             removed = schedule.pop(0)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/6e93df0823561c539162e1737c433be084b560b8/.github%2Fscripts%2Foncall_manager.py",
      "sha": "761b501431c49d2c3044e814062bb5453a7d7d68",
