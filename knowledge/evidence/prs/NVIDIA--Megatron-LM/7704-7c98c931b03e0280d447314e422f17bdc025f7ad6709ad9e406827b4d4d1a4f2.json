      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/475c38582784bc5377437ddd643e8535d15b14e5/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Fmanifest.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Fmanifest.py?ref=475c38582784bc5377437ddd643e8535d15b14e5",
      "deletions": 1,
      "filename": "tests/unit_tests/determinism/kernels/manifest.py",
      "patch": "@@ -256,7 +256,10 @@ class KernelEntry:\n             \"megatron/core/fusions/fused_mhc_kernels.py\",\n             \"megatron/core/transformer/hyper_connection.py\",\n         ),\n-        tests=(K + \"test_fused_triton_kernels.py\",),\n+        tests=(\n+            K + \"test_fused_triton_kernels.py\",\n+            \"tests/unit_tests/fusions/test_fused_mhc_kernels.py\",\n+        ),\n         kind=\"triton\",\n         notes=\"Sinkhorn / h_aggregate / h_post_bda / proj_rms_compute_h on the triton, native (torch.compile) and cuTile backends.\",\n     ),",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/475c38582784bc5377437ddd643e8535d15b14e5/tests%2Funit_tests%2Fdeterminism%2Fkernels%2Fmanifest.py",
