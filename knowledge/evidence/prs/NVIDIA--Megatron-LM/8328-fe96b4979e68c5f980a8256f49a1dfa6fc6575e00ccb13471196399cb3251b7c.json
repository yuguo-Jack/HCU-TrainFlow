  "files": [
    {
      "additions": 15,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4bdb48530d2b0163a2d458e65937b06849c69850/megatron%2Fcore%2Ffusions%2Ffused_pad_routing_map.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ffusions%2Ffused_pad_routing_map.py?ref=4bdb48530d2b0163a2d458e65937b06849c69850",
      "deletions": 0,
      "filename": "megatron/core/fusions/fused_pad_routing_map.py",
      "patch": "@@ -80,13 +80,28 @@ def fused_pad_routing_map(routing_map: torch.Tensor, pad_multiple: int) -> torch\n \n     Returns:\n         torch.Tensor: The padded routing map of shape [num_tokens, num_experts].\n+\n+    Raises:\n+        RuntimeError: If an expert is routed more than ``num_tokens - num_to_pad`` tokens, so\n+            there are not enough zeros left in its row to reach the next multiple of\n+            pad_multiple.\n     \"\"\"\n     num_tokens, num_experts = routing_map.shape\n     if num_tokens == 0:\n         return routing_map\n \n     input_map = routing_map.transpose(0, 1).contiguous().int()  # [num_experts, num_tokens]\n \n+    # Same feasibility contract as pad_routing_map: the kernel can only flip the zeros that\n+    # are left in each expert's row, so check it here instead of silently returning an\n+    # unaligned count. _assert_async keeps the check off the host.\n+    num_ones = input_map.sum(dim=1)\n+    torch._assert_async(\n+        torch.all(num_ones + (-num_ones) % pad_multiple <= num_tokens),\n+        \"fused_pad_routing_map: not enough tokens to pad every expert's token count to a \"\n+        f\"multiple of {pad_multiple}\",\n+    )\n+\n     output_map = torch.empty_like(input_map)\n \n     # Kernel launch",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4bdb48530d2b0163a2d458e65937b06849c69850/megatron%2Fcore%2Ffusions%2Ffused_pad_routing_map.py",
      "sha": "80280d89b7ac24354ac2accc06b556a6f25a75dc",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4bdb48530d2b0163a2d458e65937b06849c69850/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py?ref=4bdb48530d2b0163a2d458e65937b06849c69850",
      "deletions": 0,
      "filename": "megatron/core/transformer/moe/moe_utils.py",
      "patch": "@@ -762,6 +762,11 @@ def pad_routing_map(routing_map: torch.Tensor, pad_multiple: int) -> torch.Tenso\n \n     Returns:\n         torch.Tensor: The padded routing map of shape [num_tokens, num_experts].\n+\n+    Raises:\n+        RuntimeError: If an expert is routed more than ``num_tokens - num_to_pad`` tokens, so\n+            there are not enough zeros left in its row to reach the next multiple of\n+            pad_multiple.\n     \"\"\"\n     # Work on a copy because fused router autograd saves the returned routing\n     # map for backward. Padding a transposed view in place would increment the\n@@ -772,6 +777,15 @@ def pad_routing_map(routing_map: torch.Tensor, pad_multiple: int) -> torch.Tenso\n     num_ones = routing_map.sum(dim=1)\n     num_to_pad = (-num_ones) % pad_multiple\n \n+    # Each expert can only be padded with the zeros left in its row. Without this check an\n+    # expert that needs more padding than that is silently returned with an unaligned count.\n+    # _assert_async keeps the check off the host so it does not add a device synchronization.\n+    torch._assert_async(\n+        torch.all(num_ones + num_to_pad <= routing_map.shape[1]),\n+        \"pad_routing_map: not enough tokens to pad every expert's token count to a multiple \"\n+        f\"of {pad_multiple}\",\n+    )\n+\n     # Find the positions of zeros in each row and their ranks\n     is_zero = routing_map == 0\n     zero_ranks = torch.cumsum(is_zero.int(), dim=1)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4bdb48530d2b0163a2d458e65937b06849c69850/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py",
      "sha": "61982ede3468e84b8ce820d3b228c1821735779a",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/4bdb48530d2b0163a2d458e65937b06849c69850/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_token_dispatcher.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_token_dispatcher.py?ref=4bdb48530d2b0163a2d458e65937b06849c69850",
      "deletions": 0,
      "filename": "tests/unit_tests/transformer/moe/test_token_dispatcher.py",
      "patch": "@@ -123,6 +123,38 @@ def test_pad_routing_map_does_not_modify_input():\n     assert torch.equal(padded.sum(dim=0), torch.tensor([2, 2]))\n \n \n+def test_pad_routing_map_pads_each_expert_to_multiple():\n+    routing_map = torch.zeros(100, 3, dtype=torch.bool)\n+    routing_map[:90, 0] = True\n+    routing_map[:5, 1] = True\n+    # Expert 2 receives no tokens and must stay empty.\n+\n+    padded = pad_routing_map(routing_map, pad_multiple=16)\n+\n+    assert torch.equal(padded.sum(dim=0), torch.tensor([96, 16, 0]))\n+    # Padding only ever flips zeros to ones.\n+    assert padded[routing_map].all()\n+\n+\n+def test_pad_routing_map_uses_every_remaining_token_when_needed():\n+    # Expert 0 needs all 38 remaining tokens to reach 128, which is still feasible.\n+    routing_map = torch.zeros(128, 2, dtype=torch.bool)\n+    routing_map[:90, 0] = True\n+\n+    padded = pad_routing_map(routing_map, pad_multiple=128)\n+\n+    assert torch.equal(padded.sum(dim=0), torch.tensor([128, 0]))\n+\n+\n+def test_pad_routing_map_raises_when_not_enough_tokens():\n+    # Expert 0 has 90 of 100 tokens, so it cannot be padded to 128.\n+    routing_map = torch.zeros(100, 2, dtype=torch.bool)\n+    routing_map[:90, 0] = True\n+\n+    with pytest.raises(RuntimeError, match=\"not enough tokens\"):\n+        pad_routing_map(routing_map, pad_multiple=128)\n+\n+\n def token_permutation(token_dispatcher, hidden_states, probs, indices):\n     hidden_states, probs = token_dispatcher.dispatch_preprocess(hidden_states, indices, probs)\n     hidden_states, probs = token_dispatcher.token_dispatch(hidden_states, probs)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/4bdb48530d2b0163a2d458e65937b06849c69850/tests%2Funit_tests%2Ftransformer%2Fmoe%2Ftest_token_dispatcher.py",
      "sha": "86fe9b32a6d629ac2c6142053e929ea025a8c7ca",
      "status": "modified"
    }
