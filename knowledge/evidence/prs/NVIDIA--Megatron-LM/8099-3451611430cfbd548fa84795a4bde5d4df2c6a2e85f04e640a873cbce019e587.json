      "patch": "@@ -16,6 +16,7 @@\n \n import argparse\n import json\n+import math\n import os\n import sys\n from dataclasses import dataclass\n@@ -187,6 +188,8 @@ def confidence_value(value, default: float = 0.0) -> float:\n     except (TypeError, ValueError):\n         confidence = default\n \n+    if not math.isfinite(confidence):\n+        confidence = default\n     return max(0.0, min(confidence, 1.0))\n \n ",
