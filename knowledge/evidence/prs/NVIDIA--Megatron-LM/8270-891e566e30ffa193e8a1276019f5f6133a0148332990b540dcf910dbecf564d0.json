      "deletions": 0,
      "filename": "tests/test_utils/recipes/gb200/moe.yaml",
      "patch": "@@ -233,3 +233,11 @@ products:\n       - environment: [dev]\n         scope: [nightly]\n         platforms: [dgx_gb200]\n+\n+  # #7400: eager BF16 cuBLAS grouped GEMM with MFSDP v2 + HybridEP.\n+  # Requires 8 GPUs; GitHub runners only provide one 4-GPU node.\n+  - test_case: [deepseek_proxy_mfsdp_v2_ep2_hybridep]\n+    products:\n+      - environment: [dev]\n+        scope: [mr, nightly]\n+        platforms: [dgx_gb200]",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/7a1bd6a5c8e03c2c19faa5471619d17c23d94f76/tests%2Ftest_utils%2Frecipes%2Fgb200%2Fmoe.yaml",
