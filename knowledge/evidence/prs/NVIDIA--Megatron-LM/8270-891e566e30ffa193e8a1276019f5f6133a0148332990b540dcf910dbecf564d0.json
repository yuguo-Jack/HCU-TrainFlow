    {
      "additions": 105,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/7a1bd6a5c8e03c2c19faa5471619d17c23d94f76/tests%2Ffunctional_tests%2Ftest_cases%2Fmoe%2Fdeepseek_proxy_mfsdp_v2_ep2_hybridep%2Fmodel_config.yaml",
      "changes": 105,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Ffunctional_tests%2Ftest_cases%2Fmoe%2Fdeepseek_proxy_mfsdp_v2_ep2_hybridep%2Fmodel_config.yaml?ref=7a1bd6a5c8e03c2c19faa5471619d17c23d94f76",
      "deletions": 0,
      "filename": "tests/functional_tests/test_cases/moe/deepseek_proxy_mfsdp_v2_ep2_hybridep/model_config.yaml",
      "patch": "@@ -0,0 +1,105 @@\n+# Regression for #7400: cuBLAS grouped BF16 GEMM overlapping MFSDP collectives.\n+# Preserve the reproducer's GEMM shapes and two accumulation microbatches on\n+# 2 nodes x 4 GPUs. The smaller graph-enabled proxy exercises a different path.\n+ENV_VARS:\n+  NVTE_ALLOW_NONDETERMINISTIC_ALGO: 1\n+  NVTE_CUTEDSL_FUSED_GROUPED_MLP: 1\n+  # Keep the regression on cuBLAS even if TE changes its default backend.\n+  NVTE_USE_CUTLASS_GROUPED_GEMM: 0\n+  NCCL_LAUNCH_ORDER_IMPLICIT: 1\n+  NCCL_DEBUG: VERSION\n+MODEL_ARGS:\n+  --bf16: true\n+  --use-mcore-models: true\n+  --transformer-impl: transformer_engine\n+  --tensor-model-parallel-size: 1\n+  --pipeline-model-parallel-size: 1\n+  --context-parallel-size: 1\n+  --expert-model-parallel-size: 2\n+  --expert-tensor-parallel-size: 1\n+  --use-megatron-fsdp: true\n+  --megatron-fsdp-version: 2\n+  --data-parallel-sharding-strategy: optim_grads_params\n+  --num-distributed-optimizer-instances: 4\n+  --outer-dp-sharding-strategy: optim\n+  --expert-outer-dp-sharding-strategy: optim\n+  --megatron-fsdp-main-params-dtype: fp32\n+  --megatron-fsdp-main-grads-dtype: fp32\n+  --overlap-grad-reduce: true\n+  --overlap-param-gather: true\n+  --no-gradient-accumulation-fusion: true\n+  --use-precision-aware-optimizer: true\n+  --ckpt-format: fsdp_dtensor\n+  # Eager execution, including the optimizer.\n+  --cuda-graph-impl: none\n+  --micro-batch-size: 1\n+  --global-batch-size: 16\n+  --train-iters: 100\n+  --exit-interval: 100\n+  --seed: 1234\n+  --mock-data: true\n+  --tokenizer-type: NullTokenizer\n+  --vocab-size: 32000\n+  --make-vocab-size-divisible-by: 128\n+  --seq-length: 2048\n+  --max-position-embeddings: 2048\n+  --num-layers: 5\n+  --hidden-size: 4096\n+  --ffn-hidden-size: 11008\n+  --num-attention-heads: 32\n+  --position-embedding-type: rope\n+  --rotary-base: 10000\n+  --no-rope-fusion: true\n+  --normalization: RMSNorm\n+  --norm-epsilon: 1e-5\n+  --swiglu: true\n+  --disable-bias-linear: true\n+  --untie-embeddings-and-output-weights: true\n+  --attention-dropout: 0.0\n+  --hidden-dropout: 0.0\n+  --init-method-std: 0.02\n+  --multi-latent-attention: true\n+  --qk-layernorm: true\n+  --q-lora-rank: 512\n+  --kv-lora-rank: 512\n+  --qk-head-dim: 128\n+  --qk-pos-emb-head-dim: 64\n+  --v-head-dim: 128\n+  --num-experts: 16\n+  --moe-layer-freq: ([0]+[1]*4)\n+  --moe-ffn-hidden-size: 2048\n+  --moe-shared-expert-intermediate-size: 2048\n+  --moe-router-topk: 8\n+  --moe-token-dispatcher-type: flex\n+  --moe-flex-dispatcher-backend: hybridep\n+  --moe-expert-rank-capacity-factor: 4.0\n+  --use-transformer-engine-op-fuser: true\n+  --moe-grouped-gemm: true\n+  --moe-router-load-balancing-type: seq_aux_loss\n+  --moe-aux-loss-coeff: 1e-4\n+  --moe-router-score-function: sigmoid\n+  --moe-router-pre-softmax: true\n+  --moe-router-enable-expert-bias: true\n+  --moe-router-dtype: fp32\n+  --moe-permute-fusion: true\n+  --optimizer: adam\n+  --lr: 1e-4\n+  --min-lr: 1e-5\n+  --lr-warmup-iters: 2\n+  --lr-decay-iters: 50\n+  --lr-decay-style: cosine\n+  --weight-decay: 0.01\n+  --adam-beta1: 0.9\n+  --adam-beta2: 0.95\n+  --adam-eps: 1e-8\n+  # Effectively disable clipping while retaining gradient-norm logs for diagnostics.\n+  --clip-grad: 1.0e9\n+  --eval-iters: 0\n+  --eval-interval: 101\n+  --log-interval: 1\n+  --tensorboard-log-interval: 1\n+  --tensorboard-dir: ${TENSORBOARD_PATH}\n+TEST_TYPE: regular\n+METRICS:\n+  - \"lm loss\"\n+LAUNCHER: torchrun",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/7a1bd6a5c8e03c2c19faa5471619d17c23d94f76/tests%2Ffunctional_tests%2Ftest_cases%2Fmoe%2Fdeepseek_proxy_mfsdp_v2_ep2_hybridep%2Fmodel_config.yaml",
