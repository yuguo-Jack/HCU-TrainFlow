    {
      "additions": 56,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/9ef9176cc8a9c68197046ee9c78e592c709756e6/tests%2Funit_tests%2Ftraining%2Ftest_mfsdp_ub_arguments.py",
      "changes": 56,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Ftraining%2Ftest_mfsdp_ub_arguments.py?ref=9ef9176cc8a9c68197046ee9c78e592c709756e6",
      "deletions": 0,
      "filename": "tests/unit_tests/training/test_mfsdp_ub_arguments.py",
      "patch": "@@ -0,0 +1,56 @@\n+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.\n+\n+\"\"\"Keep NCCL UB CLI defaults specific to the selected MFSDP implementation.\"\"\"\n+\n+import sys\n+\n+import pytest\n+\n+from megatron.training.arguments import parse_args, validate_args\n+from megatron.training.training import get_megatron_ddp_config\n+\n+\n+@pytest.mark.parametrize(\n+    \"version,ub,manual\",\n+    [(1, False, False), (1, True, False), (2, False, False), (2, True, False), (2, True, True)],\n+)\n+def test_nccl_ub_registration_defaults(monkeypatch, version, ub, manual):\n+    argv = [\n+        \"test_mfsdp_ub_arguments.py\",\n+        \"--enable-experimental\",\n+        \"--num-layers\",\n+        \"2\",\n+        \"--hidden-size\",\n+        \"128\",\n+        \"--num-attention-heads\",\n+        \"8\",\n+        \"--seq-length\",\n+        \"32\",\n+        \"--max-position-embeddings\",\n+        \"32\",\n+        \"--micro-batch-size\",\n+        \"1\",\n+        \"--global-batch-size\",\n+        \"8\",\n+        \"--bf16\",\n+        \"--use-megatron-fsdp\",\n+        \"--megatron-fsdp-version\",\n+        str(version),\n+        \"--ckpt-format\",\n+        \"fsdp_dtensor\",\n+        \"--data-parallel-sharding-strategy\",\n+        \"optim_grads_params\",\n+        \"--no-gradient-accumulation-fusion\",\n+    ]\n+    if ub:\n+        argv.append(\"--use-nccl-ub\")\n+    if manual:\n+        argv.append(\"--fsdp-manual-registration\")\n+    monkeypatch.setattr(sys, \"argv\", argv)\n+\n+    args = validate_args(parse_args())\n+    config = get_megatron_ddp_config(args, use_torch_fsdp2=False)\n+\n+    assert config.nccl_ub is ub\n+    assert config.fsdp_manual_registration is (manual or (ub and version == 1))\n+    assert config.fsdp_double_buffer is (ub and version == 1)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/9ef9176cc8a9c68197046ee9c78e592c709756e6/tests%2Funit_tests%2Ftraining%2Ftest_mfsdp_ub_arguments.py",
      "sha": "f6cf698e7b7c31ea195dddc67253336e5139de48",
      "status": "added"
    }
