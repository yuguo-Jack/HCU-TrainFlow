      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/9ef9176cc8a9c68197046ee9c78e592c709756e6/megatron%2Ftraining%2Farguments.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Ftraining%2Farguments.py?ref=9ef9176cc8a9c68197046ee9c78e592c709756e6",
      "deletions": 1,
      "filename": "megatron/training/arguments.py",
      "patch": "@@ -1066,7 +1066,7 @@ def validate_args(args, defaults={}):\n         assert args.ckpt_format == \"fsdp_dtensor\", \\\n             \"Megatron-FSDP requires the `fsdp_dtensor` checkpointing format.\"\n \n-        if args.nccl_ub:\n+        if args.nccl_ub and args.megatron_fsdp_version == 1:\n             # In Megatron-LM, required implementation for manual registration is already provided.\n             # So we enable the manual registration by default when nccl-ub and use_megatron_fsdp is set.\n             args.fsdp_manual_registration = True",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/9ef9176cc8a9c68197046ee9c78e592c709756e6/megatron%2Ftraining%2Farguments.py",
