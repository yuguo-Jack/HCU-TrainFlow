      "deletions": 0,
      "filename": "megatron/core/distributed/fsdp/src/megatron_fsdp/experimental/dbuffer.py",
      "patch": "@@ -204,6 +204,12 @@ def release_storage(self) -> None:\n     def rendezvous(self, mesh_axis: int) -> None:\n         \"\"\"Rendezvous this local buffer for symmetric-memory collectives.\"\"\"\n         group = self.mesh.get_group(mesh_axis)\n+        # NCCL window registration requires an initialized communicator, even\n+        # when rendezvous is the first operation on this mesh-axis group.\n+        # Eager connection creates a communicator, so reuse it after warmup.\n+        backend = group._get_backend(self.device)\n+        if not backend._is_initialized():\n+            backend.eager_connect_single_device(self.device)\n         symm_mem.rendezvous(self.local_buffer, group=group.group_name)\n \n     def _resize_storage(self, numel: int) -> None:",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/9ef9176cc8a9c68197046ee9c78e592c709756e6/megatron%2Fcore%2Fdistributed%2Ffsdp%2Fsrc%2Fmegatron_fsdp%2Fexperimental%2Fdbuffer.py",
      "sha": "c53ce9468e1b100281f8bce5df25a389b0195ec6",
