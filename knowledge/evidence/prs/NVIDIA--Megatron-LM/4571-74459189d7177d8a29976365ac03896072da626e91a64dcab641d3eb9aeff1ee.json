      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a97df63858b5292af21ca432284424617b65f387/megatron%2Frl%2Frl_utils.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Frl%2Frl_utils.py?ref=a97df63858b5292af21ca432284424617b65f387",
      "deletions": 3,
      "filename": "megatron/rl/rl_utils.py",
      "patch": "@@ -571,9 +571,15 @@ def get_environment_rollouts(\n                     rollouts = [[None for _ in range(samples_per_group)] for _ in range(n_prompts)]\n \n         with nvtx_range(\"sync-rollouts\"):\n-            # Wait for Rollouts to be collected\n-            # TODO(jbarker): double check why this isn't causing rank 0 memory allocations\n-            torch.distributed.broadcast_object_list(rollouts, src=0)\n+            # Wait for Rollouts to be collected. Broadcast in small chunks to avoid\n+            # pickling the entire `rollouts` list at once (which can cause large\n+            # temporary allocations on rank 0).\n+            for i in range(n_prompts):\n+                group = rollouts[i] if rank == 0 else None\n+                obj_list = [group]\n+                torch.distributed.broadcast_object_list(obj_list, src=0)\n+                if rank != 0:\n+                    rollouts[i] = obj_list[0]\n         logger.debug(f\"Got rollouts on rank {rank}\")\n \n     if args.rl_offload_optimizer_during_inference:",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a97df63858b5292af21ca432284424617b65f387/megatron%2Frl%2Frl_utils.py",
