      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a9000e1a88147e2576208997e1b9abe4b168c94c/megatron%2Fcore%2Finference%2Fdisaggregation%2Finference_state_handoff.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Finference%2Fdisaggregation%2Finference_state_handoff.py?ref=a9000e1a88147e2576208997e1b9abe4b168c94c",
      "deletions": 1,
      "filename": "megatron/core/inference/disaggregation/inference_state_handoff.py",
      "patch": "@@ -654,7 +654,7 @@ def _release_pinned_handoff_ssm_slot(self, ssm_slot: int | None) -> None:\n     def add_request_with_kv_handoff(\n         self,\n         request_id: int,\n-        prompt: list,\n+        prompt: str | list[int],\n         sampling_params: \"SamplingParams\",\n         kv_meta: dict,\n         src_block_ids: list,\n@@ -663,6 +663,11 @@ def add_request_with_kv_handoff(\n \n         Side: decode engine; pull and push transport paths. A pull backend starts\n         the read here, while a push backend posts the matching receive.\n+\n+        A string prompt is tokenized once here, as ``add_request`` tokenizes one, so\n+        block hashing, the transfer size check and admission all use the same token\n+        IDs. Validation errors raise before any cache state is reserved; the engine's\n+        SUBMIT_REQUEST_WITH_KV handler turns them into a failed reply.\n         \"\"\"\n         allocator = self.context.kv_block_allocator\n         if not allocator.enable_prefix_caching:\n@@ -710,6 +715,13 @@ def add_request_with_kv_handoff(\n                 \"Decode-only handoff does not yet transfer prompt or first-token log probabilities\"\n             )\n \n+        if isinstance(prompt, str):\n+            # Normalize before hashing so the deferred and pending import records,\n+            # and the finalizer's add_request(), carry token IDs. add_request() then\n+            # takes its token-list path and does not add a second BOS.\n+            prompt = self.controller.tokenize_prompt(\n+                self.controller.tokenizer, prompt, sampling_params.add_BOS\n+            )\n         prompt_tensor = torch.tensor(prompt, dtype=torch.int64)\n         hashes = compute_block_hashes_batched(prompt_tensor, self.context.block_size_tokens)\n         num_blocks = transfer_block_count(kv_meta, src_block_ids)",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a9000e1a88147e2576208997e1b9abe4b168c94c/megatron%2Fcore%2Finference%2Fdisaggregation%2Finference_state_handoff.py",
      "sha": "14f7d5ed6c9870da1b6bacc12161584813723aa2",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a9000e1a88147e2576208997e1b9abe4b168c94c/megatron%2Fcore%2Finference%2Fengines%2Fdynamic_engine.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Finference%2Fengines%2Fdynamic_engine.py?ref=a9000e1a88147e2576208997e1b9abe4b168c94c",
      "deletions": 3,
      "filename": "megatron/core/inference/engines/dynamic_engine.py",
      "patch": "@@ -1830,6 +1830,9 @@ def _fail_submission(\n         add_request raises. Registering a placeholder record with\n         Status.FAILED lets ``_handle_failed_request`` publish the ENGINE_REPLY\n         without leaving the client hanging or killing the engine loop.\n+\n+        The SUBMIT_REQUEST_WITH_KV handler calls it too, when\n+        ``add_request_with_kv_handoff`` rejects a handoff before reserving cache state.\n         \"\"\"\n         if self.rank == 0:\n             warnings.warn(\n@@ -4594,9 +4597,15 @@ def schedule_requests(self) -> int:\n                 src_block_ids = msgpack.unpackb(message[2], raw=False)\n                 sampling_params = SamplingParams.deserialize(sampling_params)\n                 nvtx_range_push(\"add_request_with_kv_handoff\")\n-                self.add_request_with_kv_handoff(\n-                    request_id, prompt, sampling_params, kv_meta, src_block_ids\n-                )\n+                # As on the plain path, a rejected handoff must still reply. Every MP\n+                # rank receives the same message and raises the same validation error,\n+                # so failing it here keeps the ranks' request state mirrored.\n+                try:\n+                    self.add_request_with_kv_handoff(\n+                        request_id, prompt, sampling_params, kv_meta, src_block_ids\n+                    )\n+                except Exception as error:  # pylint: disable=broad-except\n+                    self._fail_submission(request_id, sampling_params, error)\n                 nvtx_range_pop(\"add_request_with_kv_handoff\")\n             elif header == Headers.RELEASE_KV:\n                 # Coordinator-broadcast release. Unknown request ids are no-ops.",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a9000e1a88147e2576208997e1b9abe4b168c94c/megatron%2Fcore%2Finference%2Fengines%2Fdynamic_engine.py",
      "sha": "1440322b3471f8f3ba08cf0e0b2a1c11026aeec1",
      "status": "modified"
    },
    {
      "additions": 48,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/a9000e1a88147e2576208997e1b9abe4b168c94c/tests%2Funit_tests%2Finference%2Fengines%2Ftest_dynamic_engine.py",
      "changes": 48,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/tests%2Funit_tests%2Finference%2Fengines%2Ftest_dynamic_engine.py?ref=a9000e1a88147e2576208997e1b9abe4b168c94c",
      "deletions": 0,
      "filename": "tests/unit_tests/inference/engines/test_dynamic_engine.py",
      "patch": "@@ -2698,6 +2698,54 @@ def test_schedule_requests_drops_malformed_submit_request(malformed, caplog):\n     assert msgpack.unpackb(broadcast[1], raw=False) == [len(malformed), len(good)]\n \n \n+def test_schedule_requests_fails_a_rejected_kv_handoff_and_continues():\n+    \"\"\"A SUBMIT_REQUEST_WITH_KV that the handoff rejects fails its request with a reply.\n+\n+    Every MP rank receives the same broadcast message and raises the same\n+    validation error, so failing the submission keeps their request state\n+    mirrored instead of taking the engine loop down, and the batch continues.\n+    \"\"\"\n+    params = SamplingParams(num_tokens_to_generate=1, termination_id=-1)\n+    kv_meta = {\"resume_tokens\": [9]}\n+    handoff = [\n+        msgpack.packb(\n+            [Headers.SUBMIT_REQUEST_WITH_KV.value, 41, params.serialize(), kv_meta],\n+            use_bin_type=True,\n+        ),\n+        msgpack.packb(\"hello\", use_bin_type=True),\n+        msgpack.packb([7, 8], use_bin_type=True),\n+    ]\n+    good = _submit_request_message(42, params.serialize(), [3, 4], None)\n+    engine = DynamicInferenceEngine.__new__(DynamicInferenceEngine)\n+    engine.prompt_preparer = None\n+    engine.rank, engine.use_coordinator, engine.is_mp_coordinator = 1, True, True\n+    engine.requests, engine.failed_request_ids = {}, []\n+    rejection = RuntimeError(\"KV handoff received without a transfer backend\")\n+    engine.add_request_with_kv_handoff = mock.Mock(side_effect=rejection)\n+    engine.add_request = mock.Mock()\n+    engine._fail_submission = mock.Mock()\n+    socket = engine.socket_for_receiving_requests = mock.Mock()\n+    socket.recv_multipart.side_effect = [handoff, good, dynamic_engine.zmq.Again]\n+    engine.model_parallel_publisher_socket, engine._pending_signals = mock.Mock(), deque()\n+    engine.local_metadata_ledger_enabled = False\n+    engine._drain_handoff_completion_notifications = mock.Mock(return_value=[])\n+    engine._collect_failed_requests = mock.Mock(return_value=[])\n+\n+    assert engine.schedule_requests() == 2\n+\n+    engine.add_request_with_kv_handoff.assert_called_once()\n+    args = engine.add_request_with_kv_handoff.call_args.args\n+    assert args[0] == 41 and args[1] == \"hello\"\n+    assert args[3] == kv_meta and args[4] == [7, 8]\n+    engine._fail_submission.assert_called_once()\n+    failed_id, failed_params, error = engine._fail_submission.call_args.args\n+    assert failed_id == 41 and error is rejection\n+    assert failed_params.num_tokens_to_generate == 1\n+    # The next message in the batch is still admitted.\n+    engine.add_request.assert_called_once()\n+    assert engine.add_request.call_args.args[:2] == (42, [3, 4])\n+\n+\n def test_handle_failed_request_releases_vlm_request_data():\n     \"\"\"Media registered before admission is dropped when the request fails.\"\"\"\n     request = DynamicInferenceRequest(",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/a9000e1a88147e2576208997e1b9abe4b168c94c/tests%2Funit_tests%2Finference%2Fengines%2Ftest_dynamic_engine.py",
