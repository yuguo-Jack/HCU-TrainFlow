      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fmoe%2Fbatch_invariant.py?ref=53e4f9e640f6286c4987925c94b6e67051d0fb57",
      "deletions": 2,
      "filename": "megatron/core/transformer/moe/batch_invariant.py",
      "patch": "@@ -56,12 +56,15 @@ def unpermute(\n     probs: Optional[torch.Tensor],\n     num_experts: int,\n     inverse_map: torch.Tensor,\n+    ep_size: Optional[int] = None,\n ) -> torch.Tensor:\n     \"\"\"Batch-invariant MoE unpermute.\n \n     Accumulation is token-owned. The AllToAll inverse map avoids data-dependent\n     shapes and adds contributions by EP rank then top-k slot, matching the\n-    inference NVLS rank-ordered combine.\n+    inference NVLS rank-ordered combine. `ep_size` is the expert-parallel size\n+    of the caller's token dispatcher, which splits the experts into `ep_size`\n+    contiguous per-rank shards; None uses the global expert-parallel size.\n     \"\"\"\n     input_dtype = permuted_tokens.dtype\n     # Mirror the inference engine's summation tree exactly:\n@@ -78,7 +81,9 @@ def unpermute(\n     cross_rank_fp64 = get_batch_invariant_collective() == \"multimem\"\n     acc_dtype = torch.float64 if cross_rank_fp64 else torch.float32\n     output_tokens = torch.zeros(restore_shape, dtype=acc_dtype, device=permuted_tokens.device)\n-    ep_size = parallel_state.get_expert_model_parallel_world_size() or 1\n+    if ep_size is None:\n+        # Migration fallback for callers that do not pass their dispatcher's EP size.\n+        ep_size = parallel_state.get_expert_model_parallel_world_size() or 1\n     assert num_experts % ep_size == 0, \"batch-invariant MoE expects contiguous EP shards\"\n     experts_per_rank = num_experts // ep_size\n     inverse_rows = inverse_map[0]",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/53e4f9e640f6286c4987925c94b6e67051d0fb57/megatron%2Fcore%2Ftransformer%2Fmoe%2Fbatch_invariant.py",
      "sha": "8e552981a7bbe947986dd581277c0f499a706766",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/53e4f9e640f6286c4987925c94b6e67051d0fb57/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py?ref=53e4f9e640f6286c4987925c94b6e67051d0fb57",
      "deletions": 0,
      "filename": "megatron/core/transformer/moe/moe_utils.py",
      "patch": "@@ -518,6 +518,7 @@ def unpermute(\n     drop_and_pad: bool = False,\n     pad_offsets: Optional[torch.Tensor] = None,\n     batch_invariant_inverse_map: Optional[torch.Tensor] = None,\n+    ep_size: Optional[int] = None,\n ) -> torch.Tensor:\n     \"\"\"\n     Restore the original order of tokens after permutation. If probs are provided, it\n@@ -546,6 +547,9 @@ def unpermute(\n         batch_invariant_inverse_map (torch.Tensor, optional): Fixed-shape\n             `[2, num_tokens, topk]` map from token/top-k slot to permuted row and\n             global expert id. Used by batch-invariant CUDA graph paths.\n+        ep_size (int, optional): Expert-parallel size of the calling token dispatcher. The\n+            batch-invariant path combines the experts of each EP rank in rank order. Defaults\n+            to the global expert-parallel size.\n \n     Returns:\n         torch.Tensor: The tokens restored to their original order.\n@@ -580,6 +584,7 @@ def unpermute(\n             probs=probs,\n             num_experts=routing_map.size(1),\n             inverse_map=batch_invariant_inverse_map,\n+            ep_size=ep_size,\n         )\n \n     _, hidden = restore_shape",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/53e4f9e640f6286c4987925c94b6e67051d0fb57/megatron%2Fcore%2Ftransformer%2Fmoe%2Fmoe_utils.py",
      "sha": "c9360c6e150abd2d71915c9e8f335fd364f4fc7a",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/53e4f9e640f6286c4987925c94b6e67051d0fb57/megatron%2Fcore%2Ftransformer%2Fmoe%2Ftoken_dispatcher.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Ftransformer%2Fmoe%2Ftoken_dispatcher.py?ref=53e4f9e640f6286c4987925c94b6e67051d0fb57",
      "deletions": 0,
      "filename": "megatron/core/transformer/moe/token_dispatcher.py",
      "patch": "@@ -899,6 +899,7 @@ def combine_postprocess(self, permutated_local_input_tokens):\n             fused=self.config.moe_permute_fusion,\n             drop_and_pad=self.drop_and_pad,\n             batch_invariant_inverse_map=self.batch_invariant_inverse_permutation_mapping,\n+            ep_size=self.ep_size,\n         )\n \n         # Reshape the output tensor",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/53e4f9e640f6286c4987925c94b6e67051d0fb57/megatron%2Fcore%2Ftransformer%2Fmoe%2Ftoken_dispatcher.py",
