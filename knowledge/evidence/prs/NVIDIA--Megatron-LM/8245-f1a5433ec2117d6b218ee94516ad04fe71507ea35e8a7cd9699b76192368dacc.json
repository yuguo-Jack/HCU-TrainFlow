      "blob_url": "https://github.com/NVIDIA/Megatron-LM/blob/c27ea94c10d27f78d18b9cd2e127f99d467d89b5/megatron%2Fcore%2Foptimizer%2Fdistrib_optimizer.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/NVIDIA/Megatron-LM/contents/megatron%2Fcore%2Foptimizer%2Fdistrib_optimizer.py?ref=c27ea94c10d27f78d18b9cd2e127f99d467d89b5",
      "deletions": 3,
      "filename": "megatron/core/optimizer/distrib_optimizer.py",
      "patch": "@@ -547,9 +547,17 @@ def _build_model_and_main_param_groups(\n                                 )\n                                 model_param.clear_high_precision_init_val()\n                             else:\n-                                shard_main_param = model_param.float().view(-1)[\n-                                    param_range.start : param_range.end\n-                                ]\n+                                # Detach first: `.float()` on a quantized parameter that requires\n+                                # grad records a grad_fn, so the resulting shard is a non-leaf\n+                                # tensor. torch.optim.Optimizer.__init__ (reached through\n+                                # HybridDeviceOptimizer with --optimizer-cpu-offload) rejects it\n+                                # with \"can't optimize a non-leaf Tensor\". Same fix as the fp32\n+                                # branch above; the master copy never needs autograd history.\n+                                shard_main_param = (\n+                                    model_param.detach()\n+                                    .float()\n+                                    .view(-1)[param_range.start : param_range.end]\n+                                )\n                         else:\n                             shard_main_param = shard_model_param.clone().float()\n ",
      "raw_url": "https://github.com/NVIDIA/Megatron-LM/raw/c27ea94c10d27f78d18b9cd2e127f99d467d89b5/megatron%2Fcore%2Foptimizer%2Fdistrib_optimizer.py",
      "sha": "2e1ff4625d9489dcff55e75597cce7abbb2584be",
      "status": "modified"
    }
