      "deletions": 2,
      "filename": "examples/coding_agent_rl/swe.py",
      "patch": "@@ -238,13 +238,18 @@ async def _repository_tree(sb: Sandbox, workdir: str) -> str:\n     # Images can contain modified tracked files and untracked build artifacts.\n     # Snapshot the actual workspace with a temporary index, preserving HEAD and\n     # the agent's real index. This also captures staged edits and new files.\n+    # .harness/ is kept out through a temporary excludes file, not a pathspec:\n+    # a pathspec naming a path the repo's own .gitignore already ignores (e.g. a\n+    # `.*` rule) makes `git add` fail.\n     cmd = (\n         f\"set -e\\ncd {shlex.quote(workdir)}\\n\"\n         'agent_index=$(mktemp)\\nrm -f \"$agent_index\"\\n'\n-        'trap \\'rm -f \"$agent_index\" \"$agent_index.lock\"\\' EXIT\\n'\n+        \"harness_excludes=$(mktemp)\\n\"\n+        'trap \\'rm -f \"$agent_index\" \"$agent_index.lock\" \"$harness_excludes\"\\' EXIT\\n'\n         'export GIT_INDEX_FILE=\"$agent_index\"\\n'\n         \"git read-tree HEAD\\n\"\n-        \"git add -A -- . ':(exclude)PROBLEM_STATEMENT.md' ':(exclude).harness/'\\n\"\n+        'echo .harness/ > \"$harness_excludes\"\\n'\n+        \"git -c core.excludesFile=\\\"$harness_excludes\\\" add -A -- . ':(exclude)PROBLEM_STATEMENT.md'\\n\"\n         \"git write-tree\"\n     )\n     _, out, _ = await sb.exec(cmd, user=\"agent\", timeout=120, check=True)",
      "raw_url": "https://github.com/THUDM/slime/raw/2253378ba006526f6f3d70991fbdfeb002c0051d/examples%2Fcoding_agent_rl%2Fswe.py",
      "sha": "6198273d044631288fa423d0f438baac2a7e56eb",
      "status": "modified"
    },
    {
      "additions": 26,
      "blob_url": "https://github.com/THUDM/slime/blob/2253378ba006526f6f3d70991fbdfeb002c0051d/tests%2Ftest_agent%2Ftest_swe_workspace_diff.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/THUDM/slime/contents/tests%2Ftest_agent%2Ftest_swe_workspace_diff.py?ref=2253378ba006526f6f3d70991fbdfeb002c0051d",
      "deletions": 0,
      "filename": "tests/test_agent/test_swe_workspace_diff.py",
      "patch": "@@ -78,5 +78,31 @@ async def scenario():\n     asyncio.run(scenario())\n \n \n+def test_patch_when_repo_gitignore_ignores_dot_directories(tmp_path):\n+    # Some task images ship the upstream project's .gitignore with a `.*` rule\n+    # (e.g. sfcc-ci), which also ignores the harness metadata directory.\n+    repo = tmp_path / \"agent repo\"\n+    repo.mkdir()\n+    git(repo, \"init\", \"-q\")\n+    git(repo, \"config\", \"user.name\", \"Test\")\n+    git(repo, \"config\", \"user.email\", \"test@example.invalid\")\n+    (repo / \"source.py\").write_text(\"result = 0\\n\")\n+    git(repo, \"add\", \".\")\n+    git(repo, \"commit\", \"-qm\", \"original\")\n+    (repo / \".gitignore\").write_text(\"node_modules\\n.*\\n!.github\\n\")\n+    shell = LocalShell()\n+\n+    async def scenario():\n+        baseline = await swe._repository_tree(shell, str(repo))\n+        (repo / \".harness\").mkdir()\n+        (repo / \".harness/log\").write_text(\"execution log\")\n+        (repo / \"source.py\").write_text(\"result = 42\\n\")\n+        patch = await swe.git_diff(shell, str(repo), baseline)\n+        assert \"result = 42\" in patch\n+        assert \".harness\" not in patch and \".gitignore\" not in patch\n+\n+    asyncio.run(scenario())\n+\n+\n if __name__ == \"__main__\":\n     raise SystemExit(pytest.main([__file__]))",
      "raw_url": "https://github.com/THUDM/slime/raw/2253378ba006526f6f3d70991fbdfeb002c0051d/tests%2Ftest_agent%2Ftest_swe_workspace_diff.py",
