      "patch": "@@ -5,7 +5,7 @@ def get_deepscaler_rule_based_reward(response, label):\n     if \"</think>\" in response:\n         model_solution = response.split(\"</think>\")[-1]\n     elif \"###Response\" in response:\n-        model_solution = response.split(\"###Response\")[1]\n+        model_solution = response.split(\"###Response\")[-1]\n     else:\n         return 0\n ",
      "raw_url": "https://github.com/THUDM/slime/raw/22023c653bbcfca188ca0ab37312840611e78913/slime%2Frollout%2Frm_hub%2Fdeepscaler.py",
