      "changes": 30,
      "contents_url": "https://api.github.com/repos/THUDM/slime/contents/slime%2Frollout%2Frm_hub%2Fmath_utils.py?ref=69e69fd2bd38ec4fb7bbb16fb2733b407fb97777",
      "deletions": 22,
      "filename": "slime/rollout/rm_hub/math_utils.py",
      "patch": "@@ -5,6 +5,7 @@\n Call grade_answer(given_answer: str, ground_truth: str).\n \"\"\"\n import re\n+from decimal import Decimal, InvalidOperation\n \n import sympy\n from pylatexenc import latex2text\n@@ -197,38 +198,25 @@ def _parse_latex(expr: str) -> str:\n     return expr.strip()\n \n \n-def _is_float(num: str) -> bool:\n-    try:\n-        float(num)\n-        return True\n-    except Exception:\n-        return False\n-\n-\n-def _is_int(x: float) -> bool:\n-    try:\n-        return abs(x - int(round(x))) <= 1e-7\n-    except Exception:\n-        return False\n-\n-\n def _is_frac(expr: str) -> bool:\n     return bool(re.search(r\"^-?[0-9]+.?/0*[1-9][0-9]*.?$\", expr))\n \n \n+_INTEGER_TOLERANCE = Decimal(\"1e-7\")\n+\n+\n def _str_is_int(x: str) -> bool:\n     try:\n         x = _strip_properly_formatted_commas(x)\n-        x = float(x)\n-        return abs(x - int(round(x))) <= 1e-7\n-    except Exception:\n+        number = Decimal(x)\n+        return number.is_finite() and abs(number - number.to_integral_value()) <= _INTEGER_TOLERANCE\n+    except (InvalidOperation, ValueError):\n         return False\n \n \n def _str_to_int(x: str) -> int:\n     x = x.replace(\",\", \"\")\n-    x = float(x)\n-    return int(x)\n+    return int(Decimal(x).to_integral_value())\n \n \n def _inject_implicit_mixed_number(step: str):\n@@ -298,8 +286,6 @@ def _normalize(expr: str) -> str:\n         expr = expr[1:-1]\n \n     expr = re.sub(\",\\\\\\\\! *\", \"\", expr)\n-    if _is_float(expr) and _is_int(float(expr)):\n-        expr = str(int(round(float(expr))))\n     if \"\\\\\" in expr:\n         try:\n             expr = _parse_latex(expr)",
      "raw_url": "https://github.com/THUDM/slime/raw/69e69fd2bd38ec4fb7bbb16fb2733b407fb97777/slime%2Frollout%2Frm_hub%2Fmath_utils.py",
      "sha": "b98ebd637fd7f7ebff9c8a51842bfde3c4d8cadf",
