  "files": [
    {
      "additions": 9,
      "blob_url": "https://github.com/AMD-AGI/TraceLens/blob/c0bed04dd1fb1cdaf9ee843f58059bdde29e3090/TraceLens%2FTraceUtils%2Futils%2Fannotation_utils.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/AMD-AGI/TraceLens/contents/TraceLens%2FTraceUtils%2Futils%2Fannotation_utils.py?ref=c0bed04dd1fb1cdaf9ee843f58059bdde29e3090",
      "deletions": 2,
      "filename": "TraceLens/TraceUtils/utils/annotation_utils.py",
      "patch": "@@ -39,9 +39,16 @@\n # step[DECODE bs=64 g_sq=128 g_sqsq=256 g_sqsk=262144 g_sk=131072]  <- MTP: g_sq > bs\n # step[MIXED bs=2 c=1 g=1 c_sq=5 c_sk=8 c_sqsq=25 c_sqsk=40\n #     g_sq=1 g_sk=12 g_sqsq=1 g_sqsk=12]\n+# step[DRAFT bs=2 g_sq=16 g_sqsq=128 g_sqsk=22944 g_sk=2868 forward_id=14960]\n+# step[VERIFY bs=2 g_sq=16 g_sqsq=128 g_sqsk=670032 g_sk=83754]\n # Case-insensitive: some builds emit lowercase phases (``step[decode bs=1]``).\n+# Speculative decoding splits each decode round into a draft-model step and a\n+# target verify step; both serve running requests, so both are generation.\n+SGLANG_SPECULATIVE_MODES = (\"DRAFT\", \"VERIFY\")\n SGLANG_DETAILED_PATTERN = re.compile(\n-    r\"step\\[(?:EXTEND|DECODE|MIXED)\\b[^\\]]*sqsq=\\d+[^\\]]*\\]\", re.IGNORECASE\n+    rf\"step\\[(?:EXTEND|DECODE|MIXED|{'|'.join(SGLANG_SPECULATIVE_MODES)})\\b\"\n+    r\"[^\\]]*sqsq=\\d+[^\\]]*\\]\",\n+    re.IGNORECASE,\n )\n # step[EXTEND bs=2 toks=14721]\n # step[DECODE bs=64]\n@@ -162,7 +169,7 @@ def _fill_sglang_detailed(ann, name):\n     ann.g_sqsq, ann.g_sqsk = _safe_int(kv.get(\"g_sqsq\", 0)), _safe_int(\n         kv.get(\"g_sqsk\", 0)\n     )\n-    if mode == \"DECODE\":\n+    if mode in (\"DECODE\", *SGLANG_SPECULATIVE_MODES):\n         ann.generation_requests, ann.generation_sum = bs, ann.g_sq\n     elif mode == \"EXTEND\":\n         ann.context_requests, ann.context_sum = bs, ann.c_sq",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/c0bed04dd1fb1cdaf9ee843f58059bdde29e3090/TraceLens%2FTraceUtils%2Futils%2Fannotation_utils.py",
      "sha": "1c5dc6d189c9dc6f6bab0f8d879a6aca071bf662",
      "status": "modified"
    },
    {
      "additions": 46,
      "blob_url": "https://github.com/AMD-AGI/TraceLens/blob/c0bed04dd1fb1cdaf9ee843f58059bdde29e3090/tests%2Ftest_annotation_utils.py",
      "changes": 46,
      "contents_url": "https://api.github.com/repos/AMD-AGI/TraceLens/contents/tests%2Ftest_annotation_utils.py?ref=c0bed04dd1fb1cdaf9ee843f58059bdde29e3090",
      "deletions": 0,
      "filename": "tests/test_annotation_utils.py",
      "patch": "@@ -342,6 +342,36 @@\n         ),\n         {},\n     ),\n+    (  # spec-decode target verify -> generation, like MTP DECODE\n+        \"step[VERIFY bs=2 g_sq=16 g_sqsq=128 g_sqsk=670032 g_sk=83754]\",\n+        \"sglang_detailed\",\n+        dict(\n+            batch_size=16,\n+            context_requests=0,\n+            generation_requests=2,\n+            generation_sum=16,\n+            g_sq=16,\n+            g_sk=83754,\n+            g_sqsq=128,\n+            g_sqsk=670032,\n+            has_sqsk=True,\n+        ),\n+        {},\n+    ),\n+    (  # draft-model decode step; forward_id is not an aggregate\n+        \"step[DRAFT bs=2 g_sq=16 g_sqsq=128 g_sqsk=22944 g_sk=2868 forward_id=14960]\",\n+        \"sglang_detailed\",\n+        dict(\n+            batch_size=16,\n+            context_requests=0,\n+            generation_requests=2,\n+            generation_sum=16,\n+            g_sq=16,\n+            g_sk=2868,\n+            has_sqsk=True,\n+        ),\n+        {},\n+    ),\n     (  # MIXED -> c=/g= are per-group request counts\n         \"step[MIXED bs=2 c=1 g=1 c_sq=5 c_sk=8 c_sqsq=25 c_sqsk=40 \"\n         \"g_sq=1 g_sk=12 g_sqsq=1 g_sqsk=12]\",\n@@ -851,6 +881,22 @@ def test_find_known_annotations_falls_back_to_the_native_tier():\n     assert [e[\"ts\"] for e in roots] == [10, 20]\n \n \n+def test_speculative_decode_steps_are_decode_iterations():\n+    extend = \"step[EXTEND bs=1 toks=3542 c_sq=3542 c_sqsq=12545764 c_sqsk=293752228 c_sk=82934]\"\n+    draft = \"step[DRAFT bs=2 g_sq=16 g_sqsq=128 g_sqsk=22944 g_sk=2868]\"\n+    verify = \"step[VERIFY bs=2 g_sq=16 g_sqsq=128 g_sqsk=670032 g_sk=83754]\"\n+    events = [_event(extend, ts=10), _event(draft, ts=20), _event(verify, ts=30)]\n+\n+    roots = find_known_annotations(events)\n+\n+    assert [e[\"name\"] for e in roots] == [extend, draft, verify]\n+    assert [classify_phase(d) for d in iteration_details(roots)] == [\n+        PHASE_PREFILL_ONLY,\n+        PHASE_DECODE_ONLY,\n+        PHASE_DECODE_ONLY,\n+    ]\n+\n+\n def test_find_known_annotations_on_no_match():\n     assert find_known_annotations([_event(\"unrelated\")]) == []\n     wrong_cat = [_event(DETAILED_DECODE, cat=\"cpu_op\")]",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/c0bed04dd1fb1cdaf9ee843f58059bdde29e3090/tests%2Ftest_annotation_utils.py",
      "sha": "f55237353662ec8c6cb80df0081b004479e0d8fe",
      "status": "modified"
    }
