      "filename": "TraceLens/PerfModel/extensions/attention_perf_model_extensions.py",
      "patch": "@@ -711,6 +711,18 @@ def get_param_details(event):\n \n \n class mla_tilelang_sparse_fwd(InferenceAttention):\n+    \"\"\"\n+    Performance model for TileLang SparseMLA\n+    (``sglang::tilelang_sparse_fwd`` / DSA sparse decode).\n+\n+    Sparse decode attends only to indexer-selected KV slots. The indices\n+    tensor's last dim is the topk window (SGLang:\n+    ``topk = indices.shape[-1]``). That width is surfaced as\n+    ``param_details[\"sliding_window\"]`` so the base roofline caps generation\n+    KV via :meth:`InferenceAttention._cap_gen_kv` (same path as\n+    :class:`pa_decode_gluon` / V4 paged decode). Missing or non-positive\n+    indices dims fail closed via :meth:`InferenceAttention.no_perf_param_details`.\n+    \"\"\"\n \n     @staticmethod\n     def get_param_details(event):\n@@ -722,6 +734,14 @@ def get_param_details(event):\n             params[\"d_h_v\"] = 512\n         else:\n             params[\"d_h_v\"] = int(concrete[4])\n+        args = event.get(\"args\") or {}\n+        dims = args.get(\"Input Dims\") or []\n+        if len(dims) <= 2 or len(dims[2]) < 1:\n+            return InferenceAttention.no_perf_param_details()\n+        topk = int(dims[2][-1])\n+        if topk <= 0:\n+            return InferenceAttention.no_perf_param_details()\n+        params[\"sliding_window\"] = topk\n         return params\n \n ",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/80e6b4e5ceecf1124ea97e2d85a7dae4ff6f256d/TraceLens%2FPerfModel%2Fextensions%2Fattention_perf_model_extensions.py",
      "sha": "014e2aa84144c7e66e122e386fa1c58305901d97",
      "status": "modified"
    },
    {
      "additions": 50,
      "blob_url": "https://github.com/AMD-AGI/TraceLens/blob/80e6b4e5ceecf1124ea97e2d85a7dae4ff6f256d/tests%2Ftest_perfmodel_extensions.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/AMD-AGI/TraceLens/contents/tests%2Ftest_perfmodel_extensions.py?ref=80e6b4e5ceecf1124ea97e2d85a7dae4ff6f256d",
      "deletions": 0,
      "filename": "tests/test_perfmodel_extensions.py",
      "patch": "@@ -1787,6 +1787,56 @@ def test_pa_decode_gluon(self):\n         model = pa_decode_gluon(event)\n         assert model.flops() > 0\n \n+    def test_mla_tilelang_sparse_fwd_topk_sliding_window(self):\n+        # glm53 decode shapes: dense annotation blows the roofline without\n+        # capping g_sk/g_sqsk to indices topk (Input Dims[2][-1]).\n+        event = {\n+            \"annotation\": (\n+                \"execute_11_context_0(sq0sk0sqsq0sqsk0)\"\n+                \"_generation_11(sq11sk1749268sqsq11sqsk1749268)\"\n+            ),\n+            \"args\": {\n+                \"Input Dims\": [[12, 8, 576], [2991488, 1, 576], [12, 1, 2048]],\n+                \"Input type\": [\"c10::Float8_e4m3fn\", \"c10::Float8_e4m3fn\", \"int\"],\n+            },\n+        }\n+        model = mla_tilelang_sparse_fwd(event)\n+        assert model.param_details[\"sliding_window\"] == 2048\n+        assert model.param_details[\"d_h_v\"] == 512\n+        capped = 11 * 2048\n+        assert model._cap_gen_kv(model.param_details[\"g_sk\"]) == capped\n+        assert model._cap_gen_kv(model.param_details[\"g_sqsk\"]) == capped\n+        bytes_mib = model.bytes() / (1024**2)\n+        assert bytes_mib < 1815\n+        assert 20 <= bytes_mib <= 30\n+        duration_s = 21.81e-6  # report mean, seconds\n+        tb_per_s = model.bytes() / duration_s / 1e12\n+        assert tb_per_s < 7.4\n+        assert 0.5 <= tb_per_s <= 2.0\n+\n+    def test_mla_tilelang_sparse_fwd_missing_indices_no_perf(self):\n+        base = {\n+            \"annotation\": (\n+                \"execute_11_context_0(sq0sk0sqsq0sqsk0)\"\n+                \"_generation_11(sq11sk1749268sqsq11sqsk1749268)\"\n+            ),\n+        }\n+        for dims in (\n+            [[12, 8, 576], [2991488, 1, 576]],\n+            [[12, 8, 576], [2991488, 1, 576], []],\n+            [[12, 8, 576], [2991488, 1, 576], [12, 1, 0]],\n+        ):\n+            event = {\n+                **base,\n+                \"args\": {\n+                    \"Input Dims\": dims,\n+                    \"Input type\": [\"c10::Float8_e4m3fn\", \"c10::Float8_e4m3fn\", \"int\"],\n+                },\n+            }\n+            model = mla_tilelang_sparse_fwd(event)\n+            assert model.param_details.get(\"_no_perf\")\n+            assert model.flops() is None\n+\n     def test_inference_attention_no_perf(self):\n         model = InferenceAttention({\"annotation\": \"bad\", \"args\": {}})\n         assert model.flops() is None",
