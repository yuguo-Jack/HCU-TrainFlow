      "filename": "TraceLens/Reporting/compare_perf_reports_pytorch.py",
      "patch": "@@ -65,6 +65,7 @@\n     },\n     \"ops_summary\": {\n         \"keys\": [\"name\"],\n+        \"optional_keys\": [\"parent_module\", \"is_recompute\"],\n         \"diff_cols\": [\"total_direct_kernel_time_ms\", \"Count\"],\n         \"cols_to_delete\": [\"total_direct_kernel_time_sum\"],\n         \"sort_col\": \"total_direct_kernel_time_ms\",\n@@ -255,7 +256,16 @@ def process_summary_sheet(\n     ):\n         config = SHEETS_COMPARE_CONFIG[\"kernel_summary_legacy\"]\n \n-    keys = config[\"keys\"]\n+    keys = list(config[\"keys\"])\n+    for opt_key in config.get(\"optional_keys\", []):\n+        present = [opt_key in df.columns for df in dfs]\n+        if all(present):\n+            keys.append(opt_key)\n+        elif any(present):\n+            raise ValueError(\n+                f\"Column '{opt_key}' is present in some reports but not all. \"\n+                f\"Cannot compare reports with different grouping granularities.\"\n+            )\n     diff_cols = config[\"diff_cols\"]\n     cols_to_delete = config[\"cols_to_delete\"]\n     sort_col = config[\"sort_col\"]",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/bd38f69361482781620f1c8cadddd5fa40076295/TraceLens%2FReporting%2Fcompare_perf_reports_pytorch.py",
