      "contents_url": "https://api.github.com/repos/AMD-AGI/TraceLens/contents/.github%2Fworkflows%2Fskill-evals.yml?ref=b8c049b2ff9608e8c6b2a78f5ed77efefa0eaa27",
      "deletions": 6,
      "filename": ".github/workflows/skill-evals.yml",
      "patch": "@@ -4,15 +4,16 @@\n # See LICENSE for license information.\n ###############################################################################\n \n-# Run skillscope on evals.json (same intake criteria as amd/skills)\n+# Track skillscope main so upstream regressions are visible.\n+# Branch protection should require \"AMD Skills Checks / Results\".\n \n name: AMD Skills Checks\n \n on:\n+  # Required checks must run on every PR, including changes outside the skill.\n   pull_request:\n-    paths:\n-      - \"TraceLens/Agent/Analysis/skills/**\"\n-      - \".github/workflows/skill-evals.yml\"\n+  schedule:\n+    - cron: \"17 6 * * *\"\n   workflow_dispatch:\n     inputs:\n       structural:\n@@ -36,10 +37,26 @@ jobs:\n     name: AMD Skills Checks\n     uses: amd/skillscope/.github/workflows/reusable.yml@main\n     secrets:\n-      api_key: ${{ secrets.ANTHROPIC_API_KEY }}\n+      api_key: ${{ github.event_name == 'workflow_dispatch' && (inputs.routing || inputs.behavioral) && secrets.ANTHROPIC_API_KEY || '' }}\n     with:\n       skills: TraceLens/Agent/Analysis/skills/analysis-orchestrator\n       # Each step can be set to `required`, `optional`, or `off`.\n       structural: ${{ github.event_name != 'workflow_dispatch' && 'required' || inputs.structural && 'required' || 'off' }}\n       routing: ${{ github.event_name == 'workflow_dispatch' && inputs.routing && 'required' || 'off' }}\n-      behavioral: ${{ github.event_name == 'workflow_dispatch' && inputs.behavioral && 'required' || 'off' }}\n\\ No newline at end of file\n+      behavioral: ${{ github.event_name == 'workflow_dispatch' && inputs.behavioral && 'required' || 'off' }}\n+\n+  external-references:\n+    name: External References\n+    runs-on: ubuntu-latest\n+    timeout-minutes: 15\n+    # Remote outages should be visible without blocking the offline Results gate.\n+    continue-on-error: true\n+    steps:\n+      - name: Check out repository\n+        uses: actions/checkout@v4\n+      - name: Check external skill references\n+        uses: amd/skillscope@main\n+        with:\n+          command: structural\n+          args: --external\n+          skills: TraceLens/Agent/Analysis/skills/analysis-orchestrator",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/b8c049b2ff9608e8c6b2a78f5ed77efefa0eaa27/.github%2Fworkflows%2Fskill-evals.yml",
