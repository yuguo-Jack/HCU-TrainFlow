    {
      "additions": 3,
      "blob_url": "https://github.com/AMD-AGI/TraceLens/blob/e45097ca5c0bad970f9045f72552c00e04b41c99/TraceLens%2FPerfModel%2Fbenchmarking%2FREADME.md",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/AMD-AGI/TraceLens/contents/TraceLens%2FPerfModel%2Fbenchmarking%2FREADME.md?ref=e45097ca5c0bad970f9045f72552c00e04b41c99",
      "deletions": 0,
      "filename": "TraceLens/PerfModel/benchmarking/README.md",
      "patch": "@@ -91,6 +91,9 @@ The output filename is used as the arch `name` heuristically (memory tier → `M\n }\n ```\n \n+All numeric values are floats rounded to one decimal place (for example `0.4`\n+TFLOPS for a slow fp64 unit), not integers.\n+\n Drop this file into an arch directory (the bundled [`Agent/Analysis/utils/arch/`](../../Agent/Analysis/utils/arch/)) as `<platform>.json`, then pass `--gpu_arch_json_path <platform>.json` to the perf-report CLIs. See [`examples/gpu_arch_example.md`](../../../examples/gpu_arch_example.md) for the field reference.\n \n ## Validating against hardware counters (AMD)",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/e45097ca5c0bad970f9045f72552c00e04b41c99/TraceLens%2FPerfModel%2Fbenchmarking%2FREADME.md",
      "sha": "39c43f447da1379554a3c591c748b6ffb062fc8b",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/AMD-AGI/TraceLens/blob/e45097ca5c0bad970f9045f72552c00e04b41c99/TraceLens%2FPerfModel%2Fbenchmarking%2Fmicrobench.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/AMD-AGI/TraceLens/contents/TraceLens%2FPerfModel%2Fbenchmarking%2Fmicrobench.py?ref=e45097ca5c0bad970f9045f72552c00e04b41c99",
      "deletions": 4,
      "filename": "TraceLens/PerfModel/benchmarking/microbench.py",
      "patch": "@@ -204,13 +204,13 @@ def _build_measured_arch_json(\n     maf: Dict[str, float] = {}\n     for key in ARCH_TLOPS_KEYS:\n         if key.startswith(\"matrix_\"):\n-            maf[key] = int(round(float(matrix_results.get(key, 0.0))))\n+            maf[key] = round(float(matrix_results.get(key, 0.0)), 1)\n         else:\n-            maf[key] = int(round(float(vector_results.get(key, 0.0))))\n+            maf[key] = round(float(vector_results.get(key, 0.0)), 1)\n     return {\n         \"name\": _arch_product_name(gpu_name, mem_gb),\n-        \"mem_bw_gbps\": int(round(float(read_bw_gbps))),\n-        \"memory_gb\": int(round(mem_gb)),\n+        \"mem_bw_gbps\": round(float(read_bw_gbps), 1),\n+        \"memory_gb\": round(float(mem_gb), 1),\n         \"max_achievable_tflops\": maf,\n         \"source\": \"These are benchmark derived peak flops and bw\",\n     }",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/e45097ca5c0bad970f9045f72552c00e04b41c99/TraceLens%2FPerfModel%2Fbenchmarking%2Fmicrobench.py",
      "sha": "367fc002d11b18508394c73460b976c6111e78ad",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/AMD-AGI/TraceLens/blob/e45097ca5c0bad970f9045f72552c00e04b41c99/tests%2Ftest_perfmodel_benchmarking.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/AMD-AGI/TraceLens/contents/tests%2Ftest_perfmodel_benchmarking.py?ref=e45097ca5c0bad970f9045f72552c00e04b41c99",
      "deletions": 2,
      "filename": "tests/test_perfmodel_benchmarking.py",
      "patch": "@@ -189,10 +189,27 @@ def test_build_measured_arch_json_shape(self):\n             vector_results={\"vector_fp16\": 45.6},\n         )\n         assert payload[\"name\"] == \"MI300X\"\n-        assert payload[\"max_achievable_tflops\"][\"matrix_fp16\"] == 123\n-        assert payload[\"max_achievable_tflops\"][\"vector_fp16\"] == 46\n+        assert payload[\"max_achievable_tflops\"][\"matrix_fp16\"] == 123.4\n+        assert payload[\"max_achievable_tflops\"][\"vector_fp16\"] == 45.6\n         assert set(mb.ARCH_TLOPS_KEYS) <= set(payload[\"max_achievable_tflops\"])\n \n+    def test_build_measured_arch_json_keeps_sub_one_tflops(self):\n+        mb = _import_microbench()\n+        payload = mb._build_measured_arch_json(\n+            gpu_name=\"R9600D\",\n+            mem_gb=47.6,\n+            read_bw_gbps=640.4,\n+            matrix_results={\"matrix_fp64\": 0.4, \"matrix_bf16\": 69.1},\n+            vector_results={\"vector_fp64\": 0.4},\n+        )\n+        maf = payload[\"max_achievable_tflops\"]\n+        assert maf[\"matrix_fp64\"] == 0.4\n+        assert maf[\"vector_fp64\"] == 0.4\n+        assert maf[\"matrix_bf16\"] == 69.1\n+        assert payload[\"mem_bw_gbps\"] == 640.4\n+        assert payload[\"memory_gb\"] == 47.6\n+        assert maf[\"vector_fp16\"] == 0.0\n+\n     def test_gemm_shapes_non_empty(self):\n         mb = _import_microbench()\n         assert len(mb.GEMM_SHAPES) >= 1",
      "raw_url": "https://github.com/AMD-AGI/TraceLens/raw/e45097ca5c0bad970f9045f72552c00e04b41c99/tests%2Ftest_perfmodel_benchmarking.py",
      "sha": "dae9d6cd15dd06520dfd9a8800c5c76c9851fb8b",
      "status": "modified"
    }
