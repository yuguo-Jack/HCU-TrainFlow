  "files": [
    {
      "additions": 16,
      "blob_url": "https://github.com/HYGON-AI/cluster-manager-das/blob/ace4113e3c2bb2fc3fa0f86d26ef5f0107e190c2/.github%2Fworkflows%2FREADME.md",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/HYGON-AI/cluster-manager-das/contents/.github%2Fworkflows%2FREADME.md?ref=ace4113e3c2bb2fc3fa0f86d26ef5f0107e190c2",
      "deletions": 3,
      "filename": ".github/workflows/README.md",
      "patch": "@@ -19,9 +19,22 @@ change to the shared `_run-unit-tests.yml` implementation or\n changes do not start any test workflow.\n \n The PR gate uses `pull_request_target`, so the triggering workflow text always\n-comes from the target branch. Only same-repository pull requests may reach the\n-shared runner. The checked-out PR source is mounted read-only, receives no\n-GitHub token, and runs without network access.\n+comes from the target branch. Same-repository and fork PRs both run automatically\n+without an approval job. Checkout uses the PR head repository and immutable head\n+SHA from the event; changes to workflow files in the PR cannot change the trusted\n+controller for that run.\n+The checked-out PR source is mounted read-only at `/ci-source` and copied into\n+a writable, temporary `/workspace` inside the container. Tests can create\n+fixtures beside the source without modifying the runner checkout. `/tmp` and\n+`/workspace` allow executable test fixtures but disallow devices and setuid\n+executables. The container receives no GitHub token or network access. All\n+Linux capabilities are dropped except SETUID/SETGID, needed by cross-UID\n+process-control tests; privilege escalation is disabled.\n+The test container is limited to 2 CPUs, 2 GiB RAM, and 256 processes.\n+\n+Existing failed runs retain the old target-branch workflow. After this change\n+reaches `main`, emit a fresh qualifying PR event (for example, a new commit or\n+closing and reopening the PR) to test an existing fork PR.\n \n ## Runner and image preparation\n ",
      "raw_url": "https://github.com/HYGON-AI/cluster-manager-das/raw/ace4113e3c2bb2fc3fa0f86d26ef5f0107e190c2/.github%2Fworkflows%2FREADME.md",
      "sha": "da2f69ebeacd7cd0373594bc4c6d6fe0764179d4",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/HYGON-AI/cluster-manager-das/blob/ace4113e3c2bb2fc3fa0f86d26ef5f0107e190c2/.github%2Fworkflows%2F_run-unit-tests.yml",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/HYGON-AI/cluster-manager-das/contents/.github%2Fworkflows%2F_run-unit-tests.yml?ref=ace4113e3c2bb2fc3fa0f86d26ef5f0107e190c2",
      "deletions": 22,
      "filename": ".github/workflows/_run-unit-tests.yml",
      "patch": "@@ -34,19 +34,6 @@ jobs:\n       CI_DEPS_VOLUME: >-\n         cluster-manager-pr-deps-${{ github.run_id }}-${{ github.run_attempt }}-${{ inputs.module-id }}\n     steps:\n-      - name: Authorize PR source\n-        shell: bash\n-        env:\n-          BASE_REPOSITORY: ${{ github.repository }}\n-          HEAD_REPOSITORY: ${{ github.event.pull_request.head.repo.full_name }}\n-        run: |\n-          set -euo pipefail\n-\n-          if [[ \"${HEAD_REPOSITORY}\" != \"${BASE_REPOSITORY}\" ]]; then\n-            echo \"ERROR: fork pull requests cannot execute code on the shared CI runner.\" >&2\n-            exit 1\n-          fi\n-\n       - name: Checkout PR source\n         uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683  # v4.2.2\n         with:\n@@ -108,22 +95,28 @@ jobs:\n             --pull never \\\n             --read-only \\\n             --network none \\\n-            --tmpfs /tmp:rw,nosuid,nodev,size=512m \\\n+            --cap-drop ALL \\\n+            --cap-add SETUID \\\n+            --cap-add SETGID \\\n+            --security-opt no-new-privileges \\\n+            --pids-limit 256 \\\n+            --cpus 2 \\\n+            --memory 2g \\\n+            --tmpfs /tmp:rw,exec,nosuid,nodev,size=512m \\\n+            --tmpfs /workspace:rw,exec,nosuid,nodev,size=512m \\\n             --env HOME=/tmp \\\n             --env PYTHONDONTWRITEBYTECODE=1 \\\n             --env PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 \\\n             --env \"PYTHONPATH=${pythonpath}\" \\\n             --volume \"${CI_DEPS_VOLUME}:/ci-deps:ro\" \\\n-            --volume \"${GITHUB_WORKSPACE}:/workspace:ro\" \\\n+            --volume \"${GITHUB_WORKSPACE}:/ci-source:ro\" \\\n             --workdir /workspace \\\n             \"${CLUSTER_MANAGER_CI_IMAGE_ID}\" \\\n-            python3 -m pytest \\\n-              -c /dev/null \\\n-              --rootdir=/workspace \\\n-              --import-mode=importlib \\\n-              -p no:cacheprovider \\\n-              -q \\\n-              \"${{ inputs.test-path }}\"\n+            bash -c 'set -euo pipefail\n+              cp -a --no-preserve=ownership /ci-source/. /workspace/\n+              exec python3 -m pytest -c /dev/null --rootdir=/workspace \\\n+                --import-mode=importlib -p no:cacheprovider -q \"$1\"\n+            ' ci-tests \"${{ inputs.test-path }}\"\n \n       - name: Remove test dependency volume\n         if: always()",
      "raw_url": "https://github.com/HYGON-AI/cluster-manager-das/raw/ace4113e3c2bb2fc3fa0f86d26ef5f0107e190c2/.github%2Fworkflows%2F_run-unit-tests.yml",
      "sha": "c0af98983d2f9e671f05dfdb11ca49a7d715aee3",
      "status": "modified"
    }
