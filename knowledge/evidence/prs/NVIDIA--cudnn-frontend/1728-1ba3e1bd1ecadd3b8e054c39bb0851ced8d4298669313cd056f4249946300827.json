  "files": [
    {
      "additions": 2,
      "blob_url": "https://github.com/NVIDIA/cudnn-frontend/blob/f7475532a45d38dd728ef4caed93290fa289f78d/docs%2Ffe-oss-apis%2Fbsa.md",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/NVIDIA/cudnn-frontend/contents/docs%2Ffe-oss-apis%2Fbsa.md?ref=f7475532a45d38dd728ef4caed93290fa289f78d",
      "deletions": 5,
      "filename": "docs/fe-oss-apis/bsa.md",
      "patch": "@@ -40,12 +40,9 @@ environments that force an older DSL.\n \n ## Forward\n \n-The `cudnn.torch` BSA functions are lazy aliases of the existing `cudnn` and\n-`cudnn.BSA` functions, with identical signatures, outputs, and supported configurations.\n-\n ```python\n import torch\n-from cudnn.torch import (\n+from cudnn import (\n     block_sparse_attention_forward,\n     block_sparse_attention_backward,\n     block_sparse_attention_fp8_forward,\n@@ -336,7 +333,7 @@ Compilation is lazy. The first call for a new static configuration JIT-compiles\n the relevant kernel; subsequent calls reuse an in-process cache.\n \n The Torch public surface consists of allocating function wrappers under\n-`cudnn.torch`, also available under `cudnn` and `cudnn.BSA`; there is no separate `APIBase` class or explicit `compile()`\n+`cudnn` and `cudnn.BSA`; there is no separate `APIBase` class or explicit `compile()`\n lifecycle for BSA.\n \n Correctness tests and FP32 references are under",
      "raw_url": "https://github.com/NVIDIA/cudnn-frontend/raw/f7475532a45d38dd728ef4caed93290fa289f78d/docs%2Ffe-oss-apis%2Fbsa.md",
      "sha": "7256ee1652e6d0b1311475d3bae682130783c828",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/NVIDIA/cudnn-frontend/blob/f7475532a45d38dd728ef4caed93290fa289f78d/python%2Fcudnn%2Ftorch%2F__init__.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/NVIDIA/cudnn-frontend/contents/python%2Fcudnn%2Ftorch%2F__init__.py?ref=f7475532a45d38dd728ef4caed93290fa289f78d",
      "deletions": 14,
      "filename": "python/cudnn/torch/__init__.py",
      "patch": "@@ -22,19 +22,6 @@\n ``F.scaled_dot_product_attention`` overrides directly.\n \"\"\"\n \n-from importlib import import_module\n-\n from cudnn.torch.sdpa_provider import calls, install, served_plan_names  # noqa: F401\n \n-_BSA_EXPORTS = (\"block_sparse_attention_forward\", \"block_sparse_attention_backward\", \"block_sparse_attention_fp8_forward\")\n-\n-\n-def __getattr__(name):\n-    if name in _BSA_EXPORTS:\n-        value = getattr(import_module(\"cudnn.block_sparse_attention\"), name)\n-        globals()[name] = value\n-        return value\n-    raise AttributeError(f\"module {__name__!r} has no attribute {name!r}\")\n-\n-\n-__all__ = [*_BSA_EXPORTS, \"calls\", \"install\", \"served_plan_names\"]\n+__all__ = [\"calls\", \"install\", \"served_plan_names\"]",
      "raw_url": "https://github.com/NVIDIA/cudnn-frontend/raw/f7475532a45d38dd728ef4caed93290fa289f78d/python%2Fcudnn%2Ftorch%2F__init__.py",
      "sha": "e605537bc9ee7b4bb3835b513287171235f0f746",
      "status": "modified"
    },
    {
      "additions": 0,
      "blob_url": "https://github.com/NVIDIA/cudnn-frontend/blob/f7475532a45d38dd728ef4caed93290fa289f78d/test%2Fpython%2Fapi_index%2Fapi_index.txt",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/NVIDIA/cudnn-frontend/contents/test%2Fpython%2Fapi_index%2Fapi_index.txt?ref=f7475532a45d38dd728ef4caed93290fa289f78d",
      "deletions": 3,
      "filename": "test/python/api_index/api_index.txt",
      "patch": "@@ -1546,9 +1546,6 @@ cudnn.tensor_reordering.NONE\n cudnn.tensor_reordering.name\n cudnn.tensor_reordering.value\n cudnn.torch\n-cudnn.torch.block_sparse_attention_backward\n-cudnn.torch.block_sparse_attention_forward\n-cudnn.torch.block_sparse_attention_fp8_forward\n cudnn.torch.calls\n cudnn.torch.install\n cudnn.torch.served_plan_names",
      "raw_url": "https://github.com/NVIDIA/cudnn-frontend/raw/f7475532a45d38dd728ef4caed93290fa289f78d/test%2Fpython%2Fapi_index%2Fapi_index.txt",
      "sha": "631f1480f75a8c5afdcd63a4bd082a1d444daee8",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/NVIDIA/cudnn-frontend/blob/f7475532a45d38dd728ef4caed93290fa289f78d/test%2Fpython%2Fblock_sparse_attention%2Fcutedsl%2Ftest_BSA_jax_parity.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/NVIDIA/cudnn-frontend/contents/test%2Fpython%2Fblock_sparse_attention%2Fcutedsl%2Ftest_BSA_jax_parity.py?ref=f7475532a45d38dd728ef4caed93290fa289f78d",
      "deletions": 5,
      "filename": "test/python/block_sparse_attention/cutedsl/test_BSA_jax_parity.py",
      "patch": "@@ -58,15 +58,15 @@ def find_spec(self, fullname, *args):\n sys.meta_path.insert(0, NoJax())\n import torch\n import cudnn\n-import cudnn.torch as ct\n+import cudnn.torch\n assert \"cudnn.block_sparse_attention.api\" not in sys.modules\n for name in (\"block_sparse_attention_forward\", \"block_sparse_attention_backward\", \"block_sparse_attention_fp8_forward\"):\n-    assert name in ct.__all__\n-    assert getattr(ct, name) is getattr(cudnn, name) is getattr(cudnn.BSA, name)\n+    assert not hasattr(cudnn.torch, name)\n+    assert getattr(cudnn, name) is getattr(cudnn.BSA, name)\n q = torch.ones((1, 1, 256, 64), device=\"cuda\", dtype=torch.bfloat16)\n i = torch.arange(2, device=\"cuda\", dtype=torch.int32).expand(1, 1, 2, 2).contiguous()\n-o, lse = ct.block_sparse_attention_forward(q, q, q, i, 2)\n-dq, dk, dv = ct.block_sparse_attention_backward(q, q, q, q, o, lse, i, 2)\n+o, lse = cudnn.block_sparse_attention_forward(q, q, q, i, 2)\n+dq, dk, dv = cudnn.block_sparse_attention_backward(q, q, q, q, o, lse, i, 2)\n torch.testing.assert_close(o, q)\n torch.testing.assert_close(dq, torch.zeros_like(q), atol=1e-3, rtol=0)\n torch.testing.assert_close(dk, torch.zeros_like(q), atol=1e-3, rtol=0)",
      "raw_url": "https://github.com/NVIDIA/cudnn-frontend/raw/f7475532a45d38dd728ef4caed93290fa289f78d/test%2Fpython%2Fblock_sparse_attention%2Fcutedsl%2Ftest_BSA_jax_parity.py",
      "sha": "eb426ffa52f5075e84e4f8901b80e3f2ef17aaeb",
      "status": "modified"
    }
