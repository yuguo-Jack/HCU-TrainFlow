      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Futils%2Fdata.py?ref=51a08c43599de95257852aa5f072f578ba292d5a",
      "deletions": 1,
      "filename": "areal/utils/data.py",
      "patch": "@@ -1517,10 +1517,17 @@ def _build_group_slices(\n                 slices.append(slice(offset, offset + sz))\n                 offset += sz\n             return slices\n-        return [\n+        if self.group_size <= 0:\n+            raise ValueError(f\"group_size must be positive, got {self.group_size}\")\n+\n+        slices = [\n             slice(i * self.group_size, (i + 1) * self.group_size)\n             for i in range(bs // self.group_size)\n         ]\n+        rem = bs % self.group_size\n+        if rem > 0:\n+            slices.append(slice(bs - rem, bs))\n+        return slices\n \n     @torch.no_grad()\n     def __call__(",
      "raw_url": "https://github.com/areal-project/AReaL/raw/51a08c43599de95257852aa5f072f578ba292d5a/areal%2Futils%2Fdata.py",
      "sha": "5323ef626d4f594ff5c94fda371782a85d8c3fe8",
