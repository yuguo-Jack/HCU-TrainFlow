      "changes": 4,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Finfra%2Fscheduler%2Flocal.py?ref=e5b353fff4dbe6cbbb0bed49df307eba56b040d0",
      "deletions": 3,
      "filename": "areal/infra/scheduler/local.py",
      "patch": "@@ -792,9 +792,7 @@ def create_workers(self, job: Job, *args, **kwargs) -> list[str]:\n                         role, f\"Resource allocation failed for worker {idx}\", str(e)\n                     ) from e\n \n-                env = get_env_vars(\n-                    \",\".join([f\"{k}={v}\" for k, v in scheduling.env_vars.items()]),\n-                )\n+                env = get_env_vars(scheduling.env_vars)\n                 if current_platform.device_control_env_var:\n                     env[current_platform.device_control_env_var] = \",\".join(\n                         map(str, gpu_devices)",
      "raw_url": "https://github.com/areal-project/AReaL/raw/e5b353fff4dbe6cbbb0bed49df307eba56b040d0/areal%2Finfra%2Fscheduler%2Flocal.py",
      "sha": "d602eb59ceb635313bba9639492149f9f09b5497",
