    },
    {
      "additions": 17,
      "blob_url": "https://github.com/areal-project/AReaL/blob/e5b353fff4dbe6cbbb0bed49df307eba56b040d0/areal%2Finfra%2Futils%2Flauncher.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Finfra%2Futils%2Flauncher.py?ref=e5b353fff4dbe6cbbb0bed49df307eba56b040d0",
      "deletions": 6,
      "filename": "areal/infra/utils/launcher.py",
      "patch": "@@ -8,6 +8,7 @@\n import subprocess\n import sys\n import time\n+from collections.abc import Mapping\n \n from areal.api.alloc_mode import AllocationType, _AllocationMode\n from areal.utils import logging, name_resolve, names\n@@ -130,19 +131,29 @@ def get_scheduling_spec(config_part):\n         return SchedulingSpec()\n \n \n-def get_env_vars(additional_env_vars: str | None = None) -> dict[str, str]:\n+def get_env_vars(\n+    additional_env_vars: str | Mapping[str, str] | None = None,\n+) -> dict[str, str]:\n     \"\"\"Returns the environment variables for the cluster.\n \n     This function dynamically captures the current Python path (sys.path) to ensure\n     that spawned worker processes can import modules from the same locations as the\n     parent process. This is essential for deserializing custom config classes defined\n     outside the areal package (e.g., in examples/).\n+\n+    ``additional_env_vars`` is either a mapping, whose values are used verbatim, or\n+    a comma-separated ``KEY=VALUE`` string. In the string form only the first ``=``\n+    of each item separates key from value; values containing ``,`` must be passed\n+    as a mapping.\n     \"\"\"\n-    _additional_env_vars = (\n-        dict(item.split(\"=\") for item in additional_env_vars.split(\",\"))\n-        if additional_env_vars\n-        else dict()\n-    )\n+    if isinstance(additional_env_vars, Mapping):\n+        _additional_env_vars = dict(additional_env_vars)\n+    elif additional_env_vars:\n+        _additional_env_vars = dict(\n+            item.split(\"=\", 1) for item in additional_env_vars.split(\",\")\n+        )\n+    else:\n+        _additional_env_vars = {}\n \n     # Dynamically build PYTHONPATH from current sys.path to ensure workers\n     # can import custom modules in controller mode",
      "raw_url": "https://github.com/areal-project/AReaL/raw/e5b353fff4dbe6cbbb0bed49df307eba56b040d0/areal%2Finfra%2Futils%2Flauncher.py",
      "sha": "95b89d9f2166ba9f61721ba9c66989bec4793f7d",
      "status": "modified"
    },
    {
      "additions": 29,
      "blob_url": "https://github.com/areal-project/AReaL/blob/e5b353fff4dbe6cbbb0bed49df307eba56b040d0/tests%2Finfra%2Ftest_launcher_utils.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/tests%2Finfra%2Ftest_launcher_utils.py?ref=e5b353fff4dbe6cbbb0bed49df307eba56b040d0",
      "deletions": 1,
      "filename": "tests/infra/test_launcher_utils.py",
      "patch": "@@ -4,7 +4,7 @@\n from types import SimpleNamespace\n from unittest.mock import patch\n \n-from areal.infra.utils.launcher import run_post_exit_hook\n+from areal.infra.utils.launcher import get_env_vars, run_post_exit_hook\n \n \n def _config(post_exit_hook: str):\n@@ -55,3 +55,31 @@ def test_run_post_exit_hook_timeout_does_not_raise():\n         run_post_exit_hook(_config(\"cleanup\"))\n \n     mock_run.assert_called_once()\n+\n+\n+def test_get_env_vars_mapping_keeps_commas_and_equals_in_values():\n+    env = get_env_vars(\n+        {\n+            \"PYTORCH_CUDA_ALLOC_CONF\": \"expandable_segments:True,max_split_size_mb:128\",\n+            \"X\": \"a=b\",\n+        }\n+    )\n+\n+    assert (\n+        env[\"PYTORCH_CUDA_ALLOC_CONF\"]\n+        == \"expandable_segments:True,max_split_size_mb:128\"\n+    )\n+    assert env[\"X\"] == \"a=b\"\n+\n+\n+def test_get_env_vars_string_splits_on_first_equals_only():\n+    env = get_env_vars(\"A=1,B=x=y\")\n+\n+    assert env[\"A\"] == \"1\"\n+    assert env[\"B\"] == \"x=y\"\n+\n+\n+def test_get_env_vars_without_additional_vars():\n+    assert \"PYTHONPATH\" in get_env_vars()\n+    assert \"PYTHONPATH\" in get_env_vars(None)\n+    assert \"PYTHONPATH\" in get_env_vars({})",
      "raw_url": "https://github.com/areal-project/AReaL/raw/e5b353fff4dbe6cbbb0bed49df307eba56b040d0/tests%2Finfra%2Ftest_launcher_utils.py",
      "sha": "e48079c95095c8c78917390b16691b0f825b17a4",
      "status": "modified"
    }
