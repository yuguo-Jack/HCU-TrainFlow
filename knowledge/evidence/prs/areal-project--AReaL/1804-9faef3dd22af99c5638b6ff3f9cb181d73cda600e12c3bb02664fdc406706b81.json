      "changes": 9,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Fengine%2Fmegatron_utils%2Fmindspeed_gdn_patch.py?ref=0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91",
      "deletions": 5,
      "filename": "areal/engine/megatron_utils/mindspeed_gdn_patch.py",
      "patch": "@@ -19,7 +19,7 @@ def has_mindspeed_gdn_conv1d(mindspeed_gdn: object) -> bool:\n \n \n def ensure_mindspeed_gdn_conv1d() -> bool:\n-    \"\"\"Bind MindSpeed's NPU causal conv into the inherited MCore GDN.\n+    \"\"\"Bind the selected MindSpeed backend's causal conv into MCore GDN.\n \n     Returns True when a varlen conv implementation is available afterwards.\n     \"\"\"\n@@ -30,9 +30,8 @@ def ensure_mindspeed_gdn_conv1d() -> bool:\n         return False\n \n     try:\n-        npu_conv = importlib.import_module(\n-            \"mindspeed.core.ssm.npu_causal_conv1d\"\n-        ).causal_conv1d\n+        backend = importlib.import_module(\"mindspeed.core.ssm.gdn_backend\")\n+        npu_conv = backend.load_gdn_operators().causal_conv1d\n     except (AttributeError, ImportError):\n         return False\n \n@@ -44,5 +43,5 @@ def ensure_mindspeed_gdn_conv1d() -> bool:\n \n     mcore_gdn.causal_conv1d = npu_conv\n     ms_gdn.causal_conv1d = npu_conv\n-    logger.info(\"Activated MindSpeed's NPU varlen causal_conv1d for GDN.\")\n+    logger.info(\"Activated the selected MindSpeed GDN causal_conv1d backend.\")\n     return True",
      "raw_url": "https://github.com/areal-project/AReaL/raw/0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91/areal%2Fengine%2Fmegatron_utils%2Fmindspeed_gdn_patch.py",
      "sha": "d787b435638982d14a70dce33cf15d1d44481300",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/areal-project/AReaL/blob/0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91/areal%2Fengine%2Fmegatron_utils%2Ftriton_l2norm_patch.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Fengine%2Fmegatron_utils%2Ftriton_l2norm_patch.py?ref=0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91",
      "deletions": 0,
      "filename": "areal/engine/megatron_utils/triton_l2norm_patch.py",
      "patch": "@@ -9,6 +9,10 @@\n ``mindspeed.megatron_adaptor`` (which binds ``l2norm`` into ``fla.modules``). No-op\n without MindSpeed; tracked in-repo so it survives image rebuilds.\n \n+Covers MindSpeed's own l2norm only. MindSpeed's GDN backend selector sources\n+l2norm from ``fla_npu`` when that package is installed, which bypasses this patch;\n+the NPU images deliberately omit fla_npu, so the MindSpeed backend is what runs.\n+\n Also despecializes ``NT`` in the GDN chunk kernels (``_despecialize_chunk_nt``) so\n they compile once across sequence lengths instead of recompiling per seqlen -- the\n dominant per-new-seqlen chunk cost. All three are runtime-free compile-once wins.",
      "raw_url": "https://github.com/areal-project/AReaL/raw/0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91/areal%2Fengine%2Fmegatron_utils%2Ftriton_l2norm_patch.py",
      "sha": "8c4463324af1ba1df4679bbf99afa4385aab62ac",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/areal-project/AReaL/blob/0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91/pyproject.npu.toml",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/pyproject.npu.toml?ref=0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91",
      "deletions": 2,
      "filename": "pyproject.npu.toml",
      "patch": "@@ -63,7 +63,10 @@ dependencies = [\n     \"transformers>=5.14.1,<6\",\n     \"huggingface_hub\",\n     \"datasets>=3.0.0\",\n-    \"pyarrow\",\n+    # pyarrow>=26 needs NumPy 2, but the NPU image preinstalls numpy 1.26 for\n+    # triton-ascend and MindSpeed. This lock resolves numpy 2 and so does not\n+    # model that; the ceiling is what keeps installs into the image consistent.\n+    \"pyarrow<26\",\n     # AReaL's Lightning Attention uses FLA directly.\n     \"flash-linear-attention\",\n     \"mbridge @ git+https://github.com/ISEEKYAN/mbridge.git@08975e6\",\n@@ -128,7 +131,9 @@ dependencies = [\n     # Monitoring and logging\n     \"wandb\",\n     \"tensorboardx\",\n-    \"trackio\",\n+    # trackio caps pillow<13. Unbounded, the resolver satisfies a competing\n+    # pillow>=13 by backtracking to trackio 0.0.6, which predates that cap.\n+    \"trackio>=0.35.0\",\n     \"colorama\",\n     \"colorlog\",\n     \"swanboard==0.1.9b3\",",
      "raw_url": "https://github.com/areal-project/AReaL/raw/0868500caf6a2e3ff76d3ed6c9cf1e82ab1f5b91/pyproject.npu.toml",
      "sha": "64428a416880176bab4c21779b2d1e0da9ab2cd6",
      "status": "modified"
