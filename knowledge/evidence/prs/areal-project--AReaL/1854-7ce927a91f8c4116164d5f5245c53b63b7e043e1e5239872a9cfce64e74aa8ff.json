    {
      "additions": 9,
      "blob_url": "https://github.com/areal-project/AReaL/blob/279b3897fba6dcd450ed6851b28fb79222a27c58/areal%2Fv2%2Ftraining_service%2Fcontroller%2Fcontroller.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Fv2%2Ftraining_service%2Fcontroller%2Fcontroller.py?ref=279b3897fba6dcd450ed6851b28fb79222a27c58",
      "deletions": 1,
      "filename": "areal/v2/training_service/controller/controller.py",
      "patch": "@@ -1159,7 +1159,15 @@ def update_weights(self, meta: Any) -> None:\n             f\"meta.version must be a positive integer, got {meta.version}\"\n         )\n         result = self._weight_update_ctrl.update_weights(version=meta.version)\n-        self.rollout.continue_generation()\n+        # Publish the version before resuming generation. Requests unblocked by\n+        # continue_generation() are served by the new weights, so they must be\n+        # stamped with the new version; otherwise every segment resumed during\n+        # the version broadcast is recorded as pre-update policy and downstream\n+        # importance ratios pick the wrong behavior policy for it.\n+        try:\n+            self.rollout.set_version(meta.version)\n+        finally:\n+            self.rollout.continue_generation()\n         logger.info(\n             \"Weight update v%d completed (%s, %.0fms)\",\n             meta.version,",
      "raw_url": "https://github.com/areal-project/AReaL/raw/279b3897fba6dcd450ed6851b28fb79222a27c58/areal%2Fv2%2Ftraining_service%2Fcontroller%2Fcontroller.py",
      "sha": "341617c06e31684d5354031d900ddfe3a0d0dbad",
      "status": "modified"
    },
    {
      "additions": 42,
      "blob_url": "https://github.com/areal-project/AReaL/blob/279b3897fba6dcd450ed6851b28fb79222a27c58/tests%2Fv2%2Ftraining_service%2Ftest_controller_unit.py",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/tests%2Fv2%2Ftraining_service%2Ftest_controller_unit.py?ref=279b3897fba6dcd450ed6851b28fb79222a27c58",
      "deletions": 0,
      "filename": "tests/v2/training_service/test_controller_unit.py",
      "patch": "@@ -344,3 +344,45 @@ async def mixed_results(addr, shard_ids):\n             \"cancel-node\": {\"s-cancel\": 0},\n         }\n         mock_gateway_post.assert_not_called()\n+\n+\n+class TestUpdateWeightsVersionOrdering:\n+    \"\"\"Resumed generation must already see the post-update version.\"\"\"\n+\n+    @staticmethod\n+    def _controller() -> GatewayTrainController:\n+        controller = _make_controller()\n+        controller._weight_update_ctrl = MagicMock()\n+        controller._weight_update_ctrl.update_weights.return_value = MagicMock(\n+            status=\"ok\", duration_ms=1.0\n+        )\n+        controller.rollout = MagicMock()\n+        return controller\n+\n+    def test_version_published_before_generation_resumes(self):\n+        controller = self._controller()\n+        recorder = MagicMock()\n+        recorder.attach_mock(controller.rollout, \"rollout\")\n+        recorder.attach_mock(controller._weight_update_ctrl, \"weights\")\n+        meta = MagicMock(version=7)\n+\n+        controller.update_weights(meta)\n+\n+        assert [name for name, _, _ in recorder.mock_calls] == [\n+            \"rollout.pause_generation\",\n+            \"weights.update_weights\",\n+            \"rollout.set_version\",\n+            \"rollout.continue_generation\",\n+        ]\n+        controller.rollout.set_version.assert_called_once_with(7)\n+\n+    def test_generation_resumes_even_if_version_broadcast_fails(self):\n+        controller = self._controller()\n+        controller.rollout.set_version.side_effect = RuntimeError(\"broadcast failed\")\n+        meta = MagicMock(version=7)\n+\n+        with pytest.raises(RuntimeError, match=\"broadcast failed\"):\n+            controller.update_weights(meta)\n+\n+        # A failed version broadcast must not leave inference paused forever.\n+        controller.rollout.continue_generation.assert_called_once_with()",
      "raw_url": "https://github.com/areal-project/AReaL/raw/279b3897fba6dcd450ed6851b28fb79222a27c58/tests%2Fv2%2Ftraining_service%2Ftest_controller_unit.py",
      "sha": "db489214025b85ed4e8c4cbacf3282417420105d",
