    {
      "additions": 35,
      "blob_url": "https://github.com/areal-project/AReaL/blob/83ec7a99730c51252f9bfd6b7c2641dfb96420d0/tests%2Ftest_tau2_messages.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/tests%2Ftest_tau2_messages.py?ref=83ec7a99730c51252f9bfd6b7c2641dfb96420d0",
      "deletions": 0,
      "filename": "tests/test_tau2_messages.py",
      "patch": "@@ -0,0 +1,35 @@\n+from copy import deepcopy\n+\n+import pytest\n+\n+\n+def test_clean_messages_preserves_tool_history():\n+    pytest.importorskip(\"tau2\")\n+    from examples.tau2.agent import Tau2Runner\n+\n+    messages = [\n+        {\"role\": \"system\", \"content\": \"you are the user\"},\n+        {\"role\": \"user\", \"content\": \"Have you tried turning it off and on?\"},\n+        {\n+            \"role\": \"assistant\",\n+            \"content\": None,\n+            \"tool_calls\": [\n+                {\n+                    \"id\": \"c1\",\n+                    \"type\": \"function\",\n+                    \"function\": {\"name\": \"check_status_bar\", \"arguments\": \"{}\"},\n+                }\n+            ],\n+        },\n+        {\n+            \"role\": \"tool\",\n+            \"tool_call_id\": \"c1\",\n+            \"content\": \"Status bar shows: No Service\",\n+        },\n+    ]\n+    original_messages = deepcopy(messages)\n+\n+    cleaned = Tau2Runner._clean_messages(messages)\n+\n+    assert cleaned == messages\n+    assert messages == original_messages",
      "raw_url": "https://github.com/areal-project/AReaL/raw/83ec7a99730c51252f9bfd6b7c2641dfb96420d0/tests%2Ftest_tau2_messages.py",
      "sha": "b2b6bffcd6d3072eb171b422d770fc8ab605e4c7",
      "status": "added"
    }
