      "additions": 30,
      "blob_url": "https://github.com/areal-project/AReaL/blob/ee2296c8d5e44cd6ef65b2e22c4e70d1a00aabe6/areal%2Futils%2Ftorch_npu_compat.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Futils%2Ftorch_npu_compat.py?ref=ee2296c8d5e44cd6ef65b2e22c4e70d1a00aabe6",
      "deletions": 7,
      "filename": "areal/utils/torch_npu_compat.py",
      "patch": "@@ -12,6 +12,10 @@\n import signal\n import threading\n from types import ModuleType\n+from typing import TYPE_CHECKING\n+\n+if TYPE_CHECKING:\n+    from torch.distributed import P2POp\n \n GROUPED_P2P_ENV = \"AREAL_NPU_GROUPED_P2P\"\n \n@@ -69,6 +73,20 @@ def grouped_p2p_broken(torch_npu_version: str) -> bool:\n     return GROUPED_P2P_FIXED_IN is None or version < Version(GROUPED_P2P_FIXED_IN)\n \n \n+def _split_p2p_ops(p2p_op_list: list[\"P2POp\"]) -> list[list[\"P2POp\"]]:\n+    \"\"\"Keep one operation per direction and peer in each fused HCCL call.\"\"\"\n+    rounds: list[list[P2POp]] = []\n+    counts: dict[tuple[str, int], int] = {}\n+    for op in p2p_op_list:\n+        key = (op.op.__name__, op.peer)\n+        index = counts.get(key, 0)\n+        if index == len(rounds):\n+            rounds.append([])\n+        rounds[index].append(op)\n+        counts[key] = index + 1\n+    return rounds\n+\n+\n def _apply_grouped_p2p_gate() -> None:\n     \"\"\"Route NPU batched P2P away from torch-npu's broken coalescing path.\n \n@@ -120,19 +138,24 @@ def legacy_batch_isend_irecv(p2p_op_list):\n             group = _get_default_group()\n         backend = group._get_backend(p2p_op_list[0].tensor.device)\n \n-        op_type, tensors, remote_rank_list = [], [], []\n         for p2p_op in p2p_op_list:\n             if p2p_op.tensor.device.type != \"npu\":\n                 raise RuntimeError(\n                     \"No backend type associated with device type \"\n                     f\"{p2p_op.tensor.device.type}\"\n                 )\n-            op_type.append(p2p_op.op.__name__)\n-            tensors.append(p2p_op.tensor)\n-            remote_rank_list.append(\n-                get_group_rank(group, p2p_op.peer) if is_multi_pg else p2p_op.peer\n-            )\n-        return [backend.batch_isend_irecv(op_type, tensors, remote_rank_list)]\n+        # HcclBatchSendRecv permits only one memory block per directed peer.\n+        # Match the nth send with the nth receive, even with uneven peer counts.\n+        works = []\n+        for batch in _split_p2p_ops(p2p_op_list):\n+            op_type = [op.op.__name__ for op in batch]\n+            tensors = [op.tensor for op in batch]\n+            remote_rank_list = [\n+                get_group_rank(group, op.peer) if is_multi_pg else op.peer\n+                for op in batch\n+            ]\n+            works.append(backend.batch_isend_irecv(op_type, tensors, remote_rank_list))\n+        return works\n \n     def batch_isend_irecv(p2p_op_list):\n         if p2p_op_list and p2p_op_list[0].tensor.device.type == \"npu\":",
      "raw_url": "https://github.com/areal-project/AReaL/raw/ee2296c8d5e44cd6ef65b2e22c4e70d1a00aabe6/areal%2Futils%2Ftorch_npu_compat.py",
      "sha": "315733d2dc00eaeb4a76839183d5d4674e3d6b1c",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/areal-project/AReaL/blob/ee2296c8d5e44cd6ef65b2e22c4e70d1a00aabe6/tests%2Ftest_torch_npu_compat.py",
      "changes": 45,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/tests%2Ftest_torch_npu_compat.py?ref=ee2296c8d5e44cd6ef65b2e22c4e70d1a00aabe6",
      "deletions": 1,
      "filename": "tests/test_torch_npu_compat.py",
      "patch": "@@ -1,13 +1,56 @@\n # SPDX-License-Identifier: Apache-2.0\n \n import signal\n-from types import ModuleType\n+from types import ModuleType, SimpleNamespace\n \n import pytest\n \n from areal.utils import torch_npu_compat\n \n \n+def test_split_p2p_ops_uneven_peers_preserves_matching_rounds():\n+    \"\"\"Each directed edge keeps its tensor order and agrees on round indices.\"\"\"\n+    sends = SimpleNamespace(__name__=\"isend\")\n+    recvs = SimpleNamespace(__name__=\"irecv\")\n+    edges = {(0, 2): 5, (0, 3): 2, (1, 2): 1, (1, 3): 4, (2, 0): 3}\n+    schedules = {}\n+    for rank in range(4):\n+        ops = []\n+        for (src, dst), count in edges.items():\n+            for index in range(count):\n+                if rank == src:\n+                    ops.append(\n+                        SimpleNamespace(op=sends, peer=dst, tensor=(src, dst, index))\n+                    )\n+                if rank == dst:\n+                    ops.append(\n+                        SimpleNamespace(op=recvs, peer=src, tensor=(src, dst, index))\n+                    )\n+        rounds = torch_npu_compat._split_p2p_ops(ops)\n+        assert sum(map(len, rounds)) == len(ops)\n+        for index, batch in enumerate(rounds):\n+            keys = [(op.op.__name__, op.peer) for op in batch]\n+            assert len(keys) == len(set(keys))\n+            for op in batch:\n+                assert op.tensor[2] == index\n+                schedules[rank, op.tensor] = index\n+    for (src, dst), count in edges.items():\n+        for index in range(count):\n+            assert (\n+                schedules[src, (src, dst, index)] == schedules[dst, (src, dst, index)]\n+            )\n+\n+\n+def test_split_p2p_ops_unique_peers_keeps_one_batch():\n+    \"\"\"Warmup and mixed send/receive pairs need no extra HCCL calls.\"\"\"\n+    ops = [\n+        SimpleNamespace(op=SimpleNamespace(__name__=direction), peer=peer)\n+        for direction, peer in [(\"isend\", 1), (\"irecv\", 1), (\"isend\", 2)]\n+    ]\n+    assert torch_npu_compat._split_p2p_ops(ops) == [ops]\n+    assert torch_npu_compat._split_p2p_ops([]) == []\n+\n+\n def _mock_signal_state(monkeypatch):\n     original_sigint = object()\n     original_sigterm = object()",
      "raw_url": "https://github.com/areal-project/AReaL/raw/ee2296c8d5e44cd6ef65b2e22c4e70d1a00aabe6/tests%2Ftest_torch_npu_compat.py",
      "sha": "120ec2511af576e175bc1e412bfee7892d9a9ab7",
      "status": "modified"
