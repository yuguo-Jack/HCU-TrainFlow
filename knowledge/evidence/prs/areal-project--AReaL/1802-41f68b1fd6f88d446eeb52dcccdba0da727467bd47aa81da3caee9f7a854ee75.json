  "files": [
    {
      "additions": 17,
      "blob_url": "https://github.com/areal-project/AReaL/blob/545198ab373ba03b67470a9d9ffc4a7a2c6412ee/areal%2Futils%2Fsaver.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Futils%2Fsaver.py?ref=545198ab373ba03b67470a9d9ffc4a7a2c6412ee",
      "deletions": 3,
      "filename": "areal/utils/saver.py",
      "patch": "@@ -31,6 +31,11 @@ def __init__(self, config: SaverConfig, ft_spec: FinetuneSpec):\n         )\n         self._async_mode = AsyncMode(config.mode)\n         self._managers: dict[str, AsyncCheckpointManager] = {}\n+        # Trainers call ``save`` once per model (e.g. actor and critic) in the\n+        # same training step. The first call of a step makes the frequency\n+        # decision and later calls of that step reuse it, so every model is\n+        # saved on the same steps and the frequency counter advances once.\n+        self._last_freq_check: tuple[int, bool] | None = None\n \n     @staticmethod\n     def get_save_root(\n@@ -136,9 +141,7 @@ def save(\n             and self.config.freq_secs is None\n         ):\n             return\n-        if not self.freq_ctl.check(\n-            epochs=int(step == self.ft_spec.steps_per_epoch - 1), steps=1\n-        ):\n+        if not self._should_save(step, global_step):\n             return\n         path = Saver.get_model_save_path(\n             self.config.experiment_name,\n@@ -177,6 +180,17 @@ def save(\n             )\n             engine.save(meta)\n \n+    def _should_save(self, step: int, global_step: int) -> bool:\n+        if self._last_freq_check is not None:\n+            last_global_step, should_save = self._last_freq_check\n+            if last_global_step == global_step:\n+                return should_save\n+        should_save = self.freq_ctl.check(\n+            epochs=int(step == self.ft_spec.steps_per_epoch - 1), steps=1\n+        )\n+        self._last_freq_check = (global_step, should_save)\n+        return should_save\n+\n     def _async_save(\n         self,\n         engine: TrainEngine | TrainController,",
      "raw_url": "https://github.com/areal-project/AReaL/raw/545198ab373ba03b67470a9d9ffc4a7a2c6412ee/areal%2Futils%2Fsaver.py",
      "sha": "39f5242ab6512097dd2157e73f59f95db107ecfe",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/areal-project/AReaL/blob/545198ab373ba03b67470a9d9ffc4a7a2c6412ee/tests%2Ftest_saver.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/tests%2Ftest_saver.py?ref=545198ab373ba03b67470a9d9ffc4a7a2c6412ee",
      "deletions": 0,
      "filename": "tests/test_saver.py",
      "patch": "@@ -3,6 +3,8 @@\n from types import SimpleNamespace\n from unittest.mock import Mock\n \n+import pytest\n+\n from areal.api.cli_args import SaverConfig\n from areal.api.io_struct import FinetuneSpec\n from areal.utils.saver import Saver\n@@ -88,3 +90,45 @@ def test_save_with_source_matching_destination_preserves_source_path(tmp_path):\n \n     meta = engine.save.call_args.args[0]\n     assert meta.base_model_path == str(save_path)\n+\n+\n+def _saved_global_steps(engine: Mock) -> list[int]:\n+    return [\n+        int(call.args[0].path.rsplit(\"globalstep\", 1)[1])\n+        for call in engine.save.call_args_list\n+    ]\n+\n+\n+@pytest.mark.parametrize(\n+    (\"freq_kwargs\", \"expected_steps\"),\n+    [\n+        ({\"freq_steps\": 2}, [1, 3, 5]),\n+        ({\"freq_epochs\": 2}, [5]),\n+    ],\n+)\n+def test_save_applies_frequency_once_per_step_for_all_models(\n+    tmp_path, freq_kwargs, expected_steps\n+):\n+    \"\"\"Actor and critic saved in the same step share one frequency decision.\"\"\"\n+    config = SaverConfig(\n+        experiment_name=\"test_exp\",\n+        trial_name=\"test_trial\",\n+        fileroot=str(tmp_path),\n+        mode=\"sync\",\n+        **freq_kwargs,\n+    )\n+    ft_spec = FinetuneSpec(total_train_epochs=2, dataset_size=3, train_batch_size=1)\n+    saver = Saver(config, ft_spec)\n+    saver._should_use_async = Mock(return_value=False)\n+    actor, critic = Mock(), Mock()\n+    actor.config = critic.config = SimpleNamespace(path=None)\n+\n+    global_step = 0\n+    for epoch in range(ft_spec.total_train_epochs):\n+        for step in range(ft_spec.steps_per_epoch):\n+            saver.save(actor, epoch, step, global_step)\n+            saver.save(critic, epoch, step, global_step, name=\"critic\")\n+            global_step += 1\n+\n+    assert _saved_global_steps(actor) == expected_steps\n+    assert _saved_global_steps(critic) == expected_steps",
      "raw_url": "https://github.com/areal-project/AReaL/raw/545198ab373ba03b67470a9d9ffc4a7a2c6412ee/tests%2Ftest_saver.py",
      "sha": "96b94d2a9b60f0f05fd243e8eab8428d3de4abd6",
      "status": "modified"
    }
