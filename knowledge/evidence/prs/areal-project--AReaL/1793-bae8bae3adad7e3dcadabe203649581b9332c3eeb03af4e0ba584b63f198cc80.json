    {
      "additions": 4,
      "blob_url": "https://github.com/areal-project/AReaL/blob/6b598f528ad62c99fca4a486a0b899a8f6fc4831/areal%2Finfra%2Fscheduler%2Fslurm.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/areal%2Finfra%2Fscheduler%2Fslurm.py?ref=6b598f528ad62c99fca4a486a0b899a8f6fc4831",
      "deletions": 1,
      "filename": "areal/infra/scheduler/slurm.py",
      "patch": "@@ -1031,7 +1031,10 @@ def _generate_sbatch_script(\n         # Build final command and export string\n         if self.container_type == \"apptainer\":\n             # For apptainer, pass env vars to singularity\n-            env_string = \" \".join(f\"--env {k}={v}\" for k, v in env_vars_dict.items())\n+            # Preserve each environment assignment as one shell argument.\n+            env_string = \" \".join(\n+                f\"--env {shlex.quote(f'{k}={v}')}\" for k, v in env_vars_dict.items()\n+            )\n             final_cmd = \"singularity exec --no-home --writable-tmpfs --nv\"\n             if self.container_mounts:\n                 final_cmd += f\" --bind {self.container_mounts}\"",
      "raw_url": "https://github.com/areal-project/AReaL/raw/6b598f528ad62c99fca4a486a0b899a8f6fc4831/areal%2Finfra%2Fscheduler%2Fslurm.py",
      "sha": "7d81503a5ef4b8fd4e0900580dc0ba216fffb6ff",
      "status": "modified"
    },
    {
      "additions": 50,
      "blob_url": "https://github.com/areal-project/AReaL/blob/6b598f528ad62c99fca4a486a0b899a8f6fc4831/tests%2Ftest_slurm_reservation_and_env.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/areal-project/AReaL/contents/tests%2Ftest_slurm_reservation_and_env.py?ref=6b598f528ad62c99fca4a486a0b899a8f6fc4831",
      "deletions": 0,
      "filename": "tests/test_slurm_reservation_and_env.py",
      "patch": "@@ -142,6 +142,56 @@ def test_worker_gpu_assignment_preserves_slurm_allocation(\n \n \n class TestUserEnvPrecedence:\n+    @pytest.mark.parametrize(\n+        \"value\",\n+        [\n+            \"4\",\n+            \"/models/model cache\",\n+            '{\"provider\": \"oss\", \"prefix\": \"trial/policy\"}',\n+            \"space and 'single' and \\\"double\\\" quotes\",\n+            \"$(printf expanded) `$UNSET` ; & | < >\",\n+            \"first\\nsecond\",\n+            \"\",\n+        ],\n+    )\n+    def test_generated_script_structured_env_preserves_literal_value(\n+        self, tmp_path, value\n+    ):\n+        \"\"\"Exercise shell parsing without invoking Slurm or a container.\"\"\"\n+        scheduler = object.__new__(SlurmScheduler)\n+        scheduler._n_gpus_per_node = 8\n+        scheduler.experiment_name = \"exp\"\n+        scheduler.trial_name = \"trial\"\n+        scheduler.fileroot = str(tmp_path)\n+        scheduler._slurm_name = lambda role: f\"exp-trial-{role}\"\n+        scheduler.name_resolve_config = NameResolveConfig(\n+            type=\"nfs\", nfs_record_root=str(tmp_path / \"nr\")\n+        )\n+        scheduler.container_type = \"apptainer\"\n+        scheduler.container_mounts = None\n+        scheduler.srun_additional_args = \"--mpi=pmi2\"\n+        spec = SchedulingSpec(\n+            gpu=1, cpu=4, mem=32, image=\"test.sif\", env_vars={\"TEST_VALUE\": value}\n+        )\n+        with mock.patch(\n+            \"areal.infra.scheduler.slurm.build_streaming_log_cmd\",\n+            side_effect=lambda cmd, *args: cmd,\n+        ):\n+            script = scheduler._generate_sbatch_script(\n+                \"actor\", 8, 1, 8, 4, 32768, [spec], None, None\n+            )\n+\n+        result = subprocess.run(\n+            [\"bash\", \"-c\", \"srun() { printf '%s\\\\0' \\\"$@\\\"; }\\n\" + script],\n+            capture_output=True,\n+            check=True,\n+        )\n+\n+        argv = result.stdout.decode().split(\"\\0\")[:-1]\n+        index = argv.index(\"--env\")\n+        assert argv[index + 1] == f\"TEST_VALUE={value}\"\n+        assert argv[index + 2] == \"test.sif\"\n+\n     def test_user_env_wins_over_framework_defaults(self):\n         scheduler = object.__new__(SlurmScheduler)\n         scheduler.enable_tms_offload = False",
      "raw_url": "https://github.com/areal-project/AReaL/raw/6b598f528ad62c99fca4a486a0b899a8f6fc4831/tests%2Ftest_slurm_reservation_and_env.py",
      "sha": "bbc56499b80a6d52b3ef07cf893fb3e005efc002",
      "status": "modified"
    }
