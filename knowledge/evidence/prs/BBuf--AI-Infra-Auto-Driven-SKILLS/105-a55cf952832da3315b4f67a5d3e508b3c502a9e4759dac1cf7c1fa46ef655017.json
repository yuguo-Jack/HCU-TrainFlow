      "changes": 26,
      "contents_url": "https://api.github.com/repos/BBuf/AI-Infra-Auto-Driven-SKILLS/contents/skills%2Fsglang-explainer-video%2Fassets%2Fbrand%2Ffollow-strip.html?ref=4f15911d1326bb9a07b081a106338e16ed9dc880",
      "deletions": 0,
      "filename": "skills/sglang-explainer-video/assets/brand/follow-strip.html",
      "patch": "@@ -0,0 +1,26 @@\n+<!--\n+  SGLang follow strip: required on the LAST frame of every SGLang video (house-style.md §Follow strip).\n+\n+  - Paste the CSS rules into the frame's own <style> (inside #root, frame contract) and the <div> inside\n+    #root, after the frame's own content.\n+  - Layout: the strip sits at y 792–872, just above the caption band. End the frame's own content\n+    above y≈770.\n+  - Timing: reveal it by the start of the frame's last clause and keep it on screen until the frame\n+    ends. The last voice line has a 2 s hold, so it stays readable:\n+      tl.fromTo(\"#fs-follow\", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.6, ease: \"power3.out\" }, T);\n+  - Text and URLs are fixed; do not edit, translate or narrate them. check_frames.mjs fails a last frame\n+    without them.\n+-->\n+<style>\n+#fs-follow{position:absolute;left:96px;top:792px;width:1728px;height:80px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:48px;padding:0 40px;background:#F9E6DB;border:1px solid rgba(31,20,16,0.12);border-radius:12px;white-space:nowrap;}\n+#fs-follow-kicker{font-family:\"Inter\",\"Noto Sans SC\",sans-serif;font-weight:700;font-size:30px;line-height:1;color:#1F1410;}\n+.fs-follow-item{display:flex;align-items:baseline;gap:14px;}\n+.fs-follow-lab{font-family:\"Inter\",\"Noto Sans SC\",sans-serif;font-weight:700;font-size:24px;line-height:1;color:rgba(31,20,16,0.64);}\n+.fs-follow-url{font-family:\"JetBrains Mono\",\"Noto Sans SC\",monospace;font-weight:400;font-size:28px;line-height:1;color:#1F1410;font-variant-ligatures:none;font-feature-settings:\"liga\" 0,\"calt\" 0;}\n+</style>\n+<div id=\"fs-follow\">\n+  <span id=\"fs-follow-kicker\">关注 SGLang</span>\n+  <span class=\"fs-follow-item\"><span class=\"fs-follow-lab\">GitHub</span><span class=\"fs-follow-url\">github.com/sgl-project/sglang</span></span>\n+  <span class=\"fs-follow-item\"><span class=\"fs-follow-lab\">博客</span><span class=\"fs-follow-url\">sglang.io/blog</span></span>\n+  <span class=\"fs-follow-item\"><span class=\"fs-follow-lab\">文档</span><span class=\"fs-follow-url\">docs.sglang.io</span></span>\n+</div>",
      "raw_url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/raw/4f15911d1326bb9a07b081a106338e16ed9dc880/skills%2Fsglang-explainer-video%2Fassets%2Fbrand%2Ffollow-strip.html",
      "sha": "f052174b285a17e78763b1549f10f481a08a3934",
      "status": "added"
    },
    {
      "additions": 20,
      "blob_url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/blob/4f15911d1326bb9a07b081a106338e16ed9dc880/skills%2Fsglang-explainer-video%2Freferences%2Fhouse-style.md",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/BBuf/AI-Infra-Auto-Driven-SKILLS/contents/skills%2Fsglang-explainer-video%2Freferences%2Fhouse-style.md?ref=4f15911d1326bb9a07b081a106338e16ed9dc880",
      "deletions": 0,
      "filename": "skills/sglang-explainer-video/references/house-style.md",
      "patch": "@@ -67,6 +67,26 @@ just before the crossfade; the still PNG keeps the full layout.\n - Only the PR author (name + @login + avatar) and the PR link. No reviewers, approvers, commit counts or status.\n - The name is on screen only — the narration does not read it.\n \n+## Follow strip (last frame of every video)\n+\n+Every SGLang video ends with links that invite viewers to follow the project, as asked by the user.\n+\n+- The last frame shows the fixed strip from `assets/brand/follow-strip.html` (reference render:\n+  `assets/brand/follow-strip-example.png`):\n+  - 关注 SGLang\n+  - GitHub `github.com/sgl-project/sglang`\n+  - 博客 `sglang.io/blog`\n+  - 文档 `docs.sglang.io`\n+- Where it goes: on the author page in PR videos; on the summary / links frame in article videos.\n+- Placement: a peach bar at y 792–872, just above the caption band. The frame's own content ends above y≈770.\n+- Timing: the strip rises in by the start of the frame's last clause and stays until the end. The 2 s hold\n+  after the last line keeps it readable.\n+- Copy it verbatim:\n+  - Do not restyle, translate or shorten the URLs.\n+  - Do not narrate it.\n+  - Do not add other channels (X, Discord, …) unless the user asks.\n+- `check_frames.mjs` fails when the last frame lacks the strip or any of its three URLs.\n+\n ## Delivery\n \n - Final MP4 and the still cover go straight to `~/Desktop`",
      "raw_url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/raw/4f15911d1326bb9a07b081a106338e16ed9dc880/skills%2Fsglang-explainer-video%2Freferences%2Fhouse-style.md",
      "sha": "8e3a9d23d6cb88b6d1b68d2f55323a1ca2d1e25c",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/blob/4f15911d1326bb9a07b081a106338e16ed9dc880/skills%2Fsglang-explainer-video%2Freferences%2Fworker-dispatch.md",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/BBuf/AI-Infra-Auto-Driven-SKILLS/contents/skills%2Fsglang-explainer-video%2Freferences%2Fworker-dispatch.md?ref=4f15911d1326bb9a07b081a106338e16ed9dc880",
      "deletions": 1,
      "filename": "skills/sglang-explainer-video/references/worker-dispatch.md",
      "patch": "@@ -16,9 +16,14 @@ share a stage (same diagram before/after, two code frames) on the same worker.\n   assets/article/figN.png — allowed: <img> inside a hairline card, object-fit: contain, never cropped or filtered.>\n - <Code frames: the <code-*> block is installed at compositions/<block>.html; fill it from the packet's\n   ### Source excerpt and fit its timing to the Scene window (you may inline an adapted copy).>\n+- <Worker holding the LAST frame only: frame <id> is the video's last frame. Paste the SGLang follow strip from\n+  <absolute $SEV_SKILL>/assets/brand/follow-strip.html verbatim: its CSS goes into your <style>, its <div> inside #root.\n+  It sits at y 792–872, so keep that frame's own content above y≈770. Reveal it by the start of the last\n+  clause and keep it to the end. Never edit its text or URLs, and never narrate it.>\n - Read only: the role file, your packets, frame.md (SGLang brand remix: cream #FBF6F1 ground, peach cards\n   #F9E6DB / #F2CFBE, ink #1F1410, accent #D55816 at most once per frame, navy = warm near-black code surface)\n-  and the assets named above. Never open STORYBOARD.md, SCRIPT.md, capture/*, or other workers' frames.\n+  and the assets named above (the last-frame worker also reads follow-strip.html). Never open STORYBOARD.md,\n+  SCRIPT.md, capture/*, or other workers' frames.\n - HARD RULES (each one broke an earlier run):\n   1. Frame contract: the FIRST element inside <template> is the composition root\n      <div id=\"root\" data-composition-id=\"<frame_id>\" data-start=\"0\" data-duration=\"<packet duration>\"",
      "raw_url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/raw/4f15911d1326bb9a07b081a106338e16ed9dc880/skills%2Fsglang-explainer-video%2Freferences%2Fworker-dispatch.md",
      "sha": "07f6f3e7833154ef4ef4c189582487c41dc558da",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/blob/4f15911d1326bb9a07b081a106338e16ed9dc880/skills%2Fsglang-explainer-video%2Fscripts%2Fcheck_frames.mjs",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/BBuf/AI-Infra-Auto-Driven-SKILLS/contents/skills%2Fsglang-explainer-video%2Fscripts%2Fcheck_frames.mjs?ref=4f15911d1326bb9a07b081a106338e16ed9dc880",
      "deletions": 2,
      "filename": "skills/sglang-explainer-video/scripts/check_frames.mjs",
      "patch": "@@ -1,15 +1,19 @@\n #!/usr/bin/env node\n // Validate every compositions/frames/*.html against pr-to-video's frame contract (the same check\n-// assemble-index.mjs runs) and flag system-font CJK faces, which garble in HyperFrames Studio.\n+// assemble-index.mjs runs), flag system-font CJK faces, which garble in HyperFrames Studio, and require\n+// the SGLang follow strip (assets/brand/follow-strip.html) on the last frame.\n //   node check_frames.mjs <project-dir>\n import { readFileSync, readdirSync } from \"node:fs\";\n import { join } from \"node:path\";\n \n const proj = process.argv[2] || \".\";\n const { validateFrameHtml } = await import(join(process.env.SKILL_DIR, \"scripts/lib/frame-contract.mjs\"));\n const dir = join(proj, \"compositions/frames\");\n+// The strip's three links, as follow-strip.html writes them (each URL is a whole <span>).\n+const FOLLOW = [\"github.com/sgl-project/sglang\", \"sglang.io/blog\", \"docs.sglang.io\"];\n+const frames = readdirSync(dir).filter((n) => n.endsWith(\".html\")).sort();\n let bad = 0;\n-for (const f of readdirSync(dir).filter((n) => n.endsWith(\".html\")).sort()) {\n+for (const f of frames) {\n   const html = readFileSync(join(dir, f), \"utf8\");\n   const problems = [];\n   try {\n@@ -19,6 +23,14 @@ for (const f of readdirSync(dir).filter((n) => n.endsWith(\".html\")).sort()) {\n   }\n   if (/src:\\s*local\\(|PingFang|Songti|Hiragino|Microsoft YaHei/.test(html))\n     problems.push('system CJK font (local()/PingFang/Songti) — use the bundled \"Noto Sans SC\"/\"Noto Serif SC\"');\n+  if (f === frames.at(-1)) {\n+    const missing = FOLLOW.filter((u) => !html.includes(`>${u}<`));\n+    if (!html.includes('id=\"fs-follow\"') || missing.length)\n+      problems.push(\n+        `last frame lacks the SGLang follow strip (assets/brand/follow-strip.html)` +\n+          (missing.length ? `: missing ${missing.join(\", \")}` : \"\"),\n+      );\n+  }\n   if (problems.length) bad++;\n   console.log(problems.length ? `FAIL ${f} — ${problems.join(\"; \")}` : `OK   ${f}`);\n }",
      "raw_url": "https://github.com/BBuf/AI-Infra-Auto-Driven-SKILLS/raw/4f15911d1326bb9a07b081a106338e16ed9dc880/skills%2Fsglang-explainer-video%2Fscripts%2Fcheck_frames.mjs",
      "sha": "fdaa2d4050bf24959a2f8541c436c92627d94597",
      "status": "modified"
    }
