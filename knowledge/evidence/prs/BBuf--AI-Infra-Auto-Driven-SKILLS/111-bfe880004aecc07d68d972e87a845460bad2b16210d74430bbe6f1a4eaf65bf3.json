      "patch": "@@ -19,6 +19,11 @@\n     \"LoRA\": \"Lora\",\n     \"Miles\": \"mials\",\n     \"AIME\": \"Aime\",\n+    \"GiB\": \"G B\",\n+    \"KiB\": \"K B\",\n+    \"MoE\": \"M O E\",\n+    \"DeepSeekMoE\": \"Deep Seek M O E\",\n+    \"MegaMoE\": \"Mega M O E\",\n     \"VAE\": \"V A E\",\n     \"DiT\": \"D I T\",\n     \"GEMM\": \"G E M M\",\n@@ -37,7 +42,7 @@\n     \"flashmla\": \"Flash MLA\",\n     \"flashinfer\": \"Flash Infer\",\n     \"topk\": \"top k\",\n-    \"moe\": \"MoE\",\n+    \"moe\": \"M O E\",\n     \"gemm\": \"G E M M\",\n     \"attn\": \"attention\",\n     \"idx\": \"index\",",
