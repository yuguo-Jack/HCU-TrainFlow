    {
      "additions": 17,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/79ab475cb13bfc6f3dc19664a248e6eba29e8c04/tests%2Funit%2Flauncher%2Ftest_multinode_runner.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Flauncher%2Ftest_multinode_runner.py?ref=79ab475cb13bfc6f3dc19664a248e6eba29e8c04",
      "deletions": 0,
      "filename": "tests/unit/launcher/test_multinode_runner.py",
      "patch": "@@ -10,6 +10,7 @@\n                                        apply_num_nodes_and_gpus)\n import os\n import pytest\n+import shlex\n \n \n @pytest.fixture\n@@ -29,6 +30,22 @@ def test_pdsh_runner(runner_info):\n     assert env['PDSH_RCMD_TYPE'] == 'ssh'\n \n \n+def test_pdsh_kill_cmd_with_venv_script(runner_info):\n+    # pdsh hands the kill command to the remote shell as one line, so with --venv_script the\n+    # \"cd ...;\" in the launch command must not leak into the pkill pattern and split it.\n+    env, resource_pool, world_info, _ = runner_info\n+    kill_cmds = []\n+    for extra_args in ([], ['--venv_script', '/opt/venv/bin/activate']):\n+        args = parse_args(extra_args + ['test_launcher.py'])\n+        runner = mnrunner.PDSHRunner(args, world_info)\n+        _, kill_cmd, _ = runner.get_cmd(deepcopy(env), resource_pool)\n+        kill_cmds.append(kill_cmd)\n+    assert kill_cmds[0] == kill_cmds[1]\n+    remote_cmd = shlex.split(\" \".join(kill_cmds[1][kill_cmds[1].index('pkill -f '):]))\n+    assert remote_cmd[:2] == ['pkill', '-f']\n+    assert len(remote_cmd) == 3 and 'deepspeed.launcher.launc' in remote_cmd[2]\n+\n+\n def test_openmpi_runner(runner_info):\n     env, resource_pool, world_info, args = runner_info\n     runner = mnrunner.OpenMPIRunner(args, world_info, resource_pool)",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/79ab475cb13bfc6f3dc19664a248e6eba29e8c04/tests%2Funit%2Flauncher%2Ftest_multinode_runner.py",
