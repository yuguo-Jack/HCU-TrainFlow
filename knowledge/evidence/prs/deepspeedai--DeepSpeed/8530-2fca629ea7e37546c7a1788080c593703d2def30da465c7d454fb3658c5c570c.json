      "additions": 1,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/937b377347dbae5b4b0af05a4eefd8390f0f3b1e/deepspeed%2Futils%2Fzero_to_fp32.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Futils%2Fzero_to_fp32.py?ref=937b377347dbae5b4b0af05a4eefd8390f0f3b1e",
      "deletions": 2,
      "filename": "deepspeed/utils/zero_to_fp32.py",
      "patch": "@@ -519,12 +519,11 @@ def _zero3_merge_trainable_params(state_dict, world_size, fp32_flat_groups, zero\n \n     if debug:\n         for i in range(world_size):\n-            print(f\"{FP32_FLAT_GROUPS}[{i}].shape={fp32_flat_groups[i].shape}\")\n+            print(f\"{FP32_FLAT_GROUPS}[{i}].shapes={[group.shape for group in fp32_flat_groups[i]]}\")\n \n         wanted_params = len(param_shapes)\n         wanted_numel = sum(shape.numel() for shape in param_shapes.values())\n         # not asserting if there is a mismatch due to possible padding\n-        avail_numel = fp32_flat_groups[0].numel() * world_size\n         print(f\"Trainable params: Have {avail_numel} numels to process.\")\n         print(f\"Trainable params: Need {wanted_numel} numels in {wanted_params} params.\")\n ",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/937b377347dbae5b4b0af05a4eefd8390f0f3b1e/deepspeed%2Futils%2Fzero_to_fp32.py",
      "sha": "ea86525f8ad5467d0bfb6f1674efedc95b262ca7",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/937b377347dbae5b4b0af05a4eefd8390f0f3b1e/tests%2Funit%2Fcheckpoint%2Ftest_convert_checkpoint.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fcheckpoint%2Ftest_convert_checkpoint.py?ref=937b377347dbae5b4b0af05a4eefd8390f0f3b1e",
      "deletions": 0,
      "filename": "tests/unit/checkpoint/test_convert_checkpoint.py",
      "patch": "@@ -4,6 +4,8 @@\n # DeepSpeed Team\n \n import json\n+import os\n+from pathlib import Path\n import shutil\n import subprocess\n import sys\n@@ -267,3 +269,45 @@ def test_buffer_round_trip(self, tmp_path, zero_stage, dtype):\n             torch.testing.assert_close(restored(inputs.cpu()), reference(inputs.cpu()), rtol=0, atol=0)\n         dist.barrier()\n         engine.destroy()\n+\n+\n+def test_debug_export_of_zero3_checkpoint(tmp_path):\n+    checkpoint = tmp_path / \"checkpoint\"\n+    checkpoint.mkdir()\n+    expected = {\"weight\": torch.arange(6, dtype=torch.float32).reshape(2, 3), \"bias\": torch.tensor([7.0, 8.0])}\n+    torch.save(\n+        {\n+            \"module\": {},\n+            \"buffer_names\": [],\n+            \"param_shapes\": [{\n+                \"weight\": expected[\"weight\"].shape\n+            }, {\n+                \"bias\": expected[\"bias\"].shape\n+            }],\n+            \"shared_params\": {},\n+        }, checkpoint / \"mp_rank_00_model_states.pt\")\n+    torch.save(\n+        {\n+            \"optimizer_state_dict\": {\n+                \"zero_stage\": 3,\n+                \"partition_count\": 1,\n+                \"fp32_flat_groups\": [expected[\"weight\"].flatten(), expected[\"bias\"]],\n+            }\n+        }, checkpoint / \"zero_pp_rank_0_mp_rank_00_optim_states.pt\")\n+    output_dir = tmp_path / \"export\"\n+    result = subprocess.run([\n+        sys.executable, \"-m\", \"deepspeed.utils.zero_to_fp32\",\n+        str(tmp_path),\n+        str(output_dir), \"--tag\", \"checkpoint\", \"--debug\"\n+    ],\n+                            cwd=Path(deepspeed.__file__).resolve().parents[1],\n+                            env={\n+                                **os.environ, \"PYTHONPATH\": str(Path(deepspeed.__file__).resolve().parents[1])\n+                            },\n+                            capture_output=True,\n+                            text=True)\n+    assert result.returncode == 0, result.stdout + result.stderr\n+    actual = torch.load(output_dir / \"pytorch_model.bin\", weights_only=True)\n+    assert actual.keys() == expected.keys()\n+    for name, value in expected.items():\n+        torch.testing.assert_close(actual[name], value)",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/937b377347dbae5b4b0af05a4eefd8390f0f3b1e/tests%2Funit%2Fcheckpoint%2Ftest_convert_checkpoint.py",
      "sha": "432a8d0876ad7e93f7f2b584150dbc353a98534f",
      "status": "modified"
    }
