      "additions": 5,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/6b7712e96d82c9463d8aa90be8fe63f30523bf08/deepspeed%2Fcompile%2Ffx.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fcompile%2Ffx.py?ref=6b7712e96d82c9463d8aa90be8fe63f30523bf08",
      "deletions": 1,
      "filename": "deepspeed/compile/fx.py",
      "patch": "@@ -180,7 +180,11 @@ def find_node_by_tag(gm: GraphModule, tag: str) -> Optional[Node]:\n     for node in gm.graph.nodes:\n         # https://github.com/pytorch/pytorch/blob/085b71eab05cbc7d474a173884269c62d2778f77/torch/_dynamo/utils.py#L5048\n         tensor_dict = node.meta.get('tensor_dict')\n-        if tensor_dict and tensor_dict.get('tag') == tag:\n+        node_tag = tensor_dict.get('tag') if tensor_dict else None\n+        # prepare_autosp_inputs tags tensors with (key, seq_dim); a bare key is also accepted.\n+        if isinstance(node_tag, tuple):\n+            node_tag = node_tag[0]\n+        if node_tag == tag:\n             input_id_node = node\n             break\n     return input_id_node",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/6b7712e96d82c9463d8aa90be8fe63f30523bf08/deepspeed%2Fcompile%2Ffx.py",
      "sha": "965666e2efd17e0f15bcfece6afbcbfccd5f22a8",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/6b7712e96d82c9463d8aa90be8fe63f30523bf08/deepspeed%2Fcompile%2Fpasses%2Fsp_compile.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fcompile%2Fpasses%2Fsp_compile.py?ref=6b7712e96d82c9463d8aa90be8fe63f30523bf08",
      "deletions": 5,
      "filename": "deepspeed/compile/passes/sp_compile.py",
      "patch": "@@ -17,7 +17,8 @@\n \n from ..custom_ops import all_to_all, sp_dp_registry  # noqa: F401\n from ..fx import find_node_by_name, get_node_shape_meta\n-from ..util import get_input_id_node, get_label_id_node, get_position_id_node, shard_tensor_node, get_sdpa_nodes\n+from ..util import (get_autosp_seq_dim, get_input_id_node, get_label_id_node, get_position_id_node, shard_tensor_node,\n+                    get_sdpa_nodes)\n \n \n def prepare_autosp_inputs(input_id: torch.Tensor,\n@@ -43,6 +44,8 @@ def prepare_autosp_inputs(input_id: torch.Tensor,\n \n     if seq_dim < 0 or seq_dim >= input_id.ndim:\n         raise ValueError(f\"seq_dim {seq_dim} must be a valid index for input_id with shape {input_id.shape}\")\n+    if seq_dim >= label_id.ndim:\n+        raise ValueError(f\"seq_dim {seq_dim} is out of bounds for label_id with shape {label_id.shape}\")\n \n     if position_id is not None:\n         if seq_dim >= position_id.ndim:\n@@ -60,10 +63,11 @@ def prepare_autosp_inputs(input_id: torch.Tensor,\n     if attention_mask is not None:\n         torch._dynamo.decorators.mark_dynamic(attention_mask, seq_dim)\n \n-    input_id.tag = constants.AUTOSP_INPUT_ID_KEY\n-    label_id.tag = constants.AUTOSP_LABEL_ID_KEY\n+    # Dynamo only carries the `tag` attribute into graph metadata, so seq_dim must travel inside it.\n+    input_id.tag = (constants.AUTOSP_INPUT_ID_KEY, seq_dim)\n+    label_id.tag = (constants.AUTOSP_LABEL_ID_KEY, seq_dim)\n     if position_id is not None:\n-        position_id.tag = constants.AUTOSP_POSITION_ID_KEY\n+        position_id.tag = (constants.AUTOSP_POSITION_ID_KEY, seq_dim)\n \n     return input_id, label_id, position_id, attention_mask\n \n@@ -77,7 +81,7 @@ def pass_shard_seq_dim(gm: GraphModule, example_inputs):\n \n     input_ids_node = get_input_id_node(gm)\n     val = get_node_shape_meta(input_ids_node)\n-    seq_symint = val.shape[1]\n+    seq_symint = val.shape[get_autosp_seq_dim(input_ids_node)]\n     assert isinstance(\n         seq_symint,\n         torch.SymInt), f\"expected sequence dimension to be of type {torch.SymInt!r} but found {type(seq_symint)!r}\"",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/6b7712e96d82c9463d8aa90be8fe63f30523bf08/deepspeed%2Fcompile%2Fpasses%2Fsp_compile.py",
      "sha": "a46c3fa2065f25ff089c35e68a3fa075fc517d70",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/6b7712e96d82c9463d8aa90be8fe63f30523bf08/deepspeed%2Fcompile%2Futil.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fcompile%2Futil.py?ref=6b7712e96d82c9463d8aa90be8fe63f30523bf08",
      "deletions": 2,
      "filename": "deepspeed/compile/util.py",
      "patch": "@@ -591,6 +591,15 @@ def get_position_id_node(gm: GraphModule) -> Node:\n     return node\n \n \n+def get_autosp_seq_dim(tensor_node: Node) -> int:\n+    \"\"\"Return the sequence dimension recorded by prepare_autosp_inputs, defaulting to 1.\"\"\"\n+    tensor_dict = tensor_node.meta.get(\"tensor_dict\") or {}\n+    tag = tensor_dict.get(\"tag\")\n+    if isinstance(tag, tuple):\n+        return tag[1]\n+    return 1\n+\n+\n def create_symbolic_slice_indices(\n     gm: GraphModule,\n     sym_seq_dim_node: Node,\n@@ -610,7 +619,8 @@ def shard_tensor_node(gm: GraphModule, tensor_node: Node):\n     val = get_node_shape_meta(tensor_node)\n     assert val is not None, f\"Node {tensor_node.name} has no shape metadata\"\n \n-    seq_len = val.shape[1]\n+    seq_dim = get_autosp_seq_dim(tensor_node)\n+    seq_len = val.shape[seq_dim]\n \n     assert isinstance(\n         seq_len,\n@@ -620,7 +630,7 @@ def shard_tensor_node(gm: GraphModule, tensor_node: Node):\n     assert symb_seq_int_node, f\"Unable to find symbolic placeholder for {seq_len}\"\n \n     slice_all, slice_range = create_symbolic_slice_indices(gm, symb_seq_int_node)\n-    indices = (slice_all, slice_range)\n+    indices = tuple(slice_range if dim == seq_dim else slice_all for dim in range(val.ndim))\n \n     positions = {node: i for i, node in enumerate(gm.graph.nodes)}\n     # Insert after the later dependency so the new getitem does not appear",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/6b7712e96d82c9463d8aa90be8fe63f30523bf08/deepspeed%2Fcompile%2Futil.py",
      "sha": "f111804947ac713d0c198d7175183f0cfbcfc7c6",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/6b7712e96d82c9463d8aa90be8fe63f30523bf08/docs%2Fcode-docs%2Fsource%2Ftraining.rst",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/docs%2Fcode-docs%2Fsource%2Ftraining.rst?ref=6b7712e96d82c9463d8aa90be8fe63f30523bf08",
      "deletions": 0,
      "filename": "docs/code-docs/source/training.rst",
      "patch": "@@ -742,6 +742,8 @@ automatic sharding:\n     )\n \n This serves as a hint to the compiler to know which inputs should be sharded across which dimension.\n+``seq_dim`` applies to every prepared tensor, so use ``seq_dim=0`` for sequence-first ``[seq, batch]`` inputs.\n+The compiler records it on the tagged inputs and shards along that dimension.\n \n Memory Optimization\n ~~~~~~~~~~~~~~~~~~~",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/6b7712e96d82c9463d8aa90be8fe63f30523bf08/docs%2Fcode-docs%2Fsource%2Ftraining.rst",
      "sha": "ee29840f80a6bc5b4032753ec715cf962d4c2e7a",
      "status": "modified"
    },
    {
      "additions": 95,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/6b7712e96d82c9463d8aa90be8fe63f30523bf08/tests%2Funit%2Fv1%2Fcompile%2Ftest_compile_autosp.py",
      "changes": 95,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fv1%2Fcompile%2Ftest_compile_autosp.py?ref=6b7712e96d82c9463d8aa90be8fe63f30523bf08",
      "deletions": 0,
      "filename": "tests/unit/v1/compile/test_compile_autosp.py",
      "patch": "@@ -3,6 +3,7 @@\n \n # DeepSpeed Team\n \n+import copy\n import operator\n import re\n from unittest.mock import patch\n@@ -87,6 +88,100 @@ def test(self, zero_stage, dtype, sp_size):\n         compare_sp_loss(self, config_dict, sp_size)\n \n \n+class _SeqDimModel(torch.nn.Module):\n+    \"\"\"Causal single-layer transformer whose inputs carry the sequence on `seq_dim` of a 2-D [seq, batch] layout.\"\"\"\n+\n+    def __init__(self, seq_dim, vocab_size=64, hidden=32, num_heads=2):\n+        super().__init__()\n+        self.seq_dim = seq_dim\n+        self.num_heads = num_heads\n+        self.embed = torch.nn.Embedding(vocab_size, hidden)\n+        self.pos_embed = torch.nn.Embedding(1024, hidden)\n+        self.qkv = torch.nn.Linear(hidden, 3 * hidden)\n+        self.out = torch.nn.Linear(hidden, hidden)\n+        self.head = torch.nn.Linear(hidden, vocab_size)\n+\n+    def forward(self, input_ids, labels, position_ids):\n+        if self.seq_dim == 1:\n+            input_ids, labels, position_ids = input_ids.t(), labels.t(), position_ids.t()\n+        seq_len, batch = input_ids.shape\n+        x = self.embed(input_ids) + self.pos_embed(position_ids)\n+        q, k, v = self.qkv(x).chunk(3, dim=-1)\n+\n+        def to_heads(t):\n+            return t.view(seq_len, batch, self.num_heads, -1).permute(1, 2, 0, 3)\n+\n+        attn = F.scaled_dot_product_attention(to_heads(q), to_heads(k), to_heads(v), is_causal=True)\n+        x = x + self.out(attn.permute(2, 0, 1, 3).reshape(seq_len, batch, -1))\n+        logits = self.head(x)\n+        return F.cross_entropy(logits.reshape(-1, logits.size(-1)), labels.reshape(-1))\n+\n+\n+class TestAutoSPSeqDim(DistributedTest):\n+    world_size = 2\n+    non_daemonic_procs = True\n+\n+    @pytest.mark.sequential\n+    @pytest.mark.parametrize(\"seq_dim\", [0, 1])\n+    def test_matches_full_sequence_reference(self, seq_dim):\n+        import deepspeed\n+        import deepspeed.comm as dist\n+        from deepspeed.compile.passes.sp_compile import prepare_autosp_inputs\n+\n+        if get_accelerator().device_name() == \"cpu\":\n+            pytest.skip(\"CPU does not support this test yet\")\n+\n+        sp_size = self.world_size\n+        seq_len, batch, vocab_size = 16, 2, 64\n+        device = get_accelerator().current_device_name()\n+\n+        torch.manual_seed(0)\n+        reference = _SeqDimModel(seq_dim, vocab_size=vocab_size).to(device)\n+        config = {\n+            \"train_micro_batch_size_per_gpu\": batch,\n+            \"train_batch_size\": batch,\n+            \"zero_optimization\": {\n+                \"stage\": 0\n+            },\n+            \"compile\": {\n+                \"deepcompile\": True,\n+                \"passes\": [\"autosp\"]\n+            },\n+            \"sequence_parallel_size\": sp_size,\n+        }\n+        engine, _, _, _ = deepspeed.initialize(config=config, model=copy.deepcopy(reference))\n+        engine.compile()\n+\n+        # Only forward losses are compared: they pin which dimension is sharded without\n+        # depending on how gradients are reduced across the SP group.\n+        for step in range(3):\n+            torch.manual_seed(100 + step)\n+            input_ids = torch.randint(0, vocab_size, (seq_len, batch), device=device)\n+            labels = torch.randint(0, vocab_size, (seq_len, batch), device=device)\n+            position_ids = torch.arange(seq_len, device=device).unsqueeze(1).expand(seq_len, batch)\n+            if seq_dim == 1:\n+                input_ids, labels, position_ids = input_ids.t(), labels.t(), position_ids.t()\n+            input_ids, labels, position_ids = (t.contiguous() for t in (input_ids, labels, position_ids))\n+\n+            with torch.no_grad():\n+                reference_loss = reference(input_ids, labels, position_ids)\n+\n+            autosp_inputs = prepare_autosp_inputs(input_ids.clone(),\n+                                                  labels.clone(),\n+                                                  position_ids.clone(),\n+                                                  seq_dim=seq_dim)\n+            loss = engine(*autosp_inputs[:3])\n+\n+            # The SP group is the whole world. Every rank holds the mean over an equally sized\n+            # shard of the sequence, so their average is the full-sequence mean.\n+            global_loss = loss.detach().clone()\n+            dist.all_reduce(global_loss)\n+            global_loss /= sp_size\n+            torch.testing.assert_close(global_loss, reference_loss, rtol=1e-4, atol=1e-5)\n+\n+        engine.destroy()\n+\n+\n class TestAutoSPMeshRegistry(DistributedTest):\n     \"\"\"Re-registering the mesh an engine already uses keeps the existing process groups.\"\"\"\n     world_size = 4",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/6b7712e96d82c9463d8aa90be8fe63f30523bf08/tests%2Funit%2Fv1%2Fcompile%2Ftest_compile_autosp.py",
      "sha": "189800ad97b2f409e0d5057145e2521609f75722",
      "status": "modified"
    }
