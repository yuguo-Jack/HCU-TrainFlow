      "changes": 13,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/csrc%2Faio%2Fpy_lib%2Fdeepspeed_py_io_handle.cpp?ref=c9f8ae6af69e1100cb384f9ed9e7000a17f12c75",
      "deletions": 2,
      "filename": "csrc/aio/py_lib/deepspeed_py_io_handle.cpp",
      "patch": "@@ -59,8 +59,17 @@ deepspeed_io_handle_t::deepspeed_io_handle_t(const int block_size,\n \n deepspeed_io_handle_t::~deepspeed_io_handle_t()\n {\n-    _stop_threads();\n-    for (auto& thr : _threads) { thr.join(); }\n+    const auto stop_and_join = [this]() {\n+        _stop_threads();\n+        for (auto& thr : _threads) { thr.join(); }\n+    };\n+\n+    if (PyGILState_Check()) {\n+        py::gil_scoped_release release;\n+        stop_and_join();\n+    } else {\n+        stop_and_join();\n+    }\n }\n \n const int deepspeed_io_handle_t::get_block_size() const",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/c9f8ae6af69e1100cb384f9ed9e7000a17f12c75/csrc%2Faio%2Fpy_lib%2Fdeepspeed_py_io_handle.cpp",
      "sha": "2396a9437ac24fa2350a054881a1e814f7a46a26",
      "status": "modified"
    },
    {
      "additions": 55,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/c9f8ae6af69e1100cb384f9ed9e7000a17f12c75/tests%2Funit%2Fops%2Faio%2Ftest_aio_handle.py",
      "changes": 55,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fops%2Faio%2Ftest_aio_handle.py?ref=c9f8ae6af69e1100cb384f9ed9e7000a17f12c75",
      "deletions": 0,
      "filename": "tests/unit/ops/aio/test_aio_handle.py",
      "patch": "@@ -0,0 +1,55 @@\n+# Copyright (c) DeepSpeed Team.\n+# SPDX-License-Identifier: Apache-2.0\n+\n+# DeepSpeed Team\n+\n+import sys\n+import threading\n+\n+import pytest\n+\n+import deepspeed\n+from deepspeed.ops.op_builder import AsyncIOBuilder\n+\n+BLOCK_SIZE = 4096\n+QUEUE_DEPTH = 2\n+INTRA_OP_PARALLELISM = 2\n+MAX_HANDLE_DESTRUCTORS = 32\n+\n+\n+def test_aio_handle_destructor_releases_gil():\n+    if not deepspeed.ops.__compatible_ops__[AsyncIOBuilder.NAME]:\n+        pytest.skip(\"async_io is not compatible with this environment\")\n+\n+    aio_handle = AsyncIOBuilder().load().aio_handle\n+    peer_ready = threading.Event()\n+    peer_ran = threading.Event()\n+    gate = threading.Lock()\n+    gate.acquire()\n+\n+    def run_peer():\n+        peer_ready.set()\n+        with gate:\n+            peer_ran.set()\n+\n+    peer = threading.Thread(target=run_peer)\n+    peer.start()\n+\n+    original_switch_interval = sys.getswitchinterval()\n+    try:\n+        assert peer_ready.wait(timeout=5)\n+        sys.setswitchinterval(60)\n+        gate.release()\n+        for _ in range(MAX_HANDLE_DESTRUCTORS):\n+            handle = aio_handle(BLOCK_SIZE, QUEUE_DEPTH, True, True, INTRA_OP_PARALLELISM)\n+            del handle\n+            if peer_ran.is_set():\n+                break\n+        assert peer_ran.is_set(), \"aio_handle destructor held the GIL while joining its worker threads\"\n+    finally:\n+        sys.setswitchinterval(original_switch_interval)\n+        if gate.locked():\n+            gate.release()\n+        peer.join(timeout=5)\n+\n+    assert not peer.is_alive()",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/c9f8ae6af69e1100cb384f9ed9e7000a17f12c75/tests%2Funit%2Fops%2Faio%2Ftest_aio_handle.py",
      "sha": "5037021ec466aa84fc5c881cffd49833f949f173",
      "status": "added"
    }
  ],
