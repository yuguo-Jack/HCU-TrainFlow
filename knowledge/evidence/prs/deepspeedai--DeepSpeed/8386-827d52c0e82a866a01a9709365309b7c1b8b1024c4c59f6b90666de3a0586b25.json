      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/62ecf0a1d347acf4485071fb219408b1b69db4f6/deepspeed%2Fruntime%2Futils.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Futils.py?ref=62ecf0a1d347acf4485071fb219408b1b69db4f6",
      "deletions": 1,
      "filename": "deepspeed/runtime/utils.py",
      "patch": "@@ -882,7 +882,7 @@ def mask_nan_or_inf_with_val_inplace(input, device=None, val=-1.):\n     norm_is_inf = input.isinf()\n     norm_is_nan = input.isnan()\n     inf_or_nan = norm_is_nan.logical_or(norm_is_inf)\n-    err = torch.tensor(-1.0, device=device, dtype=torch.float)\n+    err = torch.tensor(val, device=device, dtype=torch.float)\n     input.masked_fill_(inf_or_nan, err)\n \n ",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/62ecf0a1d347acf4485071fb219408b1b69db4f6/deepspeed%2Fruntime%2Futils.py",
