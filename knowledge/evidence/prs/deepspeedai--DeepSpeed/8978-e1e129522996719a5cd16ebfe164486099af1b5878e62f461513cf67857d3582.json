      "changes": 4,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Flauncher%2Flauncher_helper.py?ref=8755d1cbaa84a342750edc1eb51d70d7ecc3d043",
      "deletions": 0,
      "filename": "deepspeed/launcher/launcher_helper.py",
      "patch": "@@ -103,6 +103,10 @@ def main(args=None):\n     result = subprocess.Popen(cmd, env=env, close_fds=False)\n     result.wait()\n \n+    # mpirun only sees this process' exit status, so pass the user script's failure on to it\n+    if result.returncode != 0:\n+        sys.exit(result.returncode)\n+\n \n if __name__ == \"__main__\":\n     main()",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/8755d1cbaa84a342750edc1eb51d70d7ecc3d043/deepspeed%2Flauncher%2Flauncher_helper.py",
      "sha": "a445548912a24983a04243313eadddd49bde372c",
      "status": "modified"
    },
    {
      "additions": 21,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/8755d1cbaa84a342750edc1eb51d70d7ecc3d043/tests%2Funit%2Flauncher%2Ftest_launcher_helper.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Flauncher%2Ftest_launcher_helper.py?ref=8755d1cbaa84a342750edc1eb51d70d7ecc3d043",
      "deletions": 0,
      "filename": "tests/unit/launcher/test_launcher_helper.py",
      "patch": "@@ -0,0 +1,21 @@\n+# Copyright (c) Microsoft Corporation.\n+# SPDX-License-Identifier: Apache-2.0\n+\n+# DeepSpeed Team\n+\n+import pytest\n+\n+from deepspeed.launcher import launcher_helper\n+\n+\n+def test_launcher_helper_propagates_exit_code(tmp_path, monkeypatch):\n+    # mpirun only sees the helper's exit status, so a failing user script has to fail the helper too.\n+    for name in ('PMIX_RANK', 'PALS_LOCAL_RANKID'):\n+        monkeypatch.delenv(name, raising=False)\n+    monkeypatch.setenv('PMI_RANK', '0')\n+    monkeypatch.setenv('MPI_LOCALRANKID', '0')\n+    script = tmp_path / 'failing_script.py'\n+    script.write_text('import sys\\nsys.exit(3)\\n')\n+    with pytest.raises(SystemExit) as exc_info:\n+        launcher_helper.main(['--launcher', 'mpich', str(script)])\n+    assert exc_info.value.code == 3",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/8755d1cbaa84a342750edc1eb51d70d7ecc3d043/tests%2Funit%2Flauncher%2Ftest_launcher_helper.py",
      "sha": "45c99e1fac8ed4fa64981beecd31695a00eb4932",
      "status": "added"
    }
