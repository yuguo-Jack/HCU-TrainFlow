      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fstate_dict_factory.py?ref=59c4748bd5827febc8cf4928c5cd75bd48026718",
      "deletions": 1,
      "filename": "deepspeed/runtime/state_dict_factory.py",
      "patch": "@@ -335,7 +335,7 @@ def merge_state_dict(self,\n                         new_client_sd[key] = torch.cat(value_list, axis=0)\n                     else:\n                         new_client_sd[key] = self.merge_query_key_value(value_list, ckpt_ver)\n-            elif \"mlp.dense_h_to_4h.weight\" in key or \"word_embeddings.weight\" in key or \"mlp.dense_h_to_4h.bias\" in key:\n+            elif \"mlp.dense_h_to_4h.weight\" in key or \"word_embeddings.weight\" in key or \"mlp.dense_h_to_4h.bias\" in key or \"final_linear.weight\" in key:\n                 if quantize and \"mlp.dense_h_to_4h.weight\" in key:\n                     value_list = quantizer.Quantize(value_list, quantize_bits, groups, key=key)\n                 new_client_sd[key] = torch.cat(value_list, axis=0)",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/59c4748bd5827febc8cf4928c5cd75bd48026718/deepspeed%2Fruntime%2Fstate_dict_factory.py",
      "sha": "248a66c518241c96a95f395c27cfb0f58354c495",
      "status": "modified"
    },
    {
      "additions": 39,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/59c4748bd5827febc8cf4928c5cd75bd48026718/tests%2Funit%2Fcheckpoint%2Ftest_state_dict_factory.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fcheckpoint%2Ftest_state_dict_factory.py?ref=59c4748bd5827febc8cf4928c5cd75bd48026718",
      "deletions": 0,
      "filename": "tests/unit/checkpoint/test_state_dict_factory.py",
      "patch": "@@ -0,0 +1,39 @@\n+# SPDX-License-Identifier: Apache-2.0\n+\n+# DeepSpeed Team\n+\n+import os\n+\n+import torch\n+\n+from deepspeed.runtime.state_dict_factory import SDLoaderFactory\n+\n+\n+def test_megatron_split_then_merge_restores_checkpoint(tmpdir):\n+    # A tensor-parallel checkpoint that is split for more ranks and merged back for\n+    # fewer ranks must come back unchanged, including the vocab-parallel final_linear\n+    # output layer that GPT-NeoX checkpoints carry.\n+    hidden, vocab = 8, 32\n+    full_module = {\n+        \"attention.query_key_value.weight\": torch.randn(3 * hidden, hidden),\n+        \"attention.dense.weight\": torch.randn(hidden, hidden),\n+        \"mlp.dense_h_to_4h.weight\": torch.randn(4 * hidden, hidden),\n+        \"mlp.dense_h_to_4h.bias\": torch.randn(4 * hidden),\n+        \"mlp.dense_4h_to_h.weight\": torch.randn(hidden, 4 * hidden),\n+        \"final_linear.weight\": torch.randn(vocab, hidden),\n+    }\n+    full_path = os.path.join(str(tmpdir), \"full.pt\")\n+    torch.save({\"module\": full_module, \"checkpoint_version\": 2.0}, full_path)\n+\n+    tp_size = 2\n+    shard_paths = []\n+    for rank in range(tp_size):\n+        _, shard, _ = SDLoaderFactory.get_sd_loader([full_path], checkpoint_engine=None).load(tp_size, rank)\n+        shard_path = os.path.join(str(tmpdir), f\"mp_rank_{rank:02d}_model_states.pt\")\n+        torch.save(shard, shard_path)\n+        shard_paths.append(shard_path)\n+\n+    _, merged, _ = SDLoaderFactory.get_sd_loader(shard_paths, checkpoint_engine=None).load(1, 0)\n+\n+    for key, expected in full_module.items():\n+        assert torch.equal(merged[\"module\"][key], expected), key",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/59c4748bd5827febc8cf4928c5cd75bd48026718/tests%2Funit%2Fcheckpoint%2Ftest_state_dict_factory.py",
      "sha": "edabdee718ca952fc9301b42b72aae236517000f",
      "status": "added"
    }
