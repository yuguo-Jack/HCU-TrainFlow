      "changes": 21,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fdata_pipeline%2Fdata_sampling%2Fdata_sampler.py?ref=7dde93841dc32b773c9cc14859f4f3462062d9f4",
      "deletions": 9,
      "filename": "deepspeed/runtime/data_pipeline/data_sampling/data_sampler.py",
      "patch": "@@ -250,15 +250,18 @@ def reshuffle_clusters(self, cidx):\n         self.data_clusters[cidx] = MMapIndexedDataset(cluster_path, skip_warmup=True)\n \n     def get_sample_from_cluster(self, cidx, num_samples):\n-        start_idx = self.data_cluster_current_position[cidx]\n-        samples = list(np.copy(self.data_clusters[cidx][0][start_idx:(start_idx + num_samples)]))\n-        self.data_cluster_current_position[cidx] += num_samples\n-        if len(samples) < num_samples:\n-            num_samples_remained = num_samples - len(samples)\n-            logger.info(f\"reshuffling cluster {cidx}.\")\n-            self.reshuffle_clusters(cidx)\n-            samples += list(np.copy(self.data_clusters[cidx][0][:num_samples_remained]))\n-            self.data_cluster_current_position[cidx] = num_samples_remained\n+        samples = []\n+        while len(samples) < num_samples:\n+            start_idx = self.data_cluster_current_position[cidx]\n+            remaining = num_samples - len(samples)\n+            selected = self.data_clusters[cidx][0][start_idx:(start_idx + remaining)]\n+            samples.extend(np.copy(selected))\n+            self.data_cluster_current_position[cidx] += len(selected)\n+            if len(samples) < num_samples:\n+                logger.info(f\"reshuffling cluster {cidx}.\")\n+                self.reshuffle_clusters(cidx)\n+                self.data_cluster_current_position[cidx] = 0\n+\n         return samples\n \n     def get_next_global_batch(self):",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/7dde93841dc32b773c9cc14859f4f3462062d9f4/deepspeed%2Fruntime%2Fdata_pipeline%2Fdata_sampling%2Fdata_sampler.py",
      "sha": "68b21912244d6519e42c27b280678d2173764fba",
      "status": "modified"
    },
    {
      "additions": 65,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/7dde93841dc32b773c9cc14859f4f3462062d9f4/tests%2Funit%2Fruntime%2Ftest_data_efficiency.py",
      "changes": 65,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fruntime%2Ftest_data_efficiency.py?ref=7dde93841dc32b773c9cc14859f4f3462062d9f4",
      "deletions": 0,
      "filename": "tests/unit/runtime/test_data_efficiency.py",
      "patch": "@@ -13,6 +13,8 @@\n from unit.common import DistributedTest\n from unit.simple_model import SimpleModel, random_dataset\n from deepspeed.runtime.data_pipeline.curriculum_scheduler import CurriculumScheduler\n+from deepspeed.runtime.data_pipeline.config import get_data_efficiency_config\n+from deepspeed.runtime.data_pipeline.data_sampling.data_sampler import DeepSpeedDataSampler\n \n \n class MPU():\n@@ -204,3 +206,66 @@ def test_data_analyzer_runs_only_the_specific_threads(tmp_path):\n         fname = tmp_path / \"value\" / f\"worker0_thread{thread}\" / \"value_sample_to_metric\"\n         stored = MMapIndexedDataset(str(fname), skip_warmup=True)\n         assert [int(v[0]) for v in stored] == list(expected)\n+\n+\n+@pytest.mark.parametrize(\"batch_size\", [2, 3, 8])\n+def test_small_curriculum_cluster_full_batches(tmpdir, batch_size):\n+    deepspeed.comm.init_distributed(get_accelerator().communication_backend_name(),\n+                                    auto_mpi_discovery=False,\n+                                    init_method=f\"file://{tmpdir}/rdzv\",\n+                                    rank=0,\n+                                    world_size=1)\n+    try:\n+        config = get_data_efficiency_config({\n+            \"data_efficiency\": {\n+                \"enabled\": True,\n+                \"seed\": 1234,\n+                \"data_sampling\": {\n+                    \"enabled\": True,\n+                    \"num_epochs\": 20,\n+                    \"curriculum_learning\": {\n+                        \"enabled\": True,\n+                        \"data_cluster_path\": str(tmpdir),\n+                        \"curriculum_metrics\": {\n+                            \"index\": {\n+                                \"difficulty_type\": \"value\",\n+                                \"clustering_type\": \"single_cluster\",\n+                                \"min_difficulty\": 1,\n+                                \"max_difficulty\": 1,\n+                                \"schedule_type\": \"fixed_linear\",\n+                                \"schedule_config\": {\n+                                    \"total_curriculum_step\": 1,\n+                                    \"difficulty_step\": 1\n+                                },\n+                            }\n+                        },\n+                    },\n+                },\n+            }\n+        })\n+        sampler = DeepSpeedDataSampler(config,\n+                                       2,\n+                                       batch_size,\n+                                       0,\n+                                       1,\n+                                       deepspeed.comm.get_world_group(),\n+                                       1,\n+                                       global_rank=0,\n+                                       drop_last=False)\n+        loader = torch.utils.data.DataLoader(torch.arange(2), batch_sampler=sampler)\n+        iterator = iter(loader)\n+        model = torch.nn.Linear(1, 1)\n+        optimizer = torch.optim.SGD(model.parameters(), lr=0.1)\n+        for _ in range(3):\n+            batch = next(iterator)\n+            assert batch.numel() == batch_size\n+            assert set(batch.tolist()) <= {0, 1}\n+            # Complete passes over the two-item cluster must remain balanced.\n+            counts = torch.bincount(batch, minlength=2)\n+            assert abs(int(counts[0] - counts[1])) <= 1\n+            optimizer.zero_grad()\n+            loss = model(batch.float().unsqueeze(1)).square().mean()\n+            loss.backward()\n+            optimizer.step()\n+    finally:\n+        deepspeed.comm.destroy_process_group()",
