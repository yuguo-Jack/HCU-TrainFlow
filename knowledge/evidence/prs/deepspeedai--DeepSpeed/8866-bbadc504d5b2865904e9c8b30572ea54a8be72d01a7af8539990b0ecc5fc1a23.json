      "additions": 43,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e398722503665dfd779e3f185e60a8e088dd7b72/tests%2Funit%2Fruntime%2Ftest_ds_initialize.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fruntime%2Ftest_ds_initialize.py?ref=e398722503665dfd779e3f185e60a8e088dd7b72",
      "deletions": 0,
      "filename": "tests/unit/runtime/test_ds_initialize.py",
      "patch": "@@ -67,6 +67,49 @@ def test(self, zero_stage):\n         see_memory_usage('post-fwds', force=True)\n \n \n+@pytest.mark.parametrize('zero_stage', [0, 1, 2, 3])\n+class TestScalarParameter(DistributedTest):\n+    \"\"\"0-dim parameters (e.g. a learnable logit scale) must survive the uint8 parameter broadcasts.\"\"\"\n+    world_size = 1\n+\n+    def test(self, zero_stage):\n+        hidden_dim = 4\n+        ds_config = {\n+            'train_batch_size': self.world_size,\n+            'optimizer': {\n+                'type': 'Adam',\n+                'params': {\n+                    'lr': 1e-3\n+                }\n+            },\n+            'zero_optimization': {\n+                'stage': zero_stage\n+            },\n+        }\n+        if get_accelerator().is_bf16_supported():\n+            ds_config['bf16'] = {'enabled': True}\n+        elif get_accelerator().is_fp16_supported():\n+            ds_config['fp16'] = {'enabled': True}\n+\n+        class ScalarParamModel(torch.nn.Module):\n+\n+            def __init__(self):\n+                super().__init__()\n+                self.linear = torch.nn.Linear(hidden_dim, hidden_dim)\n+                self.scale = torch.nn.Parameter(torch.tensor(2.0))\n+\n+            def forward(self, x):\n+                return self.linear(x) * self.scale\n+\n+        with deepspeed.zero.Init(enabled=zero_stage == 3, config_dict_or_path=ds_config):\n+            model = ScalarParamModel()\n+        model, _, _, _ = deepspeed.initialize(model=model, model_parameters=model.parameters(), config=ds_config)\n+\n+        with deepspeed.zero.GatheredParameters(model.module.scale, enabled=zero_stage == 3):\n+            assert model.module.scale.dim() == 0\n+            assert model.module.scale.item() == 2.0\n+\n+\n @pytest.mark.parametrize('optimizer_type', [None, Optimizer, Callable])\n class TestClientOptimizer(DistributedTest):\n     world_size = 1",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/e398722503665dfd779e3f185e60a8e088dd7b72/tests%2Funit%2Fruntime%2Ftest_ds_initialize.py",
      "sha": "d54146a8abb7eaa2d246ea5828616c00d81497e4",
      "status": "modified"
    },
