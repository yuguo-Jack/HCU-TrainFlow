      "additions": 3,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/5bcf1d24605edab9edb1ce82f4870d614990a9c0/deepspeed%2Fruntime%2Flr_schedules.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Flr_schedules.py?ref=5bcf1d24605edab9edb1ce82f4870d614990a9c0",
      "deletions": 4,
      "filename": "deepspeed/runtime/lr_schedules.py",
      "patch": "@@ -449,9 +449,8 @@ class OneCycle(object):\n         cycle_momentum (bool): If ``True``, momentum is cycled inversely\n             to learning rate between 'cycle_min_mom' and 'cycle_max_mom'.\n             Default: True\n-        cycle_min_mom (float or list): Initial momentum which is the\n-            lower boundary in the cycle for each parameter group.\n-            Default: 0.8\n+        cycle_min_mom (float or list): Lower momentum boundary in the\n+            cycle for each parameter group. Default: 0.8\n         cycle_max_mom (float or list): Upper momentum boundaries in the cycle\n             for each parameter group. Functionally,\n             it defines the cycle amplitude (cycle_max_mom - cycle_min_mom).\n@@ -573,7 +572,7 @@ def _initialize_momentum(self, optimizer, cycle_min_mom, cycle_max_mom, decay_mo\n         self.max_moms = [(mom, 0.99) for mom in _format_param(optimizer, cycle_max_mom, 'cycle_max_mom')]\n \n         if last_batch_iteration == -1:\n-            for momentum, group in zip(self.min_moms, optimizer.param_groups):\n+            for momentum, group in zip(self.max_moms, optimizer.param_groups):\n                 group['betas'] = momentum\n \n         if math.isclose(self.decay_mom_rate, 0):",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/5bcf1d24605edab9edb1ce82f4870d614990a9c0/deepspeed%2Fruntime%2Flr_schedules.py",
      "sha": "237f7a26b326fef21c02411c6d39a8251e1d5a83",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/5bcf1d24605edab9edb1ce82f4870d614990a9c0/tests%2Funit%2Fruntime%2Ftest_lr_schedulers.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fruntime%2Ftest_lr_schedulers.py?ref=5bcf1d24605edab9edb1ce82f4870d614990a9c0",
      "deletions": 1,
      "filename": "tests/unit/runtime/test_lr_schedulers.py",
      "patch": "@@ -843,7 +843,7 @@ def test_one_cycle_accepts_per_group_lr_and_momentum_lists():\n     assert scheduler.min_lrs == pytest.approx([0.001, 0.002])\n     assert scheduler.max_lrs == pytest.approx([0.01, 0.02])\n     assert [group[\"lr\"] for group in optimizer.param_groups] == pytest.approx([0.001, 0.002])\n-    assert [group[\"betas\"][0] for group in optimizer.param_groups] == pytest.approx([0.8, 0.85])\n+    assert [group[\"betas\"][0] for group in optimizer.param_groups] == pytest.approx([0.9, 0.95])\n \n     # At the peak of the cycle each group reaches its own cycle_max_lr, and momentum is at\n     # its own cycle_min_mom, rather than every group tracking group 0's values.\n@@ -858,6 +858,24 @@ def test_one_cycle_accepts_per_group_lr_and_momentum_lists():\n     assert [group[\"betas\"][0] for group in optimizer.param_groups] == pytest.approx([0.9, 0.95])\n \n \n+def test_one_cycle_initial_optimizer_momentum_matches_schedule():\n+    param = torch.nn.Parameter(torch.zeros(1))\n+    optimizer = torch.optim.Adam([param], lr=0.1, betas=(0.9, 0.99))\n+    scheduler = OneCycle(optimizer=optimizer,\n+                         cycle_min_lr=0.1,\n+                         cycle_max_lr=0.2,\n+                         cycle_first_step_size=4,\n+                         cycle_second_step_size=4,\n+                         cycle_min_mom=0.8,\n+                         cycle_max_mom=0.9)\n+\n+    reported = scheduler.get_mom()[0][0]\n+    actual = optimizer.param_groups[0]['betas'][0]\n+    assert actual == pytest.approx(reported), (\n+        f\"optimizer beta1 ({actual}) != scheduler.get_mom() ({reported})\")\n+    assert actual == pytest.approx(0.9)\n+\n+\n @pytest.mark.parametrize(\"kwargs\", [{\n     \"cycle_min_lr\": [0.001, 0.002, 0.003]\n }, {",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/5bcf1d24605edab9edb1ce82f4870d614990a9c0/tests%2Funit%2Fruntime%2Ftest_lr_schedulers.py",
      "sha": "30fb4996597c2d4c2182927f3d3e0738af759a4b",
      "status": "modified"
    }
