      "changes": 2,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fcheckpoint_engine%2Ffast_checkpoint_engine.py?ref=960efec32a4abc173e1d577543048a88f750b818",
      "deletions": 1,
      "filename": "deepspeed/runtime/checkpoint_engine/fast_checkpoint_engine.py",
      "patch": "@@ -40,7 +40,7 @@ def save(self, state_dict, path: str):\n         self._writer.release_writer()\n \n     def load(self, path: str, map_location=None):\n-        sd = torch.load(path, map_location=map_location)\n+        sd = torch.load(path, map_location=map_location, weights_only=False)\n         return sd\n \n     def commit(self, info: CheckpointCommitInfo):",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/960efec32a4abc173e1d577543048a88f750b818/deepspeed%2Fruntime%2Fcheckpoint_engine%2Ffast_checkpoint_engine.py",
