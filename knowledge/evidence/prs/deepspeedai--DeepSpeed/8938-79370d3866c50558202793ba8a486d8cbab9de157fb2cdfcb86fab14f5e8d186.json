  "files": [
    {
      "additions": 26,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e01a6ba67fb59500a2f227e9d1b1a02b3b32601a/deepspeed%2Fops%2Fadam%2Fcpu_adam.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fops%2Fadam%2Fcpu_adam.py?ref=e01a6ba67fb59500a2f227e9d1b1a02b3b32601a",
      "deletions": 0,
      "filename": "deepspeed/ops/adam/cpu_adam.py",
      "patch": "@@ -3,12 +3,34 @@\n \n # DeepSpeed Team\n \n+import os\n+\n import torch\n from deepspeed.utils import logger\n from deepspeed.utils.logging import should_log_le\n from deepspeed.ops.op_builder import CPUAdamBuilder\n \n \n+def single_thread_warning():\n+    \"\"\"Return a warning if the CPU optimizer's OpenMP loop is limited to one thread while this rank has more cores.\n+\n+    torchrun exports OMP_NUM_THREADS=1 when --nproc_per_node > 1 unless the variable is already set, so ZeRO-Offload\n+    jobs started with torchrun step the CPU optimizer on a single thread unless the user overrides it.\n+    \"\"\"\n+    if os.environ.get(\"OMP_NUM_THREADS\") != \"1\":\n+        return None\n+    try:\n+        cores = len(os.sched_getaffinity(0))\n+    except AttributeError:  # not available on macOS\n+        cores = os.cpu_count() or 1\n+    cores_per_rank = cores // max(int(os.environ.get(\"LOCAL_WORLD_SIZE\", \"1\")), 1)\n+    if cores_per_rank < 2:\n+        return None\n+    return (f\"OMP_NUM_THREADS=1, so DeepSpeedCPUAdam steps on one thread although this rank can use {cores_per_rank} \"\n+            \"cores. torchrun sets OMP_NUM_THREADS=1 when --nproc_per_node > 1; set OMP_NUM_THREADS to the number of \"\n+            \"cores per rank, or launch with `deepspeed --bind_cores_to_rank`.\")\n+\n+\n class DeepSpeedCPUAdam(torch.optim.Optimizer):\n     optimizer_id = 0\n \n@@ -87,6 +109,10 @@ def __init__(self,\n \n         self.opt_id = DeepSpeedCPUAdam.optimizer_id\n         DeepSpeedCPUAdam.optimizer_id = DeepSpeedCPUAdam.optimizer_id + 1\n+        if self.opt_id == 0:\n+            message = single_thread_warning()\n+            if message:\n+                logger.warning(message)\n         self.adam_w_mode = adamw_mode\n         self.fp32_optimizer_states = fp32_optimizer_states\n         try:",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/e01a6ba67fb59500a2f227e9d1b1a02b3b32601a/deepspeed%2Fops%2Fadam%2Fcpu_adam.py",
      "sha": "35d746410a076daae2f5faa3531b66fd6c9d7d31",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e01a6ba67fb59500a2f227e9d1b1a02b3b32601a/docs%2F_tutorials%2Fzero-offload.md",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/docs%2F_tutorials%2Fzero-offload.md?ref=e01a6ba67fb59500a2f227e9d1b1a02b3b32601a",
      "deletions": 0,
      "filename": "docs/_tutorials/zero-offload.md",
      "patch": "@@ -82,6 +82,8 @@ ZeRO offload already support multi-gpu training.  If the workload is using CPU o\n 1. Divide physical CPU cores evenly among ranks, make each rank to have a dedicated set of CPU cores to run CPU optimizer.\n 2. Set OMP_NUM_THREADS environment variable to the number of CPU cores assigned to each rank, so OpenMP code in CPU optimizer will have near optimal performance.\n \n+If you launch with `torchrun` instead, note that it sets `OMP_NUM_THREADS=1` for every process when `--nproc_per_node` is larger than 1, unless the variable is already set. The CPU optimizer then runs on a single thread, and `DeepSpeedCPUAdam` logs a warning. Export `OMP_NUM_THREADS` with the number of cores per rank before calling `torchrun`.\n+\n ZeRO offload is a hybrid workload that is both heavy on GPU and CPU, and DeepSpeed is optimized for both GPU and CPU performance.  Refer to [How to launch DeepSpeed on Intel Architecture CPU](https://github.com/deepspeedai/DeepSpeed/blob/master/docs/_tutorials/accelerator-setup-guide.md#how-to-launch-deepspeed-on-intel-architecture-cpu) for more details on how to tune core bindings for CPU performance.\n \n Congratulations! You have completed the ZeRO-Offload tutorial.",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/e01a6ba67fb59500a2f227e9d1b1a02b3b32601a/docs%2F_tutorials%2Fzero-offload.md",
      "sha": "567a1c0671cbefd49c1c62458570519e51ab4b89",
      "status": "modified"
    },
    {
      "additions": 52,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e01a6ba67fb59500a2f227e9d1b1a02b3b32601a/tests%2Funit%2Fops%2Fadam%2Ftest_cpu_adam_threads.py",
      "changes": 52,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fops%2Fadam%2Ftest_cpu_adam_threads.py?ref=e01a6ba67fb59500a2f227e9d1b1a02b3b32601a",
      "deletions": 0,
      "filename": "tests/unit/ops/adam/test_cpu_adam_threads.py",
      "patch": "@@ -0,0 +1,52 @@\n+# Copyright (c) Microsoft Corporation.\n+# SPDX-License-Identifier: Apache-2.0\n+\n+# DeepSpeed Team\n+\n+import os\n+\n+import pytest\n+\n+from deepspeed.ops.adam.cpu_adam import single_thread_warning\n+\n+\n+@pytest.fixture\n+def cores(monkeypatch):\n+\n+    def set_cores(n):\n+        monkeypatch.setattr(os, \"sched_getaffinity\", lambda pid: set(range(n)), raising=False)\n+\n+    return set_cores\n+\n+\n+def test_warns_when_torchrun_default_leaves_one_thread(monkeypatch, cores):\n+    cores(8)\n+    monkeypatch.setenv(\"OMP_NUM_THREADS\", \"1\")\n+    monkeypatch.setenv(\"LOCAL_WORLD_SIZE\", \"2\")\n+    message = single_thread_warning()\n+    assert message is not None and \"4 cores\" in message\n+\n+\n+@pytest.mark.parametrize(\"omp\", [None, \"4\", \"16\"])\n+def test_silent_when_threads_are_set(monkeypatch, cores, omp):\n+    cores(8)\n+    if omp is None:\n+        monkeypatch.delenv(\"OMP_NUM_THREADS\", raising=False)\n+    else:\n+        monkeypatch.setenv(\"OMP_NUM_THREADS\", omp)\n+    monkeypatch.setenv(\"LOCAL_WORLD_SIZE\", \"2\")\n+    assert single_thread_warning() is None\n+\n+\n+def test_silent_when_rank_has_one_core(monkeypatch, cores):\n+    cores(2)\n+    monkeypatch.setenv(\"OMP_NUM_THREADS\", \"1\")\n+    monkeypatch.setenv(\"LOCAL_WORLD_SIZE\", \"2\")\n+    assert single_thread_warning() is None\n+\n+\n+def test_single_process_uses_all_cores(monkeypatch, cores):\n+    cores(6)\n+    monkeypatch.setenv(\"OMP_NUM_THREADS\", \"1\")\n+    monkeypatch.delenv(\"LOCAL_WORLD_SIZE\", raising=False)\n+    assert \"6 cores\" in single_thread_warning()",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/e01a6ba67fb59500a2f227e9d1b1a02b3b32601a/tests%2Funit%2Fops%2Fadam%2Ftest_cpu_adam_threads.py",
      "sha": "72b889b610bf01ccc943a2d2861b8927d3bc5304",
      "status": "added"
    }
