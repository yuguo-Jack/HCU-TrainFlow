      "filename": ".github/workflows/modal-torch-latest.yml",
      "patch": "@@ -1,10 +1,8 @@\n name: modal-torch-latest\n \n-# This Required workflow selects tests on a no-secret GitHub runner, then tests\n-# the exact candidate SHA inside a no-secret Modal Sandbox. If that Sandbox\n-# cannot start within its bounded acquisition window, the same trusted\n-# controller makes one bounded G7.12 Spot acquisition pass across the\n-# configured AWS regions. Under\n+# This Required workflow selects tests on a no-secret GitHub runner, then uses\n+# the trusted controller to make one bounded G7.12 Spot acquisition pass across\n+# the configured AWS regions and test the exact candidate SHA. Under\n # pull_request_target, every GitHub-side checkout and Python entrypoint comes\n # from the trusted base commit; merge queue runs resolve that trusted base from\n # merge_group.base_sha. A GPU backend runs only for merge queue entries, the\n@@ -24,7 +22,7 @@ on:\n         default: false\n         type: boolean\n       torch_preset:\n-        description: Modal PyTorch/CUDA image preset for manual runs\n+        description: PyTorch/CUDA image preset for manual runs\n         required: false\n         default: '2.10.0-cuda12.8'\n         type: choice\n@@ -302,42 +300,7 @@ jobs:\n           name: modal-torch-latest-test-selection\n           path: ci/.test_selection\n \n-      - name: Install trusted controller dependency\n-        run: |\n-          pip install uv\n-          uv pip install --system modal==1.2.6\n-\n-      - name: Try tests in isolated Modal Sandbox\n-        id: modal\n-        env:\n-          DS_CI_REPOSITORY: ${{ github.event.pull_request.head.repo.full_name || github.repository }}\n-          DS_CI_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n-          DS_CI_BASE_SHA: ${{ github.event.pull_request.base.sha || github.event.merge_group.base_sha || '' }}\n-          DS_TEST_SELECTION_MODE: ${{ needs.collect-tests.outputs.mode }}\n-          DS_TEST_LIST_FILE: ci/.test_selection/test_list.txt\n-          MODAL_TORCH_PRESET: ${{ github.event.inputs.torch_preset || '2.10.0-cuda12.8' }}\n-          MODAL_TRANSFORMERS_SOURCE: ${{ github.event.inputs.transformers_source || 'git' }}\n-          MODAL_TRANSFORMERS_REF: ${{ github.event.inputs.transformers_ref || 'main' }}\n-          MODAL_TOKEN_ID: ${{ secrets.MODAL_TOKEN_ID }}\n-          MODAL_TOKEN_SECRET: ${{ secrets.MODAL_TOKEN_SECRET }}\n-        run: |\n-          set +e\n-          python3 ci/torch_latest.py controller\n-          status=$?\n-          set -e\n-          echo \"status=$status\" >> \"$GITHUB_OUTPUT\"\n-          if [ \"$status\" -eq 0 ]; then\n-            echo \"fallback=false\" >> \"$GITHUB_OUTPUT\"\n-            exit 0\n-          fi\n-          if [ \"$status\" -eq 75 ]; then\n-            echo \"fallback=true\" >> \"$GITHUB_OUTPUT\"\n-            exit 0\n-          fi\n-          exit \"$status\"\n-\n-      - name: Configure AWS credentials for capacity fallback\n-        if: steps.modal.outputs.fallback == 'true'\n+      - name: Configure AWS credentials for test backend\n         env:\n           AWS_ROLE_ARN: ${{ secrets.AWS_MODAL_FALLBACK_ROLE_ARN }}\n         run: |\n@@ -372,8 +335,7 @@ jobs:\n             printf 'AWS_DEFAULT_REGION=us-east-1\\n'\n           } >> \"$GITHUB_ENV\"\n \n-      - name: Run tests on AWS capacity fallback\n-        if: steps.modal.outputs.fallback == 'true'\n+      - name: Run tests on AWS backend\n         env:\n           DS_CI_REPOSITORY: ${{ github.event.pull_request.head.repo.full_name || github.repository }}\n           DS_CI_SHA: ${{ github.event.pull_request.head.sha || github.sha }}\n@@ -386,8 +348,8 @@ jobs:\n           AWS_MODAL_FALLBACK_CONFIG: ${{ secrets.AWS_MODAL_FALLBACK_CONFIG }}\n         run: python3 ci/torch_latest.py aws-controller\n \n-      - name: Reconcile AWS capacity fallback cleanup\n-        if: ${{ always() && steps.modal.outputs.fallback == 'true' }}\n+      - name: Reconcile AWS test cleanup\n+        if: ${{ always() }}\n         env:\n           AWS_MODAL_FALLBACK_CONFIG: ${{ secrets.AWS_MODAL_FALLBACK_CONFIG }}\n           GITHUB_RUN_ID: ${{ github.run_id }}",
