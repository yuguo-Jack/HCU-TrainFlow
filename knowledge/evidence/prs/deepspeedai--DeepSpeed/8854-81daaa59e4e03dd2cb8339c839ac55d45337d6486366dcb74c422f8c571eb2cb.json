      "additions": 2,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/086cf174312f29db8f151f6d71433884dec370a6/deepspeed%2Fruntime%2Fzero%2Fstage3.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fzero%2Fstage3.py?ref=086cf174312f29db8f151f6d71433884dec370a6",
      "deletions": 1,
      "filename": "deepspeed/runtime/zero/stage3.py",
      "patch": "@@ -1934,7 +1934,8 @@ def __avg_scatter_grads(self, params_to_reduce: List[Parameter],\n             grad_partitions_for_rank = [g.mul(self.gradient_predivide_factor) for g in grad_partitions_for_rank]\n \n         partition_world_size = dist.get_world_size(group=process_group)\n-        averaging_world_size = self._gradient_averaging_world_size(params_to_reduce, partition_world_size)\n+        averaging_world_size = self._gradient_averaging_world_size(\n+            params_to_reduce, partition_world_size) / float(self.sequence_parallel_size)\n         if averaging_world_size != partition_world_size:\n             scale = partition_world_size / float(averaging_world_size)\n             grad_partitions_for_rank = [g.mul(scale) for g in grad_partitions_for_rank]",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/086cf174312f29db8f151f6d71433884dec370a6/deepspeed%2Fruntime%2Fzero%2Fstage3.py",
      "sha": "18038270120448e196c1288f5b8204ba91419a61",
      "status": "modified"
    },
    {
      "additions": 67,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/086cf174312f29db8f151f6d71433884dec370a6/tests%2Funit%2Fv1%2Fzero%2Ftest_zero.py",
      "changes": 67,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fv1%2Fzero%2Ftest_zero.py?ref=086cf174312f29db8f151f6d71433884dec370a6",
      "deletions": 0,
      "filename": "tests/unit/v1/zero/test_zero.py",
      "patch": "@@ -105,6 +105,73 @@ def forward(self, inputs):\n         engine.destroy()\n \n \n+@pytest.mark.parametrize(\n+    \"reduce_scatter,contiguous_gradients,reduce_bucket_size\",\n+    [\n+        (False, True, 500),\n+        (False, False, 500),\n+        (True, True, 500),\n+        (False, True, 16),\n+    ],\n+)\n+class TestZero3SequenceParallelGradientScale(DistributedTest):\n+    world_size = 2\n+\n+    def test(self, reduce_scatter, contiguous_gradients, reduce_bucket_size):\n+        import deepspeed.runtime.sequence_parallel.parallel_state_sp as sp_mpu\n+        from deepspeed.utils import groups\n+\n+        class TwoLayerLoss(Module):\n+\n+            def __init__(self):\n+                super().__init__()\n+                self.small = Parameter(torch.zeros(4))\n+                self.large = Parameter(torch.zeros(64))\n+\n+            def forward(self, scale):\n+                return (self.small.sum() + self.large.sum()) * scale\n+\n+        sp_mpu.initialize_sequence_parallel(sequence_parallel_size=self.world_size)\n+        try:\n+            model = TwoLayerLoss()\n+            optimizer = torch.optim.SGD(model.parameters(), lr=1.0)\n+            config_dict = {\n+                \"train_micro_batch_size_per_gpu\": 1,\n+                \"gradient_clipping\": 0.0,\n+                \"zero_allow_untested_optimizer\": True,\n+                \"zero_optimization\": {\n+                    \"stage\": 3,\n+                    \"reduce_scatter\": reduce_scatter,\n+                    \"contiguous_gradients\": contiguous_gradients,\n+                    \"reduce_bucket_size\": reduce_bucket_size,\n+                },\n+            }\n+            engine, _, _, _ = deepspeed.initialize(\n+                model=model,\n+                optimizer=optimizer,\n+                config=config_dict,\n+                mpu=sp_mpu,\n+            )\n+\n+            # Each sequence-parallel rank contributes 1 / sp_size of the full-sequence loss.\n+            local_loss = engine(torch.tensor(1.0 / self.world_size, device=engine.device))\n+            engine.backward(local_loss)\n+\n+            grad_small = safe_get_full_grad(engine.module.small).detach().cpu()\n+            grad_large = safe_get_full_grad(engine.module.large).detach().cpu()\n+            torch.testing.assert_close(grad_small, torch.ones_like(grad_small))\n+            torch.testing.assert_close(grad_large, torch.ones_like(grad_large))\n+\n+            engine.step()\n+            param_small = safe_get_full_fp32_param(engine.module.small).detach().cpu()\n+            param_large = safe_get_full_fp32_param(engine.module.large).detach().cpu()\n+            torch.testing.assert_close(param_small, -torch.ones_like(param_small))\n+            torch.testing.assert_close(param_large, -torch.ones_like(param_large))\n+            engine.destroy()\n+        finally:\n+            groups.mpu = None\n+\n+\n @pytest.mark.parametrize(\n     \"optimizer_name,zero_stage\",\n     [",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/086cf174312f29db8f151f6d71433884dec370a6/tests%2Funit%2Fv1%2Fzero%2Ftest_zero.py",
      "sha": "9eb39beac83b6afbeba3ead7a5d487455efa53d4",
      "status": "modified"
    }
