    {
      "additions": 2,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e2b4972c20f5b698c7a243dfac64803503b6db2f/docs%2F_tutorials%2Fmonitor.md",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/docs%2F_tutorials%2Fmonitor.md?ref=e2b4972c20f5b698c7a243dfac64803503b6db2f",
      "deletions": 0,
      "filename": "docs/_tutorials/monitor.md",
      "patch": "@@ -64,6 +64,8 @@ When using DeepSpeed for model training, the Monitor can be configured in the De\n \n DeepSpeed will automatically log to all available and enabled monitoring backends listed in the config, and will generate live monitoring views such as those listed above.\n \n+The CSV monitor appends to existing metric files when reusing the same `output_path` and `job_name`. A header is written only when the metric file is empty, so restarting the monitor does not append another header. Use a different `job_name` to keep independent runs separate.\n+\n ### Custom Monitoring\n \n In addition to automatic monitoring, users can log their own custom metrics in client scripts. Currently, there are two ways to initialize Monitor objects:",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/e2b4972c20f5b698c7a243dfac64803503b6db2f/docs%2F_tutorials%2Fmonitor.md",
      "sha": "3fcccbfdd937fe198cbaed17a7f3f1baef6cc40b",
      "status": "modified"
    },
    {
      "additions": 36,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e2b4972c20f5b698c7a243dfac64803503b6db2f/tests%2Funit%2Fmonitor%2Ftest_monitor.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fmonitor%2Ftest_monitor.py?ref=e2b4972c20f5b698c7a243dfac64803503b6db2f",
      "deletions": 1,
      "filename": "tests/unit/monitor/test_monitor.py",
      "patch": "@@ -3,10 +3,13 @@\n \n # DeepSpeed Team\n \n+import csv\n+import pytest\n+\n from deepspeed.monitor.tensorboard import TensorBoardMonitor\n from deepspeed.monitor.wandb import WandbMonitor\n from deepspeed.monitor.csv_monitor import csvMonitor\n-from deepspeed.monitor.config import DeepSpeedMonitorConfig\n+from deepspeed.monitor.config import DeepSpeedMonitorConfig, CSVConfig\n from deepspeed.monitor.comet import CometMonitor\n \n from unit.common import DistributedTest\n@@ -103,6 +106,38 @@ def test_empty_csv_monitor(self):\n         assert csv_monitor.job_name == defaults.job_name\n \n \n+class TestCSVMonitorFiles(DistributedTest):\n+    world_size = 1\n+    requires_cuda_env = False\n+\n+    @pytest.mark.parametrize(\"precreate\", [False, True])\n+    def test_header_for_new_or_empty_file(self, tmp_path, precreate):\n+        config = CSVConfig(enabled=True, output_path=str(tmp_path), job_name=\"test\")\n+        monitor = csvMonitor(config)\n+        output = tmp_path / \"test\" / \"Train_Samples_train_loss.csv\"\n+        if precreate:\n+            output.touch()\n+\n+        monitor.write_events([(\"Train/Samples/train_loss\", 1.5, 1)])\n+        monitor.write_events([(\"Train/Samples/train_loss\", 1.0, 2)])\n+\n+        with output.open() as stream:\n+            assert list(csv.reader(stream)) == [[\"step\", \"train_loss\"], [\"1\", \"1.5\"], [\"2\", \"1.0\"]]\n+\n+    def test_resume_preserves_rows_without_repeating_header(self, tmp_path):\n+        config = CSVConfig(enabled=True, output_path=str(tmp_path), job_name=\"test\")\n+        monitor = csvMonitor(config)\n+        monitor.write_events([(\"Train/Samples/train_loss\", 1.5, 1)])\n+\n+        resumed_monitor = csvMonitor(config)\n+        resumed_monitor.write_events([(\"Train/Samples/train_loss\", 1.0, 2)])\n+        resumed_monitor.write_events([(\"Train/Samples/train_loss\", 0.5, 3)])\n+\n+        output = tmp_path / \"test\" / \"Train_Samples_train_loss.csv\"\n+        with output.open() as stream:\n+            assert list(csv.reader(stream)) == [[\"step\", \"train_loss\"], [\"1\", \"1.5\"], [\"2\", \"1.0\"], [\"3\", \"0.5\"]]\n+\n+\n class TestCometMonitor(DistributedTest):\n     world_size = 2\n ",
