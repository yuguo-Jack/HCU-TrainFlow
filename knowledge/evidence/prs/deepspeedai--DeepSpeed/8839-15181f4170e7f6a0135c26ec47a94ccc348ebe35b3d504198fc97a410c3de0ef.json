      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/757a592d383f40fbef18d6bc0d71bc1ccc70d56a/deepspeed%2Fruntime%2Frollout%2Fhybrid_engine_rollout.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Frollout%2Fhybrid_engine_rollout.py?ref=757a592d383f40fbef18d6bc0d71bc1ccc70d56a",
      "deletions": 0,
      "filename": "deepspeed/runtime/rollout/hybrid_engine_rollout.py",
      "patch": "@@ -780,6 +780,7 @@ def _continuous_prefill_cache(self, module, static_cache_type, prompt_ids, promp\n             use_cache=True,\n             cache_position=torch.arange(prompt_len, device=device),\n             position_ids=position_ids,\n+            **self._last_logits_kwargs(module),\n         )\n         return prefill_output.logits[:, -1, :].argmax(dim=-1, keepdim=True), prefill_cache\n \n@@ -813,6 +814,15 @@ def _is_eos(self, token):\n         eos_ids = torch.as_tensor(eos_token_id, dtype=token.dtype, device=token.device).flatten()\n         return bool((token == eos_ids).any().item())\n \n+    @staticmethod\n+    def _last_logits_kwargs(module):\n+        \"\"\"Ask models that support it for last-position logits only, since prefill samples just one token.\"\"\"\n+        # Without this the prefill materializes [batch, prompt_len, vocab] logits, the largest activation of the\n+        # rollout. Models that do not declare the argument may forward unknown kwargs to submodules, so skip them.\n+        if \"logits_to_keep\" in signature(module.forward).parameters:\n+            return {\"logits_to_keep\": 1}\n+        return {}\n+\n     @staticmethod\n     def _call_model(module, input_ids, **kwargs):\n         \"\"\"Call models with only the cache arguments their HF version accepts.\"\"\"\n@@ -990,6 +1000,7 @@ def _generate_graph(self, prompt_ids, prompt_attn, max_new_tokens, pad_token_id,\n             past_key_values=prefill_cache,\n             use_cache=True,\n             cache_position=torch.arange(prompt_len, device=device),\n+            **self._last_logits_kwargs(module),\n         )\n         next_token = prefill_out.logits[:, -1, :].argmax(dim=-1, keepdim=True)\n ",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/757a592d383f40fbef18d6bc0d71bc1ccc70d56a/deepspeed%2Fruntime%2Frollout%2Fhybrid_engine_rollout.py",
      "sha": "b71ca72959081ad362c6effafbf66951dc0b4f02",
      "status": "modified"
    },
    {
      "additions": 50,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/757a592d383f40fbef18d6bc0d71bc1ccc70d56a/tests%2Funit%2Fruntime%2Frollout%2Ftest_hybrid_engine_rollout.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fruntime%2Frollout%2Ftest_hybrid_engine_rollout.py?ref=757a592d383f40fbef18d6bc0d71bc1ccc70d56a",
      "deletions": 0,
      "filename": "tests/unit/runtime/rollout/test_hybrid_engine_rollout.py",
      "patch": "@@ -265,6 +265,56 @@ def forward(self, input_ids, attention_mask, past_key_values=None, use_cache=Tru\n     assert (1, 3) in model.calls\n \n \n+def test_continuous_prefill_requests_last_logits_only():\n+\n+    class LastLogitsModel(torch.nn.Module):\n+        _supports_cache_class = True\n+\n+        def __init__(self):\n+            super().__init__()\n+            self.weight = torch.nn.Parameter(torch.zeros(1))\n+            self.prefill_logits_to_keep = []\n+\n+            self.config = PretrainedConfig(\n+                max_position_embeddings=32,\n+                num_hidden_layers=1,\n+                num_attention_heads=1,\n+                num_key_value_heads=1,\n+                hidden_size=1,\n+                head_dim=1,\n+            )\n+\n+        # Mirrors the Transformers contract: 0 returns logits for every position, k for the last k.\n+        def forward(self,\n+                    input_ids,\n+                    attention_mask,\n+                    past_key_values=None,\n+                    use_cache=True,\n+                    cache_position=None,\n+                    position_ids=None,\n+                    logits_to_keep=0):\n+            key_states = input_ids[:, None, :, None].to(dtype=torch.float32)\n+            past_key_values.update(key_states,\n+                                   key_states,\n+                                   layer_idx=0,\n+                                   cache_kwargs={\"cache_position\": cache_position})\n+            if input_ids.shape[1] > 1:\n+                self.prefill_logits_to_keep.append(logits_to_keep)\n+            # Each position predicts its own token + 5, so reading any position but the last changes the output.\n+            logits = torch.nn.functional.one_hot((input_ids + 5) % 16, num_classes=16).to(torch.float32)\n+            if logits_to_keep:\n+                logits = logits[:, -logits_to_keep:]\n+            return SimpleNamespace(logits=logits, past_key_values=past_key_values)\n+\n+    model = LastLogitsModel()\n+    rollout = HybridEngineRollout(SimpleNamespace(module=model), SimpleNamespace(pad_token_id=0, eos_token_id=2))\n+    request = RolloutRequest(torch.tensor([[1, 2, 3], [1, 2, 4]]), torch.ones((2, 3), dtype=torch.long))\n+    output = rollout.generate(request, SamplingConfig(max_new_tokens=2, temperature=0, continuous_batch_size=2))\n+\n+    assert output.input_ids[:, 3:].tolist() == [[8, 13], [9, 14]]\n+    assert model.prefill_logits_to_keep == [1]\n+\n+\n def test_aligned_continuous_generation_supports_mixed_effective_prompt_lengths():\n \n     class CacheConfig(SimpleNamespace):",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/757a592d383f40fbef18d6bc0d71bc1ccc70d56a/tests%2Funit%2Fruntime%2Frollout%2Ftest_hybrid_engine_rollout.py",
      "sha": "961ac260ec7970c47a920e73ff4a3ae42519f64c",
      "status": "modified"
    }
