      "additions": 5,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/9e511915fef514c44f80659a069be24a674a6e34/op_builder%2Fbuilder.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/op_builder%2Fbuilder.py?ref=9e511915fef514c44f80659a069be24a674a6e34",
      "deletions": 3,
      "filename": "op_builder/builder.py",
      "patch": "@@ -543,12 +543,14 @@ def simd_width(self):\n             if cpu_info is None:\n                 return '-D__SCALAR__'\n \n+        # py-cpuinfo reports no 'flags' on some CPUs, e.g. Apple Silicon.\n+        flags = cpu_info.get('flags', [])\n         if cpu_info['arch'] == 'X86_64':\n-            if 'avx512' in cpu_info['flags'] or 'avx512f' in cpu_info['flags']:\n+            if 'avx512' in flags or 'avx512f' in flags:\n                 return '-D__AVX512__'\n-            elif 'avx2' in cpu_info['flags']:\n+            elif 'avx2' in flags:\n                 return '-D__AVX256__'\n-        elif (cpu_info['arch'] or '').startswith('ARM') and 'sve' in cpu_info['flags']:\n+        elif (cpu_info['arch'] or '').startswith('ARM') and 'sve' in flags:\n             return '-D__SVE__'\n         elif cpu_info['arch'] == 'ARM_8':\n             # NEON is baseline on AArch64; vdivq/vsqrtq used by simd.h are A64-only,",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/9e511915fef514c44f80659a069be24a674a6e34/op_builder%2Fbuilder.py",
      "sha": "62af90c455deaabc87cb3ab3c6e14be39e7da4f2",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/9e511915fef514c44f80659a069be24a674a6e34/tests%2Funit%2Fops%2Ftest_op_builder.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fops%2Ftest_op_builder.py?ref=9e511915fef514c44f80659a069be24a674a6e34",
      "deletions": 0,
      "filename": "tests/unit/ops/test_op_builder.py",
      "patch": "@@ -408,3 +408,11 @@ def test_riscv_has_vector_agrees_with_kernel_hwcap():\n     # kernel that accepted such a token also sets the HWCAP bit, so the two cannot\n     # disagree on real hardware.\n     assert make_builder()._riscv_has_vector() is _kernel_hwcap_has_vector()\n+\n+\n+@pytest.mark.parametrize(\"flags, expected\", [(None, \"-D__NEON__\"), ([\"fp\", \"asimd\", \"sve\"], \"-D__SVE__\")])\n+def test_simd_width_handles_cpu_info_without_flags(flags, expected):\n+    # py-cpuinfo leaves out 'flags' on Apple Silicon, so simd_width must not index it.\n+    cpu_info = {\"arch\": \"ARM_8\"} if flags is None else {\"arch\": \"ARM_8\", \"flags\": flags}\n+    with patch.dict(sys.modules, {\"cpuinfo\": MagicMock(get_cpu_info=MagicMock(return_value=cpu_info))}):\n+        assert make_builder().simd_width() == expected",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/9e511915fef514c44f80659a069be24a674a6e34/tests%2Funit%2Fops%2Ftest_op_builder.py",
      "sha": "ae8bdeae06c50bae8b23b01a7ae7bffcac5d9ab3",
      "status": "modified"
    }
