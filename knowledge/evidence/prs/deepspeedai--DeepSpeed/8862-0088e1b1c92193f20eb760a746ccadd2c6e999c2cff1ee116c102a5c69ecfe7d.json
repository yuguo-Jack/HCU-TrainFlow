    {
      "additions": 15,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b7ade039fd8e16a6870fb29624fb6df5bf2e01a6/deepspeed%2Futils%2Fcomms_logging.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Futils%2Fcomms_logging.py?ref=b7ade039fd8e16a6870fb29624fb6df5bf2e01a6",
      "deletions": 6,
      "filename": "deepspeed/utils/comms_logging.py",
      "patch": "@@ -29,12 +29,17 @@ def convert_size(size_bytes):\n     return \"%s %s\" % (s, size_name[i])\n \n \n-# Helper function to calculate algbw and busbw.\n-# See https://gist.github.com/jeffra/b5e80466b4c86be00ea3b6f130fb7a36 and https://github.com/NVIDIA/nccl-tests/blob/master/doc/PERFORMANCE.md\n-def calc_bw_log(comm_op, size, duration):\n+# Resolve the participating process-group size for bandwidth calculations.\n+def _get_group_world_size(group=None):\n     import deepspeed.comm as dist\n \n-    n = dist.get_world_size()\n+    return dist.get_world_size(group=group)\n+\n+\n+# Helper function to calculate algbw and busbw.\n+# See https://gist.github.com/jeffra/b5e80466b4c86be00ea3b6f130fb7a36 and https://github.com/NVIDIA/nccl-tests/blob/master/doc/PERFORMANCE.md\n+def calc_bw_log(comm_op, size, duration, group=None):\n+    n = _get_group_world_size(group)\n     tput = 0\n     busbw = 0\n     if comm_op == \"all_to_all_single\" or comm_op == \"all_to_all\":\n@@ -101,8 +106,12 @@ def stop_profiling_op(self, op_name_list):\n         self.prof_ops = [op for op in self.prof_ops if op not in op_name_list]\n \n     # Add log entry\n-    def append(self, raw_name, record_name, latency, msg_size):\n-        algbw, busbw = calc_bw_log(raw_name, msg_size, latency)\n+    def append(self, raw_name, record_name, latency, msg_size, group=None):\n+        algbw, busbw = calc_bw_log(raw_name, msg_size, latency, group=group)\n+        group_size = _get_group_world_size(group)\n+        global_size = _get_group_world_size()\n+        if group is not None and group_size != global_size:\n+            record_name = f'{record_name} | [Group Size: {group_size}]'\n         if record_name in self.comms_dict.keys():\n             # If this comm_op has already been logged with this message size, just add to existing record\n             if msg_size in self.comms_dict[record_name].keys():",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/b7ade039fd8e16a6870fb29624fb6df5bf2e01a6/deepspeed%2Futils%2Fcomms_logging.py",
      "sha": "b9c2afb6f6e9162756c3416c816f8f138854f47e",
      "status": "modified"
    },
    {
      "additions": 72,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b7ade039fd8e16a6870fb29624fb6df5bf2e01a6/tests%2Funit%2Fcomm%2Ftest_comms_logger.py",
      "changes": 72,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fcomm%2Ftest_comms_logger.py?ref=b7ade039fd8e16a6870fb29624fb6df5bf2e01a6",
      "deletions": 0,
      "filename": "tests/unit/comm/test_comms_logger.py",
      "patch": "@@ -183,6 +183,30 @@ def barrier(prof=False, log_name='barrier'):\n     timers.assert_not_called()\n \n \n+def test_timed_op_passes_collective_group_to_comms_logger(monkeypatch):\n+    from deepspeed.comm import comm\n+\n+    group = object()\n+    backend_op = Mock(return_value='done')\n+    backend = SimpleNamespace(using_mpi=False, all_reduce=backend_op)\n+    logger = SimpleNamespace(enabled=True,\n+                             prof_all=True,\n+                             prof_ops=[],\n+                             debug=False,\n+                             append=Mock())\n+    op_timer = Mock()\n+    op_timer.elapsed.return_value = 1.0\n+\n+    monkeypatch.setattr(comm, 'cdb', backend)\n+    monkeypatch.setattr(comm, 'comms_logger', logger)\n+    monkeypatch.setattr(comm, 'get_accelerator', lambda: SimpleNamespace(synchronize=lambda: None))\n+    monkeypatch.setattr(comm, 'timers', Mock(return_value=op_timer))\n+\n+    assert comm.all_reduce(torch.ones(4), group=group) == 'done'\n+\n+    logger.append.assert_called_once_with('all_reduce', 'all_reduce', 1.0, 16, group=group)\n+\n+\n @pytest.mark.parametrize('world_size', [1, 2, 4])\n @pytest.mark.parametrize('comm_op', ['broadcast_object_list', 'all_to_all'])\n def test_calc_bw_log_supports_object_and_list_collectives(monkeypatch, comm_op, world_size):\n@@ -198,3 +222,51 @@ def test_calc_bw_log_supports_object_and_list_collectives(monkeypatch, comm_op,\n         expected_busbw *= (world_size - 1) / world_size\n     assert tput == pytest.approx(expected_tput)\n     assert busbw == pytest.approx(expected_busbw)\n+\n+\n+def test_calc_bw_log_uses_subgroup_world_size_for_all_reduce(monkeypatch):\n+    import deepspeed.comm as dist\n+    from deepspeed.utils.comms_logging import calc_bw_log\n+\n+    subgroup = object()\n+\n+    def get_world_size(group=None):\n+        return 2 if group is subgroup else 4\n+\n+    monkeypatch.setattr(dist, 'get_world_size', get_world_size)\n+\n+    size = 1024\n+    duration = 2.0\n+    subgroup_world_size = 2\n+    expected_tput = size * 2 / duration * 8 / 1e6\n+    expected_busbw = size / duration * (2 * (subgroup_world_size - 1) / subgroup_world_size) * 8 / 1e6\n+\n+    tput, busbw = calc_bw_log('all_reduce', size, duration, group=subgroup)\n+\n+    assert tput == pytest.approx(expected_tput)\n+    assert busbw == pytest.approx(expected_busbw)\n+\n+\n+def test_comms_logger_keeps_different_subgroup_sizes_separate(monkeypatch):\n+    import deepspeed.comm as dist\n+    from deepspeed.utils.comms_logging import CommsLogger\n+\n+    subgroup_a = object()\n+    subgroup_b = object()\n+\n+    def get_world_size(group=None):\n+        return {subgroup_a: 2, subgroup_b: 3}.get(group, 4)\n+\n+    monkeypatch.setattr(dist, 'get_world_size', get_world_size)\n+    logger = object.__new__(CommsLogger)\n+    logger.comms_dict = {}\n+    logger.verbose = False\n+\n+    logger.append('all_reduce', 'all_reduce', 1.0, 1024, group=subgroup_a)\n+    logger.append('all_reduce', 'all_reduce', 1.0, 1024, group=subgroup_b)\n+\n+    assert set(logger.comms_dict) == {\n+        'all_reduce | [Group Size: 2]',\n+        'all_reduce | [Group Size: 3]',\n+    }\n+    assert all(records[1024][0] == 1 for records in logger.comms_dict.values())",
