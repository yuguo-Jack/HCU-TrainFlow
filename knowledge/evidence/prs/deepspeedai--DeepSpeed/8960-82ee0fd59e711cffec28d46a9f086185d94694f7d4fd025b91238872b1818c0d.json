      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b903694a4edd7997f647e33671b5dea5017aec29/deepspeed%2Fruntime%2Fsequence_parallel%2Fulysses_sp.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fsequence_parallel%2Fulysses_sp.py?ref=b903694a4edd7997f647e33671b5dea5017aec29",
      "deletions": 1,
      "filename": "deepspeed/runtime/sequence_parallel/ulysses_sp.py",
      "patch": "@@ -879,8 +879,9 @@ def backward(ctx, *grads) -> torch.Tensor:\n \n         incoming_grad = grads[0]\n         # since we perform a reduction of outputs that doesn't get included in `autograd.backward` below we need to pre-adjust the incoming gradient. in the case of \"sum\" the gradient is 1.0, in the case of \"mean\" it's 1.0/num_elements, which in this case is 1/shards.\n+        # not in place: autograd hands the same gradient tensor to every branch of a summed loss\n         if output_reduction == \"mean\":\n-            incoming_grad /= shards\n+            incoming_grad = incoming_grad / shards\n \n         if grad_requiring_tensor.shape[0] == 1:\n             grad_requiring_tensor_grad = torch.zeros_like(grad_requiring_tensor)",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/b903694a4edd7997f647e33671b5dea5017aec29/deepspeed%2Fruntime%2Fsequence_parallel%2Fulysses_sp.py",
      "sha": "4dbaf2ed960e8f0c0803f3d287f894bd8d95573d",
      "status": "modified"
    },
    {
      "additions": 37,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b903694a4edd7997f647e33671b5dea5017aec29/tests%2Funit%2Fulysses_alst%2Ftest_tiled_compute.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fulysses_alst%2Ftest_tiled_compute.py?ref=b903694a4edd7997f647e33671b5dea5017aec29",
      "deletions": 0,
      "filename": "tests/unit/ulysses_alst/test_tiled_compute.py",
      "patch": "@@ -292,6 +292,43 @@ def compute(x, scale, model):\n             torch.testing.assert_close(param, reference_param)\n \n \n+@pytest.mark.parametrize(\"tiled_first\", [True, False])\n+def test_sequence_tiled_compute_mean_keeps_other_loss_terms_intact(tiled_first):\n+    # \"mean\" divides the incoming gradient by the shard count. A loss that adds a second term hands both terms\n+    # the same gradient tensor, so dividing it in place also rescaled the gradient of the other term.\n+    device = get_accelerator().device_name()\n+    hidden_dim, seqlen, shards = 8, 8, 4\n+    torch.manual_seed(42)\n+    model = SimpleMLP(hidden_dim).to(device)\n+\n+    def compute(x):\n+        return mlp_forward_orig(model, x).sum()\n+\n+    x = torch.rand((1, seqlen, hidden_dim), device=device, requires_grad=True)\n+    x_reference = x.detach().clone().requires_grad_(True)\n+\n+    tiled = sequence_tiled_compute(\n+        compute,\n+        seqlen,\n+        shards,\n+        kwargs_to_shard={\"x\": x},\n+        kwargs_to_pass={},\n+        grad_requiring_tensor_key=\"x\",\n+        compute_params=list(model.parameters()),\n+        output_unshard_dimension=0,\n+        output_reduction=\"mean\",\n+    )\n+    loss = tiled + x.sum() if tiled_first else x.sum() + tiled\n+    loss.backward()\n+\n+    tile = seqlen // shards\n+    reference = sum(compute(x_reference[:, i * tile:(i + 1) * tile]) for i in range(shards)) / shards\n+    (reference + x_reference.sum()).backward()\n+\n+    torch_assert_close(loss, reference + x_reference.sum())\n+    torch_assert_close(x.grad, x_reference.grad)\n+\n+\n @pytest.mark.parametrize(\"shards\", [2, 4])\n @pytest.mark.parametrize(\"layout\", [\"transposed\", \"channel_slice\"])\n class TestTiledMLPInputLayout:",
