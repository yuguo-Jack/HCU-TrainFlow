  "files": [
    {
      "additions": 10,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e06d672b8b8f7be5c2bffc2c132f5679313d1ee3/deepspeed%2Fruntime%2Fzero%2Fstage3.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fzero%2Fstage3.py?ref=e06d672b8b8f7be5c2bffc2c132f5679313d1ee3",
      "deletions": 2,
      "filename": "deepspeed/runtime/zero/stage3.py",
      "patch": "@@ -148,6 +148,10 @@ def clear_params(self):\n \n INITIAL_MICRO_STEP_ID = -1\n \n+# Elements of a pinned master partition that _copy_pinned_master_to_device moves to the device at a time: 0.25 GiB in\n+# float32. A sub-group has up to sub_group_size (default 1e9) elements.\n+PINNED_MASTER_COPY_NUMEL = 2**26\n+\n \n class DeepSpeedZeroOptimizer_Stage3(ZeROOptimizer):\n     \"\"\"\n@@ -2868,8 +2872,12 @@ def _copy_pinned_master_to_device(self, dst, src):\n         \"\"\"Copy the pinned CPU master partition ``src`` into the low-precision device partition ``dst``.\n \n         The master goes to the device in its own dtype and is cast there, the form #5301 introduced in ZeRO-1/2:\n-        ``dst.copy_(src)`` would cast on the CPU into a pageable temporary and copy from that at a few GB/s.\"\"\"\n-        dst.copy_(src.to(dst.device, non_blocking=True))\n+        ``dst.copy_(src)`` would cast on the CPU into a pageable temporary and copy from that at a few GB/s. It goes in\n+        pieces, so that the device temporary is one piece and not the whole sub-group. The pieces run in order on one\n+        stream, so each piece can reuse the memory of the previous one.\"\"\"\n+        for start in range(0, src.numel(), PINNED_MASTER_COPY_NUMEL):\n+            numel = min(PINNED_MASTER_COPY_NUMEL, src.numel() - start)\n+            dst.narrow(0, start, numel).copy_(src.narrow(0, start, numel).to(dst.device, non_blocking=True))\n         # Callers expect the partition on the device when this returns: the parameter all-gathers of the next forward\n         # run on a stream that does not wait for this one.\n         event = get_accelerator().Event()",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/e06d672b8b8f7be5c2bffc2c132f5679313d1ee3/deepspeed%2Fruntime%2Fzero%2Fstage3.py",
      "sha": "6078268a1592ba83a591d675a7fe7603217ed7be",
      "status": "modified"
    },
    {
      "additions": 53,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/e06d672b8b8f7be5c2bffc2c132f5679313d1ee3/tests%2Funit%2Fv1%2Fzero%2Ftest_zero.py",
      "changes": 53,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fv1%2Fzero%2Ftest_zero.py?ref=e06d672b8b8f7be5c2bffc2c132f5679313d1ee3",
      "deletions": 0,
      "filename": "tests/unit/v1/zero/test_zero.py",
      "patch": "@@ -1919,6 +1919,59 @@ def test(self, force_ds_optim):\n             model, _, _, _ = deepspeed.initialize(model=model, optimizer=optimizer, config=config_dict)\n \n \n+@pytest.mark.skipif(not get_accelerator().is_bf16_supported(), reason=\"bf16 is not supported on this accelerator\")\n+class TestZero3OffloadPinnedCopyBackPieces(DistributedTest):\n+    \"\"\"The pinned copy-back moves the master to the device in pieces of 2**26 elements: step() needs one piece of\n+    device memory (0.25 GiB in float32) on top of what it starts with, not the whole sub-group (sub_group_size elements,\n+    1e9 by default), and every piece reaches its place in the partition.\"\"\"\n+    world_size = 1\n+\n+    def test(self):\n+        if get_accelerator().device_name() == \"cpu\":\n+            pytest.skip(\"on the CPU accelerator the master weights never leave the host\")\n+        # One sub-group of 134M elements: two pieces and a part of a third.\n+        hidden_dim = 4096\n+        config_dict = {\n+            \"train_micro_batch_size_per_gpu\": 1,\n+            \"optimizer\": {\n+                \"type\": \"Adam\",\n+                \"params\": {\n+                    \"lr\": 1e-3\n+                }\n+            },\n+            \"bf16\": {\n+                \"enabled\": True\n+            },\n+            \"zero_optimization\": {\n+                \"stage\": 3,\n+                \"offload_optimizer\": {\n+                    \"device\": \"cpu\",\n+                    \"pin_memory\": True\n+                }\n+            },\n+        }\n+        model = SimpleModel(hidden_dim, nlayers=8)\n+        model, _, _, _ = deepspeed.initialize(model=model, model_parameters=model.parameters(), config=config_dict)\n+        data_loader = random_dataloader(model=model,\n+                                        total_samples=1,\n+                                        hidden_dim=hidden_dim,\n+                                        device=model.device,\n+                                        dtype=torch.bfloat16)\n+        batch = next(iter(data_loader))\n+        model.backward(model(batch[0], batch[1]))\n+        get_accelerator().synchronize()\n+        allocated = get_accelerator().memory_allocated()\n+        get_accelerator().reset_peak_memory_stats()\n+        model.step()\n+        get_accelerator().synchronize()\n+        step_memory = get_accelerator().max_memory_allocated() - allocated\n+        assert step_memory <= 2**28, f\"step() took {step_memory / 2**20:.0f} MiB of device memory, more than one piece\"\n+\n+        optimizer = model.optimizer\n+        for master, partition in zip(optimizer.fp32_partitioned_groups_flat, optimizer.fp16_partitioned_groups_flat):\n+            assert torch.equal(partition.cpu(), master.to(partition.dtype))\n+\n+\n @pytest.mark.skipif(not get_accelerator().is_bf16_supported(), reason=\"bf16 is not supported on this accelerator\")\n @pytest.mark.parametrize(\"ratio\", [1.0, 0.5])\n class TestZero3OffloadPinnedCopyBack(DistributedTest):",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/e06d672b8b8f7be5c2bffc2c132f5679313d1ee3/tests%2Funit%2Fv1%2Fzero%2Ftest_zero.py",
      "sha": "7f2ef241006d3331b8b5a69c8a1c79f582305a42",
      "status": "modified"
    }
