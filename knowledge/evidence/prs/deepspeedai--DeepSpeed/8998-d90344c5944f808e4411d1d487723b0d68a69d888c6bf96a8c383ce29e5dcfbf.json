      "additions": 4,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/771f2284b83a7f8dcbe1edc5ea1d0d7ca722471f/deepspeed%2Fcomm%2Futils.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fcomm%2Futils.py?ref=771f2284b83a7f8dcbe1edc5ea1d0d7ca722471f",
      "deletions": 2,
      "filename": "deepspeed/comm/utils.py",
      "patch": "@@ -114,8 +114,10 @@ def get_msg_size_from_args(func, *args, **kwargs):\n     # check if tensor arg is in args\n     if len(args) > 0:\n         tensor_arg_position = get_tensor_position(func)\n-        if tensor_arg_position > -1:\n-            tensor_arg = args[get_tensor_position(func)]\n+        # The tensor may still be passed by keyword after other positional args,\n+        # e.g. all_gather_into_tensor(output, tensor=input)\n+        if -1 < tensor_arg_position < len(args):\n+            tensor_arg = args[tensor_arg_position]\n     # check if tensor arg is in kwargs\n     if tensor_arg is None and len(kwargs) > 0:\n         tensor_arg = get_tensor_kwarg(func, kwargs)",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/771f2284b83a7f8dcbe1edc5ea1d0d7ca722471f/deepspeed%2Fcomm%2Futils.py",
      "sha": "5ff72fcb7b6e7f3c0a751f4fc3cdc97aeb9512e7",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/771f2284b83a7f8dcbe1edc5ea1d0d7ca722471f/tests%2Funit%2Fcomm%2Ftest_comms_logger.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fcomm%2Ftest_comms_logger.py?ref=771f2284b83a7f8dcbe1edc5ea1d0d7ca722471f",
      "deletions": 0,
      "filename": "tests/unit/comm/test_comms_logger.py",
      "patch": "@@ -124,6 +124,31 @@ def barrier(log_name='barrier'):\n     assert 'barrier' in comm.comms_logger.comms_dict\n \n \n+def test_profiled_op_accepts_tensor_passed_by_keyword(monkeypatch):\n+    # The input tensor of all_gather_into_tensor is its second parameter. Passing it by\n+    # keyword after a positional output used to raise IndexError once profiling was on.\n+    from deepspeed.comm import comm\n+\n+    backend_op = Mock(return_value='done')\n+    monkeypatch.setattr(\n+        comm, 'cdb',\n+        SimpleNamespace(using_mpi=False,\n+                        is_initialized=lambda: True,\n+                        get_world_size=lambda group=None: 2,\n+                        all_gather_into_tensor=backend_op))\n+    monkeypatch.setattr(comm, 'get_accelerator', lambda: SimpleNamespace(synchronize=lambda: None))\n+    monkeypatch.setattr(comm, 'comms_logger', CommsLogger())\n+    comm.comms_logger.enabled = True\n+    comm.comms_logger.start_profiling_comms()\n+\n+    input_tensor = torch.ones(4)\n+    output_tensor = torch.empty(8)\n+    assert comm.all_gather_into_tensor(output_tensor, tensor=input_tensor) == 'done'\n+\n+    msg_size = input_tensor.numel() * input_tensor.element_size()\n+    assert msg_size in comm.comms_logger.comms_dict['all_gather_into_tensor']\n+\n+\n @pytest.mark.parametrize('op_name', ['broadcast_object_list', 'all_to_all'])\n @pytest.mark.parametrize('positional', [False, True])\n @pytest.mark.parametrize('debug', [False, True])",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/771f2284b83a7f8dcbe1edc5ea1d0d7ca722471f/tests%2Funit%2Fcomm%2Ftest_comms_logger.py",
      "sha": "d4527bd1b7b5062ae13ff9a888152e402b0f898a",
      "status": "modified"
    }
