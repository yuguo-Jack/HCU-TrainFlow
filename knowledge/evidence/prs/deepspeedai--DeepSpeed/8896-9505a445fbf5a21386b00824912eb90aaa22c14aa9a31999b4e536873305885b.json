    {
      "additions": 16,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/1280a7052fa2d776fba7b618f6512ec84beee3b4/tests%2Funit%2Fcomm%2Ftest_comms_logger.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fcomm%2Ftest_comms_logger.py?ref=1280a7052fa2d776fba7b618f6512ec84beee3b4",
      "deletions": 0,
      "filename": "tests/unit/comm/test_comms_logger.py",
      "patch": "@@ -198,3 +198,19 @@ def test_calc_bw_log_supports_object_and_list_collectives(monkeypatch, comm_op,\n         expected_busbw *= (world_size - 1) / world_size\n     assert tput == pytest.approx(expected_tput)\n     assert busbw == pytest.approx(expected_busbw)\n+\n+\n+@pytest.mark.parametrize('comm_op', ['all_gather_object', 'monitored_barrier'])\n+def test_calc_bw_log_supports_every_timed_op(monkeypatch, comm_op):\n+    # all_gather_object and monitored_barrier are wrapped in timed_op but had no\n+    # branch in calc_bw_log, which printed \"wrong comm_op specified\" and called\n+    # exit(0), silently ending the training process when comms profiling was on.\n+    import deepspeed.comm as dist\n+    from deepspeed.utils.comms_logging import calc_bw_log\n+\n+    monkeypatch.setattr(dist, 'get_world_size', lambda group=None: 2)\n+    monkeypatch.setattr(dist, 'get_rank', lambda group=None: 0)\n+\n+    tput, busbw = calc_bw_log(comm_op, 0, 2.0)\n+    assert tput == 0\n+    assert busbw == 0",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/1280a7052fa2d776fba7b618f6512ec84beee3b4/tests%2Funit%2Fcomm%2Ftest_comms_logger.py",
      "sha": "0ee80198ab4ee5fe98ee3089ff5c33e438817453",
      "status": "modified"
    }
