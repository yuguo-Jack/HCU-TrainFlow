      "filename": "op_builder/npu/async_io.py",
      "patch": "@@ -6,7 +6,7 @@\n import shutil\n import subprocess\n \n-from .builder import NPUOpBuilder\n+from .builder import NPUOpBuilder, cpp_standard\n \n \n class AsyncIOBuilder(NPUOpBuilder):\n@@ -39,17 +39,11 @@ def cxx_args(self):\n         # -O0 for improved debugging, since performance is bound by I/O\n         CPU_ARCH = self.cpu_arch()\n         SIMD_WIDTH = self.simd_width()\n-        import torch  # Keep this import here to avoid errors when building DeepSpeed wheel without torch installed\n-        TORCH_MAJOR, TORCH_MINOR = map(int, torch.__version__.split('.')[0:2])\n-        if TORCH_MAJOR >= 2 and TORCH_MINOR >= 1:\n-            CPP_STD = '-std=c++17'\n-        else:\n-            CPP_STD = '-std=c++14'\n         return args + [\n             '-g',\n             '-Wall',\n             '-O0',\n-            CPP_STD,\n+            cpp_standard(),\n             '-shared',\n             '-fPIC',\n             '-Wno-reorder',",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/a8bde9ee3744700d649eb653257404361dd5b07b/op_builder%2Fnpu%2Fasync_io.py",
      "sha": "2e841fd113eb8ea71acfa5e26477736894a8ac9a",
