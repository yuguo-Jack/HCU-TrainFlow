    {
      "additions": 13,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/a8bde9ee3744700d649eb653257404361dd5b07b/op_builder%2Fnpu%2Fbuilder.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/op_builder%2Fnpu%2Fbuilder.py?ref=a8bde9ee3744700d649eb653257404361dd5b07b",
      "deletions": 1,
      "filename": "op_builder/npu/builder.py",
      "patch": "@@ -19,6 +19,18 @@\n     from deepspeed.ops.op_builder.builder import OpBuilder\n \n \n+def cpp_standard():\n+    import torch\n+    torch_major, torch_minor = map(int, torch.__version__.split('.')[0:2])\n+    # PyTorch headers require C++17 on 2.x and C++20 from 2.12 on; a later -std flag overrides\n+    # the one torch adds. Same rule as the XPU builders (#8803). CANN supports the C++20\n+    # standard on NPU (C++ standard support appendix in the CANN devkit guide):\n+    # https://www.hiascend.com/document/detail/en/CANNCommunityEdition/latest/programug/Ascendcopdevg/docs/en/guide/technical_appendix/cpp_standard_support/overview.md\n+    if (torch_major, torch_minor) >= (2, 12):\n+        return '-std=c++20'\n+    return '-std=c++17'\n+\n+\n class NPUOpBuilder(OpBuilder):\n     _ascend_path = None\n     _torch_npu_path = None\n@@ -67,7 +79,7 @@ def include_paths(self):\n \n     def cxx_args(self):\n         args = super().cxx_args()\n-        args += ['-O3', '-std=c++17', '-g', '-Wno-reorder', '-fopenmp']\n+        args += ['-O3', cpp_standard(), '-g', '-Wno-reorder', '-fopenmp']\n         args += ['-fstack-protector-all', '-Wl,-z,relro,-z,now,-z,noexecstack', '-Wl,--disable-new-dtags,--rpath']\n         args += [\n             self.cann_defs(),",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/a8bde9ee3744700d649eb653257404361dd5b07b/op_builder%2Fnpu%2Fbuilder.py",
      "sha": "42c3cefd57f3d2b4d752e2286ba860bf68d4d1b4",
      "status": "modified"
    }
