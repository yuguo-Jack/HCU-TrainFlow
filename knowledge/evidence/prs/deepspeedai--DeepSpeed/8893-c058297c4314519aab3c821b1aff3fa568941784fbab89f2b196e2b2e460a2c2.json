      "deletions": 10,
      "filename": "deepspeed/runtime/utils.py",
      "patch": "@@ -645,20 +645,20 @@ def partition_balanced(weights, num_parts):\n     dp_max[0, 0] = 0\n     dp_cost[0, 0] = 0\n     for i in range(1, n + 1):\n+        part_sum = prefix_sum[i] - prefix_sum[:i]\n         for j in range(1, min(i, m) + 1):\n-            for k in range(i):\n-                max_sum = max(dp_max[k, j - 1], prefix_sum[i] - prefix_sum[k])\n-                min_sum = min(dp_min[k, j - 1], prefix_sum[i] - prefix_sum[k])\n-                cost = max_sum - min_sum\n-                if dp_cost[i, j] >= cost:\n-                    dp_cost[i, j] = cost\n-                    dp_max[i, j] = max_sum\n-                    dp_min[i, j] = min_sum\n-                    position[i, j] = k\n+            max_sum = np.maximum(dp_max[:i, j - 1], part_sum)\n+            min_sum = np.minimum(dp_min[:i, j - 1], part_sum)\n+            cost = max_sum - min_sum\n+            k = i - 1 - int(np.argmin(cost[::-1]))\n+            dp_cost[i, j] = cost[k]\n+            dp_max[i, j] = max_sum[k]\n+            dp_min[i, j] = min_sum[k]\n+            position[i, j] = k\n \n     parts = [n]\n     for i in reversed(range(1, m + 1)):\n-        parts.append(position[parts[-1], i])\n+        parts.append(int(position[parts[-1], i]))\n     parts.reverse()\n \n     return parts",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/a0f7a0ccdf3a50b92f4a1e6dd2f79cfad2eb5c50/deepspeed%2Fruntime%2Futils.py",
