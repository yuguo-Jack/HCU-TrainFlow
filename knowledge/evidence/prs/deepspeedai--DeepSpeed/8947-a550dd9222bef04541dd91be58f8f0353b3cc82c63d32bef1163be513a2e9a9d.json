      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b7e9d8f22c718613fb0cb06647faeb7a6d071dcc/deepspeed%2Fruntime%2Frollout%2Fopsd.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Frollout%2Fopsd.py?ref=b7e9d8f22c718613fb0cb06647faeb7a6d071dcc",
      "deletions": 3,
      "filename": "deepspeed/runtime/rollout/opsd.py",
      "patch": "@@ -126,8 +126,9 @@ def generalized_jsd_loss(student_logits: torch.Tensor,\n     if pointwise_clip is not None:\n         pointwise_jsd = pointwise_jsd.clamp(max=pointwise_clip)\n \n-    response_mask = response_mask.to(dtype=pointwise_jsd.dtype)\n-    loss_sum = (pointwise_jsd.sum(dim=-1) * response_mask).sum()\n-    valid_token_count = response_mask.sum().to(dtype=torch.long)\n+    # Reduce in at least float32: a bf16 sum rounds token counts above 256 and an fp16 sum overflows past 65504.\n+    accum_dtype = torch.promote_types(pointwise_jsd.dtype, torch.float32)\n+    loss_sum = (pointwise_jsd.sum(dim=-1, dtype=accum_dtype) * response_mask).sum()\n+    valid_token_count = response_mask.sum(dtype=torch.long)\n     loss = loss_sum / valid_token_count.clamp_min(1)\n     return JSDLossOutput(loss=loss, loss_sum=loss_sum, valid_token_count=valid_token_count)",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/b7e9d8f22c718613fb0cb06647faeb7a6d071dcc/deepspeed%2Fruntime%2Frollout%2Fopsd.py",
      "sha": "f893f4f2811e618d822b2ba3cfff95eb4102211b",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b7e9d8f22c718613fb0cb06647faeb7a6d071dcc/tests%2Funit%2Fruntime%2Frollout%2Ftest_rollout_interface.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fruntime%2Frollout%2Ftest_rollout_interface.py?ref=b7e9d8f22c718613fb0cb06647faeb7a6d071dcc",
      "deletions": 0,
      "filename": "tests/unit/runtime/rollout/test_rollout_interface.py",
      "patch": "@@ -159,6 +159,22 @@ def test_generalized_jsd_loss_supports_top_k_and_empty_response_masks():\n     assert empty.loss.item() == pytest.approx(0.0)\n \n \n+@pytest.mark.parametrize(\"dtype\", [torch.bfloat16, torch.float16])\n+def test_generalized_jsd_loss_counts_tokens_exactly_for_low_precision_logits(dtype):\n+    # 97992 valid tokens: not representable in bf16, and past fp16's largest finite value of 65504.\n+    torch.manual_seed(0)\n+    student_logits = torch.randn(24, 4096, 4).to(dtype)\n+    teacher_logits = torch.randn(24, 4096, 4).to(dtype)\n+    response_mask = torch.ones(24, 4096, dtype=torch.bool)\n+    response_mask[:, :13] = False\n+\n+    output = generalized_jsd_loss(student_logits, teacher_logits, response_mask)\n+    reference = generalized_jsd_loss(student_logits.float(), teacher_logits.float(), response_mask)\n+\n+    assert output.valid_token_count.item() == response_mask.sum().item()\n+    assert output.loss.item() == pytest.approx(reference.loss.item(), rel=5e-2)\n+\n+\n # --- interface conformance via FakeRollout ---------------------------------\n \n ",
