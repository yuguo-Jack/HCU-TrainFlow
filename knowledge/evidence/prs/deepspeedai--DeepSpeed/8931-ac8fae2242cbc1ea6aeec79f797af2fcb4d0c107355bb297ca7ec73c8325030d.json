      "additions": 10,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/09fc93030cb732f1fc24bfb2dc47285f6511e8ba/deepspeed%2Finference%2Fv2%2Fragged%2Fblocked_allocator.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Finference%2Fv2%2Fragged%2Fblocked_allocator.py?ref=09fc93030cb732f1fc24bfb2dc47285f6511e8ba",
      "deletions": 0,
      "filename": "deepspeed/inference/v2/ragged/blocked_allocator.py",
      "patch": "@@ -84,14 +84,24 @@ def free(self, blocks: Union[Iterable[int], int]) -> None:\n         if isinstance(blocks, int):\n             blocks = [blocks]\n \n+        seen_blocks = set()\n         for block in blocks:\n             # Parse all blocks for validity before mutating the list.\n+            # Normalize to int: callers may pass tensors (e.g. all_block_ids),\n+            # and 0-dim tensors hash by identity, which would defeat\n+            # duplicate detection below.\n+            block = int(block)\n             if block < 0 or block >= self._num_blocks:\n                 raise ValueError(f'Invalid block {block} provided to free')\n \n+            if block in seen_blocks:\n+                raise ValueError(f'Block {block} provided multiple times to free')\n+\n             if self._blocks[block] != -1:\n                 raise ValueError(f'Block {block} is already free')\n \n+            seen_blocks.add(block)\n+\n         for block in blocks:\n             self._blocks[block] = self._head\n             self._head = block",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/09fc93030cb732f1fc24bfb2dc47285f6511e8ba/deepspeed%2Finference%2Fv2%2Fragged%2Fblocked_allocator.py",
      "sha": "cef03993eddaac5e952b710d5a1273e8bf968d0c",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/09fc93030cb732f1fc24bfb2dc47285f6511e8ba/tests%2Funit%2Finference%2Fv2%2Fragged%2Ftest_blocked_allocator.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Finference%2Fv2%2Fragged%2Ftest_blocked_allocator.py?ref=09fc93030cb732f1fc24bfb2dc47285f6511e8ba",
      "deletions": 0,
      "filename": "tests/unit/inference/v2/ragged/test_blocked_allocator.py",
      "patch": "@@ -164,3 +164,28 @@ def validate_uniqueness(all_blocks: List[torch.Tensor]) -> None:\n \n     assert num_allocs == num_frees + len(all_allocs)\n     assert num_blocks_allocated == num_blocks_freed + (TOTAL_BLOCKS - allocator.free_blocks)\n+\n+\n+@pytest.mark.inference_v2\n+def test_free_duplicate_block_rejected() -> None:\n+    \"\"\"Freeing the same block twice in one call must be rejected: the\n+    pre-validation loop used to pass (blocks are only marked during the\n+    mutation loop), corrupting the free list with a duplicate entry that\n+    would hand the same KV block to two sequences.\"\"\"\n+    allocator = BlockedAllocator(16)\n+\n+    allocated = allocator.allocate(4)\n+    free_count = allocator.free_blocks\n+\n+    duplicate = int(allocated[0])\n+    with pytest.raises(ValueError):\n+        allocator.free([duplicate, duplicate])\n+\n+    # Allocator state must be unchanged by the failed call.\n+    assert allocator.free_blocks == free_count\n+\n+    # The blocks are still usable exactly once.\n+    allocator.free(allocated)\n+    assert allocator.free_blocks == 16\n+    again = allocator.allocate(16)\n+    assert torch.unique(again).numel() == 16",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/09fc93030cb732f1fc24bfb2dc47285f6511e8ba/tests%2Funit%2Finference%2Fv2%2Fragged%2Ftest_blocked_allocator.py",
      "sha": "cac6ade8dfece66b0680f05ced45d948cae2431e",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Use normalized block IDs in the mutation pass**\n\nWhen block 1 is allocated and a caller passes `free(True)` (or a 0-D bool tensor), the conversion validates ID 1, but the mutation loop still uses the original `True`. PyTorch treats that as a boolean mask, so `self._blocks[True] = ...` overwrites the whole free-list tensor while only incrementing `_free_blocks` once, corrupting allocator state; materialize the normalized IDs and use them in both passes (or reject booleans).\n\nUseful? React with 👍 / 👎.\n\n<!-- codex-code-review-finding:v1 -->",
      "created_at": "2026-10-28T03:10:02Z",
      "diff_hunk": "@@ -84,14 +84,24 @@ def free(self, blocks: Union[Iterable[int], int]) -> None:\n         if isinstance(blocks, int):\n             blocks = [blocks]\n \n+        seen_blocks = set()\n         for block in blocks:\n             # Parse all blocks for validity before mutating the list.\n+            # Normalize to int: callers may pass tensors (e.g. all_block_ids),\n+            # and 0-dim tensors hash by identity, which would defeat\n+            # duplicate detection below.\n+            block = int(block)",
      "html_url": "https://github.com/deepspeedai/DeepSpeed/pull/8931#discussion_r4396510890",
