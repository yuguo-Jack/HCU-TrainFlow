      "additions": 2,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b509650127a592751cc8340b0ad81da7ea4c24be/deepspeed%2Fruntime%2Fzero%2Fpartition_parameters.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fzero%2Fpartition_parameters.py?ref=b509650127a592751cc8340b0ad81da7ea4c24be",
      "deletions": 2,
      "filename": "deepspeed/runtime/zero/partition_parameters.py",
      "patch": "@@ -267,7 +267,7 @@ def wrapped_fn(*args, **kwargs) -> Tensor:\n         if kwargs.get(\"device\", None) is None and target_device is not None:\n             kwargs['device'] = target_device\n         tensor: Tensor = fn(*args, **kwargs)\n-        if target_fp_dtype is not None and tensor.is_floating_point():\n+        if target_fp_dtype is not None and tensor.is_floating_point() and kwargs.get('dtype') is None:\n             tensor.data = tensor.data.to(target_fp_dtype)\n \n         return tensor\n@@ -285,7 +285,7 @@ def new_tensor(cls, *args, **kwargs) -> Tensor:\n         else:\n             tensor = _orig_torch_empty(0, device=target_device).new_empty(*args, **kwargs)\n \n-        if tensor.is_floating_point() and target_fp_dtype is not None:\n+        if tensor.is_floating_point() and target_fp_dtype is not None and kwargs.get('dtype') is None:\n             tensor = tensor.to(target_fp_dtype)\n \n         return tensor",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/b509650127a592751cc8340b0ad81da7ea4c24be/deepspeed%2Fruntime%2Fzero%2Fpartition_parameters.py",
      "sha": "16039a38c9000055c05be8970dc1ce1aef22617c",
      "status": "modified"
    },
    {
      "additions": 49,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/b509650127a592751cc8340b0ad81da7ea4c24be/tests%2Funit%2Fruntime%2Fzero%2Ftest_zero_init_preserve_dtype.py",
      "changes": 49,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fruntime%2Fzero%2Ftest_zero_init_preserve_dtype.py?ref=b509650127a592751cc8340b0ad81da7ea4c24be",
      "deletions": 0,
      "filename": "tests/unit/runtime/zero/test_zero_init_preserve_dtype.py",
      "patch": "@@ -0,0 +1,49 @@\n+# Copyright (c) Microsoft Corporation.\n+# SPDX-License-Identifier: Apache-2.0\n+\n+# DeepSpeed Team\n+\n+import pytest\n+import torch\n+\n+from deepspeed.runtime.zero.partition_parameters import zero_wrapper_for_fp_tensor_constructor\n+\n+\n+class TestZeroWrapperPreservesExplicitDtype:\n+    \"\"\"Ensure zero_wrapper_for_fp_tensor_constructor respects an explicit dtype kwarg.\"\"\"\n+\n+    @pytest.fixture\n+    def wrapped_arange(self):\n+        return zero_wrapper_for_fp_tensor_constructor(torch.arange, torch.bfloat16, None)\n+\n+    def test_no_dtype_kwarg_casts_to_target(self, wrapped_arange):\n+        t = wrapped_arange(0, 4)\n+        assert t.dtype == torch.bfloat16\n+\n+    def test_explicit_float32_preserved(self, wrapped_arange):\n+        t = wrapped_arange(0, 4, dtype=torch.float32)\n+        assert t.dtype == torch.float32\n+\n+    def test_explicit_float64_preserved(self, wrapped_arange):\n+        t = wrapped_arange(0, 4, dtype=torch.float64)\n+        assert t.dtype == torch.float64\n+\n+    def test_explicit_none_casts_to_target(self, wrapped_arange):\n+        t = wrapped_arange(0, 4, dtype=None)\n+        assert t.dtype == torch.bfloat16\n+\n+    def test_integer_dtype_not_cast(self, wrapped_arange):\n+        t = wrapped_arange(0, 4, dtype=torch.int64)\n+        assert t.dtype == torch.int64\n+\n+    @pytest.mark.parametrize(\"fn\", [torch.empty, torch.zeros, torch.ones, torch.randn])\n+    def test_explicit_float32_on_creation_fns(self, fn):\n+        wrapped = zero_wrapper_for_fp_tensor_constructor(fn, torch.bfloat16, None)\n+        t = wrapped(4, dtype=torch.float32)\n+        assert t.dtype == torch.float32\n+\n+    @pytest.mark.parametrize(\"fn\", [torch.empty, torch.zeros, torch.ones, torch.randn])\n+    def test_no_dtype_on_creation_fns_casts(self, fn):\n+        wrapped = zero_wrapper_for_fp_tensor_constructor(fn, torch.bfloat16, None)\n+        t = wrapped(4)\n+        assert t.dtype == torch.bfloat16",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/b509650127a592751cc8340b0ad81da7ea4c24be/tests%2Funit%2Fruntime%2Fzero%2Ftest_zero_init_preserve_dtype.py",
      "sha": "4ccd07d7fdf9a55a394e9be4002a56d1436a8959",
