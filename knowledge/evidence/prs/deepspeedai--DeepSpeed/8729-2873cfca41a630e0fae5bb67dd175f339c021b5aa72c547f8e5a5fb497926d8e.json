  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/18ae4a613451bf0a54623e52643a4ca2a724ec35/deepspeed%2Fruntime%2Fcomm%2Fcoalesced_collectives.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/deepspeed%2Fruntime%2Fcomm%2Fcoalesced_collectives.py?ref=18ae4a613451bf0a54623e52643a4ca2a724ec35",
      "deletions": 1,
      "filename": "deepspeed/runtime/comm/coalesced_collectives.py",
      "patch": "@@ -72,7 +72,9 @@ def all_to_all_quant_reduce(tensors: List[Tensor], groups: {}) -> List[Tensor]:\n                                                        4, quantizer_module.Symmetric)\n             assert final_output.numel(\n             ) % num_nodes == 0, f\"final_output.numel()={final_output.numel()} is not divisible by num_nodes={num_nodes}\"\n-            output_lst[idx] = (sum(list(final_output.chunk(num_nodes))) / num_nodes).view(-1)\n+            # quantized_reduction summed the local ranks and this sums the nodes, so divide by\n+            # every rank to return the average, as the reduce_scatter fallback above does.\n+            output_lst[idx] = (sum(list(final_output.chunk(num_nodes))) / global_world_size).view(-1)\n     return output_lst\n \n ",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/18ae4a613451bf0a54623e52643a4ca2a724ec35/deepspeed%2Fruntime%2Fcomm%2Fcoalesced_collectives.py",
      "sha": "1b7153e73c6d26a7efe6dc8973876e16e5a7be9b",
      "status": "modified"
    },
    {
      "additions": 35,
      "blob_url": "https://github.com/deepspeedai/DeepSpeed/blob/18ae4a613451bf0a54623e52643a4ca2a724ec35/tests%2Funit%2Fruntime%2Fcomm%2Ftest_coalesced_collectives.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/deepspeedai/DeepSpeed/contents/tests%2Funit%2Fruntime%2Fcomm%2Ftest_coalesced_collectives.py?ref=18ae4a613451bf0a54623e52643a4ca2a724ec35",
      "deletions": 0,
      "filename": "tests/unit/runtime/comm/test_coalesced_collectives.py",
      "patch": "@@ -96,3 +96,38 @@ def test_non_divisible(self):\n         elif dist.get_rank() == 1:\n             assert output.shape == (24, )\n             assert torch.allclose(output, torch.zeros_like(output))\n+\n+\n+class TestAllToAllQuantReduceAverage(DistributedTest):\n+    world_size = 4\n+    backend = \"gloo\"\n+    requires_cuda_env = False\n+\n+    def _launch_procs(self, num_procs, init_method):\n+        # CPU tensors on gloo, so the four ranks do not need four accelerator devices.\n+        torch.multiprocessing.set_start_method('forkserver', force=True)\n+        self._launch_daemonic_procs(num_procs, init_method)\n+\n+    def test_matches_reduce_scatter_average(self):\n+        # Run the two-stage qgZ path as 2 nodes x 2 devices with the pure-torch quantizer.\n+        # Rank r holds -(r + 1) everywhere, which int4 represents exactly at every stage,\n+        # so the result must be the plain average -2.5, the same as the 1D fallback.\n+        from deepspeed.ops.op_builder.npu.quantizer import NPUQuantizer\n+        from deepspeed.runtime.comm import coalesced_collectives\n+        from deepspeed.utils import groups\n+\n+        accelerator = get_accelerator()\n+        saved_device_count, saved_module = accelerator.device_count, coalesced_collectives.quantizer_module\n+        accelerator.device_count = lambda: 2\n+        coalesced_collectives.quantizer_module = NPUQuantizer\n+        try:\n+            value = -(dist.get_rank() + 1.0)\n+            weight = torch.full((8, 16), value, dtype=torch.half)\n+            bias = torch.full((16, ), value, dtype=torch.half)\n+            outputs = all_to_all_quant_reduce([weight, bias], groups._get_local_all_to_all_group())\n+        finally:\n+            accelerator.device_count = saved_device_count\n+            coalesced_collectives.quantizer_module = saved_module\n+\n+        for output in outputs:\n+            assert torch.equal(output.float(), torch.full_like(output.float(), -2.5))",
      "raw_url": "https://github.com/deepspeedai/DeepSpeed/raw/18ae4a613451bf0a54623e52643a4ca2a724ec35/tests%2Funit%2Fruntime%2Fcomm%2Ftest_coalesced_collectives.py",
      "sha": "9875f5d170d780773d766ccde1832b1a82cf9569",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "This test does not actually select Gloo: `DistributedTest` inherits the accelerator's default backend, and it also requires four accelerator devices before launching. Consequently, CPU/low-device CI skips it and accelerator CI runs NCCL/HCCL rather than the Gloo path described by the PR. Configure a CPU/Gloo launch (including bypassing the accelerator-count gate, as the existing CPU/Gloo distributed tests do) and allocate these tensors on CPU so the regression test runs in the intended environment.",
      "created_at": "2026-10-03T03:57:22Z",
      "diff_hunk": "@@ -96,3 +96,32 @@ def test_non_divisible(self):\n         elif dist.get_rank() == 1:\n             assert output.shape == (24, )\n             assert torch.allclose(output, torch.zeros_like(output))\n+\n+\n+class TestAllToAllQuantReduceAverage(DistributedTest):\n+    world_size = 4",
      "html_url": "https://github.com/deepspeedai/DeepSpeed/pull/8729#discussion_r4171606795",
