  "inline_comments": [
    {
      "body": "Verified this against the upstream template: `MiniMaxAI/MiniMax-M2`'s `chat_template.jinja` sets `toolcall_begin_token = '<minimax:tool_call>'` and `toolcall_end_token = '</minimax:tool_call>'` around the `<invoke>` blocks, so the wrapper was genuinely missing. `MiniMaxM2ToolUtils.tool_extractor` already required it (`re.compile(r\"<minimax:tool_call>\\s*(.+?)\\s*</minimax:tool_call>\")`), which means the round trip could not have worked before this.",
      "created_at": "2026-08-29T09:11:54Z",
      "diff_hunk": "@@ -521,7 +521,7 @@ def function_formatter(functions: list[\"FunctionCall\"]) -> str:\n             prompt += \"\\n</invoke>\"\n             function_texts.append(prompt)\n \n-        return \"\\n\".join(function_texts)\n+        return \"<minimax:tool_call>\\n\" + \"\\n\".join(function_texts) + \"\\n</minimax:tool_call>\"",
      "html_url": "https://github.com/hiyouga/LlamaFactory/pull/10586#discussion_r3886124029",
      "id": 3886124029,
      "line": 552,
      "original_line": 524,
      "path": "src/llamafactory/data/tool_utils.py",
      "updated_at": "2026-08-29T09:11:54Z",
      "user": {
        "login": "khazic"
      }
    }
  ],
