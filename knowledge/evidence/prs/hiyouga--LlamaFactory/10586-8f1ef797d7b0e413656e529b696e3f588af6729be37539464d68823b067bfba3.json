      "patch": "@@ -549,7 +549,7 @@ def function_formatter(functions: list[\"FunctionCall\"]) -> str:\n             prompt += \"\\n</invoke>\"\n             function_texts.append(prompt)\n \n-        return \"\\n\".join(function_texts)\n+        return \"<minimax:tool_call>\\n\" + \"\\n\".join(function_texts) + \"\\n</minimax:tool_call>\"\n \n     @override\n     @staticmethod",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/1178508c8678101b8351fd7487a2c4ad6e4e575f/src%2Fllamafactory%2Fdata%2Ftool_utils.py",
