      "deletions": 1,
      "filename": "src/llamafactory/model/model_utils/attention.py",
      "patch": "@@ -32,7 +32,10 @@ def configure_attn_implementation(config: \"PretrainedConfig\", model_args: \"Model\n     from transformers.utils import is_flash_attn_2_available\n \n     if getattr(config, \"model_type\", None) == \"gpt_oss\":\n-        from transformers.integrations.hub_kernels import load_and_register_kernel\n+        try:  # transformers >= 5.0.0\n+            from transformers.integrations.hub_kernels import load_and_register_attn_kernel as load_and_register_kernel\n+        except ImportError:\n+            from transformers.integrations.hub_kernels import load_and_register_kernel\n \n         flash_attn3_kernel = \"kernels-community/vllm-flash-attn3\"\n         load_and_register_kernel(flash_attn3_kernel)",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/81b44bec45d8cf7173975915fb2a4d807c3ac82e/src%2Fllamafactory%2Fmodel%2Fmodel_utils%2Fattention.py",
      "sha": "60125723914a1f67dd7b009e8aa89435b0ab0acc",
      "status": "modified"
    },
    {
      "additions": 27,
      "blob_url": "https://github.com/hiyouga/LlamaFactory/blob/81b44bec45d8cf7173975915fb2a4d807c3ac82e/tests%2Fmodel%2Fmodel_utils%2Ftest_attention.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/hiyouga/LlamaFactory/contents/tests%2Fmodel%2Fmodel_utils%2Ftest_attention.py?ref=81b44bec45d8cf7173975915fb2a4d807c3ac82e",
      "deletions": 0,
      "filename": "tests/model/model_utils/test_attention.py",
      "patch": "@@ -58,3 +58,30 @@ def test_attention():\n         for module in model.modules():\n             if \"Attention\" in module.__class__.__name__:\n                 assert module.__class__.__name__ == llama_attention_classes[requested_attention]\n+\n+\n+def test_gpt_oss_attention_kernel():\n+    from unittest.mock import patch\n+\n+    from transformers import PretrainedConfig\n+\n+    from llamafactory.extras.constants import AttentionFunction\n+    from llamafactory.hparams import ModelArguments\n+    from llamafactory.model.model_utils.attention import configure_attn_implementation\n+\n+    if is_transformers_version_greater_than(\"5.0.0\"):\n+        kernel_loader = \"transformers.integrations.hub_kernels.load_and_register_attn_kernel\"\n+    elif is_transformers_version_greater_than(\"4.56.0\"):\n+        kernel_loader = \"transformers.integrations.hub_kernels.load_and_register_kernel\"\n+    else:\n+        pytest.skip(\"Hub kernels for attention require transformers>=4.56.0.\")\n+\n+    config = PretrainedConfig()\n+    config.model_type = \"gpt_oss\"\n+    model_args = ModelArguments(model_name_or_path=TINY_LLAMA3)\n+    with patch(kernel_loader) as mock_loader:\n+        configure_attn_implementation(config, model_args)\n+\n+    mock_loader.assert_called_once_with(\"kernels-community/vllm-flash-attn3\")\n+    assert config._attn_implementation == \"kernels-community/vllm-flash-attn3\"\n+    assert model_args.flash_attn == AttentionFunction.FA3",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/81b44bec45d8cf7173975915fb2a4d807c3ac82e/tests%2Fmodel%2Fmodel_utils%2Ftest_attention.py",
      "sha": "5d46bcdf8c60240d087002bb8ac62cc481ab1f70",
