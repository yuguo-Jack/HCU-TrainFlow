    {
      "additions": 1,
      "blob_url": "https://github.com/hiyouga/LlamaFactory/blob/ff5f3d2f37fa67fcd6b3eb5fe6e92e387f584f15/src%2Fllamafactory%2Fdata%2Fmm_plugin.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/hiyouga/LlamaFactory/contents/src%2Fllamafactory%2Fdata%2Fmm_plugin.py?ref=ff5f3d2f37fa67fcd6b3eb5fe6e92e387f584f15",
      "deletions": 1,
      "filename": "src/llamafactory/data/mm_plugin.py",
      "patch": "@@ -2286,7 +2286,7 @@ def _regularize_videos(self, videos: list[\"VideoInput\"], **kwargs) -> \"Regulariz\n                     if not is_valid_image(frame) and not isinstance(frame, dict) and not os.path.exists(frame):\n                         raise ValueError(\"Invalid image found in video frames.\")\n \n-                frames = video\n+                frames = list(video)\n                 fps_per_video.append(kwargs.get(\"video_fps\", 2.0))\n                 durations.append(len(frames) / kwargs.get(\"video_fps\", 2.0))\n                 frames_indices.append(list(range(len(frames))))",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/ff5f3d2f37fa67fcd6b3eb5fe6e92e387f584f15/src%2Fllamafactory%2Fdata%2Fmm_plugin.py",
