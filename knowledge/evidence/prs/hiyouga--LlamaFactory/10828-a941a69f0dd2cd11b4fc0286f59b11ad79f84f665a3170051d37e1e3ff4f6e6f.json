      "patch": "@@ -329,7 +329,7 @@ def _get_scores(\n         input_kwargs: Optional[dict[str, Any]] = {},\n     ) -> list[float]:\n         max_length: Optional[int] = input_kwargs.pop(\"max_length\", None)\n-        device = getattr(model.pretrained_model, \"device\", \"cuda\")\n+        device = getattr(model.pretrained_model, \"device\", torch.device(\"cpu\"))\n         inputs: dict[str, torch.Tensor] = tokenizer(\n             batch_input,\n             padding=True,",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/e197ef283373dda549e66cf0ef7423a548d746cc/src%2Fllamafactory%2Fchat%2Fhf_engine.py",
