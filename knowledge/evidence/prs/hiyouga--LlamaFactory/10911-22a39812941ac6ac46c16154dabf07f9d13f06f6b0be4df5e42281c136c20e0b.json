      "changes": 2,
      "contents_url": "https://api.github.com/repos/hiyouga/LlamaFactory/contents/src%2Fllamafactory%2Fdata%2Fdata_utils.py?ref=7a12ce0a3bbc01740b4f5cb8429d6ec7093664d1",
      "deletions": 1,
      "filename": "src/llamafactory/data/data_utils.py",
      "patch": "@@ -195,7 +195,7 @@ def read_cloud_json(cloud_path: str) -> list[Any]:\n         fs = setup_fs(cloud_path)  # try again with credentials\n \n     # filter out non-JSON files\n-    files = [x[\"Key\"] for x in fs.listdir(cloud_path)] if fs.isdir(cloud_path) else [cloud_path]\n+    files = fs.ls(cloud_path, detail=False) if fs.isdir(cloud_path) else [cloud_path]\n     files = list(filter(lambda file: file.endswith(\".json\") or file.endswith(\".jsonl\"), files))\n     if not files:\n         raise ValueError(f\"No JSON/JSONL files found in the specified path: {cloud_path}.\")",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/7a12ce0a3bbc01740b4f5cb8429d6ec7093664d1/src%2Fllamafactory%2Fdata%2Fdata_utils.py",
      "sha": "8730e81f19b5cf920cc169dbb8a287439cf199cf",
      "status": "modified"
    },
    {
      "additions": 65,
      "blob_url": "https://github.com/hiyouga/LlamaFactory/blob/7a12ce0a3bbc01740b4f5cb8429d6ec7093664d1/tests%2Fdata%2Ftest_cloud_json.py",
      "changes": 65,
      "contents_url": "https://api.github.com/repos/hiyouga/LlamaFactory/contents/tests%2Fdata%2Ftest_cloud_json.py?ref=7a12ce0a3bbc01740b4f5cb8429d6ec7093664d1",
      "deletions": 0,
      "filename": "tests/data/test_cloud_json.py",
      "patch": "@@ -0,0 +1,65 @@\n+# Copyright 2025 the LlamaFactory team.\n+#\n+# Licensed under the Apache License, Version 2.0 (the \"License\");\n+# you may not use this file except in compliance with the License.\n+# You may obtain a copy of the License at\n+#\n+#     http://www.apache.org/licenses/LICENSE-2.0\n+#\n+# Unless required by applicable law or agreed to in writing, software\n+# distributed under the License is distributed on an \"AS IS\" BASIS,\n+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n+# See the License for the specific language governing permissions and\n+# limitations under the License.\n+\n+import json\n+\n+import pytest\n+from fsspec.implementations.memory import MemoryFileSystem\n+\n+from llamafactory.data import data_utils\n+\n+\n+@pytest.fixture\n+def cloud_fs(monkeypatch, tmp_path):\n+    fs = MemoryFileSystem()\n+    root = f\"bucket/{tmp_path.name}\"\n+    monkeypatch.setattr(data_utils, \"setup_fs\", lambda _path, anon=False: fs)\n+    yield fs, root\n+    for protocol in (\"s3\", \"gs\", \"gcs\"):\n+        path = f\"{protocol}://{root}\"\n+        if fs.exists(path):\n+            fs.rm(path, recursive=True)\n+\n+\n+@pytest.mark.runs_on([\"cpu\", \"mps\", \"xpu\"])\n+@pytest.mark.parametrize(\"protocol\", [\"s3\", \"gs\", \"gcs\"])\n+def test_read_cloud_json_directory_uses_filesystem_listing_names(cloud_fs, protocol):\n+    fs, root = cloud_fs\n+    directory = f\"{protocol}://{root}\"\n+    fs.pipe(f\"{directory}/first.json\", json.dumps([{\"id\": 1}]).encode())\n+    fs.pipe(f\"{directory}/second.jsonl\", b'{\"id\": 2}\\n\\n{\"id\": 3}\\n')\n+    fs.pipe(f\"{directory}/ignored.txt\", b\"not json\")\n+\n+    assert all(\"name\" in entry and \"Key\" not in entry for entry in fs.ls(directory))\n+    result = data_utils.read_cloud_json(directory)\n+    assert sorted(row[\"id\"] for row in result) == [1, 2, 3]\n+\n+\n+@pytest.mark.runs_on([\"cpu\", \"mps\", \"xpu\"])\n+@pytest.mark.parametrize(\"protocol\", [\"s3\", \"gs\", \"gcs\"])\n+@pytest.mark.parametrize(\"extension,content\", [(\"json\", b'[{\"id\": 1}]'), (\"jsonl\", b'{\"id\": 1}\\n')])\n+def test_read_cloud_json_still_accepts_a_single_file(cloud_fs, protocol, extension, content):\n+    fs, root = cloud_fs\n+    path = f\"{protocol}://{root}/data.{extension}\"\n+    fs.pipe(path, content)\n+    assert data_utils.read_cloud_json(path) == [{\"id\": 1}]\n+\n+\n+@pytest.mark.runs_on([\"cpu\", \"mps\", \"xpu\"])\n+def test_read_cloud_json_reports_directory_without_json_files(cloud_fs):\n+    fs, root = cloud_fs\n+    directory = f\"gs://{root}\"\n+    fs.pipe(f\"{directory}/ignored.txt\", b\"not json\")\n+    with pytest.raises(ValueError, match=\"No JSON/JSONL files found\"):\n+        data_utils.read_cloud_json(directory)",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/7a12ce0a3bbc01740b4f5cb8429d6ec7093664d1/tests%2Fdata%2Ftest_cloud_json.py",
      "sha": "74d4d1fa7f11d59c12755a73c38f759cc0a7bb3d",
      "status": "added"
    }
