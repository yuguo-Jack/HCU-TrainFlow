      "filename": "src/llamafactory/data/processor/pretrain.py",
      "patch": "@@ -36,6 +36,7 @@ def preprocess_dataset(self, examples: dict[str, list[Any]]) -> dict[str, list[A\n             result = self.tokenizer(\n                 text_examples, add_special_tokens=False, truncation=True, max_length=self.data_args.cutoff_len\n             )\n+            result[\"length\"] = [len(input_ids) for input_ids in result[\"input_ids\"]]  # for `group_by_length`\n         else:\n             tokenized_examples = self.tokenizer(text_examples, add_special_tokens=False)\n             concatenated_examples = {k: list(chain(*tokenized_examples[k])) for k in tokenized_examples.keys()}",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/91ed6ad2c92fd80d5034a8575e4e2974c6c3983b/src%2Fllamafactory%2Fdata%2Fprocessor%2Fpretrain.py",
