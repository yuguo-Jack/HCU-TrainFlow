  "files": [
    {
      "additions": 9,
      "blob_url": "https://github.com/hiyouga/LlamaFactory/blob/decd6fe75319bc439c9d8ebc420ce71280fe7296/src%2Fllamafactory%2Fdata%2Fformatter.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/hiyouga/LlamaFactory/contents/src%2Fllamafactory%2Fdata%2Fformatter.py?ref=decd6fe75319bc439c9d8ebc420ce71280fe7296",
      "deletions": 1,
      "filename": "src/llamafactory/data/formatter.py",
      "patch": "@@ -73,11 +73,19 @@ def apply(self, **kwargs) -> SLOTS:\n         elements = []\n         for slot in self.slots:\n             if isinstance(slot, str):\n+                replacements = []\n                 for name, value in kwargs.items():\n                     if not isinstance(value, str):\n                         raise RuntimeError(f\"Expected a string, got {value}\")\n \n-                    slot = slot.replace(\"{{\" + name + \"}}\", value, 1)\n+                    placeholder = \"{{\" + name + \"}}\"\n+                    start = slot.find(placeholder)\n+                    if start != -1:\n+                        replacements.append((start, start + len(placeholder), value))\n+\n+                # Match the original slot so inserted content is never interpreted as a placeholder.\n+                for start, end, value in sorted(replacements, reverse=True):\n+                    slot = slot[:start] + value + slot[end:]\n                 elements.append(slot)\n             elif isinstance(slot, (dict, set)):\n                 elements.append(slot)",
      "raw_url": "https://github.com/hiyouga/LlamaFactory/raw/decd6fe75319bc439c9d8ebc420ce71280fe7296/src%2Fllamafactory%2Fdata%2Fformatter.py",
      "sha": "aa2e73ce7529e7ffa8897b06af205f221b4b3d03",
      "status": "modified"
    },
    {
      "additions": 27,
      "blob_url": "https://github.com/hiyouga/LlamaFactory/blob/decd6fe75319bc439c9d8ebc420ce71280fe7296/tests%2Fdata%2Ftest_formatter.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/hiyouga/LlamaFactory/contents/tests%2Fdata%2Ftest_formatter.py?ref=decd6fe75319bc439c9d8ebc420ce71280fe7296",
      "deletions": 0,
      "filename": "tests/data/test_formatter.py",
      "patch": "@@ -50,6 +50,33 @@ def test_string_formatter():\n     assert formatter.apply(content=\"Hi\") == [\"<s>\", \"Human: Hi\\nAssistant:\"]\n \n \n+@pytest.mark.runs_on([\"cpu\", \"mps\", \"xpu\"])\n+@pytest.mark.parametrize(\"content_first\", [True, False])\n+@pytest.mark.parametrize(\n+    (\"slot\", \"expected\"),\n+    [\n+        (\"{{content}}\", \"Use {{idx}} literally\"),\n+        (\"{{content}} / {{idx}}\", \"Use {{idx}} literally / 2\"),\n+        (\"{{idx}} / {{content}}\", \"2 / Use {{idx}} literally\"),\n+    ],\n+)\n+def test_string_formatter_preserves_literal_placeholders(slot, expected, content_first):\n+    formatter = StringFormatter(slots=[slot])\n+    values = {\"content\": \"Use {{idx}} literally\", \"idx\": \"2\"}\n+    if not content_first:\n+        values = dict(reversed(values.items()))\n+    assert formatter.apply(**values) == [expected]\n+\n+\n+@pytest.mark.runs_on([\"cpu\", \"mps\", \"xpu\"])\n+def test_string_formatter_preserves_existing_slot_behavior():\n+    formatter = StringFormatter(slots=[\"{{content}} {{content}}\", \"{{unknown}}\", {\"eos_token\"}])\n+    assert formatter.apply(content=\"Hi\") == [\"Hi {{content}}\", \"{{unknown}}\", {\"eos_token\"}]\n+    assert formatter.apply() == formatter.slots\n+    with pytest.raises(RuntimeError, match=\"Expected a string\"):\n+        formatter.apply(content=1)\n+\n+\n @pytest.mark.runs_on([\"cpu\", \"mps\", \"xpu\"])\n def test_function_formatter():\n     formatter = FunctionFormatter(slots=[\"{{content}}\", \"</s>\"], tool_format=\"default\")",
