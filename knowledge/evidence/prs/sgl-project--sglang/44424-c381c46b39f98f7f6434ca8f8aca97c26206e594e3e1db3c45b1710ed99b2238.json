      "patch": "@@ -638,7 +638,7 @@ async def process_mm_data_async(\n             hf_config=self.hf_config,\n             image_grid_thw=getattr(ret, \"image_grid_thw\", None),\n             video_grid_thw=getattr(ret, \"video_grid_thw\", None),\n-            attention_mask=getattr(ret, \"attention_mask\", None),\n+            attention_mask=None,\n         )\n         mrope_positions = mrope_positions.squeeze(1)\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8dffebb09c2878404dbe405ae3f90e453334b7a1/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fglm4v.py",
