    },
    {
      "additions": 43,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f79c00989a76c03285e7ca797b237e8df377dad9/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_inputs_merge_mrope_delta.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_inputs_merge_mrope_delta.py?ref=f79c00989a76c03285e7ca797b237e8df377dad9",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_mm_inputs_merge_mrope_delta.py",
      "patch": "@@ -0,0 +1,43 @@\n+import unittest\n+\n+import torch\n+\n+from sglang.srt.managers.schedule_batch import (\n+    Modality,\n+    MultimodalDataItem,\n+    MultimodalInputs,\n+)\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+IM_TOKEN_ID = 7\n+\n+\n+class TestMultimodalInputsMergeMropeDelta(CustomTestCase):\n+    def test_merge_invalidates_mrope_delta_cache(self):\n+        def _mm(delta):\n+            item = MultimodalDataItem(\n+                modality=Modality.IMAGE, hash=7, pad_value=7, offsets=[(0, 0)]\n+            )\n+            return MultimodalInputs(\n+                mm_items=[item],\n+                im_token_id=IM_TOKEN_ID,\n+                mrope_position_delta=torch.tensor([[delta]]),\n+            )\n+\n+        base = _mm(3)\n+        base.mrope_position_delta_repeated_cache = torch.zeros(3, 1, dtype=torch.long)\n+        base.merge(_mm(5))\n+        self.assertIsNone(base.mrope_position_delta_repeated_cache)\n+        self.assertEqual(base.mrope_position_delta.flatten().tolist(), [3, 5])\n+\n+        no_delta = _mm(1)\n+        no_delta.mrope_position_delta = None\n+        no_delta.merge(_mm(9))\n+        self.assertEqual(no_delta.mrope_position_delta.flatten().tolist(), [9])\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f79c00989a76c03285e7ca797b237e8df377dad9/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_inputs_merge_mrope_delta.py",
      "sha": "518147cc4a32d8c980dec383a5d135ba810e6c93",
      "status": "added"
    }
