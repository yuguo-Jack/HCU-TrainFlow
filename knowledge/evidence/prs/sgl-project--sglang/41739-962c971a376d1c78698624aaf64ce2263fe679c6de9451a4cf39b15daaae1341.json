      "changes": 3,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py?ref=f79c00989a76c03285e7ca797b237e8df377dad9",
      "deletions": 0,
      "filename": "python/sglang/srt/managers/schedule_batch.py",
      "patch": "@@ -888,6 +888,9 @@ def merge(self, other: MultimodalInputs):\n                 self.mrope_position_delta = torch.cat(\n                     [self.mrope_position_delta, other.mrope_position_delta], dim=0\n                 )\n+        elif other.mrope_position_delta is not None:\n+            self.mrope_position_delta = other.mrope_position_delta\n+        self.mrope_position_delta_repeated_cache = None\n \n         for key, val in other.__dict__.items():\n             if \"_id\" in key:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f79c00989a76c03285e7ca797b237e8df377dad9/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
