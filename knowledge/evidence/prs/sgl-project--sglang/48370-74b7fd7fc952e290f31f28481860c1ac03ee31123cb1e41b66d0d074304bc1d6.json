  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8a06ca5d67d08a62666a861179b62e6b660a65e7/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py?ref=8a06ca5d67d08a62666a861179b62e6b660a65e7",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/layernorm.py",
      "patch": "@@ -1439,7 +1439,12 @@ def forward_cuda(self, x, residual: Optional[torch.Tensor] = None):\n             return x, residual\n         if x.dim() == 2:\n             return gemma_rmsnorm(x, self.weight.data, self.eps)\n-        return self.forward_native(x)\n+        if x.numel() == 0:\n+            return x\n+        # q_norm and k_norm get [tokens, heads, head_dim]. The norm reduces over\n+        # the last dim only, so flatten the leading dims for the fused kernel.\n+        flat = x.contiguous().view(-1, x.shape[-1])\n+        return gemma_rmsnorm(flat, self.weight.data, self.eps).view(x.shape)\n \n     def forward_xpu(self, x, residual: Optional[torch.Tensor] = None):\n         if residual is not None and x.dim() == 2:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8a06ca5d67d08a62666a861179b62e6b660a65e7/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py",
      "sha": "98c1be4f4c572dec1812247e90ce164d2ec403da",
      "status": "modified"
    },
    {
      "additions": 39,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8a06ca5d67d08a62666a861179b62e6b660a65e7/test%2Fregistered%2Flayers%2Ftest_layernorm_fusion.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Flayers%2Ftest_layernorm_fusion.py?ref=8a06ca5d67d08a62666a861179b62e6b660a65e7",
      "deletions": 1,
      "filename": "test/registered/layers/test_layernorm_fusion.py",
      "patch": "@@ -1,9 +1,11 @@\n import itertools\n import unittest\n+from unittest import mock\n \n import torch\n \n-from sglang.srt.layers.layernorm import RMSNorm\n+from sglang.srt.layers import layernorm\n+from sglang.srt.layers.layernorm import Gemma3RMSNorm, RMSNorm\n from sglang.test.ci.ci_register import register_amd_ci, register_cuda_ci\n from sglang.test.test_utils import CustomTestCase\n \n@@ -43,6 +45,42 @@ def test_higher_rank_residual(self):\n                 torch.testing.assert_close(actual[1], expected[1], atol=1e-2, rtol=1e-2)\n \n \n+class TestGemma3RMSNormInputShape(CustomTestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        if not torch.cuda.is_available():\n+            raise unittest.SkipTest(\"CUDA is not available\")\n+\n+    def test_head_slice_uses_fused_kernel(self):\n+        torch.manual_seed(0)\n+        head_dim = 256\n+        for dtype, num_tokens, num_heads in itertools.product(\n+            (torch.bfloat16, torch.half), (1, 7, 83), (1, 8)\n+        ):\n+            with self.subTest(dtype=dtype, num_tokens=num_tokens, num_heads=num_heads):\n+                layer = Gemma3RMSNorm(head_dim).to(device=\"cuda\", dtype=dtype)\n+                layer.weight.data.normal_(mean=0.0, std=0.1)\n+                # q_norm and k_norm see a head slice of the fused qkv tensor.\n+                qkv = torch.randn(\n+                    num_tokens, (num_heads + 2) * head_dim, device=\"cuda\", dtype=dtype\n+                )\n+                x = qkv[:, : num_heads * head_dim].unflatten(-1, (num_heads, head_dim))\n+\n+                with torch.inference_mode():\n+                    expected = layer.forward_native(x)\n+                    if torch.version.hip is None:\n+                        with mock.patch.object(\n+                            layernorm, \"gemma_rmsnorm\", wraps=layernorm.gemma_rmsnorm\n+                        ) as fused:\n+                            actual = layer(x)\n+                        fused.assert_called_once()\n+                    else:\n+                        actual = layer(x)\n+\n+                self.assertEqual(actual.shape, x.shape)\n+                torch.testing.assert_close(actual, expected, atol=1e-2, rtol=1e-2)\n+\n+\n class TestRMSNormFp8QuantFusion(CustomTestCase):\n     DTYPES = [torch.bfloat16, torch.half]\n     NUM_TOKENS = [7, 83, 512]",
