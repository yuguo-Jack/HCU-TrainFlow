      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0cb72b106aa3692709c08badfb80145af6a11f60/python%2Fsglang%2Fkernels%2Fops%2Fmoe%2Fep_moe_kernels.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fmoe%2Fep_moe_kernels.py?ref=0cb72b106aa3692709c08badfb80145af6a11f60",
      "deletions": 4,
      "filename": "python/sglang/kernels/ops/moe/ep_moe_kernels.py",
      "patch": "@@ -990,10 +990,12 @@ def _fwd_kernel_ep_scatter_1(\n         mask=offset_cumsum < num_experts,\n         other=0,\n     )\n-    cumsum = tl.cumsum(tokens_per_expert) - tokens_per_expert\n-    tl.store(expert_start_loc + offset_cumsum, cumsum, mask=offset_cumsum < num_experts)\n-\n-    cur_expert_start = tl.load(expert_start_loc + cur_expert)\n+    # Compute the start locally: reading it back from the global table can race\n+    # with another warp's store. Each program publishes only its own entry.\n+    cur_expert_start = tl.sum(\n+        tl.where(offset_cumsum < cur_expert, tokens_per_expert, 0)\n+    )\n+    tl.store(expert_start_loc + cur_expert, cur_expert_start)\n     cur_expert_padded_token_num = tl.load(num_recv_tokens_per_expert + cur_expert)\n     cur_expert_valid_token_num = tl.load(num_valid_tokens_per_expert + cur_expert)\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0cb72b106aa3692709c08badfb80145af6a11f60/python%2Fsglang%2Fkernels%2Fops%2Fmoe%2Fep_moe_kernels.py",
      "sha": "9ea86c4c17ea4566cf64105caf0e724f7960cc66",
      "status": "modified"
    }
