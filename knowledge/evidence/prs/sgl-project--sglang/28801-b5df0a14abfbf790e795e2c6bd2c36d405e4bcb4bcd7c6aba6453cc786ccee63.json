      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_completions.py?ref=e7b6ff2457ea41aab17ad7fa6d8970917db38ce2",
      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/openai/serving_completions.py",
      "patch": "@@ -16,6 +16,7 @@\n     CompletionResponseStreamChoice,\n     CompletionStreamResponse,\n     ErrorResponse,\n+    PromptTokensDetails,\n     SglExt,\n )\n from sglang.srt.entrypoints.openai.serving_base import OpenAIServingBase\n@@ -396,6 +397,13 @@ async def _generate_completion_stream(\n                         prompt_tokens=prompt_tokens.get(index, 0),\n                         completion_tokens=completion_tokens.get(index, 0),\n                         reasoning_tokens=reasoning_tokens.get(index, 0),\n+                        cached_tokens=(\n+                            PromptTokensDetails(\n+                                cached_tokens=cached_tokens.get(index, 0)\n+                            )\n+                            if get_serving().enable_cache_report\n+                            else None\n+                        ),\n                     )\n \n                 yield f\"data: {chunk.model_dump_json()}\\n\\n\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e7b6ff2457ea41aab17ad7fa6d8970917db38ce2/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_completions.py",
