      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py?ref=c37a9da7ffc80233ee175cf0d2b7edc41ee79521",
      "deletions": 10,
      "filename": "python/sglang/srt/entrypoints/openai/serving_chat.py",
      "patch": "@@ -2444,15 +2444,14 @@ def _process_response_logprobs(self, ret_item: dict[str, Any]) -> ChoiceLogprobs\n         output_token_logprobs = ret_item[\"meta_info\"][\"output_token_logprobs\"]\n         output_top_logprobs = ret_item[\"meta_info\"].get(\"output_top_logprobs\", None)\n         token_logprobs = self._build_token_logprobs_from_raw(\n-            output_token_logprobs, output_top_logprobs, use_token_index=True\n+            output_token_logprobs, output_top_logprobs\n         )\n         return ChoiceLogprobs(content=token_logprobs)\n \n     def _build_token_logprobs_from_raw(\n         self,\n         output_token_logprobs: list[Any],\n         output_top_logprobs: list[Any] | None,\n-        use_token_index: bool = False,\n     ) -> list[ChatCompletionTokenLogprob]:\n         \"\"\"Build OpenAI ChatCompletionTokenLogprob from the engine's raw\n         ``(logprob, token_id, token_text)`` triples.\n@@ -2486,13 +2485,11 @@ def _build_token_logprobs_from_raw(\n \n             top_logprobs: list[TopLogprob] = []\n             if output_top_logprobs:\n-                # - Non-streaming (use_token_index=True): output_top_logprobs is\n-                #   the full per-position list; take the row for this token.\n-                # - Streaming (use_token_index=False): rows are pre-sliced so the\n-                #   current chunk holds exactly one row at index 0.\n-                top_row_idx = token_idx if use_token_index else 0\n-                if top_row_idx < len(output_top_logprobs):\n-                    top_row = output_top_logprobs[top_row_idx]\n+                # The caller passes token-aligned rows (the full sequence for\n+                # non-streaming, this chunk's segment for streaming), so take\n+                # the row for this token.\n+                if token_idx < len(output_top_logprobs):\n+                    top_row = output_top_logprobs[token_idx]\n                     if top_row is not None:\n                         for top_logprob, top_id, top_text in top_row:\n                             if is_byte_level:\n@@ -2685,7 +2682,7 @@ def _process_streaming_logprobs(\n                 n_prev_token:total_output_logprobs\n             ]\n         token_logprobs = self._build_token_logprobs_from_raw(\n-            output_token_logprobs, output_top_logprobs, use_token_index=False\n+            output_token_logprobs, output_top_logprobs\n         )\n         return ChoiceLogprobs(content=token_logprobs)\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c37a9da7ffc80233ee175cf0d2b7edc41ee79521/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py",
      "sha": "2a8df884b26dc6f9bd6e1ffb957adcda3e4aaa1d",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c37a9da7ffc80233ee175cf0d2b7edc41ee79521/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py?ref=c37a9da7ffc80233ee175cf0d2b7edc41ee79521",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/openai/test_serving_chat.py",
      "patch": "@@ -2954,6 +2954,30 @@ async def _collect_stream_content(self, content, choice_logprobs, req):\n             chunks.append(chunk)\n         return chunks\n \n+    def test_streaming_logprobs_use_per_token_top_logprobs(self):\n+        \"\"\"Each token in a multi-token streaming segment carries its own top_logprobs.\n+\n+        Streaming can commit more than one token per chunk (speculative decode,\n+        stream_interval, coalesced deltas). The segment is token-aligned, so the\n+        second token must not report the first token's alternatives.\n+        \"\"\"\n+        content = {\n+            \"meta_info\": {\n+                \"output_token_logprobs\": [(-0.1, 1, \"a\"), (-0.2, 2, \"b\")],\n+                \"output_top_logprobs\": [\n+                    [(-0.1, 1, \"a\"), (-1.1, 3, \"x\")],\n+                    [(-0.2, 2, \"b\"), (-2.2, 4, \"y\")],\n+                ],\n+            }\n+        }\n+        choice_logprobs = self.chat._process_streaming_logprobs(content, 0, 2)\n+\n+        self.assertEqual([t.token for t in choice_logprobs.content], [\"a\", \"b\"])\n+        first_top = {t.token for t in choice_logprobs.content[0].top_logprobs}\n+        second_top = {t.token for t in choice_logprobs.content[1].top_logprobs}\n+        self.assertEqual(first_top, {\"a\", \"x\"})\n+        self.assertEqual(second_top, {\"b\", \"y\"})\n+\n     def test_streaming_logprobs_attached_with_reasoning_parser(self):\n         \"\"\"Logprobs must ride on the reasoning chunk when a reasoning parser is active.\"\"\"\n         self.chat.reasoning_parser = \"qwen3\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c37a9da7ffc80233ee175cf0d2b7edc41ee79521/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py",
      "sha": "588ab02d87c7c3df088c394fd0999a670c117c16",
      "status": "modified"
    }
