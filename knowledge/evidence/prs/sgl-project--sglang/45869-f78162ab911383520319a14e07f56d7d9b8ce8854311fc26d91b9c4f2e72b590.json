  "files": [
    {
      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f0b9551b1fc27931676d973374bfcf33e38d2988/.github%2Fworkflows%2Fpr-test-amd.yml",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Fworkflows%2Fpr-test-amd.yml?ref=f0b9551b1fc27931676d973374bfcf33e38d2988",
      "deletions": 0,
      "filename": ".github/workflows/pr-test-amd.yml",
      "patch": "@@ -835,14 +835,24 @@ jobs:\n \n       - name: Run diffusion server tests (1-GPU)\n         timeout-minutes: 90\n+        env:\n+          # Keep equal to timeout-minutes above.\n+          STEP_TIMEOUT_MINUTES: 90\n         run: |\n           # AMD CI: All 1-GPU tests except FLUX.2 (FLUX.1 covers same code path)\n           # Tests: T2V, T2I, I2V, LoRA\n           #\n           # HF download env vars:\n           # - HF_HUB_ENABLE_HF_TRANSFER=1: Use faster hf_transfer for downloads (if available)\n           # - HF_HUB_DISABLE_SYMLINKS_WARNING=1: Suppress symlink warnings\n+          #\n+          # The runner retries failed cases only while another attempt still\n+          # fits before this deadline, so a case that fails every time ends\n+          # the step with its failure summary instead of a step timeout.\n+          # pr-test-multimodal-gen.yml sets the same variable.\n+          RETRY_DEADLINE=$(( $(date +%s) + (STEP_TIMEOUT_MINUTES - 5) * 60 ))\n           docker exec \\\n+            -e SGLANG_DIFFUSION_RETRY_DEADLINE=\"${RETRY_DEADLINE}\" \\\n             -e SGLANG_E2E_TOLERANCE=0.3 \\\n             -e SGLANG_STAGE_TIME_TOLERANCE=0.2 \\\n             -e SGLANG_NON_DENOISE_STAGE_TIME_TOLERANCE=0.6 \\\n@@ -993,6 +1003,8 @@ jobs:\n         env:\n           HF_TOKEN: ${{ secrets.SGLANG_DIFFUSION_CI_HF_TOKEN || secrets.HF_TOKEN }}\n           HUGGING_FACE_HUB_TOKEN: ${{ secrets.SGLANG_DIFFUSION_CI_HF_TOKEN || secrets.HF_TOKEN }}\n+          # Keep equal to timeout-minutes above.\n+          STEP_TIMEOUT_MINUTES: ${{ (inputs.runner_arch || 'mi300') == 'mi300' && 180 || 150 }}\n         run: |\n           # AMD CI: All 2-GPU tests including LoRA\n           # Tests: T2V, T2I, I2V, LoRA\n@@ -1005,7 +1017,11 @@ jobs:\n           # finished warmup inside the 1200s startup deadline, and the harness\n           # retries that TimeoutError six times, running the shard into the\n           # step timeout.\n+          #\n+          # Retry deadline: see the 1-GPU job.\n+          RETRY_DEADLINE=$(( $(date +%s) + (STEP_TIMEOUT_MINUTES - 5) * 60 ))\n           docker exec \\\n+            -e SGLANG_DIFFUSION_RETRY_DEADLINE=\"${RETRY_DEADLINE}\" \\\n             -e HF_TOKEN \\\n             -e HUGGING_FACE_HUB_TOKEN \\\n             -e SGLANG_E2E_TOLERANCE=0.3 \\",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f0b9551b1fc27931676d973374bfcf33e38d2988/.github%2Fworkflows%2Fpr-test-amd.yml",
      "sha": "27b3199150265e3cda9fe857732307b06cf19591",
      "status": "modified"
