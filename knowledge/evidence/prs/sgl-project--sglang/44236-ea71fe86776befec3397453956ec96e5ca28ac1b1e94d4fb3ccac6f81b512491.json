      "deletions": 0,
      "filename": "python/sglang/srt/disaggregation/decode.py",
      "patch": "@@ -1945,6 +1945,12 @@ def note_destinations_queued(self, count: int) -> None:\n             0, self._num_published_destinations - count\n         )\n \n+    @property\n+    def num_tokens_pending_prealloc(self):\n+        return sum(\n+            self._pre_alloc_fill_len(decode_req.req) for decode_req in self.queue\n+        ) + sum(self._pre_alloc_fill_len(req) for req in self.retracted_queue)\n+\n     @property\n     def num_tokens_pre_allocated(self):\n         return sum(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/61a887a6a8a838df82a3af30e58eeb713e0abcc0/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fdecode.py",
