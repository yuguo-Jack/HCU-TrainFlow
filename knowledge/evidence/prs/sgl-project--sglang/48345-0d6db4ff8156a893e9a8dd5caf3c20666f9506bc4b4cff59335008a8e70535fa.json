      "blob_url": "https://github.com/sgl-project/sglang/blob/f2d795b21bc656ae051ab24f471073d4850a997e/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fentrypoints%2Fopenai%2Frealtime%2Frealtime_video_api.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fentrypoints%2Fopenai%2Frealtime%2Frealtime_video_api.py?ref=f2d795b21bc656ae051ab24f471073d4850a997e",
      "deletions": 1,
      "filename": "python/sglang/multimodal_gen/runtime/entrypoints/openai/realtime/realtime_video_api.py",
      "patch": "@@ -139,6 +139,14 @@ async def _send_realtime_chunk_stats(\n     )\n \n \n+def _first_error_line(error: Exception) -> str:\n+    \"\"\"Return a one-line failure reason, including for exceptions with no message.\"\"\"\n+    for line in str(error).splitlines():\n+        if line.strip():\n+            return line\n+    return type(error).__name__\n+\n+\n async def _generate_loop(ws: WebSocket, session: GenerateSession):\n     adapter = session.adapter\n     if adapter is None:\n@@ -222,7 +230,7 @@ async def _generate_loop(ws: WebSocket, session: GenerateSession):\n             )\n             break\n         except Exception as e:\n-            err_msg = str(e).splitlines()[0]\n+            err_msg = _first_error_line(e)\n             logger.error(\"error during generate loop: %s\", err_msg)\n             try:\n                 # finish any frame header/payload pair before reporting a generation error",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f2d795b21bc656ae051ab24f471073d4850a997e/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fentrypoints%2Fopenai%2Frealtime%2Frealtime_video_api.py",
      "sha": "93c06c3a4eec8caaaa8615764d9736dfad412bef",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f2d795b21bc656ae051ab24f471073d4850a997e/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Frealtime%2Ftest_realtime_runtime.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Frealtime%2Ftest_realtime_runtime.py?ref=f2d795b21bc656ae051ab24f471073d4850a997e",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/realtime/test_realtime_runtime.py",
      "patch": "@@ -615,6 +615,38 @@ async def send_bytes(self, message):\n     assert sent_messages == []\n \n \n+@pytest.mark.parametrize(\n+    (\"error\", \"reason\"),\n+    [\n+        (NotImplementedError(), \"NotImplementedError\"),\n+        (RuntimeError(\"\\n\\nscheduler failed\\ndetails\"), \"scheduler failed\"),\n+    ],\n+)\n+def test_generate_loop_reports_errors_without_a_leading_message_line(error, reason):\n+    \"\"\"a failure with an empty or blank first line must still reach the client\"\"\"\n+    sent_messages = []\n+\n+    class _Adapter(realtime_adapter.BaseRealtimeModelAdapter):\n+        def create_state(self):\n+            return None\n+\n+        async def wait_for_next_chunk(self, session):\n+            raise error\n+\n+    class _Ws:\n+        async def send_bytes(self, message):\n+            sent_messages.append(msgspec.msgpack.decode(message))\n+\n+    session = GenerateSession()\n+    session.set_adapter(_Adapter())\n+\n+    asyncio.run(realtime_video_api._generate_loop(_Ws(), session))\n+\n+    assert sent_messages == [\n+        {\"type\": \"error\", \"content\": f\"error during generate loop: {reason}\"}\n+    ]\n+\n+\n def test_invalid_event_does_not_split_frame_header_and_payload():\n     \"\"\"an invalid event under send backpressure must not corrupt frame transport\"\"\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f2d795b21bc656ae051ab24f471073d4850a997e/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Frealtime%2Ftest_realtime_runtime.py",
