      "blob_url": "https://github.com/sgl-project/sglang/blob/065cf6df6a3cd9b0305382613f117035c3bc8339/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fpool_configurator.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fpool_configurator.py?ref=065cf6df6a3cd9b0305382613f117035c3bc8339",
      "deletions": 6,
      "filename": "python/sglang/srt/model_executor/pool_configurator.py",
      "patch": "@@ -102,6 +102,15 @@ def __post_init__(self):\n logger = logging.getLogger(__name__)\n \n \n+def _target_pays_for_draft_kv(kvc: KVCacheConfigurator) -> bool:\n+    spec = kvc.spec_algorithm\n+    if kvc.is_draft_worker or not (spec.is_eagle() or spec.is_standalone()):\n+        return False\n+    # A FROZEN_KV_MTP draft reads the target pool and owns no KV, except under\n+    # unified memory, where its worker builds a pool over the virtual id space.\n+    return not spec.is_frozen_kv_mtp() or get_memory().enable_unified_memory\n+\n+\n def _dflash_draft_cell_size(kvc: KVCacheConfigurator) -> int:\n     \"\"\"Bytes/token the DFLASH draft KV pool adds, 0 if none; replicated across DCP\n     ranks because the draft pool spans the widened virtual location space.\"\"\"\n@@ -252,9 +261,7 @@ def __init__(self, kvc: KVCacheConfigurator):\n \n         # EAGLE/STANDALONE: assumes the draft shares the target's per-layer KV size,\n         # which holds for EAGLE/MTP drafts that reuse the target's attention config.\n-        if (\n-            kvc.spec_algorithm.is_eagle() or kvc.spec_algorithm.is_standalone()\n-        ) and not kvc.is_draft_worker:\n+        if _target_pays_for_draft_kv(kvc):\n             eagle_draft_num_layers = kvc.spec_aux_config.eagle_draft_num_layers\n             fused_full_entry = kvc.fused_entry_bytes(\"full\")\n             if fused_full_entry is not None:\n@@ -699,9 +706,7 @@ def __init__(self, kvc: KVCacheConfigurator):\n         self._draft_full_layers_num = 0\n         self._draft_swa_layers_num = 0\n         self._draft_swa_full_layers_num = 0\n-        if (\n-            kvc.spec_algorithm.is_eagle() or kvc.spec_algorithm.is_standalone()\n-        ) and not kvc.is_draft_worker:\n+        if _target_pays_for_draft_kv(kvc):\n             draft_layers = kvc.spec_aux_config.eagle_draft_num_layers\n             if draft_layers is not None and int(draft_layers) > 0:\n                 draft_layers = int(draft_layers)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/065cf6df6a3cd9b0305382613f117035c3bc8339/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fpool_configurator.py",
      "sha": "40e5e4e1f9b869795f315f2cd44aa200957d4a92",
      "status": "modified"
    },
    {
      "additions": 72,
      "blob_url": "https://github.com/sgl-project/sglang/blob/065cf6df6a3cd9b0305382613f117035c3bc8339/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_pool_configurator.py",
      "changes": 72,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_pool_configurator.py?ref=065cf6df6a3cd9b0305382613f117035c3bc8339",
      "deletions": 0,
      "filename": "test/registered/unit/model_executor/test_pool_configurator.py",
      "patch": "@@ -162,6 +162,7 @@ def _make_model_runner(\n     spec = MagicMock()\n     spec.is_eagle.return_value = False\n     spec.is_standalone.return_value = False\n+    spec.is_frozen_kv_mtp.return_value = False\n     spec.is_dflash.return_value = False\n     spec.is_dflash_family.return_value = False\n     spec.is_none.return_value = True\n@@ -989,6 +990,77 @@ def test_hybrid_swa_draft_uses_swa_geometry_and_capacity(self):\n         self.assertGreater(used, available * 0.99)\n \n \n+class TestFrozenKvMtpDraftBudget(CustomTestCase):\n+    \"\"\"FROZEN_KV_MTP drafts read the target KV pool, so they own no pool to budget.\"\"\"\n+\n+    AVAILABLE = 10_000_000\n+    DRAFT_LAYERS = 4\n+\n+    def _tokens(self, *, algorithm, hybrid_swa, unified=False):\n+        if hybrid_swa:\n+            mr = _make_model_runner(\n+                self,\n+                num_layers=4,\n+                is_hybrid_swa=True,\n+                full_attention_layer_ids=[0, 1],\n+                swa_attention_layer_ids=[2, 3],\n+                swa_num_kv_heads=2,\n+                swa_full_tokens_ratio=0.25,\n+                enable_unified_memory=unified,\n+            )\n+        else:\n+            mr = _make_model_runner(self, num_layers=4, enable_unified_memory=unified)\n+        spec = mr.spec_algorithm\n+        spec.is_none.return_value = algorithm == \"NONE\"\n+        spec.is_eagle.return_value = algorithm in (\"EAGLE\", \"FROZEN_KV_MTP\")\n+        spec.is_frozen_kv_mtp.return_value = algorithm == \"FROZEN_KV_MTP\"\n+        if algorithm != \"NONE\":\n+            mr.spec_aux_config.eagle_draft_num_layers = self.DRAFT_LAYERS\n+\n+        with mock_cpu_env():\n+            from sglang.srt.model_executor.pool_configurator import (\n+                create_memory_pool_configurator,\n+            )\n+\n+            cfg = create_memory_pool_configurator(mr)\n+            config = cfg.calculate_pool_sizes(\n+                available_bytes=self.AVAILABLE, page_size=1\n+            )\n+        return config.max_total_num_tokens\n+\n+    def test_hybrid_swa_pool_is_sized_without_draft_layers(self):\n+        \"\"\"Gemma-4 shape: the draft term shrank the full pool for KV nobody allocates.\"\"\"\n+        self.assertEqual(\n+            self._tokens(algorithm=\"FROZEN_KV_MTP\", hybrid_swa=True),\n+            self._tokens(algorithm=\"NONE\", hybrid_swa=True),\n+        )\n+\n+    def test_default_pool_is_sized_without_draft_layers(self):\n+        \"\"\"Non-hybrid target: the same draft term shrank the pool.\"\"\"\n+        self.assertEqual(\n+            self._tokens(algorithm=\"FROZEN_KV_MTP\", hybrid_swa=False),\n+            self._tokens(algorithm=\"NONE\", hybrid_swa=False),\n+        )\n+\n+    def test_eagle_still_pays_for_draft_layers(self):\n+        \"\"\"The exemption is FROZEN_KV_MTP only; EAGLE drafts own a real KV pool.\"\"\"\n+        for hybrid_swa in (True, False):\n+            self.assertLess(\n+                self._tokens(algorithm=\"EAGLE\", hybrid_swa=hybrid_swa),\n+                self._tokens(algorithm=\"NONE\", hybrid_swa=hybrid_swa),\n+            )\n+\n+    def test_unified_memory_keeps_charging_draft_layers(self):\n+        \"\"\"Under unified memory the draft worker sizes its own virtual-space pool.\"\"\"\n+        for hybrid_swa in (True, False):\n+            self.assertEqual(\n+                self._tokens(\n+                    algorithm=\"FROZEN_KV_MTP\", hybrid_swa=hybrid_swa, unified=True\n+                ),\n+                self._tokens(algorithm=\"EAGLE\", hybrid_swa=hybrid_swa, unified=True),\n+            )\n+\n+\n class TestDSAIndexerAllocationPolicy(CustomTestCase):\n     @patch(\n         \"sglang.srt.mem_cache.kv_cache_configurator.calculate_mla_kv_cache_dim\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/065cf6df6a3cd9b0305382613f117035c3bc8339/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_pool_configurator.py",
