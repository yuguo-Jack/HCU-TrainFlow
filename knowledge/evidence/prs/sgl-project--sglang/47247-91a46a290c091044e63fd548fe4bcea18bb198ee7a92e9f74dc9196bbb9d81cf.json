      "blob_url": "https://github.com/sgl-project/sglang/blob/f065f3d1747afacdca9982208e3d2e952dd08f09/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_common%2Fmoe_transport.py",
      "changes": 28,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_common%2Fmoe_transport.py?ref=f065f3d1747afacdca9982208e3d2e952dd08f09",
      "deletions": 4,
      "filename": "python/sglang/srt/models/deepseek_common/moe_transport.py",
      "patch": "@@ -228,10 +228,30 @@ def return_output(self, hidden_states):\n         if _use_cp and get_moe_a2a_backend().is_none():\n             if self.cp_return_contiguous:\n                 parallel = get_parallel()\n-                hidden_states = parallel.tp_group.all_reduce(hidden_states)\n-                hidden_states = hidden_states.tensor_split(parallel.attn_cp_size)[\n-                    parallel.attn_cp_rank\n-                ].contiguous()\n+                cp_size = parallel.attn_cp_size\n+                rows = hidden_states.shape[0]\n+                if (\n+                    hidden_states.is_cuda\n+                    and not _is_hip\n+                    and parallel.tp_size == cp_size\n+                    and parallel.tp_group.world_size == cp_size\n+                    and rows > 0\n+                    and rows % cp_size == 0\n+                ):\n+                    # CP and TP rank order coincide when CP spans the whole TP\n+                    # group. Return only this rank's reduced contiguous rows.\n+                    local = hidden_states.new_empty(\n+                        (rows // cp_size, *hidden_states.shape[1:])\n+                    )\n+                    parallel.tp_group.reduce_scatter_tensor(\n+                        local, hidden_states.contiguous()\n+                    )\n+                    hidden_states = local\n+                else:\n+                    hidden_states = parallel.tp_group.all_reduce(hidden_states)\n+                    hidden_states = hidden_states.tensor_split(cp_size)[\n+                        parallel.attn_cp_rank\n+                    ].contiguous()\n             else:\n                 hidden_states = attn_cp_interleave_reduce_scatter(hidden_states)\n         elif _use_tp_moe_gather:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f065f3d1747afacdca9982208e3d2e952dd08f09/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_common%2Fmoe_transport.py",
