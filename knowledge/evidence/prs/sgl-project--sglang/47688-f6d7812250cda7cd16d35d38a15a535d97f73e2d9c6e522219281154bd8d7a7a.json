    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e44d3f5523a8a472275cccab5fd045a2205245b5/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Flocal_attention.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Flocal_attention.py?ref=e44d3f5523a8a472275cccab5fd045a2205245b5",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/attention/local_attention.py",
      "patch": "@@ -250,7 +250,10 @@ def make_local_attention_virtual_batches(\n         block_table_local: Block table for local attention\n     \"\"\"\n     if not preserve_attn_chunk_size:\n-        max_seq_len = seq_lens_np.max()\n+        # Round the longest sequence up to a whole page before clamping. Rounding\n+        # it down would put a chunk boundary inside a sequence that fits in one\n+        # model chunk, and its tail would stop attending to the keys before it.\n+        max_seq_len = cdiv(seq_lens_np.max(), page_size) * page_size\n         effective_chunk_size = min(attn_chunk_size, max_seq_len)\n         effective_chunk_size = (effective_chunk_size // page_size) * page_size\n         if effective_chunk_size < page_size:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e44d3f5523a8a472275cccab5fd045a2205245b5/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Flocal_attention.py",
      "sha": "4c74c87a15fab079a591a3396f17f10f1e4ace99",
      "status": "modified"
    },
    {
      "additions": 40,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e44d3f5523a8a472275cccab5fd045a2205245b5/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_local_attention.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_local_attention.py?ref=e44d3f5523a8a472275cccab5fd045a2205245b5",
      "deletions": 0,
      "filename": "test/registered/unit/layers/attention/test_local_attention.py",
      "patch": "@@ -70,6 +70,46 @@ def test_page_size_divides_the_block_table_width(self):\n         self.assertEqual(k_local.tolist(), [4, 2])\n         self.assertEqual(tuple(block_table_local.shape), (2, 2))  # chunk 4 / page 2\n \n+    def test_clamped_chunk_rounds_up_to_a_whole_page(self):\n+        \"\"\"A 1000-token sequence fits in one 8192-token chunk, so it must stay one block.\"\"\"\n+        q_start = np.array([0, 1000], dtype=np.int32)\n+        seq_lens = np.array([1000], dtype=np.int32)\n+        q_local, _, k_local, block_table_local = make_local_attention_virtual_batches(\n+            8192, q_start, seq_lens, _page_table(1, width=16), 128\n+        )\n+        self.assertEqual(q_local.tolist(), [1000])\n+        self.assertEqual(k_local.tolist(), [1000])\n+        self.assertEqual(tuple(block_table_local.shape), (1, 8))  # 1024 / page 128\n+\n+    def test_clamped_chunk_matches_the_model_chunk(self):\n+        \"\"\"Clamping only narrows the block table; the blocks match the model chunk.\"\"\"\n+        rng = np.random.default_rng(0)\n+        chunk = 512\n+        for page_size in (1, 16, 64, 128):\n+            for _ in range(50):\n+                bs = int(rng.integers(1, 5))\n+                seq_lens = rng.integers(1, 1500, size=bs).astype(np.int32)\n+                q_lens = np.array([rng.integers(1, s + 1) for s in seq_lens])\n+                q_start = np.pad(np.cumsum(q_lens), (1, 0)).astype(np.int32)\n+                width = int(seq_lens.max()) // page_size + 1\n+                page_table = _page_table(bs, width=width)\n+\n+                clamped = make_local_attention_virtual_batches(\n+                    chunk, q_start, seq_lens, page_table, page_size\n+                )\n+                model = make_local_attention_virtual_batches(\n+                    chunk,\n+                    q_start,\n+                    seq_lens,\n+                    page_table,\n+                    page_size,\n+                    preserve_attn_chunk_size=True,\n+                )\n+                for got, want in zip(clamped[:3], model[:3]):\n+                    np.testing.assert_array_equal(got, want)\n+                num_pages = clamped[3].shape[1]\n+                torch.testing.assert_close(clamped[3], model[3][:, :num_pages])\n+\n \n class TestLocalAttentionMetadataBuilder(CustomTestCase):\n     def _builder(self, swa_translate=None, max_context_len=16):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e44d3f5523a8a472275cccab5fd045a2205245b5/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_local_attention.py",
      "sha": "89a00ccc2d046d2a04cd10dfa04f68313b8c1193",
      "status": "modified"
    }
