    {
      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8908b13cb632f53a389597544427c8a6c79770ad/test%2Fregistered%2Funit%2Fsampling%2Ftest_sampling_params.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fsampling%2Ftest_sampling_params.py?ref=8908b13cb632f53a389597544427c8a6c79770ad",
      "deletions": 0,
      "filename": "test/registered/unit/sampling/test_sampling_params.py",
      "patch": "@@ -315,6 +315,24 @@ def test_logit_bias_valid_tokens(self):\n         sp = self._make(logit_bias={\"0\": 1.0, \"31999\": -0.5})\n         sp.verify(self.VOCAB_SIZE)\n \n+    # --- stop_token_ids ---\n+    def test_stop_token_ids_exceeds_vocab_raises(self):\n+        \"\"\"Test that stop_token_ids with token_id >= vocab_size are rejected.\"\"\"\n+        sp = self._make(stop_token_ids=[99999])\n+        with self.assertRaises(ValueError):\n+            sp.verify(self.VOCAB_SIZE)\n+\n+    def test_stop_token_ids_negative_raises(self):\n+        \"\"\"Test that stop_token_ids with negative token_id are rejected.\"\"\"\n+        sp = self._make(stop_token_ids=[-1])\n+        with self.assertRaises(ValueError):\n+            sp.verify(self.VOCAB_SIZE)\n+\n+    def test_stop_token_ids_valid_tokens(self):\n+        \"\"\"Test that stop_token_ids within [0, vocab_size) are accepted.\"\"\"\n+        sp = self._make(stop_token_ids=[0, 31999])\n+        sp.verify(self.VOCAB_SIZE)\n+\n     # --- sampling_seed ---\n     def test_sampling_seed_valid(self):\n         \"\"\"Test that None (the default) and the int64 min/max boundaries are accepted.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8908b13cb632f53a389597544427c8a6c79770ad/test%2Fregistered%2Funit%2Fsampling%2Ftest_sampling_params.py",
