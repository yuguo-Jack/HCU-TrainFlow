      "filename": "python/sglang/srt/sampling/sampling_params.py",
      "patch": "@@ -276,6 +276,14 @@ def verify(self, vocab_size):\n                         f\"logit_bias must has keys in [0, {vocab_size - 1}], got \"\n                         f\"{token_id}.\"\n                     )\n+        if self.stop_token_ids is not None:\n+            # check if each stop token id is within vocab size bounds\n+            for token_id in self.stop_token_ids:\n+                if not 0 <= token_id < vocab_size:\n+                    raise ValueError(\n+                        f\"stop_token_ids must be in [0, {vocab_size - 1}], got \"\n+                        f\"{token_id}.\"\n+                    )\n         if self.sampling_seed is not None:\n             if not isinstance(self.sampling_seed, int):\n                 raise ValueError(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8908b13cb632f53a389597544427c8a6c79770ad/python%2Fsglang%2Fsrt%2Fsampling%2Fsampling_params.py",
