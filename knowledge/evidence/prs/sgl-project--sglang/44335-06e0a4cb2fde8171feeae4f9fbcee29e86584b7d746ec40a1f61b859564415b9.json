      "deletions": 0,
      "filename": "python/sglang/srt/mem_cache/base_prefix_cache.py",
      "patch": "@@ -98,6 +98,11 @@ class InsertParams:\n     # The inserting request already inserted [0, here) (req.kv.cache_inserted_len);\n     # only the nodes past it count a hit, so a request counts each node once.\n     inserted_len: int = 0\n+    # When True, skip the inserted_len gate and bump hit counts on every node\n+    # the root walk passes — used at request finish to give a chunked prefill's\n+    # retained prefix its deferred hit-count bump (see unified_tree_core.py\n+    # _insert_walk_step / _should_backup_after_insert).\n+    force_bump_hit_count: bool = False\n     priority: int = 0\n     session_id: Optional[str] = None\n     track_adopted_ranges: bool = False",
      "raw_url": "https://github.com/sgl-project/sglang/raw/145381c9bdf690ced5d760ccc2f64c23c2d5e62a/python%2Fsglang%2Fsrt%2Fmem_cache%2Fbase_prefix_cache.py",
      "sha": "7bbc573e011295b589532da27c418d5b4f6b0d7f",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/145381c9bdf690ced5d760ccc2f64c23c2d5e62a/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_tree_core.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_tree_core.py?ref=145381c9bdf690ced5d760ccc2f64c23c2d5e62a",
      "deletions": 5,
      "filename": "python/sglang/srt/mem_cache/unified_cache/unified_tree_core.py",
      "patch": "@@ -1348,9 +1348,14 @@ def _insert_walk_step(self, state: _InsertWalkState) -> None:\n                 if swa_already_freed < dup.numel():\n                     step_actions.append(FreeDeviceKV([dup[swa_already_freed:]]))\n \n-        # Nodes this request already inserted were counted back then.\n+        # Nodes this request already inserted were counted back then — unless\n+        # the caller forces a replay (used at request finish to give a chunked\n+        # prefill's retained prefix its deferred hit-count bump).\n         node_end = state.total_prefix_length + prefix_len\n-        if node_end > state.params.inserted_len and self._inc_hit_count_and_check(node):\n+        if (\n+            state.params.force_bump_hit_count\n+            or node_end > state.params.inserted_len\n+        ) and self._inc_hit_count_and_check(node):\n             step_actions.append(self._build_backup_kv_action(node))\n         state.node = node\n         state.total_prefix_length += prefix_len\n@@ -1413,9 +1418,9 @@ def _should_backup_after_insert(self, state: _InsertWalkState) -> bool:\n         if state.is_new_leaf:\n             leaf_end = state.total_prefix_length + len(state.target_node.key)\n             return (\n-                leaf_end > state.params.inserted_len\n-                and self._inc_hit_count_and_check(state.target_node)\n-            )\n+                state.params.force_bump_hit_count\n+                or leaf_end > state.params.inserted_len\n+            ) and self._inc_hit_count_and_check(state.target_node)\n \n         node = state.target_node\n         return (",
      "raw_url": "https://github.com/sgl-project/sglang/raw/145381c9bdf690ced5d760ccc2f64c23c2d5e62a/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_tree_core.py",
      "sha": "a24591a2ed6b25f706d6939aa21d52db4b72807d",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/145381c9bdf690ced5d760ccc2f64c23c2d5e62a/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py?ref=145381c9bdf690ced5d760ccc2f64c23c2d5e62a",
      "deletions": 0,
      "filename": "python/sglang/srt/mem_cache/unified_radix_cache.py",
      "patch": "@@ -1096,9 +1096,16 @@ def checkpoint_into_tree(self, req: Req, *, up_to: int, **kwargs) -> None:\n         ]\n \n         # components prepare insert data + return effective cache_len\n+        #\n+        # If this is the final insert for a request that already went through\n+        # intermediate checkpoints (chunked prefill), replay hit-count bumps\n+        # on every node the root walk passes so HiCache write-through can fire\n+        # on the retained prefix. See issue #33714.\n+        force_bump_hit_count = is_finished and req.kv.cache_inserted_len > 0\n         insert_params = InsertParams(\n             prev_prefix_len=req.kv.cache_protected_len,\n             inserted_len=req.kv.cache_inserted_len,\n+            force_bump_hit_count=force_bump_hit_count,\n             priority=req.priority or 0,\n             session_id=req.session_id,\n             rotation_base=req.kv_rotation_base,\n@@ -1191,6 +1198,7 @@ def checkpoint_into_tree(self, req: Req, *, up_to: int, **kwargs) -> None:\n                     value=values[: len(prompt_key)],\n                     prev_prefix_len=len(prompt_key),\n                     inserted_len=len(prompt_key),\n+                    force_bump_hit_count=False,\n                     priority=min(\n                         insert_params.priority + 1, torch.iinfo(torch.int64).max\n                     ),",
      "raw_url": "https://github.com/sgl-project/sglang/raw/145381c9bdf690ced5d760ccc2f64c23c2d5e62a/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py",
      "sha": "a2b832540eeeb181129d13d1a29b71f77f342071",
      "status": "modified"
    }
