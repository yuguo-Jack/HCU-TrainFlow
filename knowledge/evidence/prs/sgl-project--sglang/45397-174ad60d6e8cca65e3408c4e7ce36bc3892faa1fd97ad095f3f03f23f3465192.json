  "files": [
    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/70b35c7e1aa7eddb417282b8e69af62340939ee2/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=70b35c7e1aa7eddb417282b8e69af62340939ee2",
      "deletions": 2,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -6027,8 +6027,13 @@ def close_session(self, recv_req: CloseSessionReqInput):\n             self.session_controller.close(recv_req)\n \n     def maybe_sleep_on_idle(self):\n-        if self.idle_sleeper is not None:\n-            self.idle_sleeper.maybe_sleep()\n+        if self.idle_sleeper is None:\n+            return\n+        # EPD embeddings arrive on per-request sockets the idle sleeper does not\n+        # poll; sleeping here would delay every image request by its timeout.\n+        if self.mm_receiver is not None and self.mm_receiver.waiting_list:\n+            return\n+        self.idle_sleeper.maybe_sleep()\n \n     def handle_freeze_gc(self, recv_req: FreezeGCReq):\n         \"\"\"Handle freeze_gc request: freeze scheduler's GC and forward to detokenizer.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/70b35c7e1aa7eddb417282b8e69af62340939ee2/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "b35546ec959ee2f78a64c00b57f0eba957e16777",
      "status": "modified"
    },
    {
      "additions": 43,
      "blob_url": "https://github.com/sgl-project/sglang/blob/70b35c7e1aa7eddb417282b8e69af62340939ee2/test%2Fregistered%2Funit%2Fmanagers%2Ftest_idle_sleep_epd_wait.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_idle_sleep_epd_wait.py?ref=70b35c7e1aa7eddb417282b8e69af62340939ee2",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_idle_sleep_epd_wait.py",
      "patch": "@@ -0,0 +1,43 @@\n+\"\"\"The idle sleeper must not hold back a request waiting for EPD embeddings.\"\"\"\n+\n+import unittest\n+from types import SimpleNamespace\n+from unittest.mock import Mock\n+\n+from parameterized import parameterized\n+\n+from sglang.srt.managers.scheduler import Scheduler\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=1, suite=\"base-a-test-cpu\")\n+\n+\n+class TestIdleSleepEpdWait(CustomTestCase):\n+    def test_no_sleep_while_embedding_pending(self):\n+        \"\"\"With --sleep-on-idle and --language-only, the encoder's embeddings arrive\n+        on a socket the idle sleeper does not poll, so sleeping delayed every image\n+        request by the full poll timeout (1 s).\"\"\"\n+        sleeper = Mock()\n+        scheduler = SimpleNamespace(\n+            idle_sleeper=sleeper,\n+            mm_receiver=SimpleNamespace(waiting_list=[object()]),\n+        )\n+        Scheduler.maybe_sleep_on_idle(scheduler)\n+        sleeper.maybe_sleep.assert_not_called()\n+\n+    @parameterized.expand(\n+        [\n+            (\"no_epd\", None),\n+            (\"epd_nothing_pending\", SimpleNamespace(waiting_list=[])),\n+        ]\n+    )\n+    def test_sleeps_when_idle(self, _name, mm_receiver):\n+        sleeper = Mock()\n+        scheduler = SimpleNamespace(idle_sleeper=sleeper, mm_receiver=mm_receiver)\n+        Scheduler.maybe_sleep_on_idle(scheduler)\n+        sleeper.maybe_sleep.assert_called_once_with()\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/70b35c7e1aa7eddb417282b8e69af62340939ee2/test%2Fregistered%2Funit%2Fmanagers%2Ftest_idle_sleep_epd_wait.py",
      "sha": "9b4d96dda707c2619e5a3ffcb48a779ab999808c",
      "status": "added"
    }
