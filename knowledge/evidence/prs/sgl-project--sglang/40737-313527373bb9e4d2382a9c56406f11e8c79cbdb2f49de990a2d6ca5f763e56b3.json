      "changes": 21,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_session_token_share_unit.py?ref=460d555645d33ce3fb31a608a31e4ea9e9c62f24",
      "deletions": 2,
      "filename": "test/registered/unit/mem_cache/test_session_token_share_unit.py",
      "patch": "@@ -23,10 +23,11 @@\n VOCAB = 1 << 20\n \n \n-def _recv(rid, input_ids, max_new_tokens=8):\n+def _recv(rid, input_ids, max_new_tokens=8, input_embeds=None):\n     return SimpleNamespace(\n         rid=rid,\n-        input_ids=array(\"q\", input_ids),\n+        input_ids=None if input_ids is None else array(\"q\", input_ids),\n+        input_embeds=input_embeds,\n         mm_inputs=None,\n         session_params=SimpleNamespace(\n             id=\"s\", rid=None, offset=None, replace=False, drop_previous_output=False\n@@ -142,6 +143,22 @@ def test_first_turn_abort(self):\n         r3 = self._create(\"r3\", [6])\n         self.assertEqual(list(r3.origin_input_ids), [4, 5, 9, 6])\n \n+    def test_first_turn_input_embeds(self):\n+        input_embeds = [[0.1, 0.2], [0.3, 0.4]]\n+        for streaming in (False, True):\n+            with self.subTest(streaming=streaming):\n+                session = Session(\n+                    capacity_of_str_len=0, session_id=\"s\", streaming=streaming\n+                )\n+                req = session.create_req(\n+                    _recv(\"r1\", None, input_embeds=input_embeds),\n+                    tokenizer=None,\n+                    vocab_size=VOCAB,\n+                )\n+\n+                self.assertEqual(list(req.origin_input_ids), [1, 1])\n+                self.assertIs(req.input_embeds, input_embeds)\n+\n     def test_max_new_tokens_overshoot_falls_back(self):\n         in1 = list(range(300, 310))\n         r1 = self._create(\"r1\", in1, max_new_tokens=4)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/460d555645d33ce3fb31a608a31e4ea9e9c62f24/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_session_token_share_unit.py",
