      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/65ef331d8653f6e78a50fe995e092c99fe368d1e/python%2Fsglang%2Fsrt%2Fserver_args.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fserver_args.py?ref=65ef331d8653f6e78a50fe995e092c99fe368d1e",
      "deletions": 1,
      "filename": "python/sglang/srt/server_args.py",
      "patch": "@@ -2899,7 +2899,7 @@ class ServerArgs:\n     ] = None\n     disaggregation_decode_enable_radix_cache: A[\n         bool,\n-        \"Enable radix cache on decode server (PD mode). Caches KV prefixes to avoid redundant transfers. Incompatible with --enable-hisparse, speculative decoding, and --disaggregation-transfer-backend fake.\",\n+        \"Enable radix cache on decode server (PD mode). Caches KV prefixes to avoid redundant transfers. Incompatible with --enable-hisparse and --disaggregation-transfer-backend fake. Combining with speculative decoding is experimental.\",\n         NS(\"disagg\"),\n     ] = False\n     disaggregation_decode_enable_offload_kvcache: A[",
      "raw_url": "https://github.com/sgl-project/sglang/raw/65ef331d8653f6e78a50fe995e092c99fe368d1e/python%2Fsglang%2Fsrt%2Fserver_args.py",
