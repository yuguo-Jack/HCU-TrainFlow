    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/01f777bb19c6fe1adba6053c07235ba0eb5d46f4/python%2Fsglang%2Fkernels%2Fkda_kernels%2Fresidual_gate_add_jit.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fkda_kernels%2Fresidual_gate_add_jit.py?ref=01f777bb19c6fe1adba6053c07235ba0eb5d46f4",
      "deletions": 1,
      "filename": "python/sglang/kernels/kda_kernels/residual_gate_add_jit.py",
      "patch": "@@ -8,6 +8,7 @@\n \n from sglang.kernels.jit.utils import cache_once, load_jit, make_cpp_args\n from sglang.kernels.kda_kernels import _cuda_source\n+from sglang.kernels.ops.diffusion.common.platform import is_hip\n from sglang.srt.utils.custom_op import register_custom_op\n \n if TYPE_CHECKING:\n@@ -230,8 +231,12 @@ def _is_transposed_dense_residual(\n def can_use_residual_gate_add_cuda(\n     residual: torch.Tensor, update: torch.Tensor, gate: torch.Tensor\n ) -> bool:\n+    # The Triton fast path emits CUDA PTX cvt.rn.*.f32 with constraint \"=h\".\n+    # On ROCm that constraint is a fatal LLVM register-allocation error, so\n+    # the caller never reaches its eager fallback. tensor.is_cuda is true on\n+    # HIP; the platform predicate is what rejects this path.\n     return (\n-        torch.version.hip is None\n+        not is_hip()\n         and residual.dtype in _SUPPORTED_DTYPES\n         and residual.dtype == update.dtype\n         and residual.dtype == gate.dtype",
      "raw_url": "https://github.com/sgl-project/sglang/raw/01f777bb19c6fe1adba6053c07235ba0eb5d46f4/python%2Fsglang%2Fkernels%2Fkda_kernels%2Fresidual_gate_add_jit.py",
      "sha": "8ac0995125206666bfe630015436c8c931dc223d",
      "status": "modified"
    },
    {
      "additions": 39,
      "blob_url": "https://github.com/sgl-project/sglang/blob/01f777bb19c6fe1adba6053c07235ba0eb5d46f4/test%2Fregistered%2Funit%2Fkernels%2Ftest_residual_gate_add_hip.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fkernels%2Ftest_residual_gate_add_hip.py?ref=01f777bb19c6fe1adba6053c07235ba0eb5d46f4",
      "deletions": 0,
      "filename": "test/registered/unit/kernels/test_residual_gate_add_hip.py",
      "patch": "@@ -0,0 +1,39 @@\n+# SPDX-License-Identifier: Apache-2.0\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n+\n+import unittest\n+from unittest.mock import patch\n+\n+import torch\n+\n+from sglang.kernels.kda_kernels.residual_gate_add_jit import (\n+    can_use_residual_gate_add_cuda,\n+    residual_gate_add,\n+)\n+\n+\n+class TestResidualGateAddHip(unittest.TestCase):\n+    def test_hip_skips_cuda_ptx_fast_path(self):\n+        with patch(\n+            \"sglang.kernels.kda_kernels.residual_gate_add_jit.is_hip\",\n+            return_value=True,\n+        ):\n+            self.assertFalse(can_use_residual_gate_add_cuda(None, None, None))\n+\n+    def test_hip_residual_gate_add_matches_eager(self):\n+        residual = torch.randn(2, 8, dtype=torch.float16)\n+        update = torch.randn(2, 8, dtype=torch.float16)\n+        gate = torch.randn(1, 8, dtype=torch.float16)\n+        with patch(\n+            \"sglang.kernels.kda_kernels.residual_gate_add_jit.is_hip\",\n+            return_value=True,\n+        ):\n+            out = residual_gate_add(residual, update, gate)\n+        torch.testing.assert_close(out, residual + update * gate)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/01f777bb19c6fe1adba6053c07235ba0eb5d46f4/test%2Fregistered%2Funit%2Fkernels%2Ftest_residual_gate_add_hip.py",
      "sha": "41b41660bae81bfc62b45fdf8643c46c8b6b89c0",
      "status": "added"
    }
