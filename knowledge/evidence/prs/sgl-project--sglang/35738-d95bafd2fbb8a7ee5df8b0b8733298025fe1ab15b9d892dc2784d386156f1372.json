      "deletions": 1,
      "filename": "python/sglang/srt/entrypoints/openai/serving_chat.py",
      "patch": "@@ -1288,7 +1288,10 @@ def _apply_jinja_template(\n             if messages[0][\"role\"] != \"system\":\n                 # insert an empty system prompt to help render tool system prompt\n                 messages.insert(0, {\"role\": \"system\", \"content\": \"\"})\n-            if request.tools:\n+            if request.tool_choice == \"none\":\n+                for message in messages:\n+                    message.pop(\"tools\", None)\n+            elif request.tools:\n                 messages[0][\"tools\"] = [tool.model_dump() for tool in request.tools]\n \n             # Default encoding (dsv4/dsv32)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fe24e8af4fcfc8ef43d126307cc4beaceaf3cf2f/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py",
