      "patch": "@@ -7,6 +7,7 @@\n import triton\n import triton.language as tl\n \n+import sglang.kernels.ops.attention.triton_block_ptr_compat  # noqa: F401\n from sglang.kernels.jit.utils import is_arch_support_pdl\n from sglang.srt.utils import (\n     cdiv,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/df49d3118d060e3ebf61c219e95a91357161eb5d/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Ffused_norm_gate.py",
