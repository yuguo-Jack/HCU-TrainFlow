      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e276872719258ea0086426abc523700a7d2ddd0c/python%2Fsglang%2Fsrt%2Fmodels%2Fspark2_5.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fspark2_5.py?ref=e276872719258ea0086426abc523700a7d2ddd0c",
      "deletions": 1,
      "filename": "python/sglang/srt/models/spark2_5.py",
      "patch": "@@ -2,6 +2,7 @@\n from typing import Iterable, Optional, Tuple, Union\n \n import torch\n+import torch.nn.functional as F\n from torch import nn\n \n from sglang.srt.distributed import get_pp_group\n@@ -42,6 +43,15 @@ def _get_attention_sliding_window_size(config):\n     return config.sliding_window - 1\n \n \n+def _apply_gate_activation(gate: torch.Tensor, mode: str) -> torch.Tensor:\n+    gate = gate.float()\n+    if mode == \"sigmoid\":\n+        return torch.sigmoid(gate)\n+    if mode == \"silu\":\n+        return F.silu(gate)\n+    raise ValueError(f\"Unsupported gate_attn_act_mode: {mode}\")\n+\n+\n class Spark2_5MLP(nn.Module):\n     def __init__(\n         self,\n@@ -96,6 +106,7 @@ def __init__(\n         layer_type: str = \"sliding_attention\",\n         headwise_attn_output_gate: bool = True,\n         prefix: str = \"\",\n+        gate_attn_act_mode: str = \"sigmoid\",\n     ) -> None:\n         super().__init__()\n         self.hidden_size = hidden_size\n@@ -126,6 +137,9 @@ def __init__(\n         self.max_position_embeddings = max_position_embeddings\n         self.partial_rotary_factor = partial_rotary_factor\n         self.headwise_attn_output_gate = headwise_attn_output_gate\n+        if gate_attn_act_mode not in (\"sigmoid\", \"silu\"):\n+            raise ValueError(f\"Unsupported gate_attn_act_mode: {gate_attn_act_mode}\")\n+        self.gate_attn_act_mode = gate_attn_act_mode\n \n         self.q_k_v_proj = QKVParallelLinear(\n             hidden_size,\n@@ -197,7 +211,7 @@ def forward(\n \n         if self.headwise_attn_output_gate:\n             g, _ = self.g_proj(hidden_states)\n-            g = torch.sigmoid(g.float()).to(attn_output.dtype)\n+            g = _apply_gate_activation(g, self.gate_attn_act_mode).to(attn_output.dtype)\n             gate_output = attn_output.view(\n                 attn_output.shape[0],\n                 self.num_heads,\n@@ -249,6 +263,7 @@ def __init__(\n             headwise_attn_output_gate=getattr(\n                 config, \"headwise_attn_output_gate\", True\n             ),\n+            gate_attn_act_mode=getattr(config, \"gate_attn_act_mode\", \"sigmoid\"),\n             prefix=add_prefix(\"self_attn\", prefix),\n         )\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e276872719258ea0086426abc523700a7d2ddd0c/python%2Fsglang%2Fsrt%2Fmodels%2Fspark2_5.py",
      "sha": "ab7ff8e223ee864a018d7ddca6be0a148ae972c2",
