      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/87ace6382203bf07438ddd3b12aac8990dc09203/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_mla.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_mla.py?ref=87ace6382203bf07438ddd3b12aac8990dc09203",
      "deletions": 3,
      "filename": "python/sglang/kernels/ops/attention/verify_mla.py",
      "patch": "@@ -64,7 +64,7 @@ def _verify_mla_prefix_stage1(\n     qo_indptr,\n     kv_indptr,\n     kv_indices,\n-    Att_Out,  # [BS, H_Q, MAX_N_SPLITS, L_EXT, Dv] bf16\n+    Att_Out,  # [BS, H_Q, MAX_N_SPLITS, L_EXT, Dv] fp32\n     Att_Lse,  # [BS, H_Q, MAX_N_SPLITS, L_EXT]     fp32\n     num_splits,  # launched split count\n     stride_qbs,\n@@ -415,10 +415,10 @@ def __init__(\n \n     def _alloc(self, max_bs):\n         self.max_bs = max_bs\n-        # bf16 partials (halves scratch traffic vs fp32); lse stays fp32.\n+        # Preserve cancellation residuals until the final prefix/draft merge.\n         self.att_out = torch.empty(\n             (max_bs, self.h_q, MAX_N_SPLITS, self.l_pad, self.v_head_dim),\n-            dtype=torch.bfloat16,\n+            dtype=torch.float32,\n             device=self.device,\n         )\n         self.att_lse = torch.empty(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/87ace6382203bf07438ddd3b12aac8990dc09203/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_mla.py",
      "sha": "6da493ef9f91debb0b25a3ee5879694684a6bc30",
      "status": "modified"
    },
    {
      "additions": 43,
      "blob_url": "https://github.com/sgl-project/sglang/blob/87ace6382203bf07438ddd3b12aac8990dc09203/test%2Fregistered%2Fattention%2Ftest_verify_shared_kv.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fattention%2Ftest_verify_shared_kv.py?ref=87ace6382203bf07438ddd3b12aac8990dc09203",
      "deletions": 0,
      "filename": "test/registered/attention/test_verify_shared_kv.py",
      "patch": "@@ -59,6 +59,49 @@ def randn(*shape):\n \n @unittest.skipIf(not torch.cuda.is_available(), \"GPU required\")\n class TestVerifySharedKV(CustomTestCase):\n+    def test_split_partials_preserve_cancellation_residual(self):\n+        from sglang.kernels.ops.attention.verify_mla import VerifyMLA, block_config\n+\n+        for dim in (64, 256):\n+            with self.subTest(head_dim=dim):\n+                block_h, block_n, num_warps = block_config(dim)\n+                prefix = 2 * block_n\n+                q = torch.zeros(3, 16, dim, device=\"cuda\", dtype=torch.bfloat16)\n+                k = torch.zeros(3, 1, dim, device=\"cuda\", dtype=q.dtype)\n+                v = torch.zeros_like(k)\n+                kb = torch.zeros(prefix, 1, dim, device=\"cuda\", dtype=q.dtype)\n+                vb = torch.full_like(kb, -32)\n+                vb[:block_n] = 32\n+                vb[:7] = 32.25\n+                qo = torch.tensor([0, 3], device=\"cuda\", dtype=torch.int32)\n+                kp = torch.tensor([0, prefix], device=\"cuda\", dtype=torch.int32)\n+                ids = torch.arange(prefix, device=\"cuda\", dtype=torch.int64)\n+                kernel = VerifyMLA(\n+                    1,\n+                    16,\n+                    dim,\n+                    dim,\n+                    3,\n+                    block_h=block_h,\n+                    block_n=block_n,\n+                    num_warps=num_warps,\n+                )\n+                # Uniform attention: opposite V blocks leave a total of 1.75.\n+                ref = 1.75 / (\n+                    prefix + torch.arange(1, 4, device=\"cuda\", dtype=torch.float64)\n+                )\n+                ref = ref[:, None, None].expand_as(q)\n+                out = kernel(q, k, v, kb, vb, qo, kp, ids, dim**-0.5)\n+                torch.testing.assert_close(out.double(), ref, atol=5e-5, rtol=0)\n+                # Growing cached scratch must retain the same precision policy.\n+                kernel.grow_buffers(2)\n+                self.assertEqual(kernel.att_out.dtype, torch.float32)\n+                graph = torch.cuda.CUDAGraph()\n+                with torch.cuda.graph(graph):\n+                    out = kernel(q, k, v, kb, vb, qo, kp, ids, dim**-0.5)\n+                graph.replay()\n+                torch.testing.assert_close(out.double(), ref, atol=5e-5, rtol=0)\n+\n     def _run_parity(\n         self,\n         head_dim,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/87ace6382203bf07438ddd3b12aac8990dc09203/test%2Fregistered%2Fattention%2Ftest_verify_shared_kv.py",
      "sha": "f382df3606909637416a8fab87c38f1e47f205c8",
      "status": "modified"
    }
