    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/d0f10e4ab300fea3eab881a6a39f95b2d7198e5e/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsa%2Ftransform_index.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsa%2Ftransform_index.py?ref=d0f10e4ab300fea3eab881a6a39f95b2d7198e5e",
      "deletions": 2,
      "filename": "python/sglang/kernels/ops/attention/dsa/transform_index.py",
      "patch": "@@ -157,12 +157,12 @@ def transform_index_page_table_decode_kernel(\n     tl.store(result_ptr + offset, -1, mask=~mask)\n \n \n-@triton.jit\n+@triton.jit(do_not_specialize=[\"page_table_row_stride\"])\n def transform_index_page_table_decode_tiled_kernel(\n     page_table_ptr: torch.Tensor,\n     topk_indices_ptr: torch.Tensor,\n     result_ptr: torch.Tensor,\n-    page_table_row_stride: tl.constexpr,\n+    page_table_row_stride,\n     topk_indices_stride_0: tl.constexpr,\n     topk_indices_stride_1: tl.constexpr,\n     result_stride_0: tl.constexpr,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d0f10e4ab300fea3eab881a6a39f95b2d7198e5e/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsa%2Ftransform_index.py",
      "sha": "6b4f18835f4eaebb0bedba34f1b48e7fe5f483eb",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/d0f10e4ab300fea3eab881a6a39f95b2d7198e5e/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_dsa_transform_index.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_dsa_transform_index.py?ref=d0f10e4ab300fea3eab881a6a39f95b2d7198e5e",
      "deletions": 0,
      "filename": "test/registered/kernels/ops/attention/test_dsa_transform_index.py",
      "patch": "@@ -308,6 +308,28 @@ def test_large_context_lengths(self):\n                     page_table_is_expanded=page_table_is_expanded,\n                 )\n \n+    def test_decode_tiled_page_table_row_stride_is_not_specialized(self):\n+        kernel = transform_index_module.transform_index_page_table_decode_tiled_kernel\n+        stride_param = next(\n+            param for param in kernel.params if param.name == \"page_table_row_stride\"\n+        )\n+\n+        self.assertFalse(stride_param.is_constexpr)\n+        self.assertTrue(stride_param.do_not_specialize)\n+\n+    def test_decode_tiled_dynamic_page_table_row_strides(self):\n+        context_lengths = (4096, 4160, 4224, 4100, 4101)\n+        kernel = transform_index_module.transform_index_page_table_decode_tiled_kernel\n+\n+        self._check_decode_case(17, context_lengths[0], topk_width=KPOOL_TOPK)\n+        kernel_cache = kernel.device_caches[torch.cuda.current_device()][0]\n+        specialization_count = len(kernel_cache)\n+\n+        for context_length in context_lengths[1:]:\n+            with self.subTest(context_length=context_length):\n+                self._check_decode_case(17, context_length, topk_width=KPOOL_TOPK)\n+                self.assertEqual(len(kernel_cache), specialization_count)\n+\n     def test_decode_fast_correctness_and_strides(self):\n         self._check_decode_case(17, 8192, provide_result=True)\n         self._check_decode_case(17, 8192, zero_row_stride=True)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d0f10e4ab300fea3eab881a6a39f95b2d7198e5e/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_dsa_transform_index.py",
      "sha": "c5b063d6b4eab05b3a50d72eba1159df3ff054a3",
      "status": "modified"
    }
