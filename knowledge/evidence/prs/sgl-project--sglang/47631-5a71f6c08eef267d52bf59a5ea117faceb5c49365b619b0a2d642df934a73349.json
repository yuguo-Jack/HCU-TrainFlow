      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fprofiler_manager.py?ref=af9a8ce1cf4eb9707215131f2afff3acb3c601e6",
