    {
      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/af9a8ce1cf4eb9707215131f2afff3acb3c601e6/python%2Fsglang%2Fsrt%2Futils%2Fprofile_utils.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fprofile_utils.py?ref=af9a8ce1cf4eb9707215131f2afff3acb3c601e6",
      "deletions": 0,
      "filename": "python/sglang/srt/utils/profile_utils.py",
      "patch": "@@ -40,6 +40,22 @@\n GRAPH_CAPTURE_PROFILE_DIRNAME = \"graph_capture_profile\"\n \n \n+def sanitize_profile_filename_component(value: Optional[str]) -> Optional[str]:\n+    \"\"\"Make a caller-supplied profile_id or profile_prefix safe to use in a filename.\n+\n+    These values are joined into trace file names under the profiler output\n+    directory, so path separators (and NUL) are replaced to keep the trace\n+    from landing outside that directory.\n+    \"\"\"\n+    if value is None:\n+        return None\n+    value = str(value)\n+    for sep in {\"/\", \"\\\\\", os.sep, os.altsep, \"\\0\"}:\n+        if sep:\n+            value = value.replace(sep, \"_\")\n+    return value\n+\n+\n def graph_capture_profile_dir() -> str:\n     \"\"\"``<SGLANG_TORCH_PROFILER_DIR>/graph_capture_profile`` — the one directory\n     both capture-trace modes write to. Change the location here only.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/af9a8ce1cf4eb9707215131f2afff3acb3c601e6/python%2Fsglang%2Fsrt%2Futils%2Fprofile_utils.py",
      "sha": "437a69968a681859ee0aeecd30f9ad37b34c0489",
      "status": "modified"
    },
    {
      "additions": 51,
      "blob_url": "https://github.com/sgl-project/sglang/blob/af9a8ce1cf4eb9707215131f2afff3acb3c601e6/test%2Fregistered%2Funit%2Fmanagers%2Ftest_profile_filename_sanitize.py",
      "changes": 51,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_profile_filename_sanitize.py?ref=af9a8ce1cf4eb9707215131f2afff3acb3c601e6",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_profile_filename_sanitize.py",
      "patch": "@@ -0,0 +1,51 @@\n+\"\"\"Unit tests for sanitizing caller-supplied profiler filename components (#44189).\"\"\"\n+\n+import os\n+import unittest\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase, maybe_stub_sgl_kernel\n+\n+maybe_stub_sgl_kernel()\n+\n+from sglang.srt.utils.profile_utils import sanitize_profile_filename_component\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestSanitizeProfileFilenameComponent(CustomTestCase):\n+    def _assert_stays_in(self, prefix, profile_id):\n+        out_dir = os.path.realpath(\"/tmp/sglang-profile-root/expected\")\n+        filename = (\n+            sanitize_profile_filename_component(prefix)\n+            + \"-\"\n+            + sanitize_profile_filename_component(profile_id)\n+            + \"-TP-0.trace.json.gz\"\n+        )\n+        path = os.path.realpath(os.path.join(out_dir, filename))\n+        self.assertEqual(os.path.dirname(path), out_dir)\n+\n+    def test_relative_prefix_cannot_escape(self):\n+        self._assert_stays_in(\"../escaped\", \"123\")\n+        self._assert_stays_in(\"..\\\\escaped\", \"123\")\n+\n+    def test_absolute_prefix_cannot_replace_output_dir(self):\n+        self._assert_stays_in(\"/tmp/elsewhere/x\", \"123\")\n+\n+    def test_profile_id_cannot_escape(self):\n+        self._assert_stays_in(\"p\", \"../../../tmp/x\")\n+\n+    def test_plain_values_unchanged(self):\n+        self.assertEqual(sanitize_profile_filename_component(\"run-1.a_b\"), \"run-1.a_b\")\n+        self.assertEqual(\n+            sanitize_profile_filename_component(\"1730361600.5\"), \"1730361600.5\"\n+        )\n+        self.assertIsNone(sanitize_profile_filename_component(None))\n+        self.assertEqual(sanitize_profile_filename_component(\"\"), \"\")\n+\n+    def test_separators_replaced(self):\n+        self.assertEqual(sanitize_profile_filename_component(\"a/b\\\\c\\0d\"), \"a_b_c_d\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/af9a8ce1cf4eb9707215131f2afff3acb3c601e6/test%2Fregistered%2Funit%2Fmanagers%2Ftest_profile_filename_sanitize.py",
      "sha": "a9a6d546c01ac40e61df87ef7f07847d12b2b629",
      "status": "added"
    }
