      "deletions": 1,
      "filename": ".github/workflows/pr-test-musa.yml",
      "patch": "@@ -26,8 +26,10 @@ on:\n         default: false\n \n concurrency:\n+  # Only PR runs are superseded. Push/schedule runs on main queue instead, so a newer merge\n+  # never kills an in-flight post-merge run (GitHub still collapses multiple pending runs).\n   group: pr-test-musa-${{ inputs.ref || github.ref }}\n-  cancel-in-progress: ${{ github.event_name != 'workflow_call' }}\n+  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n \n jobs:\n   # ==================== Check Changes ==================== #",
