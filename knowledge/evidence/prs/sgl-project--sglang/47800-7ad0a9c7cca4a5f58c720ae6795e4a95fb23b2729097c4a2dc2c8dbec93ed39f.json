  "files": [
    {
      "additions": 14,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad6a401974a028fd4afedc7cc4194fa62168540c/python%2Fsglang%2Fsrt%2Fbatch_invariant_ops%2Fbatch_invariant_ops.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fbatch_invariant_ops%2Fbatch_invariant_ops.py?ref=ad6a401974a028fd4afedc7cc4194fa62168540c",
      "deletions": 2,
      "filename": "python/sglang/srt/batch_invariant_ops/batch_invariant_ops.py",
      "patch": "@@ -67,6 +67,14 @@ def _matmul_launch_metadata(\n     return ret\n \n \n+def _dot_precision(dtype: torch.dtype) -> Optional[str]:\n+    # tl.dot runs fp32 operands in TF32 by default; like aten::mm, use TF32 only\n+    # when torch allows it (e.g. --enable-tf32-matmul).\n+    if dtype == torch.float32 and torch.backends.cuda.matmul.fp32_precision != \"tf32\":\n+        return \"ieee\"\n+    return None\n+\n+\n @triton.jit\n def _compute_pid(tile_id, num_pid_in_group, num_pid_m, GROUP_SIZE_M, NUM_SMS):\n     group_id = tile_id // num_pid_in_group\n@@ -101,6 +109,7 @@ def matmul_kernel_persistent(\n     B_LARGE: tl.constexpr,\n     C_LARGE: tl.constexpr,\n     HAS_BIAS: tl.constexpr,\n+    DOT_PRECISION: tl.constexpr,\n ):\n     start_pid = tl.program_id(axis=0)\n     num_pid_m = tl.cdiv(M, BLOCK_SIZE_M)\n@@ -147,7 +156,7 @@ def matmul_kernel_persistent(\n             b = tl.load(\n                 b_ptrs, mask=offs_k_for_mask[:, None] < K - ki * BLOCK_SIZE_K, other=0.0\n             )\n-            accumulator = tl.dot(a, b, accumulator)\n+            accumulator = tl.dot(a, b, accumulator, input_precision=DOT_PRECISION)\n \n         offs_cm = pid_m * BLOCK_SIZE_M + tl.arange(0, BLOCK_SIZE_M)\n         offs_cn = pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)\n@@ -263,6 +272,7 @@ def grid(META):\n         B_LARGE=b.numel() > 2**31,\n         C_LARGE=c.numel() > 2**31,\n         HAS_BIAS=bias is not None,\n+        DOT_PRECISION=_dot_precision(a.dtype),\n         **configs[a.dtype],\n     )\n     return c\n@@ -678,6 +688,7 @@ def bmm_kernel_persistent(\n     A_LARGE: tl.constexpr,\n     B_LARGE: tl.constexpr,\n     C_LARGE: tl.constexpr,\n+    DOT_PRECISION: tl.constexpr,\n ):\n     \"\"\"\n     Batched matrix multiplication kernel that processes batches in parallel.\n@@ -745,7 +756,7 @@ def bmm_kernel_persistent(\n             b = tl.load(\n                 b_ptrs, mask=offs_k_for_mask[:, None] < K - ki * BLOCK_SIZE_K, other=0.0\n             )\n-            accumulator = tl.dot(a, b, accumulator)\n+            accumulator = tl.dot(a, b, accumulator, input_precision=DOT_PRECISION)\n \n         offs_cm = pid_m * BLOCK_SIZE_M + tl.arange(0, BLOCK_SIZE_M)\n         offs_cn = pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)\n@@ -857,6 +868,7 @@ def bmm_batch_invariant(a, b, *, out=None):\n             A_LARGE=a.numel() > 2**31,\n             B_LARGE=b.numel() > 2**31,\n             C_LARGE=c.numel() > 2**31,\n+            DOT_PRECISION=_dot_precision(dtype),\n             **config,\n         )\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad6a401974a028fd4afedc7cc4194fa62168540c/python%2Fsglang%2Fsrt%2Fbatch_invariant_ops%2Fbatch_invariant_ops.py",
      "sha": "e84d609b6d3880fd1c6b3eff2923ca08b0c6e228",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad6a401974a028fd4afedc7cc4194fa62168540c/test%2Fregistered%2Funit%2Fbatch_invariant_ops%2Ftest_batch_invariant_ops.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fbatch_invariant_ops%2Ftest_batch_invariant_ops.py?ref=ad6a401974a028fd4afedc7cc4194fa62168540c",
      "deletions": 0,
      "filename": "test/registered/unit/batch_invariant_ops/test_batch_invariant_ops.py",
      "patch": "@@ -274,6 +274,30 @@ def test_bmm_large_matrices(self):\n                             )\n                             self._assert_batch_invariant_results(difflist, dtype, name)\n \n+    def test_fp32_matches_fp64_reference(self):\n+        \"\"\"fp32 mm and bmm must keep fp32 precision, not round operands to TF32.\"\"\"\n+        torch.manual_seed(0)\n+        a = torch.randn(4, 96, 1536, dtype=torch.float32)\n+        b = torch.randn(4, 1536, 160, dtype=torch.float32)\n+        ref = (a.double() @ b.double()).float()\n+        with set_batch_invariant_mode(True):\n+            mm = torch.mm(a[0], b[0])\n+            bmm = torch.bmm(a, b)\n+        torch.testing.assert_close(mm, ref[0], rtol=0, atol=1e-2)\n+        torch.testing.assert_close(bmm, ref, rtol=0, atol=1e-2)\n+\n+    def test_fp32_rope_angles_are_exact(self):\n+        \"\"\"Gemma 3 computes RoPE angles as inv_freq @ positions in fp32;\n+        positions past 2048 must not be rounded to 11 significant bits.\"\"\"\n+        inv_freq = 1.0 / (10000 ** (torch.arange(0, 256, 2).float() / 256))\n+        positions = torch.arange(8192).float()\n+        expected = (inv_freq.double()[:, None] * positions.double()).float()\n+        with set_batch_invariant_mode(True):\n+            bmm = inv_freq[None, :, None] @ positions[None, None, :]\n+            mm = inv_freq[:, None] @ positions[None, :]\n+        torch.testing.assert_close(bmm[0], expected, rtol=0, atol=0)\n+        torch.testing.assert_close(mm, expected, rtol=0, atol=0)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad6a401974a028fd4afedc7cc4194fa62168540c/test%2Fregistered%2Funit%2Fbatch_invariant_ops%2Ftest_batch_invariant_ops.py",
      "sha": "76a33db1dc078e0c8f9fbda37cfb77f1b9ef914e",
      "status": "modified"
    }
