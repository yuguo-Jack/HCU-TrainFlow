      "changes": 13,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Fmamba_checkpoint_pool.py?ref=255a9d04b4c972e5d27877c93a26fd2808ba0828",
      "deletions": 2,
      "filename": "python/sglang/srt/mem_cache/mamba_checkpoint_pool.py",
      "patch": "@@ -249,15 +249,24 @@ def store_from_active(self, active_mamba_pool, active_slots, ckpt_slots) -> None\n         cache = active_mamba_pool.mamba_cache\n         self.temporal.store_from_pool(cache.temporal, active_slots, ckpt_slots)\n         for i, c in enumerate(self.conv):\n-            c[:, ckpt_slots] = cache.conv[i][:, active_slots]\n+            src = cache.conv[i][:, active_slots]\n+            # The active pool may store conv windows transposed (e.g. NPU\n+            # backend allocates (k, d) while cache_params.shape.conv is (d, k)).\n+            if src.shape[-2:] != c.shape[-2:]:\n+                src = src.transpose(-1, -2)\n+            c[:, ckpt_slots] = src\n \n     def load_to_active(self, active_mamba_pool, ckpt_slots, active_slots) -> None:\n         \"\"\"Dequantize temporal + copy conv from checkpoint slots into the active pool\n         (the cache-hit copy-on-write).\"\"\"\n         cache = active_mamba_pool.mamba_cache\n         self.temporal.copy_to_pool(cache.temporal, ckpt_slots, active_slots)\n         for i, c in enumerate(self.conv):\n-            cache.conv[i][:, active_slots] = c[:, ckpt_slots].to(cache.conv[i].dtype)\n+            dst = cache.conv[i][:, active_slots]\n+            val = c[:, ckpt_slots].to(dst.dtype)\n+            if dst.shape[-2:] != val.shape[-2:]:\n+                val = val.transpose(-1, -2)\n+            dst[:] = val\n \n     @staticmethod\n     def estimate_mem_usage_bytes(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/255a9d04b4c972e5d27877c93a26fd2808ba0828/python%2Fsglang%2Fsrt%2Fmem_cache%2Fmamba_checkpoint_pool.py",
