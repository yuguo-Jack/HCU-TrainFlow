  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/71f719eb71bba19cee69e771cd0379ff8ad85b3f/python%2Fsglang%2Fsrt%2Ffunction_call%2Fglm47_moe_detector.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fglm47_moe_detector.py?ref=71f719eb71bba19cee69e771cd0379ff8ad85b3f",
      "deletions": 1,
      "filename": "python/sglang/srt/function_call/glm47_moe_detector.py",
      "patch": "@@ -286,7 +286,12 @@ def parse_arguments(\n     # Strategy 3: ast.literal_eval\n     try:\n         parsed_value = safe_literal_eval(json_value)\n-        return parsed_value, True\n+        # A bare comma makes literal_eval build a tuple (\"1,000\" -> (1, 0));\n+        # only an array-typed argument may take it, as a list.\n+        if not isinstance(parsed_value, tuple):\n+            return parsed_value, True\n+        if arg_type == \"array\":\n+            return list(parsed_value), True\n     except (ValueError, SyntaxError):\n         pass\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/71f719eb71bba19cee69e771cd0379ff8ad85b3f/python%2Fsglang%2Fsrt%2Ffunction_call%2Fglm47_moe_detector.py",
      "sha": "f9e94315d46eebea709afe64500547a1f54bcf49",
      "status": "modified"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/71f719eb71bba19cee69e771cd0379ff8ad85b3f/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_glm47_schema_types.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_glm47_schema_types.py?ref=71f719eb71bba19cee69e771cd0379ff8ad85b3f",
      "deletions": 1,
      "filename": "test/registered/unit/function_call/test_glm47_schema_types.py",
      "patch": "@@ -2,7 +2,10 @@\n import unittest\n \n from sglang.srt.entrypoints.openai.protocol import Function, Tool\n-from sglang.srt.function_call.glm47_moe_detector import Glm47MoeDetector\n+from sglang.srt.function_call.glm47_moe_detector import (\n+    Glm47MoeDetector,\n+    parse_arguments,\n+)\n from sglang.test.ci.ci_register import register_cpu_ci\n \n register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n@@ -357,6 +360,20 @@ def test_completed_arguments_reset_between_tool_calls(self):\n             {\"value\": \"hello\"},\n         )\n \n+    def test_bare_comma_value_is_not_split_into_an_array(self):\n+        \"\"\"#43147: \"1,000\" for a number arg reached the tool as [1, 0].\"\"\"\n+        self.check_arguments(\n+            {\"type\": \"object\", \"properties\": {\"n\": {\"type\": \"number\"}}},\n+            {\"n\": \"1,000\"},\n+        )\n+\n+    def test_parse_arguments_bare_comma(self):\n+        \"\"\"#43147: literal_eval turns a bare comma into a tuple. Non-array args\n+        keep the raw string; array args keep the list they got before.\"\"\"\n+        self.assertEqual(parse_arguments(\"1,000\", \"number\"), (\"1,000\", True))\n+        self.assertEqual(parse_arguments('\"a\",\"b\"', \"object\"), ('\"a\",\"b\"', True))\n+        self.assertEqual(parse_arguments(\"1, 2\", \"array\"), ([1, 2], True))\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/71f719eb71bba19cee69e771cd0379ff8ad85b3f/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_glm47_schema_types.py",
      "sha": "51905c7c9856299b8f7c98f6c474d39f326d12ac",
      "status": "modified"
    }
  ],
