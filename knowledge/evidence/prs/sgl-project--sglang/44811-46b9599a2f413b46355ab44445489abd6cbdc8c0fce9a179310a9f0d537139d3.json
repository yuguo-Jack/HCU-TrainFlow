      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/71ffb900c889476c0cf9471f01be985d0a72c892/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx?ref=71ffb900c889476c0cf9471f01be985d0a72c892",
      "deletions": 0,
      "filename": "docs/docs/references/environment_variables.mdx",
      "patch": "@@ -1336,6 +1336,11 @@ SGLang supports various environment variables that can be used to configure its\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Interval (seconds) between scheduler-status log lines.</td>\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>60.0</code></td>\n     </tr>\n+    <tr>\n+      <td style={{padding: \"9px 12px\", fontWeight: 500, backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>SGLANG_REDACT_REQUEST_DATA</code></td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Print only the request id and the input and output lengths when a request is formatted into a log line or error message, such as the scheduler watchdog dump. Token ids, sampling params and grammar are left out. The server refuses to start with <code>--log-requests</code>, <code>--crash-dump-folder</code> or <code>--log-level debug</code>.</td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>false</code></td>\n+    </tr>\n   </tbody>\n </table>\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/71ffb900c889476c0cf9471f01be985d0a72c892/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx",
      "sha": "93c9d4f2501bcccc90bd4c8e7cd75edf1c27c7cb",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/71ffb900c889476c0cf9471f01be985d0a72c892/python%2Fsglang%2Fsrt%2Farg_groups%2Fvalidation_hook.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Fvalidation_hook.py?ref=71ffb900c889476c0cf9471f01be985d0a72c892",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/validation_hook.py",
      "patch": "@@ -326,6 +326,8 @@ def check_server_args(server_args: Any):\n             f\"got {cfg.device!r}.\"\n         )\n \n+    check_request_data_redaction(cfg)\n+\n     # Check metrics labels\n     if (\n         not cfg.tokenizer_metrics_custom_labels_header\n@@ -380,6 +382,26 @@ def check_server_args(server_args: Any):\n     check_load_publish_args(server_args)\n \n \n+def check_request_data_redaction(cfg: Any):\n+    \"\"\"Raise ValueError when SGLANG_REDACT_REQUEST_DATA is set together with an\n+    option that logs or dumps request data. Debug logging includes model output\n+    (serving_chat.py), so --log-level debug is refused too.\"\"\"\n+    if not envs.SGLANG_REDACT_REQUEST_DATA.get():\n+        return\n+    conflicts = []\n+    if cfg.log_requests:\n+        conflicts.append(\"--log-requests\")\n+    if cfg.crash_dump_folder:\n+        conflicts.append(\"--crash-dump-folder\")\n+    if cfg.log_level.lower() == \"debug\":\n+        conflicts.append(\"--log-level debug\")\n+    if conflicts:\n+        raise ValueError(\n+            f\"SGLANG_REDACT_REQUEST_DATA is set, so {', '.join(conflicts)} \"\n+            \"cannot be used.\"\n+        )\n+\n+\n def validate_buckets_rule(arg_name: str, buckets_rule: List[str]):\n     if not buckets_rule:\n         return",
      "raw_url": "https://github.com/sgl-project/sglang/raw/71ffb900c889476c0cf9471f01be985d0a72c892/python%2Fsglang%2Fsrt%2Farg_groups%2Fvalidation_hook.py",
      "sha": "07c137cdcb2265a2218a4388deff0ba8f7edb6eb",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/71ffb900c889476c0cf9471f01be985d0a72c892/python%2Fsglang%2Fsrt%2Fenviron.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fenviron.py?ref=71ffb900c889476c0cf9471f01be985d0a72c892",
      "deletions": 0,
      "filename": "python/sglang/srt/environ.py",
      "patch": "@@ -356,6 +356,10 @@ class Envs:\n     SGLANG_LOG_REQUEST_HEADERS = EnvTuple(tuple())\n     SGLANG_LOG_SCHEDULER_STATUS_TARGET = EnvStr(\"\")\n     SGLANG_LOG_SCHEDULER_STATUS_INTERVAL = EnvFloat(60.0)\n+    # Leave prompt and output token ids, sampling params and grammar out of\n+    # Req.__repr__, so a logged or raised Req carries no request data, and\n+    # refuse to start with options that log or dump request data.\n+    SGLANG_REDACT_REQUEST_DATA = EnvBool(False)\n     # Read by JIT kernel headers (sgl_kernel/logging.h): DEBUG | INFO | WARNING | ERROR.\n     SGLANG_JIT_LOG_LEVEL = EnvStr(\"WARNING\")\n     SGLANG_ENABLE_RANK_CONSENSUS_CHECKER = EnvBool(False)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/71ffb900c889476c0cf9471f01be985d0a72c892/python%2Fsglang%2Fsrt%2Fenviron.py",
      "sha": "8d25c93fa4d9f09290470da1d5d2c325c8e564d0",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/71ffb900c889476c0cf9471f01be985d0a72c892/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py?ref=71ffb900c889476c0cf9471f01be985d0a72c892",
      "deletions": 0,
      "filename": "python/sglang/srt/managers/schedule_batch.py",
      "patch": "@@ -2199,6 +2199,11 @@ def update_reasoning_tokens(self, token_id, think_end_ids):\n         self.reasoning_tokens += len(token_id)\n \n     def __repr__(self):\n+        if envs.SGLANG_REDACT_REQUEST_DATA.get():\n+            return (\n+                f\"Req(rid={self.rid}, input_len={len(self.origin_input_ids)}, \"\n+                f\"output_len={len(self.output_ids)})\"\n+            )\n         return (\n             f\"Req(rid={self.rid}, \"\n             f\"input_ids={self.origin_input_ids}, output_ids={self.output_ids}, \"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/71ffb900c889476c0cf9471f01be985d0a72c892/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "sha": "51414cdc82f1e194a4598aa3341e3860227f0b83",
      "status": "modified"
    },
    {
      "additions": 80,
      "blob_url": "https://github.com/sgl-project/sglang/blob/71ffb900c889476c0cf9471f01be985d0a72c892/test%2Fregistered%2Funit%2Fmanagers%2Ftest_req_repr_redaction.py",
      "changes": 80,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_req_repr_redaction.py?ref=71ffb900c889476c0cf9471f01be985d0a72c892",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_req_repr_redaction.py",
      "patch": "@@ -0,0 +1,80 @@\n+\"\"\"SGLANG_REDACT_REQUEST_DATA keeps request data out of Req.__repr__, which\n+the scheduler watchdog and assertion messages format into logs, and refuses\n+startup options that log or dump request data. Pure CPU.\"\"\"\n+\n+import unittest\n+from array import array\n+from types import SimpleNamespace\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase, maybe_stub_sgl_kernel\n+\n+maybe_stub_sgl_kernel()\n+\n+from sglang.srt.arg_groups.validation_hook import check_request_data_redaction\n+from sglang.srt.environ import envs\n+from sglang.srt.managers.schedule_batch import Req\n+from sglang.srt.sampling.sampling_params import SamplingParams\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+def _make_req():\n+    req = Req(\n+        rid=\"rid-abc\",\n+        origin_input_text=\"\",\n+        origin_input_ids=array(\"q\", [90001, 90002, 90003]),\n+        sampling_params=SamplingParams(max_new_tokens=8, stop=\"secret-stop\"),\n+        vocab_size=100_000,\n+    )\n+    req.output_ids = array(\"q\", [90004])\n+    return req\n+\n+\n+class TestReqReprRedaction(CustomTestCase):\n+    def test_redacted_repr_has_rid_and_lengths_only(self):\n+        with envs.SGLANG_REDACT_REQUEST_DATA.override(True):\n+            text = repr(_make_req())\n+        self.assertEqual(text, \"Req(rid=rid-abc, input_len=3, output_len=1)\")\n+\n+    def test_redacted_repr_covers_lists_of_reqs(self):\n+        # The watchdog formats the batch's request list with an f-string `=`.\n+        reqs = [_make_req()]\n+        with envs.SGLANG_REDACT_REQUEST_DATA.override(True):\n+            text = f\"{reqs=}\"\n+        for secret in (\"90001\", \"90004\", \"secret-stop\"):\n+            self.assertNotIn(secret, text)\n+\n+    def test_default_repr_is_unchanged(self):\n+        text = repr(_make_req())\n+        self.assertIn(\"90001\", text)\n+        self.assertIn(\"secret-stop\", text)\n+\n+\n+def _server_args(**overrides):\n+    args = dict(log_requests=False, crash_dump_folder=None, log_level=\"info\")\n+    args.update(overrides)\n+    return SimpleNamespace(**args)\n+\n+\n+class TestRedactionStartupCheck(CustomTestCase):\n+    def test_request_data_options_are_refused(self):\n+        args = _server_args(\n+            log_requests=True, crash_dump_folder=\"/tmp/dump\", log_level=\"DEBUG\"\n+        )\n+        with envs.SGLANG_REDACT_REQUEST_DATA.override(True):\n+            with self.assertRaises(ValueError) as ctx:\n+                check_request_data_redaction(args)\n+        for option in (\"--log-requests\", \"--crash-dump-folder\", \"--log-level debug\"):\n+            self.assertIn(option, str(ctx.exception))\n+\n+    def test_other_options_are_allowed(self):\n+        with envs.SGLANG_REDACT_REQUEST_DATA.override(True):\n+            check_request_data_redaction(_server_args(log_level=\"warning\"))\n+\n+    def test_options_are_allowed_without_the_flag(self):\n+        check_request_data_redaction(_server_args(log_requests=True))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
