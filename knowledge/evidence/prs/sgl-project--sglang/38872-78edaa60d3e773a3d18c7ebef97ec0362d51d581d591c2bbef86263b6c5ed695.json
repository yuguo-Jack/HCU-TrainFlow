      "filename": "python/sglang/srt/layers/attention/vision.py",
      "patch": "@@ -611,6 +611,9 @@ def forward(\n         Returns:\n              [b * s, h, head_size]\n         \"\"\"\n+        window_size = kwargs.get(\"window_size\", (-1, -1))\n+        s_aux = kwargs.get(\"s_aux\", None)\n+\n         if forward_metadata is not None:\n             cu_seqlens_gpu = forward_metadata.cu_seqlens\n             max_seqlen = forward_metadata.max_seqlen\n@@ -621,17 +624,18 @@ def forward(\n                 cu_seqlens_gpu, kwargs.get(\"max_seqlen\")\n             )\n \n-        output = flash_attn_func(\n-            q,\n-            k,\n-            v,\n+        fa_kwargs = dict(\n             cu_seqlens_q=cu_seqlens_gpu,\n             cu_seqlens_k=cu_seqlens_gpu,\n             max_seqlen_q=max_seqlen,\n             max_seqlen_k=max_seqlen,\n             softmax_scale=softmax_scale,\n+            window_size=window_size,\n             ver=4,\n         )\n+        if s_aux is not None:\n+            fa_kwargs[\"sinks\"] = s_aux\n+        output = flash_attn_func(q, k, v, **fa_kwargs)\n \n         return output\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6b46091e50b7911a1a3d294bd9551aa078a67831/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fvision.py",
      "sha": "f1048f4de3541d2e68a4a61817c2a8b695cc2e38",
