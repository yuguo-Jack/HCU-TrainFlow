  "files": [
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3e1b4264735f414c15bcd11df95be30e775eb23a/python%2Fsglang%2Fkernels%2Fops%2Fspeculative%2Fdspark%2Fdspark_draft_model.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fspeculative%2Fdspark%2Fdspark_draft_model.py?ref=3e1b4264735f414c15bcd11df95be30e775eb23a",
      "deletions": 8,
      "filename": "python/sglang/kernels/ops/speculative/dspark/dspark_draft_model.py",
      "patch": "@@ -8,6 +8,8 @@\n import triton\n import triton.language as tl\n \n+from sglang.kernels.ops.speculative.row_argmax import _argmax_pair\n+\n _IDX_SENTINEL = tl.constexpr(2147483647)\n _MARKOV_BLOCK_V = 256\n _MARKOV_BLOCK_R = 32\n@@ -114,11 +116,13 @@ def _markov_greedy_partial_kernel(\n         base_ptr + row * stride_base_row + offs_v, mask=mask_v, other=float(\"-inf\")\n     ).to(tl.float32)\n     score = tl.where(mask_v, base + acc, float(\"-inf\"))\n-    tile_best = tl.max(score, axis=0)\n-    # First-index tie-break within the tile, matching torch.argmax.\n-    idx = tl.where(score == tile_best, offs_v, _IDX_SENTINEL)\n+    # Match torch.argmax's NaN priority and first-index tie-break, excluding\n+    # padded lanes even when every valid score is NaN or negative infinity.\n+    tile_best, idx = tl.reduce(\n+        (score, tl.where(mask_v, offs_v, _IDX_SENTINEL)), 0, _argmax_pair\n+    )\n     tl.store(tile_val_ptr + row * n_tiles + tile, tile_best)\n-    tl.store(tile_idx_ptr + row * n_tiles + tile, tl.min(idx, axis=0))\n+    tl.store(tile_idx_ptr + row * n_tiles + tile, idx)\n \n \n @triton.jit\n@@ -134,10 +138,8 @@ def _markov_greedy_combine_kernel(\n     mask = offs < n_tiles\n     vals = tl.load(tile_val_ptr + row * n_tiles + offs, mask=mask, other=float(\"-inf\"))\n     idxs = tl.load(tile_idx_ptr + row * n_tiles + offs, mask=mask, other=_IDX_SENTINEL)\n-    best = tl.max(vals, axis=0)\n-    # Lowest global index among equal-valued tiles, matching torch.argmax.\n-    cand = tl.where(vals == best, idxs, _IDX_SENTINEL)\n-    tl.store(next_tokens_ptr + row, tl.min(cand, axis=0).to(tl.int64))\n+    _, index = tl.reduce((vals, idxs), 0, _argmax_pair)\n+    tl.store(next_tokens_ptr + row, index.to(tl.int64))\n \n \n def markov_greedy_step_triton(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3e1b4264735f414c15bcd11df95be30e775eb23a/python%2Fsglang%2Fkernels%2Fops%2Fspeculative%2Fdspark%2Fdspark_draft_model.py",
      "sha": "be8045197fc44fe6633d67bc2260fe69d9db55c3",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3e1b4264735f414c15bcd11df95be30e775eb23a/python%2Fsglang%2Fkernels%2Fops%2Fspeculative%2Frow_argmax.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fspeculative%2Frow_argmax.py?ref=3e1b4264735f414c15bcd11df95be30e775eb23a",
      "deletions": 7,
      "filename": "python/sglang/kernels/ops/speculative/row_argmax.py",
      "patch": "@@ -12,6 +12,11 @@\n import triton.language as tl\n \n \n+@triton.jit\n+def _maximum_with_nan(a, b):\n+    return tl.maximum(a, b, propagate_nan=tl.PropagateNan.ALL)\n+\n+\n @triton.jit\n def _argmax_partial_kernel(\n     X, OUTV, OUTI, N, SX, SPLITS: tl.constexpr, BLOCK: tl.constexpr\n@@ -26,12 +31,15 @@ def _argmax_partial_kernel(\n         idx = off + tl.arange(0, BLOCK)\n         m = idx < tl.minimum(start + per, N)\n         v = tl.load(X + row * SX + idx, m, float(\"-inf\"))\n-        cur_v = tl.max(v, 0)\n-        # lowest index among the maxima of this tile\n-        cur_i = tl.min(tl.where(v == cur_v, idx, N), 0)\n-        take = (cur_v > best_v) | ((cur_v == best_v) & (cur_i < best_i))\n-        best_i = tl.where(take, cur_i, best_i)\n+        cur_v = tl.reduce(v, 0, _maximum_with_nan)\n+        # Match NaNs explicitly: equality alone cannot select their indices.\n+        hit = m & ((v == cur_v) | ((v != v) & (cur_v != cur_v)))\n+        cur_i = tl.min(tl.where(hit, idx, N), 0)\n+        # Tiles visit increasing indices, so an existing NaN/tie wins.\n+        take = (cur_v > best_v) | ((cur_v != cur_v) & (best_v == best_v))\n+        take |= cur_i < best_i\n         best_v = tl.where(take, cur_v, best_v)\n+        best_i = tl.where(take, cur_i, best_i)\n     tl.store(OUTV + row * SPLITS + part, best_v)\n     tl.store(OUTI + row * SPLITS + part, best_i)\n \n@@ -43,8 +51,7 @@ def _argmax_final_kernel(INV, INI, OUT, SPLITS: tl.constexpr, BLOCK: tl.constexp\n     m = o < SPLITS\n     v = tl.load(INV + row * SPLITS + o, m, float(\"-inf\"))\n     i = tl.load(INI + row * SPLITS + o, m, 0x7FFFFFFF)\n-    best_v = tl.max(v, 0)\n-    best_i = tl.min(tl.where(v == best_v, i, 0x7FFFFFFF), 0)\n+    _, best_i = tl.reduce((v, i), 0, _argmax_pair)\n     tl.store(OUT + row, best_i.to(tl.int64))\n \n ",
