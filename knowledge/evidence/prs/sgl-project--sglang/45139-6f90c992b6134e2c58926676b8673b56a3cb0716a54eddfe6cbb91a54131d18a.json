    {
      "additions": 63,
      "blob_url": "https://github.com/sgl-project/sglang/blob/61503979e4936ed9b9fb31515fda5960da95191e/test%2Fregistered%2Funit%2Futils%2Ftest_http_request.py",
      "changes": 63,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Futils%2Ftest_http_request.py?ref=61503979e4936ed9b9fb31515fda5960da95191e",
      "deletions": 0,
      "filename": "test/registered/unit/utils/test_http_request.py",
      "patch": "@@ -0,0 +1,63 @@\n+\"\"\"Regression coverage for frontend streaming TLS settings.\"\"\"\n+\n+import os\n+import shutil\n+import tempfile\n+import unittest\n+from io import BytesIO\n+from pathlib import Path\n+from unittest.mock import patch\n+\n+import requests\n+from urllib3 import HTTPResponse\n+from urllib3.connectionpool import HTTPSConnectionPool\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+from sglang.utils import http_request\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+\n+class TestHttpRequest(CustomTestCase):\n+    def test_streaming_ca_bundle(self):\n+        \"\"\"Custom CAs must reach the TLS pool; defaults must keep verification.\"\"\"\n+        tls_settings = []\n+\n+        def respond(pool, **kwargs):\n+            tls_settings.append((pool.ca_certs, pool.cert_reqs))\n+            return HTTPResponse(\n+                body=BytesIO(b\"data: [DONE]\\n\\n\"), status=200, preload_content=False\n+            )\n+\n+        # Keep requests' TLS setup; replace only the network I/O.\n+        with (\n+            tempfile.TemporaryDirectory() as directory,\n+            patch.dict(os.environ, {}, clear=True),\n+            patch.object(\n+                HTTPSConnectionPool, \"urlopen\", autospec=True, side_effect=respond\n+            ),\n+        ):\n+            custom_ca = str(Path(directory) / \"ca.pem\")\n+            shutil.copyfile(requests.certs.where(), custom_ca)\n+            for verify in (custom_ca, None):\n+                with (\n+                    self.subTest(verify=verify),\n+                    http_request(\n+                        \"https://localhost/generate\", stream=True, verify=verify\n+                    ) as response,\n+                ):\n+                    self.assertEqual(\n+                        list(response.iter_lines()), [b\"data: [DONE]\", b\"\"]\n+                    )\n+            self.assertEqual(\n+                tls_settings,\n+                [\n+                    (custom_ca, \"CERT_REQUIRED\"),\n+                    (requests.certs.where(), \"CERT_REQUIRED\"),\n+                ],\n+            )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/61503979e4936ed9b9fb31515fda5960da95191e/test%2Fregistered%2Funit%2Futils%2Ftest_http_request.py",
      "sha": "4e1c02881414f9505d05a975ea105a5525fc7f12",
      "status": "added"
    }
