      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fpythonic_detector.py?ref=10347f3a54ef6a6bdbfcef2f7fe0301f17c91c1a",
      "deletions": 4,
      "filename": "python/sglang/srt/function_call/pythonic_detector.py",
      "patch": "@@ -129,7 +129,7 @@ def detect_and_parse(self, text: str, tools: List[Tool]) -> StreamingParseResult\n     def _find_matching_bracket(self, buffer: str, start: int) -> int:\n         \"\"\"\n         Find the matching closing bracket for the opening bracket at start position.\n-        Properly handles nested brackets.\n+        Properly handles nested brackets and brackets inside strings.\n \n         Args:\n             buffer: The text buffer to search in\n@@ -139,13 +139,35 @@ def _find_matching_bracket(self, buffer: str, start: int) -> int:\n             Position of the matching closing bracket ']', or -1 if not found\n         \"\"\"\n         bracket_count = 0\n-        for i in range(start, len(buffer)):\n-            if buffer[i] == \"[\":\n+        quote = \"\"\n+        i = start\n+        while i < len(buffer):\n+            char = buffer[i]\n+            if quote:\n+                if char == \"\\\\\":\n+                    i += 2\n+                    continue\n+                if buffer.startswith(quote, i):\n+                    i += len(quote)\n+                    quote = \"\"\n+                    continue\n+                i += 1\n+                continue\n+            if char in (\"'\", '\"'):\n+                quote = char * 3 if buffer.startswith(char * 3, i) else char\n+                i += len(quote)\n+                continue\n+            elif char == \"#\":\n+                while i < len(buffer) and buffer[i] not in \"\\r\\n\":\n+                    i += 1\n+                continue\n+            elif char == \"[\":\n                 bracket_count += 1\n-            elif buffer[i] == \"]\":\n+            elif char == \"]\":\n                 bracket_count -= 1\n                 if bracket_count == 0:\n                     return i\n+            i += 1\n         return -1  # No matching bracket found\n \n     def _strip_and_split_buffer(self, buffer: str) -> tuple[str, str]:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/10347f3a54ef6a6bdbfcef2f7fe0301f17c91c1a/python%2Fsglang%2Fsrt%2Ffunction_call%2Fpythonic_detector.py",
      "sha": "6a5c94abe3596b76e9cd82ad390edeb51c4b1497",
      "status": "modified"
    },
    {
      "additions": 73,
      "blob_url": "https://github.com/sgl-project/sglang/blob/10347f3a54ef6a6bdbfcef2f7fe0301f17c91c1a/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py",
      "changes": 73,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py?ref=10347f3a54ef6a6bdbfcef2f7fe0301f17c91c1a",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_function_call_parser.py",
      "patch": "@@ -540,6 +540,79 @@ def test_parse_streaming_complete_tool_call(self):\n         self.assertEqual(params[\"location\"], \"New York\")\n         self.assertEqual(params[\"unit\"], \"celsius\")\n \n+    def test_parse_streaming_bracket_in_string(self):\n+        result = self.detector.parse_streaming_increment(\n+            '[search(query=\"]\")', self.tools\n+        )\n+        self.assertEqual(result.normal_text, \"\")\n+        self.assertEqual(result.calls, [])\n+\n+        result = self.detector.parse_streaming_increment(\"]\", self.tools)\n+        self.assertEqual(result.normal_text, \"\")\n+        self.assertEqual(len(result.calls), 1)\n+        self.assertEqual(result.calls[0].name, \"search\")\n+        self.assertEqual(json.loads(result.calls[0].parameters), {\"query\": \"]\"})\n+\n+    def test_parse_streaming_quoted_brackets_across_chunks(self):\n+        cases = [\n+            ('\"[\"', \"[\"),\n+            (\"']'\", \"]\"),\n+            ('\"a]b[c\"', \"a]b[c\"),\n+            (r'\"a\\\" [ b\"', 'a\" [ b'),\n+            (r\"'a\\' ] b'\", \"a' ] b\"),\n+            (r'\"a\\\\]\"', \"a\\\\]\"),\n+            ('\"\"\"a\" ] b\"\"\"', 'a\" ] b'),\n+            (\"'''a' [ b'''\", \"a' [ b\"),\n+        ]\n+        for literal, expected in cases:\n+            text = f\"[search(query={literal})]\"\n+            partitions = [[text], list(text)] + [\n+                [text[:cut], text[cut:]] for cut in range(1, len(text))\n+            ]\n+            for chunks in partitions:\n+                with self.subTest(literal=literal, chunks=chunks):\n+                    parser = FunctionCallParser(self.tools, \"pythonic\")\n+                    calls = []\n+                    for chunk in chunks:\n+                        normal_text, current_calls = parser.parse_stream_chunk(chunk)\n+                        self.assertEqual(normal_text, \"\")\n+                        calls.extend(current_calls)\n+                    self.assertEqual(parser.parse_stream_end(), (\"\", []))\n+                    self.assertEqual(len(calls), 1)\n+                    self.assertEqual(calls[0].tool_index, 0)\n+                    self.assertEqual(calls[0].name, \"search\")\n+                    self.assertEqual(\n+                        json.loads(calls[0].parameters), {\"query\": expected}\n+                    )\n+\n+    def test_parse_streaming_quoted_brackets_in_nested_arguments(self):\n+        text = '[search(query={\"]\": [\"[\", \"a]b\"]}), get_weather(location=\"]\")]'\n+        calls = []\n+        for char in text:\n+            result = self.detector.parse_streaming_increment(char, self.tools)\n+            self.assertEqual(result.normal_text, \"\")\n+            calls.extend(result.calls)\n+        self.assertEqual([call.name for call in calls], [\"search\", \"get_weather\"])\n+        self.assertEqual([call.tool_index for call in calls], [0, 1])\n+        self.assertEqual(\n+            [json.loads(call.parameters) for call in calls],\n+            [{\"query\": {\"]\": [\"[\", \"a]b\"]}}, {\"location\": \"]\"}],\n+        )\n+\n+    def test_parse_streaming_ignores_quotes_in_comments(self):\n+        for newline in (\"\\n\", \"\\r\\n\", \"\\r\"):\n+            text = f\"[search(query='ok' # don't open a string{newline})]\"\n+            for chunks in ([text], list(text)):\n+                with self.subTest(newline=newline, chunks=chunks):\n+                    parser = FunctionCallParser(self.tools, \"pythonic\")\n+                    calls = []\n+                    for chunk in chunks:\n+                        normal_text, current_calls = parser.parse_stream_chunk(chunk)\n+                        self.assertEqual(normal_text, \"\")\n+                        calls.extend(current_calls)\n+                    self.assertEqual(len(calls), 1)\n+                    self.assertEqual(json.loads(calls[0].parameters), {\"query\": \"ok\"})\n+\n     def test_parse_streaming_partial_tool_call(self):\n         \"\"\"Test parsing a partial tool call that spans multiple chunks.\"\"\"\n         # First chunk with opening bracket but no closing bracket",
