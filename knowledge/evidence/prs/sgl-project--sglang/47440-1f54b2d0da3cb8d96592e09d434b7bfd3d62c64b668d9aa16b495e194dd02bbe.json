    {
      "additions": 24,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3637ec1dfd9a785b20b6d670620ccc2e30506fd4/python%2Fsglang%2Fkernels%2Fjit%2Finclude%2Fsgl_kernel%2Fdeepseek_v4%2Ftopk_impl.cuh",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fjit%2Finclude%2Fsgl_kernel%2Fdeepseek_v4%2Ftopk_impl.cuh?ref=3637ec1dfd9a785b20b6d670620ccc2e30506fd4",
      "deletions": 5,
      "filename": "python/sglang/kernels/jit/include/sgl_kernel/deepseek_v4/topk_impl.cuh",
      "patch": "@@ -868,10 +868,8 @@ struct TopKStreaming : TopKRadixBase<12> {\n // CUDA only: thread-block clusters and distributed shared memory have no CDNA\n // equivalent.\n //\n-// Still truncates an overflowing threshold bin, unlike the register, streaming\n-// and ROCm split paths: the candidate set is split across kClusterSize ranks\n-// and no single block resolves the row, so refining needs cluster-wide\n-// histogram and emit counters rather than the block-local ones refine_ties uses.\n+// When the threshold bin overflows, rank 0 retries the row with the exact\n+// streaming path. All ranks preserve their true candidate counts until then.\n // ---------------------------------------------------------------------------\n \n #if SUPPORT_CLUSTER\n@@ -896,6 +894,23 @@ struct TopKCluster : TopKRadixBase<10> {\n     };\n     TieValue tie_values[kMaxNumTie];\n   };\n+  static_assert(sizeof(Smem) >= sizeof(TopKStreaming::Smem));\n+  static_assert(alignof(Smem) >= alignof(TopKStreaming::Smem));\n+\n+  SGL_DEVICE static bool handle_overflow(TopKProblem problem, Smem* smem) {\n+    const auto cluster = cooperative_groups::this_cluster();\n+    const auto smem_0 = cluster.map_shared_rank(smem, 0);\n+    const bool overflow = smem_0->count_eq > kMaxNumTie;\n+    // Peers must not reuse or retire DSMEM while rank 0 reads the count.\n+    cluster.sync();\n+    if (!overflow) return false;\n+    if (blockIdx.y == 0) {\n+      // The cluster scan already waited for the producer through PDL.\n+      TopKStreaming::forward<false>(problem, smem);\n+    }\n+    cluster.sync();\n+    return true;\n+  }\n \n   SGL_DEVICE static void barrier_cluster_arrive_relaxed() {\n     asm volatile(\"barrier.cluster.arrive.relaxed.aligned;\" ::: \"memory\");\n@@ -976,7 +991,7 @@ struct TopKCluster : TopKRadixBase<10> {\n       });\n       __syncthreads();\n       const auto local_count_gt = smem->count_gt;\n-      const auto local_count_eq = min(smem->count_eq, kMaxNumTie);\n+      const auto local_count_eq = smem->count_eq;\n       if (tx == 0) {\n         const auto gt = atomicAdd(&smem_0->count_gt, local_count_gt);\n         const auto eq = atomicAdd(&smem_0->count_eq, local_count_eq);\n@@ -996,6 +1011,8 @@ struct TopKCluster : TopKRadixBase<10> {\n \n       cluster.sync();  // bar 3\n \n+      if (handle_overflow(problem, smem)) return;\n+\n       const auto start_write = local_start_gt;\n       const auto num_write = local_count_gt;\n #pragma unroll\n@@ -1038,6 +1055,8 @@ struct TopKCluster : TopKRadixBase<10> {\n \n       cluster.sync();  // bar-3\n \n+      if (handle_overflow(problem, smem)) return;\n+\n       // Phase 4: Handle ties.\n       const auto count_gt = smem->count_gt;\n       const auto count_eq = smem->count_eq;",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3637ec1dfd9a785b20b6d670620ccc2e30506fd4/python%2Fsglang%2Fkernels%2Fjit%2Finclude%2Fsgl_kernel%2Fdeepseek_v4%2Ftopk_impl.cuh",
      "sha": "82d434a5baee15fa4d792599e9cf5a6c9896f988",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3637ec1dfd9a785b20b6d670620ccc2e30506fd4/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_topk_v2.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_topk_v2.py?ref=3637ec1dfd9a785b20b6d670620ccc2e30506fd4",
      "deletions": 9,
      "filename": "test/registered/kernels/ops/attention/test_topk_v2.py",
      "patch": "@@ -379,22 +379,14 @@ def _narrow_seed(dist, *rest):\n     return seed\n \n \n-# Longest row that never reaches the CUDA cluster path, which still truncates an\n-# overflowing threshold bin (the smallest get_static_cluster_floor in topk_v2.cuh).\n-CUDA_MAX_NON_CLUSTER_SEQ = 24576\n-\n-\n @pytest.mark.parametrize(\"dist\", NARROW_DISTRIBUTIONS)\n @pytest.mark.parametrize(\"batch,seq\", [(6, 8192), (4, 20480), (4, 32768), (4, 65536)])\n @torch.inference_mode()\n def test_topk_v2_single_coarse_bin_is_exact(batch: int, seq: int, dist: str) -> None:\n     \"\"\"No tolerance here: the threshold bin holds the whole row at k=2048, so a\n     dropped candidate is a wrong answer rather than a tie swap. Covers\n-    register-path and streaming-path shapes, and a ROCm split-path shape (above\n-    split_floor); tie staging is per-template.\n+    register, streaming, and Cluster shapes on CUDA, plus the ROCm split path.\n     \"\"\"\n-    if not is_hip() and seq > CUDA_MAX_NON_CLUSTER_SEQ:\n-        pytest.skip(\"CUDA may route this shape to the unrefined cluster path\")\n     torch.manual_seed(_narrow_seed(dist, batch, seq))\n     device = \"cuda\"\n     k = 2048\n@@ -409,6 +401,22 @@ def test_topk_v2_single_coarse_bin_is_exact(batch: int, seq: int, dist: str) ->\n     )\n \n \n+@pytest.mark.skipif(is_hip(), reason=\"CUDA Cluster path\")\n+@pytest.mark.parametrize(\"batch,seq\", [(1, 131072), (40, 131072)])\n+@pytest.mark.parametrize(\"k\", [512, 2048])\n+@torch.inference_mode()\n+def test_topk_v2_cluster_overflow_is_exact(batch: int, seq: int, k: int) -> None:\n+    \"\"\"Cover fused small-batch and persistent Cluster launches past tie capacity.\"\"\"\n+    torch.manual_seed(_narrow_seed(\"narrow_bin\", batch, seq, k))\n+    scores = _single_bin_scores(\"narrow_bin\", batch, seq, \"cuda\")\n+    seq_lens = torch.full((batch,), seq, dtype=torch.int32, device=\"cuda\")\n+    our_raw = _run_raw(scores, seq_lens, k)\n+    ref_raw = _reference(scores, seq_lens, k)\n+    _assert_topk_close(\n+        scores.cpu(), ref_raw, our_raw, batch, seq_lens.cpu(), k, max_permit_error=0\n+    )\n+\n+\n # --- ragged entry point ------------------------------------------------------\n # Rows select inside `[row_start, row_start + seq_len)` of their score row and\n # emit `position + offset`. The window start is an arbitrary token offset, so",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3637ec1dfd9a785b20b6d670620ccc2e30506fd4/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_topk_v2.py",
      "sha": "c3ff1cb5802f9d34ff7ed6dc91fbb12a45aea008",
      "status": "modified"
    }
