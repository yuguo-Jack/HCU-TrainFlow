      "blob_url": "https://github.com/sgl-project/sglang/blob/d3d811d2f09a18099457f47b392a430f599fb901/test%2Fregistered%2Fattention%2Ftest_deterministic_tp2.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fattention%2Ftest_deterministic_tp2.py?ref=d3d811d2f09a18099457f47b392a430f599fb901",
      "deletions": 0,
      "filename": "test/registered/attention/test_deterministic_tp2.py",
      "patch": "@@ -0,0 +1,43 @@\n+\"\"\"\n+Usage:\n+python3 test/registered/attention/test_deterministic_tp2.py\n+\"\"\"\n+\n+import unittest\n+\n+from sglang.test.ci.ci_register import register_amd_ci\n+from sglang.test.test_deterministic import BenchArgs, test_deterministic\n+from sglang.test.test_deterministic_utils import (\n+    COMMON_SERVER_ARGS,\n+    TestDeterministicBase,\n+)\n+\n+register_amd_ci(est_time=300, suite=\"stage-c-test-large-8-gpu-amd-mi35x\")\n+\n+\n+class TestTritonDeterministicTP2(TestDeterministicBase):\n+    \"\"\"With TP2, the log-probabilities of a prefixed request must not change with the\n+    batch, including batches whose all-reduce inputs exceed the custom all-reduce buffer.\"\"\"\n+\n+    test_single = None\n+\n+    @classmethod\n+    def get_server_args(cls):\n+        return list(COMMON_SERVER_ARGS) + [\"--attention-backend\", \"triton\", \"--tp\", \"2\"]\n+\n+    def test_prefix_with_logprobs(self):\n+        args = BenchArgs()\n+        args.host, args.port = self._extract_host_and_port(self.base_url)\n+        args.test_mode = \"prefix\"\n+        args.n_start = 10\n+        # Measured on MI350X: 10 trials pass even without the fix for oversized\n+        # all-reduce inputs; 50 catch it.\n+        args.n_trials = 50\n+        args.temperature = 0.5\n+        args.return_logprob = True\n+        for result in test_deterministic(args):\n+            assert result == 1\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d3d811d2f09a18099457f47b392a430f599fb901/test%2Fregistered%2Fattention%2Ftest_deterministic_tp2.py",
      "sha": "7c68daae0cc75c710a88731a6faad6102f16bdeb",
      "status": "added"
    }
