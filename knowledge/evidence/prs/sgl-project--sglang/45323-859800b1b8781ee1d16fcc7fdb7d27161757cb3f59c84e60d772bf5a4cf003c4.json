      "deletions": 2,
      "filename": "python/sglang/multimodal_gen/runtime/server_args/server_args.py",
      "patch": "@@ -3731,7 +3731,7 @@ def load_config_file(config_file: str) -> dict[str, Any]:\n         \"\"\"Load a config file.\"\"\"\n         if config_file.endswith(\".json\"):\n             with open(config_file, \"r\") as f:\n-                return json.load(f)\n+                data = json.load(f)\n         elif config_file.endswith((\".yaml\", \".yml\")):\n             try:\n                 import yaml\n@@ -3741,10 +3741,21 @@ def load_config_file(config_file: str) -> dict[str, Any]:\n                     \"`pip install pyyaml`\"\n                 )\n             with open(config_file, \"r\") as f:\n-                return yaml.safe_load(f)\n+                data = yaml.safe_load(f)\n         else:\n             raise ValueError(f\"Unsupported config file format: {config_file}\")\n \n+        if data is None:\n+            data = {}\n+\n+        if not isinstance(data, dict):\n+            raise ValueError(\n+                f\"Config file must contain a mapping/dictionary at the root level, \"\n+                f\"but got {type(data).__name__}: {config_file}\"\n+            )\n+\n+        return data\n+\n     @classmethod\n     def from_kwargs(cls, **kwargs: Any) -> \"ServerArgs\":\n         cls._reject_retired_args(kwargs)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/791a9e1564058dccd9090551bae14d161d05946d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fserver_args%2Fserver_args.py",
      "sha": "09ea1f94285f18f1e23c52c5a2dfb0f10fc0a69b",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/sgl-project/sglang/blob/791a9e1564058dccd9090551bae14d161d05946d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Futils%2Fargparse.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Futils%2Fargparse.py?ref=791a9e1564058dccd9090551bae14d161d05946d",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/runtime/utils/argparse.py",
      "patch": "@@ -234,6 +234,15 @@ def _load_config_file(self, file_path: str) -> list[str]:\n             )\n             raise ex\n \n+        if config is None:\n+            config = {}\n+\n+        if not isinstance(config, dict):\n+            raise ValueError(\n+                f\"Config file must contain a mapping/dictionary at the root level, \"\n+                f\"but got {type(config).__name__}: {file_path}\"\n+            )\n+\n         store_boolean_arguments = [\n             action.dest for action in self._actions if isinstance(action, StoreBoolean)\n         ]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/791a9e1564058dccd9090551bae14d161d05946d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Futils%2Fargparse.py",
