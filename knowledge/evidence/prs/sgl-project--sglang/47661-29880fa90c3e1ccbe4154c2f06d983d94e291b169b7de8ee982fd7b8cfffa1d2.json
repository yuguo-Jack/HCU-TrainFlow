      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/openai/serving_responses.py",
      "patch": "@@ -349,6 +349,17 @@ async def create_responses(\n         if model_error is not None:\n             return model_error\n \n+        lora_path = (\n+            self._resolve_lora_path(request.model, None) if request.model else None\n+        )\n+        if lora_path is None and request.model:\n+            lora_registry = getattr(self.tokenizer_manager, \"lora_registry\", None)\n+            if (\n+                lora_registry is not None\n+                and request.model in lora_registry.get_all_adapters()\n+            ):\n+                lora_path = request.model\n+\n         # FIXME: If the engine is dead, raise an error\n         # This is required for the streaming case\n \n@@ -587,6 +598,7 @@ async def create_responses(\n                             if processed_messages\n                             else None\n                         ),\n+                        lora_path=lora_path,\n                         sampling_params=sampling_params,\n                         stream=request.stream,\n                         rid=request.request_id,\n@@ -3115,6 +3127,7 @@ async def _generate_with_builtin_tools(\n                 return_hidden_states=adapted_request.return_hidden_states,\n                 background=adapted_request.background,\n                 require_reasoning=adapted_request.require_reasoning,\n+                lora_path=adapted_request.lora_path,\n             )\n \n             # Update sampling params with reduced max_tokens",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c29cfcdf985e1ff12ef0c36a21063303212daf1a/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_responses.py",
