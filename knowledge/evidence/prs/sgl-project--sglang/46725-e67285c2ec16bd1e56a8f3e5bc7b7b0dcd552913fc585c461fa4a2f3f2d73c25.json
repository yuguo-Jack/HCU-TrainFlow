      "filename": "python/sglang/srt/hardware_backend/musa/attention/flashattention_backend.py",
      "patch": "@@ -211,6 +211,17 @@ def flash_attn_with_kvcache(\n     )\n \n \n+def _should_use_kvcache_for_extend(forward_batch: ForwardBatch) -> bool:\n+    has_cached_prefix = forward_batch.extend_prefix_lens_cpu is not None and any(\n+        forward_batch.extend_prefix_lens_cpu\n+    )\n+    return (\n+        has_cached_prefix\n+        or forward_batch.forward_mode.is_target_verify()\n+        or forward_batch.forward_mode.is_draft_extend_v2()\n+    )\n+\n+\n class MusaFlashAttentionBackend(FlashAttentionBackend):\n     def __init__(self, model_runner: ModelRunner, **kwargs):\n         super().__init__(model_runner, **kwargs)\n@@ -425,10 +436,7 @@ def _fa_cp_attn(\n                     self.device,\n                     _fa_cp_attn,\n                 )\n-            elif (\n-                forward_batch.extend_prefix_lens_cpu is not None\n-                and any(forward_batch.extend_prefix_lens_cpu)\n-            ) or forward_batch.forward_mode.is_target_verify():\n+            elif _should_use_kvcache_for_extend(forward_batch):\n                 result = flash_attn_with_kvcache(\n                     q=q.contiguous().view(-1, layer.tp_q_head_num, layer.head_dim),\n                     k_cache=key_cache,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/316610d60efc98180ccee8c1e2d67b571bafbf88/python%2Fsglang%2Fsrt%2Fhardware_backend%2Fmusa%2Fattention%2Fflashattention_backend.py",
