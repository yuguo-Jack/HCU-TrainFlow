      "deletions": 1,
      "filename": "python/sglang/srt/entrypoints/anthropic/serving.py",
      "patch": "@@ -12,7 +12,7 @@\n import uuid\n from typing import TYPE_CHECKING, Any, AsyncGenerator, Optional, Union\n \n-from fastapi import Request\n+from fastapi import HTTPException, Request\n from fastapi.responses import JSONResponse, StreamingResponse\n from pydantic import BaseModel, ValidationError\n \n@@ -757,6 +757,15 @@ async def _handle_non_streaming(\n             )\n         except asyncio.CancelledError:\n             raise\n+        except HTTPException as e:\n+            logger.warning(\n+                \"Non-streaming request rejected: %s %s\", e.status_code, e.detail\n+            )\n+            return self._error_response(\n+                status_code=e.status_code,\n+                error_type=ERROR_TYPE_MAP.get(e.status_code, \"api_error\"),\n+                message=_scrub_error_message(str(e.detail), e.status_code),\n+            )\n         except Exception as e:\n             logger.exception(\"Error processing Anthropic request: %s\", e)\n             return self._error_response(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1198750d2edda65ecee421b7fb220f3dd1c62aba/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fserving.py",
