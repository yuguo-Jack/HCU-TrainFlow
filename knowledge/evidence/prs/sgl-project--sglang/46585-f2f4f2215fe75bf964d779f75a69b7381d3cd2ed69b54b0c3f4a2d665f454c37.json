      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fblockwise_int8.py?ref=7a13fcbd7f09ee07b6364ec76896313f186f0877",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/quantization/blockwise_int8.py",
      "patch": "@@ -20,7 +20,10 @@\n     QuantizeMethodBase,\n )\n from sglang.srt.layers.quantization.int8_utils import apply_w8a8_block_int8_linear\n-from sglang.srt.layers.quantization.unquant import UnquantizedLinearMethod\n+from sglang.srt.layers.quantization.unquant import (\n+    UnquantizedFusedMoEMethod,\n+    UnquantizedLinearMethod,\n+)\n from sglang.srt.layers.quantization.utils import is_layer_skipped\n from sglang.srt.utils import set_weight_attrs\n \n@@ -112,6 +115,10 @@ def get_quant_method(\n                 return UnquantizedLinearMethod()\n             return BlockInt8LinearMethod(self)\n         elif isinstance(layer, FusedMoE):\n+            if is_layer_skipped(prefix, self.ignored_layers):\n+                return UnquantizedFusedMoEMethod(\n+                    layer.use_triton_kernels, layer.use_flashinfer_trtllm_moe\n+                )\n             return BlockInt8MoEMethod(self)\n         return None\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7a13fcbd7f09ee07b6364ec76896313f186f0877/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fblockwise_int8.py",
      "sha": "a18eac662d23f6bde39ead5700755eb31b4ca57f",
      "status": "modified"
    },
    {
      "additions": 30,
      "blob_url": "https://github.com/sgl-project/sglang/blob/7a13fcbd7f09ee07b6364ec76896313f186f0877/test%2Fregistered%2Funit%2Flayers%2Fquantization%2Ftest_is_layer_skipped.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fquantization%2Ftest_is_layer_skipped.py?ref=7a13fcbd7f09ee07b6364ec76896313f186f0877",
      "deletions": 0,
      "filename": "test/registered/unit/layers/quantization/test_is_layer_skipped.py",
      "patch": "@@ -1,5 +1,13 @@\n import unittest\n \n+import torch\n+\n+from sglang.srt.layers.moe.fused_moe_triton import FusedMoE\n+from sglang.srt.layers.quantization.blockwise_int8 import (\n+    BlockInt8Config,\n+    BlockInt8MoEMethod,\n+)\n+from sglang.srt.layers.quantization.unquant import UnquantizedFusedMoEMethod\n from sglang.srt.layers.quantization.utils import is_layer_skipped\n from sglang.test.ci.ci_register import register_cpu_ci\n from sglang.test.test_utils import CustomTestCase\n@@ -59,5 +67,27 @@ def test_trailing_dot_prefix_matches_child_modules(self):\n         )\n \n \n+class TestBlockInt8MoE(CustomTestCase):\n+    def test_ignored_moe_is_unquantized(self):\n+        \"\"\"An ignored MoE block used to select the INT8 method.\"\"\"\n+        prefix = \"model.layers.0.mlp.experts\"\n+        layer = FusedMoE.__new__(FusedMoE)\n+        torch.nn.Module.__init__(layer)\n+        layer.use_triton_kernels = False\n+        layer.use_flashinfer_trtllm_moe = False\n+        config = BlockInt8Config(\n+            is_checkpoint_int8_serialized=True,\n+            ignored_layers=(prefix,),\n+            weight_block_size=(128, 128),\n+        )\n+        self.assertIsInstance(\n+            config.get_quant_method(layer, prefix), UnquantizedFusedMoEMethod\n+        )\n+        self.assertIsInstance(\n+            config.get_quant_method(layer, \"model.layers.1.mlp.experts\"),\n+            BlockInt8MoEMethod,\n+        )\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7a13fcbd7f09ee07b6364ec76896313f186f0877/test%2Fregistered%2Funit%2Flayers%2Fquantization%2Ftest_is_layer_skipped.py",
      "sha": "244c5a7073cd7727f563dbe15ea0561721cc3a07",
      "status": "modified"
    }
