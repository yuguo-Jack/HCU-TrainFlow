      "additions": 31,
      "blob_url": "https://github.com/sgl-project/sglang/blob/50c001a739f9e00bc2605c7bb42c000d5d6ff231/python%2Fsglang%2Fsrt%2Fhardware_backend%2Fmlx%2Fmodel_runner_stub.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fhardware_backend%2Fmlx%2Fmodel_runner_stub.py?ref=50c001a739f9e00bc2605c7bb42c000d5d6ff231",
      "deletions": 0,
      "filename": "python/sglang/srt/hardware_backend/mlx/model_runner_stub.py",
      "patch": "@@ -94,6 +94,32 @@ def forward():\n         pass\n \n \n+class _MlxWeightUpdater:\n+    \"\"\"Fails online weight updates; the served weights live in the MLX model.\"\"\"\n+\n+    _UNSUPPORTED = (False, \"Online weight updates are not supported on the MLX backend\")\n+\n+    def _reject(self, *args, **kwargs) -> Tuple[bool, str]:\n+        return self._UNSUPPORTED\n+\n+    update_weights_from_disk = _reject\n+    update_weights_from_tensor = _reject\n+    update_weights_from_ipc = _reject\n+    load_weights_from_distributed = _reject\n+    init_weights_update_group = _reject\n+    destroy_weights_update_group = _reject\n+\n+    def receive_weights_from_distributed(self, **kwargs):\n+        raise RuntimeError(self._UNSUPPORTED[1])\n+\n+    # A session opens before the tensor and distributed loads; they then fail.\n+    def begin_weight_update(self) -> None:\n+        pass\n+\n+    def end_weight_update(self, *, run_post_load: bool) -> None:\n+        pass\n+\n+\n class MlxModelRunnerStub(ModelRunner):\n     \"\"\"ModelRunner that skips PyTorch weight loading and KV cache allocation.\n \n@@ -249,6 +275,11 @@ def _resolve_max_running_requests(self) -> int:\n             )\n         return resolved\n \n+    def init_weight_updater(self):\n+        # The Torch updater would walk or reload `_DummyModel`, and an\n+        # exception in the scheduler's request dispatch stops the server.\n+        self.weight_updater = _MlxWeightUpdater()\n+\n     def initialize(self):\n         \"\"\"Lightweight initialize that skips heavy PyTorch setup.\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/50c001a739f9e00bc2605c7bb42c000d5d6ff231/python%2Fsglang%2Fsrt%2Fhardware_backend%2Fmlx%2Fmodel_runner_stub.py",
      "sha": "d64e29c78e5fbbf708bb25aa25207126287f0065",
      "status": "modified"
    },
    {
      "additions": 30,
      "blob_url": "https://github.com/sgl-project/sglang/blob/50c001a739f9e00bc2605c7bb42c000d5d6ff231/test%2Fregistered%2Funit%2Fhardware_backend%2Fmlx%2Ftest_mlx_runner_pool_contract.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fhardware_backend%2Fmlx%2Ftest_mlx_runner_pool_contract.py?ref=50c001a739f9e00bc2605c7bb42c000d5d6ff231",
      "deletions": 1,
      "filename": "test/registered/unit/hardware_backend/mlx/test_mlx_runner_pool_contract.py",
      "patch": "@@ -18,6 +18,9 @@\n The MLX stub never creates one because its native runner owns model loading\n and KV sizing, so it must report zero for the Torch accounting hook.\n \n+The base weight updater walks the Torch model, which the stub replaces with\n+``_DummyModel``, so online weight updates must fail with a message instead.\n+\n The checks are MLX-gated because importing the stub pulls in ``mlx.core``.\n \"\"\"\n \n@@ -28,7 +31,7 @@\n import unittest\n from types import SimpleNamespace\n \n-from sglang.srt.runtime_context import get_context\n+from sglang.srt.runtime_context import get_context, get_parallel\n from sglang.test.ci.ci_register import register_mlx_ci\n from sglang.test.test_utils import CustomTestCase\n \n@@ -109,6 +112,32 @@ def test_stub_model_supports_runner_model_context(self):\n \n         self.assertEqual(runner.model.shared_experts_config.num_fused_shared_experts, 0)\n \n+    def test_online_weight_update_fails_cleanly(self):\n+        \"\"\"A weight update must return an error, not raise in the scheduler.\"\"\"\n+        runner = object.__new__(MlxModelRunnerStub)\n+        runner.device = \"mps\"\n+        runner.gpu_id = 0\n+        runner.model_config = SimpleNamespace(\n+            model_path=\"model\",\n+            is_hybrid_swa=False,\n+            sliding_window_size=None,\n+            attention_chunk_size=None,\n+            dtype=None,\n+        )\n+        runner.load_model()\n+\n+        with (\n+            get_context().override_server_args(),\n+            get_parallel().override(tp_rank=0),\n+        ):\n+            runner.init_weight_updater()\n+            success, message = runner.weight_updater.update_weights_from_disk(\n+                model_path=\"new-model\", load_format=\"auto\"\n+            )\n+\n+        self.assertFalse(success)\n+        self.assertIn(\"MLX\", message)\n+\n     def test_stub_overrides_base_alloc_memory_pool(self):\n         self.assertIn(\n             \"alloc_memory_pool\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/50c001a739f9e00bc2605c7bb42c000d5d6ff231/test%2Fregistered%2Funit%2Fhardware_backend%2Fmlx%2Ftest_mlx_runner_pool_contract.py",
      "sha": "bc42d98a583ca8726b540df5fa7d076a6e25366c",
      "status": "modified"
    }
