    {
      "additions": 67,
      "blob_url": "https://github.com/sgl-project/sglang/blob/511415587d4afab03bc03c97440fba1bec7b8fa7/.github%2Fworkflows%2Frelease-docker-arm64.yml",
      "changes": 67,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Fworkflows%2Frelease-docker-arm64.yml?ref=511415587d4afab03bc03c97440fba1bec7b8fa7",
      "deletions": 0,
      "filename": ".github/workflows/release-docker-arm64.yml",
      "patch": "@@ -0,0 +1,67 @@\n+name: Release Docker Arm64 CPU Images\n+on:\n+  push:\n+    tags:\n+      - 'v[0-9]+.*'\n+  workflow_dispatch:\n+    inputs:\n+      version:\n+        description: 'Version to build (without v prefix, e.g., 0.5.7)'\n+        required: true\n+\n+jobs:\n+  publish:\n+    if: github.repository == 'sgl-project/sglang'\n+    runs-on: ubuntu-24.04-arm\n+    environment: 'prod'\n+    strategy:\n+      matrix:\n+        build_type: ['all']\n+    steps:\n+\n+      - name: Checkout repository\n+        uses: actions/checkout@v4\n+\n+      - name: Login to Docker Hub\n+        uses: docker/login-action@v2\n+        with:\n+          username: ${{ secrets.DOCKERHUB_USERNAME }}\n+          password: ${{ secrets.DOCKERHUB_TOKEN }}\n+\n+      - name: Get version from tag\n+        id: version\n+        run: |\n+          if [ \"${{ github.event_name }}\" = \"workflow_dispatch\" ]; then\n+            VERSION=\"${{ github.event.inputs.version }}\"\n+          else\n+            # Extract version from tag (e.g., v0.5.7 -> 0.5.7)\n+            VERSION=\"${GITHUB_REF_NAME#v}\"\n+          fi\n+\n+          # Validate version format\n+          if [ -z \"$VERSION\" ]; then\n+            echo \"::error::Version is empty\"\n+            exit 1\n+          fi\n+          if ! echo \"$VERSION\" | grep -qE '^[0-9]+\\.[0-9]+\\.[0-9]+'; then\n+            echo \"::error::Invalid version format: $VERSION (expected: X.Y.Z)\"\n+            exit 1\n+          fi\n+\n+          echo \"version=${VERSION}\" >> $GITHUB_OUTPUT\n+\n+      - name: Build and Push\n+        run: |\n+          version=${{ steps.version.outputs.version }}\n+          tag=v${version}-arm64-cpu\n+\n+          docker build . -f docker/arm64.Dockerfile \\\n+            --build-arg VER_SGLANG=v${version} \\\n+            -t lmsysorg/sglang:${tag} \\\n+            --no-cache\n+          docker run --rm \\\n+            --entrypoint /opt/.venv/bin/python \\\n+            lmsysorg/sglang:${tag} \\\n+            -c 'import platform, torch, sgl_kernel; assert platform.machine() == \"aarch64\"; assert hasattr(torch.ops.sgl_kernel, \"decode_attention_cpu\"); print(\"Arm CPU kernel is available\")'\n+\n+          docker push lmsysorg/sglang:${tag}",
      "raw_url": "https://github.com/sgl-project/sglang/raw/511415587d4afab03bc03c97440fba1bec7b8fa7/.github%2Fworkflows%2Frelease-docker-arm64.yml",
      "sha": "9adc54ba4acbf12422dd64bc9c2766311389a956",
      "status": "added"
    }
