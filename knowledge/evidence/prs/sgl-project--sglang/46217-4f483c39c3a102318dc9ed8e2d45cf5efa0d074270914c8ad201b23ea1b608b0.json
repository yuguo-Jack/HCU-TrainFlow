      "changes": 13,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fhunyuan_detector.py?ref=1c34a9e1e9e17ffcbd053d17eb5f4a0837444ce4",
      "deletions": 9,
      "filename": "python/sglang/srt/function_call/hunyuan_detector.py",
      "patch": "@@ -516,15 +516,10 @@ def _stream_args(self, tools: List[Tool]) -> List[ToolCallItem]:\n             )\n             safe_value = partial_value[:-hold] if hold else partial_value\n             k_json = json.dumps(partial_key, ensure_ascii=False)\n-            escaped = (\n-                safe_value.replace(\"\\\\\", \"\\\\\\\\\")\n-                .replace('\"', '\\\\\"')\n-                .replace(\"\\n\", \"\\\\n\")\n-                .replace(\"\\r\", \"\\\\r\")\n-                .replace(\"\\t\", \"\\\\t\")\n-            )\n-            # No closing `\"` here — it's appended when the value closes.\n-            snapshot_parts.append(f'{k_json}: \"{escaped}')\n+            # Escape like the final json.dumps, so the stream stays a prefix of it;\n+            # the closing `\"` is appended when the value closes.\n+            v_json = json.dumps(safe_value, ensure_ascii=False)[:-1]\n+            snapshot_parts.append(f\"{k_json}: {v_json}\")\n \n         snapshot = \"{\" + \", \".join(snapshot_parts) + \"}\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1c34a9e1e9e17ffcbd053d17eb5f4a0837444ce4/python%2Fsglang%2Fsrt%2Ffunction_call%2Fhunyuan_detector.py",
      "sha": "7ab6c83f1c507125b25d55a318c8b060b200ab87",
      "status": "modified"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/1c34a9e1e9e17ffcbd053d17eb5f4a0837444ce4/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_hunyuan_detector.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_hunyuan_detector.py?ref=1c34a9e1e9e17ffcbd053d17eb5f4a0837444ce4",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_hunyuan_detector.py",
      "patch": "@@ -611,6 +611,24 @@ def test_streaming_string_arg_holds_back_partial_end_tag(self):\n         args = json.loads(collected[0][\"parameters\"])\n         self.assertEqual(args[\"city\"], \"San Francisco\")\n \n+    def test_streaming_string_arg_control_characters_match_one_shot(self):\n+        \"\"\"Streamed string args with control characters must be the one-shot JSON.\"\"\"\n+        value = 'a\\x00b\\x08c\\x0cd\\x1fe\"f\\\\g\\nh'\n+        text = (\n+            \"<tool_calls><tool_call>get_weather<tool_sep>\"\n+            f\"<arg_key>city</arg_key><arg_value>{value}</arg_value>\"\n+            \"</tool_call></tool_calls>\"\n+        )\n+        expected = self._new_detector().detect_and_parse(text, self.tools)\n+        detector = self._new_detector()\n+        all_calls = []\n+        for ch in text:\n+            all_calls.extend(detector.parse_streaming_increment(ch, self.tools).calls)\n+\n+        collected = _collect_streamed_tool_calls(all_calls)\n+        self.assertEqual(collected[0][\"parameters\"], expected.calls[0].parameters)\n+        self.assertEqual(json.loads(collected[0][\"parameters\"]), {\"city\": value})\n+\n     def test_streaming_all_in_one_delta(self):\n         \"\"\"Entire tool call arriving in a single delta.\"\"\"\n         detector = self._new_detector()",
