      "additions": 33,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f0af744d181fe94253e1062c4fc70319ea7b4f49/python%2Fsglang%2Fsrt%2Farg_groups%2Fattention_hook.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Fattention_hook.py?ref=f0af744d181fe94253e1062c4fc70319ea7b4f49",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/attention_hook.py",
      "patch": "@@ -596,6 +596,39 @@ def handle_deterministic_inference(server_args: Any):\n         envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.set(True)\n \n     if cfg.enable_deterministic_inference:\n+        # --- cuBLAS / cuDNN / PyTorch deterministic knobs ---\n+        # These settings must be applied before any cuBLAS/cuDNN lazy\n+        # initialisation so the GPU libraries pick their deterministic code\n+        # paths from the first call.  The cuBLAS workspace config pins the\n+        # GEMM algorithm selection across different M/N/K shapes, which is\n+        # what caused the BF16 batch-shape drift that crossed rounding\n+        # boundaries (see issue #43956).  Setting them again after cuBLAS\n+        # has already picked its workspace is a no-op, so the env vars go\n+        # first and torch.use_deterministic_algorithms is called below as a\n+        # soft fallback.\n+        os.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\n+        os.environ.setdefault(\"CUDNN_DETERMINISTIC\", \"1\")\n+        os.environ.setdefault(\"CUDNN_BENCHMARK\", \"0\")\n+        try:\n+            import torch\n+\n+            torch.use_deterministic_algorithms(True, warn_only=True)\n+            if hasattr(torch.backends, \"cudnn\"):\n+                torch.backends.cudnn.deterministic = True\n+                torch.backends.cudnn.benchmark = False\n+            if hasattr(\n+                torch.backends.cuda.matmul, \"allow_bf16_reduced_precision_reduction\"\n+            ):\n+                torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = (\n+                    False\n+                )\n+            if hasattr(torch.backends.cuda, \"enable_flash_sdp\"):\n+                torch.backends.cuda.enable_flash_sdp(False)\n+            if hasattr(torch.backends.cuda, \"enable_mem_efficient_sdp\"):\n+                torch.backends.cuda.enable_mem_efficient_sdp(False)\n+        except Exception as _e:  # pragma: no cover - torch may not be present yet\n+            logger.debug(\"Could not apply PyTorch deterministic settings: %s\", _e)\n+\n         if cfg.enable_aiter_allreduce_fusion:\n             logger.warning(\n                 \"Disable --enable-aiter-allreduce-fusion because deterministic inference is enabled.\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f0af744d181fe94253e1062c4fc70319ea7b4f49/python%2Fsglang%2Fsrt%2Farg_groups%2Fattention_hook.py",
      "sha": "9f7bede28056f4a1e8cefab34fe06c294e8e1ac7",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f0af744d181fe94253e1062c4fc70319ea7b4f49/python%2Fsglang%2Fsrt%2Farg_groups%2Fserving_hook.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Fserving_hook.py?ref=f0af744d181fe94253e1062c4fc70319ea7b4f49",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/serving_hook.py",
      "patch": "@@ -410,6 +410,14 @@ def handle_environment_variables(server_args: Any):\n     )\n     if cfg.enable_deterministic_inference:\n         envs.SGLANG_FLASHINFER_MOE_FUSED_FINALIZE.set(\"0\")\n+        # Double-guess cuBLAS / cuDNN determinism here too, for code paths\n+        # that might initialise cuBLAS between handle_deterministic_inference\n+        # (pipeline step 228) and handle_environment_variables (step 318) —\n+        # e.g. model loading or backend auto-detection.  Using setdefault\n+        # means handle_deterministic_inference still wins when both run.\n+        os.environ.setdefault(\"CUBLAS_WORKSPACE_CONFIG\", \":4096:8\")\n+        os.environ.setdefault(\"CUDNN_DETERMINISTIC\", \"1\")\n+        os.environ.setdefault(\"CUDNN_BENCHMARK\", \"0\")\n     if cfg.debug_cuda_graph:\n         if not (get_platform().is_cuda or get_platform().is_hip):\n             logger.warning(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f0af744d181fe94253e1062c4fc70319ea7b4f49/python%2Fsglang%2Fsrt%2Farg_groups%2Fserving_hook.py",
      "sha": "87d283c226244aa7321e429a76acb76468e5905b",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f0af744d181fe94253e1062c4fc70319ea7b4f49/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Ffp4_utils.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Ffp4_utils.py?ref=f0af744d181fe94253e1062c4fc70319ea7b4f49",
      "deletions": 0,
      "filename": "python/sglang/srt/layers/quantization/fp4_utils.py",
      "patch": "@@ -159,6 +159,21 @@ def initialize_fp4_gemm_config() -> None:\n         else:\n             backend = \"flashinfer_cutlass\"\n \n+    # FP4 Marlin is weight-only (W4A16) and does not support W4A4 GEMM.\n+    # FlashInfer's mm_fp4 rejects backend='marlin' on SM100+, so force a\n+    # fallback whenever the user (or auto-selection) picks marlin on\n+    # Blackwell GPUs. See issue #43988.\n+    if backend == \"marlin\" and get_platform().is_blackwell:\n+        fallback = (\n+            \"flashinfer_cutedsl\" if get_platform().is_sm100 else \"flashinfer_cutlass\"\n+        )\n+        logger.warning(\n+            \"FP4 Marlin does not support SM100+ (Blackwell); falling back to %s. \"\n+            \"FlashInfer's mm_fp4 has no 'marlin' backend for capability 100.\",\n+            fallback,\n+        )\n+        backend = fallback\n+\n     FP4_GEMM_RUNNER_BACKEND = Fp4GemmRunnerBackend(backend)\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f0af744d181fe94253e1062c4fc70319ea7b4f49/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Ffp4_utils.py",
      "sha": "26da51c5f6099bc0b7c7b42bd31b142e15350a56",
      "status": "modified"
