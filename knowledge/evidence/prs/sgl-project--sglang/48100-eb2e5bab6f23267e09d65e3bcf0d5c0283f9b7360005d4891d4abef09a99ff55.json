      "deletions": 0,
      "filename": "python/sglang/srt/managers/schedule_batch.py",
      "patch": "@@ -1643,6 +1643,7 @@ def set_finish_with_abort(\n         self.origin_input_ids = array(\n             \"q\", [0]\n         )  # set it to one token to skip the long prefill\n+        self.token_indices_to_pool = None\n         self.return_logprob = False\n         self.logprob_start_len = -1\n         self.request_finish(FINISH_ABORT(error_msg, status_code, err_type))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d5414f797c7f954b25efd17c698da3a94d486ee0/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
