    },
    {
      "additions": 17,
      "blob_url": "https://github.com/sgl-project/sglang/blob/d5414f797c7f954b25efd17c698da3a94d486ee0/test%2Fregistered%2Funit%2Fmanagers%2Ftest_setwise_score_mixin.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_setwise_score_mixin.py?ref=d5414f797c7f954b25efd17c698da3a94d486ee0",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_setwise_score_mixin.py",
      "patch": "@@ -12,15 +12,18 @@\n import math\n import unittest\n from types import SimpleNamespace\n+from unittest import mock\n \n import torch\n \n from sglang.srt.managers.io_struct import RequestOutputStats\n+from sglang.srt.managers.schedule_batch import Req\n from sglang.srt.managers.tokenizer_manager_score_mixin import (\n     ScoreResult,\n     TokenizerManagerScoreMixin,\n )\n from sglang.srt.runtime_context import get_context\n+from sglang.srt.sampling.sampling_params import SamplingParams\n from sglang.test.ci.ci_register import register_cpu_ci\n from sglang.test.test_utils import CustomTestCase\n \n@@ -702,5 +705,19 @@ def test_full_roundtrip_into_parser_groups_per_item(self):\n             torch.testing.assert_close(res.pooled_hidden_states[0][i], phs[i])\n \n \n+class TestSetwiseAbort(CustomTestCase):\n+    def test_abort_clears_pooling_positions(self):\n+        \"\"\"Aborting a setwise request (e.g. over-length) shrinks its prompt to one\n+        token; keeping its pooling positions made the logits processor gather out\n+        of range and crash the scheduler.\"\"\"\n+        req = Req(\"over-length\", \"\", [1, 9, 2, 9], SamplingParams())\n+        req.token_indices_to_pool = [1, 3]\n+        with mock.patch(\"sglang.srt.managers.schedule_batch.get_parallel\") as gp:\n+            gp().tp_rank = 0\n+            req.set_finish_with_abort(\"too long\")\n+        self.assertEqual(list(req.origin_input_ids), [0])\n+        self.assertIsNone(req.token_indices_to_pool)\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d5414f797c7f954b25efd17c698da3a94d486ee0/test%2Fregistered%2Funit%2Fmanagers%2Ftest_setwise_score_mixin.py",
      "sha": "a485c3e3e9a4a42d831155b97e66e14daa558fe4",
      "status": "modified"
    }
