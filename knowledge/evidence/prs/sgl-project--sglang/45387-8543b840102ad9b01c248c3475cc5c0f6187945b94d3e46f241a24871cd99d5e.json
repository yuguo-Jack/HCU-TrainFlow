  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/803e6fa1882a70fac16ca4a4bcf7a5d26044f63a/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_splitkv.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_splitkv.py?ref=803e6fa1882a70fac16ca4a4bcf7a5d26044f63a",
      "deletions": 1,
      "filename": "python/sglang/kernels/ops/attention/verify_splitkv.py",
      "patch": "@@ -348,9 +348,14 @@ def _verify_combine_stage2(\n         + offs_l[None, :, None] * stride_ol\n         + offs_dv[None, None, :]\n     )\n+    # Empty splits never write Att_Out and the scratch is reused across calls;\n+    # 0 * inf/nan is nan, so mask the stale rows rather than rely on w == 0.\n+    valid_s = lse > float(\"-inf\")  # [N_SPLITS, L_EXT]\n     ao = tl.load(\n         offs_ao + Att_Out,\n-        mask=mask_l[None, :, None] & (offs_dv[None, None, :] < V_HEAD_DIM),\n+        mask=valid_s[:, :, None]\n+        & mask_l[None, :, None]\n+        & (offs_dv[None, None, :] < V_HEAD_DIM),\n         other=0.0,\n     )  # [N_SPLITS, L_EXT, Dv]\n     o_prefix = tl.sum(ao * w[:, :, None], 0)  # [L_EXT, Dv]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/803e6fa1882a70fac16ca4a4bcf7a5d26044f63a/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_splitkv.py",
      "sha": "15b537f6265bcc8090b029d931410b920068d611",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/803e6fa1882a70fac16ca4a4bcf7a5d26044f63a/test%2Fregistered%2Fattention%2Ftest_verify_splitkv.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fattention%2Ftest_verify_splitkv.py?ref=803e6fa1882a70fac16ca4a4bcf7a5d26044f63a",
      "deletions": 0,
      "filename": "test/registered/attention/test_verify_splitkv.py",
      "patch": "@@ -24,7 +24,9 @@\n     extend_attention_fwd,\n )\n from sglang.kernels.ops.attention.verify_splitkv import (\n+    _get_vk,\n     can_handle,\n+    choose_n_splits,\n     verify_splitkv_fwd,\n )\n from sglang.test.ci.ci_register import register_amd_ci, register_cuda_ci\n@@ -171,6 +173,19 @@ def test_numerics_with_kv_scales(self):\n         # the fp8 KV-cache path applies); both kernels must apply them identically.\n         self._run_parity([1024, 2048], k_scale=0.5, v_scale=0.25)\n \n+    def test_empty_splits_ignore_stale_scratch(self):\n+        \"\"\"A split with no prefix keys must not read the reused scratch buffer;\n+        stale nan/inf there used to reach the output through its zero weight.\"\"\"\n+        device = torch.empty(0, device=\"cuda\").device\n+        # Splits hold whole 32-key blocks, so a 100-key prefix fills 4 of 16 splits\n+        # and a 64-key one 2 of 4; the remaining splits are empty.\n+        for prefix_lens in ([64], [16384, 100]):\n+            with self.subTest(prefix_lens=prefix_lens):\n+                n_splits = choose_n_splits(sum(prefix_lens) / len(prefix_lens))\n+                vk = _get_vk(len(prefix_lens), 16, 2, 256, 256, 4, device, n_splits)\n+                vk.att_out.fill_(float(\"nan\"))\n+                self._run_parity(prefix_lens)\n+\n     # --- fallback: can_handle() must reject what the kernel can't serve --------\n     # (topk>1 is gated off in the backend, not here -- can_handle never inspects\n     #  the tree custom_mask; see verify_splitkv.can_handle docstring.)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/803e6fa1882a70fac16ca4a4bcf7a5d26044f63a/test%2Fregistered%2Fattention%2Ftest_verify_splitkv.py",
      "sha": "ceb822bbde6d0f568ee746eb8fe3641a438bcb07",
      "status": "modified"
    }
