      "blob_url": "https://github.com/sgl-project/sglang/blob/e6691e2bee120011c54883934034b5ffd8bee726/python%2Fsglang%2Fsrt%2Flora%2Futils.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flora%2Futils.py?ref=e6691e2bee120011c54883934034b5ffd8bee726",
      "deletions": 18,
      "filename": "python/sglang/srt/lora/utils.py",
      "patch": "@@ -635,27 +635,34 @@ def build_lm_head_pass_segments(\n     Returns:\n         List of (seg_weight_indices, seg_lens) tuples, one per pass.\n     \"\"\"\n-    # Expand to per-token weight index\n-    token_wi: List[int] = []\n-    for wi, pl in zip(weight_indices, pruned_lens):\n-        token_wi.extend([wi] * pl)\n-    total = len(token_wi)\n-    num_passes = (total + logprobs_chunk_size - 1) // logprobs_chunk_size\n+    if logprobs_chunk_size <= 0:\n+        raise ValueError(\n+            f\"logprobs_chunk_size must be positive, got {logprobs_chunk_size}\"\n+        )\n \n     result: List[Tuple[List[int], List[int]]] = []\n-    for i in range(num_passes):\n-        start = i * logprobs_chunk_size\n-        end = min((i + 1) * logprobs_chunk_size, total)\n-\n-        # Run-length encode the pass's adapter indices\n-        seg_wi: List[int] = []\n-        seg_lens: List[int] = []\n-        for t in range(start, end):\n-            if seg_wi and seg_wi[-1] == token_wi[t]:\n-                seg_lens[-1] += 1\n+    seg_wi: List[int] = []\n+    seg_lens: List[int] = []\n+    room = logprobs_chunk_size\n+\n+    for wi, pl in zip(weight_indices, pruned_lens):\n+        remaining = pl\n+        while remaining > 0:\n+            take = min(remaining, room)\n+            if seg_wi and seg_wi[-1] == wi:\n+                seg_lens[-1] += take\n             else:\n-                seg_wi.append(token_wi[t])\n-                seg_lens.append(1)\n+                seg_wi.append(wi)\n+                seg_lens.append(take)\n+            remaining -= take\n+            room -= take\n+            if room == 0:\n+                result.append((seg_wi, seg_lens))\n+                seg_wi = []\n+                seg_lens = []\n+                room = logprobs_chunk_size\n+\n+    if seg_wi:\n         result.append((seg_wi, seg_lens))\n \n     return result",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e6691e2bee120011c54883934034b5ffd8bee726/python%2Fsglang%2Fsrt%2Flora%2Futils.py",
      "sha": "1deb55e4b4514b3a33b4c99208fb2cc01fafd082",
      "status": "modified"
    },
    {
      "additions": 60,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e6691e2bee120011c54883934034b5ffd8bee726/test%2Fregistered%2Funit%2Flora%2Ftest_lm_head_pruning.py",
      "changes": 60,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flora%2Ftest_lm_head_pruning.py?ref=e6691e2bee120011c54883934034b5ffd8bee726",
      "deletions": 0,
      "filename": "test/registered/unit/lora/test_lm_head_pruning.py",
      "patch": "@@ -14,6 +14,7 @@\n \n \"\"\"Keep LoRA lm_head segmentation aligned with logits-state pruning.\"\"\"\n \n+import random\n import unittest\n from types import SimpleNamespace\n \n@@ -23,11 +24,37 @@\n from sglang.srt.lora.utils import get_lm_head_pruned_lens\n from sglang.srt.model_executor.forward_batch_info import ForwardMode\n from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.srt.lora.utils import build_lm_head_pass_segments\n from sglang.test.test_utils import CustomTestCase\n \n register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n \n \n+def _reference_build_lm_head_pass_segments(\n+    weight_indices, pruned_lens, logprobs_chunk_size\n+):\n+    token_wi = []\n+    for wi, pl in zip(weight_indices, pruned_lens):\n+        token_wi.extend([wi] * pl)\n+    total = len(token_wi)\n+    num_passes = (total + logprobs_chunk_size - 1) // logprobs_chunk_size\n+\n+    result = []\n+    for i in range(num_passes):\n+        start = i * logprobs_chunk_size\n+        end = min((i + 1) * logprobs_chunk_size, total)\n+        seg_wi = []\n+        seg_lens = []\n+        for t in range(start, end):\n+            if seg_wi and seg_wi[-1] == token_wi[t]:\n+                seg_lens[-1] += 1\n+            else:\n+                seg_wi.append(token_wi[t])\n+                seg_lens.append(1)\n+        result.append((seg_wi, seg_lens))\n+    return result\n+\n+\n class TestLMHeadPruning(CustomTestCase):\n     def test_lora_segments_match_pruned_rows_per_request(self):\n         \"\"\"Equal total rows must not hide routing one request through another LoRA.\"\"\"\n@@ -82,6 +109,39 @@ def test_lora_segments_match_pruned_rows_per_request(self):\n                     \"rows forwarded by logits pruning\",\n                 )\n \n+    def test_build_lm_head_pass_segments_edge_cases_and_equivalence(self):\n+        self.assertEqual(build_lm_head_pass_segments([], [], 4), [])\n+        self.assertEqual(build_lm_head_pass_segments([0, 1], [0, 0], 4), [])\n+        self.assertEqual(\n+            build_lm_head_pass_segments([0], [8], 4),\n+            [([0], [4]), ([0], [4])],\n+        )\n+        self.assertEqual(\n+            build_lm_head_pass_segments([0, 1], [3, 3], 4),\n+            [([0, 1], [3, 1]), ([1], [2])],\n+        )\n+        # Zero-length sequence between two sequences with the same adapter\n+        self.assertEqual(\n+            build_lm_head_pass_segments([2, 9, 2], [2, 0, 3], 4),\n+            [([2], [4]), ([2], [1])],\n+        )\n+        with self.assertRaises(ValueError):\n+            build_lm_head_pass_segments([0], [4], 0)\n+\n+        rng = random.Random(42)\n+        for _ in range(500):\n+            n = rng.randint(0, 10)\n+            weight_indices = [rng.randint(-1, 3) for _ in range(n)]\n+            pruned_lens = [rng.randint(0, 15) for _ in range(n)]\n+            chunk_size = rng.randint(1, 12)\n+            expected = _reference_build_lm_head_pass_segments(\n+                weight_indices, pruned_lens, chunk_size\n+            )\n+            actual = build_lm_head_pass_segments(\n+                weight_indices, pruned_lens, chunk_size\n+            )\n+            self.assertEqual(actual, expected)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e6691e2bee120011c54883934034b5ffd8bee726/test%2Fregistered%2Funit%2Flora%2Ftest_lm_head_pruning.py",
      "sha": "dc506b3987b7d4b1591550fa7d3c7cc8ea67705b",
