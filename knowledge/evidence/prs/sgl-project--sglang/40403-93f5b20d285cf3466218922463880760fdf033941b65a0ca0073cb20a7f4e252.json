      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/806303af008f2abbf34d92e8f14718364433ac85/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fnano_nemotron_vl.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fnano_nemotron_vl.py?ref=806303af008f2abbf34d92e8f14718364433ac85",
      "deletions": 3,
      "filename": "python/sglang/srt/multimodal/processors/nano_nemotron_vl.py",
      "patch": "@@ -245,10 +245,10 @@ def parse_video(video) -> tuple[np.ndarray, list[float]]:\n         video_array = video.get_frames_at(frames)\n         avg_fps = video.avg_fps\n         if avg_fps > 0:\n-            frame_duration_ms = int(1000 / avg_fps)\n+            frame_duration_s = 1 / avg_fps\n         else:\n-            frame_duration_ms = 0\n-        timestamps = [i * frame_duration_ms / 1000.0 for i in frames]\n+            frame_duration_s = 0.0\n+        timestamps = [i * frame_duration_s for i in frames]\n         return video_array, timestamps\n \n     def render_audio(self, *, num_tokens: int):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/806303af008f2abbf34d92e8f14718364433ac85/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fnano_nemotron_vl.py",
      "sha": "53a13bb597489aa3c73a280f673da7799e5c1174",
      "status": "modified"
    },
    {
      "additions": 34,
      "blob_url": "https://github.com/sgl-project/sglang/blob/806303af008f2abbf34d92e8f14718364433ac85/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_nano_nemotron_vl_processor.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_nano_nemotron_vl_processor.py?ref=806303af008f2abbf34d92e8f14718364433ac85",
      "deletions": 2,
      "filename": "test/registered/unit/multimodal/test_nano_nemotron_vl_processor.py",
      "patch": "@@ -1,6 +1,15 @@\n \"\"\"Unit tests for the Nano Nemotron VL processor.\"\"\"\n \n+import tempfile\n import unittest\n+from fractions import Fraction\n+\n+import av\n+import numpy as np\n+\n+from sglang.test.test_utils import CustomTestCase, maybe_stub_sgl_kernel\n+\n+maybe_stub_sgl_kernel()\n \n import torch\n \n@@ -9,10 +18,10 @@\n     NanoNemotronVLImageProcessor,\n     _create_visual_items,\n )\n+from sglang.srt.utils.video_decoder import VideoDecoderWrapper\n from sglang.test.ci.ci_register import register_cpu_ci\n-from sglang.test.test_utils import CustomTestCase\n \n-register_cpu_ci(est_time=1, suite=\"base-a-test-cpu\")\n+register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n \n \n class TestNanoNemotronVLProcessor(CustomTestCase):\n@@ -59,6 +68,29 @@ def test_evs_video_next_to_dynamic_images_keeps_evs_metadata(self):\n         self.assertEqual(video.pre_chunked_input_ids, input_ids)\n         self.assertEqual(video.frames_per_video, [3])\n \n+    def test_video_timestamps_preserve_frame_rate_precision(self):\n+        fps = Fraction(24000, 1001)\n+        with tempfile.TemporaryDirectory() as tmpdir:\n+            path = f\"{tmpdir}/video.avi\"\n+            with av.open(path, \"w\") as container:\n+                stream = container.add_stream(\"ffv1\", rate=fps)\n+                stream.width = stream.height = 16\n+                stream.pix_fmt = \"bgr0\"\n+                for index in range(120):\n+                    # Lossless pixels identify each sampled frame independently.\n+                    pixels = np.full((16, 16, 3), index, dtype=np.uint8)\n+                    frame = av.VideoFrame.from_ndarray(pixels, format=\"rgb24\")\n+                    for packet in stream.encode(frame):\n+                        container.mux(packet)\n+                for packet in stream.encode():\n+                    container.mux(packet)\n+\n+            with VideoDecoderWrapper(path) as video:\n+                frames, timestamps = NanoNemotronVLImageProcessor.parse_video(video)\n+\n+        expected_timestamps = frames[:, 0, 0, 0].astype(float) / float(fps)\n+        np.testing.assert_allclose(timestamps, expected_timestamps, rtol=0, atol=1e-9)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/806303af008f2abbf34d92e8f14718364433ac85/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_nano_nemotron_vl_processor.py",
      "sha": "1dc4c556a65d90b935a67132508a80fb9195d8f2",
      "status": "modified"
