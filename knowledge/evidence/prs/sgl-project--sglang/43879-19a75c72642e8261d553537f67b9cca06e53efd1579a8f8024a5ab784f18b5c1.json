      "blob_url": "https://github.com/sgl-project/sglang/blob/2d61c15652208628fb14c0afae7c4613c0d2fb37/scripts%2Fci%2Fcuda%2Fci_install_dependency.sh",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/scripts%2Fci%2Fcuda%2Fci_install_dependency.sh?ref=2d61c15652208628fb14c0afae7c4613c0d2fb37",
      "deletions": 0,
      "filename": "scripts/ci/cuda/ci_install_dependency.sh",
      "patch": "@@ -369,6 +369,45 @@ setup_cargo_cache() {\n         mkdir -p \"${CARGO_TARGET_DIR}\"\n     fi\n \n+    # Rebuild checkout-local crates but keep third-party ones warm: cargo judges\n+    # local crates by mtime, so another checkout's artifacts can pass as Fresh.\n+    python3 - \"${REPO_ROOT}/rust\" <<'EOF'\n+import json\n+import os\n+import subprocess\n+import sys\n+from pathlib import Path\n+\n+\n+def cargo_metadata(manifest):\n+    out = subprocess.run(\n+        [\"cargo\", \"metadata\", \"--locked\", \"--no-deps\", \"--format-version\", \"1\",\n+         \"--manifest-path\", manifest],\n+        check=True, stdout=subprocess.PIPE, text=True,\n+    ).stdout\n+    return json.loads(out)\n+\n+\n+rust_dir = Path(sys.argv[1])\n+root = cargo_metadata(rust_dir / \"Cargo.toml\")\n+# The same manifest set setup.py builds extensions from.\n+extension_manifests = (\n+    (root.get(\"metadata\") or {}).get(\"sglang\", {}).get(\"extension-manifests\", [])\n+)\n+# setuptools-rust forwards CARGO_BUILD_TARGET as --target, but `cargo clean` ignores it.\n+build_target = os.environ.get(\"CARGO_BUILD_TARGET\")\n+target_args = [\"--target\", build_target] if build_target else []\n+for manifest in [rust_dir / \"Cargo.toml\", *(rust_dir / m for m in extension_manifests)]:\n+    names = [p[\"name\"] for p in cargo_metadata(manifest)[\"packages\"] if p[\"source\"] is None]\n+    package_args = [arg for name in names for arg in (\"--package\", name)]\n+    # setuptools-rust builds with --release; `cargo clean -p` cleans only the given profile.\n+    subprocess.run(\n+        [\"cargo\", \"clean\", \"--locked\", \"--release\", *target_args,\n+         \"--manifest-path\", manifest, *package_args],\n+        check=True,\n+    )\n+EOF\n+\n     mark_step_done \"${FUNCNAME[0]}\"\n }\n ",
