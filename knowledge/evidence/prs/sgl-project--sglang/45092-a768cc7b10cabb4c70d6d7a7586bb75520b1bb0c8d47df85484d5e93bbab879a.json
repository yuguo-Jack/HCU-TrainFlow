  "files": [
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c0d77c40809c6328a84a1849e936eb5e95bcf885/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fflashinfer_backend.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fflashinfer_backend.py?ref=c0d77c40809c6328a84a1849e936eb5e95bcf885",
      "deletions": 2,
      "filename": "python/sglang/srt/layers/attention/flashinfer_backend.py",
      "patch": "@@ -1280,7 +1280,13 @@ def _prepare_cuda_graph_metadata(\n         spec_info: Optional[SpecInput],\n     ) -> None:\n         if forward_mode.is_decode_or_idle():\n-            decode_wrappers = self._create_decode_wrappers(bs, num_tokens)\n+            # A batch size captured more than once (attention graph variants, LoRA /\n+            # no-LoRA) must share one set of wrappers: replay plans only\n+            # decode_cuda_graph_metadata[bs], so a fresh set per capture leaves the\n+            # earlier graphs reading plans nobody refreshes.\n+            decode_wrappers = self.decode_cuda_graph_metadata.get(\n+                bs\n+            ) or self._create_decode_wrappers(bs, num_tokens)\n             self.decode_cuda_graph_metadata[bs] = decode_wrappers\n             self.forward_metadata = DecodeMetadata(decode_wrappers)\n         elif forward_mode.is_target_verify() or forward_mode.is_dllm_extend():\n@@ -1289,7 +1295,9 @@ def _prepare_cuda_graph_metadata(\n                 and spec_info is not None\n                 and getattr(spec_info, \"custom_mask\", None) is not None\n             )\n-            prefill_wrappers = self._create_prefill_wrappers(bs, use_custom_mask)\n+            prefill_wrappers = self.prefill_cuda_graph_metadata.get(\n+                bs\n+            ) or self._create_prefill_wrappers(bs, use_custom_mask)\n             self.prefill_cuda_graph_metadata[bs] = prefill_wrappers\n             self.forward_metadata = PrefillMetadata(\n                 prefill_wrappers, forward_mode.is_dllm_extend(), False",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c0d77c40809c6328a84a1849e936eb5e95bcf885/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fflashinfer_backend.py",
      "sha": "f5a1aa2c7012f90363677b1d97530af390f60f45",
      "status": "modified"
    },
    {
      "additions": 50,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c0d77c40809c6328a84a1849e936eb5e95bcf885/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_flashinfer_graph_variant_wrappers.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_flashinfer_graph_variant_wrappers.py?ref=c0d77c40809c6328a84a1849e936eb5e95bcf885",
      "deletions": 0,
      "filename": "test/registered/unit/layers/attention/test_flashinfer_graph_variant_wrappers.py",
      "patch": "@@ -0,0 +1,50 @@\n+\"\"\"FlashInfer CUDA-graph metadata: a batch size captured twice must reuse its wrappers.\n+\n+Replay plans only the wrappers stored for the batch size. If a second capture of the same batch\n+size (another attention graph variant, or the LoRA / no-LoRA pair) created new wrappers, the first\n+graph would replay against wrappers that are never re-planned.\n+\"\"\"\n+\n+import unittest\n+from types import SimpleNamespace\n+\n+from sglang.srt.layers.attention import flashinfer_backend as fib\n+from sglang.srt.model_executor.forward_batch_info import ForwardMode\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+\n+def _backend():\n+    backend = object.__new__(fib.FlashInferAttnBackend)\n+    backend.decode_cuda_graph_metadata = {}\n+    backend.prefill_cuda_graph_metadata = {}\n+    backend._create_decode_wrappers = lambda bs, num_tokens: [object()]\n+    backend._create_prefill_wrappers = lambda bs, use_custom_mask=False: [object()]\n+    return backend\n+\n+\n+class TestFlashInferGraphVariantWrappers(CustomTestCase):\n+    def test_decode_capture_twice_shares_wrappers(self):\n+        backend = _backend()\n+        backend._prepare_cuda_graph_metadata(4, 4, ForwardMode.DECODE, None)\n+        first = backend.forward_metadata.decode_wrappers\n+        backend._prepare_cuda_graph_metadata(4, 4, ForwardMode.DECODE, None)\n+        self.assertIs(backend.forward_metadata.decode_wrappers, first)\n+        self.assertIs(backend.decode_cuda_graph_metadata[4], first)\n+        backend._prepare_cuda_graph_metadata(8, 8, ForwardMode.DECODE, None)\n+        self.assertIsNot(backend.decode_cuda_graph_metadata[8], first)\n+\n+    def test_verify_capture_twice_shares_wrappers(self):\n+        backend = _backend()\n+        spec = SimpleNamespace(custom_mask=None)\n+        backend._prepare_cuda_graph_metadata(4, 32, ForwardMode.TARGET_VERIFY, spec)\n+        first = backend.forward_metadata.prefill_wrappers\n+        backend._prepare_cuda_graph_metadata(4, 32, ForwardMode.TARGET_VERIFY, spec)\n+        self.assertIs(backend.forward_metadata.prefill_wrappers, first)\n+        self.assertIs(backend.prefill_cuda_graph_metadata[4], first)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c0d77c40809c6328a84a1849e936eb5e95bcf885/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_flashinfer_graph_variant_wrappers.py",
      "sha": "3485e71b6a18d1cc68cc0583419999514239d525",
      "status": "added"
    }
