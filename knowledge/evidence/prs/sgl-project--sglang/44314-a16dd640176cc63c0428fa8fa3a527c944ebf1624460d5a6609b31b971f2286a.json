    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/aa2a94348ff187084c73071fc9276bf34abf4e0c/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner_components%2Fweight_exporter.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner_components%2Fweight_exporter.py?ref=aa2a94348ff187084c73071fc9276bf34abf4e0c",
      "deletions": 1,
      "filename": "python/sglang/srt/model_executor/model_runner_components/weight_exporter.py",
      "patch": "@@ -93,7 +93,7 @@ def send_weights_to_remote_instance(\n         group_port = ports_list[self.tp_rank]\n         group_name = f\"{group_name}_{group_port}_{self.tp_rank}\"\n \n-        if self._weights_send_group[group_name] is not None:\n+        if self._weights_send_group.get(group_name) is not None:\n             send_group = self._weights_send_group[group_name]\n         else:\n             message = f\"Group {group_name} not in _weights_send_group list. Please call `init_weights_send_group_for_remote_instance` first.\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aa2a94348ff187084c73071fc9276bf34abf4e0c/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner_components%2Fweight_exporter.py",
      "sha": "4c0bf8d4a514ca60b94112071cc456cb46fa64dd",
      "status": "modified"
    },
    {
      "additions": 86,
      "blob_url": "https://github.com/sgl-project/sglang/blob/aa2a94348ff187084c73071fc9276bf34abf4e0c/test%2Fregistered%2Funit%2Fmodel_executor%2Fmodel_runner_components%2Ftest_weight_exporter.py",
      "changes": 86,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodel_executor%2Fmodel_runner_components%2Ftest_weight_exporter.py?ref=aa2a94348ff187084c73071fc9276bf34abf4e0c",
      "deletions": 0,
      "filename": "test/registered/unit/model_executor/model_runner_components/test_weight_exporter.py",
      "patch": "@@ -0,0 +1,86 @@\n+\"\"\"Unit tests for missing and consumed remote weight-export groups.\"\"\"\n+\n+import unittest\n+from unittest.mock import Mock, patch\n+\n+import torch\n+\n+from sglang.srt.model_executor.model_runner_components.weight_exporter import (\n+    WeightExporter,\n+)\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+_MODULE = \"sglang.srt.model_executor.model_runner_components.weight_exporter\"\n+\n+\n+class TestWeightExporter(CustomTestCase):\n+    def setUp(self):\n+        self.get_model = Mock(return_value=torch.nn.Linear(2, 2, bias=False))\n+        self.exporter = WeightExporter(\n+            tp_rank=1,\n+            tp_size=2,\n+            gpu_id=1,\n+            get_model_path=lambda: \"unused\",\n+            get_model=self.get_model,\n+        )\n+        self.group_name = \"export_29312_1\"\n+        self.initialized = self.enterContext(\n+            patch(f\"{_MODULE}.dist.is_initialized\", return_value=True)\n+        )\n+        self.empty_cache = self.enterContext(\n+            patch(f\"{_MODULE}.current_platform.empty_cache\")\n+        )\n+        self.broadcast = self.enterContext(patch(f\"{_MODULE}.dist.broadcast\"))\n+        self.destroy_group = self.enterContext(\n+            patch(f\"{_MODULE}.dist.distributed_c10d.destroy_process_group\")\n+        )\n+\n+    def send(self):\n+        return self.exporter.send_weights_to_remote_instance(\n+            \"127.0.0.1\", \"29311,29312\", \"export\"\n+        )\n+\n+    def assert_missing_group(self):\n+        success, message = self.send()\n+        self.assertFalse(success)\n+        self.assertIn(self.group_name, message)\n+        self.assertIn(\"init_weights_send_group_for_remote_instance\", message)\n+        self.get_model.assert_not_called()\n+        self.empty_cache.assert_not_called()\n+        self.broadcast.assert_not_called()\n+        self.destroy_group.assert_not_called()\n+\n+    def test_unknown_group_returns_error(self):\n+        self.assert_missing_group()\n+        self.assertEqual(self.exporter._weights_send_group, {})\n+\n+    def test_none_group_returns_error(self):\n+        self.exporter._weights_send_group[self.group_name] = None\n+        self.assert_missing_group()\n+        self.assertIsNone(self.exporter._weights_send_group[self.group_name])\n+\n+    def test_send_consumes_group_and_repeat_returns_error(self):\n+        group = object()\n+        self.exporter._weights_send_group[self.group_name] = group\n+        success, _ = self.send()\n+        self.assertTrue(success)\n+        self.broadcast.assert_called_once_with(\n+            self.get_model.return_value.weight, src=0, group=group\n+        )\n+        self.destroy_group.assert_called_once_with(group)\n+        self.assertNotIn(self.group_name, self.exporter._weights_send_group)\n+        for mock in (\n+            self.get_model,\n+            self.empty_cache,\n+            self.broadcast,\n+            self.destroy_group,\n+        ):\n+            mock.reset_mock()\n+        self.assert_missing_group()\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aa2a94348ff187084c73071fc9276bf34abf4e0c/test%2Fregistered%2Funit%2Fmodel_executor%2Fmodel_runner_components%2Ftest_weight_exporter.py",
