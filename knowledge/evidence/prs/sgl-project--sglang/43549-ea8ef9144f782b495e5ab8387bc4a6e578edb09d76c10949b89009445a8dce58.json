      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/bf6b750148484cc7a41b3d9a08ebd7c0bedf6f56/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fchat_encoding.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fchat_encoding.py?ref=bf6b750148484cc7a41b3d9a08ebd7c0bedf6f56",
      "deletions": 1,
      "filename": "python/sglang/srt/entrypoints/openai/chat_encoding.py",
      "patch": "@@ -62,7 +62,11 @@ def resolve_chat_encoding_spec(\n def spec_supports_inline_system(spec: Optional[str]) -> bool:\n     \"\"\"Native encoders verified to render mid-conversation system messages in place.\"\"\"\n     # K3's tokenizer renders in Python, so there is no Jinja source to probe.\n-    return spec == \"kimi_k3\"\n+    # dsv41 is the same shape: its encoder converts the message list itself\n+    # (deepseek-recipe for the dsv4 family), so a system turn past index 0 is\n+    # rendered where it sits, and the checkpoint ships no chat_template for the\n+    # probe to read.\n+    return spec in (\"kimi_k3\", \"dsv41\")\n \n \n def spec_owns_reasoning_history(spec: Optional[str]) -> bool:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bf6b750148484cc7a41b3d9a08ebd7c0bedf6f56/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fchat_encoding.py",
      "sha": "a7312e8363f453eb14610cf3a4744bb1695044de",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/bf6b750148484cc7a41b3d9a08ebd7c0bedf6f56/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py?ref=bf6b750148484cc7a41b3d9a08ebd7c0bedf6f56",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/anthropic/test_serving.py",
      "patch": "@@ -18,6 +18,9 @@\n     AnthropicMessagesRequest,\n )\n from sglang.srt.entrypoints.anthropic.serving import AnthropicServing  # noqa: E402\n+from sglang.srt.entrypoints.openai.chat_encoding import (  # noqa: E402\n+    spec_supports_inline_system,\n+)\n from sglang.srt.entrypoints.openai.protocol import (  # noqa: E402\n     ChatCompletionRequest,\n     ChatCompletionResponse,\n@@ -1713,6 +1716,25 @@ def test_inline_system_support_comes_from_the_prompt_renderer(self):\n         )\n         self.assertEqual(converted.messages[0].content, \"Stable instructions\")\n \n+    def test_dsv41_uses_the_native_inline_system_encoder(self):\n+        \"\"\"DeepSeek-V4.1-Flash ships no ``chat_template`` and renders the conversation\n+        with its own encoder, so the Jinja probe cannot answer for it: the encoder\n+        converts the message list itself, so a system turn past index 0 stays where\n+        it is. The allowlist has to answer for it, otherwise Messages hoists the turn\n+        into the leading system block and the prompt prefix changes on every turn,\n+        which is what defeats the radix cache.\"\"\"\n+        self.assertTrue(spec_supports_inline_system(\"dsv41\"))\n+        self.assertTrue(spec_supports_inline_system(\"kimi_k3\"))\n+        # Inkling renders prompt ids natively, but its inline-system handling is\n+        # unverified, so it stays out of the allowlist.\n+        self.assertFalse(spec_supports_inline_system(\"inkling\"))\n+        self.assertFalse(spec_supports_inline_system(None))\n+\n+        chat = _FakeOpenAIServingChat(chat_template=None)\n+        chat.supports_inline_system = spec_supports_inline_system(\"dsv41\")\n+        serving = AnthropicServing(chat)\n+        self.assertFalse(serving._merge_inline_system)\n+\n     def test_top_level_system_only_is_unchanged(self):\n         \"\"\"A request with only the top-level ``system`` field (no in-messages\n         system turn) is unaffected on both detection paths: the system field is",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bf6b750148484cc7a41b3d9a08ebd7c0bedf6f56/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py",
      "sha": "138da4a80193f635aef4fbe0d397b83f66126619",
      "status": "modified"
    }
