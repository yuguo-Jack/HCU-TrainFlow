      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdistributed%2Fbootstrap.py?ref=9f03113db28ba1b27778f0836bc4acd2ceb3be0e",
      "deletions": 0,
      "filename": "python/sglang/srt/distributed/bootstrap.py",
      "patch": "@@ -140,6 +140,8 @@ def init_parallel_runtime(\n         )\n         raise\n     maybe_init_shared_mooncake_transfer_engine(gpu_id=get_device().gpu_id)\n+    if device == \"xpu\":\n+        _set_xpu_ccl_defaults()\n \n     parallel = get_parallel()\n     if device == \"cpu\":\n@@ -259,6 +261,14 @@ def _set_all_reduce_flags() -> None:\n     )\n \n \n+def _set_xpu_ccl_defaults() -> None:\n+    # oneCCL reads this when the first communicator is created. On Arc Pro B70 (TP4,\n+    # PCIe) it cuts graph-mode decode-size all-reduces from 17-26 us to 15-16 us\n+    # and leaves prefill-size ones unchanged; a user-set value wins.\n+    if \"Arc\" in torch.xpu.get_device_name():\n+        os.environ.setdefault(\"CCL_SYCL_ALLREDUCE_ARC\", \"1\")\n+\n+\n def _set_shm_master_env(dist_init_method: Optional[str]) -> None:\n     # setdefault so an explicit user-provided MASTER_ADDR/MASTER_PORT wins.\n     prefix = \"tcp://\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9f03113db28ba1b27778f0836bc4acd2ceb3be0e/python%2Fsglang%2Fsrt%2Fdistributed%2Fbootstrap.py",
