      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Flogprob_result_processor.py?ref=15f08d58fcb041c58d9ac986ff49f31125e1bc40",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/scheduler_components/logprob_result_processor.py",
      "patch": "@@ -51,7 +51,7 @@ def _process_input_token_logprobs(\n \n         # Clip padded hash values from image tokens to prevent detokenization errors\n         req.logprob.input_token_logprobs_idx = [\n-            x if x < self.model_config.vocab_size - 1 else 0\n+            x if x < self.model_config.vocab_size else 0\n             for x in input_token_logprobs_idx\n         ]\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/15f08d58fcb041c58d9ac986ff49f31125e1bc40/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Flogprob_result_processor.py",
      "sha": "7f197083a88078ee1fb85e3cd5dbd1ce98def64b",
      "status": "modified"
    },
    {
      "additions": 20,
      "blob_url": "https://github.com/sgl-project/sglang/blob/15f08d58fcb041c58d9ac986ff49f31125e1bc40/test%2Fregistered%2Funit%2Fmanagers%2Ftest_flat_raw_top_logprobs.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_flat_raw_top_logprobs.py?ref=15f08d58fcb041c58d9ac986ff49f31125e1bc40",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_flat_raw_top_logprobs.py",
      "patch": "@@ -547,6 +547,26 @@ def test_chunked_matches_one_shot(self):\n             chunked.logprob.input_top_logprobs_flat_null_prefix,\n         )\n \n+    def test_input_logprobs_preserve_max_valid_token(self):\n+        \"\"\"Prompt logprob IDs retain the last vocab token, not a zero replacement.\"\"\"\n+        input_ids = array(\"q\", [0, 999_998, 999_999, 1_000_000, 1_000_123])\n+        for flat in (False, True):\n+            for chunk_sizes in ([5], [2, 3]):\n+                with self.subTest(flat=flat, chunk_sizes=chunk_sizes):\n+                    req = self._make_req(flat=flat)\n+                    req.origin_input_ids = input_ids[:]\n+                    self._run_prefill(req, chunk_sizes)\n+\n+                    self.assertEqual(\n+                        req.logprob.input_token_logprobs_idx,\n+                        [0, 999_998, 999_999, 0, 0],\n+                    )\n+                    self.assertEqual(\n+                        req.logprob.input_token_logprobs_val,\n+                        [None] + [row[0] for row in _SCHED_VAL_ROWS[:-1]],\n+                    )\n+                    self.assertEqual(req.origin_input_ids, input_ids)\n+\n     def test_unrepresentable_rows_fall_back_to_nested(self):\n         req = self._make_req(flat=True, num_tokens=3)\n         processor = _make_logprob_processor()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/15f08d58fcb041c58d9ac986ff49f31125e1bc40/test%2Fregistered%2Funit%2Fmanagers%2Ftest_flat_raw_top_logprobs.py",
      "sha": "8b454bad7e6179edf1ea34a709512cc3b5798835",
      "status": "modified"
    }
