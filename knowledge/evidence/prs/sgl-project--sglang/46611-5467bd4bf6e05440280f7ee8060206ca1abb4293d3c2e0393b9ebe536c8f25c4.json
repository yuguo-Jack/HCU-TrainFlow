  "files": [
    {
      "additions": 19,
      "blob_url": "https://github.com/sgl-project/sglang/blob/eed900801b63addbba6c7d043861dfde4a3ad1ad/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fhook_manager.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fhook_manager.py?ref=eed900801b63addbba6c7d043861dfde4a3ad1ad",
      "deletions": 0,
      "filename": "python/sglang/srt/model_executor/hook_manager.py",
      "patch": "@@ -7,6 +7,25 @@\n \n logger = logging.getLogger(__name__)\n \n+FORWARD_HOOKS_CUDA_GRAPH_WARNING = (\n+    \"forward_hooks are registered after CUDA graph capture and do not run on \"\n+    \"graph replay. CUDA graphs are enabled, so hooks may never fire. Disable \"\n+    \"them with --disable-decode-cuda-graph --disable-prefill-cuda-graph (or \"\n+    \"Engine kwargs disable_decode_cuda_graph=True, \"\n+    \"disable_prefill_cuda_graph=True) to run hooks on every forward pass. \"\n+    \"This lowers throughput.\"\n+)\n+\n+\n+def warn_if_cuda_graphs_skip_forward_hooks(\n+    hook_specs: Optional[List[dict[str, Any]]],\n+    *,\n+    cuda_graphs_enabled: bool,\n+) -> None:\n+    \"\"\"Warn at startup when configured hooks will be skipped by graph replay.\"\"\"\n+    if hook_specs and cuda_graphs_enabled:\n+        logger.warning(FORWARD_HOOKS_CUDA_GRAPH_WARNING)\n+\n \n def register_forward_hooks(model: nn.Module, hook_specs: List[dict[str, Any]]) -> None:\n     \"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/eed900801b63addbba6c7d043861dfde4a3ad1ad/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fhook_manager.py",
      "sha": "7af57612c587c81236439695056e3be7686875ec",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/sgl-project/sglang/blob/eed900801b63addbba6c7d043861dfde4a3ad1ad/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner_components%2Fcuda_graph_setup.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner_components%2Fcuda_graph_setup.py?ref=eed900801b63addbba6c7d043861dfde4a3ad1ad",
      "deletions": 3,
      "filename": "python/sglang/srt/model_executor/model_runner_components/cuda_graph_setup.py",
      "patch": "@@ -24,6 +24,7 @@\n     Backend,\n     Phase,\n     check_cuda_graph_backend,\n+    cuda_graph_fully_disabled,\n )\n from sglang.srt.model_executor.forward_batch_info import (\n     CaptureHiddenMode,\n@@ -34,7 +35,10 @@\n     merge_graph_time_usage,\n )\n from sglang.srt.model_executor.graph_shared_output import GraphSharedOutput\n-from sglang.srt.model_executor.hook_manager import register_forward_hooks\n+from sglang.srt.model_executor.hook_manager import (\n+    register_forward_hooks,\n+    warn_if_cuda_graphs_skip_forward_hooks,\n+)\n from sglang.srt.model_executor.runner import (\n     EagerRunner,\n     PrefillCudaGraphRunner,\n@@ -455,8 +459,13 @@ def finalize_cuda_graph_capture(model_runner: ModelRunner) -> None:\n     # not traced into any captured graph — capture stays hook-free and hooks\n     # fire only on the eager forward path (capture replay never runs Python\n     # hooks anyway).\n-    if get_observability().forward_hooks:\n-        register_forward_hooks(model_runner.model, get_observability().forward_hooks)\n+    hook_specs = get_observability().forward_hooks\n+    if hook_specs:\n+        warn_if_cuda_graphs_skip_forward_hooks(\n+            hook_specs,\n+            cuda_graphs_enabled=not cuda_graph_fully_disabled(),\n+        )\n+        register_forward_hooks(model_runner.model, hook_specs)\n \n     prealloc_symmetric_memory_pool(\n         is_draft_worker=model_runner.is_draft_worker,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/eed900801b63addbba6c7d043861dfde4a3ad1ad/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner_components%2Fcuda_graph_setup.py",
      "sha": "9c5341cb3ee10e63318a858c84401a04a3028b60",
      "status": "modified"
    },
    {
      "additions": 69,
      "blob_url": "https://github.com/sgl-project/sglang/blob/eed900801b63addbba6c7d043861dfde4a3ad1ad/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_hook_manager.py",
      "changes": 69,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_hook_manager.py?ref=eed900801b63addbba6c7d043861dfde4a3ad1ad",
      "deletions": 0,
      "filename": "test/registered/unit/model_executor/test_hook_manager.py",
      "patch": "@@ -0,0 +1,69 @@\n+\"\"\"Unit tests for forward-hook CUDA graph skip warning — no server, no GPU.\n+\n+hook_manager is loaded straight from its file: importing sglang as a package\n+pulls in the engine's runtime dependencies, which would make a pure-logic test\n+require a full install.\n+\"\"\"\n+\n+import importlib.util\n+import os\n+import unittest\n+\n+try:\n+    from sglang.test.ci.ci_register import register_cpu_ci\n+except ImportError:  # standalone run without an sglang install; CI parses the\n+    # registration below from the AST, so the stub changes nothing for CI.\n+    def register_cpu_ci(**kwargs):\n+        pass\n+\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+_HERE = os.path.dirname(os.path.abspath(__file__))\n+_HOOK_MANAGER = os.path.normpath(\n+    os.path.join(_HERE, \"../../../../python/sglang/srt/model_executor/hook_manager.py\")\n+)\n+_spec = importlib.util.spec_from_file_location(\n+    \"sglang.srt.model_executor.hook_manager\", _HOOK_MANAGER\n+)\n+_mod = importlib.util.module_from_spec(_spec)\n+_spec.loader.exec_module(_mod)\n+FORWARD_HOOKS_CUDA_GRAPH_WARNING = _mod.FORWARD_HOOKS_CUDA_GRAPH_WARNING\n+warn_if_cuda_graphs_skip_forward_hooks = _mod.warn_if_cuda_graphs_skip_forward_hooks\n+\n+\n+class TestForwardHookCudaGraphWarning(unittest.TestCase):\n+    def test_warns_when_hooks_and_cuda_graphs_are_on(self):\n+        with self.assertLogs(\n+            \"sglang.srt.model_executor.hook_manager\", level=\"WARNING\"\n+        ) as captured:\n+            warn_if_cuda_graphs_skip_forward_hooks(\n+                [{\"name\": \"probe\"}],\n+                cuda_graphs_enabled=True,\n+            )\n+        self.assertTrue(\n+            any(\n+                FORWARD_HOOKS_CUDA_GRAPH_WARNING in message\n+                for message in captured.output\n+            )\n+        )\n+\n+    def test_silent_when_cuda_graphs_are_disabled(self):\n+        with self.assertNoLogs(\n+            \"sglang.srt.model_executor.hook_manager\", level=\"WARNING\"\n+        ):\n+            warn_if_cuda_graphs_skip_forward_hooks(\n+                [{\"name\": \"probe\"}],\n+                cuda_graphs_enabled=False,\n+            )\n+\n+    def test_silent_when_no_hooks_are_configured(self):\n+        with self.assertNoLogs(\n+            \"sglang.srt.model_executor.hook_manager\", level=\"WARNING\"\n+        ):\n+            warn_if_cuda_graphs_skip_forward_hooks(None, cuda_graphs_enabled=True)\n+            warn_if_cuda_graphs_skip_forward_hooks([], cuda_graphs_enabled=True)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/eed900801b63addbba6c7d043861dfde4a3ad1ad/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_hook_manager.py",
      "sha": "e4907b70be6a3496b3ba2d86ea06d8a13387fe82",
      "status": "added"
    }
