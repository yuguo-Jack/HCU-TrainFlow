    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2daaff0492c8b167532b5829d674ad28d31ac806/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py?ref=2daaff0492c8b167532b5829d674ad28d31ac806",
      "deletions": 2,
      "filename": "python/sglang/srt/multimodal/processors/base_processor.py",
      "patch": "@@ -1550,8 +1550,11 @@ def get_mm_items_offset(\n             return result = [(2,4),(6,7)]\n         \"\"\"\n         mask = input_ids == mm_token_id\n-        start_positions = (mask & ~torch.roll(mask, 1)).nonzero(as_tuple=True)[0]\n-        end_positions = (mask & ~torch.roll(mask, -1)).nonzero(as_tuple=True)[0]\n+        if mask.numel() == 0:\n+            return []\n+        padded = torch.nn.functional.pad(mask, (1, 1), value=False)\n+        start_positions = (mask & ~padded[:-2]).nonzero(as_tuple=True)[0]\n+        end_positions = (mask & ~padded[2:]).nonzero(as_tuple=True)[0]\n         return list(zip(start_positions.tolist(), end_positions.tolist()))\n \n     @staticmethod",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2daaff0492c8b167532b5829d674ad28d31ac806/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "sha": "7ae62a24e1570d57aa2612c10ce1ff10a0335e24",
      "status": "modified"
    },
    {
      "additions": 23,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2daaff0492c8b167532b5829d674ad28d31ac806/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_image_decode.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_image_decode.py?ref=2daaff0492c8b167532b5829d674ad28d31ac806",
      "deletions": 0,
      "filename": "test/registered/unit/multimodal/test_base_processor_image_decode.py",
      "patch": "@@ -214,5 +214,28 @@ def __init__(self, *, sample_format, apply_exif_orientation):\n         self.assertFalse(pool._decode_params.apply_exif_orientation)\n \n \n+class TestGetMmItemsOffset(CustomTestCase):\n+    def test_boundary_spans_do_not_wrap_around(self):\n+        \"\"\"Spans touching both ends of input_ids must not merge across the boundary.\"\"\"\n+        for ids, expected in (\n+            ([], []),\n+            ([1, 2, 4], []),\n+            ([3], [(0, 0)]),\n+            ([3, 3, 3], [(0, 2)]),\n+            ([3, 3, 1, 2, 3, 3], [(0, 1), (4, 5)]),\n+            ([3, 1, 3], [(0, 0), (2, 2)]),\n+            ([1, 2, 3, 3, 3, 4, 3, 3], [(2, 4), (6, 7)]),\n+            ([3, 3, 1, 3, 2], [(0, 1), (3, 3)]),\n+        ):\n+            with self.subTest(ids=ids):\n+                tensor_ids = torch.tensor(ids, dtype=torch.long)\n+                self.assertEqual(\n+                    BaseMultimodalProcessor.get_mm_items_offset(\n+                        input_ids=tensor_ids, mm_token_id=3\n+                    ),\n+                    expected,\n+                )\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2daaff0492c8b167532b5829d674ad28d31ac806/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_image_decode.py",
      "sha": "54fa29e619817d2a73fda167ca055aeb6e691668",
      "status": "modified"
    }
