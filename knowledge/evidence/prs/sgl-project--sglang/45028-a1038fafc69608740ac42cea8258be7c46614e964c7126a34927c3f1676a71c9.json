      "changes": 27,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fextend_attention.py?ref=34b5d72eb1d4bc4ef4935fd60d8d6f4c5550286a",
      "deletions": 0,
      "filename": "python/sglang/kernels/ops/attention/extend_attention.py",
      "patch": "@@ -17,6 +17,7 @@\n \"\"\"\n \n import math\n+import os\n from typing import Optional\n \n import torch\n@@ -949,6 +950,32 @@ def extend_attention_fwd(\n         _get_block_sizes_for_extend_attention(Lq, Lv)\n     )\n \n+    if (\n+        os.environ.get(\"MUSE_DFLASH_SMALL_QUERY_TILE\", \"0\") == \"1\"\n+        and _is_gfx95\n+        and Lq == 128\n+        and Lk == 128\n+        and Lv == 128\n+        and head_num == 8\n+        and k_extend.shape[1] == 1\n+        and max_len_extend == 8\n+        and q_extend.shape[0] == batch_size * 8\n+        and not is_causal\n+        and sliding_window_size == 2048\n+        and q_extend.dtype == torch.bfloat16\n+        and k_extend.dtype == v_extend.dtype == torch.bfloat16\n+        and k_buffer.dtype == v_buffer.dtype == torch.float8_e4m3fn\n+        and custom_mask is None\n+        and sinks is None\n+        and logit_cap <= 0\n+        and xai_temperature_len <= 0\n+        and score_mod is None\n+        and aux_tensors is None\n+    ):\n+        # TP8 DFlash has only eight query rows. Preserve the original N tile\n+        # and mixed BF16/FP8 arithmetic while avoiding the 64-row query tile.\n+        BLOCK_M, BLOCK_N, num_warps = 16, 64, 4\n+\n     USE_CUSTOM_MASK = custom_mask is not None\n     # Skip custom mask for prefix part\n     SKIP_PREFIX_CUSTOM_MASK = skip_prefix_custom_mask",
      "raw_url": "https://github.com/sgl-project/sglang/raw/34b5d72eb1d4bc4ef4935fd60d8d6f4c5550286a/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fextend_attention.py",
