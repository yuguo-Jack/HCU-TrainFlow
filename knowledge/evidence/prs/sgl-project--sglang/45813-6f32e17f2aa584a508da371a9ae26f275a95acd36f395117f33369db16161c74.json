      "blob_url": "https://github.com/sgl-project/sglang/blob/8ebe947bddc62df740a6faa40d629dbecb4efe1d/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_policy.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_policy.py?ref=8ebe947bddc62df740a6faa40d629dbecb4efe1d",
      "deletions": 3,
      "filename": "python/sglang/srt/managers/schedule_policy.py",
      "patch": "@@ -1694,11 +1694,13 @@ def preempt_to_schedule(self, req: Req) -> bool:\n             return False\n \n         # Preempt running requests. Release allocated resources for immediate usage.\n-        preemptible_reqs = set(preemptible_reqs)\n+        # The set is for membership only: its iteration order follows object ids,\n+        # which can differ across TP ranks.\n+        preemptible_set = set(preemptible_reqs)\n         keep_indices = []\n         release_counter = 0\n         for i, running_req in enumerate(self.running_batch.reqs):\n-            if running_req in preemptible_reqs:\n+            if running_req in preemptible_set:\n                 self.memory_budget.total_offset -= (\n                     self._get_running_request_total_token_offset(running_req)\n                 )\n@@ -1709,5 +1711,7 @@ def preempt_to_schedule(self, req: Req) -> bool:\n             else:\n                 keep_indices.append(i)\n         self.running_batch.filter_batch(keep_indices=keep_indices)\n-        self.preempt_list.extend(preemptible_reqs)\n+        # Requeue in the reverse of the selection order (preferred priority, then oldest\n+        # first), so the new wait_queue_entry_time stamps keep the victims' order.\n+        self.preempt_list.extend(reversed(preemptible_reqs))\n         return True",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8ebe947bddc62df740a6faa40d629dbecb4efe1d/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_policy.py",
      "sha": "618e98bdbb7308f92b295cd5f6966d16f0568be3",
      "status": "modified"
    },
    {
      "additions": 39,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8ebe947bddc62df740a6faa40d629dbecb4efe1d/test%2Fregistered%2Funit%2Fmanagers%2Ftest_prefill_adder.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_prefill_adder.py?ref=8ebe947bddc62df740a6faa40d629dbecb4efe1d",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_prefill_adder.py",
      "patch": "@@ -683,6 +683,45 @@ def test_preempt_fail_high_priority_values_first(self):\n         )\n         self.assertFalse(success_by_capacity_check)\n \n+    def test_preempt_list_order_independent_of_req_hashes(self):\n+        \"\"\"Several victims are requeued in waiting-queue order on every TP rank:\n+        Req hashes by object id, so set order could differ between ranks.\"\"\"\n+        # (rid, importance, wait_queue_entry_time); all five must go to fit new_req.\n+        params = [\n+            (\"c\", 0, 2.0),\n+            (\"a\", 1, 0.0),\n+            (\"e\", 0, 4.0),\n+            (\"b\", 1, 1.0),\n+            (\"d\", 0, 3.0),\n+        ]\n+        for low_first in (False, True):\n+            self.scheduling_order(schedule_low_priority_values_first=low_first)\n+            sign = -1 if low_first else 1\n+            for hashes in ([1, 2, 3, 4, 5], [5, 4, 3, 2, 1]):\n+                with self.subTest(low_first=low_first, hashes=hashes):\n+                    running_reqs = []\n+                    for (rid, importance, wait_time), h in zip(params, hashes):\n+                        req = self.create_mock_req(\n+                            rid,\n+                            sign * importance,\n+                            max_new_tokens=10,\n+                            wait_time=wait_time,\n+                        )\n+                        req.__hash__.return_value = h\n+                        running_reqs.append(req)\n+                    adder = self.create_adder(self.create_running_batch(running_reqs))\n+                    self.mock_token_allocator.full_available_size.return_value = 50\n+                    self.mock_token_allocator.available_size.return_value = 50\n+\n+                    new_req = self.create_mock_req(\n+                        \"new\", priority=sign * 2, max_new_tokens=50\n+                    )\n+                    self.assertTrue(adder.preempt_to_schedule(new_req))\n+                    # More important first, then the earliest queued.\n+                    self.assertEqual(\n+                        [r.rid for r in adder.preempt_list], [\"a\", \"b\", \"c\", \"d\", \"e\"]\n+                    )\n+\n     def test_preempt_skip_already_preempted_request(self):\n         params = [\n             (\"req_prio_0\", 0, 50),",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8ebe947bddc62df740a6faa40d629dbecb4efe1d/test%2Fregistered%2Funit%2Fmanagers%2Ftest_prefill_adder.py",
      "sha": "5e2ddc5c906b322e3a08bca9d95f070fc79a0af6",
      "status": "modified"
    }
