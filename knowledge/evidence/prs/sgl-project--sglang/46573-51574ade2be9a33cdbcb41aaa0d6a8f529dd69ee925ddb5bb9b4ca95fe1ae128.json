  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/08b0f6dedccd4542c47e75190c2d14da798df4e3/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fsparse_decode_reduce_hip.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fsparse_decode_reduce_hip.py?ref=08b0f6dedccd4542c47e75190c2d14da798df4e3",
      "deletions": 1,
      "filename": "python/sglang/kernels/ops/attention/sparse_decode_reduce_hip.py",
      "patch": "@@ -63,7 +63,10 @@ def _gfx_sparse_decode_reduce_kernel(\n         w = tl.exp2(m_s - m_final)\n         # gluon contracts l + w * l_s into one fma; Triton leaves the scalar chain as mul + add\n         l_final = tl.fma(w, l_s, l_final)\n-        acc_s = tl.load(part_acc_ptr + pa_base + s * pa_stride_s + d)\n+        # aiter retires surplus splits with m = -inf and leaves their part_acc unwritten\n+        acc_s = tl.load(\n+            part_acc_ptr + pa_base + s * pa_stride_s + d, mask=m_s > neg_inf, other=0.0\n+        )\n         acc = tl.fma(w, acc_s, acc)\n     if HAS_SINK:\n         l_final = l_final + tl.exp2(sink * RCP_LN2 - m_final)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/08b0f6dedccd4542c47e75190c2d14da798df4e3/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fsparse_decode_reduce_hip.py",
      "sha": "78d99efafe2f49fe0a4a9930ef7a7c42d556eb4a",
      "status": "modified"
    },
    {
      "additions": 39,
      "blob_url": "https://github.com/sgl-project/sglang/blob/08b0f6dedccd4542c47e75190c2d14da798df4e3/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_sparse_decode_reduce_hip.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_sparse_decode_reduce_hip.py?ref=08b0f6dedccd4542c47e75190c2d14da798df4e3",
      "deletions": 0,
      "filename": "test/registered/kernels/ops/attention/test_sparse_decode_reduce_hip.py",
      "patch": "@@ -0,0 +1,39 @@\n+\"\"\"`gfx_sparse_split_reduce` ignores splits that pa_decode_sparse retired (m = -inf, part_acc unwritten).\"\"\"\n+\n+import unittest\n+\n+import torch\n+\n+from sglang.kernels.ops.attention.sparse_decode_reduce_hip import (\n+    gfx_sparse_split_reduce,\n+)\n+from sglang.srt.utils import is_hip\n+from sglang.test.ci.ci_register import register_amd_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_amd_ci(est_time=5, stage=\"stage-b\", runner_config=\"1-gpu-small-amd-mi35x\")\n+\n+\n+@unittest.skipUnless(is_hip(), \"HIP split reduce\")\n+class TestSparseDecodeReduceHip(CustomTestCase):\n+    def test_retired_splits_do_not_change_the_output(self):\n+        torch.manual_seed(0)\n+        T, S, H, D, live = 3, 4, 16, 512, 2\n+        part_m = torch.randn(T, S, H, device=\"cuda\")\n+        part_l = torch.rand(T, S, H, device=\"cuda\") + 0.5\n+        part_acc = torch.randn(T, S, H, D, device=\"cuda\")\n+        sink = torch.randn(H, device=\"cuda\")\n+        want = gfx_sparse_split_reduce(\n+            part_acc[:, :live].contiguous(),\n+            part_m[:, :live].contiguous(),\n+            part_l[:, :live].contiguous(),\n+            sink,\n+        )\n+        part_m[:, live:], part_l[:, live:] = float(\"-inf\"), 0.0\n+        part_acc[:, live:] = float(\"nan\")\n+        got = gfx_sparse_split_reduce(part_acc, part_m, part_l, sink)\n+        self.assertTrue(torch.equal(got, want))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/08b0f6dedccd4542c47e75190c2d14da798df4e3/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_sparse_decode_reduce_hip.py",
      "sha": "5323f038c84bf5ff9df2af323f373bedc070e6b3",
      "status": "added"
    }
  ],
  "inline_comments": [],
  "issue_comments": [
    {
