      "changes": 29,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fapps%2FComfyUI_SGLDiffusion%2Fcore%2Fgenerator.py?ref=1b129c99add809ee4b79f6612a76585523d5a1fc",
      "deletions": 5,
      "filename": "python/sglang/multimodal_gen/apps/ComfyUI_SGLDiffusion/core/generator.py",
      "patch": "@@ -3,8 +3,10 @@\n \"\"\"\n \n import atexit\n+import contextlib\n import logging\n import os\n+import sys\n \n from ..executors.flux import FluxExecutor\n from ..executors.minimax_h3 import MiniMaxH3Executor\n@@ -14,6 +16,22 @@\n logger = logging.getLogger(__name__)\n \n \n+@contextlib.contextmanager\n+def _spawn_without_host_main():\n+    # Spawned workers re-import __main__ from its file; under ComfyUI that is\n+    # main.py, which fails in the child because comfy/ is first on sys.path.\n+    main = sys.modules[\"__main__\"]\n+    saved_file = main.__dict__.pop(\"__file__\", None)\n+    saved_spec = main.__spec__\n+    main.__spec__ = None\n+    try:\n+        yield\n+    finally:\n+        main.__spec__ = saved_spec\n+        if saved_file is not None:\n+            main.__file__ = saved_file\n+\n+\n class _HeaderTensor:\n     \"\"\"Shape-only stand-in so detect_unet_config does not load 66GB weights.\"\"\"\n \n@@ -212,11 +230,12 @@ def init_generator(\n             kwargs.setdefault(\"cfg_parallel_degree\", 1)\n         kwargs = self._server_args_kwargs(kwargs)\n         try:\n-            self.generator = DiffGenerator.from_pretrained(\n-                model_path=model_path,\n-                pipeline_class_name=pipeline_class_name,\n-                **kwargs,\n-            )\n+            with _spawn_without_host_main():\n+                self.generator = DiffGenerator.from_pretrained(\n+                    model_path=model_path,\n+                    pipeline_class_name=pipeline_class_name,\n+                    **kwargs,\n+                )\n         except EOFError as error:\n             # A worker that raises while loading closes its pipe without a message.\n             raise RuntimeError(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1b129c99add809ee4b79f6612a76585523d5a1fc/python%2Fsglang%2Fmultimodal_gen%2Fapps%2FComfyUI_SGLDiffusion%2Fcore%2Fgenerator.py",
      "sha": "c1b964db6bcd4a4cee8b14a130522340e01f6bb8",
