  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5f5de69818dc2217267915cf5078f937935f6b98/python%2Fsglang%2Fsrt%2Fmultimodal%2Fmm_utils.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fmm_utils.py?ref=5f5de69818dc2217267915cf5078f937935f6b98",
      "deletions": 2,
      "filename": "python/sglang/srt/multimodal/mm_utils.py",
      "patch": "@@ -324,11 +324,15 @@ def load_image_from_base64(image):\n \n \n def expand2square(pil_img, background_color):\n+    \"\"\"Pad an image to a square, returning RGB.\"\"\"\n     width, height = pil_img.size\n+    if pil_img.mode != \"RGB\":\n+        # Image processors expect three channels. The previous \"L\"-only\n+        # conversion was skipped entirely for square inputs, and LA/I;16/1\n+        # raised TypeError from Image.new because the background is a 3-tuple.\n+        pil_img = pil_img.convert(\"RGB\")\n     if width == height:\n         return pil_img\n-    if pil_img.mode == \"L\":\n-        pil_img = pil_img.convert(\"RGB\")\n     if width > height:\n         result = Image.new(pil_img.mode, (width, width), background_color)\n         result.paste(pil_img, (0, (width - height) // 2))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5f5de69818dc2217267915cf5078f937935f6b98/python%2Fsglang%2Fsrt%2Fmultimodal%2Fmm_utils.py",
      "sha": "883b05f1e640ca3ece99d57e7ba66370bd62b5ca",
      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5f5de69818dc2217267915cf5078f937935f6b98/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_expand2square_modes.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_expand2square_modes.py?ref=5f5de69818dc2217267915cf5078f937935f6b98",
      "deletions": 0,
      "filename": "test/registered/unit/multimodal/test_expand2square_modes.py",
      "patch": "@@ -0,0 +1,33 @@\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+import pytest\n+from PIL import Image\n+\n+from sglang.srt.multimodal.mm_utils import expand2square\n+\n+MODES = [\"RGB\", \"L\", \"LA\", \"RGBA\", \"P\", \"CMYK\", \"I;16\", \"1\"]\n+\n+\n+@pytest.mark.parametrize(\"mode\", MODES)\n+@pytest.mark.parametrize(\"size\", [(64, 32), (64, 64)])\n+def test_expand2square_returns_rgb(mode, size):\n+    \"\"\"Every PIL mode must come back as RGB, including square inputs.\n+\n+    Square inputs used to return early, so even the old \"L\"-only conversion was\n+    skipped; LA/I;16/1 raised TypeError from Image.new because the background is\n+    a 3-tuple, and P stayed paletted.\n+    \"\"\"\n+    image = Image.new(mode, size, 128)\n+    out = expand2square(image, (127, 127, 127))\n+    assert out.mode == \"RGB\"\n+    side = max(size)\n+    assert out.size == (side, side)\n+\n+\n+def test_expand2square_pads_with_background():\n+    image = Image.new(\"L\", (4, 2), 255)\n+    out = expand2square(image, (10, 20, 30))\n+    assert out.getpixel((0, 0)) == (10, 20, 30)\n+    assert out.getpixel((2, 1)) == (255, 255, 255)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5f5de69818dc2217267915cf5078f937935f6b98/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_expand2square_modes.py",
      "sha": "d6d5909f518f82227a8d6a5c1fdcfbac6ac17415",
      "status": "added"
    }
  ],
