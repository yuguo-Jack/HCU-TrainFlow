      "filename": "python/sglang/srt/models/qwen3_moe.py",
      "patch": "@@ -338,10 +338,20 @@ def forward_normal(\n         num_tokens, hidden_dim = hidden_states.shape\n         hidden_states = hidden_states.view(-1, hidden_dim)\n \n+        dispatch_info = (\n+            ExpertLocationDispatchInfo.init_new(layer_id=self.layer_id)\n+            if get_exec().moe.enable_eplb\n+            else None\n+        )\n+\n         if hidden_states.shape[0] > 0:\n             # router_logits: (num_tokens, n_experts)\n             router_logits, _ = self.gate(hidden_states)\n-            topk_output = self.topk(hidden_states, router_logits)\n+            topk_output = self.topk(\n+                hidden_states,\n+                router_logits,\n+                expert_location_dispatch_info=dispatch_info,\n+            )\n         else:\n             topk_output = self.topk.empty_topk_output(hidden_states.device)\n         final_hidden_states = self.experts(hidden_states, topk_output)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/79cc442b26f9bd90d8ab329010cd3706967260cc/python%2Fsglang%2Fsrt%2Fmodels%2Fqwen3_moe.py",
