      "blob_url": "https://github.com/sgl-project/sglang/blob/45d7edf8fffc76f68630dc519f27d481bd4de10d/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py",
      "changes": 43,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py?ref=45d7edf8fffc76f68630dc519f27d481bd4de10d",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_function_call_parser.py",
      "patch": "@@ -3310,6 +3310,49 @@ def test_parse_arguments_object_with_invalid_escape(self):\n         self.assertIsInstance(value, dict)\n         self.assertEqual(value, {\"pattern\": \"\\\\d+\"})\n \n+    def test_anyof_string_null_preserves_json_null(self):\n+        \"\"\"anyOf[string,null] with bare null must not become the string 'None'.\"\"\"\n+        tools = [\n+            Tool(\n+                type=\"function\",\n+                function=Function(\n+                    name=\"api_fetch\",\n+                    parameters={\n+                        \"type\": \"object\",\n+                        \"properties\": {\n+                            \"body\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}]},\n+                            \"params\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}]},\n+                            \"method\": {\"type\": \"string\"},\n+                            \"url\": {\"type\": \"string\"},\n+                        },\n+                        \"required\": [\"method\", \"url\", \"params\", \"body\"],\n+                    },\n+                ),\n+            )\n+        ]\n+        text = (\n+            \"<tool_call>api_fetch\\n\"\n+            \"<arg_key>body</arg_key>\\n<arg_value>null</arg_value>\\n\"\n+            \"<arg_key>method</arg_key>\\n<arg_value>GET</arg_value>\\n\"\n+            \"<arg_key>params</arg_key>\\n<arg_value>null</arg_value>\\n\"\n+            \"<arg_key>url</arg_key>\\n<arg_value>https://example.com</arg_value>\\n\"\n+            \"</tool_call>\"\n+        )\n+        calls = self.detector.detect_and_parse(text, tools).calls\n+        self.assertEqual(len(calls), 1)\n+        args = json.loads(calls[0].parameters)\n+        self.assertEqual(\n+            args,\n+            {\n+                \"body\": None,\n+                \"params\": None,\n+                \"method\": \"GET\",\n+                \"url\": \"https://example.com\",\n+            },\n+        )\n+        self.assertIsNone(args[\"body\"])\n+        self.assertIsNone(args[\"params\"])\n+\n \n class TestGlm47MoeDetector(unittest.TestCase):\n     def setUp(self):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/45d7edf8fffc76f68630dc519f27d481bd4de10d/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py",
