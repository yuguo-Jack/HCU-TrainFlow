    {
      "additions": 37,
      "blob_url": "https://github.com/sgl-project/sglang/blob/94867e8a2316f2adee4cd2c54b30b2b469556f55/python%2Fsglang%2Fsrt%2Futils%2Fhost_shared_memory.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fhost_shared_memory.py?ref=94867e8a2316f2adee4cd2c54b30b2b469556f55",
      "deletions": 1,
      "filename": "python/sglang/srt/utils/host_shared_memory.py",
      "patch": "@@ -30,7 +30,6 @@ def _malloc_raw(self, *, num_bytes: int) -> torch.Tensor:\n         self._operation_index += 1\n         shm_name = f\"{self._base_name}_op{self._operation_index}\"\n \n-        # TODO handle dispose\n         if get_naive_distributed().get_rank() == 0:\n             shm = shared_memory.SharedMemory(name=shm_name, create=True, size=num_bytes)\n \n@@ -59,6 +58,36 @@ def _malloc_raw(self, *, num_bytes: int) -> torch.Tensor:\n         )\n         return tensor\n \n+    def dispose(self):\n+        import cuda.bindings.runtime as cuda_rt\n+\n+        for record in self._records:\n+            # Unregister cuda host memory\n+            try:\n+                check_cuda_result(cuda_rt.cudaHostUnregister(record.tensor.data_ptr()))\n+            except Exception as e:\n+                logger.warning(\n+                    f\"Failed to cudaHostUnregister in HostSharedMemoryManager: {e}\"\n+                )\n+\n+            # Close shared memory\n+            try:\n+                record.shm.close()\n+            except Exception as e:\n+                logger.warning(\n+                    f\"Failed to close shared memory in HostSharedMemoryManager: {e}\"\n+                )\n+\n+            # Unlink shared memory\n+            try:\n+                if get_naive_distributed().get_rank() == 0:\n+                    record.shm.unlink()\n+            except Exception:\n+                # Ignore unlink failures (e.g. already unlinked)\n+                pass\n+\n+        self._records.clear()\n+\n \n @dataclass\n class _Record:\n@@ -80,3 +109,10 @@ def set_host_shared_memory_manager(instance: HostSharedMemoryManager):\n     global _instance\n     assert _instance is None\n     _instance = instance\n+\n+\n+def dispose_host_shared_memory_manager():\n+    global _instance\n+    if _instance is not None:\n+        _instance.dispose()\n+        _instance = None",
      "raw_url": "https://github.com/sgl-project/sglang/raw/94867e8a2316f2adee4cd2c54b30b2b469556f55/python%2Fsglang%2Fsrt%2Futils%2Fhost_shared_memory.py",
      "sha": "26cdff5a46f8fd87129c90f1aaf154e6cf7e074b",
