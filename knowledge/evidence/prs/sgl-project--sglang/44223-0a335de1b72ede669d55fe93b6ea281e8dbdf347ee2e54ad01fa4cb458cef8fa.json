      "changes": 1,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmanagers%2Fmemory_managers%2Flayerwise_offload.py?ref=7b8581c16f087762e262169fbb34a4374fa5a178",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/runtime/managers/memory_managers/layerwise_offload.py",
      "patch": "@@ -191,6 +191,7 @@ def restore_host_resident_tables(\n ) -> None:\n     for module, data in detached:\n         module.weight.data = data\n+        module.to(\"cpu\")\n         _install_host_gather_hooks(module, device)\n         logger.info(\n             \"Keeping %s (%.2f GiB) in host memory: a gather reads one row per \"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7b8581c16f087762e262169fbb34a4374fa5a178/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmanagers%2Fmemory_managers%2Flayerwise_offload.py",
