  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9a00dbb9f217c507351654e5bba5ee63fe97bc14/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fipc_array.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fipc_array.py?ref=9a00dbb9f217c507351654e5bba5ee63fe97bc14",
      "deletions": 1,
      "filename": "python/sglang/multimodal_gen/runtime/ipc_array.py",
      "patch": "@@ -30,7 +30,10 @@ class NumpyArrayFileRef:\n \n     def materialize(self) -> np.ndarray:\n         try:\n-            return np.load(self.path, allow_pickle=False)\n+            # Map the spill rather than copying it. The mapping outlives the\n+            # unlink below, and copy-on-write keeps the result writable without\n+            # touching the file.\n+            return np.asarray(np.load(self.path, allow_pickle=False, mmap_mode=\"c\"))\n         finally:\n             try:\n                 os.unlink(self.path)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9a00dbb9f217c507351654e5bba5ee63fe97bc14/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fipc_array.py",
      "sha": "4d5cb1033478e090e69727c8efb433a1910f8a8c",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9a00dbb9f217c507351654e5bba5ee63fe97bc14/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_ipc_array.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_ipc_array.py?ref=9a00dbb9f217c507351654e5bba5ee63fe97bc14",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_ipc_array.py",
      "patch": "@@ -43,6 +43,21 @@ def test_spill_large_arrays_round_trips_and_removes_file(ipc_request):\n     assert not spilled_path.exists()\n \n \n+def test_materialized_spill_is_a_writable_mapping(ipc_request):\n+    array = np.arange(ipc_array._MIN_FILE_REF_BYTES, dtype=np.uint8)\n+    spilled = spill_large_arrays_to_file_refs(array, ipc_request)\n+    spilled_path = Path(spilled.path)\n+\n+    materialized = materialize_file_refs(spilled)\n+\n+    assert type(materialized) is np.ndarray\n+    assert isinstance(materialized.base, np.memmap)\n+    assert not spilled_path.exists()\n+    materialized[0] = 255\n+    assert materialized[0] == 255\n+    assert np.array_equal(materialized[1:], array[1:])\n+\n+\n def test_small_arrays_are_kept_inline(ipc_request):\n     array = np.arange(16, dtype=np.uint8)\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9a00dbb9f217c507351654e5bba5ee63fe97bc14/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_ipc_array.py",
      "sha": "a5825c8a02c1b86833d421ec22a881deb2c28c7c",
      "status": "modified"
    }
