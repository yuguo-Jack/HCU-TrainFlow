      "blob_url": "https://github.com/sgl-project/sglang/blob/d4ab5476f066dabd184868f9efa30585e07a6aca/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fdecode.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fdecode.py?ref=d4ab5476f066dabd184868f9efa30585e07a6aca",
      "deletions": 6,
      "filename": "python/sglang/srt/disaggregation/decode.py",
      "patch": "@@ -2732,6 +2732,9 @@ def _init_staging_handler(self, kv_manager):\n         kv_manager._staging_handler = self.staging_handler\n \n     def _release_request(self, decode_req: DecodeRequest) -> None:\n+        # HiSparse host pages are the transfer destination; free them with the KV.\n+        if self.scheduler.enable_hisparse:\n+            self.scheduler.hisparse_coordinator.request_finished(decode_req.req)\n         if self.enable_host_receive:\n             discard_kv_cache_backup(decode_req.req, self.tree_cache, \"host_pool\")\n             if decode_req.host_staged:\n@@ -2806,8 +2809,6 @@ def pop_transferred(self, rids_to_check: Optional[List[str]] = None) -> List[Req\n                     [decode_req.req],\n                     decode_req.req.return_logprob,\n                 )\n-                if self.scheduler.enable_hisparse:\n-                    self.scheduler.hisparse_coordinator.request_finished(decode_req.req)\n                 requires_host_drain = (\n                     self.enable_host_receive and decode_req.host_staged\n                 )\n@@ -2864,10 +2865,6 @@ def pop_transferred(self, rids_to_check: Optional[List[str]] = None) -> List[Req\n                         [decode_req.req],\n                         decode_req.req.return_logprob,\n                     )\n-                    if self.scheduler.enable_hisparse:\n-                        self.scheduler.hisparse_coordinator.request_finished(\n-                            decode_req.req\n-                        )\n                     self._clean_hicache_prefetch_resources(decode_req)\n                     self._release_request(decode_req)\n                     self._record_transfer_failure(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d4ab5476f066dabd184868f9efa30585e07a6aca/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fdecode.py",
      "sha": "75b144497d0bab9c3eb7859aeab6bdc33df99086",
      "status": "modified"
    },
    {
      "additions": 53,
      "blob_url": "https://github.com/sgl-project/sglang/blob/d4ab5476f066dabd184868f9efa30585e07a6aca/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_deferred_decode_kv_release.py",
      "changes": 53,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_deferred_decode_kv_release.py?ref=d4ab5476f066dabd184868f9efa30585e07a6aca",
      "deletions": 0,
      "filename": "test/registered/unit/disaggregation/test_deferred_decode_kv_release.py",
      "patch": "@@ -669,6 +669,7 @@ def _make_queue(timeout=30.0, enable_metrics=False):\n     q.metadata_buffers = SimpleNamespace(bootstrap_room={})\n     q.req_to_metadata_buffer_idx_allocator = _FakeIdxAllocator()\n     q.scheduler = SimpleNamespace(\n+        enable_hisparse=False,\n         metrics_reporter=SimpleNamespace(enable_metrics=enable_metrics),\n         metrics_collector=SimpleNamespace(\n             observe_decode_deferred_kv_release=MagicMock()\n@@ -976,6 +977,58 @@ def test_backend_optout_keeps_immediate_release_and_sends_no_abort(self):\n         self.assertEqual(q._deferred_releases, [])\n \n \n+class TestHiSparseDestinationFollowsTheHold(CustomTestCase):\n+    \"\"\"Under HiSparse the transfer writes into the coordinator's host pages.\"\"\"\n+\n+    def _queue(self, mgr, log):\n+        q = _make_pop_queue(mgr)\n+        q.scheduler.enable_hisparse = True\n+        q.scheduler.hisparse_coordinator = SimpleNamespace(\n+            request_finished=lambda req: log.append((\"hisparse\", req.rid))\n+        )\n+        return q\n+\n+    def _pop_and_resolve(self, q, mgr, room, log):\n+        release = lambda req, *args, **kwargs: log.append((\"kv\", req.rid))\n+        with (\n+            patch.object(decode_mod, \"prepare_abort\"),\n+            patch.object(decode_mod, \"release_kv_cache\", side_effect=release),\n+        ):\n+            q.pop_transferred()\n+            at_failure = list(log)\n+            generation = mgr.register_deferred_abort_room(room)\n+            for prefill_rank in (0, 1):\n+                mgr.note_abort_ack(room, prefill_rank, generation)\n+            q.resolve_deferred_releases()\n+        return at_failure\n+\n+    def test_deferred_failure_keeps_the_destination_until_release(self):\n+        mgr = _make_manager()\n+        log = []\n+        q = self._queue(mgr, log)\n+        q.queue = [_make_failed_req(mgr, room=12, idx=6, abort_notified=False)]\n+\n+        at_failure = self._pop_and_resolve(q, mgr, 12, log)\n+\n+        self.assertEqual(at_failure, [])\n+        self.assertEqual(log, [(\"hisparse\", \"r12\"), (\"kv\", \"r12\")])\n+\n+    def test_immediate_failure_frees_the_destination_once(self):\n+        mgr = _make_manager()\n+        log = []\n+        q = self._queue(mgr, log)\n+        q.queue = [\n+            _make_failed_req(\n+                mgr, room=13, idx=7, abort_notified=False, notifiable=False\n+            )\n+        ]\n+\n+        at_failure = self._pop_and_resolve(q, mgr, 13, log)\n+\n+        self.assertEqual(at_failure, [(\"hisparse\", \"r13\"), (\"kv\", \"r13\")])\n+        self.assertEqual(log, at_failure)\n+\n+\n class TestBackendOptIn(CustomTestCase):\n     \"\"\"Without a prefill ack, every hold waits out the full release timeout.\"\"\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d4ab5476f066dabd184868f9efa30585e07a6aca/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_deferred_decode_kv_release.py",
