      "patch": "@@ -64,6 +64,10 @@ on:\n         type: string\n         default: '{}'\n         description: 'JSON run metadata {branch_label, workflow_name, create_time}, recorded once at workflow start'\n+      is_nightly_pipeline_job:\n+        description: 'Enable the temporary torch_npu trace-rule workaround inside the test pods'\n+        type: boolean\n+        default: false\n \n concurrency:\n   group: ascend-nightly-multi-node-${{ github.workflow_ref }}-${{ github.ref }}-${{ inputs.test_config_name }}\n@@ -99,6 +103,8 @@ jobs:\n         uses: actions/checkout@v4\n \n       - name: Prepare code for testing\n+        env:\n+          IS_NIGHTLY_PIPELINE_JOB: ${{ inputs.is_nightly_pipeline_job }}\n         run: |\n           # copy source code to shared-disk\n           # Append run_id to isolate concurrent runs sharing the same PVC.\n@@ -107,6 +113,12 @@ jobs:\n           rm -rf ${target_path}\n           mkdir -p ${target_path}\n           cp -r ${current_path}/* ${target_path}/\n+          # Temporary workaround for the CANN 9.2 nightly images.\n+          # The pods mount this directory at /root/sglang, so this marker is how\n+          # run_npu_testcase.sh knows the torch_npu trace-rule patch is enabled.\n+          if [ \"${IS_NIGHTLY_PIPELINE_JOB}\" = \"true\" ]; then\n+            touch ${target_path}/.patch_torch_npu_trace_rule\n+          fi\n \n       - name: Clear resources\n         run: |",
