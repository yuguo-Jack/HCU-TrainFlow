      "blob_url": "https://github.com/sgl-project/sglang/blob/dc96079d552c1d536db9e1788ab277aba2f302bb/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_splitkv.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_splitkv.py?ref=dc96079d552c1d536db9e1788ab277aba2f302bb",
      "deletions": 3,
      "filename": "python/sglang/kernels/ops/attention/verify_splitkv.py",
      "patch": "@@ -336,7 +336,8 @@ def _verify_combine_stage2(\n         other=float(\"-inf\"),\n     )  # [N_SPLITS, L_EXT]\n     m_p = tl.max(lse, 0)  # [L_EXT]\n-    w = tl.exp(lse - m_p[None, :])  # [N_SPLITS, L_EXT]; -inf->0\n+    safe_max = tl.where(m_p == float(\"-inf\"), 0.0, m_p)\n+    w = tl.exp(lse - safe_max[None, :])  # Empty splits contribute zero.\n     denom_p = tl.sum(w, 0)  # [L_EXT]\n \n     # weighted-sum of partial outputs: o_prefix[L_EXT, Dv]\n@@ -350,11 +351,13 @@ def _verify_combine_stage2(\n     )\n     ao = tl.load(\n         offs_ao + Att_Out,\n-        mask=mask_l[None, :, None] & (offs_dv[None, None, :] < V_HEAD_DIM),\n+        mask=mask_l[None, :, None]\n+        & (offs_dv[None, None, :] < V_HEAD_DIM)\n+        & (lse[:, :, None] != float(\"-inf\")),\n         other=0.0,\n     )  # [N_SPLITS, L_EXT, Dv]\n     o_prefix = tl.sum(ao * w[:, :, None], 0)  # [L_EXT, Dv]\n-    o_prefix = o_prefix / denom_p[:, None]\n+    o_prefix = o_prefix / tl.where(denom_p > 0, denom_p, 1.0)[:, None]\n     lse_prefix = m_p + tl.log(denom_p)  # [L_EXT]\n \n     # ---- (b) draft-draft causal attention (L_EXT x L_EXT) -----------------",
      "raw_url": "https://github.com/sgl-project/sglang/raw/dc96079d552c1d536db9e1788ab277aba2f302bb/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fverify_splitkv.py",
      "sha": "91226bd82a0b4c28bf83078e5132f1fdbb037a8a",
      "status": "modified"
    },
    {
      "additions": 35,
      "blob_url": "https://github.com/sgl-project/sglang/blob/dc96079d552c1d536db9e1788ab277aba2f302bb/test%2Fregistered%2Fattention%2Ftest_verify_splitkv.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fattention%2Ftest_verify_splitkv.py?ref=dc96079d552c1d536db9e1788ab277aba2f302bb",
      "deletions": 0,
      "filename": "test/registered/attention/test_verify_splitkv.py",
      "patch": "@@ -82,6 +82,41 @@ def _build_verify_inputs(\n \n @unittest.skipIf(not torch.cuda.is_available(), \"GPU required\")\n class TestVerifySplitKV(CustomTestCase):\n+    def test_inactive_splits_ignore_poisoned_scratch(self):\n+        from sglang.kernels.ops.attention.verify_splitkv import VerifySplitKV\n+\n+        q = torch.zeros(3, 16, 256, device=\"cuda\", dtype=torch.bfloat16)\n+        k = torch.zeros(3, 8, 256, device=\"cuda\", dtype=q.dtype)\n+        v = torch.tensor([4, 6, 8], device=\"cuda\", dtype=q.dtype)\n+        v = v[:, None, None].expand_as(k).contiguous()\n+        kb = torch.zeros(1, 8, 256, device=\"cuda\", dtype=q.dtype)\n+        vb = torch.full_like(kb, 2)\n+        qo = torch.tensor([0, 3], device=\"cuda\", dtype=torch.int32)\n+        kp = torch.tensor([0, 1], device=\"cuda\", dtype=torch.int32)\n+        ids = torch.zeros(1, device=\"cuda\", dtype=torch.int64)\n+        kernel = VerifySplitKV(1, 16, 8, 256, 256, 3, n_splits=16)\n+        out = torch.empty_like(q)\n+\n+        def run():\n+            kernel(q, k, v, kb, vb, qo, kp, ids, 256**-0.5, o_out=out)\n+\n+        run()\n+        graph = torch.cuda.CUDAGraph()\n+        with torch.cuda.graph(graph):\n+            run()\n+        for prefix, expected in ((1, [3, 4, 5]), (0, [4, 5, 6])):\n+            with self.subTest(prefix=prefix):\n+                kp[1] = prefix\n+                ref = torch.tensor(expected, device=\"cuda\", dtype=q.dtype)\n+                ref = ref[:, None, None].expand_as(q)\n+                for replay in (False, True):\n+                    # Stage1 writes -inf LSE for unused splits but leaves their\n+                    # output scratch untouched. Zero times NaN is still NaN.\n+                    kernel.att_out.fill_(float(\"nan\"))\n+                    kernel.att_lse.fill_(float(\"nan\"))\n+                    graph.replay() if replay else run()\n+                    torch.testing.assert_close(out, ref, atol=0, rtol=0)\n+\n     def _run_parity(\n         self,\n         prefix_lens,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/dc96079d552c1d536db9e1788ab277aba2f302bb/test%2Fregistered%2Fattention%2Ftest_verify_splitkv.py",
      "sha": "11a578dc87288896fe048ba7437f91bc28bfc788",
      "status": "modified"
    }
