      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fparser%2Freasoning_parser.py?ref=0c563ec290aba5a022bc2ce58f49f3fef2e9a4a0",
      "deletions": 0,
      "filename": "python/sglang/srt/parser/reasoning_parser.py",
      "patch": "@@ -2157,6 +2157,16 @@ def _consume(self, flush: bool, preserve_channels: bool = False) -> Tuple[str, s\n                 if i != -1 and (end_idx == -1 or i < end_idx):\n                     end_idx, end_tok = i, tok\n \n+            # Only unframed prose can recover at a new channel marker.\n+            # Explicit answer channels can contain quoted tool headers.\n+            if self._recipient is None:\n+                next_channel = self._buffer.find(START)\n+                if next_channel != -1 and (end_idx == -1 or next_channel < end_idx):\n+                    normal_parts.append(self._buffer[:next_channel])\n+                    self._buffer = self._buffer[next_channel:]\n+                    self._in_body = False\n+                    continue\n+\n             if end_idx != -1:\n                 body = self._buffer[:end_idx]\n                 self._buffer = self._buffer[end_idx + len(end_tok) :]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0c563ec290aba5a022bc2ce58f49f3fef2e9a4a0/python%2Fsglang%2Fsrt%2Fparser%2Freasoning_parser.py",
