      "patch": "@@ -764,11 +764,15 @@ def _load_w13(\n         if self.use_padded_loading:\n             if _is_cpu and is_bias:\n                 shard_dim = 1\n+            weight_start = shard_size * self.moe_tp_rank\n+            # Pre-sharded CPU weights are rank-local; do not apply the TP offset again.\n+            if _is_cpu and self.use_presharded_weights:\n+                weight_start = 0\n             expert_data, loaded_weight = narrow_padded_param_and_loaded_weight(\n                 expert_data,\n                 loaded_weight,\n                 start,\n-                shard_size * self.moe_tp_rank,\n+                weight_start,\n                 shard_dim,\n                 shard_size,\n                 not self.use_presharded_weights,\n@@ -853,11 +857,15 @@ def _load_w2(\n         if self.use_padded_loading:\n             if _is_cpu and is_bias:\n                 shard_dim = 1\n+            weight_start = shard_size * self.moe_tp_rank\n+            # Pre-sharded CPU weights are rank-local; do not apply the TP offset again.\n+            if _is_cpu and self.use_presharded_weights:\n+                weight_start = 0\n             expert_data, loaded_weight = narrow_padded_param_and_loaded_weight(\n                 expert_data,\n                 loaded_weight,\n                 0,  # param_data_start\n-                shard_size * self.moe_tp_rank,\n+                weight_start,\n                 shard_dim,\n                 shard_size,\n                 not self.use_presharded_weights,",
