      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/6afa229a273b33906cc62d1a50ff50214b483031/docker%2FDockerfile",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docker%2FDockerfile?ref=6afa229a273b33906cc62d1a50ff50214b483031",
      "deletions": 3,
      "filename": "docker/Dockerfile",
      "patch": "@@ -631,14 +631,17 @@ RUN --mount=type=cache,target=/root/.cache/uv \\\n # SM103, compiled at runtime); disable with --build-arg ENABLE_SGL_NVIDIA_MEGA=0.\n ARG ENABLE_SGL_NVIDIA_MEGA=1\n ARG SGL_NVIDIA_MEGA_REPO=\"https://github.com/sgl-project/sgl-nvidia-mega.git\"\n-ARG SGL_NVIDIA_MEGA_COMMIT=\"54b428921749fef89fcbd043000f839ac9cc4638\"\n-RUN --mount=type=cache,target=/root/.cache/uv \\\n+# Default pin shared by both CUDA images; a build argument may override it.\n+ARG SGL_NVIDIA_MEGA_COMMIT\n+RUN --mount=type=bind,source=docker/sgl-nvidia-mega.commit,target=/tmp/sgl-nvidia-mega.commit \\\n+    --mount=type=cache,target=/root/.cache/uv \\\n     if [ \"${ENABLE_SGL_NVIDIA_MEGA}\" != \"1\" ]; then \\\n         echo \"[sgl-nvidia-mega] skip (ENABLE_SGL_NVIDIA_MEGA=${ENABLE_SGL_NVIDIA_MEGA})\"; \\\n     elif ! printf '%s\\n' 12.9 \"${CUDA_VERSION}\" | sort -V -C; then \\\n         echo \"[sgl-nvidia-mega] skip (CUDA_VERSION=${CUDA_VERSION} < 12.9)\"; \\\n     else \\\n-        git clone \"${SGL_NVIDIA_MEGA_REPO}\" /sgl-workspace/sgl-nvidia-mega \\\n+        SGL_NVIDIA_MEGA_COMMIT=\"${SGL_NVIDIA_MEGA_COMMIT:-$(cat /tmp/sgl-nvidia-mega.commit)}\" \\\n+        && git clone \"${SGL_NVIDIA_MEGA_REPO}\" /sgl-workspace/sgl-nvidia-mega \\\n         && cd /sgl-workspace/sgl-nvidia-mega \\\n         && git checkout -f \"${SGL_NVIDIA_MEGA_COMMIT}\" \\\n         && uv pip install --no-deps -e . \\",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6afa229a273b33906cc62d1a50ff50214b483031/docker%2FDockerfile",
      "sha": "9dce58c43731456090d1a56215ece7a187435b18",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/6afa229a273b33906cc62d1a50ff50214b483031/docker%2FDockerfile.cu134",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docker%2FDockerfile.cu134?ref=6afa229a273b33906cc62d1a50ff50214b483031",
      "deletions": 3,
      "filename": "docker/Dockerfile.cu134",
      "patch": "@@ -923,14 +923,17 @@ RUN --mount=type=cache,target=/root/.cache/pip \\\n # SM103, compiled at runtime); disable with --build-arg ENABLE_SGL_NVIDIA_MEGA=0.\n ARG ENABLE_SGL_NVIDIA_MEGA=1\n ARG SGL_NVIDIA_MEGA_REPO=\"https://github.com/sgl-project/sgl-nvidia-mega.git\"\n-ARG SGL_NVIDIA_MEGA_COMMIT=\"54b428921749fef89fcbd043000f839ac9cc4638\"\n-RUN --mount=type=cache,target=/root/.cache/pip \\\n+# Default pin shared by both CUDA images; a build argument may override it.\n+ARG SGL_NVIDIA_MEGA_COMMIT\n+RUN --mount=type=bind,source=docker/sgl-nvidia-mega.commit,target=/tmp/sgl-nvidia-mega.commit \\\n+    --mount=type=cache,target=/root/.cache/pip \\\n     if [ \"${ENABLE_SGL_NVIDIA_MEGA}\" != \"1\" ]; then \\\n         echo \"[sgl-nvidia-mega] skip (ENABLE_SGL_NVIDIA_MEGA=${ENABLE_SGL_NVIDIA_MEGA})\"; \\\n     elif ! printf '%s\\n' 12.9 \"${CUDA_VERSION}\" | sort -V -C; then \\\n         echo \"[sgl-nvidia-mega] skip (CUDA_VERSION=${CUDA_VERSION} < 12.9)\"; \\\n     else \\\n-        git clone \"${SGL_NVIDIA_MEGA_REPO}\" /sgl-workspace/sgl-nvidia-mega \\\n+        SGL_NVIDIA_MEGA_COMMIT=\"${SGL_NVIDIA_MEGA_COMMIT:-$(cat /tmp/sgl-nvidia-mega.commit)}\" \\\n+        && git clone \"${SGL_NVIDIA_MEGA_REPO}\" /sgl-workspace/sgl-nvidia-mega \\\n         && cd /sgl-workspace/sgl-nvidia-mega \\\n         && git checkout -f \"${SGL_NVIDIA_MEGA_COMMIT}\" \\\n         && python3 -m pip install --no-deps -e . \\",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6afa229a273b33906cc62d1a50ff50214b483031/docker%2FDockerfile.cu134",
