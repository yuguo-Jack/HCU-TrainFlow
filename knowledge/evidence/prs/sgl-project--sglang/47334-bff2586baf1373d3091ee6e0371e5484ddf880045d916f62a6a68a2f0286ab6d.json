    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/6b262dc8bce75a71369e47f1215b16cc571a6291/rust%2Fsglang-grpc%2Fsrc%2Fserver.rs",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/rust%2Fsglang-grpc%2Fsrc%2Fserver.rs?ref=6b262dc8bce75a71369e47f1215b16cc571a6291",
      "deletions": 2,
      "filename": "rust/sglang-grpc/src/server.rs",
      "patch": "@@ -9,7 +9,7 @@ use pyo3::exceptions::{PyTypeError, PyValueError};\n use tokio::sync::{Notify, mpsc::Receiver, watch};\n use tokio::time::{Duration, timeout};\n use tokio_stream::Stream;\n-use tokio_stream::wrappers::TcpListenerStream;\n+use tonic::transport::server::TcpIncoming;\n use tonic::{Request, Response, Status};\n \n use crate::bridge::{PyBridge, ResponseChunk, TerminalError};\n@@ -1148,6 +1148,19 @@ pub async fn run_grpc_server(\n     result\n }\n \n+/// Wraps the gRPC listener so every accepted connection gets `TCP_NODELAY`.\n+///\n+/// Streamed responses are one small frame per token, all flowing server -> client with\n+/// almost nothing coming back. With Nagle enabled, the kernel holds each frame until the\n+/// previous one is acknowledged, and the client's delayed ACK stretches that wait to tens of\n+/// milliseconds: the Dynamo sidecar saw ITL p99 pinned at 40 ms and +25 ms TTFT on an idle\n+/// server, both gone with `TCP_NODELAY`. tonic only applies its own `tcp_nodelay` setting to\n+/// listeners it binds itself, not to a caller-supplied incoming stream, so set it here. This\n+/// matches the HTTP/gRPC listeners of `sglang-server` (`utils/sock.rs`).\n+fn grpc_incoming(listener: tokio::net::TcpListener) -> TcpIncoming {\n+    TcpIncoming::from(listener).with_nodelay(Some(true))\n+}\n+\n async fn serve_grpc(\n     listener: std::net::TcpListener,\n     service: impl proto::sglang_service_server::SglangService,\n@@ -1165,7 +1178,7 @@ async fn serve_grpc(\n \n     let result = tonic::transport::Server::builder()\n         .add_service(svc)\n-        .serve_with_incoming_shutdown(TcpListenerStream::new(listener), async move {\n+        .serve_with_incoming_shutdown(grpc_incoming(listener), async move {\n             shutdown.notified().await;\n             if let Some(stream_shutdown) = stream_shutdown {\n                 stream_shutdown.send_replace(true);",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6b262dc8bce75a71369e47f1215b16cc571a6291/rust%2Fsglang-grpc%2Fsrc%2Fserver.rs",
      "sha": "28b28217e5576789a18e321f8a0c38d38bee469c",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/sgl-project/sglang/blob/6b262dc8bce75a71369e47f1215b16cc571a6291/rust%2Fsglang-grpc%2Fsrc%2Fserver%2Ftests.rs",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/rust%2Fsglang-grpc%2Fsrc%2Fserver%2Ftests.rs?ref=6b262dc8bce75a71369e47f1215b16cc571a6291",
      "deletions": 0,
      "filename": "rust/sglang-grpc/src/server/tests.rs",
      "patch": "@@ -79,6 +79,23 @@ fn resolve_max_message_size_honors_env_var() {\n     }\n }\n \n+#[tokio::test]\n+async fn accepted_grpc_connections_have_tcp_nodelay() {\n+    use tokio_stream::StreamExt;\n+\n+    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n+    let addr = listener.local_addr().unwrap();\n+    let mut incoming = super::grpc_incoming(listener);\n+\n+    let client = tokio::net::TcpStream::connect(addr).await.unwrap();\n+    let accepted = incoming.next().await.unwrap().unwrap();\n+    assert!(\n+        accepted.nodelay().unwrap(),\n+        \"the gRPC listener must disable Nagle on accepted connections\"\n+    );\n+    drop(client);\n+}\n+\n #[tokio::test]\n async fn follower_metadata_server_exposes_only_server_info_and_shuts_down() {\n     use sglang_api_types::runtime::v1::{GetServerInfoRequest, GetServerInfoResponse};",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6b262dc8bce75a71369e47f1215b16cc571a6291/rust%2Fsglang-grpc%2Fsrc%2Fserver%2Ftests.rs",
      "sha": "de2a9d257af10cbdd58dd9491d8da78aa3ad9a5d",
      "status": "modified"
    }
