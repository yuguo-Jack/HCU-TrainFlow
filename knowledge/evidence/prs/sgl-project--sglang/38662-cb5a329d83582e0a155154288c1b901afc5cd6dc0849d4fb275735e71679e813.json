repare_multi_stream_hip(\n+                q, kv = self._forward_prepare_multi_stream_hip(\n                     x,\n                     positions,\n                     forward_batch,\n@@ -1670,6 +1694,7 @@ def forward(\n                     q_out,\n                     x_quant=x_quant,\n                 )\n+                kv = None\n             else:\n                 q = self._forward_prepare_multi_stream(\n                     x,\n@@ -1679,7 +1704,7 @@ def forward(\n                     q_out,\n                     x_quant=x_quant,\n                 )\n-            kv = None\n+                kv = None\n         else:\n             q, kv = self._forward_prepare(\n                 x,",
