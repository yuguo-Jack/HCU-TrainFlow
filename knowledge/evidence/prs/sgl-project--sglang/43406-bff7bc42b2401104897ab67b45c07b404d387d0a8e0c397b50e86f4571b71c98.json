      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fscheduler_client.py?ref=78e9e64761c0f933ee26d8373a94df6aad0faf78",
      "deletions": 4,
      "filename": "python/sglang/multimodal_gen/runtime/scheduler_client.py",
      "patch": "@@ -123,12 +123,16 @@ async def run_zeromq_broker(server_args: ServerArgs):\n \n \n def _session_key(batch: Any) -> str | None:\n-    \"\"\"Realtime sessions hold GPU state on one replica, so every request of a\n-    session must land on the same one.\"\"\"\n+    \"\"\"Return the affinity key for requests that hold state on one replica.\"\"\"\n     reqs = batch if isinstance(batch, list) else [batch]\n     for req in reqs:\n-        if isinstance(req, Req) and req.realtime_session_id:\n-            return req.realtime_session_id\n+        if isinstance(req, Req):\n+            if req.realtime_session_id:\n+                return req.realtime_session_id\n+            extra = req.extra or {}\n+            comfyui_session_id = extra.get(\"comfyui_session_id\")\n+            if comfyui_session_id:\n+                return comfyui_session_id\n     return None\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/78e9e64761c0f933ee26d8373a94df6aad0faf78/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fscheduler_client.py",
      "sha": "e0e408515b4e49378e41e3b781393c6c3b92c1e1",
      "status": "modified"
    },
