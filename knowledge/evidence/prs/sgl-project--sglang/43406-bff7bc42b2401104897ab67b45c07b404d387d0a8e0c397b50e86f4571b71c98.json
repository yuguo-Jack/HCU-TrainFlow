      "additions": 9,
      "blob_url": "https://github.com/sgl-project/sglang/blob/78e9e64761c0f933ee26d8373a94df6aad0faf78/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_dp_routing.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_dp_routing.py?ref=78e9e64761c0f933ee26d8373a94df6aad0faf78",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_dp_routing.py",
      "patch": "@@ -44,6 +44,15 @@ def test_session_requests_stick_to_one_replica():\n     assert _select_replica([_req()], 4, counter) == 0\n \n \n+def test_comfyui_session_requests_stick_to_one_replica():\n+    counter = itertools.count()\n+    session_req = _req(extra={\"comfyui_session_id\": \"executor-1:run-1\"})\n+    picks = [_select_replica([session_req], 2, counter) for _ in range(4)]\n+    assert len(set(picks)) == 1\n+    # ComfyUI session traffic does not consume the round-robin counter either.\n+    assert _select_replica([_req()], 2, counter) == 0\n+\n+\n def test_control_reqs_are_recognized():\n     assert isinstance(SetLoraReq(lora_nickname=\"x\", lora_path=\"y\"), _CONTROL_REQ_TYPES)\n     assert isinstance(ShutdownReq(), _CONTROL_REQ_TYPES)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/78e9e64761c0f933ee26d8373a94df6aad0faf78/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_dp_routing.py",
