  "files": [
    {
      "additions": 27,
      "blob_url": "https://github.com/sgl-project/sglang/blob/1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100.py?ref=1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c",
      "deletions": 5,
      "filename": "python/sglang/kernels/ops/attention/dsv4/decode_attention_sm100.py",
      "patch": "@@ -10,7 +10,12 @@\n from .kv_layout import KVLayout\n \n LAYOUT = KVLayout.V4\n+# Row bounds the callers dispatch at; the kernels take any row count, since each\n+# (row, KV tile) is its own CTA. gfx950 keeps MAX_BATCH. On SM100 the alternative is\n+# FlashMLA on 64 zero-padded heads, which swap-AB beats up to 24 rows (GB300 TP4, per\n+# layer: 10.2 vs 21.7 us at 12 rows, 15 us at 24); FlashMLA is faster from 32 rows.\n MAX_BATCH = 8\n+SM100_MAX_ROWS = 24\n NUM_HEADS = 16\n HEAD_DIM = 512\n SOFTMAX_SCALE = HEAD_DIM**-0.5\n@@ -26,7 +31,7 @@ def can_use_swapab_attention(\n ) -> bool:\n     \"\"\"The caller adds the SM100 and single-query forward-mode gates.\"\"\"\n     return (\n-        0 < q.shape[0] <= MAX_BATCH\n+        0 < q.shape[0] <= SM100_MAX_ROWS\n         and num_heads == NUM_HEADS\n         and q.dtype == torch.bfloat16\n         and q.shape[-1] == HEAD_DIM\n@@ -69,9 +74,15 @@ def _combine(\n     ST: tl.constexpr,\n     H: tl.constexpr,\n     BD: tl.constexpr,\n+    USE_GDC: tl.constexpr,\n ):\n     b, h, tile = tl.program_id(0), tl.program_id(1), tl.program_id(2)\n     t, d = tl.arange(0, ST), tile * BD + tl.arange(0, BD)\n+    if USE_GDC:\n+        tl.extra.cuda.gdc_wait()\n+        # Trigger right after the wait, not after the loads: fused_rope_wo_a streams its\n+        # weights before its own wait. Faster in 7 of 9 GB300 cases at 6-24 rows.\n+        tl.extra.cuda.gdc_launch_dependents()\n     den = tl.load(SUM + (b * NT + t) * H + h, t < NT, 0)\n     mx = tl.load(MAX + (b * NT + t) * H + h, t < NT, 0)\n     mx = tl.where(den > 0, mx, -float(\"inf\"))\n@@ -105,17 +116,21 @@ def swapab_attention(\n     extra_lengths=None,\n     inv_rope=None,\n     partial_gluon=None,\n+    pdl=True,\n+    narrow_combine=True,\n ):\n     \"\"\"V4-layout attention on 16 heads; `extra_*` is a second slot range appended\n     to each request's keys, and the attention sink is folded in exactly once.\n-    `partial_gluon` replaces the SM100 split-KV kernel (swapab_gluon_hip passes gfx950's).\"\"\"\n+    `partial_gluon` replaces the SM100 split-KV kernel (swapab_gluon_hip passes gfx950's,\n+    with `pdl` and `narrow_combine` off). `pdl` launches both kernels as programmatic\n+    dependents; `narrow_combine` runs the combine as one-warp programs over 128 columns.\"\"\"\n     if partial_gluon is None:\n         from .decode_attention_sm100_gluon import partial_gluon\n \n     block = 64\n     b, h, d = q.shape[0], q.shape[-2], q.shape[-1]\n     assert q.ndim in (3, 4) and (q.ndim == 3 or q.shape[1] == 1)\n-    assert 0 < b <= MAX_BATCH and h == NUM_HEADS and d == HEAD_DIM\n+    assert b > 0 and h == NUM_HEADS and d == HEAD_DIM\n     assert q.dtype == torch.bfloat16 and q.stride(-1) == 1\n     assert kv.shape[-1] == LAYOUT.bytes_per_token\n     assert kv.dtype in (torch.uint8, torch.float8_e4m3fn)\n@@ -172,6 +187,8 @@ def swapab_attention(\n         SCALE_BYTES=LAYOUT.scale_bytes,\n         TILE=LAYOUT.tile_size,\n         num_warps=4,\n+        # The HIP partial kernel takes no USE_GDC.\n+        **({\"USE_GDC\": True, \"launch_pdl\": True} if pdl else {}),\n     )\n     if inv_rope is not None:\n         freqs, positions = inv_rope\n@@ -182,7 +199,10 @@ def swapab_attention(\n     else:\n         freqs = positions = out\n         rope_dim = 0\n-    bd = 64 if ne else 512\n+    bd, combine_warps = 64 if ne else 512, 4\n+    if narrow_combine and ne:\n+        # GB300, 10 KV tiles: 2.1 vs 3.1 us at 12 rows, 2.5 vs 4.6 at 24.\n+        bd, combine_warps = 128, 1\n     _combine[(b, h, triton.cdiv(512, bd))](\n         partial,\n         maximum,\n@@ -197,6 +217,8 @@ def swapab_attention(\n         ST=triton.next_power_of_2(nt),\n         H=h,\n         BD=bd,\n-        num_warps=4,\n+        USE_GDC=pdl,\n+        num_warps=combine_warps,\n+        **({\"launch_pdl\": True} if pdl else {}),\n     )\n     return out",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100.py",
      "sha": "bbef94591c0701363904393d7b22e9db12e9c755",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100_gluon.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100_gluon.py?ref=1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c",
      "deletions": 0,
      "filename": "python/sglang/kernels/ops/attention/dsv4/decode_attention_sm100_gluon.py",
      "patch": "@@ -98,8 +98,19 @@ def partial_gluon(\n     DATA_BYTES: gl.constexpr,\n     SCALE_BYTES: gl.constexpr,\n     TILE: gl.constexpr,\n+    USE_GDC: gl.constexpr = False,\n ):\n     gl.static_assert(SWAP_AB and H == 16 and (BT == 64 or BT == 128))\n+    if USE_GDC:\n+        # tl.extra.cuda.gdc_wait: every input is read after it.\n+        gl.inline_asm_elementwise(\n+            \"griddepcontrol.wait; // $0\",\n+            \"=r\",\n+            [],\n+            dtype=gl.int32,\n+            is_pure=False,\n+            pack=1,\n+        )\n     b, t = gl.program_id(0), gl.program_id(1)\n     kv_layout: gl.constexpr = gl.BlockedLayout([1, 8], [4, 8], [4, 1], [1, 0])\n     n = gl.arange(0, BT, gl.SliceLayout(1, kv_layout))\n@@ -150,6 +161,17 @@ def partial_gluon(\n         gl.NVMMASharedLayout(swizzle_byte_width=128, element_bitwidth=16),\n         value=kv,\n     )\n+    if USE_GDC:\n+        # tl.extra.cuda.gdc_launch_dependents after the last global load: the combine\n+        # launches while the MMAs and the epilogue run.\n+        gl.inline_asm_elementwise(\n+            \"griddepcontrol.launch_dependents; // $0\",\n+            \"=r\",\n+            [],\n+            dtype=gl.int32,\n+            is_pure=False,\n+            pack=1,\n+        )\n     score_tmem = allocate_tensor_memory(\n         gl.float32, [BT, H], TensorMemoryLayout(block=(BT, H), col_stride=1)\n     )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100_gluon.py",
      "sha": "380c72c0d67d261429eed07c948e008e86094bf7",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fswapab_gluon_hip.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fswapab_gluon_hip.py?ref=1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c",
      "deletions": 1,
      "filename": "python/sglang/kernels/ops/attention/dsv4/swapab_gluon_hip.py",
      "patch": "@@ -127,4 +127,6 @@ def partial_gluon(\n \n \n # the SM100 host path (sink, combine, inverse RoPE) on the gfx950 split-KV kernel above\n-swapab_attention = functools.partial(_swapab_attention, partial_gluon=partial_gluon)\n+swapab_attention = functools.partial(\n+    _swapab_attention, partial_gluon=partial_gluon, pdl=False, narrow_combine=False\n+)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1b46f6f6cdee6ef2710f141bc1dc02d511b8eb1c/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fswapab_gluon_hip.py",
      "sha": "9c0ece01d5522a3f55b62e310cb5ff0e3625ec31",
