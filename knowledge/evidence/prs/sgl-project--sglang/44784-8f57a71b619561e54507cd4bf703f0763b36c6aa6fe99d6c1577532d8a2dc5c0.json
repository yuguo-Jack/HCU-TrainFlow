      "deletions": 1,
      "filename": "python/sglang/srt/function_call/mistral_detector.py",
      "patch": "@@ -40,6 +40,10 @@ def __init__(self):\n         self._tool_calls_marker = \"[TOOL_CALLS\"\n         self.eot_token = \"]\"\n         self.tool_call_separator = \", \"\n+        # (text, json_start, depth, in_string, escape_next) of the last\n+        # incomplete JSON value scanned by _extract_json_value, so streaming\n+        # resumes where it stopped instead of rescanning the whole buffer.\n+        self._json_scan = None\n \n     def has_tool_call(self, text: str) -> bool:\n         \"\"\"Return True if the text contains either supported tool-call marker.\"\"\"\n@@ -268,8 +272,14 @@ def _extract_json_value(\n         depth = 0\n         in_string = False\n         escape_next = False\n+        first = json_start\n \n-        for k in range(json_start, len(text)):\n+        scan = self._json_scan\n+        if scan is not None and scan[1] == json_start and text.startswith(scan[0]):\n+            _, _, depth, in_string, escape_next = scan\n+            first = len(scan[0])\n+\n+        for k in range(first, len(text)):\n             ch = text[k]\n             if escape_next:\n                 escape_next = False\n@@ -287,8 +297,10 @@ def _extract_json_value(\n             elif ch == closing:\n                 depth -= 1\n                 if depth == 0:\n+                    self._json_scan = None\n                     return text[json_start : k + 1], k + 1\n \n+        self._json_scan = (text, json_start, depth, in_string, escape_next)\n         return None, json_start\n \n     def _extract_json_array(self, text: str) -> str:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9d0d0746b6c9287e1a5b666741511da33a450afb/python%2Fsglang%2Fsrt%2Ffunction_call%2Fmistral_detector.py",
      "sha": "e19d2ba98d2c9f25ef2b1976ed66f3084bae0be9",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9d0d0746b6c9287e1a5b666741511da33a450afb/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_mistral_detector.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_mistral_detector.py?ref=9d0d0746b6c9287e1a5b666741511da33a450afb",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_mistral_detector.py",
      "patch": "@@ -217,6 +217,22 @@ def test_streaming_text_then_tool_call(self):\n         params = json.loads(full_params)\n         self.assertEqual(params[\"city\"], \"Tokyo\")\n \n+    def test_streaming_compact_format_small_deltas(self):\n+        # Braces, brackets and escaped quotes inside strings must not end the\n+        # arguments early when the JSON scan resumes across many small deltas.\n+        args = {\"city\": 'a {b} [c] \\\\\"d\\\\\" ' * 50, \"days\": [1, {\"x\": \"}\"}]}\n+        text = \"[TOOL_CALLS]get_weather[ARGS]\" + json.dumps(args)\n+        text += '[TOOL_CALLS]get_weather[ARGS]{\"city\": \"Paris\"}'\n+        detector = MistralDetector()\n+        all_calls = []\n+        for i in range(0, len(text), 3):\n+            result = detector.parse_streaming_increment(text[i : i + 3], self.tools)\n+            all_calls.extend(result.calls)\n+\n+        self.assertEqual([c.name for c in all_calls if c.name], [\"get_weather\"] * 2)\n+        params = [json.loads(c.parameters) for c in all_calls if c.parameters]\n+        self.assertEqual(params, [args, {\"city\": \"Paris\"}])\n+\n \n if __name__ == \"__main__\":\n     import unittest",
