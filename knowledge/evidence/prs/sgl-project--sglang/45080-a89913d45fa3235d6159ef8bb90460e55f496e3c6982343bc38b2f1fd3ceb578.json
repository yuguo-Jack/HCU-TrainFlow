    {
      "additions": 33,
      "blob_url": "https://github.com/sgl-project/sglang/blob/1cae94d301b9270d968726ac6bb3005e2a8bb6f4/test%2Fregistered%2Funit%2Fmanagers%2Ftest_output_serialization.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_output_serialization.py?ref=1cae94d301b9270d968726ac6bb3005e2a8bb6f4",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_output_serialization.py",
      "patch": "@@ -0,0 +1,33 @@\n+import unittest\n+\n+import pybase64\n+import torch\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import maybe_stub_sgl_kernel\n+\n+maybe_stub_sgl_kernel()\n+\n+from sglang.srt.managers.detokenizer_manager import DetokenizerManager  # noqa: E402\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestOutputSerialization(unittest.TestCase):\n+    def test_base64_preserves_bytes_and_missing_items(self):\n+        tensor = torch.arange(120, dtype=torch.int32).reshape(5, 4, 6)\n+        items = [tensor, tensor.transpose(0, 1), torch.empty((0, 2)), None]\n+        expected = [\n+            pybase64.b64encode(item.numpy().tobytes()).decode(\"utf-8\")\n+            if item is not None\n+            else None\n+            for item in items\n+        ]\n+        encode = DetokenizerManager._b64_encode_per_request\n+        self.assertEqual(encode(items), expected)\n+        self.assertIsNone(encode(None))\n+        self.assertEqual(encode([]), [])\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1cae94d301b9270d968726ac6bb3005e2a8bb6f4/test%2Fregistered%2Funit%2Fmanagers%2Ftest_output_serialization.py",
      "sha": "39cbfbbfa2f340769b73db2fe7f0324adaab9768",
      "status": "added"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/1cae94d301b9270d968726ac6bb3005e2a8bb6f4/test%2Fregistered%2Funit%2Fmanagers%2Ftest_tokenizer_manager_rid_cleanup.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_tokenizer_manager_rid_cleanup.py?ref=1cae94d301b9270d968726ac6bb3005e2a8bb6f4",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_tokenizer_manager_rid_cleanup.py",
      "patch": "@@ -21,6 +21,8 @@\n from unittest.mock import AsyncMock, MagicMock, Mock, patch\n \n import msgspec\n+import pybase64\n+import torch\n from fastapi import HTTPException\n \n from sglang.test.ci.ci_register import register_cpu_ci\n@@ -458,6 +460,26 @@ def test_abort_output_ids_match_the_streaming_mode(self):\n class TestRidToStateCleanupOnBatchOutput(CustomTestCase):\n     \"\"\"Test that _handle_batch_output removes rid from rid_to_state on completion.\"\"\"\n \n+    def test_batch_output_encodes_expert_tensors_and_preserves_strings(self):\n+        tensor = torch.arange(120, dtype=torch.int32).reshape(5, 4, 6).transpose(0, 1)\n+        encoded = pybase64.b64encode(tensor.numpy().tobytes()).decode(\"utf-8\")\n+        for value in (tensor, encoded, None):\n+            with self.subTest(value_type=type(value).__name__):\n+                tm = _make_tokenizer_manager(self)\n+                rid = \"expert-output\"\n+                state = _make_req_state(rid)\n+                tm.rid_to_state[rid] = state\n+                batch = _make_batch_str_output(rid)\n+                batch.routed_experts = [value]\n+                batch.indexer_topk = [value]\n+                asyncio.run(tm._handle_batch_output(batch))\n+                meta = state.out_list[0][\"meta_info\"]\n+                for name in (\"routed_experts\", \"indexer_topk\"):\n+                    if value is None:\n+                        self.assertNotIn(name, meta)\n+                    else:\n+                        self.assertEqual(meta[name], encoded)\n+\n     def test_batch_output_removes_rid_on_finish(self):\n         \"\"\"When a request finishes in _handle_batch_output, rid should be removed.\"\"\"\n         tm = _make_tokenizer_manager(self)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1cae94d301b9270d968726ac6bb3005e2a8bb6f4/test%2Fregistered%2Funit%2Fmanagers%2Ftest_tokenizer_manager_rid_cleanup.py",
      "sha": "505c70e76319caf3eb65839ad57d6ff9aa387688",
      "status": "modified"
