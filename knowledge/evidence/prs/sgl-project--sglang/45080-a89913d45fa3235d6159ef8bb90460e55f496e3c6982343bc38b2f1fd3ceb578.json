      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Ftokenizer_manager.py?ref=1cae94d301b9270d968726ac6bb3005e2a8bb6f4",
      "deletions": 2,
      "filename": "python/sglang/srt/managers/tokenizer_manager.py",
      "patch": "@@ -2617,13 +2617,17 @@ async def _handle_batch_output(\n                     # BatchStrOutput is pre-encoded by the detokenizer;\n                     # BatchTokenIDOutput (skip_tokenizer_init) bypasses it.\n                     if isinstance(val, torch.Tensor):\n-                        val = pybase64.b64encode(val.numpy().tobytes()).decode(\"utf-8\")\n+                        val = pybase64.b64encode_as_string(\n+                            memoryview(np.ascontiguousarray(val.numpy()))\n+                        )\n                     meta_info[\"routed_experts\"] = val\n             if getattr(recv_obj, \"indexer_topk\", None):\n                 val = recv_obj.indexer_topk[i]\n                 if val is not None:\n                     if isinstance(val, torch.Tensor):\n-                        val = pybase64.b64encode(val.numpy().tobytes()).decode(\"utf-8\")\n+                        val = pybase64.b64encode_as_string(\n+                            memoryview(np.ascontiguousarray(val.numpy()))\n+                        )\n                     meta_info[\"indexer_topk\"] = val\n             if getattr(recv_obj, \"dp_ranks\", None):\n                 meta_info[\"dp_rank\"] = recv_obj.dp_ranks[i]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1cae94d301b9270d968726ac6bb3005e2a8bb6f4/python%2Fsglang%2Fsrt%2Fmanagers%2Ftokenizer_manager.py",
      "sha": "5a4e6c9ecc62bf653a1f8f51ed7e9b72a4b93990",
