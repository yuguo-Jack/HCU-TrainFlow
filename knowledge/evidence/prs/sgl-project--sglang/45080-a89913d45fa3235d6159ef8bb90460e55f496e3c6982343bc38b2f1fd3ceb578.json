      "filename": "python/sglang/srt/managers/detokenizer_manager.py",
      "patch": "@@ -20,6 +20,7 @@\n from collections import OrderedDict, defaultdict\n from typing import Dict, List, Optional, Tuple, Union\n \n+import numpy as np\n import psutil\n import pybase64\n import setproctitle\n@@ -434,7 +435,9 @@ def _b64_encode_per_request(\n             return None\n         return [\n             (\n-                pybase64.b64encode(item.numpy().tobytes()).decode(\"utf-8\")\n+                pybase64.b64encode_as_string(\n+                    memoryview(np.ascontiguousarray(item.numpy()))\n+                )\n                 if item is not None\n                 else None\n             )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1cae94d301b9270d968726ac6bb3005e2a8bb6f4/python%2Fsglang%2Fsrt%2Fmanagers%2Fdetokenizer_manager.py",
