  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9168996689d15de9c659c5385fbd739b3c84b7fa/python%2Fsglang%2Fsrt%2Flora%2Flora_manager.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flora%2Flora_manager.py?ref=9168996689d15de9c659c5385fbd739b3c84b7fa",
      "deletions": 1,
      "filename": "python/sglang/srt/lora/lora_manager.py",
      "patch": "@@ -811,7 +811,12 @@ def init_lora_shapes(\n \n         if target_modules and target_modules == {\"all\"}:\n             self.target_modules = auto_detect_lora_target_modules(self.base_model)\n-            self.target_modules.update(EMBEDDING_NAMES)\n+            # Auto-detection only finds the parallel embedding classes LoRA can\n+            # wrap, and misses a tied lm_head. Add both names when either was\n+            # found; a model with its own embedding class (e.g. Gemma's scaled\n+            # nn.Embedding) gets neither.\n+            if self.target_modules & set(EMBEDDING_NAMES):\n+                self.target_modules.update(EMBEDDING_NAMES)\n             logger.info(\n                 \"CLI --lora-target-modules='all' resolved to %s \"\n                 \"by inspecting the base model.\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9168996689d15de9c659c5385fbd739b3c84b7fa/python%2Fsglang%2Fsrt%2Flora%2Flora_manager.py",
      "sha": "7aaed94b4389b7082ea81d5d6de02e84df611d97",
      "status": "modified"
    },
    {
      "additions": 53,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9168996689d15de9c659c5385fbd739b3c84b7fa/test%2Fregistered%2Funit%2Flora%2Ftest_lora_manager_init_modules.py",
      "changes": 53,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flora%2Ftest_lora_manager_init_modules.py?ref=9168996689d15de9c659c5385fbd739b3c84b7fa",
      "deletions": 0,
      "filename": "test/registered/unit/lora/test_lora_manager_init_modules.py",
      "patch": "@@ -236,6 +236,59 @@ def test_auto_detect_lora_target_modules(self):\n         )\n \n \n+class _MockVocabParallelEmbedding(torch.nn.Module):\n+    pass\n+\n+\n+class TestAllTargetsEmbeddings(CustomTestCase):\n+    \"\"\"`--lora-target-modules all` adds `embed_tokens`/`lm_head` only for the\n+    embedding classes LoRA can wrap.\"\"\"\n+\n+    @staticmethod\n+    def _resolve_all(embed_tokens):\n+        model = torch.nn.Module()\n+        model.model = torch.nn.Module()\n+        layer = torch.nn.Module()\n+        layer.self_attn = torch.nn.Module()\n+        layer.self_attn.qkv_proj = _MockLinearBase()\n+        layer.self_attn.o_proj = _MockLinearBase()\n+        model.model.layers = torch.nn.ModuleList([layer])\n+        model.model.embed_tokens = embed_tokens\n+        model.lm_head = embed_tokens  # tied\n+\n+        manager = LoRAManager.__new__(LoRAManager)\n+        manager.base_model = model\n+        manager.configs = {}\n+        manager.lora_added_tokens_size = 0\n+        with (\n+            patch(\"sglang.srt.layers.linear.LinearBase\", _MockLinearBase),\n+            patch(\n+                \"sglang.srt.layers.moe.fused_moe_triton.layer.FusedMoE\", _MockFusedMoE\n+            ),\n+            patch(\n+                \"sglang.srt.layers.vocab_parallel_embedding.ParallelLMHead\",\n+                _MockParallelLMHead,\n+            ),\n+            patch(\n+                \"sglang.srt.layers.vocab_parallel_embedding.VocabParallelEmbedding\",\n+                _MockVocabParallelEmbedding,\n+            ),\n+        ):\n+            manager.init_lora_shapes(max_lora_rank=8, target_modules={\"all\"})\n+        return manager.target_modules\n+\n+    def test_tied_parallel_embedding_gets_both_targets(self):\n+        targets = self._resolve_all(_MockVocabParallelEmbedding())\n+        self.assertEqual(targets, {\"qkv_proj\", \"o_proj\", \"embed_tokens\", \"lm_head\"})\n+\n+    def test_plain_embedding_gets_no_embedding_targets(self):\n+        # Gemma 3/4 tie lm_head to a scaled `nn.Embedding`, which has no\n+        # `org_vocab_size`; adding `lm_head` sent init_lora_modules into the\n+        # tied-head path and failed with AttributeError.\n+        targets = self._resolve_all(torch.nn.Embedding(10, 8))\n+        self.assertEqual(targets, {\"qkv_proj\", \"o_proj\"})\n+\n+\n class TestTargetValidation(CustomTestCase):\n     \"\"\"init_state rejects unsupported targets before any module is wrapped.\"\"\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9168996689d15de9c659c5385fbd739b3c84b7fa/test%2Fregistered%2Funit%2Flora%2Ftest_lora_manager_init_modules.py",
      "sha": "62c6368e0e2ac57faed77015d91a43abc72a937b",
      "status": "modified"
    }
