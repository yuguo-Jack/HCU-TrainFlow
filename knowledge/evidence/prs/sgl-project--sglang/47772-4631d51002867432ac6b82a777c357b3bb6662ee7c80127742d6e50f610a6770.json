      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Foutput_streamer.py?ref=5d47fa711a434e1cdf273e52d0361722e7318b06",
      "deletions": 2,
      "filename": "python/sglang/srt/managers/scheduler_components/output_streamer.py",
      "patch": "@@ -72,12 +72,15 @@ class OutputSink(Enum):\n \n def _scheduler_decode_latency(time_stats: SchedulerReqTimeStats) -> Optional[float]:\n     \"\"\"A finished non-streaming request's decode latency as Python's\n-    TokenizerManager measures it: from the scheduler's prefill-finished stamp\n+    TokenizerManager measures it: from the scheduler's first-token stamp\n     (`_get_scheduler_first_token_time`, which has the stamp only when metrics\n     are on) to now, its terminal output (`get_decode_latency`). None where it\n     falls back to its own first-output time, which the Rust frontend\n     measures the same way.\"\"\"\n-    stamp = time_stats.prefill_finished_time\n+    stamp = (\n+        getattr(time_stats, \"decode_first_token_time\", 0.0)\n+        or time_stats.prefill_finished_time\n+    )\n     now = time.perf_counter()\n     if time_stats.enable_metrics and 0.0 < stamp <= now:\n         return now - stamp",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5d47fa711a434e1cdf273e52d0361722e7318b06/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Foutput_streamer.py",
      "sha": "0a4d396c266bbbf3a8312f97509d3d2c059689b2",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5d47fa711a434e1cdf273e52d0361722e7318b06/python%2Fsglang%2Fsrt%2Fmanagers%2Ftokenizer_manager.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Ftokenizer_manager.py?ref=5d47fa711a434e1cdf273e52d0361722e7318b06",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/tokenizer_manager.py",
      "patch": "@@ -2952,7 +2952,10 @@ def _get_scheduler_first_token_time(\n         # Non-streaming outputs are batched; use the scheduler's first-token time.\n         if getattr(state.obj, \"stream\", False):\n             return None\n-        stamp = _scheduler_time_stats(request_stats).prefill_finished_time\n+        time_stats = _scheduler_time_stats(request_stats)\n+        # PD decode does not run prefill locally. Its handoff timestamp includes\n+        # transfer and admission, without misreporting those as prefill forward.\n+        stamp = time_stats.decode_first_token_time or time_stats.prefill_finished_time\n         if stamp is None:\n             return None\n         ts = convert_realtime_to_time(stamp)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5d47fa711a434e1cdf273e52d0361722e7318b06/python%2Fsglang%2Fsrt%2Fmanagers%2Ftokenizer_manager.py",
