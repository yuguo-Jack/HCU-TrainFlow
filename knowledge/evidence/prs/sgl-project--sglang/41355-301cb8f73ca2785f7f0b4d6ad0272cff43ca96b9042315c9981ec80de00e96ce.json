    {
      "additions": 9,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4b8ea8033e777273d9d360f5367cc4acd4bc11d6/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py?ref=4b8ea8033e777273d9d360f5367cc4acd4bc11d6",
      "deletions": 10,
      "filename": "python/sglang/srt/layers/layernorm.py",
      "patch": "@@ -771,12 +771,13 @@ def forward_hip(\n             # NOTE: Remove this if aiter kernel supports discontinuous input\n             x = x.contiguous()\n         if residual is not None:\n-            out = torch.empty_like(x)\n-            residual_out = torch.empty_like(x)\n             if post_residual_addition is not None:\n                 residual = residual + post_residual_addition\n+            # in place: out <- norm(x + residual), residual_out <- x + residual\n+            out = x.clone()\n+            residual_out = residual.clone(memory_format=torch.contiguous_format)\n             fused_add_rms_norm(\n-                out, x, residual_out, residual, self.weight.data, self.variance_epsilon\n+                out, residual_out, self.weight.data, self.variance_epsilon\n             )\n             return out, residual_out\n         out = torch.empty_like(x)\n@@ -1179,18 +1180,16 @@ def forward_hip(\n             return self.forward_native(x, residual, post_residual_addition)\n         else:\n             w = self.gemma_weight\n-            # vllm API: rms_norm(out, input, weight, eps) -> None (in-place)\n-            #           fused_add_rms_norm(out, input, residual_out, residual, weight, eps)\n+            # vllm API: rms_norm(out, input, weight, eps) -> None\n+            #           fused_add_rms_norm(input, residual, weight, eps), in place\n             if not x.is_contiguous():\n                 x = x.contiguous()\n             if residual is not None:\n-                out = torch.empty_like(x)\n-                residual_out = torch.empty_like(x)\n                 if post_residual_addition is not None:\n                     residual = residual + post_residual_addition\n-                fused_add_rms_norm(\n-                    out, x, residual_out, residual, w, self.variance_epsilon\n-                )\n+                out = x.clone()\n+                residual_out = residual.clone(memory_format=torch.contiguous_format)\n+                fused_add_rms_norm(out, residual_out, w, self.variance_epsilon)\n                 return out, residual_out\n             out = torch.empty_like(x)\n             rms_norm(out, x, w, self.variance_epsilon)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4b8ea8033e777273d9d360f5367cc4acd4bc11d6/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py",
      "sha": "1b7bb09cd16051c4812dc81298c2e2568a041eaa",
      "status": "modified"
    }
