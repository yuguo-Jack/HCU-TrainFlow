      "filename": "python/sglang/srt/mem_cache/memory_pool.py",
      "patch": "@@ -649,6 +649,20 @@ def __init__(\n         temporal_state_shape = cache_params.shape.temporal\n         conv_dtype = cache_params.dtype.conv\n         ssm_dtype = cache_params.dtype.temporal\n+        if (\n+            speculative_num_draft_tokens is not None\n+            and _is_npu\n+            and ssm_dtype != torch.bfloat16\n+        ):\n+            # recurrent_gated_delta_rule requires bfloat16 for both persistent\n+            # and intermediate states. Resolve the dtype before allocating either\n+            # buffer so speculative verify and state commit use the same contract.\n+            logger.warning(\n+                f\"Mamba SSM state dtype {ssm_dtype} is not supported by the NPU \"\n+                \"speculative verify kernels; using bfloat16 instead. Set \"\n+                \"SGLANG_MAMBA_SSM_DTYPE=bfloat16 to silence this warning.\"\n+            )\n+            ssm_dtype = torch.bfloat16\n         self.memory_saver_adapter = TorchMemorySaverAdapter.create(\n             enable=enable_memory_saver\n         )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/756dac5a667bb423e476e8ccf94b29f5f19b2de7/python%2Fsglang%2Fsrt%2Fmem_cache%2Fmemory_pool.py",
