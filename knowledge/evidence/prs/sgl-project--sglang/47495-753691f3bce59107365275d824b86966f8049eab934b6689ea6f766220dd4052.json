      "blob_url": "https://github.com/sgl-project/sglang/blob/682dc00139cdc8bff6b077c8a298ad5b9603da9b/python%2Fsglang%2Flang%2Fbackend%2Fruntime_endpoint.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Flang%2Fbackend%2Fruntime_endpoint.py?ref=682dc00139cdc8bff6b077c8a298ad5b9603da9b",
      "deletions": 1,
      "filename": "python/sglang/lang/backend/runtime_endpoint.py",
      "patch": "@@ -130,8 +130,12 @@ def _handle_dtype_to_regex(self, sampling_params: SglSamplingParams):\n         if sampling_params.dtype is None:\n             return\n \n-        if sampling_params.stop == ():\n+        if not sampling_params.stop:\n             sampling_params.stop = []\n+        elif isinstance(sampling_params.stop, str):\n+            sampling_params.stop = [sampling_params.stop]\n+        else:\n+            sampling_params.stop = list(sampling_params.stop)\n \n         dtype_regex = None\n         if sampling_params.dtype in [\"int\", int]:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/682dc00139cdc8bff6b077c8a298ad5b9603da9b/python%2Fsglang%2Flang%2Fbackend%2Fruntime_endpoint.py",
      "sha": "627b1e337ece53f2469cd54687049149ba2ad110",
      "status": "modified"
    },
    {
      "additions": 61,
      "blob_url": "https://github.com/sgl-project/sglang/blob/682dc00139cdc8bff6b077c8a298ad5b9603da9b/test%2Fregistered%2Funit%2Flang%2Ftest_runtime_endpoint_dtype.py",
      "changes": 61,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flang%2Ftest_runtime_endpoint_dtype.py?ref=682dc00139cdc8bff6b077c8a298ad5b9603da9b",
      "deletions": 0,
      "filename": "test/registered/unit/lang/test_runtime_endpoint_dtype.py",
      "patch": "@@ -0,0 +1,61 @@\n+\"\"\"Unit tests for RuntimeEndpoint._handle_dtype_to_regex.\"\"\"\n+\n+import unittest\n+\n+from sglang.lang.backend.runtime_endpoint import RuntimeEndpoint\n+from sglang.lang.ir import REGEX_BOOL, REGEX_FLOAT, REGEX_INT, REGEX_STR, SglSamplingParams\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestRuntimeEndpointDtypeToRegex(CustomTestCase):\n+    def setUp(self):\n+        self.endpoint = object.__new__(RuntimeEndpoint)\n+\n+    def test_int_dtype_with_str_stop(self):\n+        params = SglSamplingParams(dtype=int, stop=\"\\n\")\n+        self.endpoint._handle_dtype_to_regex(params)\n+        self.assertEqual(params.regex, REGEX_INT)\n+        self.assertEqual(params.stop, [\"\\n\", \" \", \"\\n\"])\n+\n+    def test_float_dtype_with_str_stop(self):\n+        params = SglSamplingParams(dtype=float, stop=\";\")\n+        self.endpoint._handle_dtype_to_regex(params)\n+        self.assertEqual(params.regex, REGEX_FLOAT)\n+        self.assertEqual(params.stop, [\";\", \" \", \"\\n\"])\n+\n+    def test_int_dtype_with_tuple_stop(self):\n+        params = SglSamplingParams(dtype=\"int\", stop=(\"\\n\", \",\"))\n+        self.endpoint._handle_dtype_to_regex(params)\n+        self.assertEqual(params.regex, REGEX_INT)\n+        self.assertEqual(params.stop, [\"\\n\", \",\", \" \", \"\\n\"])\n+\n+    def test_float_dtype_does_not_mutate_caller_stop_list(self):\n+        user_stop = [\"END\"]\n+        params = SglSamplingParams(dtype=\"float\", stop=user_stop)\n+        self.endpoint._handle_dtype_to_regex(params)\n+        self.assertEqual(user_stop, [\"END\"])\n+        self.assertEqual(params.stop, [\"END\", \" \", \"\\n\"])\n+\n+    def test_default_empty_tuple_stop(self):\n+        params = SglSamplingParams(dtype=int)\n+        self.endpoint._handle_dtype_to_regex(params)\n+        self.assertEqual(params.regex, REGEX_INT)\n+        self.assertEqual(params.stop, [\" \", \"\\n\"])\n+\n+    def test_str_and_bool_dtypes(self):\n+        str_params = SglSamplingParams(dtype=str, stop=\"\\n\")\n+        self.endpoint._handle_dtype_to_regex(str_params)\n+        self.assertEqual(str_params.regex, REGEX_STR)\n+        self.assertEqual(str_params.stop, [\"\\n\"])\n+\n+        bool_params = SglSamplingParams(dtype=bool)\n+        self.endpoint._handle_dtype_to_regex(bool_params)\n+        self.assertEqual(bool_params.regex, REGEX_BOOL)\n+        self.assertEqual(bool_params.stop, [])\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/682dc00139cdc8bff6b077c8a298ad5b9603da9b/test%2Fregistered%2Funit%2Flang%2Ftest_runtime_endpoint_dtype.py",
