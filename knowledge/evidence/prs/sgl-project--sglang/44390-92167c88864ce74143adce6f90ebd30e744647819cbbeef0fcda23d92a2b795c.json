  "files": [
    {
      "additions": 12,
      "blob_url": "https://github.com/sgl-project/sglang/blob/60dba2d38a5378808b17ab54b278e1b96af0af2c/docs%2Fdocs%2Freferences%2Fproduction_metrics.mdx",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fdocs%2Freferences%2Fproduction_metrics.mdx?ref=60dba2d38a5378808b17ab54b278e1b96af0af2c",
      "deletions": 0,
      "filename": "docs/docs/references/production_metrics.mdx",
      "patch": "@@ -115,6 +115,18 @@ sglang:spec_num_steps{model_name=\"meta-llama/Llama-3.1-8B-Instruct\"} 3.0\n sglang:spec_num_draft_tokens{model_name=\"meta-llama/Llama-3.1-8B-Instruct\"} 4.0\n ```\n \n+## Detokenizer router throughput\n+\n+With `--enable-metrics` and multiple detokenizer workers, the router exposes these counters:\n+\n+| Metric | Meaning |\n+| --- | --- |\n+| `sglang:detokenizer_router_messages_received_total` | Messages received from the scheduler, including control messages and idle batches. |\n+| `sglang:detokenizer_router_request_outputs_received_total` | Request entries in received output batches. Streaming outputs for the same request count again. Control messages and idle batches contribute zero. |\n+| `sglang:detokenizer_router_messages_sent_total` | Successful sends to detokenizer workers after grouping or broadcasting. |\n+\n+Use `rate()` to inspect throughput alongside `sglang:process_cpu_seconds_total{component=\"detokenizer_router\"}`. Received and sent message counts can differ because the router groups outputs by worker and broadcasts control messages. These counters do not measure queue depth or completed requests.\n+\n ## Request-level time per output token (TPOT)\n \n `sglang:request_time_per_output_token_seconds` records TPOT once per successfully finished request:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/60dba2d38a5378808b17ab54b278e1b96af0af2c/docs%2Fdocs%2Freferences%2Fproduction_metrics.mdx",
      "sha": "10db3fe839c9443cf177826a08236e501cc3bb5a",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/sgl-project/sglang/blob/60dba2d38a5378808b17ab54b278e1b96af0af2c/python%2Fsglang%2Fsrt%2Fmanagers%2Fmulti_tokenizer_mixin.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fmulti_tokenizer_mixin.py?ref=60dba2d38a5378808b17ab54b278e1b96af0af2c",
      "deletions": 2,
      "filename": "python/sglang/srt/managers/multi_tokenizer_mixin.py",
      "patch": "@@ -725,10 +725,23 @@ class MultiDetokenizerRouter:\n     ``rid`` is hashed instead.\n     \"\"\"\n \n-    def __init__(self, ipc_name_list: List[str], port_args: PortArgs):\n+    def __init__(\n+        self,\n+        ipc_name_list: List[str],\n+        port_args: PortArgs,\n+        *,\n+        enable_metrics: bool = False,\n+    ):\n         self.ipc_name_list = ipc_name_list\n         self.num_workers = len(ipc_name_list)\n         self.socket_mapping = SocketMapping()\n+        self.metrics = None\n+        if enable_metrics:\n+            from sglang.srt.observability.detokenizer_router_metrics import (\n+                DetokenizerRouterMetrics,\n+            )\n+\n+            self.metrics = DetokenizerRouterMetrics()\n         context = zmq.Context(2)\n         self.recv_from_scheduler = get_zmq_socket(\n             context, zmq.PULL, port_args.detokenizer_ipc_name, True\n@@ -739,6 +752,8 @@ def _pick(self, key: str) -> str:\n \n     def _send(self, ipc_name: str, obj: Any) -> None:\n         self.socket_mapping.send_output(ipc_name, obj, is_tokenizer=False)\n+        if self.metrics is not None:\n+            self.metrics.messages_sent.inc()\n \n     def _pick_for(self, http_worker_ipc: Optional[str], rid: str) -> str:\n         return self._pick(rid if http_worker_ipc is None else http_worker_ipc)\n@@ -767,6 +782,11 @@ def event_loop(self):\n         while True:\n             recv_obj = sock_recv(self.recv_from_scheduler)\n \n+            if self.metrics is not None:\n+                self.metrics.messages_received.inc()\n+                if isinstance(recv_obj, BaseBatchReq):\n+                    self.metrics.request_outputs_received.inc(len(recv_obj.rids))\n+\n             # Control messages must reach every detokenizer process.\n             if isinstance(recv_obj, (FreezeGCReq, ConfigureLoggingReq)):\n                 for ipc in self.ipc_name_list:\n@@ -815,7 +835,9 @@ def run_multi_detokenizer_router_process(\n     try:\n         if enable_metrics:\n             start_cpu_monitor_thread(\"detokenizer_router\")\n-        router = MultiDetokenizerRouter(ipc_name_list, port_args)\n+        router = MultiDetokenizerRouter(\n+            ipc_name_list, port_args, enable_metrics=enable_metrics\n+        )\n         router.event_loop()\n     except Exception:\n         traceback = get_exception_traceback()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/60dba2d38a5378808b17ab54b278e1b96af0af2c/python%2Fsglang%2Fsrt%2Fmanagers%2Fmulti_tokenizer_mixin.py",
      "sha": "35ba8122e3a1b5475a84f6382889b0d140d37a44",
      "status": "modified"
    },
    {
      "additions": 19,
