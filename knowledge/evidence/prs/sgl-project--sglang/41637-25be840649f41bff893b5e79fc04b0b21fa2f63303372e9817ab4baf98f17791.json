    {
      "additions": 64,
      "blob_url": "https://github.com/sgl-project/sglang/blob/67839b218c1ce8ac0f3cc2a7a3996be8fb081662/python%2Fsglang%2Fsrt%2Flayers%2Frotary_embedding%2Fbase.py",
      "changes": 64,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Frotary_embedding%2Fbase.py?ref=67839b218c1ce8ac0f3cc2a7a3996be8fb081662",
      "deletions": 0,
      "filename": "python/sglang/srt/layers/rotary_embedding/base.py",
      "patch": "@@ -18,6 +18,7 @@\n     is_cpu,\n     is_cuda,\n     is_hip,\n+    is_mlu,\n     is_mps,\n     is_musa,\n     is_npu,\n@@ -39,6 +40,7 @@\n _is_cpu = is_cpu()\n _is_xpu = is_xpu()\n _is_musa = is_musa()\n+_is_mlu = is_mlu()\n _is_mps = is_mps()\n \n if _is_cuda:\n@@ -125,6 +127,7 @@ def __init__(\n             and not (_is_xpu)\n             and not (_is_npu)\n             and not (_is_musa)\n+            and not (_is_mlu)\n             and not (_is_mps)\n             and not (current_platform.is_out_of_tree())\n         ):\n@@ -162,6 +165,8 @@ def __init__(\n                 dynamic=True,\n                 disable=_is_npu,\n             )(apply_rotary_emb)\n+        elif _is_mlu:\n+            self._forward_method = self.forward_mlu\n         self.position_cos, self.position_sin = None, None\n \n     def try_bf16_rope_store(\n@@ -530,6 +535,65 @@ def forward_cuda(\n                 )\n         return query, key\n \n+    def forward_mlu(\n+        self,\n+        positions: torch.Tensor,\n+        query: torch.Tensor,\n+        key: torch.Tensor,\n+        offsets: Optional[torch.Tensor] = None,\n+        fused_set_kv_buffer_arg: Optional[Union[FusedSetKVBufferArg, dict]] = None,\n+    ) -> Tuple[torch.Tensor, torch.Tensor]:\n+        \"\"\"Run RoPE through FlagTree's packed Cambricon Triton kernel.\"\"\"\n+        assert fused_set_kv_buffer_arg is None, (\n+            \"save kv cache is not supported by the MLU rotary kernel\"\n+        )\n+        if offsets is not None:\n+            positions = positions + offsets\n+        positions = positions.flatten().to(device=query.device, dtype=torch.int32)\n+        cos_sin = self.cos_sin_cache.to(device=query.device, dtype=query.dtype)\n+        cos, sin = (part.contiguous() for part in cos_sin.chunk(2, dim=-1))\n+        try:\n+            from triton.ops.apply_rotary import apply_rotary\n+        except (ImportError, ModuleNotFoundError):\n+            return self.forward_native(positions, query, key)\n+\n+        num_tokens = positions.numel()\n+        cu_seqlens = torch.tensor(\n+            [0, num_tokens], device=query.device, dtype=torch.int32\n+        )\n+        token_offsets = positions.view(1, num_tokens)\n+        q = query.view(num_tokens, -1, self.head_size)\n+        k = key.view(num_tokens, -1, self.head_size)\n+        q_rot, q_pass = q[..., : self.rotary_dim], q[..., self.rotary_dim :]\n+        k_rot, k_pass = k[..., : self.rotary_dim], k[..., self.rotary_dim :]\n+        q_out = torch.empty_like(q_rot)\n+        k_out = torch.empty_like(k_rot)\n+        apply_rotary(\n+            q_out,\n+            q_rot,\n+            cos,\n+            sin,\n+            BLOCK_M=2,\n+            token_offsets=token_offsets,\n+            cu_seqlens=cu_seqlens,\n+            max_seqlen=num_tokens,\n+            interleaved=not self.is_neox_style,\n+        )\n+        apply_rotary(\n+            k_out,\n+            k_rot,\n+            cos,\n+            sin,\n+            BLOCK_M=2,\n+            token_offsets=token_offsets,\n+            cu_seqlens=cu_seqlens,\n+            max_seqlen=num_tokens,\n+            interleaved=not self.is_neox_style,\n+        )\n+        q_result = torch.cat((q_out, q_pass), dim=-1)\n+        k_result = torch.cat((k_out, k_pass), dim=-1)\n+        return q_result.view_as(query), k_result.view_as(key)\n+\n     def extra_repr(self) -> str:\n         s = f\"head_size={self.head_size}, rotary_dim={self.rotary_dim}\"\n         s += f\", max_position_embeddings={self.max_position_embeddings}\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/67839b218c1ce8ac0f3cc2a7a3996be8fb081662/python%2Fsglang%2Fsrt%2Flayers%2Frotary_embedding%2Fbase.py",
      "sha": "ede0fd98cb17f6336be9ec30d429133e861b4c2b",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/sgl-project/sglang/blob/67839b218c1ce8ac0f3cc2a7a3996be8fb081662/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py?ref=67839b218c1ce8ac0f3cc2a7a3996be8fb081662",
      "deletions": 0,
      "filename": "python/sglang/srt/utils/common.py",
      "patch": "@@ -235,6 +235,18 @@ def is_musa() -> bool:\n     return True\n \n \n+@lru_cache(maxsize=1)\n+def is_mlu() -> bool:\n+    \"\"\"Return whether the Cambricon Torch backend has a visible device.\"\"\"\n+    backend = getattr(torch, \"mlu\", None)\n+    if backend is None:\n+        return False\n+    try:\n+        return bool(backend.is_available())\n+    except (OSError, RuntimeError):\n+        return False\n+\n+\n @lru_cache(maxsize=1)\n def is_mps() -> bool:\n     return hasattr(torch, \"mps\") and torch.mps.is_available()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/67839b218c1ce8ac0f3cc2a7a3996be8fb081662/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "sha": "f8759fc25eb3714b77dc7329c0f3632f3ba51776",
      "status": "modified"
    },
