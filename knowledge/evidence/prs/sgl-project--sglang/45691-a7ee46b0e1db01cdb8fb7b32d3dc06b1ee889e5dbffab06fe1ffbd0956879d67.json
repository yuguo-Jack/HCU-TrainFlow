    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4e23a406bfbee17f084a4fbf674580914d09d276/scripts%2Fci%2Famd%2Famd_ci_start_container_disagg.sh",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/scripts%2Fci%2Famd%2Famd_ci_start_container_disagg.sh?ref=4e23a406bfbee17f084a4fbf674580914d09d276",
      "deletions": 0,
      "filename": "scripts/ci/amd/amd_ci_start_container_disagg.sh",
      "patch": "@@ -308,6 +308,10 @@ add_mount_if_exists \"libmnl\" \"libmnl.so*\"\n echo \"Mount args: $MOUNT_ARGS\"\n \n echo \"Launching container: ci_sglang\"\n+# MOONCAKE_DISABLE_HIP_DMABUF=1: Mooncake >= v0.3.14 registers GPU KV buffers\n+# for RDMA through a dma-buf export. With a full-GPU KV pool (Qwen3-8B at TP1)\n+# both PD servers then fail their next stream creation with hipErrorOutOfMemory\n+# at scheduler start; plain ibv_reg_mr (the pre-v0.3.14 behavior) works here.\n docker run -dt --user root \\\n   --device=/dev/kfd \\\n   --device=/dev/dri \\\n@@ -336,6 +340,7 @@ docker run -dt --user root \\\n   -e HF_HUB_DOWNLOAD_TIMEOUT=300 \\\n   -e MIOPEN_USER_DB_PATH=/sgl-data/miopen-cache \\\n   -e MIOPEN_CUSTOM_CACHE_DIR=/sgl-data/miopen-cache \\\n+  -e MOONCAKE_DISABLE_HIP_DMABUF=\"${MOONCAKE_DISABLE_HIP_DMABUF:-1}\" \\\n   -w /sglang-checkout \\\n   --name ci_sglang \\\n   \"${IMAGE}\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4e23a406bfbee17f084a4fbf674580914d09d276/scripts%2Fci%2Famd%2Famd_ci_start_container_disagg.sh",
      "sha": "46c466cf415c4182842b0f2fa0e502d9ebe32e49",
      "status": "modified"
    }
