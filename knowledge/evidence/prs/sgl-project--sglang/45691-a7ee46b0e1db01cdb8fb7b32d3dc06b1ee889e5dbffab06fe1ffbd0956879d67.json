  "repository": "sgl-project/sglang",
  "reviews": [
    {
      "body": "Thanks for the fix. #45759 addresses the same failure the other way: it keeps dma-buf on and bounds the KV pool. Measured with a standalone HIP + ibv_reg_dmabuf_mr program, each dma-buf registration is charged against free GPU memory a second time on MI355X with ionic (100 GiB registered leaves 87 GiB free instead of 187 GiB), so the pool must be smaller than the free memory after model load. Disabling dma-buf hides this and takes the registration path real deployments use out of the tests. Please land only one of the two; I suggest #45759.",
      "html_url": "https://github.com/sgl-project/sglang/pull/45691#pullrequestreview-5622263670",
      "id": 5622263670,
      "state": "COMMENTED",
      "submitted_at": "2026-10-22T23:44:17Z",
      "user": {
        "login": "Lzy17"
      }
    }
  ]
