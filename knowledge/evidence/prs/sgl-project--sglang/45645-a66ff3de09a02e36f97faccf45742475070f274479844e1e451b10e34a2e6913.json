      "blob_url": "https://github.com/sgl-project/sglang/blob/fc47532ef24356c84e46aa6f0b6f44198b66bcbb/python%2Fsglang%2Fsrt%2Fentrypoints%2Fgrpc_bridge.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fgrpc_bridge.py?ref=fc47532ef24356c84e46aa6f0b6f44198b66bcbb",
      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/grpc_bridge.py",
      "patch": "@@ -57,6 +57,22 @@ async def is_disconnected(self) -> bool:\n         return bool(self._is_disconnected_fn())\n \n \n+def _bad_request_chunk(rid: Any, error: Exception) -> Dict[str, Any]:\n+    \"\"\"A terminal chunk carrying FINISH_ABORT's JSON with HTTP 400.\"\"\"\n+    return {\n+        \"output_ids\": [],\n+        \"meta_info\": {\n+            \"id\": rid,\n+            \"finish_reason\": {\n+                \"type\": \"abort\",\n+                \"message\": str(error),\n+                \"status_code\": 400,\n+                \"err_type\": \"BadRequestError\",\n+            },\n+        },\n+    }\n+\n+\n class RuntimeHandle:\n     \"\"\"Thin Python handle that the Rust gRPC server calls into.\n \n@@ -343,6 +359,14 @@ async def _run_generate(self, obj, chunk_callback, stream: bool, request):\n                         return\n         except StopAsyncIteration:\n             self._safe_callback(chunk_callback, {}, finished=True)\n+        except ValueError as e:\n+            # Invalid client input found while preparing the request, such as\n+            # an image that cannot be fetched or decoded. Finish with SGLang's\n+            # abort shape so the client sees a 400 rather than INTERNAL.\n+            logger.error(\"gRPC generate rejected rid=%s: %s\", obj.rid, e)\n+            self._safe_callback(\n+                chunk_callback, _bad_request_chunk(obj.rid, e), finished=True\n+            )\n         except Exception as e:\n             logger.error(\"gRPC generate error for rid=%s: %s\", obj.rid, e)\n             self._send_native_error(chunk_callback, str(e))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fc47532ef24356c84e46aa6f0b6f44198b66bcbb/python%2Fsglang%2Fsrt%2Fentrypoints%2Fgrpc_bridge.py",
      "sha": "9c45631b995577b6d78da2e078d604fa7bc117bf",
      "status": "modified"
    },
    {
      "additions": 30,
      "blob_url": "https://github.com/sgl-project/sglang/blob/fc47532ef24356c84e46aa6f0b6f44198b66bcbb/test%2Fregistered%2Funit%2Fentrypoints%2Ftest_grpc_bridge.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Ftest_grpc_bridge.py?ref=fc47532ef24356c84e46aa6f0b6f44198b66bcbb",
      "deletions": 1,
      "filename": "test/registered/unit/entrypoints/test_grpc_bridge.py",
      "patch": "@@ -28,11 +28,14 @@ def __call__(self, payload, *, finished=False, error=None):\n \n \n class _FakeTokenizerManager:\n-    def __init__(self, responses):\n+    def __init__(self, responses, error=None):\n         self.responses = responses\n+        self.error = error\n \n     def generate_request(self, obj, request=None):\n         async def generate():\n+            if self.error is not None:\n+                raise self.error\n             for response in self.responses:\n                 yield response\n \n@@ -136,6 +139,32 @@ async def handle_request(self, request, raw_request):\n         self.assertEqual(json.loads(payload)[0][\"score\"], 0.5)\n \n \n+class TestNativeGrpcErrors(CustomTestCase):\n+    def _run(self, error, stream):\n+        callback = _RecordingCallback()\n+        handle = RuntimeHandle.__new__(RuntimeHandle)\n+        handle.tokenizer_manager = _FakeTokenizerManager([], error=error)\n+        obj = SimpleNamespace(rid=\"rid-1\", sampling_params={})\n+        asyncio.run(handle._run_generate(obj, callback, stream=stream, request=None))\n+        return callback.calls\n+\n+    def test_invalid_input_finishes_with_bad_request_abort(self):\n+        for stream in (False, True):\n+            calls = self._run(ValueError(\"cannot load image\"), stream)\n+            self.assertEqual(len(calls), 1)\n+            payload, finished, error = calls[0]\n+            self.assertTrue(finished)\n+            self.assertIsNone(error)\n+            reason = payload[\"meta_info\"][\"finish_reason\"]\n+            self.assertEqual(reason[\"type\"], \"abort\")\n+            self.assertEqual(reason[\"status_code\"], 400)\n+            self.assertIn(\"cannot load image\", reason[\"message\"])\n+\n+    def test_server_failure_stays_an_error(self):\n+        calls = self._run(RuntimeError(\"scheduler died\"), stream=False)\n+        self.assertEqual(calls, [({}, True, \"scheduler died\")])\n+\n+\n class TestEngineStateNotifications(CustomTestCase):\n     def setUp(self):\n         self.manager = TokenizerManager.__new__(TokenizerManager)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fc47532ef24356c84e46aa6f0b6f44198b66bcbb/test%2Fregistered%2Funit%2Fentrypoints%2Ftest_grpc_bridge.py",
