      "blob_url": "https://github.com/sgl-project/sglang/blob/b709b178b5452478aeea6d958aea77b0affe863a/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fprotocol.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fprotocol.py?ref=b709b178b5452478aeea6d958aea77b0affe863a",
      "deletions": 5,
      "filename": "python/sglang/srt/entrypoints/anthropic/protocol.py",
      "patch": "@@ -262,6 +262,7 @@ class AnthropicThinkingParam(BaseModel):\n     Mirrors the SDK's ``thinking_config_{enabled,disabled,adaptive}_param.py``\n     variants. ``budget_tokens`` and ``display=\"omitted\"``/``\"updates\"`` are\n     accepted for SDK compatibility but not enforced; the serving layer logs them.\n+    Some Anthropic-compatible clients omit ``budget_tokens`` on ``enabled``.\n     \"\"\"\n \n     type: Literal[\"enabled\", \"disabled\", \"adaptive\"]\n@@ -272,11 +273,7 @@ class AnthropicThinkingParam(BaseModel):\n     def _validate_thinking_shape(self):\n         # Cross-field rules mirror the SDK's three discriminated variants.\n         if self.type == \"enabled\":\n-            if self.budget_tokens is None:\n-                raise ValueError(\n-                    \"thinking.budget_tokens is required when thinking.type is 'enabled'\"\n-                )\n-            if self.budget_tokens < 1024:\n+            if self.budget_tokens is not None and self.budget_tokens < 1024:\n                 raise ValueError(\n                     \"thinking.budget_tokens must be >= 1024 (got {})\".format(\n                         self.budget_tokens",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b709b178b5452478aeea6d958aea77b0affe863a/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fprotocol.py",
      "sha": "37fd0cf04fe0658a769042d87b193591c7c64a70",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b709b178b5452478aeea6d958aea77b0affe863a/sgl-router%2Fsrc%2Fprotocol%2Fanthropic%2Frequest.rs",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/sgl-router%2Fsrc%2Fprotocol%2Fanthropic%2Frequest.rs?ref=b709b178b5452478aeea6d958aea77b0affe863a",
      "deletions": 4,
      "filename": "sgl-router/src/protocol/anthropic/request.rs",
      "patch": "@@ -197,9 +197,7 @@ fn thinking_enabled(thinking: &Value) -> Result<bool, String> {\n     };\n     match thinking.get(\"type\").and_then(Value::as_str) {\n         Some(\"enabled\") => match budget.map(Value::as_i64) {\n-            None => {\n-                Err(\"thinking.budget_tokens is required when thinking.type is 'enabled'\".into())\n-            }\n+            None => Ok(true),\n             Some(Some(n)) if n >= 1024 => Ok(true),\n             Some(Some(n)) => Err(format!(\"thinking.budget_tokens must be >= 1024 (got {n})\")),\n             Some(None) => Err(\"thinking.budget_tokens: must be an integer\".into()),\n@@ -944,9 +942,9 @@ mod tests {\n             with(json!({\"type\": \"adaptive\", \"display\": \"omitted\"})),\n             Ok(json!(true))\n         );\n+        assert_eq!(with(json!({\"type\": \"enabled\"})), Ok(json!(true)));\n         assert_eq!(with(json!({\"type\": \"disabled\"})), Ok(json!(false)));\n         for (thinking, needle) in [\n-            (json!({\"type\": \"enabled\"}), \"required\"),\n             (json!({\"type\": \"enabled\", \"budget_tokens\": 1023}), \">= 1024\"),\n             (\n                 json!({\"type\": \"disabled\", \"budget_tokens\": 2048}),",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b709b178b5452478aeea6d958aea77b0affe863a/sgl-router%2Fsrc%2Fprotocol%2Fanthropic%2Frequest.rs",
      "sha": "a85b39ab0c7f6eac473b92b7e71ae0f5fa69b87e",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b709b178b5452478aeea6d958aea77b0affe863a/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py?ref=b709b178b5452478aeea6d958aea77b0affe863a",
      "deletions": 1,
      "filename": "test/registered/unit/entrypoints/anthropic/test_serving.py",
      "patch": "@@ -907,12 +907,17 @@ def test_request_thinking_enabled_with_budget_tokens_logs_warning(self):\n             f\"expected unenforced-budget warning: {log.output}\",\n         )\n \n+    def test_request_thinking_enabled_without_budget_tokens_is_accepted(self):\n+        serving = self._serving()\n+        request = self._anthropic_request(thinking={\"type\": \"enabled\"}, stream=False)\n+        serving._convert_to_chat_completion_request(request)\n+        self.assertEqual(serving.openai_serving_chat.apply_reasoning_calls, [True])\n+\n     def test_request_thinking_shape_violations_are_rejected(self):\n         \"\"\"Each SDK thinking variant's field rules (``thinking_config_*_param.py``).\"\"\"\n         from pydantic import ValidationError\n \n         for thinking, field in [\n-            ({\"type\": \"enabled\"}, \"budget_tokens\"),\n             ({\"type\": \"enabled\", \"budget_tokens\": 512}, \"1024\"),\n             ({\"type\": \"disabled\", \"display\": \"omitted\"}, \"display\"),\n             ({\"type\": \"disabled\", \"budget_tokens\": 2048}, \"budget_tokens\"),",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b709b178b5452478aeea6d958aea77b0affe863a/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py",
      "sha": "12b2803fbcb78c67c5dd9198bbf786bd294c06c6",
      "status": "modified"
    }
