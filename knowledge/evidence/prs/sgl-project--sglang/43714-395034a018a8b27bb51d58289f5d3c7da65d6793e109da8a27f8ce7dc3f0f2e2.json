      "blob_url": "https://github.com/sgl-project/sglang/blob/fb711b2ccc8be6a08fc0e61565528d241121f469/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Fconfig.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Fconfig.py?ref=fb711b2ccc8be6a08fc0e61565528d241121f469",
      "deletions": 2,
      "filename": "python/sglang/srt/utils/hf_transformers/config.py",
      "patch": "@@ -60,6 +60,7 @@ def _apply_deepseek_ocr_overrides(config, model):\n \n _GEMMA4_MODEL_TYPES = (\n     \"gemma4\",\n+    \"gemma4_text\",\n     \"gemma4_assistant\",\n     \"gemma4_unified\",\n     \"gemma4_unified_assistant\",\n@@ -110,7 +111,8 @@ def _gemma4_attention_shapes(text_config) -> dict[str, tuple[int, int]]:\n def _apply_gemma4_attention_overrides(config):\n     # Gemma4 states its shapes SWA-first: base attributes are the sliding-window\n     # values and full-attention overrides them; SGLang's base is full attention.\n-    text_config = config.text_config\n+    # A text-only checkpoint (Gemma4ForCausalLM) is its own text config.\n+    text_config = getattr(config, \"text_config\", None) or config\n \n     if text_config.is_heterogeneous:\n         # transformers states that split as a `per_layer_config`, and\n@@ -252,7 +254,12 @@ def parse(\n \n         text_config = get_hf_text_config(config=config)\n \n-        if isinstance(model, str) and text_config is not None:\n+        # A text-only config is its own text config, so there is nothing to copy.\n+        if (\n+            isinstance(model, str)\n+            and text_config is not None\n+            and text_config is not config\n+        ):\n             items = (\n                 text_config.items()\n                 if hasattr(text_config, \"items\")",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fb711b2ccc8be6a08fc0e61565528d241121f469/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Fconfig.py",
      "sha": "ba0baeba834ffe248c4e3abe9205d0c38e10d50c",
      "status": "modified"
    },
    {
      "additions": 27,
      "blob_url": "https://github.com/sgl-project/sglang/blob/fb711b2ccc8be6a08fc0e61565528d241121f469/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py?ref=fb711b2ccc8be6a08fc0e61565528d241121f469",
      "deletions": 0,
      "filename": "test/registered/unit/utils/test_hf_transformers.py",
      "patch": "@@ -886,6 +886,33 @@ def test_layer_type_with_more_than_one_shape_is_rejected(self):\n         with self.assertRaisesRegex(ValueError, \"single shape per layer type\"):\n             _apply_gemma4_attention_overrides(config)\n \n+    def test_text_only_checkpoint_gets_the_same_overrides(self):\n+        \"\"\"A text-only Gemma4ForCausalLM export has no `text_config`; its own\n+        config must still carry the full-attention head dim (#43434).\"\"\"\n+        from transformers import Gemma4TextConfig\n+\n+        from sglang.srt.utils.hf_transformers.config import get_config\n+\n+        text_config = Gemma4TextConfig(\n+            num_hidden_layers=6,\n+            head_dim=128,\n+            global_head_dim=256,\n+            num_key_value_heads=2,\n+            num_global_key_value_heads=4,\n+            attention_k_eq_v=True,\n+            architectures=[\"Gemma4ForCausalLM\"],\n+        )\n+        with tempfile.TemporaryDirectory() as model_dir:\n+            text_config.save_pretrained(model_dir)\n+            config = get_config(model_dir, trust_remote_code=False)\n+\n+        self.assertEqual(config.model_type, \"gemma4_text\")\n+        self.assertFalse(config.is_heterogeneous)\n+        self.assertEqual(config.head_dim, 256)\n+        self.assertEqual(config.num_key_value_heads, 4)\n+        self.assertEqual(config.swa_head_dim, 128)\n+        self.assertEqual(config.swa_num_key_value_heads, 2)\n+\n \n class TestNormalizeTpStyle(CustomTestCase):\n     \"\"\"Every style a shipped TP plan can name must normalize; a tied-embedding",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fb711b2ccc8be6a08fc0e61565528d241121f469/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py",
      "sha": "e02f059042d35ed89df1e384001480795eaa2f39",
      "status": "modified"
    }
