      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=f5acd5197f0edf9901faa840ecd0c9956e4958b7",
      "deletions": 6,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -3556,12 +3556,16 @@ def _poll_timeout_aborts(self) -> List[AbortReq]:\n \n         if (timeout_s := envs.SGLANG_REQ_RUNNING_TIMEOUT.get()) > 0:\n             deadline = time.perf_counter() - timeout_s\n-            inflight_batches = self._collect_inflight_batches()\n+            req_groups = [\n+                batch.reqs\n+                for batch in self._collect_inflight_batches()\n+                if batch is not None\n+            ]\n+            if self.dllm_config is not None:\n+                req_groups.append(self.dllm_manager.waiting_queue)\n             seen_rids = set()\n-            for batch in inflight_batches:\n-                if batch is None:\n-                    continue\n-                for req in batch.reqs:\n+            for reqs in req_groups:\n+                for req in reqs:\n                     # Polling must not re-emit an abort awaiting result processing.\n                     if (\n                         req.rid in seen_rids\n@@ -5600,7 +5604,7 @@ def abort_request(self, recv_req: AbortReq):\n             ):\n                 self._release_aborted_request(req)\n                 self.ipc_channels.send_to_tokenizer.send_output(\n-                    _make_abort_req(req), req\n+                    _make_abort_req(req, finished_reason=recv_req.finished_reason), req\n                 )\n                 if req.kv.holds_kv or req.kv.holds_mamba:\n                     release_kv_cache(req, self.tree_cache, checkpoint=False)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f5acd5197f0edf9901faa840ecd0c9956e4958b7/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "c11445bebfbfb9061b4c5d155f6032b9067814d0",
      "status": "modified"
    },
    {
      "additions": 50,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f5acd5197f0edf9901faa840ecd0c9956e4958b7/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py?ref=f5acd5197f0edf9901faa840ecd0c9956e4958b7",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_scheduler_timeouts.py",
      "patch": "@@ -24,6 +24,7 @@\n \n maybe_stub_sgl_kernel()\n \n+from sglang.srt.dllm.mixin.scheduler import DllmManager\n from sglang.srt.managers.schedule_batch import FINISH_ABORT, Req\n from sglang.srt.managers.scheduler import Scheduler\n from sglang.srt.mem_cache.base_prefix_cache import (\n@@ -72,6 +73,7 @@ def _scheduler(waiting_queue, running_reqs=(), last_batch_reqs=()):\n     s.enable_continuous_input_polling = False\n     s.result_queue = deque()\n     s.waiting_queue = waiting_queue\n+    s.dllm_config = None\n     s.enable_hierarchical_cache = False\n     s.enable_hicache_storage = False\n     s.enable_unified_cache_external_linker = False\n@@ -143,6 +145,54 @@ class TestRunningTimeout(CustomTestCase):\n     def setUp(self):\n         enter_scope(self, published_topology())\n \n+    def test_dllm_running_timeout_for_manager_held_reqs(self):\n+        \"\"\"Between-round timeouts must preserve their reason through abort cleanup.\"\"\"\n+        now = time.perf_counter()\n+        stale = _req(\"stale\", forward_entry=now - 10)\n+        fresh = _req(\"fresh\", forward_entry=now)\n+        unstarted = _req(\"unstarted\", forward_entry=0.0)\n+        reqs = [stale, fresh, unstarted]\n+        s = _scheduler([])\n+        s.dllm_config = SimpleNamespace(max_running_requests=3)\n+        s.dllm_manager = DllmManager(s.dllm_config)\n+        s.dllm_manager.waiting_queue = list(reqs)\n+\n+        with envs.SGLANG_REQ_RUNNING_TIMEOUT.override(1.0):\n+            aborts = s._poll_timeout_aborts()\n+            self.assertEqual([a.rid for a in aborts], [\"stale\"])\n+            self.assertEqual(s.dllm_manager.waiting_queue, reqs)\n+            s.running_batch = _batch([stale])\n+            self.assertEqual([a.rid for a in s._poll_timeout_aborts()], [\"stale\"])\n+\n+        self.assertEqual(s.dllm_manager.waiting_queue, reqs)\n+        s.running_batch = _batch([])\n+        s.chunked_req = None\n+        s.mm_receiver = None\n+        s.disaggregation_mode = DisaggregationMode.NULL\n+        s.grammar_manager = MagicMock()\n+        s.tree_cache = MagicMock(spec=[\"finish\"])\n+        stale.kv = SimpleNamespace(holds_kv=False, holds_mamba=False)\n+        with patch(\n+            \"sglang.srt.managers.scheduler.get_serving\",\n+            return_value=SimpleNamespace(weight_version=\"v0\"),\n+        ):\n+            s.abort_request(aborts[0])\n+\n+        sent_abort, sent_req = (\n+            s.ipc_channels.send_to_tokenizer.send_output.call_args.args\n+        )\n+        self.assertIs(sent_req, stale)\n+        self.assertEqual(sent_abort.rid, \"stale\")\n+        self.assertEqual(\n+            sent_abort.finished_reason,\n+            {\n+                \"type\": \"abort\",\n+                \"status_code\": 503,\n+                \"message\": \"Request running timeout reached.\",\n+            },\n+        )\n+        self.assertEqual(s.dllm_manager.waiting_queue, [fresh, unstarted])\n+\n     def test_emits_only_stale_unfinished_reqs_without_marking(self):\n         now = time.perf_counter()\n         stale = _req(\"stale\", forward_entry=now - 10)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f5acd5197f0edf9901faa840ecd0c9956e4958b7/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py",
