      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fglm4_moe_detector.py?ref=840706eff801bfec795b1b206d66ac19d8cca20a",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/glm4_moe_detector.py",
      "patch": "@@ -105,6 +105,17 @@ def parse_arguments(\n         if arg_type == \"number\" and isinstance(parsed_value, str):\n             parsed_value = _convert_to_number(parsed_value)\n \n+        # A string-typed parameter whose JSON value is a bare scalar (an\n+        # unquoted numeric id like 123, or true/null) must keep the raw text\n+        # the model emitted; str() would mangle it (\"True\", \"None\"). Dict and\n+        # list values fall through so the caller can re-serialize them.\n+        if (\n+            arg_type == \"string\"\n+            and not isinstance(parsed_value, str)\n+            and not isinstance(parsed_value, (dict, list))\n+        ):\n+            return json_value, True\n+\n         return parsed_value, True\n     except (json.JSONDecodeError, ValueError):\n         pass\n@@ -117,6 +128,13 @@ def parse_arguments(\n         if arg_type == \"number\" and isinstance(parsed_value, str):\n             parsed_value = _convert_to_number(parsed_value)\n \n+        if (\n+            arg_type == \"string\"\n+            and not isinstance(parsed_value, str)\n+            and not isinstance(parsed_value, (dict, list))\n+        ):\n+            return json_value, True\n+\n         return parsed_value, True\n     except (json.JSONDecodeError, ValueError, KeyError):\n         pass",
      "raw_url": "https://github.com/sgl-project/sglang/raw/840706eff801bfec795b1b206d66ac19d8cca20a/python%2Fsglang%2Fsrt%2Ffunction_call%2Fglm4_moe_detector.py",
      "sha": "adee8d4702e700f3b01ce3b657ac65c3110493aa",
