      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Fmoe_runner%2Ftriton_utils%2Ffused_moe.py?ref=c9da69af495b11cab01f26a90c77d4fda0ae2e70",
      "deletions": 3,
      "filename": "python/sglang/srt/layers/moe/moe_runner/triton_utils/fused_moe.py",
      "patch": "@@ -761,10 +761,13 @@ def _fused_moe_kernel_sequence(\n \n             if filter_expert:\n                 swiglu_limit_for_triton = swiglu_limit\n+            elif _is_hip:\n+                # No fused silu_and_mul_clamp on HIP. Clamp the scratch gate/up\n+                # halves in place, then run the regular silu_and_mul below.\n+                gate_up = intermediate_cache1.view(-1, N)\n+                gate_up[:, : N // 2].clamp_(max=swiglu_limit)\n+                gate_up[:, N // 2 :].clamp_(min=-swiglu_limit, max=swiglu_limit)\n             else:\n-                assert _is_cuda or _is_xpu, (\n-                    \"fused silu_and_mul_clamp kernel is CUDA/XPU only; HIP must disable SWIGLU_CLAMP_FUSION\"\n-                )\n                 swiglu_limit_for_silu_and_mul_clamp = swiglu_limit\n \n             if not filter_expert:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c9da69af495b11cab01f26a90c77d4fda0ae2e70/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Fmoe_runner%2Ftriton_utils%2Ffused_moe.py",
