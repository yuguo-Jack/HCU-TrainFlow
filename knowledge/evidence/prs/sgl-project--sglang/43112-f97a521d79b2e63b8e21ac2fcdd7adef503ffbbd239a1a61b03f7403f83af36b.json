      "filename": "python/sglang/srt/entrypoints/anthropic/serving.py",
      "patch": "@@ -684,6 +684,8 @@ def _emit_user_message(parts: list[dict]) -> None:\n         # would deceive the caller, so raise an explicit 400.\n         if anthropic_request.tool_choice is not None:\n             tc_type = anthropic_request.tool_choice.type\n+            if anthropic_request.tool_choice.disable_parallel_tool_use:\n+                chat_request.parallel_tool_calls = False\n             if tc_type == \"none\":\n                 chat_request.tool_choice = \"none\"\n             elif chat_request.tools:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8916e770507341b5513db468eb55968559646823/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fserving.py",
