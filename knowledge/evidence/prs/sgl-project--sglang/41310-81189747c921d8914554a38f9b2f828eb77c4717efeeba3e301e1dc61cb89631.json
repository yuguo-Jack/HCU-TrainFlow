      "patch": "@@ -113,7 +113,11 @@ def kill_process_tree(\n     except psutil.NoSuchProcess:\n         return\n \n-    children = itself.children(recursive=True)\n+    try:\n+        children = itself.children(recursive=True)\n+    except psutil.NoSuchProcess:\n+        # The parent can exit after Process() succeeds but before traversal.\n+        return\n     killed = []\n     for child in children:\n         if child.pid == skip_pid:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a4fd30941c4b2f0e420f55b5135cb746b1d32c4d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Futils%2Fprocess.py",
