  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0e80880065bc24b3b0872f4b6d1ea7a1bcb81500/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100.py?ref=0e80880065bc24b3b0872f4b6d1ea7a1bcb81500",
      "deletions": 2,
      "filename": "python/sglang/kernels/ops/attention/dsv4/decode_attention_sm100.py",
      "patch": "@@ -11,6 +11,8 @@\n \n LAYOUT = KVLayout.V4\n MAX_BATCH = 8\n+# SM100 row cap, below the ~48-row break-even against FlashMLA.\n+MAX_ROWS = 40\n NUM_HEADS = 16\n HEAD_DIM = 512\n SOFTMAX_SCALE = HEAD_DIM**-0.5\n@@ -26,7 +28,7 @@ def can_use_swapab_attention(\n ) -> bool:\n     \"\"\"The caller adds the SM100 and single-query forward-mode gates.\"\"\"\n     return (\n-        0 < q.shape[0] <= MAX_BATCH\n+        0 < q.shape[0] <= MAX_ROWS\n         and num_heads == NUM_HEADS\n         and q.dtype == torch.bfloat16\n         and q.shape[-1] == HEAD_DIM\n@@ -115,7 +117,7 @@ def swapab_attention(\n     block = 64\n     b, h, d = q.shape[0], q.shape[-2], q.shape[-1]\n     assert q.ndim in (3, 4) and (q.ndim == 3 or q.shape[1] == 1)\n-    assert 0 < b <= MAX_BATCH and h == NUM_HEADS and d == HEAD_DIM\n+    assert 0 < b <= MAX_ROWS and h == NUM_HEADS and d == HEAD_DIM\n     assert q.dtype == torch.bfloat16 and q.stride(-1) == 1\n     assert kv.shape[-1] == LAYOUT.bytes_per_token\n     assert kv.dtype in (torch.uint8, torch.float8_e4m3fn)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0e80880065bc24b3b0872f4b6d1ea7a1bcb81500/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdsv4%2Fdecode_attention_sm100.py",
      "sha": "54747e8e3856110cf1076fdc29ec061e85b34076",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0e80880065bc24b3b0872f4b6d1ea7a1bcb81500/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Fdsv4%2Ftest_swapab_attention.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Fdsv4%2Ftest_swapab_attention.py?ref=0e80880065bc24b3b0872f4b6d1ea7a1bcb81500",
      "deletions": 4,
      "filename": "test/registered/kernels/ops/attention/dsv4/test_swapab_attention.py",
      "patch": "@@ -98,13 +98,13 @@ def check_case(self, b, page, nk, ne, graph=False):\n         )\n         ei = ei_storage[..., :ne]\n         lengths = torch.tensor(\n-            [0, 1, 31, 63, 64, nk - 1, nk, nk + 3][:b], device=\"cuda\", dtype=torch.int32\n-        )\n+            [0, 1, 31, 63, 64, nk - 1, nk, nk + 3] * 5, device=\"cuda\", dtype=torch.int32\n+        )[:b]\n         el = torch.tensor(\n-            [ne, ne // 2, 1, 0, 63, ne - 1, 65, ne][:b],\n+            [ne, ne // 2, 1, 0, 63, ne - 1, 65, ne] * 5,\n             device=\"cuda\",\n             dtype=torch.int32,\n-        )\n+        )[:b]\n         sink = torch.randn(64, device=\"cuda\")\n         sink[0], sink[1], sink[2] = -torch.inf, torch.inf, 20.0\n         originals = [x.clone() for x in (raw, extra_raw, ids, ei, q, lengths, el, sink)]\n@@ -222,6 +222,14 @@ def test_packed_pages_and_sink(self):\n     def test_dynamic_graph_replay(self):\n         self.check_case(6, 64, 192, 512, graph=True)\n \n+    @unittest.skipIf(is_hip(), \"the gfx950 kernel keeps the 8-row cap\")\n+    def test_rows_up_to_cap(self):\n+        \"\"\"SM100 admits up to 40 rows: DSpark verify at TP4 bs <= 8.\"\"\"\n+        for case in ((20, 16, 133, 0), (40, 128, 192, 1024)):\n+            with self.subTest(case=case):\n+                self.check_case(*case)\n+        self.check_case(40, 64, 192, 512, graph=True)\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0e80880065bc24b3b0872f4b6d1ea7a1bcb81500/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Fdsv4%2Ftest_swapab_attention.py",
      "sha": "cc7d2e6690ee6e2e4d9f381ad7b72a3fd48fb087",
      "status": "modified"
    }
