      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/aaa8931743d4ff0908e29a85bfa4c5cb8908e2a9/python%2Fsglang%2Fsrt%2Fmanagers%2Fasync_d2h_copy_worker.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fasync_d2h_copy_worker.py?ref=aaa8931743d4ff0908e29a85bfa4c5cb8908e2a9",
      "deletions": 2,
      "filename": "python/sglang/srt/managers/async_d2h_copy_worker.py",
      "patch": "@@ -5,6 +5,8 @@\n import threading\n from typing import Callable, Optional\n \n+from sglang.srt.utils.common import DynamicGradMode\n+\n logger = logging.getLogger(__name__)\n \n \n@@ -88,10 +90,11 @@ def _loop(self):\n                 # Event-sync, not a stream wait: a stream wait would re-expose\n                 # the caller's thread to the blocking copy.\n                 src_ready.synchronize()\n-                with self.device_module.stream(self.d2h_copy_stream):\n+                # Grad mode is thread-local; use the scheduler's policy here too.\n+                with DynamicGradMode(), self.device_module.stream(self.d2h_copy_stream):\n                     copy_fn()\n                 self.d2h_copy_stream.synchronize()\n-            except Exception as e:\n+            except BaseException as e:\n                 logger.exception(\"AsyncD2HCopyWorker copy failed\")\n                 error = e\n             finally:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aaa8931743d4ff0908e29a85bfa4c5cb8908e2a9/python%2Fsglang%2Fsrt%2Fmanagers%2Fasync_d2h_copy_worker.py",
      "sha": "0f476c28a8f657ca8e14d540bb924a9000c7e380",
      "status": "modified"
    },
    {
      "additions": 36,
      "blob_url": "https://github.com/sgl-project/sglang/blob/aaa8931743d4ff0908e29a85bfa4c5cb8908e2a9/test%2Fregistered%2Funit%2Fmanagers%2Ftest_async_d2h_copy_worker.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_async_d2h_copy_worker.py?ref=aaa8931743d4ff0908e29a85bfa4c5cb8908e2a9",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_async_d2h_copy_worker.py",
      "patch": "@@ -19,6 +19,7 @@\n from sglang.srt.environ import envs\n from sglang.srt.managers.async_d2h_copy_worker import AsyncD2HCopyWorker, HostCopyDone\n from sglang.srt.utils.common import (\n+    DynamicGradMode,\n     async_d2h,\n     is_confidential_compute,\n     is_pin_memory_available,\n@@ -99,6 +100,41 @@ def boom():\n         with self.assertRaises(RuntimeError):\n             done.synchronize()\n \n+    def test_base_exception_is_reported_and_later_copies_complete(self):\n+        \"\"\"A callback exit must not look successful or strand subsequent copies.\"\"\"\n+        failure = SystemExit(\"injected copy exit\")\n+\n+        def boom():\n+            raise failure\n+\n+        done = self.worker.submit(boom)\n+        self.assertTrue(done._done.wait(timeout=30), \"worker did not signal completion\")\n+        with self.assertRaises(RuntimeError) as raised:\n+            done.synchronize()\n+        self.assertIs(raised.exception.__cause__, failure)\n+        self._run_one(4)\n+\n+    def test_copy_uses_scheduler_grad_mode(self):\n+        \"\"\"The new thread must not attach autograd history to host readbacks.\"\"\"\n+        src = torch.ones(4, device=\"cuda\", requires_grad=True)\n+        out = {}\n+        with DynamicGradMode():\n+            expected_inference_mode = torch.is_inference_mode_enabled()\n+\n+        def copy_fn():\n+            out[\"grad_enabled\"] = torch.is_grad_enabled()\n+            out[\"inference_mode\"] = torch.is_inference_mode_enabled()\n+            out[\"cpu\"] = src.to(\"cpu\", non_blocking=True)\n+\n+        done = self.worker.submit(copy_fn)\n+        self.assertTrue(done._done.wait(timeout=30), \"worker did not signal completion\")\n+        done.synchronize()\n+        self.assertFalse(out[\"grad_enabled\"])\n+        self.assertEqual(out[\"inference_mode\"], expected_inference_mode)\n+        self.assertFalse(out[\"cpu\"].requires_grad)\n+        self.assertIsNone(out[\"cpu\"].grad_fn)\n+        self.assertTrue(torch.equal(out[\"cpu\"], torch.ones(4)))\n+\n \n class TestConfidentialComputeDetection(CustomTestCase):\n     \"\"\"CC detection env override. Does not require CUDA (override short-circuits).\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aaa8931743d4ff0908e29a85bfa4c5cb8908e2a9/test%2Fregistered%2Funit%2Fmanagers%2Ftest_async_d2h_copy_worker.py",
      "sha": "e86cc94768b1d7a06a90c6dd00ed4453697d337f",
      "status": "modified"
    }
