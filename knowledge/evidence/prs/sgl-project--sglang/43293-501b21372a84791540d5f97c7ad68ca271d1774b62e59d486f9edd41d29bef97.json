  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3284009453ff3158e49996e0ea3cdf34907cca6d/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Fcommon.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Fcommon.py?ref=3284009453ff3158e49996e0ea3cdf34907cca6d",
      "deletions": 5,
      "filename": "python/sglang/srt/utils/hf_transformers/common.py",
      "patch": "@@ -580,11 +580,10 @@ def get_hf_text_config(config: PretrainedConfig):\n         # qwen2.5 omni\n         thinker_config = config.thinker_config\n         if hasattr(thinker_config, \"text_config\"):\n-            setattr(\n-                thinker_config.text_config,\n-                \"dtype\",\n-                getattr(thinker_config, \"dtype\", None),\n-            )\n+            if getattr(thinker_config.text_config, \"dtype\", None) is None:\n+                thinker_config.text_config.dtype = getattr(\n+                    thinker_config, \"dtype\", None\n+                )\n             text_config = thinker_config.text_config\n         else:\n             text_config = thinker_config",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3284009453ff3158e49996e0ea3cdf34907cca6d/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Fcommon.py",
      "sha": "16ccb431cf0588e390e3cf75514dee814ca03677",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3284009453ff3158e49996e0ea3cdf34907cca6d/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py?ref=3284009453ff3158e49996e0ea3cdf34907cca6d",
      "deletions": 0,
      "filename": "test/registered/unit/utils/test_hf_transformers.py",
      "patch": "@@ -529,6 +529,38 @@ def test_thinker_config_with_text_sub_config(self):\n         self.assertIs(result, inner_text)\n         self.assertEqual(inner_text.torch_dtype, \"float16\")\n \n+    def test_thinker_config_preserves_text_sub_config_dtype_when_thinker_dtype_is_none(self):\n+        # Issue #43157: thinker_config without dtype should not erase existing dtype on text_config\n+        import torch\n+\n+        inner_text = PretrainedConfig(num_attention_heads=8, dtype=torch.bfloat16)\n+        thinker_cfg = PretrainedConfig()\n+        thinker_cfg.text_config = inner_text\n+        cfg = PretrainedConfig()\n+        cfg.architectures = [\"Qwen2_5OmniForConditionalGeneration\"]\n+        cfg.thinker_config = thinker_cfg\n+\n+        result = get_hf_text_config(cfg)\n+        self.assertIs(result, inner_text)\n+        self.assertEqual(result.dtype, torch.bfloat16)\n+        self.assertEqual(inner_text.dtype, torch.bfloat16)\n+\n+    def test_thinker_config_propagates_dtype_when_text_sub_config_dtype_is_none(self):\n+        import torch\n+\n+        inner_text = PretrainedConfig(num_attention_heads=8)\n+        self.assertIsNone(getattr(inner_text, \"dtype\", None))\n+        thinker_cfg = PretrainedConfig(dtype=torch.float16)\n+        thinker_cfg.text_config = inner_text\n+        cfg = PretrainedConfig()\n+        cfg.architectures = [\"Qwen2_5OmniForConditionalGeneration\"]\n+        cfg.thinker_config = thinker_cfg\n+\n+        result = get_hf_text_config(cfg)\n+        self.assertIs(result, inner_text)\n+        self.assertEqual(result.dtype, torch.float16)\n+        self.assertEqual(inner_text.dtype, torch.float16)\n+\n     def test_converts_dict_sub_config(self):\n         cfg = PretrainedConfig()\n         cfg.architectures = [\"SomeModel\"]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3284009453ff3158e49996e0ea3cdf34907cca6d/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py",
      "sha": "36810518f01be847bb7d852c934be147d26745bd",
      "status": "modified"
