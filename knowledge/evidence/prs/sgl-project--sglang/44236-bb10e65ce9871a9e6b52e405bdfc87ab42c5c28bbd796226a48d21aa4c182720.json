      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fmetrics_reporter.py?ref=d11da7aa15b71564eb47383fb6c6f12ac0f3a6bf",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/scheduler_components/metrics_reporter.py",
      "patch": "@@ -998,7 +998,9 @@ def report_decode_stats(\n \n         if self.scheduler.disaggregation_mode == DisaggregationMode.DECODE:\n             self._update_decode_queue_stats(self.scheduler.enable_priority_scheduling)\n-            msg += f\"pre-allocated usage: {self.scheduler.disagg_decode_prealloc_queue.num_tokens_pre_allocated / self.scheduler.max_total_num_tokens:.2f}, \"\n+            msg += (\n+                f\"pre-allocated usage: {self.stats.pending_prealloc_token_usage:.2f}, \"\n+            )\n             msg += f\"#prealloc-req: {len(self.scheduler.disagg_decode_prealloc_queue.queue)}, \"\n             msg += f\"#transfer-req: {len(self.scheduler.disagg_decode_transfer_queue.queue)}, \"\n             if get_disagg().disaggregation_decode_host_receive_threshold < 1:\n@@ -1425,6 +1427,10 @@ def _update_decode_queue_stats(self, priority_enabled: bool) -> None:\n         self.stats.num_decode_host_receive_queue_reqs = QueueCount.from_reqs(\n             host_reqs, priority_enabled\n         )\n+        self.stats.pending_prealloc_token_usage = (\n+            self.scheduler.disagg_decode_prealloc_queue.num_tokens_pre_allocated\n+            / self.scheduler.max_total_num_tokens\n+        )\n \n     def _maybe_log_idle_metrics(self):\n         \"\"\"Reset forward timing and publish idle metrics when needed.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d11da7aa15b71564eb47383fb6c6f12ac0f3a6bf/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fmetrics_reporter.py",
