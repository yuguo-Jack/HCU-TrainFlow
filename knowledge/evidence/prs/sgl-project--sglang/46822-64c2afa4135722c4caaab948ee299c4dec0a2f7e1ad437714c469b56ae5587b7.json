      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsa%2Fdsa_indexer.py?ref=11262e1199d914ac1946bdcf3d18f56cc3f45612",
      "deletions": 5,
      "filename": "python/sglang/srt/layers/attention/dsa/dsa_indexer.py",
      "patch": "@@ -228,6 +228,18 @@ def _broadcast_indexer_topk_from_rank0(\n     return topk_indices\n \n \n+def _skips_eager_idle(forward_batch: ForwardBatch) -> bool:\n+    \"\"\"Whether the indexer returns all-invalid rows without running: an eager\n+    IDLE forward (a DP-attention rank padded with no requests) has no valid\n+    page-table rows or lengths to score. On ROCm the paged top-k v2 kernel\n+    faulted on them in the idle NextN draft forward under DP2 x DCP2.\"\"\"\n+    return (\n+        (_is_cuda or _is_hip)\n+        and forward_batch.forward_mode.is_idle()\n+        and not get_is_capture_mode()\n+    )\n+\n+\n def _make_eager_idle_topk_result(\n     x: torch.Tensor, index_topk: int, return_indices: bool\n ) -> Optional[torch.Tensor]:\n@@ -1921,11 +1933,7 @@ def forward_cuda(\n         # DSA page-table rows to index. Return invalid rows with the physical DP\n         # shape so later MLP/EP collectives still agree across ranks.\n         x_meta = x[0] if isinstance(x, tuple) else x\n-        if (\n-            _is_cuda\n-            and forward_batch.forward_mode.is_idle()\n-            and not get_is_capture_mode()\n-        ):\n+        if _skips_eager_idle(forward_batch):\n             topk_result = _make_eager_idle_topk_result(\n                 x_meta, self.index_topk, return_indices\n             )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/11262e1199d914ac1946bdcf3d18f56cc3f45612/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsa%2Fdsa_indexer.py",
      "sha": "79e2729aa849daa2caae21caf663bc568b4384bb",
      "status": "modified"
    },
    {
      "additions": 29,
      "blob_url": "https://github.com/sgl-project/sglang/blob/11262e1199d914ac1946bdcf3d18f56cc3f45612/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_dsa_indexer_idle.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_dsa_indexer_idle.py?ref=11262e1199d914ac1946bdcf3d18f56cc3f45612",
      "deletions": 1,
      "filename": "test/registered/unit/layers/attention/test_dsa_indexer_idle.py",
      "patch": "@@ -7,6 +7,7 @@\n from sglang.srt.layers.attention.dsa.dsa_indexer import (\n     Indexer,\n     _make_eager_idle_topk_result,\n+    _skips_eager_idle,\n )\n from sglang.srt.model_executor.forward_batch_info import ForwardMode\n from sglang.test.ci.ci_register import register_cpu_ci\n@@ -37,12 +38,39 @@ def test_returns_none_when_indices_are_not_consumed(self):\n             )\n         )\n \n+    def test_capture_and_active_modes_keep_the_normal_path(self):\n+        for is_cuda, is_hip in ((True, False), (False, True), (False, False)):\n+            for mode in (ForwardMode.IDLE, ForwardMode.DECODE, ForwardMode.EXTEND):\n+                for capture in (False, True):\n+                    with (\n+                        self.subTest(\n+                            cuda=is_cuda, hip=is_hip, mode=mode, capture=capture\n+                        ),\n+                        patch(f\"{_INDEXER}._is_cuda\", is_cuda),\n+                        patch(f\"{_INDEXER}._is_hip\", is_hip),\n+                        patch(f\"{_INDEXER}.get_is_capture_mode\", return_value=capture),\n+                    ):\n+                        self.assertEqual(\n+                            _skips_eager_idle(SimpleNamespace(forward_mode=mode)),\n+                            (is_cuda or is_hip)\n+                            and mode == ForwardMode.IDLE\n+                            and not capture,\n+                        )\n+\n     def test_eager_idle_short_circuits_before_paged_mqa(self):\n+        for is_cuda, is_hip in ((True, False), (False, True)):\n+            with self.subTest(is_cuda=is_cuda, is_hip=is_hip):\n+                self._check_eager_idle_short_circuits(is_cuda, is_hip)\n+\n+    def _check_eager_idle_short_circuits(self, is_cuda, is_hip):\n+        # On ROCm the idle rank of a DP2 x DCP2 server faulted in the paged\n+        # top-k v2 kernel when the indexer ran on its padding rows.\n         indexer = SimpleNamespace(index_topk=4)\n         batch = SimpleNamespace(forward_mode=ForwardMode.IDLE)\n \n         with (\n-            patch(f\"{_INDEXER}._is_cuda\", True),\n+            patch(f\"{_INDEXER}._is_cuda\", is_cuda),\n+            patch(f\"{_INDEXER}._is_hip\", is_hip),\n             patch(f\"{_INDEXER}.get_is_capture_mode\", return_value=False),\n             patch(\n                 f\"{_INDEXER}._broadcast_indexer_topk_from_rank0\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/11262e1199d914ac1946bdcf3d18f56cc3f45612/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_dsa_indexer_idle.py",
