      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Fstorage_attachment.py?ref=9348a190bf963bf66051dbbbc4b1059c72336b1f",
      "deletions": 0,
      "filename": "python/sglang/srt/mem_cache/unified_cache/storage_attachment.py",
      "patch": "@@ -177,6 +177,8 @@ def attach(\n             enable_storage_metrics=cache._enable_metrics_flag,\n             extra_metric_labels=cache.extra_metric_labels,\n         )\n+        # The new backend may not contain pages stored in the previous backend.\n+        cache.storage_existence_cache.clear()\n         return True, \"Attached HiCache storage backend successfully.\"\n \n     def detach(self) -> tuple[bool, str]:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9348a190bf963bf66051dbbbc4b1059c72336b1f/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Fstorage_attachment.py",
