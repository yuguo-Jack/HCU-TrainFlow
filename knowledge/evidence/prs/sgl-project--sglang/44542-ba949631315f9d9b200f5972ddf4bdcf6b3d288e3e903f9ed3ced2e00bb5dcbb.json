  "files": [
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4bec30ffa100c648c4c76e8c912e955c6851ed15/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Ftopk.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Ftopk.py?ref=4bec30ffa100c648c4c76e8c912e955c6851ed15",
      "deletions": 0,
      "filename": "python/sglang/srt/layers/moe/topk.py",
      "patch": "@@ -285,6 +285,8 @@ def correction_bias_for_dtype(self, dtype: torch.dtype) -> Optional[torch.Tensor\n \n         # Weight loaders update parameters in place. Including the version in\n         # the key prevents an early access from retaining pre-load contents.\n+        # Writes through `param.data` (RL weight sync, dummy-load warmup) do\n+        # not bump `_version`, so a matching key still has to refresh the copy.\n         cache_key = (\n             correction_bias.data_ptr(),\n             correction_bias._version,\n@@ -295,6 +297,9 @@ def correction_bias_for_dtype(self, dtype: torch.dtype) -> Optional[torch.Tensor\n         if self._correction_bias_cache_key != cache_key:\n             self._correction_bias_dtype_cache = correction_bias.to(dtype=dtype)\n             self._correction_bias_cache_key = cache_key\n+        else:\n+            # In-place refresh keeps the CUDA-graph address of the cached bias.\n+            self._correction_bias_dtype_cache.copy_(correction_bias)\n         return self._correction_bias_dtype_cache\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4bec30ffa100c648c4c76e8c912e955c6851ed15/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Ftopk.py",
      "sha": "e5d00096ce695011d489ff500873d43cf8d1d1e7",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4bec30ffa100c648c4c76e8c912e955c6851ed15/test%2Fregistered%2Funit%2Flayers%2Fmoe%2Ftest_topk_correction_bias_cache.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fmoe%2Ftest_topk_correction_bias_cache.py?ref=4bec30ffa100c648c4c76e8c912e955c6851ed15",
      "deletions": 0,
      "filename": "test/registered/unit/layers/moe/test_topk_correction_bias_cache.py",
      "patch": "@@ -44,6 +44,21 @@ def test_cache_refreshes_if_weight_is_reloaded(self):\n         torch.testing.assert_close(converted_after_reload, reloaded_value.float())\n         self.assertNotEqual(converted.data_ptr(), converted_after_reload.data_ptr())\n \n+    def test_data_write_refreshes_cache_in_place(self):\n+        correction_bias = torch.zeros(8, dtype=torch.bfloat16, device=self.device)\n+        config = TopKConfig(top_k=2, correction_bias=correction_bias)\n+        converted = config.correction_bias_for_dtype(torch.float32)\n+\n+        reloaded_value = torch.arange(8, dtype=torch.float32).to(\n+            device=self.device, dtype=torch.bfloat16\n+        )\n+        with torch.no_grad():\n+            correction_bias.data.copy_(reloaded_value)\n+        converted_after_reload = config.correction_bias_for_dtype(torch.float32)\n+\n+        torch.testing.assert_close(converted_after_reload, reloaded_value.float())\n+        self.assertEqual(converted.data_ptr(), converted_after_reload.data_ptr())\n+\n     def test_matching_dtype_returns_original_tensor(self):\n         correction_bias = torch.randn(8, dtype=torch.float32, device=self.device)\n         config = TopKConfig(top_k=2, correction_bias=correction_bias)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4bec30ffa100c648c4c76e8c912e955c6851ed15/test%2Fregistered%2Funit%2Flayers%2Fmoe%2Ftest_topk_correction_bias_cache.py",
      "sha": "aea3503db9250203463fd6c2ac92a81b6efa2fad",
      "status": "modified"
    }
