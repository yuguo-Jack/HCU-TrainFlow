      "blob_url": "https://github.com/sgl-project/sglang/blob/9b489e5a4c51f066208db0560ecf7a5fb7dc1200/python%2Fsglang%2Fsrt%2Fparser%2Fconversation.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fparser%2Fconversation.py?ref=9b489e5a4c51f066208db0560ecf7a5fb7dc1200",
      "deletions": 4,
      "filename": "python/sglang/srt/parser/conversation.py",
      "patch": "@@ -221,14 +221,14 @@ def get_prompt(self) -> str:\n             else:\n                 ret = \"[INST] \"\n             for i, (role, message) in enumerate(self.messages):\n-                tag = self.roles[i % 2]\n                 if message:\n-                    if i == 0:\n+                    if i == 0 and role == self.roles[0]:\n                         ret += message + \" \"\n                     else:\n-                        ret += tag + \" \" + message + seps[i % 2]\n+                        sep = seps[0] if role == self.roles[0] else seps[1]\n+                        ret += role + \" \" + message + sep\n                 else:\n-                    ret += tag\n+                    ret += role\n             return ret\n         elif self.sep_style == SeparatorStyle.CHATGLM:\n             # source: https://huggingface.co/THUDM/chatglm-6b/blob/1d240ba371910e9282298d4592532d7f0f3e9f3e/modeling_chatglm.py#L1302-L1308",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9b489e5a4c51f066208db0560ecf7a5fb7dc1200/python%2Fsglang%2Fsrt%2Fparser%2Fconversation.py",
      "sha": "355b5e98692ced83ceba23bcf065f184dd5160a5",
      "status": "modified"
    },
    {
      "additions": 58,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9b489e5a4c51f066208db0560ecf7a5fb7dc1200/test%2Fregistered%2Funit%2Fparser%2Ftest_conversation.py",
      "changes": 58,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fparser%2Ftest_conversation.py?ref=9b489e5a4c51f066208db0560ecf7a5fb7dc1200",
      "deletions": 0,
      "filename": "test/registered/unit/parser/test_conversation.py",
      "patch": "@@ -212,6 +212,64 @@ def test_llama2_multi_turn(self):\n         self.assertIn(\"Q1 \", prompt)\n         # i=1: tag + \" \" + message + sep2\n         self.assertIn(\"[/INST] A1 </s><s>\", prompt)\n+        self.assertEqual(\n+            prompt,\n+            \"[INST] <<SYS>>\\nSys\\n<</SYS>>\\n\\nQ1 [/INST] A1 </s><s>[INST] Q2 [/INST]\",\n+        )\n+\n+    def test_llama2_consecutive_user_messages(self):\n+        \"\"\"Consecutive users keep their role and open an assistant response.\"\"\"\n+        request = ChatCompletionRequest(\n+            model=\"test\",\n+            messages=[\n+                {\"role\": \"system\", \"content\": \"\"},\n+                {\"role\": \"user\", \"content\": \"Here is my code.\"},\n+                {\"role\": \"user\", \"content\": \"Please review it.\"},\n+            ],\n+        )\n+        for template in (\"llama-2\", \"mistral\", \"devstral\"):\n+            with self.subTest(template=template):\n+                conv = generate_chat_conv(request, template)\n+                self.assertEqual(\n+                    conv.get_prompt(),\n+                    \"[INST] Here is my code. [INST] Please review it. [/INST]\",\n+                )\n+\n+    def test_llama2_consecutive_assistant_messages(self):\n+        \"\"\"Each assistant response receives its own end-of-turn separator.\"\"\"\n+        conv = Conversation(\n+            name=\"test\",\n+            roles=(\"[INST]\", \"[/INST]\"),\n+            messages=[\n+                [\"[INST]\", \"Q\"],\n+                [\"[/INST]\", \"A1\"],\n+                [\"[/INST]\", \"A2\"],\n+                [\"[INST]\", \"Q2\"],\n+                [\"[/INST]\", None],\n+            ],\n+            sep_style=SeparatorStyle.LLAMA2,\n+            sep=\" \",\n+            sep2=\" </s><s>\",\n+        )\n+        self.assertEqual(\n+            conv.get_prompt(),\n+            \"[INST] Q [/INST] A1 </s><s>[/INST] A2 </s><s>[INST] Q2 [/INST]\",\n+        )\n+\n+    def test_llama2_leading_assistant_message(self):\n+        \"\"\"An assistant-first history must not relabel its content as a user.\"\"\"\n+        request = ChatCompletionRequest(\n+            model=\"test\",\n+            messages=[\n+                {\"role\": \"assistant\", \"content\": \"Previous answer.\"},\n+                {\"role\": \"user\", \"content\": \"Follow up.\"},\n+            ],\n+        )\n+        conv = generate_chat_conv(request, \"llama-2\")\n+        self.assertEqual(\n+            conv.get_prompt(),\n+            \"[INST] [/INST] Previous answer. </s><s>[INST] Follow up. [/INST]\",\n+        )\n \n     def test_llama4(self):\n         \"\"\"Test prompt generation with LLAMA4 style.\"\"\"",
