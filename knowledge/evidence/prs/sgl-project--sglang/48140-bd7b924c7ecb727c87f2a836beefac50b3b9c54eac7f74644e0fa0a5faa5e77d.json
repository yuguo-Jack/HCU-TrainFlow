      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/490a3da3a7ad05c3c6ed469451f4e9d1d91cec78/python%2Fsglang%2Fsrt%2Flayers%2Fdeep_gemm_wrapper%2Fconfigurer.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fdeep_gemm_wrapper%2Fconfigurer.py?ref=490a3da3a7ad05c3c6ed469451f4e9d1d91cec78",
      "deletions": 2,
      "filename": "python/sglang/srt/layers/deep_gemm_wrapper/configurer.py",
      "patch": "@@ -17,7 +17,8 @@\n def _sm120_deep_gemm_apis_available() -> bool:\n     try:\n         import deep_gemm\n-    except (ImportError, OSError, RuntimeError):\n+    except (ImportError, OSError, RuntimeError, AssertionError):\n+        # DeepGEMM asserts during import when it cannot find a CUDA toolkit.\n         return False\n     return all(\n         callable(getattr(deep_gemm, name, None))\n@@ -46,7 +47,7 @@ def _compute_enable_deep_gemm():\n \n     try:\n         import deep_gemm  # noqa: F401\n-    except (ImportError, OSError, RuntimeError):\n+    except (ImportError, OSError, RuntimeError, AssertionError):\n         return False\n \n     return True",
      "raw_url": "https://github.com/sgl-project/sglang/raw/490a3da3a7ad05c3c6ed469451f4e9d1d91cec78/python%2Fsglang%2Fsrt%2Flayers%2Fdeep_gemm_wrapper%2Fconfigurer.py",
      "sha": "5ee469751742146085b2fa556ddd8afa06e3009f",
      "status": "modified"
    },
    {
      "additions": 55,
      "blob_url": "https://github.com/sgl-project/sglang/blob/490a3da3a7ad05c3c6ed469451f4e9d1d91cec78/test%2Fregistered%2Funit%2Flayers%2Fdeep_gemm_wrapper%2Ftest_configurer.py",
      "changes": 55,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fdeep_gemm_wrapper%2Ftest_configurer.py?ref=490a3da3a7ad05c3c6ed469451f4e9d1d91cec78",
      "deletions": 0,
      "filename": "test/registered/unit/layers/deep_gemm_wrapper/test_configurer.py",
      "patch": "@@ -0,0 +1,55 @@\n+\"\"\"CPU regression tests for optional DeepGEMM availability detection.\"\"\"\n+\n+import builtins\n+import sys\n+import unittest\n+from types import ModuleType\n+from unittest.mock import patch\n+\n+from sglang.srt.layers.deep_gemm_wrapper import configurer\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestDeepGemmAvailability(CustomTestCase):\n+    def test_missing_cuda_toolkit_disables_deep_gemm(self):\n+        \"\"\"A wheel without a discoverable CUDA toolkit must not break model imports.\"\"\"\n+        original_import = builtins.__import__\n+\n+        def import_without_cuda_toolkit(name, *args, **kwargs):\n+            if name == \"deep_gemm\":\n+                raise AssertionError(\"Cannot find CUDA home\")\n+            return original_import(name, *args, **kwargs)\n+\n+        for sm in (90, 100, 120, 121):\n+            with (\n+                self.subTest(sm=sm),\n+                patch.multiple(configurer, _is_cuda=True, _is_musa=False),\n+                patch.object(configurer, \"get_device_sm\", return_value=sm),\n+                configurer.envs.SGLANG_ENABLE_JIT_DEEPGEMM.override(True),\n+                patch(\"builtins.__import__\", side_effect=import_without_cuda_toolkit),\n+            ):\n+                self.assertFalse(configurer._compute_enable_deep_gemm())\n+\n+    def test_available_deep_gemm_remains_enabled(self):\n+        \"\"\"The missing-toolkit fallback must not disable a working installation.\"\"\"\n+        deep_gemm = ModuleType(\"deep_gemm\")\n+        deep_gemm.fp8_einsum = lambda: None\n+        deep_gemm.m_grouped_fp8_fp4_gemm_nt_contiguous = lambda: None\n+        deep_gemm.transform_sf_into_required_layout = lambda: None\n+\n+        for sm in (90, 100, 120, 121):\n+            with (\n+                self.subTest(sm=sm),\n+                patch.multiple(configurer, _is_cuda=True, _is_musa=False),\n+                patch.object(configurer, \"get_device_sm\", return_value=sm),\n+                configurer.envs.SGLANG_ENABLE_JIT_DEEPGEMM.override(True),\n+                patch.dict(sys.modules, {\"deep_gemm\": deep_gemm}),\n+            ):\n+                self.assertTrue(configurer._compute_enable_deep_gemm())\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/490a3da3a7ad05c3c6ed469451f4e9d1d91cec78/test%2Fregistered%2Funit%2Flayers%2Fdeep_gemm_wrapper%2Ftest_configurer.py",
      "sha": "0eaa07815f37b0a281af076db8a22f2b0de18161",
      "status": "added"
    }
