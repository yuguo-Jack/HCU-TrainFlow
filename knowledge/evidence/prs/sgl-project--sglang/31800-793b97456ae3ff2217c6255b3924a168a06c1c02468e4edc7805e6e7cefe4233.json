    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2d41efb8ac01668e3797b2ab6c0d76ef740631cb/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fcommon%2Fconn.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fcommon%2Fconn.py?ref=2d41efb8ac01668e3797b2ab6c0d76ef740631cb",
      "deletions": 1,
      "filename": "python/sglang/srt/disaggregation/common/conn.py",
      "patch": "@@ -1373,7 +1373,7 @@ def _check_waiting_timeout(self) -> Optional[KVPoll]:\n         self.kv_mgr.record_failure(\n             self.bootstrap_room,\n             f\"Request {self.bootstrap_room} timed out after {elapsed:.1f}s \"\n-            f\"in KVPoll.WaitingForInput\",\n+            f\"waiting for KV Cache transfer to complete\",\n         )\n         self.kv_mgr.update_status(self.bootstrap_room, KVPoll.Failed)\n         if (",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2d41efb8ac01668e3797b2ab6c0d76ef740631cb/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fcommon%2Fconn.py",
      "sha": "378b620fbad55c8f6a040f228ed3b239ad379376",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2d41efb8ac01668e3797b2ab6c0d76ef740631cb/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fmooncake%2Fconn.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fmooncake%2Fconn.py?ref=2d41efb8ac01668e3797b2ab6c0d76ef740631cb",
      "deletions": 1,
      "filename": "python/sglang/srt/disaggregation/mooncake/conn.py",
      "patch": "@@ -1997,7 +1997,14 @@ def poll(self) -> KVPoll:\n         status = self.kv_mgr.check_status(self.bootstrap_room)\n         if status in (KVPoll.Success, KVPoll.Failed):\n             self.conclude_state = status\n-        elif status == KVPoll.WaitingForInput:\n+        elif status in (KVPoll.WaitingForInput, KVPoll.Transferring):\n+            # Apply the timeout to both WaitingForInput (transfer not yet\n+            # started) and Transferring (transfer started but never signalled\n+            # done). A request that stalls mid-transfer otherwise stays pinned\n+            # forever, holding its req_to_token_pool slot on the decode side and\n+            # eventually starving admission. This mirrors the NIXL receiver,\n+            # which already checks the timeout unconditionally once the transfer\n+            # has been initiated.\n             timeout_result = self._check_waiting_timeout()\n             if timeout_result is not None:\n                 return timeout_result",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2d41efb8ac01668e3797b2ab6c0d76ef740631cb/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fmooncake%2Fconn.py",
      "sha": "bd29b5f511e96f9c4a2094dd2420deb9f3752c1d",
      "status": "modified"
    }
