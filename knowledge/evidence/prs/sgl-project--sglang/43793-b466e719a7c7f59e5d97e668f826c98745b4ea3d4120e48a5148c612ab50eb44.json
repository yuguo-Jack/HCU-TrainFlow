  "files": [
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c2e29e71f2b286994d946e97130f911e5e4b1e3c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fdistributed%2Fgroup_coordinator.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fdistributed%2Fgroup_coordinator.py?ref=c2e29e71f2b286994d946e97130f911e5e4b1e3c",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/runtime/distributed/group_coordinator.py",
      "patch": "@@ -420,6 +420,8 @@ def all_gather(\n                 return list(output_tensor.chunk(world_size, dim=dim))\n             return output_tensor\n         else:\n+            if not input_.is_contiguous():\n+                input_ = input_.contiguous()\n             all_gather_single(output_tensor, input_, group=self.device_group)\n \n         if dim != 0:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c2e29e71f2b286994d946e97130f911e5e4b1e3c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fdistributed%2Fgroup_coordinator.py",
      "sha": "e6f12e001fb29b68c572ac792a3e4969b1f0bcf9",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c2e29e71f2b286994d946e97130f911e5e4b1e3c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Flayers%2Fattention%2Flayer.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Flayers%2Fattention%2Flayer.py?ref=c2e29e71f2b286994d946e97130f911e5e4b1e3c",
      "deletions": 5,
      "filename": "python/sglang/multimodal_gen/runtime/layers/attention/layer.py",
      "patch": "@@ -1526,10 +1526,9 @@ def _gather_sharded_sequence(\n                 \"Replicated prefix and suffix cannot be used at the same time.\"\n             )\n \n-        # slicing along dim 1 keeps the original row stride, so the shard is\n-        # contiguous only while the batch dim is 1; all_gather_into_tensor\n-        # requires a contiguous input, so materialize the shard before the\n-        # collective\n+        # A dim-1 slice keeps the original row stride, and Flux2 K/V are views\n+        # from qkv.chunk, so neither form is contiguous. all_gather_into_tensor\n+        # rejects a non-contiguous input, so materialize before the collective.\n         if num_replicated_prefix:\n             replicated = tensor[:, :num_replicated_prefix]\n             sharded = tensor[:, num_replicated_prefix:].contiguous()\n@@ -1542,7 +1541,7 @@ def _gather_sharded_sequence(\n             gathered = sequence_model_parallel_all_gather(sharded, dim=1)\n             return torch.cat([gathered, replicated], dim=1)\n \n-        return sequence_model_parallel_all_gather(tensor, dim=1)\n+        return sequence_model_parallel_all_gather(tensor.contiguous(), dim=1)\n \n     def _forward_with_kv_gather(\n         self,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c2e29e71f2b286994d946e97130f911e5e4b1e3c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Flayers%2Fattention%2Flayer.py",
      "sha": "62349f58012007b36c52e8f512aecf8170b1dfe7",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c2e29e71f2b286994d946e97130f911e5e4b1e3c/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_sp_kv_gather_contiguous.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_sp_kv_gather_contiguous.py?ref=c2e29e71f2b286994d946e97130f911e5e4b1e3c",
      "deletions": 0,
      "filename": "test/registered/unit/layers/attention/test_sp_kv_gather_contiguous.py",
      "patch": "@@ -0,0 +1,44 @@\n+\"\"\"Sequence-parallel K/V gather must materialize non-contiguous views.\n+\n+Flux2 packs Q, K, and V with one projection and then ``chunk``s them. That\n+view is not contiguous, and ``all_gather_into_tensor`` rejects it.\n+\"\"\"\n+\n+import unittest\n+from unittest.mock import patch\n+\n+import torch\n+\n+from sglang.multimodal_gen.runtime.layers.attention.layer import USPAttention\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=20, suite=\"base-a-test-cpu\")\n+\n+\n+class TestSequenceParallelKvGatherContiguous(unittest.TestCase):\n+    def test_noncontiguous_kv_chunk_is_materialized_before_all_gather(self):\n+        packed = torch.randn(2, 8, 12)\n+        key = packed.chunk(3, dim=-1)[1]\n+        self.assertFalse(key.is_contiguous())\n+\n+        captured = {}\n+\n+        def fake_all_gather(tensor, dim=-1):\n+            captured[\"tensor\"] = tensor\n+            captured[\"dim\"] = dim\n+            return tensor\n+\n+        with patch(\n+            \"sglang.multimodal_gen.runtime.layers.attention.layer.sequence_model_parallel_all_gather\",\n+            fake_all_gather,\n+        ):\n+            gathered = USPAttention._gather_sharded_sequence(key)\n+\n+        self.assertEqual(captured[\"dim\"], 1)\n+        self.assertTrue(captured[\"tensor\"].is_contiguous())\n+        self.assertTrue(torch.equal(captured[\"tensor\"], key))\n+        self.assertTrue(torch.equal(gathered, key))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c2e29e71f2b286994d946e97130f911e5e4b1e3c/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_sp_kv_gather_contiguous.py",
      "sha": "7ec9b511df675bb4feed5ddc02214bab4aeb20a6",
      "status": "added"
    }
  ],
