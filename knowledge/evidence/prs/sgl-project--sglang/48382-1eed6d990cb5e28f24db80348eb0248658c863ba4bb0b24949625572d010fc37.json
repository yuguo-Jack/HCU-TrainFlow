      "blob_url": "https://github.com/sgl-project/sglang/blob/ed7910a6861b3151fa244b981c54ac8d600c5e85/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fmori%2Fconn.py",
      "changes": 41,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fmori%2Fconn.py?ref=ed7910a6861b3151fa244b981c54ac8d600c5e85",
      "deletions": 8,
      "filename": "python/sglang/srt/disaggregation/mori/conn.py",
      "patch": "@@ -27,7 +27,7 @@\n     StatusCode,\n )\n \n-from sglang.srt.disaggregation.base.conn import KVArgs, KVPoll\n+from sglang.srt.disaggregation.base.conn import KVArgs, KVPoll, StateType\n from sglang.srt.disaggregation.common.conn import (\n     ABORT_TAG,\n     AbortNotification,\n@@ -1943,13 +1943,38 @@ def _send_swa_dsa_state(\n         )\n \n         statuses: List[TransferStatus] = []\n-        pairs = build_transfer_entry_pairs(\n-            src_layer_ids,\n-            dst_layer_ids,\n-            len(src_state_mem_descs),\n-            len(dst_state_mem_descs),\n-            allow_positional_fallback=self.pp_size == 1,\n-        )\n+        n_src, n_dst = len(src_state_mem_descs), len(dst_state_mem_descs)\n+        if (\n+            state_type == StateType.DSA\n+            and self.pp_size is not None\n+            and self.pp_size > 1\n+            # A hybrid linear+DSA pool lists only its full-attention layers, so a\n+            # model-layer slice would mispair them; it still needs layer ids.\n+            and not self.is_hybrid_mla_backend\n+            and not src_layer_ids\n+            and not dst_layer_ids\n+            and n_src != n_dst\n+        ):\n+            # DSA state is registered without layer ids; slice the decode entries for\n+            # this PP stage the same way Mooncake's no-layer-id path does.\n+            src_entries, dst_entries, n_stage = self.get_mla_kv_ptrs_with_pp(\n+                list(range(n_src)), list(range(n_dst)), StateType.DSA\n+            )\n+            if len(dst_entries) < n_stage:\n+                raise RuntimeError(\n+                    \"Destination DSA state descriptors do not match prefill pp \"\n+                    f\"configuration: start={self.kv_args.prefill_start_layer} \"\n+                    f\"src={n_src} dst={n_dst}\"\n+                )\n+            pairs = list(zip(src_entries[:n_stage], dst_entries[:n_stage]))\n+        else:\n+            pairs = build_transfer_entry_pairs(\n+                src_layer_ids,\n+                dst_layer_ids,\n+                n_src,\n+                n_dst,\n+                allow_positional_fallback=self.pp_size == 1,\n+            )\n         for i, j in pairs:\n             src_desc = src_state_mem_descs[i]\n             dst_desc = dst_state_mem_descs[j]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ed7910a6861b3151fa244b981c54ac8d600c5e85/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fmori%2Fconn.py",
      "sha": "d20a1f2ff6d4cb052952b35703750ec134e3403a",
      "status": "modified"
    },
    {
      "additions": 92,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ed7910a6861b3151fa244b981c54ac8d600c5e85/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_mori_deferred_kv_release.py",
      "changes": 93,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_mori_deferred_kv_release.py?ref=ed7910a6861b3151fa244b981c54ac8d600c5e85",
      "deletions": 1,
      "filename": "test/registered/unit/disaggregation/test_mori_deferred_kv_release.py",
      "patch": "@@ -1,4 +1,4 @@\n-\"\"\"Deferred decode-side KV release on the Mori backend.\"\"\"\n+\"\"\"Deferred decode-side KV release and PP state pairing on the Mori backend.\"\"\"\n \n import importlib\n import sys\n@@ -358,5 +358,96 @@ def test_drain_worker_retries_same_item_after_exception(self):\n         log.assert_called_once()\n \n \n+# GLM-5.2 under PP4: 78 layers split 20/20/20/18, the MTP draft entry on the last stage.\n+_DECODE_DSA_ENTRIES = 79\n+_PP4_STAGES = ((0, 20), (20, 20), (40, 20), (60, 19))\n+\n+\n+def _pp_stage_manager(\n+    start_layer: int, *, hybrid: bool = False\n+) -> tuple[MoriKVManager, list]:\n+    \"\"\"A PP4 prefill-stage manager whose engine records each batch write's descriptors.\"\"\"\n+    manager = _manager()\n+    manager.pp_size = 4\n+    manager.is_mla_backend = True\n+    manager.is_hybrid_mla_backend = hybrid\n+    manager.attn_tp_size = 1\n+    manager.kv_args = types.SimpleNamespace(prefill_start_layer=start_layer)\n+    writes = []\n+\n+    def batch_write(src_descs, local_offsets, dst_descs, *args):\n+        writes.append((src_descs[0], dst_descs[0]))\n+        return [MagicMock()]\n+\n+    manager.engine = MagicMock()\n+    manager.engine.batch_write.side_effect = batch_write\n+    return manager, writes\n+\n+\n+def _send_unlabeled_state(\n+    manager: MoriKVManager,\n+    *,\n+    state_type: str,\n+    num_src: int,\n+    num_dst: int = _DECODE_DSA_ENTRIES,\n+) -> None:\n+    \"\"\"Send one request's state pages with no layer ids on either peer.\"\"\"\n+    manager._send_swa_dsa_state(\n+        peer_info=types.SimpleNamespace(decode_tp_size=4),\n+        src_state_indices=np.array([3, 4, 9], dtype=np.int32),\n+        dst_state_indices=np.array([7, 8, 12], dtype=np.int32),\n+        src_state_mem_descs=[f\"P{i}\" for i in range(num_src)],\n+        src_state_item_lens=[64] * num_src,\n+        dst_state_mem_descs=[f\"D{j}\" for j in range(num_dst)],\n+        dst_state_item_lens=[64] * num_dst,\n+        state_type=state_type,\n+        src_layer_ids=[],\n+        dst_layer_ids=[],\n+    )\n+\n+\n+class TestMoriPpDsaStatePairing(CustomTestCase):\n+    def test_each_stage_writes_decode_entries_at_its_layer_offset(self):\n+        \"\"\"DSA state carries no layer ids, so a PP>1 prefill used to fail every state\n+        send; each stage must write its entries from its first layer, draft included.\"\"\"\n+        for start_layer, num_src in _PP4_STAGES:\n+            with self.subTest(start_layer=start_layer):\n+                manager, writes = _pp_stage_manager(start_layer)\n+\n+                _send_unlabeled_state(manager, state_type=\"dsa\", num_src=num_src)\n+\n+                self.assertEqual(\n+                    writes,\n+                    [(f\"P{i}\", f\"D{start_layer + i}\") for i in range(num_src)],\n+                )\n+\n+    def test_unpairable_layouts_still_fail_before_any_write(self):\n+        \"\"\"Only plain DSA state pairs by stage offset: a hybrid linear+DSA pool,\n+        whose entries skip its linear layers, would land on the wrong layers,\n+        and a stage that would overrun the decode entries raises instead of\n+        writing past them.\"\"\"\n+        for state_type, hybrid, start_layer, num_src, num_dst, error in (\n+            (\"swa\", False, 40, 20, _DECODE_DSA_ENTRIES, \"requires layer ids\"),\n+            (\"dsa\", False, 70, 19, _DECODE_DSA_ENTRIES, \"do not match prefill pp\"),\n+            # Hybrid, half the layers full attention: decode lists 40 entries,\n+            # the stage at layer 20 has 10.\n+            (\"dsa\", True, 20, 10, 40, \"requires layer ids\"),\n+        ):\n+            with self.subTest(\n+                state_type=state_type, hybrid=hybrid, start_layer=start_layer\n+            ):\n+                manager, writes = _pp_stage_manager(start_layer, hybrid=hybrid)\n+\n+                with self.assertRaisesRegex(RuntimeError, error):\n+                    _send_unlabeled_state(\n+                        manager,\n+                        state_type=state_type,\n+                        num_src=num_src,\n+                        num_dst=num_dst,\n+                    )\n+\n+                self.assertEqual(writes, [])\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ed7910a6861b3151fa244b981c54ac8d600c5e85/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_mori_deferred_kv_release.py",
      "sha": "94e5819677259e8cbf9ffda7c47d59cf78d463c2",
      "status": "modified"
