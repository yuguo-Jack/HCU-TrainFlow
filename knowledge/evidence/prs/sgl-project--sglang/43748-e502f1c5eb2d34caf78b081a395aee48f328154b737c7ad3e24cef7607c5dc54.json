    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b105d7d9e69520c141698c8e28ce78e758813c83/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fvision.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fvision.py?ref=b105d7d9e69520c141698c8e28ce78e758813c83",
      "deletions": 5,
      "filename": "python/sglang/srt/layers/attention/vision.py",
      "patch": "@@ -869,17 +869,17 @@ def forward(\n             # TND fused attention expects cumulative seqlens (cu_seqlens[1:]),\n             # not per-sequence lengths in forward_metadata.seq_lens.\n             cu = forward_metadata.cu_seqlens.to(\"cpu\")\n-            output = torch.empty_like(q)\n+            output = torch.zeros_like(q)\n             seq_len_arg = cu[1:].to(torch.int32)\n         elif envs.SGLANG_VIT_ENABLE_CUDA_GRAPH.get():\n             if \"output_ws\" not in kwargs:\n                 raise RuntimeError(\"output_ws should be prepared for npu-graph mode\")\n-            output = kwargs[\"output_ws\"]\n+            output = kwargs[\"output_ws\"].zero_()\n             seq_len_arg = cu_seqlens\n         else:\n             cu_seqlens = resolve_seqlens(cu_seqlens, bsz, seq_len, device=\"cpu\")\n             seq_len_arg = cu_seqlens[1:].to(torch.int32)\n-            output = torch.empty_like(q)\n+            output = torch.zeros_like(q)\n \n         _, num_heads, head_size = q.shape\n         num_kv_heads = k.shape[1]\n@@ -938,8 +938,6 @@ def forward(\n         if valid_indices is not None:\n             output.index_copy_(0, valid_indices, attn_output)\n         elif output.shape[0] != total_tokens:\n-            # Single image: write the compact result into the front of the\n-            # pre-allocated padded output, leaving the padding rows as-is.\n             output[:total_tokens].copy_(attn_output)\n         else:\n             output = attn_output",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b105d7d9e69520c141698c8e28ce78e758813c83/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fvision.py",
      "sha": "3e2ff84856f67f1a3fd856c53a0346c8cffbac4b",
      "status": "modified"
    },
    {
      "additions": 72,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b105d7d9e69520c141698c8e28ce78e758813c83/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_vision_backend_selection.py",
      "changes": 72,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_vision_backend_selection.py?ref=b105d7d9e69520c141698c8e28ce78e758813c83",
      "deletions": 0,
      "filename": "test/registered/unit/layers/attention/test_vision_backend_selection.py",
      "patch": "@@ -257,5 +257,77 @@ def test_ascend_attention_unmasked_inputs_keep_fused_path(\n     sdpa_forward.assert_not_called()\n \n \n+@pytest.mark.parametrize(\"seq_lens\", [(2, 4, 3), (2,), (4, 4)])\n+@pytest.mark.parametrize(\"output_mode\", [\"eager\", \"metadata\", \"graph\"])\n+def test_ascend_attention_initializes_padding(\n+    monkeypatch,\n+    npu_platform,\n+    seq_lens,\n+    output_mode,\n+):\n+    monkeypatch.setenv(\n+        \"SGLANG_VIT_ENABLE_CUDA_GRAPH\", \"1\" if output_mode == \"graph\" else \"0\"\n+    )\n+    bsz, seq_len, num_heads, head_dim = len(seq_lens), 4, 2, 8\n+    shape = (bsz * seq_len, num_heads, head_dim)\n+    q = torch.arange(bsz * seq_len * num_heads * head_dim).reshape(shape).float()\n+    k, v = q + 1, q + 2\n+    lengths = torch.tensor(seq_lens, dtype=torch.int32)\n+    cu_seqlens = torch.cat([torch.zeros(1, dtype=torch.int32), lengths.cumsum(0)])\n+    valid_mask = (torch.arange(seq_len)[None, :] < lengths[:, None]).flatten()\n+\n+    empty_like = torch.empty_like\n+    monkeypatch.setattr(\n+        torch,\n+        \"empty_like\",\n+        lambda *args, **kwargs: empty_like(*args, **kwargs).fill_(float(\"nan\")),\n+    )\n+    workspace = torch.full_like(q, float(\"nan\"))\n+\n+    def fake_fused_attention(**kwargs):\n+        torch.testing.assert_close(kwargs[\"query\"], q[valid_mask])\n+        torch.testing.assert_close(kwargs[\"key\"], k[valid_mask])\n+        torch.testing.assert_close(kwargs[\"value\"], v[valid_mask])\n+        assert kwargs[\"actual_seq_lengths\"] == cu_seqlens[1:].tolist()\n+        assert kwargs[\"actual_seq_lengths_kv\"] == cu_seqlens[1:].tolist()\n+        return kwargs[\"value\"] + 1, None\n+\n+    monkeypatch.setattr(\n+        vision,\n+        \"torch_npu\",\n+        SimpleNamespace(npu_fused_infer_attention_score=fake_fused_attention),\n+        raising=False,\n+    )\n+    backend = vision.VisionAscendAttention(\n+        head_dim=head_dim,\n+        num_heads=num_heads,\n+        num_kv_heads=num_heads,\n+    )\n+    kwargs = {}\n+    if output_mode == \"metadata\":\n+        kwargs[\"forward_metadata\"] = vision.VisionAttentionMetadata(\n+            cu_seqlens=cu_seqlens, seq_lens=lengths, max_seqlen=max(seq_lens)\n+        )\n+    elif output_mode == \"graph\":\n+        kwargs[\"output_ws\"] = workspace\n+\n+    output = backend(\n+        q=q,\n+        k=k,\n+        v=v,\n+        cu_seqlens=cu_seqlens[1:] if output_mode == \"graph\" else cu_seqlens,\n+        bsz=bsz,\n+        seq_len=seq_len,\n+        **kwargs,\n+    )\n+\n+    expected = torch.zeros_like(v)\n+    expected[valid_mask] = v[valid_mask] + 1\n+    torch.testing.assert_close(output, expected)\n+    assert torch.isfinite(output).all()\n+    if output_mode == \"graph\" and not valid_mask.all():\n+        assert output is workspace\n+\n+\n if __name__ == \"__main__\":\n     sys.exit(pytest.main([__file__]))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b105d7d9e69520c141698c8e28ce78e758813c83/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_vision_backend_selection.py",
