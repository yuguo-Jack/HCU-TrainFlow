      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/22dd2c3d8004582d5fa3443ee5eaffb054f8f49b/python%2Fsglang%2Fsrt%2Fobservability%2Fmetrics_collector.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fobservability%2Fmetrics_collector.py?ref=22dd2c3d8004582d5fa3443ee5eaffb054f8f49b",
      "deletions": 0,
      "filename": "python/sglang/srt/observability/metrics_collector.py",
      "patch": "@@ -1898,7 +1898,15 @@ def __init__(\n         )\n \n         if bucket_time_to_first_token is None:\n+            # The first buckets sit below 0.1 s: a short prompt on an H100 gets its\n+            # first token in 20 to 60 ms, and with 0.1 as the lowest bucket every\n+            # quantile below it reads the same value.\n             bucket_time_to_first_token = [\n+                0.01,\n+                0.02,\n+                0.04,\n+                0.06,\n+                0.08,\n                 0.1,\n                 0.2,\n                 0.4,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/22dd2c3d8004582d5fa3443ee5eaffb054f8f49b/python%2Fsglang%2Fsrt%2Fobservability%2Fmetrics_collector.py",
      "sha": "69e8d703b0f6980b1ca739b506e730ed6ad8b3e3",
      "status": "modified"
    },
    {
      "additions": 77,
      "blob_url": "https://github.com/sgl-project/sglang/blob/22dd2c3d8004582d5fa3443ee5eaffb054f8f49b/test%2Fregistered%2Funit%2Fobservability%2Ftest_metrics_collector.py",
      "changes": 77,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fobservability%2Ftest_metrics_collector.py?ref=22dd2c3d8004582d5fa3443ee5eaffb054f8f49b",
      "deletions": 0,
      "filename": "test/registered/unit/observability/test_metrics_collector.py",
      "patch": "@@ -0,0 +1,77 @@\n+\"\"\"Unit tests for the tokenizer metrics collector's defaults: no server, no model.\"\"\"\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+import unittest\n+from typing import ClassVar\n+\n+from sglang.srt.observability.metrics_collector import TokenizerMetricsCollector\n+from sglang.srt.runtime_context import get_context, reset_context\n+from sglang.test.test_utils import CustomTestCase\n+\n+\n+class _RecordingMetric:\n+    \"\"\"Keeps the constructor arguments, so a test can read the buckets.\"\"\"\n+\n+    instances: ClassVar[list] = []\n+\n+    def __init__(self, *args, name=None, labelnames=(), buckets=None, **kwargs):\n+        self.name = name if name is not None else args[0]\n+        self.labelnames = tuple(labelnames)\n+        self.buckets = buckets\n+        _RecordingMetric.instances.append(self)\n+\n+    def labels(self, *values, **labels):\n+        return self\n+\n+\n+class _RecordingTokenizerMetricsCollector(TokenizerMetricsCollector):\n+    _counter_cls = _RecordingMetric\n+    _gauge_cls = _RecordingMetric\n+    _histogram_cls = _RecordingMetric\n+\n+\n+def _collector(**kwargs):\n+    # The constructor reads the published config; a unit test has none.\n+    with get_context().override_server_args(\n+        prompt_tokens_buckets=None, generation_tokens_buckets=None\n+    ):\n+        return _RecordingTokenizerMetricsCollector(labels={\"model_name\": \"m\"}, **kwargs)\n+\n+\n+class TestDefaultBuckets(CustomTestCase):\n+    def setUp(self):\n+        _RecordingMetric.instances.clear()\n+        _collector()\n+\n+    def tearDown(self):\n+        reset_context()\n+\n+    def _buckets(self, name):\n+        return next(m.buckets for m in _RecordingMetric.instances if m.name == name)\n+\n+    def test_ttft_buckets_resolve_fast_first_tokens(self):\n+        # A short prompt on a current GPU returns its first token in tens of\n+        # milliseconds; the lowest buckets have to sit below 0.1 s to tell\n+        # 20 ms from 90 ms.\n+        buckets = self._buckets(\"sglang:time_to_first_token_seconds\")\n+        self.assertEqual(buckets[:6], [0.01, 0.02, 0.04, 0.06, 0.08, 0.1])\n+        self.assertEqual(buckets, sorted(buckets))\n+\n+    def test_ttft_buckets_keep_the_long_tail(self):\n+        buckets = self._buckets(\"sglang:time_to_first_token_seconds\")\n+        self.assertIn(1, buckets)\n+        self.assertIn(400, buckets)\n+\n+    def test_explicit_buckets_are_used_as_given(self):\n+        _RecordingMetric.instances.clear()\n+        _collector(bucket_time_to_first_token=[0.5, 1, 2])\n+        self.assertEqual(\n+            self._buckets(\"sglang:time_to_first_token_seconds\"), [0.5, 1, 2]\n+        )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/22dd2c3d8004582d5fa3443ee5eaffb054f8f49b/test%2Fregistered%2Funit%2Fobservability%2Ftest_metrics_collector.py",
