      "additions": 11,
      "blob_url": "https://github.com/sgl-project/sglang/blob/eb0fba6a4c51e51c4a46d160c5f1041bce843f57/python%2Fsglang%2Fsrt%2Ffunction_call%2Fgigachat35_detector.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fgigachat35_detector.py?ref=eb0fba6a4c51e51c4a46d160c5f1041bce843f57",
      "deletions": 10,
      "filename": "python/sglang/srt/function_call/gigachat35_detector.py",
      "patch": "@@ -4,6 +4,7 @@\n from typing import Any, Dict, List\n \n from sglang.srt.entrypoints.openai.protocol import Tool\n+from sglang.srt.environ import envs\n from sglang.srt.function_call.base_format_detector import BaseFormatDetector\n from sglang.srt.function_call.core_types import (\n     StreamingParseResult,\n@@ -115,21 +116,21 @@ def parse_streaming_increment(\n         invokes_body, _, _ = after_open.partition(self.eot_token)\n         matches = list(_GCML_INVOKE_RE.finditer(invokes_body))\n         calls: List[ToolCallItem] = []\n-        for i in range(self._emitted_invokes, len(matches)):\n-            m = matches[i]\n+        for m in matches[self._emitted_invokes :]:\n             name = m.group(\"name\")\n             if name not in self._tool_indices:\n                 logger.warning(f\"[GigaChat35] undefined function call: {name}\")\n-                continue\n+                if not envs.SGLANG_FORWARD_UNKNOWN_TOOLS.get():\n+                    continue\n             args = _parse_gcml_invoke_body(m.group(\"body\"))\n             args_json = json.dumps(args, ensure_ascii=False)\n-            calls.append(ToolCallItem(tool_index=i, name=name, parameters=args_json))\n-            while len(self.prev_tool_call_arr) <= i:\n-                self.prev_tool_call_arr.append({})\n-            self.prev_tool_call_arr[i] = {\"name\": name, \"arguments\": args}\n-            while len(self.streamed_args_for_tool) <= i:\n-                self.streamed_args_for_tool.append(\"\")\n-            self.streamed_args_for_tool[i] = args_json\n+            # Count emitted calls, not invokes, so a skipped unknown tool leaves no gap.\n+            tool_index = len(self.prev_tool_call_arr)\n+            calls.append(\n+                ToolCallItem(tool_index=tool_index, name=name, parameters=args_json)\n+            )\n+            self.prev_tool_call_arr.append({\"name\": name, \"arguments\": args})\n+            self.streamed_args_for_tool.append(args_json)\n \n         self._emitted_invokes = len(matches)\n         return StreamingParseResult(calls=calls)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/eb0fba6a4c51e51c4a46d160c5f1041bce843f57/python%2Fsglang%2Fsrt%2Ffunction_call%2Fgigachat35_detector.py",
      "sha": "5116fa5850f063029828223906dca4e2ad1c186b",
      "status": "modified"
    },
    {
      "additions": 65,
      "blob_url": "https://github.com/sgl-project/sglang/blob/eb0fba6a4c51e51c4a46d160c5f1041bce843f57/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gigachat35_detector.py",
      "changes": 65,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gigachat35_detector.py?ref=eb0fba6a4c51e51c4a46d160c5f1041bce843f57",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_gigachat35_detector.py",
      "patch": "@@ -0,0 +1,65 @@\n+\"\"\"Unit tests for GigaChat35Detector - no server, no model loading.\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.entrypoints.openai.protocol import Function, Tool\n+from sglang.srt.environ import envs\n+from sglang.srt.function_call.gigachat35_detector import GigaChat35Detector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+_OPEN = \"<｜GCML｜tool_calls>\"\n+_CLOSE = \"</｜GCML｜tool_calls>\"\n+\n+\n+def _make_tools():\n+    return [\n+        Tool(\n+            type=\"function\",\n+            function=Function(\n+                name=\"search\",\n+                parameters={\"type\": \"object\", \"properties\": {\"q\": {\"type\": \"string\"}}},\n+            ),\n+        ),\n+    ]\n+\n+\n+def _invoke(name, q):\n+    return (\n+        f'<｜GCML｜invoke name=\"{name}\">'\n+        f'<｜GCML｜parameter name=\"q\" string=\"true\">{q}</｜GCML｜parameter>'\n+        \"</｜GCML｜invoke>\"\n+    )\n+\n+\n+def _stream(text, tools):\n+    detector = GigaChat35Detector()\n+    calls = list(detector.parse_streaming_increment(text, tools).calls)\n+    calls += detector.finish(tools).calls\n+    return calls\n+\n+\n+class TestGigaChat35DetectorStreaming(CustomTestCase):\n+    def setUp(self):\n+        self.tools = _make_tools()\n+        self.text = _OPEN + _invoke(\"nope\", \"x\") + _invoke(\"search\", \"y\") + _CLOSE\n+\n+    def test_skipped_unknown_tool_leaves_no_index_gap(self):\n+        \"\"\"Streamed tool_index must stay contiguous after a skipped unknown tool.\"\"\"\n+        with envs.SGLANG_FORWARD_UNKNOWN_TOOLS.override(False):\n+            calls = _stream(self.text, self.tools)\n+        self.assertEqual([(c.tool_index, c.name) for c in calls], [(0, \"search\")])\n+\n+    def test_forward_unknown_tools_in_streaming(self):\n+        \"\"\"SGLANG_FORWARD_UNKNOWN_TOOLS must forward unknown tools when streaming too.\"\"\"\n+        with envs.SGLANG_FORWARD_UNKNOWN_TOOLS.override(True):\n+            calls = _stream(self.text, self.tools)\n+        self.assertEqual(\n+            [(c.tool_index, c.name) for c in calls], [(0, \"nope\"), (1, \"search\")]\n+        )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/eb0fba6a4c51e51c4a46d160c5f1041bce843f57/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gigachat35_detector.py",
