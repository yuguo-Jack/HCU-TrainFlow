  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/daf31e521112537b8dc17117deec1a27c996cbe1/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py?ref=daf31e521112537b8dc17117deec1a27c996cbe1",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/qwen3_coder_detector.py",
      "patch": "@@ -390,6 +390,12 @@ def parse_streaming_increment(\n             # 4. Function End: </function>\n             # -------------------------------------------------------\n             if current_slice.startswith(self.function_end_token):\n+                if self.current_func_name is None:\n+                    # Stray closing tag (no function is open, e.g. a repeated\n+                    # `</function>` after `</tool_call>`): consume it without\n+                    # emitting another `}` into the finished call's arguments.\n+                    self.parsed_pos += len(self.function_end_token)\n+                    continue\n                 if not self.json_started:\n                     calls.append(\n                         ToolCallItem(tool_index=self.current_tool_id, parameters=\"{\")",
      "raw_url": "https://github.com/sgl-project/sglang/raw/daf31e521112537b8dc17117deec1a27c996cbe1/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py",
      "sha": "47e92fe2faed0dd92a30ddef1624ae18292329fa",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/sgl-project/sglang/blob/daf31e521112537b8dc17117deec1a27c996cbe1/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py?ref=daf31e521112537b8dc17117deec1a27c996cbe1",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_function_call_parser.py",
      "patch": "@@ -2507,6 +2507,38 @@ def test_streaming_with_text_and_tool(self):\n         self.assertTrue(full_text.startswith(\"Let me\"))\n         self.assertGreater(len(all_calls), 0)\n \n+    def test_streaming_stray_closing_tags_do_not_corrupt_arguments(self):\n+        \"\"\"\n+        Test stray closing tags after a complete call stay inert.\n+\n+        Scenario: a finished call is followed by a stray tail repeating the\n+        closers (`</invoke>`, `</function>`, `</tool_call>`), which models\n+        sometimes emit. Purpose: the stray `</function>` must not emit a\n+        second `}` into the finished call's arguments (regression for #45226).\n+        \"\"\"\n+        chunks = [\n+            \"<tool_call>\",\n+            \"<function=get_current_weather>\",\n+            \"<parameter=location>Boston</parameter>\",\n+            \"</function>\",\n+            \"</tool_call>\",\n+            \"\\n</invoke>\\n\\n</function>\\n</tool_call>\\n\",\n+        ]\n+\n+        detector = Qwen3CoderDetector()\n+        collected_params = \"\"\n+\n+        for chunk in chunks:\n+            result = detector.parse_streaming_increment(chunk, self.tools)\n+            for call in result.calls:\n+                if call.parameters:\n+                    collected_params += call.parameters\n+\n+        # The finished call's arguments stay valid JSON (the stray\n+        # `</function>` used to append a second `}`).\n+        params = json.loads(collected_params)\n+        self.assertEqual(params[\"location\"], \"Boston\")\n+\n     # ==================== Parameter Type Tests ====================\n \n     def test_integer_parameter_conversion(self):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/daf31e521112537b8dc17117deec1a27c996cbe1/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_function_call_parser.py",
      "sha": "2d062170ffdbc333b702834223d03750c48274fa",
      "status": "modified"
    }
