      "deletions": 2,
      "filename": "sgl-kernel/csrc/infllm_v2/max_pooling.cu",
      "patch": "@@ -9,8 +9,8 @@\n //   * `TypeTraits<T>::inf()` is replaced by `static_cast<T>(INFINITY)`, and the\n //     pooling max is accumulated in fp32 so we don't rely on half/bf16\n //     comparison operators.\n-//   * Outputs are pre-allocated on the Python side and passed in (the original\n-//     wrappers also allocated a zero-filled output before launching).\n+//   * Outputs are pre-allocated on the Python side and passed in. The kernel\n+//     writes every element for packed varlen inputs, so no pre-zeroing is needed.\n \n #include <ATen/cuda/CUDAContext.h>\n #include <cuda_bf16.h>",
      "raw_url": "https://github.com/sgl-project/sglang/raw/52a41ec9b7006ca3b6cc834e40ad7973fff60479/sgl-kernel%2Fcsrc%2Finfllm_v2%2Fmax_pooling.cu",
      "sha": "c58d8d499f3133922b1058b0e65bcda3f411a03a",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/52a41ec9b7006ca3b6cc834e40ad7973fff60479/sgl-kernel%2Fpython%2Fsgl_kernel%2Finfllm_v2%2Fmax_pooling.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/sgl-kernel%2Fpython%2Fsgl_kernel%2Finfllm_v2%2Fmax_pooling.py?ref=52a41ec9b7006ca3b6cc834e40ad7973fff60479",
      "deletions": 2,
      "filename": "sgl-kernel/python/sgl_kernel/infllm_v2/max_pooling.py",
      "patch": "@@ -37,9 +37,9 @@ def max_pooling_1d_varlen(\n     padding = 1\n \n     num_heads = input.shape[0]\n-    total_q = input.shape[1]\n+    total_q = total_q if total_q > 0 else input.shape[1]\n \n-    output = torch.zeros(\n+    output = torch.empty(\n         num_heads, total_q, out_len, device=input.device, dtype=input.dtype\n     )\n     torch.ops.sgl_kernel.infllm_v2_max_pooling_1d_varlen.default(",
