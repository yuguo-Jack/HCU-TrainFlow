      "blob_url": "https://github.com/sgl-project/sglang/blob/32cecd63ca21e65caeb840963d1a74c025e558d7/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Flightonocr.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Flightonocr.py?ref=32cecd63ca21e65caeb840963d1a74c025e558d7",
      "deletions": 11,
      "filename": "python/sglang/srt/multimodal/processors/lightonocr.py",
      "patch": "@@ -21,6 +21,7 @@\n to produce a single contiguous range of image tokens per image.\n \"\"\"\n \n+from bisect import bisect_left, bisect_right\n from typing import List, Union\n \n from sglang.srt.models.lightonocr import LightOnOCRForConditionalGeneration\n@@ -83,11 +84,12 @@ async def process_mm_data_async(\n         input_ids = result.input_ids or []\n         mm_items = result.mm_items or []\n \n+        break_token_ids = self._break_token_ids\n         new_input_ids = []\n-        old_to_new = {}\n+        surviving_old_indices = []\n         for old_idx, token_id in enumerate(input_ids):\n-            if token_id not in self._break_token_ids:\n-                old_to_new[old_idx] = len(new_input_ids)\n+            if token_id not in break_token_ids:\n+                surviving_old_indices.append(old_idx)\n                 new_input_ids.append(token_id)\n \n         if len(new_input_ids) == len(input_ids):\n@@ -97,14 +99,20 @@ async def process_mm_data_async(\n         for mm_item in mm_items:\n             if not mm_item.offsets:\n                 continue\n-            new_indices = sorted(\n-                old_to_new[idx]\n-                for start, end in mm_item.offsets\n-                for idx in range(start, end + 1)\n-                if idx in old_to_new\n-            )\n-            if new_indices:\n-                mm_item.offsets = [(new_indices[0], new_indices[-1])]\n+            min_new_idx = None\n+            max_new_idx = None\n+            for start, end in mm_item.offsets:\n+                lo = bisect_left(surviving_old_indices, start)\n+                hi = bisect_right(surviving_old_indices, end) - 1\n+                if lo <= hi:\n+                    if min_new_idx is None or lo < min_new_idx:\n+                        min_new_idx = lo\n+                    if max_new_idx is None or hi > max_new_idx:\n+                        max_new_idx = hi\n+            if min_new_idx is not None and max_new_idx is not None:\n+                mm_item.offsets = [(min_new_idx, max_new_idx)]\n+            else:\n+                mm_item.offsets = []\n \n         result.input_ids = new_input_ids\n         return result",
      "raw_url": "https://github.com/sgl-project/sglang/raw/32cecd63ca21e65caeb840963d1a74c025e558d7/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Flightonocr.py",
      "sha": "3d4c8a81eca0b2fad7f5aa309c7fda0deec24c7a",
      "status": "modified"
