      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.pre-commit-config.yaml?ref=a9c567669a3e73f64534d76968002be724834ced",
      "deletions": 12,
      "filename": ".pre-commit-config.yaml",
      "patch": "@@ -35,20 +35,8 @@ repos:\n     hooks:\n       - id: ruff\n         args:\n-          - --select=F401,F821,F823,UP037\n           - --fix\n         files: ^(benchmark/|docs/|examples/|python/sglang/|sgl-model-gateway/py_*|test/)\n-        exclude: |\n-          (?x)^(\n-          .*/__init__\\.py$|\n-          .*\\.ipynb$|\n-          python/sglang/kernels/aot/.*|\n-          python/sglang/srt/grpc/.*_pb2\\.py$|\n-          python/sglang/srt/grpc/.*_pb2_grpc\\.py$|\n-          python/sglang/srt/grpc/.*_pb2\\.pyi$|\n-          python/sglang/srt/grpc/.*_pb2_grpc\\.pyi$|\n-          python/sglang/(api|json)/v1/.*\\.py$|\n-          )$\n       - id: ruff-format\n         exclude: '^python/sglang/srt/grpc/.*_pb2\\.py$|^python/sglang/srt/grpc/.*_pb2_grpc\\.py$|^python/sglang/srt/grpc/.*_pb2\\.pyi$|^python/sglang/srt/grpc/.*_pb2_grpc\\.pyi$|^python/sglang/(api|json)/v1/.*\\.py$'\n   - repo: https://github.com/codespell-project/codespell",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a9c567669a3e73f64534d76968002be724834ced/.pre-commit-config.yaml",
      "sha": "a9f36c3174ea0be218eac59567d2ca427e2ddb77",
      "status": "modified"
    },
    {
      "additions": 23,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a9c567669a3e73f64534d76968002be724834ced/pyproject.toml",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/pyproject.toml?ref=a9c567669a3e73f64534d76968002be724834ced",
      "deletions": 0,
      "filename": "pyproject.toml",
      "patch": "@@ -0,0 +1,23 @@\n+[tool.ruff]\n+# Apply exclusions to explicitly passed files as well as editor diagnostics.\n+force-exclude = true\n+\n+[tool.ruff.lint]\n+# Shared by editors and the Ruff pre-commit hook.\n+select = [\"F401\", \"F821\", \"F823\", \"UP037\"]\n+exclude = [\n+  \"__init__.py\",\n+  \"*.ipynb\",\n+  \"python/sglang/kernels/aot/**\",\n+  \"python/sglang/srt/grpc/**/*_pb2.py\",\n+  \"python/sglang/srt/grpc/**/*_pb2_grpc.py\",\n+  \"python/sglang/srt/grpc/**/*_pb2.pyi\",\n+  \"python/sglang/srt/grpc/**/*_pb2_grpc.pyi\",\n+  \"python/sglang/api/v1/**/*.py\",\n+  \"python/sglang/json/v1/**/*.py\",\n+  # Mirror the global pre-commit exclusions for editor linting.\n+  \"python/sglang/multimodal_gen/csrc/**\",\n+  \"python/sglang/kernels/ops/diffusion/render/**\",\n+  \"python/sglang/kernels/ops/attention/flash_attn/cute/**\",\n+  \"python/sglang/kernels/jit/csrc/diffusion/vsa_block_sparse_sm100/**\",\n+]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a9c567669a3e73f64534d76968002be724834ced/pyproject.toml",
      "sha": "f73563af5b7f1d60336e15f90aa2be4688150353",
      "status": "added"
    }
