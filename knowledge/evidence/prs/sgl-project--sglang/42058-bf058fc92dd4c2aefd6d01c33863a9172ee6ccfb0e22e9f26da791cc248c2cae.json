    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9134c84da12aa389a89362146455b730d461e37f/python%2Fsglang%2Fsrt%2Ffunction_call%2Fminimax_m2.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fminimax_m2.py?ref=9134c84da12aa389a89362146455b730d461e37f",
      "deletions": 2,
      "filename": "python/sglang/srt/function_call/minimax_m2.py",
      "patch": "@@ -145,8 +145,8 @@ def _convert_param_value_with_types(\n         # Normalize types\n         normalized_types = [t.lower() for t in param_types]\n \n-        # Try null first if it's in the list\n-        if \"null\" in normalized_types or value.lower() in (\"null\", \"none\", \"nil\"):\n+        # A nullable schema still needs to convert non-null values normally.\n+        if value.lower() in (\"null\", \"none\", \"nil\"):\n             return None\n \n         # Try each type in order of preference (most specific first, string as fallback)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9134c84da12aa389a89362146455b730d461e37f/python%2Fsglang%2Fsrt%2Ffunction_call%2Fminimax_m2.py",
      "sha": "8a75d42fcd03de320c67d1f22ce1103407251141",
      "status": "modified"
    },
    {
      "additions": 82,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9134c84da12aa389a89362146455b730d461e37f/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_minimax_m2_nullable.py",
      "changes": 82,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_minimax_m2_nullable.py?ref=9134c84da12aa389a89362146455b730d461e37f",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_minimax_m2_nullable.py",
      "patch": "@@ -0,0 +1,82 @@\n+import json\n+import unittest\n+\n+from sglang.srt.entrypoints.openai.protocol import Function, Tool\n+from sglang.srt.function_call.function_call_parser import FunctionCallParser\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+\n+class TestMinimaxM2NullableParameters(unittest.TestCase):\n+    def check_value(self, schema, raw, expected):\n+        tools = [\n+            Tool(\n+                type=\"function\",\n+                function=Function(\n+                    name=\"lookup\",\n+                    parameters={\"type\": \"object\", \"properties\": {\"value\": schema}},\n+                ),\n+            )\n+        ]\n+        pieces = [\n+            \"<minimax:tool_call>\",\n+            '<invoke name=\"lookup\">',\n+            f'<parameter name=\"value\">{raw}</parameter>',\n+            \"</invoke>\",\n+            \"</minimax:tool_call>\",\n+        ]\n+        for chunks in (\n+            None,\n+            [\"\".join(pieces)],\n+            pieces,\n+            [pieces[0], *\"\".join(pieces[1:])],\n+        ):\n+            with self.subTest(schema=schema, raw=raw, streaming=chunks is not None):\n+                parser = FunctionCallParser(tools, \"minimax-m2\")\n+                if chunks is None:\n+                    normal, calls = parser.parse_non_stream(\"\".join(pieces))\n+                else:\n+                    normal, calls = \"\", []\n+                    for chunk in chunks:\n+                        content, delta = parser.parse_stream_chunk(chunk)\n+                        normal += content\n+                        calls.extend(delta)\n+                self.assertEqual(normal, \"\")\n+                self.assertEqual([call.name for call in calls if call.name], [\"lookup\"])\n+                self.assertTrue(all(call.tool_index == 0 for call in calls))\n+                arguments = json.loads(\"\".join(call.parameters for call in calls))\n+                self.assertEqual(arguments, {\"value\": expected})\n+                self.assertIs(type(arguments[\"value\"]), type(expected))\n+\n+    def test_nullable_type_arrays_preserve_non_null_values(self):\n+        for kind, raw, expected in (\n+            (\"integer\", \"42\", 42),\n+            (\"number\", \"2.5\", 2.5),\n+            (\"string\", \"hello\", \"hello\"),\n+            (\"boolean\", \"false\", False),\n+            (\"array\", \"[1,2]\", [1, 2]),\n+            (\"object\", '{\"a\":1}', {\"a\": 1}),\n+        ):\n+            self.check_value({\"type\": [kind, \"null\"]}, raw, expected)\n+\n+    def test_nullable_compositions_preserve_non_null_values(self):\n+        for keyword in (\"anyOf\", \"oneOf\"):\n+            self.check_value(\n+                {keyword: [{\"type\": \"integer\"}, {\"type\": \"null\"}]}, \"42\", 42\n+            )\n+\n+    def test_nullable_enum_preserves_non_null_values(self):\n+        self.check_value({\"enum\": [\"low\", \"high\", None]}, \"high\", \"high\")\n+\n+    def test_explicit_null_and_legacy_aliases_are_unchanged(self):\n+        for raw in (\"null\", \"none\", \"nil\"):\n+            self.check_value({\"type\": [\"integer\", \"null\"]}, raw, None)\n+\n+    def test_non_nullable_values_are_unchanged(self):\n+        self.check_value({\"type\": \"integer\"}, \"42\", 42)\n+        self.check_value({\"type\": \"string\"}, \"hello\", \"hello\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9134c84da12aa389a89362146455b730d461e37f/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_minimax_m2_nullable.py",
      "sha": "ffe949ae36ed73c6bdd184a52463c6aea29b1e67",
      "status": "added"
    }
