      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ac7c5d8711891e52577dde233667b0308569db38/python%2Fsglang%2Fsrt%2Flora%2Flora.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flora%2Flora.py?ref=ac7c5d8711891e52577dde233667b0308569db38",
      "deletions": 1,
      "filename": "python/sglang/srt/lora/lora.py",
      "patch": "@@ -19,6 +19,7 @@\n # https://github.com/vllm-project/vllm/blob/4abf6336ec65c270343eb895e7b18786e9274176/vllm/lora/layers.py\n \n import logging\n+import math\n import re\n from typing import Dict, List, Optional\n \n@@ -68,7 +69,10 @@ def __init__(\n         self.base_hf_config: AutoConfig = base_hf_config\n         self.load_config: LoadConfig = load_config\n         self.lora_backend: BaseLoRABackend = lora_backend\n-        self.scaling: float = self.config.lora_alpha / self.config.r\n+        if self.config.use_rslora:\n+            self.scaling: float = self.config.lora_alpha / math.sqrt(self.config.r)\n+        else:\n+            self.scaling: float = self.config.lora_alpha / self.config.r\n \n         # Bypass nn.Module.__setattr__ so the base model is held as a plain\n         # reference rather than auto-registered as a submodule (which would",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ac7c5d8711891e52577dde233667b0308569db38/python%2Fsglang%2Fsrt%2Flora%2Flora.py",
      "sha": "181f63ecbc010bf9b10c43890cf547d9096131fb",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ac7c5d8711891e52577dde233667b0308569db38/python%2Fsglang%2Fsrt%2Flora%2Flora_config.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flora%2Flora_config.py?ref=ac7c5d8711891e52577dde233667b0308569db38",
      "deletions": 0,
      "filename": "python/sglang/srt/lora/lora_config.py",
      "patch": "@@ -43,6 +43,7 @@ def __init__(\n         self.r = self.hf_config[\"r\"]\n         self.lora_alpha = self.hf_config[\"lora_alpha\"]\n         self.use_dora = self.hf_config.get(\"use_dora\", False)\n+        self.use_rslora = self.hf_config.get(\"use_rslora\", False)\n \n         # Filter fake added tokens: tokens with ID < base_vocab_size are already\n         # part of the base vocabulary and should not be treated as added tokens.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ac7c5d8711891e52577dde233667b0308569db38/python%2Fsglang%2Fsrt%2Flora%2Flora_config.py",
      "sha": "b5008f150fe1fb0694f27e8a8d05709f67408261",
      "status": "modified"
    },
    {
      "additions": 71,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ac7c5d8711891e52577dde233667b0308569db38/test%2Fregistered%2Funit%2Flora%2Ftest_rslora_scaling.py",
      "changes": 71,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flora%2Ftest_rslora_scaling.py?ref=ac7c5d8711891e52577dde233667b0308569db38",
      "deletions": 0,
      "filename": "test/registered/unit/lora/test_rslora_scaling.py",
      "patch": "@@ -0,0 +1,71 @@\n+import math\n+from types import SimpleNamespace\n+\n+import pytest\n+\n+from sglang.srt.lora.lora import LoRAAdapter\n+from sglang.srt.lora.lora_config import LoRAConfig\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=1, suite=\"base-a-test-cpu\")\n+\n+\n+def _make_config(r, lora_alpha, use_rslora=False):\n+    return LoRAConfig.from_dict(\n+        {\n+            \"peft_type\": \"LORA\",\n+            \"r\": r,\n+            \"lora_alpha\": lora_alpha,\n+            \"target_modules\": [\"q_proj\"],\n+            \"use_rslora\": use_rslora,\n+        }\n+    )\n+\n+\n+def _make_adapter(config):\n+    return LoRAAdapter(\n+        uid=\"test\",\n+        config=config,\n+        base_hf_config=SimpleNamespace(num_hidden_layers=1),\n+        load_config=None,\n+        lora_backend=None,\n+    )\n+\n+\n+@pytest.mark.parametrize(\"r,lora_alpha\", [(16, 32), (64, 128), (256, 256)])\n+class TestRSLoRAScaling:\n+    def test_standard_scaling(self, r, lora_alpha):\n+        config = _make_config(r, lora_alpha, use_rslora=False)\n+        adapter = _make_adapter(config)\n+        expected = lora_alpha / r\n+        assert adapter.scaling == pytest.approx(expected), (\n+            f\"standard LoRA scaling: expected {expected}, got {adapter.scaling}\"\n+        )\n+\n+    def test_rslora_scaling(self, r, lora_alpha):\n+        config = _make_config(r, lora_alpha, use_rslora=True)\n+        adapter = _make_adapter(config)\n+        expected = lora_alpha / math.sqrt(r)\n+        assert adapter.scaling == pytest.approx(expected), (\n+            f\"rsLoRA scaling: expected {expected}, got {adapter.scaling}\"\n+        )\n+\n+    def test_rslora_differs_from_standard(self, r, lora_alpha):\n+        standard = _make_adapter(_make_config(r, lora_alpha, use_rslora=False))\n+        rslora = _make_adapter(_make_config(r, lora_alpha, use_rslora=True))\n+        assert rslora.scaling > standard.scaling, (\n+            f\"rsLoRA scaling ({rslora.scaling}) should be larger \"\n+            f\"than standard ({standard.scaling}) for r={r}\"\n+        )\n+\n+\n+def test_use_rslora_default_false():\n+    config = LoRAConfig.from_dict(\n+        {\n+            \"peft_type\": \"LORA\",\n+            \"r\": 16,\n+            \"lora_alpha\": 32,\n+            \"target_modules\": [\"q_proj\"],\n+        }\n+    )\n+    assert config.use_rslora is False",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ac7c5d8711891e52577dde233667b0308569db38/test%2Fregistered%2Funit%2Flora%2Ftest_rslora_scaling.py",
      "sha": "ab354d555dd45078f864be1a4f39557a7a3f81c1",
      "status": "added"
    }
