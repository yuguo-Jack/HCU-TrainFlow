  "files": [
    {
      "additions": 31,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e6750aa8dd9b85ba522ad9ff17b59f30d7c43328/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py?ref=e6750aa8dd9b85ba522ad9ff17b59f30d7c43328",
      "deletions": 13,
      "filename": "python/sglang/srt/mem_cache/unified_radix_cache.py",
      "patch": "@@ -1243,21 +1243,39 @@ def checkpoint_into_tree(self, req: Req, *, up_to: int, **kwargs) -> None:\n                 )\n             )\n \n-        # With PD decode radix caching, SWA matching can stop short of the inserted path.\n-        # Repoint from that path to protect all tree-owned KV.\n+        # An unfinished request already points at its protected prefix. If the\n+        # insert matched no new prefix, the tree adopted its remaining indices,\n+        # so rebuilding the path and writing the same row is unnecessary.\n         new_last_node = result.last_device_node\n-        new_indices = self.path_device_indices(new_last_node)\n         new_prefix_len = result.prefix_len\n-        assert req.kv.cache_protected_len <= len(new_indices) + self.page_size - 1, (\n-            f\"{req.kv.cache_protected_len=}, {len(new_indices)=}, {page_aligned_len=}\"\n-        )\n-        assert (\n-            new_prefix_len <= len(new_indices) and len(new_indices) == page_aligned_len\n-        ), f\"{new_prefix_len=}, {len(new_indices)=}, {page_aligned_len=}\"\n-        self.req_to_token_pool.write(\n-            (req.kv.req_pool_idx, slice(req.kv.cache_protected_len, len(new_indices))),\n-            new_indices[req.kv.cache_protected_len :],\n+        keep_request_indices = (\n+            not is_finished\n+            and not self.enable_session_radix_cache\n+            and new_prefix_len <= insert_params.prev_prefix_len\n         )\n+        if keep_request_indices:\n+            # A successful insert owns the entire page-aligned key, including\n+            # nodes whose auxiliary components contain only tombstones.\n+            new_protected_len = page_aligned_len\n+        else:\n+            # SWA matching can stop short of the inserted path. Protect the\n+            # entire path even when its live SWA tail is below the window.\n+            new_indices = self.path_device_indices(new_last_node)\n+            new_protected_len = len(new_indices)\n+        assert req.kv.cache_protected_len <= new_protected_len + self.page_size - 1, (\n+            f\"{req.kv.cache_protected_len=}, {new_protected_len=}, {page_aligned_len=}\"\n+        )\n+        assert new_prefix_len <= new_protected_len == page_aligned_len, (\n+            f\"{new_prefix_len=}, {new_protected_len=}, {page_aligned_len=}\"\n+        )\n+        if not keep_request_indices:\n+            self.req_to_token_pool.write(\n+                (\n+                    req.kv.req_pool_idx,\n+                    slice(req.kv.cache_protected_len, new_protected_len),\n+                ),\n+                new_indices[req.kv.cache_protected_len :],\n+            )\n \n         self.unlock(req.lock)\n         # Opt-in: leave the matched-prefix mamba evictable during decode (it is\n@@ -1276,7 +1294,7 @@ def checkpoint_into_tree(self, req: Req, *, up_to: int, **kwargs) -> None:\n         )\n \n         # Update req fields\n-        req.kv.cache_protected_len = len(new_indices)\n+        req.kv.cache_protected_len = new_protected_len\n         req.last_node = new_last_node\n \n         # cleanup",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e6750aa8dd9b85ba522ad9ff17b59f30d7c43328/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py",
      "sha": "759efe3f8a53d137157db8e0caa881dcae9a6b94",
      "status": "modified"
    },
    {
      "additions": 65,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e6750aa8dd9b85ba522ad9ff17b59f30d7c43328/test%2Fregistered%2Funit%2Fmem_cache%2Funified_radix_cache%2Ftest_unified_radix_cache_core.py",
      "changes": 65,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Funified_radix_cache%2Ftest_unified_radix_cache_core.py?ref=e6750aa8dd9b85ba522ad9ff17b59f30d7c43328",
      "deletions": 0,
      "filename": "test/registered/unit/mem_cache/unified_radix_cache/test_unified_radix_cache_core.py",
      "patch": "@@ -631,6 +631,71 @@ def test_checkpoint_mid_flight(self):\n         cache.unlock(req.lock)\n         cache.sanity_check()\n \n+    def test_checkpoint_unshared_chunk_preserves_indices(self):\n+        cache, allocator, pool = build_fixture(self.cfg)\n+        tokens = self._make_seq(1, 3)\n+        req, indices = self._make_inflight_req(cache, allocator, pool, tokens)\n+        if self.cfg.has_mamba:\n+            req.kv.mamba_last_track_seqlen = len(tokens)\n+        with mock.patch.object(\n+            cache, \"path_device_indices\", wraps=cache.path_device_indices\n+        ) as collect:\n+            cache.checkpoint(req, up_to=req.extend_end)\n+            collect.assert_not_called()\n+        protected = req.kv.cache_protected_len\n+        self.assertGreater(protected, 0)\n+        torch.testing.assert_close(\n+            pool.req_to_token[req.kv.req_pool_idx, :protected].to(torch.int64),\n+            indices[:protected],\n+        )\n+        torch.testing.assert_close(\n+            cache.path_device_indices(req.last_node), indices[:protected]\n+        )\n+        cache.unlock(req.lock)\n+        cache.sanity_check()\n+\n+    @requires(lambda cfg: not cfg.has_mamba, \"Mamba uses tracked checkpoint lengths\")\n+    def test_checkpoint_incremental_chunks_preserve_indices(self):\n+        cache, allocator, pool = build_fixture(self.cfg)\n+        tokens = self._make_seq(1, 3)\n+        req, indices = self._make_inflight_req(cache, allocator, pool, tokens)\n+        with mock.patch.object(\n+            cache, \"path_device_indices\", wraps=cache.path_device_indices\n+        ) as collect:\n+            for end in range(self.cfg.page_size, len(tokens) + 1, self.cfg.page_size):\n+                cache.checkpoint_into_tree(req, up_to=end)\n+                self.assertEqual(req.kv.cache_protected_len, end)\n+            collect.assert_not_called()\n+        torch.testing.assert_close(\n+            pool.req_to_token[req.kv.req_pool_idx, : len(tokens)].long(), indices\n+        )\n+        torch.testing.assert_close(cache.path_device_indices(req.last_node), indices)\n+        cache.unlock(req.lock)\n+        cache.sanity_check()\n+\n+    def test_checkpoint_duplicate_chunk_adopts_existing_indices(self):\n+        cache, allocator, pool = build_fixture(self.cfg)\n+        tokens = self._make_seq(1, 3)\n+        first, _ = self._make_inflight_req(cache, allocator, pool, tokens)\n+        second, _ = self._make_inflight_req(cache, allocator, pool, tokens)\n+        if self.cfg.has_mamba:\n+            first.kv.mamba_last_track_seqlen = len(tokens)\n+            second.kv.mamba_last_track_seqlen = len(tokens)\n+        cache.checkpoint(first, up_to=first.extend_end)\n+        with mock.patch.object(\n+            cache, \"path_device_indices\", wraps=cache.path_device_indices\n+        ) as collect:\n+            cache.checkpoint(second, up_to=second.extend_end)\n+            collect.assert_called_once()\n+        protected = second.kv.cache_protected_len\n+        torch.testing.assert_close(\n+            pool.req_to_token[second.kv.req_pool_idx, :protected].to(torch.int64),\n+            cache.path_device_indices(second.last_node),\n+        )\n+        cache.unlock(first.lock)\n+        cache.unlock(second.lock)\n+        cache.sanity_check()\n+\n     @requires_swa_only\n     @requires_ps1_window4\n     def test_swa_unfinished_req_repoints_whole_insert_below_window(self):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e6750aa8dd9b85ba522ad9ff17b59f30d7c43328/test%2Fregistered%2Funit%2Fmem_cache%2Funified_radix_cache%2Ftest_unified_radix_cache_core.py",
      "sha": "b1a59ecd44788f10aede316eb043756027172213",
      "status": "modified"
    }
