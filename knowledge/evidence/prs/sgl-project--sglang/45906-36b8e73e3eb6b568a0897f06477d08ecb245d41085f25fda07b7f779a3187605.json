      "additions": 14,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e34ce13256ff5bf21ba190400ad002de1c38bab8/.github%2Factions%2Fcheck-pr-test-health%2Faction.test.cjs",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Factions%2Fcheck-pr-test-health%2Faction.test.cjs?ref=e34ce13256ff5bf21ba190400ad002de1c38bab8",
      "deletions": 2,
      "filename": ".github/actions/check-pr-test-health/action.test.cjs",
      "patch": "@@ -12,7 +12,9 @@ const run = new (Object.getPrototypeOf(async function () {}).constructor)(\n   'github', 'context', 'core', 'process', 'require', script,\n );\n \n-async function check({ snapshot = [], live = [], lint = 'success', event = 'pull_request' } = {}) {\n+async function check({\n+  snapshot = [], live = [], lint = 'success', event = 'pull_request', jobsError, warnings = [],\n+} = {}) {\n   const failures = [];\n   let labelReads = 0;\n   let jobReads = 0;\n@@ -35,6 +37,7 @@ async function check({ snapshot = [], live = [], lint = 'success', event = 'pull\n     },\n     paginate: async () => {\n       jobReads++;\n+      if (jobsError) throw jobsError;\n       return [{ name: 'model-test', status: 'completed', conclusion: 'failure', steps: [] }];\n     },\n   };\n@@ -43,7 +46,8 @@ async function check({ snapshot = [], live = [], lint = 'success', event = 'pull\n     payload: event === 'pull_request'\n       ? { pull_request: { number: 42, head: { sha: 'head' }, labels: labels(snapshot) } }\n       : {},\n-  }, { info: () => {}, setFailed: message => failures.push(message) },\n+  }, { info: () => {}, warning: message => warnings.push(message),\n+       setFailed: message => failures.push(message) },\n      { env: { GITHUB_WORKSPACE: WORKSPACE } }, require);\n   return { failures, labelReads, jobReads };\n }\n@@ -74,3 +78,11 @@ test('scheduled runs remain exempt', async () => {\n   assert.deepEqual(await check({ event: 'schedule' }),\n     { failures: [], labelReads: 0, jobReads: 0 });\n });\n+\n+test('a jobs-list 502 after retries warns and runs the shard', async () => {\n+  const warnings = [];\n+  const jobsError = Object.assign(new Error('Server Error'), { status: 502 });\n+  assert.deepEqual(await check({ jobsError, warnings }),\n+    { failures: [], labelReads: 1, jobReads: 1 });\n+  assert.match(warnings[0], /after 3 retries \\(HTTP 502: Server Error\\)/);\n+});",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e34ce13256ff5bf21ba190400ad002de1c38bab8/.github%2Factions%2Fcheck-pr-test-health%2Faction.test.cjs",
      "sha": "bbfb779d3903d29f2aca273f85afcc1d2f0cd015",
      "status": "modified"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e34ce13256ff5bf21ba190400ad002de1c38bab8/.github%2Factions%2Fcheck-pr-test-health%2Faction.yml",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Factions%2Fcheck-pr-test-health%2Faction.yml?ref=e34ce13256ff5bf21ba190400ad002de1c38bab8",
      "deletions": 6,
      "filename": ".github/actions/check-pr-test-health/action.yml",
      "patch": "@@ -16,6 +16,7 @@ runs:\n         SKIP_PR_TEST_HEALTH_CHECK: ${{ env.SKIP_PR_TEST_HEALTH_CHECK }}\n       with:\n         github-token: ${{ inputs.github-token }}\n+        retries: 3\n         script: |\n           core.info(`[health-check] START -- event=${context.eventName}, runId=${context.runId}`);\n \n@@ -62,12 +63,23 @@ runs:\n             return;\n           }\n \n-          const jobs = await github.paginate(github.rest.actions.listJobsForWorkflowRun, {\n-            owner: context.repo.owner,\n-            repo: context.repo.repo,\n-            run_id: context.runId,\n-            per_page: 100,\n-          });\n+          let jobs;\n+          try {\n+            jobs = await github.paginate(github.rest.actions.listJobsForWorkflowRun, {\n+              owner: context.repo.owner,\n+              repo: context.repo.repo,\n+              run_id: context.runId,\n+              per_page: 100,\n+            });\n+          } catch (err) {\n+            // Only reached once the `retries: 3` above are exhausted.\n+            core.warning(\n+              `[health-check] SKIP: could not list this run's jobs after 3 retries ` +\n+              `(HTTP ${err.status}: ${err.message}). This is a GitHub API error, ` +\n+              `not a test failure; this shard will run its tests.`\n+            );\n+            return;\n+          }\n           core.info(`[health-check] Total jobs in run: ${jobs.length}`);\n           const failedJobs = jobs.filter(j => j.status === 'completed' && j.conclusion === 'failure');\n           core.info(`[health-check] Failed jobs (before filtering): ${failedJobs.map(j => `${j.name}(${j.conclusion})`).join(', ') || 'none'}`);",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e34ce13256ff5bf21ba190400ad002de1c38bab8/.github%2Factions%2Fcheck-pr-test-health%2Faction.yml",
      "sha": "6508c862b430236dbfa6b4242489353644624c35",
      "status": "modified"
    }
