    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a73e95463c4000017e90c5ac5611af32e6fafe0d/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_policy.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_policy.py?ref=a73e95463c4000017e90c5ac5611af32e6fafe0d",
      "deletions": 2,
      "filename": "python/sglang/srt/managers/schedule_policy.py",
      "patch": "@@ -1100,12 +1100,13 @@ def add_chunked_req(self, req: Req):\n                 return req\n             if self.kv_shard_granule:\n                 # Align the absolute boundary to keep pages within one scratch region.\n-                # If no budget remains, use a full chunk to make progress.\n                 prefix_len = req.prefix_len\n                 floored = (\n                     prefix_len + _rem_tokens\n                 ) // self.kv_shard_granule * self.kv_shard_granule - prefix_len\n-                _rem_tokens = floored if floored > 0 else self.rem_chunk_tokens\n+                if floored <= 0:\n+                    return req\n+                _rem_tokens = floored\n \n         # A mid-chunk rank prefills this pass regardless of the delayer\n         # verdict, so report prefillable=True and ignore the result.\n@@ -1168,6 +1169,10 @@ def add_chunked_req(self, req: Req):\n             is_chunked_continuation=True,\n             compute_charge=req.extend_len if self.exact_chunk_fill else None,\n         )\n+        if truncated:\n+            self.memory_budget.reserve_unfinished_chunk(\n+                cand_extend_input_len - new_len\n+            )\n \n         # Return if chunked prefill not finished\n         return req if truncated else None",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a73e95463c4000017e90c5ac5611af32e6fafe0d/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_policy.py",
      "sha": "f1b715833d01e55788a0aa50ba4cf9818f2cc224",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a73e95463c4000017e90c5ac5611af32e6fafe0d/python%2Fsglang%2Fsrt%2Fmem_cache%2Fprefill_budget.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Fprefill_budget.py?ref=a73e95463c4000017e90c5ac5611af32e6fafe0d",
      "deletions": 3,
      "filename": "python/sglang/srt/mem_cache/prefill_budget.py",
      "patch": "@@ -139,9 +139,13 @@ def can_allocate_prefill(\n         return paged_input <= min(self.remaining_current, self.remaining_total)\n \n     def available_chunk_tokens(self, chunk_limit: int) -> int | None:\n-        available = min(chunk_limit, int(self.remaining_total))\n-        # Single-pool continuation must make progress to release its KV.\n-        return available if available > 0 else chunk_limit\n+        available = min(\n+            chunk_limit,\n+            int(self.remaining_total),\n+            int(self.remaining_current) - self.page_size,\n+        )\n+        available = available // self.page_size * self.page_size\n+        return available if available > 0 else None\n \n     def fit_chunk(\n         self,\n@@ -166,6 +170,10 @@ def reserve(\n         self.total_offset += immediate + max_new_tokens\n         self.current_offset += immediate\n \n+    def reserve_unfinished_chunk(self, remaining_tokens: int) -> None:\n+        \"\"\"Keep later admissions away from a single-pool continuation's rest.\"\"\"\n+        self.reserve(remaining_tokens, 0, is_chunked_continuation=True)\n+\n \n class SWAPrefillBudget(PrefillBudget):\n     \"\"\"Separate FULL/SWA partitions, including per-request SWA rings.\"\"\"\n@@ -314,6 +322,9 @@ def reserve(\n                 chunk_limit=chunk_limit,\n             )\n \n+    def reserve_unfinished_chunk(self, remaining_tokens: int) -> None:\n+        \"\"\"SWA keeps only a window between chunks, so the rest needs no slot.\"\"\"\n+\n \n class SharedSWAPrefillBudget(SWAPrefillBudget):\n     \"\"\"FULL and SWA reservations compete for the same physical byte budget.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a73e95463c4000017e90c5ac5611af32e6fafe0d/python%2Fsglang%2Fsrt%2Fmem_cache%2Fprefill_budget.py",
      "sha": "44c3b43dfc68386a2e850a3d9e0bc3bcc2531807",
      "status": "modified"
    },
