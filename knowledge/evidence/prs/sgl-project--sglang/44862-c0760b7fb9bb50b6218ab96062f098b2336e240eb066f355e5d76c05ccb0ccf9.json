      "filename": "python/sglang/srt/lora/utils.py",
      "patch": "@@ -405,6 +405,8 @@ def get_target_module_name(full_module_name: str, target_modules: Set[str]) -> s\n     \"fused_qkv_a_proj_with_mqa\",\n     \"fc1_latent_proj\",\n     \"fc2_latent_proj\",\n+    \"f_a_proj\",\n+    \"g_a_proj\",\n     *DSA_INDEXER_LORA_NAMES,\n ]\n # Attention-projection LoRA modules shard on the attention-TP group, which\n@@ -423,6 +425,9 @@ def get_target_module_name(full_module_name: str, target_modules: Set[str]) -> s\n         \"wo_ud\",\n         \"in_proj\",\n         \"in_proj_qkvz\",\n+        \"b_proj\",\n+        \"f_b_proj\",\n+        \"g_b_proj\",\n     }\n )\n \n@@ -438,6 +443,11 @@ def get_target_module_name(full_module_name: str, target_modules: Set[str]) -> s\n         \"in_proj\",\n         \"in_proj_qkvz\",\n         \"in_proj_ba\",\n+        \"b_proj\",\n+        \"f_a_proj\",\n+        \"f_b_proj\",\n+        \"g_a_proj\",\n+        \"g_b_proj\",\n         \"up_proj\",\n         \"gate_up_proj\",\n         \"down_proj\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/463a595a1f1f7c19ae6d25e0a575d51ef2062982/python%2Fsglang%2Fsrt%2Flora%2Futils.py",
