      "deletions": 0,
      "filename": "python/sglang/srt/dllm/mixin/req.py",
      "patch": "@@ -33,6 +33,19 @@ def init_diffusion_llm(self: Req, dllm_config: DllmConfig):\n             else:\n                 self.dllm_phase = DllmReqPhase.INCOMING_PREFILL\n \n+    def reset_dllm_for_retract(self: Req):\n+        # Retraction frees the KV, so the request rejoins as an incoming\n+        # request and drops any unresolved FDFO block.\n+        self.dllm_incomplete_ids = array(\"q\")\n+        self.dllm_algo_state = None\n+        committed_len = len(self.origin_input_ids) + len(self.output_ids)\n+        self.dllm_phase = (\n+            DllmReqPhase.INCOMING_PREFILL\n+            if self.dllm_config.requires_separate_context_encoding\n+            or committed_len >= self.dllm_config.block_size\n+            else DllmReqPhase.INCOMING_DECODE\n+        )\n+\n     def is_dllm(self: Req) -> bool:\n         return self.dllm_config is not None\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0489f4c157403baf8d2542bd2909f528a27c9a9c/python%2Fsglang%2Fsrt%2Fdllm%2Fmixin%2Freq.py",
      "sha": "108dd7ccfc687b3aa73d4108a6029226fd07246f",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0489f4c157403baf8d2542bd2909f528a27c9a9c/python%2Fsglang%2Fsrt%2Fdllm%2Fmixin%2Fscheduler.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdllm%2Fmixin%2Fscheduler.py?ref=0489f4c157403baf8d2542bd2909f528a27c9a9c",
      "deletions": 0,
      "filename": "python/sglang/srt/dllm/mixin/scheduler.py",
      "patch": "@@ -502,6 +502,10 @@ def pop_aborted_reqs(self, abort_all: bool, rid: str) -> List[Req]:\n \n         return aborted_reqs\n \n+    def pop_all_reqs(self) -> List[Req]:\n+        \"\"\"Remove and return every request in both queues once.\"\"\"\n+        return self.pop_aborted_reqs(abort_all=True, rid=\"\")\n+\n     def init_next_round(self) -> None:\n         \"\"\"Initialize staging requests for next round and clear staging queue.\"\"\"\n         for req in self.staging_queue:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0489f4c157403baf8d2542bd2909f528a27c9a9c/python%2Fsglang%2Fsrt%2Fdllm%2Fmixin%2Fscheduler.py",
      "sha": "a45c7126dfc30fed24aa58c2a8fe90f157d16649",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0489f4c157403baf8d2542bd2909f528a27c9a9c/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py?ref=0489f4c157403baf8d2542bd2909f528a27c9a9c",
      "deletions": 0,
      "filename": "python/sglang/srt/managers/schedule_batch.py",
      "patch": "@@ -2052,6 +2052,8 @@ def reset_for_retract(self):\n         self.swa_branching_seqlen = None\n         self.extend_end = None\n         self.dllm_initialized = False\n+        if self.is_dllm():\n+            self.reset_dllm_for_retract()\n         self.is_retracted = True\n         self.retracted_stain = True\n         self.input_token_logprobs = None",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0489f4c157403baf8d2542bd2909f528a27c9a9c/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "sha": "565743252faea8a604b8f5706301312ed739c27c",
      "status": "modified"
    },
    {
      "additions": 14,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0489f4c157403baf8d2542bd2909f528a27c9a9c/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=0489f4c157403baf8d2542bd2909f528a27c9a9c",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -5740,6 +5740,19 @@ def pause_generation(self, recv_req: PauseGenerationReqInput):\n         ):\n             retract_reqs.append(self.chunked_req)\n \n+        # dLLM requests wait in the dLLM manager between blocks, many still\n+        # holding KV. Take them all out so each one returns exactly once.\n+        idle_dllm_reqs = []\n+        if self.dllm_config is not None:\n+            for req in self.dllm_manager.pop_all_reqs():\n+                if req.finished() or any(req is r for r in retract_reqs):\n+                    continue\n+                if req.kv.holds_kv:\n+                    retract_reqs.append(req)\n+                else:\n+                    req.reset_for_retract()\n+                    idle_dllm_reqs.append(req)\n+\n         if self.disaggregation_mode == DisaggregationMode.DECODE:\n             # Transferred requests wait for a slot holding their row and KV;\n             # retract them too, so their KV is rebuilt under the new weights.\n@@ -5771,7 +5784,7 @@ def pause_generation(self, recv_req: PauseGenerationReqInput):\n                 offload_kv=False,\n             )\n         self.running_batch.reqs = []\n-        for req in retract_reqs:\n+        for req in retract_reqs + idle_dllm_reqs:\n             if self.disaggregation_mode == DisaggregationMode.DECODE:\n                 if req.output_ids:\n                     req.pd_rebootstrap_forced_output_id = req.output_ids.pop()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0489f4c157403baf8d2542bd2909f528a27c9a9c/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "dd74b202fa22003c80659f72c07f48dab60df6ad",
      "status": "modified"
    },
    {
      "additions": 52,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0489f4c157403baf8d2542bd2909f528a27c9a9c/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_pause_generation.py",
      "changes": 52,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_pause_generation.py?ref=0489f4c157403baf8d2542bd2909f528a27c9a9c",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_scheduler_pause_generation.py",
      "patch": "@@ -101,6 +101,7 @@ def _new_scheduler(self) -> Scheduler:\n         scheduler.disaggregation_mode = DisaggregationMode.NULL\n         scheduler.hisparse_coordinator = None\n         scheduler.decode_offload_manager = None\n+        scheduler.dllm_config = None\n         scheduler.server_args = MagicMock()\n         scheduler.waiting_queue = []\n         # pause_generation zeros gen_throughput and flushes KV events.\n@@ -365,6 +366,57 @@ def test_retract_requeues_running_then_last_fold_in(self):\n         self.assertIsNone(scheduler.chunked_req)\n         self.assertIsNone(scheduler.last_batch)\n \n+    def test_retract_takes_dllm_requests_out_of_the_dllm_manager(self):\n+        \"\"\"dLLM requests wait in the dLLM manager between blocks. Retract must\n+        take each out once, releasing the KV holders and resetting the rest.\"\"\"\n+        from sglang.srt.dllm.config import DllmConfig\n+        from sglang.srt.dllm.mixin.req import DllmReqPhase\n+        from sglang.srt.dllm.mixin.scheduler import DllmManager\n+\n+        scheduler = self._new_scheduler()\n+        config = DllmConfig(\"LowConfidence\", {}, 4, 99, 4)\n+        scheduler.dllm_config = config\n+        scheduler.dllm_manager = DllmManager(config)\n+\n+        def _req(rid, holds_kv):\n+            return SimpleNamespace(\n+                rid=rid,\n+                finished=lambda: False,\n+                is_retracted=True,\n+                kv=SimpleNamespace(holds_kv=holds_kv),\n+            )\n+\n+        last, between_blocks = _req(\"last\", True), _req(\"between\", True)\n+        idle = Req(\n+            rid=\"idle\",\n+            origin_input_text=\"\",\n+            origin_input_ids=array(\"q\", range(8)),\n+            sampling_params=SamplingParams(),\n+            dllm_config=config,\n+        )\n+        idle.dllm_phase = DllmReqPhase.STAGING_DECODE\n+        idle.dllm_incomplete_ids = array(\"q\", range(4))\n+        scheduler.last_batch = SimpleNamespace(\n+            reqs=[last], forward_mode=ForwardMode.DLLM_EXTEND\n+        )\n+        scheduler.dllm_manager.waiting_queue = [last, between_blocks, idle]\n+        scheduler.dllm_manager.staging_queue = [last]\n+        requeue_log = self._spy_requeue(scheduler)\n+\n+        with patch(\"sglang.srt.managers.scheduler.retract_all\") as mock_retract_all:\n+            scheduler.pause_generation(PauseGenerationReqInput(mode=\"retract\"))\n+\n+        self.assertEqual(\n+            mock_retract_all.call_args.kwargs[\"reqs\"], [last, between_blocks]\n+        )\n+        self.assertEqual(\n+            [entry[\"req\"] for entry in requeue_log], [last, between_blocks, idle]\n+        )\n+        self.assertEqual(scheduler.dllm_manager.waiting_queue, [])\n+        self.assertEqual(scheduler.dllm_manager.staging_queue, [])\n+        self.assertEqual(idle.dllm_phase, DllmReqPhase.INCOMING_PREFILL)\n+        self.assertEqual(len(idle.dllm_incomplete_ids), 0)\n+\n     def test_retract_after_dp_conversion_releases_each_req_once(self):\n         \"\"\"retract after DP attention converted the running batch to extend\n         (running_batch is last_batch) releases each request once.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0489f4c157403baf8d2542bd2909f528a27c9a9c/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_pause_generation.py",
      "sha": "e1619827372a61201f45d8d606829d5a246b4b21",
      "status": "modified"
