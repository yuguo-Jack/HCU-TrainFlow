      "deletions": 0,
      "filename": "python/sglang/srt/model_loader/weight_utils.py",
      "patch": "@@ -1351,6 +1351,9 @@ def _load_file(st_file: str):\n             with open(st_file, \"rb\") as f:\n                 result = safetensors.torch.load(f.read())\n         else:\n+            # Read the shard sequentially first; creating every view before any copy\n+            # otherwise faults the mapping in one 4 KiB page at a time.\n+            _prefetch_checkpoint_file(st_file)\n             with safetensors.safe_open(st_file, framework=\"pt\", device=\"cpu\") as f:\n                 result = {k: f.get_tensor(k) for k in f.keys()}\n         return result",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4e07fb645877a68fbbf425af67c4ab473114ec2e/python%2Fsglang%2Fsrt%2Fmodel_loader%2Fweight_utils.py",
