      "status": "modified"
    },
    {
      "additions": 31,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4e07fb645877a68fbbf425af67c4ab473114ec2e/test%2Fregistered%2Funit%2Fmodel_loader%2Ftest_prefetch_checkpoints.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodel_loader%2Ftest_prefetch_checkpoints.py?ref=4e07fb645877a68fbbf425af67c4ab473114ec2e",
      "deletions": 0,
      "filename": "test/registered/unit/model_loader/test_prefetch_checkpoints.py",
      "patch": "@@ -254,6 +254,37 @@ def block_first_prefetch(path, cancel_event):\n         self.assertTrue(handle.cancelled)\n         self.assertEqual(loaded_paths, paths[:1])\n \n+    @patch(\"torch.distributed.is_initialized\", return_value=False)\n+    def test_buffered_loader_reads_each_shard_before_mapping_it(self, _):\n+        \"\"\"A shard's views are created only after its file was read sequentially.\"\"\"\n+        events = []\n+        real_safe_open = safetensors.safe_open\n+\n+        def record_open(path, *args, **kwargs):\n+            events.append((\"open\", path))\n+            return real_safe_open(path, *args, **kwargs)\n+\n+        with tempfile.TemporaryDirectory() as tmpdir:\n+            paths = self._create_safetensors_files(tmpdir, num_shards=3)\n+\n+            with (\n+                patch(\n+                    \"sglang.srt.model_loader.weight_utils._prefetch_checkpoint_file\",\n+                    side_effect=lambda path: events.append((\"read\", path)),\n+                ),\n+                patch(\"safetensors.safe_open\", side_effect=record_open),\n+            ):\n+                list(\n+                    buffered_multi_thread_safetensors_weights_iterator(\n+                        paths, max_workers=1\n+                    )\n+                )\n+\n+            for path in paths:\n+                self.assertLess(\n+                    events.index((\"read\", path)), events.index((\"open\", path))\n+                )\n+\n     @patch(\"torch.distributed.is_initialized\", return_value=False)\n     def test_buffered_loader_drops_cache_after_each_loaded_shard(self, _):\n         with tempfile.TemporaryDirectory() as tmpdir:",
