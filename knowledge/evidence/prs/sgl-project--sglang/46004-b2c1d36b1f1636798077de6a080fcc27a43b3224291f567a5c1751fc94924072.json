      "deletions": 2,
      "filename": "python/sglang/srt/utils/server_args_config_parser.py",
      "patch": "@@ -194,5 +194,9 @@ def _add_list_arg(self, args: List[str], key: str, value: List[Any]) -> None:\n             args.extend(str(item) for item in value)\n \n     def _add_scalar_arg(self, args: List[str], key: str, value: Any) -> None:\n-        \"\"\"Add scalar argument to the list.\"\"\"\n-        args.extend([f\"--{key}\", str(value)])\n+        \"\"\"Add a scalar value without interpreting leading dashes as options.\"\"\"\n+        value_str = str(value)\n+        if value_str.startswith(\"-\"):\n+            args.append(f\"--{key}={value_str}\")\n+        else:\n+            args.extend([f\"--{key}\", value_str])",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c557d71df3871c510cce4aa82eb1722985d72131/python%2Fsglang%2Fsrt%2Futils%2Fserver_args_config_parser.py",
