    },
    {
      "additions": 25,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c557d71df3871c510cce4aa82eb1722985d72131/test%2Fregistered%2Funit%2Fserver_args%2Ftest_server_args.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fserver_args%2Ftest_server_args.py?ref=c557d71df3871c510cce4aa82eb1722985d72131",
      "deletions": 0,
      "filename": "test/registered/unit/server_args/test_server_args.py",
      "patch": "@@ -631,6 +631,31 @@ def test_draft_quantization_explicitness_survives_asdict_round_trip(self):\n             )\n         )\n \n+    def test_config_scalar_values_starting_with_dash(self):\n+        with tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".yaml\", delete=False) as f:\n+            f.write('api-key: \"--host\"\\nserved-model-name: \"-example=model\"\\n')\n+            config_file = f.name\n+\n+        try:\n+            parser = server_args_module.argparse.ArgumentParser()\n+            ServerArgs.add_cli_args(parser)\n+            config_args = [\"--config\", config_file, \"--model-path\", \"dummy\"]\n+            merger = ConfigArgumentMerger(parser)\n+            parsed = parser.parse_args(merger.merge_config_with_args(config_args))\n+            self.assertEqual(parsed.api_key, \"--host\")\n+            self.assertEqual(parsed.served_model_name, \"-example=model\")\n+\n+            for cli_args in (\n+                [\"--api-key\", \"override\"] + config_args,\n+                config_args + [\"--api-key\", \"override\"],\n+            ):\n+                with self.subTest(cli_args=cli_args):\n+                    parsed = parser.parse_args(merger.merge_config_with_args(cli_args))\n+                    self.assertEqual(parsed.api_key, \"override\")\n+                    self.assertEqual(parsed.served_model_name, \"-example=model\")\n+        finally:\n+            os.unlink(config_file)\n+\n     def test_config_nested_dict_args_are_json(self):\n         with tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".yaml\", delete=False) as f:\n             f.write(\"mm-process-config:\\n  image:\\n    resize: 128\\n\")",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c557d71df3871c510cce4aa82eb1722985d72131/test%2Fregistered%2Funit%2Fserver_args%2Ftest_server_args.py",
