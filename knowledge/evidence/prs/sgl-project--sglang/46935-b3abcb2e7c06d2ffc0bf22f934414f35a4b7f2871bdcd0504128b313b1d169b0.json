  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0f2b43332c915516f613b20f8aa7f6ca56753bfe/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=0f2b43332c915516f613b20f8aa7f6ca56753bfe",
      "deletions": 4,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -3508,9 +3508,7 @@ def _prefetch_kvcache(self, req: Req, storage_hit_end: Optional[int] = None):\n             # Buffer mode host-backups nothing, so match_prefix anchors at\n             # root; re-anchor on the deepest device node. The anchor is only\n             # read for hash/extra-key context here (never locked), so a device\n-            # node serves. Cache mode keeps the is_backuped gate below: its\n-            # write-through prefix is contiguous from root, so an unbacked\n-            # anchor means a guaranteed storage miss.\n+            # node serves.\n             if (\n                 buffer_mode\n                 and tree_cache.is_root(last_host_node)\n@@ -3521,11 +3519,13 @@ def _prefetch_kvcache(self, req: Req, storage_hit_end: Optional[int] = None):\n             matched_len = req.prefix_len + req.host_hit_length\n             req.storage_prefetch_last_match_len = matched_len\n \n+            # Write-back keeps a host-only suffix below a device-only anchor, and\n+            # another writer (e.g. a P/D decode) may have stored that suffix.\n             if (\n                 tree_cache.is_backuped(last_host_node)\n                 or tree_cache.is_root(last_host_node)\n                 or (\n-                    buffer_mode\n+                    (buffer_mode or tree_cache.is_write_back)\n                     and tree_cache.get_last_hash_value(last_host_node) is not None\n                 )\n             ):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0f2b43332c915516f613b20f8aa7f6ca56753bfe/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "0fbb8e82a23cd427c19a6756910e74cdfde6feff",
      "status": "modified"
    },
    {
      "additions": 36,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0f2b43332c915516f613b20f8aa7f6ca56753bfe/test%2Fregistered%2Funit%2Fmem_cache%2Funified_radix_cache%2Ftest_unified_radix_cache_storage.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Funified_radix_cache%2Ftest_unified_radix_cache_storage.py?ref=0f2b43332c915516f613b20f8aa7f6ca56753bfe",
      "deletions": 0,
      "filename": "test/registered/unit/mem_cache/unified_radix_cache/test_unified_radix_cache_storage.py",
      "patch": "@@ -18,6 +18,7 @@\n )\n from sglang.srt.environ import envs\n from sglang.srt.managers.schedule_batch import Req, ReqKvInfo\n+from sglang.srt.managers.scheduler import Scheduler\n from sglang.srt.mem_cache.base_prefix_cache import (\n     CacheRequestHandle,\n     CacheRequestOutcome,\n@@ -2487,6 +2488,41 @@ def test_swa_backup_reaches_device_ancestor_in_cache_mode_only(self):\n         self._drain_buffer_writes(cache)\n         cache.sanity_check()\n \n+    @requires_hicache\n+    def test_write_back_prefetch_looks_up_storage_below_a_device_anchor(self):\n+        \"\"\"A write-back tree holds a prefix on device only, with no host copy;\n+        the scheduler still looks up L3 for the rest of the prompt, which another\n+        writer may have stored.\"\"\"\n+        storage_dir = self._make_storage_dir()\n+        base = self._make_seq(1, 2)\n+        cache, allocator, req_to_token_pool = build_fixture(self.cfg)\n+        self._init_hicache(\n+            cache,\n+            write_policy=\"write_back\",\n+            storage_backend=\"file\",\n+            storage_dir=storage_dir,\n+            prefetch_threshold=1,\n+        )\n+        self._insert(cache, allocator, req_to_token_pool, base)\n+        self.assertFalse(cache.is_backuped(match_prefix(cache, base).last_device_node))\n+\n+        req = Req(\n+            rid=\"device-anchor-req\",\n+            origin_input_text=\"\",\n+            origin_input_ids=array(\"q\", base + self._make_seq(500, 2)),\n+            sampling_params=SamplingParams(temperature=0, max_new_tokens=1),\n+        )\n+        Scheduler._prefetch_kvcache(\n+            SimpleNamespace(\n+                tree_cache=cache, enable_hicache_storage=True, enable_lmcache=False\n+            ),\n+            req,\n+        )\n+\n+        self.assertEqual(req.storage_prefetch_last_match_len, len(base))\n+        self.assertIn(req.cache_request_handle, cache.ongoing_prefetch)\n+        cache.release_aborted_request(req.cache_request_handle)\n+\n \n define_config_test_classes(UnifiedRadixCacheStorageSuite, globals())\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0f2b43332c915516f613b20f8aa7f6ca56753bfe/test%2Fregistered%2Funit%2Fmem_cache%2Funified_radix_cache%2Ftest_unified_radix_cache_storage.py",
      "sha": "74146315843868adcdf71899d34897dfec8cee4f",
      "status": "modified"
    }
  ],
