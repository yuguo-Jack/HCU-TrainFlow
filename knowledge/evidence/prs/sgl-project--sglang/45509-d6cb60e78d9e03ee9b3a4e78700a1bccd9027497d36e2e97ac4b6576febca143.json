    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5151d27eb4850f3bc50b33af90e1566a99a5f6be/python%2Fsglang%2Fsrt%2Fconfigs%2Fmamba_utils.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fconfigs%2Fmamba_utils.py?ref=5151d27eb4850f3bc50b33af90e1566a99a5f6be",
      "deletions": 3,
      "filename": "python/sglang/srt/configs/mamba_utils.py",
      "patch": "@@ -128,7 +128,7 @@ def replayssm_ring_bytes_per_req(self, record_len: int) -> int:\n         \"\"\"ReplaySSM spec-verify scratch bytes across all layers.\n \n         GDN keeps compact d/k/g plus low parts for the activation-dtype d/k\n-        rings. KDA keeps its raw-input fold window and d/k rings.\n+        rings. KDA keeps its raw-input fold window.\n         \"\"\"\n         hv, v_dim, k_dim = self.shape.temporal\n         h_k = self.shape.num_k_heads_per_tp\n@@ -140,8 +140,6 @@ def replayssm_ring_bytes_per_req(self, record_len: int) -> int:\n                 + h_k * record_len * k_dim * conv_b  # rawk\n                 + hv * record_len * fp32_b  # beta\n                 + hv * record_len * k_dim * fp32_b  # vector g\n-                + hv * record_len * v_dim * conv_b  # d\n-                + h_k * record_len * k_dim * conv_b  # k\n             )\n         else:\n             per_layer = (",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5151d27eb4850f3bc50b33af90e1566a99a5f6be/python%2Fsglang%2Fsrt%2Fconfigs%2Fmamba_utils.py",
      "sha": "706df8dd9d8192befb69d08aa86e0e09236ad2ba",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5151d27eb4850f3bc50b33af90e1566a99a5f6be/python%2Fsglang%2Fsrt%2Fmem_cache%2Fmemory_pool.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Fmemory_pool.py?ref=5151d27eb4850f3bc50b33af90e1566a99a5f6be",
      "deletions": 8,
      "filename": "python/sglang/srt/mem_cache/memory_pool.py",
      "patch": "@@ -772,13 +772,8 @@ def __init__(\n                 # records follow the activation dtype; g stays fp32.\n                 ring_dtype = conv_dtype if enable_linear_replayssm_spec else ssm_dtype\n                 # Fold-every-commit: one verify window, no chunked (d, k)\n-                # records. KDA is the exception on both counts: its window\n-                # stays L-sized (the fused verify ring-write drops\n-                # absorb-inflated rows past L), and d/k stay allocated --\n-                # forward_decode routes on `replayssm_d is None` (fused vs\n-                # decode-ring), so skipping them would flip KDA decode to the\n-                # fused path, a behavior change needing its own validation\n-                # (memory follow-up).\n+                # records. KDA's window stays L-sized since the fused verify\n+                # ring-write drops absorb-inflated rows past L.\n                 if self.replayssm_spec_fold and not cache_params.is_kda:\n                     record_len = (\n                         speculative_num_draft_tokens\n@@ -787,7 +782,7 @@ def __init__(\n                     )\n                 else:\n                     record_len = L\n-                if not self.replayssm_spec_fold or cache_params.is_kda:\n+                if not self.replayssm_spec_fold:\n                     replayssm_d = torch.zeros(\n                         size=(num_mamba_layers, num_slots, hv, L, v_dim),\n                         dtype=ring_dtype,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5151d27eb4850f3bc50b33af90e1566a99a5f6be/python%2Fsglang%2Fsrt%2Fmem_cache%2Fmemory_pool.py",
