    {
      "additions": 29,
      "blob_url": "https://github.com/sgl-project/sglang/blob/885d535edf2b3062afdf3f5ee454a2936abf43f0/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsa%2Fmqa_logits_backend.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsa%2Fmqa_logits_backend.py?ref=885d535edf2b3062afdf3f5ee454a2936abf43f0",
      "deletions": 0,
      "filename": "python/sglang/srt/layers/attention/dsa/mqa_logits_backend.py",
      "patch": "@@ -0,0 +1,29 @@\n+from enum import Enum\n+from typing import Callable\n+\n+from sglang.srt.utils import is_gfx95_supported, is_hip\n+\n+\n+class DSAMQALogitsBackend(Enum):\n+    TRITON = \"triton\"\n+    FLYDSL = \"flydsl\"\n+\n+    @classmethod\n+    def resolve(cls, value: str) -> \"DSAMQALogitsBackend\":\n+        if value in (\"auto\", \"triton\"):\n+            return cls.TRITON\n+        if value != \"flydsl\":\n+            raise ValueError(f\"Unknown dsa_mqa_logits_backend: {value!r}\")\n+        if not is_hip() or not is_gfx95_supported():\n+            raise ValueError(\"dsa_mqa_logits_backend='flydsl' requires ROCm gfx950.\")\n+        return cls.FLYDSL\n+\n+    def get_hip_kernel(self) -> Callable:\n+        if self == DSAMQALogitsBackend.FLYDSL:\n+            from aiter.ops.flydsl import flydsl_fp8_mqa_logits\n+\n+            return flydsl_fp8_mqa_logits\n+\n+        from aiter.ops.triton.fp8_mqa_logits import fp8_mqa_logits\n+\n+        return fp8_mqa_logits",
      "raw_url": "https://github.com/sgl-project/sglang/raw/885d535edf2b3062afdf3f5ee454a2936abf43f0/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsa%2Fmqa_logits_backend.py",
