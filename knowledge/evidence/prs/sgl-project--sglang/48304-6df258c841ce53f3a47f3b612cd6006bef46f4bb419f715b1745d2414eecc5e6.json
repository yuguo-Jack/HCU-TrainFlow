      "deletions": 10,
      "filename": "python/sglang/srt/multimodal/token_space_mm_process/processor.py",
      "patch": "@@ -30,6 +30,11 @@ def _device_type(device):\n     return None if device is None else torch.device(device).type\n \n \n+def _log_failed_write(future):\n+    if future.exception() is not None:\n+        logger.warning(\"Item feature cache write failed\", exc_info=future.exception())\n+\n+\n def _check_cached_features(media_item, cached, computed):\n     modality = media_item[0]\n     if cached.keys() != computed.keys():\n@@ -242,8 +247,8 @@ async def _get_item_features(self, media_items, request_options):\n                 )\n                 for modality, source, _, item_kwargs in media_items\n             ]\n-            # A backend may block on IO, e.g. a disk cache reads whole files, so get and\n-            # set run in the default thread pool, off the event loop and the media IO pool.\n+            # A backend may block on IO, e.g. a disk cache reads whole files, so get runs\n+            # in the default thread pool, off the event loop and the media IO pool.\n             item_features = list(\n                 await asyncio.gather(\n                     *(\n@@ -300,17 +305,16 @@ async def _get_item_features(self, media_items, request_options):\n         for index, cached in checked.items():\n             _check_cached_features(media_items[index], cached, item_features[index])\n         if self._item_feature_cache is not None:\n-            await asyncio.gather(\n-                *(\n-                    asyncio.to_thread(\n+            # Written behind the request: a reader that comes first misses and computes.\n+            loop = asyncio.get_running_loop()\n+            for index in missed:\n+                if index not in checked:\n+                    loop.run_in_executor(\n+                        None,\n                         self._item_feature_cache.__setitem__,\n                         item_keys[index],\n                         item_features[index],\n-                    )\n-                    for index in missed\n-                    if index not in checked\n-                )\n-            )\n+                    ).add_done_callback(_log_failed_write)\n         return item_features\n \n     async def _process_items(self, media_items, request_options):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/46bd86b9d7b538e0b2f6f6505b2bbdb0deb55634/python%2Fsglang%2Fsrt%2Fmultimodal%2Ftoken_space_mm_process%2Fprocessor.py",
      "sha": "31d61a05fbfa83782d86e8bd54cd843c91195905",
      "status": "modified"
    },
    {
      "additions": 40,
      "blob_url": "https://github.com/sgl-project/sglang/blob/46bd86b9d7b538e0b2f6f6505b2bbdb0deb55634/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_mm_token_expansion.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_mm_token_expansion.py?ref=46bd86b9d7b538e0b2f6f6505b2bbdb0deb55634",
      "deletions": 0,
      "filename": "test/registered/unit/multimodal/test_mm_token_expansion.py",
      "patch": "@@ -26,6 +26,7 @@\n   one map, processors of another checkpoint, mm_process_config or library version -> loaded again\n   item feature cache, a sampled hit -> computed again, equal to the cache, not rewritten\n   item feature cache, a sampled hit computes to other features -> RuntimeError\n+  item feature cache, a slow or failing write -> the request returns first; a failure is logged\n \n get_mm_processor -> TokenSpaceSGLangProcessor\n   each strategy and serving spec keep the legacy processor's loader and worker defaults\n@@ -45,6 +46,7 @@\n import contextlib\n import io\n import tempfile\n+import threading\n import unittest\n from types import SimpleNamespace\n from unittest.mock import AsyncMock, patch\n@@ -72,6 +74,7 @@\n from sglang.srt.multimodal.token_space_mm_process.process_strategy import (\n     TokenSpaceProcessStrategy,\n )\n+from sglang.srt.multimodal.token_space_mm_process import processor as processor_module\n from sglang.srt.multimodal.token_space_mm_process.processor import (\n     TokenSpaceProcessor,\n )\n@@ -456,6 +459,43 @@ def test_item_feature_cache_sampled_hit_is_computed_again_and_checked(self):\n         with self.assertRaisesRegex(RuntimeError, \"other pixel_values\"):\n             asyncio.run(processor.process([image], input_ids=[1, IMAGE]))\n \n+    def test_item_feature_cache_writes_behind_the_request(self):\n+        \"\"\"A request returns with its features while the cache write is still running.\"\"\"\n+        image = Image.new(\"RGB\", (2, 1))\n+        written = {}\n+        release = threading.Event()\n+\n+        class _SlowCache(dict):\n+            def __setitem__(self, key, value):\n+                release.wait(timeout=10)\n+                written[key] = value\n+\n+        processor = self._processor(\n+            hf_config=_CHECKPOINT, item_feature_cache=_SlowCache()\n+        )\n+\n+        async def run():\n+            output = await processor.process([image], input_ids=[1, IMAGE])\n+            self.assertEqual(written, {})\n+            release.set()\n+            return output\n+\n+        output = asyncio.run(run())\n+        self.assertEqual(len(written), 1)\n+        (cached,) = written.values()\n+        self.assertTrue(torch.equal(cached[\"pixel_values\"], output[\"pixel_values\"]))\n+\n+        class _FailingCache(dict):\n+            def __setitem__(self, key, value):\n+                raise OSError(\"disk full\")\n+\n+        processor = self._processor(\n+            hf_config=_CHECKPOINT, item_feature_cache=_FailingCache()\n+        )\n+        with self.assertLogs(processor_module.logger, level=\"WARNING\") as logs:\n+            asyncio.run(processor.process([image], input_ids=[1, IMAGE]))\n+        self.assertIn(\"disk full\", \"\\n\".join(logs.output))\n+\n     def test_item_feature_cache_is_shared_only_by_matching_processors(self):\n         \"\"\"A trainer and serving may share one map; another checkpoint, config or upgrade must miss.\"\"\"\n         image = Image.new(\"RGB\", (2, 1))",
