      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fprofile_utils.py?ref=4ea2f081bd6d8971c3047f0d16f03e308de75376",
      "deletions": 1,
      "filename": "python/sglang/srt/utils/profile_utils.py",
      "patch": "@@ -179,7 +179,10 @@ def _get_stage_from_forward_mode(forward_mode: ForwardMode):\n         return \"prefill\"\n     elif forward_mode.is_decode():\n         return \"decode\"\n-    elif forward_mode.is_idle():\n+    elif forward_mode.is_idle() or forward_mode.is_prebuilt():\n+        # PREBUILT is the disaggregated-decode placeholder for requests whose\n+        # KV just arrived; it never enters a model forward, so it is not a\n+        # profile stage (mirrors SchedulerProfilerManager._profile_batch_predicate).\n         return None\n     else:\n         raise RuntimeError(f\"unsupported profile stage: {forward_mode=}\")",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4ea2f081bd6d8971c3047f0d16f03e308de75376/python%2Fsglang%2Fsrt%2Futils%2Fprofile_utils.py",
      "sha": "e42a202d95a718804a3c97e845dfad63a3c9c3da",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4ea2f081bd6d8971c3047f0d16f03e308de75376/test%2Fregistered%2Funit%2Futils%2Ftest_profile_utils.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Futils%2Ftest_profile_utils.py?ref=4ea2f081bd6d8971c3047f0d16f03e308de75376",
      "deletions": 0,
      "filename": "test/registered/unit/utils/test_profile_utils.py",
      "patch": "@@ -0,0 +1,32 @@\n+\"\"\"\n+Unit tests for profile_utils stage mapping (profile V2).\n+\n+Usage:\n+    python test_profile_utils.py\n+    python -m unittest test_profile_utils.py -v\n+\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.model_executor.forward_batch_info import ForwardMode\n+from sglang.srt.utils.profile_utils import _get_stage_from_forward_mode\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestGetStageFromForwardMode(CustomTestCase):\n+    def test_prefill_and_decode_map_to_stages(self):\n+        self.assertEqual(_get_stage_from_forward_mode(ForwardMode.EXTEND), \"prefill\")\n+        self.assertEqual(_get_stage_from_forward_mode(ForwardMode.DECODE), \"decode\")\n+\n+    def test_idle_and_prebuilt_are_not_stages(self):\n+        # IDLE has no forward, and PREBUILT is the disaggregated-decode\n+        # placeholder whose KV just arrived; it never enters a model forward.\n+        self.assertIsNone(_get_stage_from_forward_mode(ForwardMode.IDLE))\n+        self.assertIsNone(_get_stage_from_forward_mode(ForwardMode.PREBUILT))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4ea2f081bd6d8971c3047f0d16f03e308de75376/test%2Fregistered%2Funit%2Futils%2Ftest_profile_utils.py",
      "sha": "319465e6d4cbd9730a779ba17bb54a0c3ede4d2c",
      "status": "added"
    }
