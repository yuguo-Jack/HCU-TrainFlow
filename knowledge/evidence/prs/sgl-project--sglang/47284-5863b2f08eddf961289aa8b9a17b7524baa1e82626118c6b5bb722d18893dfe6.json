      "patch": "@@ -153,7 +153,7 @@ def build(*, spec: BuildSpec, build_dir: pathlib.Path, build_file: str) -> pathl\n             (build_dir / unit.filename).write_text(unit.source)\n     (build_dir / _BUILD_FILE).write_text(build_file)\n \n-    command = [\"ninja\", \"-f\", _BUILD_FILE]\n+    command = [toolchain.ninja_path(), \"-f\", _BUILD_FILE]\n     jobs = os.environ.get(\"MAX_JOBS\")\n     if jobs:\n         command += [\"-j\", jobs]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ebc158cb37f7f6e0b116a35cb3f0e38897522ca9/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Fninja.py",
      "sha": "3d1e766c10c4e1829af0e7ff67f62873872dcd35",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ebc158cb37f7f6e0b116a35cb3f0e38897522ca9/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Ftoolchain.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Ftoolchain.py?ref=ebc158cb37f7f6e0b116a35cb3f0e38897522ca9",
      "deletions": 0,
      "filename": "python/sglang/kernels/jit/utils/compile/toolchain.py",
      "patch": "@@ -112,6 +112,31 @@ def hgcc_path() -> str:\n     )\n \n \n+def ninja_path() -> str:\n+    \"\"\"The ninja that JIT builds run, from PATH or the ``ninja`` package.\n+\n+    The package's binary is not on PATH when its environment is used without\n+    being activated.\n+    \"\"\"\n+    searched = [\"ninja on PATH\"]\n+    on_path = shutil.which(\"ninja\")\n+    if on_path is not None:\n+        return on_path\n+    try:\n+        import ninja\n+    except ImportError:\n+        pass\n+    else:\n+        searched.append(ninja.BIN_DIR)\n+        in_package = shutil.which(\"ninja\", path=ninja.BIN_DIR)\n+        if in_package is not None:\n+            return in_package\n+    raise RuntimeError(\n+        \"JIT builds require ninja, which was not found. Searched: \"\n+        + \", \".join(searched)\n+    )\n+\n+\n @cache_once\n def ppu_sdk_home() -> str:\n     \"\"\"The PPU SDK root providing the hggc libraries to link against.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ebc158cb37f7f6e0b116a35cb3f0e38897522ca9/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Ftoolchain.py",
      "sha": "317d72006d635ee6cc4f73bf3c4bd5268c80665c",
      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ebc158cb37f7f6e0b116a35cb3f0e38897522ca9/test%2Fregistered%2Funit%2Fkernels%2Ftest_jit_cache.py",
      "changes": 34,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fkernels%2Ftest_jit_cache.py?ref=ebc158cb37f7f6e0b116a35cb3f0e38897522ca9",
      "deletions": 1,
      "filename": "test/registered/unit/kernels/test_jit_cache.py",
      "patch": "@@ -9,12 +9,14 @@\n \n import os\n import pathlib\n+import shutil\n import sys\n \n import msgspec\n+import ninja as ninja_package\n import pytest\n \n-from sglang.kernels.jit.utils.compile import cache, ninja\n+from sglang.kernels.jit.utils.compile import cache, ninja, toolchain\n from sglang.kernels.jit.utils.compile.paths import KERNEL_PATH\n from sglang.kernels.jit.utils.compile.spec import BuildSpec\n from sglang.test.ci.ci_register import register_cpu_ci\n@@ -559,5 +561,35 @@ def test_relative_sources_resolve_against_csrc():\n     assert resolve_sources([\"/usr/include/stdio.h\"]) == (\"/usr/include/stdio.h\",)\n \n \n+# --------------------------------------------------------------------------\n+# Finding ninja\n+# --------------------------------------------------------------------------\n+\n+\n+def test_ninja_path_falls_back_to_the_ninja_package(tmp_path, monkeypatch):\n+    monkeypatch.setenv(\"PATH\", str(tmp_path))\n+    expected = shutil.which(\"ninja\", path=ninja_package.BIN_DIR)\n+    assert expected is not None\n+    assert toolchain.ninja_path() == expected\n+\n+\n+def test_ninja_path_names_where_it_looked(tmp_path, monkeypatch):\n+    monkeypatch.setenv(\"PATH\", str(tmp_path))\n+    monkeypatch.setitem(sys.modules, \"ninja\", None)\n+    with pytest.raises(RuntimeError, match=\"ninja on PATH\"):\n+        toolchain.ninja_path()\n+\n+\n+def test_build_runs_ninja_that_is_not_on_path(tmp_path, monkeypatch):\n+    \"\"\"An environment used without activation has the package, not the PATH entry.\"\"\"\n+    monkeypatch.setenv(\"PATH\", str(tmp_path))\n+    spec = _spec()\n+    build_dir = tmp_path / \"build\"\n+    library = ninja.build(\n+        spec=spec, build_dir=build_dir, build_file=\"build all: phony\\ndefault all\\n\"\n+    )\n+    assert library == build_dir / f\"{spec.module_name}.so\"\n+\n+\n if __name__ == \"__main__\":\n     sys.exit(pytest.main([__file__, \"-v\"]))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ebc158cb37f7f6e0b116a35cb3f0e38897522ca9/test%2Fregistered%2Funit%2Fkernels%2Ftest_jit_cache.py",
      "sha": "e93a4c63a545534c2480b9e5247b0badeacfd347",
      "status": "modified"
