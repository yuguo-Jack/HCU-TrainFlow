      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a5614085e6a2505db7d2206e3ad99a637dd32243/python%2Fsglang%2Fkernels%2Fops%2Fmoe%2Finkling_moe.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fmoe%2Finkling_moe.py?ref=a5614085e6a2505db7d2206e3ad99a637dd32243",
      "deletions": 5,
      "filename": "python/sglang/kernels/ops/moe/inkling_moe.py",
      "patch": "@@ -3,7 +3,7 @@\n import triton.language as tl\n \n from sglang.kernels.jit.utils import is_arch_support_pdl\n-from sglang.srt.utils.common import is_sm121\n+from sglang.srt.utils.common import is_sm120, is_sm121\n \n DEFAULT_BLOCK_SIZE = 4096\n BLOCK_SIZE_M = 128\n@@ -969,10 +969,11 @@ def grouped_gemm_triton(\n             \"BLOCK_SIZE_K\": 128,\n             \"GROUP_SIZE_M\": 8,\n             \"num_warps\": 4,\n-            # sm_121 (GB10 / DGX Spark) caps shared memory at 99 KB per block and\n-            # num_stages=4 needs 108 KB. The BLOCK_SIZE_M=128 branch below fits at\n-            # its default 3 (96 KB) and needs no gate.\n-            \"num_stages\": 3 if is_sm121() else 4,\n+            # sm_120 (RTX 50 / RTX PRO) and sm_121 (GB10 / DGX Spark) cap shared\n+            # memory at 99 KB per block and num_stages=4 needs 108 KB. The\n+            # BLOCK_SIZE_M=128 branch below fits at its default 3 (96 KB) and needs\n+            # no gate.\n+            \"num_stages\": 3 if is_sm120() or is_sm121() else 4,\n         }\n     else:\n         assert block_size_m == BLOCK_SIZE_M, f\"{block_size_m=}\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a5614085e6a2505db7d2206e3ad99a637dd32243/python%2Fsglang%2Fkernels%2Fops%2Fmoe%2Finkling_moe.py",
      "sha": "0d7d476f5a7b7fea56990f8c7d52423baea7f69a",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a5614085e6a2505db7d2206e3ad99a637dd32243/test%2Fregistered%2Fkernels%2Fops%2Fmoe%2Ftest_moe_preprocess.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fmoe%2Ftest_moe_preprocess.py?ref=a5614085e6a2505db7d2206e3ad99a637dd32243",
      "deletions": 0,
      "filename": "test/registered/kernels/ops/moe/test_moe_preprocess.py",
      "patch": "@@ -16,6 +16,8 @@\n from sglang.test.ci.ci_register import register_cuda_ci\n \n register_cuda_ci(est_time=20, stage=\"base-b-kernel-unit\", runner_config=\"1-gpu-large\")\n+# RTX 5090 (sm_120) covers the reduced-shared-memory grouped GEMM config.\n+register_cuda_ci(est_time=20, stage=\"base-b-kernel-unit\", runner_config=\"1-gpu-small\")\n \n requires_cuda = pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA only\")\n ",
