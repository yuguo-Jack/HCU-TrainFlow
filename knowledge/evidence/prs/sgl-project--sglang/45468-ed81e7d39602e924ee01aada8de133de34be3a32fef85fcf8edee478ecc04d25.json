    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/bacb8750fdbe04e4cbb02d82de472018799d73d3/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_cache_linker.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_cache_linker.py?ref=bacb8750fdbe04e4cbb02d82de472018799d73d3",
      "deletions": 1,
      "filename": "python/sglang/srt/mem_cache/unified_cache/unified_cache_linker.py",
      "patch": "@@ -118,7 +118,8 @@ def finish(self, index: int) -> bool:\n             return True\n         # Wait before dropping the entry: the load thread still completes the\n         # layers the forward never waited on through it.\n-        landed = all(future.exception() is None for future in futures)\n+        errors = [future.exception() for future in futures]\n+        landed = all(error is None for error in errors)\n         del self.futures[index]\n         return landed\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bacb8750fdbe04e4cbb02d82de472018799d73d3/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_cache_linker.py",
      "sha": "b78dac2739738ba6b70fcc1d8b1c727107350908",
      "status": "modified"
    },
    {
      "additions": 29,
      "blob_url": "https://github.com/sgl-project/sglang/blob/bacb8750fdbe04e4cbb02d82de472018799d73d3/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_cache_linker.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_cache_linker.py?ref=bacb8750fdbe04e4cbb02d82de472018799d73d3",
      "deletions": 7,
      "filename": "test/registered/unit/mem_cache/test_unified_cache_linker.py",
      "patch": "@@ -3,6 +3,7 @@\n import unittest\n from array import array\n from collections import defaultdict\n+from concurrent.futures import ThreadPoolExecutor\n from dataclasses import replace\n from types import SimpleNamespace\n from unittest.mock import MagicMock\n@@ -1064,14 +1065,35 @@ def test_layer_counter_reports_failure_after_the_forward():\n     assert counter.finish(index) is False\n \n \n-def test_layer_counter_finish_waits_for_layers_still_loading():\n-    counter = LayerWiseLoadCounter(1)\n+@pytest.mark.parametrize(\n+    \"failed_first\", [False, True], ids=[\"success\", \"failed-first-layer\"]\n+)\n+def test_layer_counter_finish_waits_for_layers_still_loading(monkeypatch, failed_first):\n+    counter = LayerWiseLoadCounter(2)\n     index = counter.update_producer()\n-    loader = threading.Timer(0.05, counter.complete, (index, 0))\n-    loader.start()\n-\n-    assert counter.finish(index) is True  # the forward never waited on layer 0\n-    loader.join()\n+    first, pending = counter.futures[index]\n+    if failed_first:\n+        first.set_exception(RuntimeError(\"first layer failed\"))\n+    else:\n+        first.set_result(None)\n+    waiting = threading.Event()\n+    exception = pending.exception\n+\n+    def wait_for_pending(timeout=None):\n+        waiting.set()\n+        return exception(timeout)\n+\n+    monkeypatch.setattr(pending, \"exception\", wait_for_pending)\n+    with ThreadPoolExecutor(max_workers=1) as executor:\n+        finishing = executor.submit(counter.finish, index)\n+        try:\n+            assert waiting.wait(timeout=1)\n+            assert not finishing.done()\n+            assert index in counter.futures\n+        finally:\n+            pending.set_result(None)\n+        assert finishing.result(timeout=1) is (not failed_first)\n+    assert index not in counter.futures\n \n \n def test_finish_loads_adopts_a_peer_rank_failure():",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bacb8750fdbe04e4cbb02d82de472018799d73d3/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_cache_linker.py",
      "sha": "c9388773fd0cc33df19e8d21e97f4adf8d40052b",
