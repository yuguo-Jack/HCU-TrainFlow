    {
      "additions": 12,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b128df9f23f1b1c8fc4e69e23b55783d16b728b1/python%2Fsglang%2Fsrt%2Farg_groups%2Fserving_hook.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Fserving_hook.py?ref=b128df9f23f1b1c8fc4e69e23b55783d16b728b1",
      "deletions": 4,
      "filename": "python/sglang/srt/arg_groups/serving_hook.py",
      "patch": "@@ -278,20 +278,28 @@ def handle_deprecated_args(server_args: Any):\n         \"_handle_deprecated_args\",\n         enable_flashinfer_allreduce_fusion=False,\n     )\n-    # Deprecated attention-backend alias: \"compressed\" -> \"dsv4\".\n+    # Deprecated attention-backend aliases: \"compressed\" -> \"dsv4\",\n+    # \"nsa\" -> \"dsa\". Normalized once here so every downstream consumer\n+    # (e.g. CPAttentionBackendKind.from_string) only ever sees the\n+    # canonical names.\n+    deprecated_attention_backends = {\"compressed\": \"dsv4\", \"nsa\": \"dsa\"}\n     renamed = {}\n     for attr in (\n         \"attention_backend\",\n         \"decode_attention_backend\",\n         \"prefill_attention_backend\",\n         \"speculative_draft_attention_backend\",\n     ):\n-        if getattr(server_args, attr, None) == \"compressed\":\n+        alias = getattr(server_args, attr, None)\n+        canonical = deprecated_attention_backends.get(alias)\n+        if canonical is not None:\n             logger.warning(\n-                \"--%s=compressed is deprecated; use 'dsv4' instead.\",\n+                \"--%s=%s is deprecated; use '%s' instead.\",\n                 attr.replace(\"_\", \"-\"),\n+                alias,\n+                canonical,\n             )\n-            renamed[attr] = \"dsv4\"\n+            renamed[attr] = canonical\n     if renamed:\n         declare_resolution(server_args, \"_handle_deprecated_args\", **renamed)\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b128df9f23f1b1c8fc4e69e23b55783d16b728b1/python%2Fsglang%2Fsrt%2Farg_groups%2Fserving_hook.py",
      "sha": "27d6b66ce9e7d10808d395395c7a37170bca8f56",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b128df9f23f1b1c8fc4e69e23b55783d16b728b1/python%2Fsglang%2Fsrt%2Flayers%2Fcp%2Fbase.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fcp%2Fbase.py?ref=b128df9f23f1b1c8fc4e69e23b55783d16b728b1",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/cp/base.py",
      "patch": "@@ -72,7 +72,7 @@ class CPAttentionBackendKind(IntEnum):\n     def from_string(cls, value: str) -> CPAttentionBackendKind:\n         if value in (\"fa3\", \"fa4\", \"flashinfer\"):\n             return cls.FLASH_ATTENTION\n-        if value in (\"dsa\"):\n+        if value == \"dsa\":\n             return cls.DSA\n         if value == \"trtllm_mha\":\n             return cls.TRTLLM_MHA",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b128df9f23f1b1c8fc4e69e23b55783d16b728b1/python%2Fsglang%2Fsrt%2Flayers%2Fcp%2Fbase.py",
