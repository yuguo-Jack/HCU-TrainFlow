ed_mhc_post_pre(\n@@ -389,6 +403,8 @@ def try_mhc_fused_post_pre_boundary(\n         hc_eps,\n         hc_post_mult,\n         sinkhorn_iters,\n+        norm_weight,\n+        norm_eps,\n         is_gfx95_supported_flag,\n     )\n ",
