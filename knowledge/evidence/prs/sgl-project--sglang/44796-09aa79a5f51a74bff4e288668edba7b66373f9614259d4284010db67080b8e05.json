  "files": [
    {
      "additions": 11,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e6122f5c9f1b6da0510eaa6727956dff88704f93/python%2Fsglang%2Fsrt%2Fobservability%2Ftrace.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fobservability%2Ftrace.py?ref=e6122f5c9f1b6da0510eaa6727956dff88704f93",
      "deletions": 9,
      "filename": "python/sglang/srt/observability/trace.py",
      "patch": "@@ -127,8 +127,8 @@ class TraceCustomIdGenerator(id_generator.IdGenerator):\n     \"\"\"Custom ID generator with support for pre-setting the next span ID.\n \n     Why custom IDs are needed:\n-      The default IdGenerator may produce duplicate trace IDs across\n-      multiple TP scheduler processes.\n+      IDs are drawn from the OS entropy pool. A PRNG may produce duplicate\n+      IDs across scheduler processes forked or seeded at the same moment.\n \n     Preset mechanism (used by async tracing):\n       When SGLANG_TRACE_ASYNC=1, span creation is deferred to an exporter\n@@ -147,22 +147,24 @@ class TraceCustomIdGenerator(id_generator.IdGenerator):\n \n     # Thread-local storage for the next span ID to use preset.\n     _preset_local = threading.local()\n-\n-    def __init__(self):\n-        super().__init__()\n-        self.local_random = random.Random()\n-        self.local_random.seed(time.time())\n+    _random = random.SystemRandom()\n \n     def generate_trace_id(self) -> int:\n-        return self.local_random.getrandbits(64)\n+        return self._nonzero_bits(128)\n \n     def generate_span_id(self) -> int:\n         # If a preset span ID was injected, consume it (one-shot).\n         preset = getattr(self._preset_local, \"span_id\", None)\n         if preset is not None:\n             self._preset_local.span_id = None\n             return preset\n-        return self.local_random.getrandbits(64)\n+        return self._nonzero_bits(64)\n+\n+    def _nonzero_bits(self, bits: int) -> int:\n+        # An all-zero ID is invalid in W3C trace context.\n+        while True:\n+            if value := self._random.getrandbits(bits):\n+                return value\n \n     @classmethod\n     def preset_next_span_id(cls, span_id: int):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e6122f5c9f1b6da0510eaa6727956dff88704f93/python%2Fsglang%2Fsrt%2Fobservability%2Ftrace.py",
      "sha": "18e2ea8e4fca838f299503abacc6e062febbdb3d",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e6122f5c9f1b6da0510eaa6727956dff88704f93/test%2Fregistered%2Funit%2Fobservability%2Ftest_trace.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fobservability%2Ftest_trace.py?ref=e6122f5c9f1b6da0510eaa6727956dff88704f93",
      "deletions": 0,
      "filename": "test/registered/unit/observability/test_trace.py",
      "patch": "@@ -13,6 +13,7 @@\n import sglang.srt.observability.trace as mod\n from sglang.srt.observability.trace import (\n     SpanAttributes,\n+    TraceCustomIdGenerator,\n     TraceEvent,\n     TraceNullContext,\n     TraceReqContext,\n@@ -92,6 +93,24 @@ def test_constants_exist(self):\n         self.assertIsInstance(SpanAttributes.GEN_AI_USAGE_COMPLETION_TOKENS, str)\n \n \n+class TestTraceCustomIdGenerator(unittest.TestCase):\n+    def test_trace_ids_use_all_128_bits(self):\n+        \"\"\"W3C trace IDs are 128-bit; the upper half must not be left zero.\"\"\"\n+        generator = TraceCustomIdGenerator()\n+        ids = [generator.generate_trace_id() for _ in range(64)]\n+        self.assertTrue(all(0 < i < 2**128 for i in ids))\n+        self.assertTrue(any(i >= 2**64 for i in ids))\n+\n+    def test_generators_created_at_the_same_instant_draw_different_ids(self):\n+        \"\"\"Processes that start together must not share an ID sequence.\"\"\"\n+        with patch(\"time.time\", return_value=1792000000.123456):\n+            first, second = TraceCustomIdGenerator(), TraceCustomIdGenerator()\n+        self.assertNotEqual(\n+            [first.generate_trace_id() for _ in range(4)],\n+            [second.generate_trace_id() for _ in range(4)],\n+        )\n+\n+\n # __get_host_id\n class TestGetHostId(unittest.TestCase):\n     def test_from_machine_id_file(self):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e6122f5c9f1b6da0510eaa6727956dff88704f93/test%2Fregistered%2Funit%2Fobservability%2Ftest_trace.py",
      "sha": "67f5a093ae52611538d28d93bb561164ded726b3",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "can we add a test for this generator? the unit fixture uses sdk default generator, so it would still pass if trace IDs reverted to 64 bits",
      "created_at": "2026-10-22T23:51:46Z",
      "diff_hunk": "@@ -147,22 +147,24 @@ class TraceCustomIdGenerator(id_generator.IdGenerator):\n \n     # Thread-local storage for the next span ID to use preset.\n     _preset_local = threading.local()\n-\n-    def __init__(self):\n-        super().__init__()\n-        self.local_random = random.Random()\n-        self.local_random.seed(time.time())\n+    _random = random.SystemRandom()\n \n     def generate_trace_id(self) -> int:\n-        return self.local_random.getrandbits(64)\n+        return self._nonzero_bits(128)",
