      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8cd7943f7619d5c0a0ff92d163b972be47ef0dd1/test%2Fregistered%2Funit%2Fsampling%2Ftest_sampling_params.py",
      "changes": 18,
