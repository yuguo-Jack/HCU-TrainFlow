      "deletions": 0,
      "filename": "test/registered/unit/sampling/test_sampling_params.py",
      "patch": "@@ -315,6 +315,24 @@ def test_logit_bias_valid_tokens(self):\n         sp = self._make(logit_bias={\"0\": 1.0, \"31999\": -0.5})\n         sp.verify(self.VOCAB_SIZE)\n \n+    # --- stop_token_ids ---\n+    def test_stop_token_ids_exceeds_vocab_raises(self):\n+        \"\"\"Test that verify() rejects stop_token_ids with token_id >= vocab_size.\"\"\"\n+        sp = self._make(stop_token_ids=[99999])\n+        with self.assertRaises(ValueError):\n+            sp.verify(self.VOCAB_SIZE)\n+\n+    def test_stop_token_ids_negative_token_raises(self):\n+        \"\"\"Test that verify() rejects stop_token_ids with negative token_id.\"\"\"\n+        sp = self._make(stop_token_ids=[-1])\n+        with self.assertRaises(ValueError):\n+            sp.verify(self.VOCAB_SIZE)\n+\n+    def test_stop_token_ids_valid_tokens(self):\n+        \"\"\"Test that stop_token_ids with token_ids within [0, vocab_size) is accepted.\"\"\"\n+        sp = self._make(stop_token_ids=[0, 31999])\n+        sp.verify(self.VOCAB_SIZE)\n+\n     # --- sampling_seed ---\n     def test_sampling_seed_valid(self):\n         \"\"\"Test that None (the default) and the int64 min/max boundaries are accepted.\"\"\"",
