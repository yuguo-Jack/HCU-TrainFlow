    },
    {
      "additions": 11,
      "blob_url": "https://github.com/sgl-project/sglang/blob/aacaca3069d10433e44b432f9ca85f6a7123aa4f/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_host_memory.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_host_memory.py?ref=aacaca3069d10433e44b432f9ca85f6a7123aa4f",
      "deletions": 0,
      "filename": "test/registered/unit/mem_cache/test_host_memory.py",
      "patch": "@@ -212,6 +212,17 @@ def test_unavailable_cgroup_requires_explicit_sizing(self):\n                             self.available(allow_cgroup_fallback=True), 5000\n                         )\n \n+    def test_membership_outside_mount_root_requires_explicit_sizing(self):\n+        \"\"\"A process joined from a sibling cgroup (an srun --overlap step) sees\n+        a membership above the mount root; explicit sizing must still start.\"\"\"\n+        for v1 in [False, True]:\n+            with self.subTest(v1=v1):\n+                self.configure(\"/../../../step_129/user/task_0\", v1=v1)\n+                with self.assertRaisesRegex(RuntimeError, \"set --hicache-size\"):\n+                    self.available()\n+                with self.assertLogs(host_memory.logger, level=\"WARNING\"):\n+                    self.assertEqual(self.available(allow_cgroup_fallback=True), 5000)\n+\n     def test_missing_counters_for_known_limit_requires_explicit_sizing(self):\n         for name in (\"memory.current\", \"memory.stat\"):\n             with self.subTest(name=name):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aacaca3069d10433e44b432f9ca85f6a7123aa4f/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_host_memory.py",
