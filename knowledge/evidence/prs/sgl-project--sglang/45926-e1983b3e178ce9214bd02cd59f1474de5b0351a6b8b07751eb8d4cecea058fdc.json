      "blob_url": "https://github.com/sgl-project/sglang/blob/aacaca3069d10433e44b432f9ca85f6a7123aa4f/python%2Fsglang%2Fsrt%2Fmem_cache%2Fhost_memory.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Fhost_memory.py?ref=aacaca3069d10433e44b432f9ca85f6a7123aa4f",
      "deletions": 1,
      "filename": "python/sglang/srt/mem_cache/host_memory.py",
      "patch": "@@ -75,7 +75,8 @@ def _cgroup_memory_headroom(proc_root: Path = Path(\"/proc\")) -> int | None:\n         else:\n             continue\n         if \"..\" in relative.parts:\n-            raise ValueError(f\"Cannot resolve cgroup memory path: {membership}\")\n+            # e.g. an srun --overlap step joining another step's container.\n+            raise RuntimeError(f\"Cannot resolve cgroup memory path: {membership}\")\n         directory = mount / relative\n         if not directory.is_dir():\n             continue",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aacaca3069d10433e44b432f9ca85f6a7123aa4f/python%2Fsglang%2Fsrt%2Fmem_cache%2Fhost_memory.py",
