      "additions": 13,
      "blob_url": "https://github.com/sgl-project/sglang/blob/fe20c43c592878570db9df8c6dc2e9d196af292a/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=fe20c43c592878570db9df8c6dc2e9d196af292a",
      "deletions": 2,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -26,6 +26,7 @@\n from contextlib import ExitStack, contextmanager, nullcontext\n from functools import partial\n from http import HTTPStatus\n+from itertools import chain\n from typing import TYPE_CHECKING, Any, Deque, Dict, List, Optional, Set, Tuple, Union\n \n from sglang.srt.runtime_context import (\n@@ -3539,7 +3540,17 @@ def _poll_timeout_aborts(self) -> List[AbortReq]:\n \n         if (timeout_s := envs.SGLANG_REQ_WAITING_TIMEOUT.get()) > 0:\n             deadline = time.perf_counter() - timeout_s\n-            for req in self.waiting_queue:\n+            waiting_reqs = self.waiting_queue\n+            if self.dllm_config is not None:\n+                waiting_reqs = chain(\n+                    waiting_reqs,\n+                    (\n+                        req\n+                        for req in self.dllm_manager.waiting_queue\n+                        if req.time_stats.forward_entry_time == 0.0\n+                    ),\n+                )\n+            for req in waiting_reqs:\n                 entry_time = req.time_stats.wait_queue_entry_time\n                 if 0 < entry_time < deadline:\n                     aborts.append(\n@@ -5600,7 +5611,7 @@ def abort_request(self, recv_req: AbortReq):\n             ):\n                 self._release_aborted_request(req)\n                 self.ipc_channels.send_to_tokenizer.send_output(\n-                    _make_abort_req(req), req\n+                    _make_abort_req(req, finished_reason=recv_req.finished_reason), req\n                 )\n                 if req.kv.holds_kv or req.kv.holds_mamba:\n                     release_kv_cache(req, self.tree_cache, checkpoint=False)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fe20c43c592878570db9df8c6dc2e9d196af292a/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "56589dbd432b5ef27a753ce99d95cbdfb31a8d38",
      "status": "modified"
    },
    {
      "additions": 48,
      "blob_url": "https://github.com/sgl-project/sglang/blob/fe20c43c592878570db9df8c6dc2e9d196af292a/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py",
      "changes": 48,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py?ref=fe20c43c592878570db9df8c6dc2e9d196af292a",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_scheduler_timeouts.py",
      "patch": "@@ -24,6 +24,7 @@\n \n maybe_stub_sgl_kernel()\n \n+from sglang.srt.dllm.mixin.scheduler import DllmManager\n from sglang.srt.managers.schedule_batch import FINISH_ABORT, Req\n from sglang.srt.managers.scheduler import Scheduler\n from sglang.srt.mem_cache.base_prefix_cache import (\n@@ -72,6 +73,7 @@ def _scheduler(waiting_queue, running_reqs=(), last_batch_reqs=()):\n     s.enable_continuous_input_polling = False\n     s.result_queue = deque()\n     s.waiting_queue = waiting_queue\n+    s.dllm_config = None\n     s.enable_hierarchical_cache = False\n     s.enable_hicache_storage = False\n     s.enable_unified_cache_external_linker = False\n@@ -138,6 +140,52 @@ def test_disabled_timeout_is_a_no_op(self):\n         with envs.SGLANG_REQ_WAITING_TIMEOUT.override(0):\n             self.assertEqual(s._poll_timeout_aborts(), [])\n \n+    def test_dllm_waiting_timeout_after_queue_transfer(self):\n+        \"\"\"Queued dLLM timeouts must preserve their reason through abort cleanup.\"\"\"\n+        enter_scope(self, published_topology())\n+        now = time.perf_counter()\n+        stale = _req(\"stale\", wait_entry=now - 10)\n+        denoising = _req(\"denoising\", wait_entry=now - 10, forward_entry=now - 5)\n+        s = _scheduler([stale, denoising])\n+        s.dllm_config = SimpleNamespace(max_running_requests=2)\n+        s.dllm_manager = DllmManager(s.dllm_config)\n+\n+        s._fetch_waiting_reqs()\n+        self.assertEqual(s.waiting_queue, [])\n+        self.assertEqual(s.dllm_manager.waiting_queue, [stale, denoising])\n+\n+        with envs.SGLANG_REQ_WAITING_TIMEOUT.override(1.0):\n+            aborts = s._poll_timeout_aborts()\n+\n+        self.assertEqual([a.rid for a in aborts], [\"stale\"])\n+        self.assertEqual(s.dllm_manager.waiting_queue, [stale, denoising])\n+        s.chunked_req = None\n+        s.mm_receiver = None\n+        s.disaggregation_mode = DisaggregationMode.NULL\n+        s.grammar_manager = MagicMock()\n+        s.tree_cache = MagicMock(spec=[\"finish\"])\n+        stale.kv = SimpleNamespace(holds_kv=False, holds_mamba=False)\n+        with patch(\n+            \"sglang.srt.managers.scheduler.get_serving\",\n+            return_value=SimpleNamespace(weight_version=\"v0\"),\n+        ):\n+            s.abort_request(aborts[0])\n+\n+        sent_abort, sent_req = (\n+            s.ipc_channels.send_to_tokenizer.send_output.call_args.args\n+        )\n+        self.assertIs(sent_req, stale)\n+        self.assertEqual(sent_abort.rid, \"stale\")\n+        self.assertEqual(\n+            sent_abort.finished_reason,\n+            {\n+                \"type\": \"abort\",\n+                \"status_code\": 503,\n+                \"message\": \"Request waiting timeout reached.\",\n+            },\n+        )\n+        self.assertEqual(s.dllm_manager.waiting_queue, [denoising])\n+\n \n class TestRunningTimeout(CustomTestCase):\n     def setUp(self):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fe20c43c592878570db9df8c6dc2e9d196af292a/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py",
      "sha": "51141c4817cd3912660a8f71f9290cf582a06b65",
      "status": "modified"
    }
