  "inline_comments": [
    {
      "body": "Manager-held requests now time out, but the dLLM branch of `abort_request` drops the reason, returning HTTP 200 `Abort in waiting queue` instead of 503. Could you pass `recv_req.finished_reason` and assert it in the new test?",
      "created_at": "2026-10-11T07:18:04Z",
      "diff_hunk": "@@ -3389,7 +3390,17 @@ def _poll_timeout_aborts(self) -> List[AbortReq]:\n \n         if (timeout_s := envs.SGLANG_REQ_WAITING_TIMEOUT.get()) > 0:\n             deadline = time.perf_counter() - timeout_s\n-            for req in self.waiting_queue:\n+            waiting_reqs = self.waiting_queue\n+            if self.dllm_config is not None:\n+                waiting_reqs = chain(\n+                    waiting_reqs,\n+                    (\n+                        req\n+                        for req in self.dllm_manager.waiting_queue\n+                        if req.time_stats.forward_entry_time == 0.0\n+                    ),\n+                )",
