      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fio_struct.py?ref=22e47399295b956458d91659f906573e2c0e3c97",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/io_struct.py",
      "patch": "@@ -2374,7 +2374,7 @@ class ProfileReq(BaseReq, kw_only=True):\n     num_steps: Optional[int] = None\n     # The activities to record. The choices are [\"CPU\", \"GPU\", \"MEM\", \"RPD\"]\n     activities: Optional[List[str]] = None\n-    # Whether profile by stages (e.g., prefill and decode) separately\n+    # Profile prefill and decode separately; requires a positive num_steps.\n     profile_by_stage: bool = False\n     # Whether to record source information (file and line number) for the ops.\n     with_stack: Optional[bool] = None\n@@ -2390,6 +2390,10 @@ class ProfileReq(BaseReq, kw_only=True):\n     # Add iteration-level annotations (KV / request aggregates) for roofline-style analysis\n     detailed_annotations: bool = False\n \n+    def __post_init__(self):\n+        if self.profile_by_stage and (self.num_steps is None or self.num_steps <= 0):\n+            raise ValueError(\"profile_by_stage requires a positive num_steps\")\n+\n \n class ProfileReqOutput(BaseReq, kw_only=True):\n     success: bool",
      "raw_url": "https://github.com/sgl-project/sglang/raw/22e47399295b956458d91659f906573e2c0e3c97/python%2Fsglang%2Fsrt%2Fmanagers%2Fio_struct.py",
      "sha": "09d80e0f239f19fad509714fae83c7670cf6e8eb",
      "status": "modified"
    },
    {
      "additions": 30,
      "blob_url": "https://github.com/sgl-project/sglang/blob/22e47399295b956458d91659f906573e2c0e3c97/test%2Fregistered%2Funit%2Fapi%2Fv1%2Ftest_parity.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fapi%2Fv1%2Ftest_parity.py?ref=22e47399295b956458d91659f906573e2c0e3c97",
      "deletions": 0,
      "filename": "test/registered/unit/api/v1/test_parity.py",
      "patch": "@@ -34,6 +34,8 @@\n     AttachHiCacheStorageReqInput,\n     BaseReq,\n     GenerateReqInput,\n+    ProfileReq,\n+    ProfileReqType,\n )\n from sglang.srt.sampling.sampling_params import SamplingParams as PySamplingParams\n \n@@ -135,6 +137,34 @@ def test_every_fixture_type_is_a_generated_struct(self):\n             self.assertTrue(hasattr(api_types, case[\"type\"]), case[\"type\"])\n \n \n+class TestProfileRequestValidation(CustomTestCase):\n+    def test_stage_profiling_requires_positive_steps(self):\n+        \"\"\"Invalid stage profiles are rejected before request handling.\"\"\"\n+        adapter = TypeAdapter(ProfileReq)\n+        for payload in (\n+            {\"profile_by_stage\": True},\n+            {\"profile_by_stage\": True, \"num_steps\": 0},\n+            {\"profile_by_stage\": True, \"num_steps\": -1},\n+            {\"profile_by_stage\": True, \"req_type\": 2},\n+        ):\n+            with self.subTest(payload=payload):\n+                with self.assertRaises(ValueError):\n+                    adapter.validate_json(json.dumps(payload))\n+        self.assertEqual(\n+            adapter.validate_json(\n+                '{\"profile_by_stage\": true, \"num_steps\": 3}'\n+            ).num_steps,\n+            3,\n+        )\n+        self.assertIsNone(adapter.validate_json(\"{}\").num_steps)\n+        with self.assertRaises(ValueError):\n+            ProfileReq(profile_by_stage=True)\n+        self.assertEqual(\n+            ProfileReq(req_type=ProfileReqType.STOP_PROFILE).req_type,\n+            ProfileReqType.STOP_PROFILE,\n+        )\n+\n+\n class TestHiCacheRequestParity(CustomTestCase):\n     def test_attach_fields_match_python(self):\n         \"\"\"Only scheduler transport fields are excluded from the public request.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/22e47399295b956458d91659f906573e2c0e3c97/test%2Fregistered%2Funit%2Fapi%2Fv1%2Ftest_parity.py",
