      "changes": 1,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=7b7e4ed20005c00b11ac3f86f0acb7812f0a5733",
      "deletions": 0,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -3947,6 +3947,7 @@ def _handle_embedding_request(\n             get_serving().allow_auto_truncate,\n         )\n         if error_msg:\n+            req.set_finish_with_abort(error_msg)\n             self._add_request_to_queue(req)\n             return\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7b7e4ed20005c00b11ac3f86f0acb7812f0a5733/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "75af9fcc78a36f2af658e3d4947714f9c57e4ca9",
      "status": "modified"
    },
    {
      "additions": 57,
      "blob_url": "https://github.com/sgl-project/sglang/blob/7b7e4ed20005c00b11ac3f86f0acb7812f0a5733/test%2Fregistered%2Fopenai_server%2Fvalidation%2Ftest_embedding_length_validation.py",
      "changes": 57,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fopenai_server%2Fvalidation%2Ftest_embedding_length_validation.py?ref=7b7e4ed20005c00b11ac3f86f0acb7812f0a5733",
      "deletions": 0,
      "filename": "test/registered/openai_server/validation/test_embedding_length_validation.py",
      "patch": "@@ -0,0 +1,57 @@\n+import unittest\n+\n+import requests\n+\n+from sglang.srt.utils import kill_process_tree\n+from sglang.test.ci.ci_register import register_cuda_ci, register_xpu_ci\n+from sglang.test.test_utils import (\n+    DEFAULT_SMALL_EMBEDDING_MODEL_NAME_FOR_TEST,\n+    DEFAULT_TIMEOUT_FOR_SERVER_LAUNCH,\n+    DEFAULT_URL_FOR_TEST,\n+    CustomTestCase,\n+    popen_launch_server,\n+)\n+\n+register_cuda_ci(est_time=60, stage=\"base-b\", runner_config=\"1-gpu-small\")\n+register_xpu_ci(est_time=90, suite=\"stage-b-test-1-gpu-xpu\")\n+\n+\n+class TestEmbeddingLengthValidation(CustomTestCase):\n+    \"\"\"A prompt that fits the context length but not the KV pool must fail fast, not hang.\"\"\"\n+\n+    @classmethod\n+    def setUpClass(cls):\n+        cls.model = DEFAULT_SMALL_EMBEDDING_MODEL_NAME_FOR_TEST\n+        cls.base_url = DEFAULT_URL_FOR_TEST\n+        cls.process = popen_launch_server(\n+            cls.model,\n+            cls.base_url,\n+            timeout=DEFAULT_TIMEOUT_FOR_SERVER_LAUNCH,\n+            other_args=(\"--is-embedding\", \"--max-total-tokens\", \"1000\"),\n+        )\n+\n+    @classmethod\n+    def tearDownClass(cls):\n+        kill_process_tree(cls.process.pid)\n+\n+    def _embed(self, text: str) -> requests.Response:\n+        return requests.post(\n+            f\"{self.base_url}/v1/embeddings\",\n+            json={\"model\": self.model, \"input\": text},\n+            timeout=60,\n+        )\n+\n+    def test_input_longer_than_kv_pool_is_rejected(self):\n+        response = self._embed(\"hello \" * 1500)\n+        self.assertEqual(response.status_code, 400, response.text)\n+        self.assertIn(\"exceeds the maximum allowed length\", response.text)\n+\n+    def test_server_still_serves_after_rejection(self):\n+        self._embed(\"hello \" * 1500)\n+        response = self._embed(\"hello world\")\n+        self.assertEqual(response.status_code, 200, response.text)\n+        self.assertGreater(len(response.json()[\"data\"][0][\"embedding\"]), 0)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7b7e4ed20005c00b11ac3f86f0acb7812f0a5733/test%2Fregistered%2Fopenai_server%2Fvalidation%2Ftest_embedding_length_validation.py",
      "sha": "772bac7ae8286e0916e5e739cd8173f28df399c6",
      "status": "added"
    }
