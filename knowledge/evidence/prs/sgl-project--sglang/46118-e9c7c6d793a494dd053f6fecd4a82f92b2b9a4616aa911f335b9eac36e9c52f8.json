  "files": [
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e9e070202399f282f82be553eaec6d8712617384/docs%2Fcookbook%2Fautoregressive%2FMoonshotai%2FKimi-K3.mdx",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fcookbook%2Fautoregressive%2FMoonshotai%2FKimi-K3.mdx?ref=e9e070202399f282f82be553eaec6d8712617384",
      "deletions": 0,
      "filename": "docs/cookbook/autoregressive/Moonshotai/Kimi-K3.mdx",
      "patch": "@@ -478,3 +478,13 @@ Decisions the preset already makes:\n <Note>\n No preset has a full serving round on final weights; the constants derive from measured single- and dual-node rounds plus a 64-GPU sweep. Validate throughput and accuracy on your workload before committing a fleet.\n </Note>\n+\n+\n+## Nested Messages tool results\n+\n+For the Anthropic-compatible Messages API, `tool_result.content` accepts a string\n+or a list of `text`, `image`, `tool_reference` and `search_result` blocks.\n+Unsupported nested blocks are rejected during request validation instead of\n+being removed while the rest of the tool result is processed. This restriction\n+applies only inside tool results; assistant thinking and tool-use history keep\n+their existing top-level formats.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e9e070202399f282f82be553eaec6d8712617384/docs%2Fcookbook%2Fautoregressive%2FMoonshotai%2FKimi-K3.mdx",
      "sha": "5cf9db96cf31a157ec8217a34013e0137b01ef75",
      "status": "modified"
    },
    {
      "additions": 17,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e9e070202399f282f82be553eaec6d8712617384/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fprotocol.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fprotocol.py?ref=e9e070202399f282f82be553eaec6d8712617384",
      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/anthropic/protocol.py",
      "patch": "@@ -80,6 +80,23 @@ class ToolResultBlock(BaseModel):\n     content: Optional[Union[str, list[\"AnthropicContentBlock\"]]] = None\n     is_error: Optional[bool] = None\n \n+    @field_validator(\"content\")\n+    @classmethod\n+    def validate_nested_content(cls, content):\n+        if isinstance(content, list):\n+            for index, block in enumerate(content):\n+                if block.type not in (\n+                    \"text\",\n+                    \"image\",\n+                    \"tool_reference\",\n+                    \"search_result\",\n+                ):\n+                    raise ValueError(\n+                        f\"Unsupported tool_result.content[{index}] type: {block.type!r}; \"\n+                        \"expected text, image, tool_reference or search_result\"\n+                    )\n+        return content\n+\n \n class ToolReferenceBlock(BaseModel):\n     \"\"\"sglang extension: references a deferred-loaded tool by name.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e9e070202399f282f82be553eaec6d8712617384/python%2Fsglang%2Fsrt%2Fentrypoints%2Fanthropic%2Fprotocol.py",
      "sha": "c803a728db59065b757b7bc32dad3f87dc54a0d2",
      "status": "modified"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e9e070202399f282f82be553eaec6d8712617384/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py?ref=e9e070202399f282f82be553eaec6d8712617384",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/anthropic/test_serving.py",
      "patch": "@@ -11,6 +11,7 @@\n from fastapi import HTTPException  # noqa: E402\n from fastapi.responses import JSONResponse  # noqa: E402\n from jinja2 import Environment  # noqa: E402\n+from pydantic import ValidationError  # noqa: E402\n \n from sglang.srt.entrypoints.anthropic.protocol import (  # noqa: E402\n     AnthropicMessage,\n@@ -385,6 +386,23 @@ def test_non_streaming_usage_subtracts_cache_read_tokens(self):\n         self.assertEqual(anthropic_response.usage.output_tokens, 2)\n         self.assertEqual(anthropic_response.usage.cache_read_input_tokens, 4)\n \n+    def test_unsupported_nested_tool_result_blocks_are_rejected(self):\n+        for block in (\n+            {\"type\": \"thinking\", \"thinking\": \"discarded\"},\n+            {\"type\": \"redacted_thinking\", \"data\": \"discarded\"},\n+            {\"type\": \"tool_use\", \"id\": \"nested\", \"name\": \"f\", \"input\": {}},\n+            {\"type\": \"tool_result\", \"tool_use_id\": \"nested\", \"content\": \"discarded\"},\n+        ):\n+            with (\n+                self.subTest(block=block),\n+                self.assertRaisesRegex(\n+                    ValidationError, \"Unsupported tool_result.content\"\n+                ),\n+            ):\n+                self._tool_result_request(\n+                    [{\"type\": \"text\", \"text\": \"Keep this\"}, block]\n+                )\n+\n     def test_tool_result_search_result_content_is_flattened(self):\n         request = AnthropicMessagesRequest.model_validate(\n             {",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e9e070202399f282f82be553eaec6d8712617384/test%2Fregistered%2Funit%2Fentrypoints%2Fanthropic%2Ftest_serving.py",
      "sha": "b885bdeff16716d06f22ae0f26b7440934ceb430",
