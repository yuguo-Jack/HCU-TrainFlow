      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fmm_utils.py?ref=5e4ba30e774e387db49e0f120f9dad615bbcdb7e",
      "deletions": 6,
      "filename": "python/sglang/srt/managers/mm_utils.py",
      "patch": "@@ -512,12 +512,9 @@ def embed_mm_inputs(\n \n     # 3. Get input embeddings\n     vocab_size = input_embedding.num_embeddings\n-    # Important: clamp after getting original multimodal regions\n-    # Clamp input ids. This is because the input_ids for the multimodal tokens are\n-    # filled with the hash values of the multimodal for the prefix matching in the radix attention.\n-    # There values are useless because their embeddings will be replaced by vision embeddings anyway.\n-    input_ids.clamp_(min=0, max=vocab_size - 1)\n-    input_embeds = input_embedding(input_ids)\n+    # Multimodal hash IDs can exceed the vocabulary. Clamp only the embedding\n+    # input; the caller's IDs must retain those placeholders for later calls.\n+    input_embeds = input_embedding(input_ids.clamp(min=0, max=vocab_size - 1))\n \n     # deepstack embedding\n     if use_deepstack:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5e4ba30e774e387db49e0f120f9dad615bbcdb7e/python%2Fsglang%2Fsrt%2Fmanagers%2Fmm_utils.py",
      "sha": "b2e3584ce21b09edf105e5920129e249d8daf593",
      "status": "modified"
    },
    {
      "additions": 45,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5e4ba30e774e387db49e0f120f9dad615bbcdb7e/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_embed_scatter.py",
      "changes": 46,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_embed_scatter.py?ref=5e4ba30e774e387db49e0f120f9dad615bbcdb7e",
      "deletions": 1,
      "filename": "test/registered/unit/managers/test_mm_embed_scatter.py",
      "patch": "@@ -1,7 +1,11 @@\n+from types import SimpleNamespace\n+from unittest.mock import patch\n+\n import pytest\n import torch\n \n-from sglang.srt.managers.mm_utils import _scatter_mm_embedding\n+from sglang.srt.managers.mm_utils import _scatter_mm_embedding, embed_mm_inputs\n+from sglang.srt.managers.schedule_batch import Modality\n from sglang.test.ci.ci_register import register_cpu_ci\n \n register_cpu_ci(est_time=5, suite=\"stage-a-test-cpu-intel\")\n@@ -55,6 +59,46 @@ def test_scatter_row_count_mismatch_fails_loud():\n         _scatter_mm_embedding(dest=dest, mask=mask_heavy, src=torch.ones(1, 4))\n \n \n+@pytest.mark.parametrize(\"as_view\", [False, True], ids=[\"owned\", \"view\"])\n+def test_embedding_preserves_reusable_multimodal_input_ids(as_view):\n+    pad = 1_000_001\n+    original = torch.tensor([3, 1, pad, pad, 2, 4])\n+    original_before = original.clone()\n+    ids = original[1:5] if as_view else original[1:5].clone()\n+    before = ids.clone()\n+    item = SimpleNamespace(\n+        pad_value=pad,\n+        offsets=[(1, 2)],\n+        is_modality=lambda modality: modality == Modality.IMAGE,\n+    )\n+    embedding = torch.nn.Embedding(16, 4)\n+\n+    def image_embedding(**kwargs):\n+        return (\n+            torch.full((2, 4), 42.0),\n+            kwargs[\"input_ids\"].eq(pad).unsqueeze(-1),\n+            kwargs[\"input_ids\"],\n+        )\n+\n+    with patch(\n+        \"sglang.srt.managers.mm_utils.get_embedding_and_mask\",\n+        side_effect=image_embedding,\n+    ):\n+        for _ in range(2):\n+            result, _ = embed_mm_inputs(\n+                mm_inputs_list=[SimpleNamespace(mm_items=[item])],\n+                extend_prefix_lens=[0],\n+                extend_seq_lens=[4],\n+                input_ids=ids,\n+                input_embedding=embedding,\n+                multimodal_model=SimpleNamespace(get_image_feature=lambda items: None),\n+            )\n+            assert torch.equal(ids, before)\n+            assert torch.equal(original, original_before)\n+            torch.testing.assert_close(result[1:3], torch.full((2, 4), 42.0))\n+            torch.testing.assert_close(result[[0, 3]], embedding(before[[0, 3]]))\n+\n+\n if __name__ == \"__main__\":\n     import sys\n ",
