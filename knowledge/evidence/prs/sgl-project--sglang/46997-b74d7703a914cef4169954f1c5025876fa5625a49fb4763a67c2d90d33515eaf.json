  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9220452c979bd5b781a7d8297649b21c731b29a9/python%2Fsglang%2Fsrt%2Flayers%2Frotary_embedding%2Fbase.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Frotary_embedding%2Fbase.py?ref=9220452c979bd5b781a7d8297649b21c731b29a9",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/rotary_embedding/base.py",
      "patch": "@@ -81,6 +81,8 @@\n             \"XPU rotary embedding will use the generic rotary_embedding kernel. \"\n             \"Upgrade sgl_kernel to enable the fused XPU kernel.\"\n         )\n+# Head sizes sgl_kernel.rotary_embedding accepts on XPU; it raises on any other.\n+_XPU_ROTARY_EMBEDDING_HEAD_SIZES = (32, 64, 96, 128, 256)\n \n \n class RotaryEmbedding(BaseFusedOp):\n@@ -570,7 +572,10 @@ def forward_xpu(\n                 self.is_neox_style,\n             )\n             return query, key\n-        elif self.head_size != self.rotary_dim:\n+        elif (\n+            self.head_size != self.rotary_dim\n+            or self.head_size not in _XPU_ROTARY_EMBEDDING_HEAD_SIZES\n+        ):\n             return self.forward_native(positions, query, key)\n         else:\n             self._match_cos_sin_cache_dtype(query)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9220452c979bd5b781a7d8297649b21c731b29a9/python%2Fsglang%2Fsrt%2Flayers%2Frotary_embedding%2Fbase.py",
      "sha": "d9f721d5de07db2fb64e56ccbfc4cb126e2856f0",
      "status": "modified"
    },
    {
      "additions": 53,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9220452c979bd5b781a7d8297649b21c731b29a9/test%2Fregistered%2Fxpu%2Ftest_rope_xpu.py",
      "changes": 53,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fxpu%2Ftest_rope_xpu.py?ref=9220452c979bd5b781a7d8297649b21c731b29a9",
      "deletions": 0,
      "filename": "test/registered/xpu/test_rope_xpu.py",
      "patch": "@@ -0,0 +1,53 @@\n+\"\"\"RotaryEmbedding.forward_xpu must not raise for full-rotary head sizes sgl_kernel lacks.\n+\n+sgl_kernel.rotary_embedding on XPU only takes head sizes 32/64/96/128/256; any other\n+full-rotary head size (e.g. 80) must fall back to forward_native instead of raising.\n+\"\"\"\n+\n+import unittest\n+\n+import torch\n+\n+from sglang.test.ci.ci_register import register_xpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_xpu_ci(est_time=30, suite=\"stage-b-test-1-gpu-xpu\")\n+\n+\n+class TestRotaryEmbeddingXPU(CustomTestCase):\n+    def setUp(self):\n+        if not torch.xpu.is_available():\n+            self.skipTest(\"XPU not available\")\n+        torch.manual_seed(0)\n+\n+    def _check(self, head_size: int, is_neox: bool):\n+        from sglang.srt.layers.rotary_embedding import get_rope\n+\n+        rope = get_rope(\n+            head_size,\n+            rotary_dim=head_size,\n+            max_position=4096,\n+            base=1e6,\n+            is_neox_style=is_neox,\n+        ).to(\"xpu\")\n+        num_tokens, num_heads, num_kv_heads = 7, 4, 2\n+        positions = torch.randint(0, 4096, (num_tokens,), device=\"xpu\")\n+        q = torch.randn(\n+            num_tokens, num_heads * head_size, dtype=torch.bfloat16, device=\"xpu\"\n+        )\n+        k = torch.randn(\n+            num_tokens, num_kv_heads * head_size, dtype=torch.bfloat16, device=\"xpu\"\n+        )\n+        q_ref, k_ref = rope.forward_native(positions, q.clone(), k.clone())\n+        q_out, k_out = rope.forward_xpu(positions, q.clone(), k.clone())\n+        torch.testing.assert_close(q_out, q_ref, atol=2e-2, rtol=1e-2)\n+        torch.testing.assert_close(k_out, k_ref, atol=2e-2, rtol=1e-2)\n+\n+    def test_head_size_without_xpu_kernel(self):\n+        # Qwen3-32B's EAGLE3 draft (AngelSlim/Qwen3-32B_eagle3) uses head_dim 80.\n+        for is_neox in (True, False):\n+            self._check(80, is_neox)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9220452c979bd5b781a7d8297649b21c731b29a9/test%2Fregistered%2Fxpu%2Ftest_rope_xpu.py",
      "sha": "2d0f2c3590b41338a5456ca1e90a457b58c7618f",
      "status": "added"
    }
