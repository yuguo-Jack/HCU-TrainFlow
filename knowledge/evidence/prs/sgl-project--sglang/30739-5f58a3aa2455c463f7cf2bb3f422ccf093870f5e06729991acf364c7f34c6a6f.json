      "blob_url": "https://github.com/sgl-project/sglang/blob/e06aa11554fd6d20d834a3254945c957aa26737b/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fprofiler_manager.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fprofiler_manager.py?ref=e06aa11554fd6d20d834a3254945c957aa26737b",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/scheduler_components/profiler_manager.py",
      "patch": "@@ -123,7 +123,15 @@ def _init_profile(\n         if activities is None:\n             activities = [\"CPU\", \"GPU\"]\n \n-        self.torch_profiler_output_dir = Path(output_dir).expanduser()\n+        # Security: sanitize output_dir to prevent path traversal. The\n+        # output_dir comes from the /start_profile API request body and could\n+        # contain ../ sequences to write trace files to arbitrary locations.\n+        resolved = Path(output_dir).expanduser().resolve()\n+        # Only allow absolute paths under a known-safe root (default /tmp).\n+        safe_root = Path(os.getenv(\"SGLANG_TORCH_PROFILER_DIR\", \"/tmp\")).resolve()\n+        if not str(resolved).startswith(str(safe_root)):\n+            raise ValueError(f\"output_dir must be under {safe_root}, got: {output_dir}\")\n+        self.torch_profiler_output_dir = resolved\n         self.torch_profiler_with_stack = with_stack\n         self.torch_profiler_record_shapes = record_shapes\n         self.profiler_activities = activities",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e06aa11554fd6d20d834a3254945c957aa26737b/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fprofiler_manager.py",
      "sha": "ec32a3d2e711047af5c0ac623f8d862d296bbf8a",
      "status": "modified"
    }
