      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/attention_hook.py",
      "patch": "@@ -14,6 +14,7 @@\n     _cutedsl_prefill_backend_fill,\n     _deterministic_allreduce_fusion_disable,\n     _deterministic_attention_backend,\n+    _deterministic_rocm_rccl_check,\n     _deterministic_sampling_backend,\n     _fa4_page_constraint,\n     _intel_xpu_page_constraint,\n@@ -668,6 +669,7 @@ def handle_deterministic_inference(server_args: Any):\n             if get_platform().is_hip:\n                 # AMD: use 1-stage all-reduce kernel which is inherently deterministic\n                 # (each GPU reads all data from all GPUs, reduces locally in fixed order)\n+                run_post_process_pass(server_args, _deterministic_rocm_rccl_check)\n                 logger.info(\"AMD/ROCm: Using 1-stage all-reduce kernel (deterministic)\")\n             else:\n                 # CUDA: use NCCL tree algorithm",
      "raw_url": "https://github.com/sgl-project/sglang/raw/037248f15acbe665493870e160a16e4224469fa6/python%2Fsglang%2Fsrt%2Farg_groups%2Fattention_hook.py",
      "sha": "6f7b7d1e49ab7cad96ac3fce379f644d2aa4e2cd",
      "status": "modified"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/037248f15acbe665493870e160a16e4224469fa6/python%2Fsglang%2Fsrt%2Farg_groups%2Foverrides.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Foverrides.py?ref=037248f15acbe665493870e160a16e4224469fa6",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/overrides.py",
      "patch": "@@ -1030,6 +1030,24 @@ def _deterministic_allreduce_fusion_disable(view: Any) -> dict:\n     return {}\n \n \n+@register_post_process\n+def _deterministic_rocm_rccl_check(view: Any) -> dict:\n+    # Deterministic TP on ROCm relies on the one-stage custom all-reduce; above two ranks\n+    # RCCL's results change with the batch, even with its algorithm and protocol pinned.\n+    if (\n+        view.enable_deterministic_inference\n+        and get_platform().is_hip\n+        and view.tp_size > 2\n+        and view.disable_custom_all_reduce\n+    ):\n+        raise ValueError(\n+            \"--disable-custom-all-reduce cannot be combined with \"\n+            \"--enable-deterministic-inference on ROCm when --tp-size is above 2: \"\n+            \"the all-reduce would run through RCCL, which is not batch-invariant.\"\n+        )\n+    return {}\n+\n+\n @register_post_process\n def _deterministic_attention_backend(view: Any) -> dict:\n     if not view.enable_deterministic_inference:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/037248f15acbe665493870e160a16e4224469fa6/python%2Fsglang%2Fsrt%2Farg_groups%2Foverrides.py",
      "sha": "fa311fd05d5fd5b8e569f26cbf77fd7566ba6abe",
      "status": "modified"
    },
    {
      "additions": 49,
      "blob_url": "https://github.com/sgl-project/sglang/blob/037248f15acbe665493870e160a16e4224469fa6/test%2Fregistered%2Funit%2Ftest_model_overrides.py",
      "changes": 49,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ftest_model_overrides.py?ref=037248f15acbe665493870e160a16e4224469fa6",
      "deletions": 0,
      "filename": "test/registered/unit/test_model_overrides.py",
      "patch": "@@ -1741,6 +1741,55 @@ def test_deterministic_ascend_is_left_alone(self):\n         )\n         self.assertEqual(_deterministic_sampling_backend(view), {})\n \n+    def test_deterministic_rocm_rccl_above_two_ranks_raises(self):\n+        \"\"\"Deterministic ROCm TP above 2 must not fall back to RCCL, whose results\n+        change with the batch above two ranks.\"\"\"\n+        from sglang.srt.arg_groups.overrides import (\n+            ResolvedView,\n+            _deterministic_rocm_rccl_check,\n+        )\n+\n+        view = ResolvedView(\n+            SimpleNamespace(\n+                enable_deterministic_inference=True,\n+                tp_size=4,\n+                disable_custom_all_reduce=True,\n+            )\n+        )\n+        with override_platform(is_cuda=False, is_hip=True):\n+            with self.assertRaises(ValueError):\n+                _deterministic_rocm_rccl_check(view)\n+\n+    def test_deterministic_rocm_rccl_check_leaves_other_setups_alone(self):\n+        # CUDA disables the custom all-reduce itself in deterministic mode, and\n+        # a two-rank sum has one order whatever the algorithm.\n+        from sglang.srt.arg_groups.overrides import (\n+            ResolvedView,\n+            _deterministic_rocm_rccl_check,\n+        )\n+\n+        cases = [\n+            (False, True, 8, True),\n+            (True, False, 8, True),\n+            (True, True, 2, True),\n+            (True, True, 8, False),\n+        ]\n+        for is_hip, deterministic, tp_size, disable_car in cases:\n+            view = ResolvedView(\n+                SimpleNamespace(\n+                    enable_deterministic_inference=deterministic,\n+                    tp_size=tp_size,\n+                    disable_custom_all_reduce=disable_car,\n+                )\n+            )\n+            with (\n+                self.subTest(\n+                    is_hip=is_hip, deterministic=deterministic, tp_size=tp_size\n+                ),\n+                override_platform(is_cuda=not is_hip, is_hip=is_hip),\n+            ):\n+                self.assertEqual(_deterministic_rocm_rccl_check(view), {})\n+\n     def test_dllm_forces_flashinfer_with_cuda_graph(self):\n         # CUDA path: cuda graph enabled by default -> dllm forces flashinfer.\n         # A real dllm arch: the page pass now runs regardless of the radix",
      "raw_url": "https://github.com/sgl-project/sglang/raw/037248f15acbe665493870e160a16e4224469fa6/test%2Fregistered%2Funit%2Ftest_model_overrides.py",
      "sha": "ae61276e7018af4192531420c2f3fc617f5d64f5",
      "status": "modified"
