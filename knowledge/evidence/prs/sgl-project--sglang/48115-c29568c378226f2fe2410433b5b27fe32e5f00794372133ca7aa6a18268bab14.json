      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fcommon%2Fstaging_buffer.py?ref=90844cd41543c09bbbe970426b144c38046179d8",
      "deletions": 7,
      "filename": "python/sglang/srt/disaggregation/common/staging_buffer.py",
      "patch": "@@ -196,7 +196,6 @@ def __init__(\n         self.head = 0\n         self.round = 0\n         self.allocations: dict = {}  # alloc_id -> (offset, size, round)\n-        self.alloc_order: List[int] = []\n         self.next_alloc_id = 0\n         self.watermark_round = 0\n         self.watermark_tail = 0\n@@ -229,7 +228,6 @@ def assign(self, required_bytes: int) -> Optional[Tuple[int, int, int]]:\n             alloc_id = self.next_alloc_id\n             self.next_alloc_id += 1\n             self.allocations[alloc_id] = (offset, required_bytes, self.round)\n-            self.alloc_order.append(alloc_id)\n             return (alloc_id, offset, self.round)\n \n     def free(self, alloc_id: int):\n@@ -239,18 +237,15 @@ def free(self, alloc_id: int):\n                 return\n             self.allocations.pop(alloc_id)\n \n-            while self.alloc_order and self.alloc_order[0] not in self.allocations:\n-                self.alloc_order.pop(0)\n-\n             if not self.allocations:\n                 # An empty ring makes the entire prior round reusable. Start a\n                 # fresh round at offset zero so the watermark cannot stay stale.\n                 self.round += 1\n                 self.head = 0\n                 self.watermark_round = self.round\n                 self.watermark_tail = 0\n-            elif self.alloc_order:\n-                off, _, rnd = self.allocations[self.alloc_order[0]]\n+            else:\n+                off, _, rnd = next(iter(self.allocations.values()))\n                 self.watermark_round = rnd\n                 self.watermark_tail = off\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/90844cd41543c09bbbe970426b144c38046179d8/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fcommon%2Fstaging_buffer.py",
      "sha": "3eafa3272e73e85a909ff19a41c1e11c311864ab",
      "status": "modified"
    },
    {
      "additions": 30,
      "blob_url": "https://github.com/sgl-project/sglang/blob/90844cd41543c09bbbe970426b144c38046179d8/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_disaggregation_wire.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_disaggregation_wire.py?ref=90844cd41543c09bbbe970426b144c38046179d8",
      "deletions": 0,
      "filename": "test/registered/unit/disaggregation/test_disaggregation_wire.py",
      "patch": "@@ -1536,6 +1536,36 @@ def test_empty_ring_restarts_at_zero(self, staging_buffer):\n         self.assertEqual(allocator.get_watermark(), (1, 0))\n         self.assertEqual(allocator.assign(70)[1:], (0, 1))\n \n+    @patch(\"sglang.srt.disaggregation.common.staging_buffer.StagingBuffer\")\n+    def test_out_of_order_frees_advance_watermark_to_oldest_live_allocation(\n+        self, staging_buffer\n+    ):\n+        staging_buffer.return_value.data_ptr = 0\n+        allocator = StagingAllocator(100, \"cpu\", 0)\n+        a0, off0, rnd0 = allocator.assign(30)\n+        a1, off1, rnd1 = allocator.assign(40)\n+        a2, off2, rnd2 = allocator.assign(50)  # wraps to round 1, offset 0\n+        a3, off3, rnd3 = allocator.assign(25)  # round 1, offset 50\n+\n+        self.assertEqual((off0, rnd0), (0, 0))\n+        self.assertEqual((off1, rnd1), (30, 0))\n+        self.assertEqual((off2, rnd2), (0, 1))\n+        self.assertEqual((off3, rnd3), (50, 1))\n+\n+        # Freeing middle allocations out-of-order keeps watermark pinned at a0.\n+        allocator.free(a1)\n+        self.assertEqual(allocator.get_watermark(), (0, 0))\n+        allocator.free(a2)\n+        self.assertEqual(allocator.get_watermark(), (0, 0))\n+\n+        # Once a0 is freed, watermark jumps past already-freed a1 and a2 to a3.\n+        allocator.free(a0)\n+        self.assertEqual(allocator.get_watermark(), (1, 50))\n+\n+        # Freeing the last live allocation resets the ring to the next round at offset 0.\n+        allocator.free(a3)\n+        self.assertEqual(allocator.get_watermark(), (2, 0))\n+\n     def test_new_watermark_subscriber_receives_current_allocator_state(self):\n         sock = Mock()\n         bootstrap_info = {\"host\": \"prefill\", \"port\": 7200}",
      "raw_url": "https://github.com/sgl-project/sglang/raw/90844cd41543c09bbbe970426b144c38046179d8/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_disaggregation_wire.py",
      "sha": "b8672a7929aea1518ecec844598dd057c407d0a5",
