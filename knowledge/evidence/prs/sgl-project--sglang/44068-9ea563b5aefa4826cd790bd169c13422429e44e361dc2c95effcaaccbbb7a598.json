      "deletions": 1,
      "filename": "python/sglang/kernels/jit/utils/compile/cache.py",
      "patch": "@@ -299,7 +299,9 @@ def _normalize_text(text: str) -> str:\n \n \n def cache_root() -> pathlib.Path:\n-    configured = envs.SGLANG_JIT_CACHE_DIR.get() or \"~/.cache/sglang/jit\"\n+    configured = envs.SGLANG_JIT_CACHE_DIR.get() or os.path.join(\n+        os.path.expanduser(envs.SGLANG_CACHE_DIR.get()), \"jit\"\n+    )\n     return pathlib.Path(configured).expanduser()\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b7739ce1532c07fdd5284d368ff64d45487d213a/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Fcache.py",
