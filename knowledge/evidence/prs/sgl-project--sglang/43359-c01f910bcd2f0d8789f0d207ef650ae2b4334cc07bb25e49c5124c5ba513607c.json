    {
      "additions": 17,
      "blob_url": "https://github.com/sgl-project/sglang/blob/73f6ddafd032bf6611fea0d886ff55ba09f617a9/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fflashinfer_backend.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fflashinfer_backend.py?ref=73f6ddafd032bf6611fea0d886ff55ba09f617a9",
      "deletions": 0,
      "filename": "python/sglang/srt/layers/attention/flashinfer_backend.py",
      "patch": "@@ -291,6 +291,22 @@ def fast_prefill_plan(\n     self._plan_info = self._cached_module.plan(*args)\n \n \n+# FlashInfer's JIT dispatch has no float32 entry, so an fp32 model only\n+# surfaces as a bare KeyError deep in CUDA-graph capture. Gate it up front.\n+_FLASHINFER_SUPPORTED_MODEL_DTYPES = (torch.float16, torch.bfloat16)\n+\n+\n+def _validate_model_dtype(model_dtype: torch.dtype) -> None:\n+    if model_dtype not in _FLASHINFER_SUPPORTED_MODEL_DTYPES:\n+        raise ValueError(\n+            f\"The FlashInfer attention backend does not support model dtype \"\n+            f\"{model_dtype}; its kernels are compiled for float16 and bfloat16 \"\n+            f'only. Run with --dtype float16 or bfloat16 (\"auto\" downcasts '\n+            f\"float32 checkpoints to float16), or pick an attention backend \"\n+            f\"with float32 support, e.g. --attention-backend torch_native.\"\n+        )\n+\n+\n class FlashInferAttnBackend(AttentionBackend):\n     \"\"\"Flashinfer attention kernels.\"\"\"\n \n@@ -307,6 +323,7 @@ def __init__(\n         init_new_workspace: bool = False,\n     ):\n         super().__init__()\n+        _validate_model_dtype(model_runner.dtype)\n         self.prefill_backend = \"fa2\"\n         self.decode_backend = \"fa2\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/73f6ddafd032bf6611fea0d886ff55ba09f617a9/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fflashinfer_backend.py",
      "sha": "26cdd368223cbf8088285b7ea6585abff77045d5",
      "status": "modified"
    },
    {
      "additions": 47,
      "blob_url": "https://github.com/sgl-project/sglang/blob/73f6ddafd032bf6611fea0d886ff55ba09f617a9/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_flashinfer_model_dtype_gate.py",
      "changes": 47,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_flashinfer_model_dtype_gate.py?ref=73f6ddafd032bf6611fea0d886ff55ba09f617a9",
      "deletions": 0,
      "filename": "test/registered/unit/layers/attention/test_flashinfer_model_dtype_gate.py",
      "patch": "@@ -0,0 +1,47 @@\n+import unittest\n+from unittest.mock import MagicMock\n+\n+import torch\n+\n+from sglang.srt.layers.attention.flashinfer_backend import (\n+    FlashInferAttnBackend,\n+    _validate_model_dtype,\n+)\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestFlashInferModelDtypeGate(CustomTestCase):\n+    \"\"\"--dtype float32 is accepted by the argument parser, but FlashInfer has\n+    no fp32 attention kernel, so the engine used to die with a bare KeyError\n+    from the JIT dispatch table during CUDA-graph capture. The backend now\n+    rejects the dtype at construction with an actionable message.\"\"\"\n+\n+    def test_supported_dtypes_pass(self):\n+        for dtype in (torch.float16, torch.bfloat16):\n+            with self.subTest(dtype=dtype):\n+                _validate_model_dtype(dtype)\n+\n+    def test_float32_rejected_with_guidance(self):\n+        for dtype in (torch.float32, torch.float):\n+            with self.subTest(dtype=dtype):\n+                with self.assertRaises(ValueError) as ctx:\n+                    _validate_model_dtype(dtype)\n+                message = str(ctx.exception)\n+                self.assertIn(\"float16\", message)\n+                self.assertIn(\"bfloat16\", message)\n+                self.assertIn(\"torch_native\", message)\n+\n+    def test_backend_init_gates_before_any_state(self):\n+        # A bare runner mock carries no pools/config; reaching anything past\n+        # the dtype gate would raise AttributeError instead of ValueError.\n+        runner = MagicMock(dtype=torch.float32)\n+        with self.assertRaises(ValueError) as ctx:\n+            FlashInferAttnBackend(runner)\n+        self.assertIn(\"float32\", str(ctx.exception))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/73f6ddafd032bf6611fea0d886ff55ba09f617a9/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_flashinfer_model_dtype_gate.py",
      "sha": "884b60978e30a5a1bc2c902c062d243e6ab814c5",
      "status": "added"
    }
