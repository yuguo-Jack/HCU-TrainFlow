      "additions": 51,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8af794831998522fe4c1ba49998074beea596894/docs%2Fsrc%2Fsnippets%2Fconfigs%2Fzai-org%2Fglm-5.2.jsx",
      "changes": 51,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fsrc%2Fsnippets%2Fconfigs%2Fzai-org%2Fglm-5.2.jsx?ref=8af794831998522fe4c1ba49998074beea596894",
      "deletions": 0,
      "filename": "docs/src/snippets/configs/zai-org/glm-5.2.jsx",
      "patch": "@@ -23,6 +23,7 @@ export const config = {\n     { id: \"low-latency\",    label: \"Low-Latency\"    },\r\n     { id: \"balanced\",       label: \"Balanced\"       },\r\n     { id: \"high-throughput\", label: \"High-Throughput\" },\r\n+    { id: \"agentic\",        label: \"Agentic (MTP + HiCache)\" },\r\n   ],\r\n   nodesOptions: [\r\n     { id: \"single\",  label: \"Single Node\" },\r\n@@ -189,6 +190,16 @@ sgl-eval run aime25 \\\\\n                   \"--speculative-eagle-topk 1\", \"--speculative-num-draft-tokens 2\"],\r\n           disable: { hw: [\"mi355x\", \"mi325x\", \"mi300x\"] },\r\n           disableReason: \"MTP/EAGLE speculative decoding is not yet validated on AMD ROCm (MI300X/MI325X/MI355X): the gfx950 spec-decode draft kernel is not yet validated and at --speculative-num-steps > 3 hits a separate build issue; the DSA nextn draft path is CUDA-only.\" },\r\n+        { id: \"mtp-415\", label: \"EAGLE / MTP 4-1-5 (agentic · B300 FP8)\",\r\n+          flags: [\"--speculative-algorithm EAGLE\", \"--speculative-num-steps 4\",\r\n+                  \"--speculative-eagle-topk 1\", \"--speculative-num-draft-tokens 5\"],\r\n+          enable: { hw: [\"b300\"], quant: [\"fp8\"] },\r\n+          enableReason: \"InferenceX AgentX B300 FP8 depth for concurrency 4 and 16.\" },\r\n+        { id: \"mtp-617\", label: \"EAGLE / MTP 6-1-7 (agentic · B300 FP8)\",\r\n+          flags: [\"--speculative-algorithm EAGLE\", \"--speculative-num-steps 6\",\r\n+                  \"--speculative-eagle-topk 1\", \"--speculative-num-draft-tokens 7\"],\r\n+          enable: { hw: [\"b300\"], quant: [\"fp8\"] },\r\n+          enableReason: \"InferenceX AgentX B300 FP8 depth for concurrency 1.\" },\r\n         { id: \"mtp-314\", label: \"EAGLE / MTP 3-1-4 (agentic · MI355X MXFP4)\",\r\n           flags: [\"--speculative-algorithm EAGLE\", \"--speculative-num-steps 3\",\r\n                   \"--speculative-eagle-topk 1\", \"--speculative-num-draft-tokens 4\"],\r\n@@ -485,6 +496,46 @@ sgl-eval run aime25 \\\\\n       ],\r\n     },\r\n \r\n+    // B300 + FP8 agentic (InferenceX AgentX): TP8 EAGLE/MTP with a 270 GB/rank HiCache\r\n+    // host-DRAM pool. Per concurrency: c1 6-1-7 --max-running-requests 2; c4 4-1-5 mrr 3;\r\n+    // c12 5-1-6 mrr 5; c16 4-1-5 mrr 7 plus --prefill-decode-interval 8 and write_through.\r\n+    // c8 and c20-c28 keep the default 3-1-4 depth with uncapped admission (mrr 2x concurrency:\r\n+    // c8 16, c20 40, c24 48, c28 56). Pick the depth in the Speculative Decoding card;\r\n+    // cuda-graph-max-bs is 2x concurrency.\r\n+    {\r\n+      match: { hw: \"b300\", variant: \"default\", quant: \"fp8\", strategy: \"agentic\", nodes: \"single\" },\r\n+      verified: false,\r\n+      env: [],\r\n+      flags: [\r\n+        \"--trust-remote-code\",\r\n+        \"--model-path {{MODEL_NAME}}\",\r\n+        \"--tp 8\",\r\n+        \"--quantization fp8\",\r\n+        \"--kv-cache-dtype fp8_e4m3\",\r\n+        \"--bf16-gemm-backend cutedsl\",\r\n+        \"--tool-call-parser glm47\",\r\n+        \"--reasoning-parser glm45\",\r\n+        \"--speculative-algorithm EAGLE\",\r\n+        \"--speculative-num-steps 5\",\r\n+        \"--speculative-eagle-topk 1\",\r\n+        \"--speculative-num-draft-tokens 6\",\r\n+        \"--max-prefill-tokens 8192\",\r\n+        \"--chunked-prefill-size 8192\",\r\n+        \"--mem-fraction-static 0.85\",\r\n+        \"--max-running-requests 5\",\r\n+        \"--cuda-graph-max-bs 24\",\r\n+        \"--enable-hierarchical-cache\",\r\n+        \"--hicache-size 270\",\r\n+        \"--hicache-write-policy write_back\",\r\n+        \"--hicache-io-backend direct\",\r\n+        \"--hicache-mem-layout page_first_direct\",\r\n+        \"--watchdog-timeout 1800\",\r\n+        \"--enable-metrics\",\r\n+        \"--host {{HOST_IP}}\",\r\n+        \"--port {{PORT}}\",\r\n+      ],\r\n+    },\r\n+\r\n     // ====================================================================\r\n     // B300 + BF16 (Blackwell Ultra, 8-GPU single node) — TP8. Verified on 8xB300 (v0.5.13.post1).\r\n     // The unquantized GLM-5.2 (~700B, ~1.51 TB) only fits single-node on 8xB300\r",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8af794831998522fe4c1ba49998074beea596894/docs%2Fsrc%2Fsnippets%2Fconfigs%2Fzai-org%2Fglm-5.2.jsx",
      "sha": "5229b1767591d25488049d7631c45786303a2566",
