      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmanagers%2Fgpu_worker.py?ref=51d5cb61e7804b4d173206a68a778779880c74bc",
      "deletions": 1,
      "filename": "python/sglang/multimodal_gen/runtime/managers/gpu_worker.py",
      "patch": "@@ -189,7 +189,9 @@ def _bind_worker_to_gpu_numa_node(\n         numa_bind_to_node,\n     )\n \n-    numa_node = get_numa_node_if_available(server_args, local_rank)\n+    # Pods without SYS_NICE cannot set memory policy; CPU affinity alone still\n+    # removes the cross-socket drift (FLUX.1 TP2 on GB300: spread 26-60% -> 6-8%).\n+    numa_node = get_numa_node_if_available(server_args, local_rank, cpu_only_ok=True)\n     if numa_node is not None:\n         numa_bind_to_node(numa_node)\n         logger.info(\"GPU %d worker bound to NUMA node %d\", local_rank, numa_node)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/51d5cb61e7804b4d173206a68a778779880c74bc/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmanagers%2Fgpu_worker.py",
      "sha": "8185017273f676ee316419bddcce561b7a26ce6c",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/51d5cb61e7804b4d173206a68a778779880c74bc/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_gpu_worker_cpu_threads.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_gpu_worker_cpu_threads.py?ref=51d5cb61e7804b4d173206a68a778779880c74bc",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_gpu_worker_cpu_threads.py",
      "patch": "@@ -66,6 +66,28 @@ def test_auto_detection_queries_the_worker_gpu(self):\n         self.assertEqual(node, 1)\n         bind.assert_called_once_with(1)\n \n+    def test_cpu_affinity_still_binds_without_mempolicy(self):\n+        with (\n+            patch.dict(\"os.environ\", {\"SGLANG_AUTO_NUMA_BIND\": \"1\"}),\n+            patch(\"sglang.srt.utils.numa_utils._is_cuda\", True),\n+            patch(\"os.path.isdir\", return_value=True),\n+            patch(\"sglang.srt.utils.numa_utils._can_set_mempolicy\", return_value=False),\n+            patch(\n+                \"sglang.srt.utils.numa_utils.shutil.which\",\n+                return_value=\"/usr/bin/numactl\",\n+            ),\n+            patch(\n+                \"sglang.srt.utils.numa_utils._query_numa_node_for_gpu\",\n+                return_value=[1],\n+            ),\n+            patch(\"sglang.srt.utils.numa_utils.numa_bind_to_node\") as bind,\n+        ):\n+            node = _bind_worker_to_gpu_numa_node(\n+                SimpleNamespace(numa_node=None), local_rank=1\n+            )\n+        self.assertEqual(node, 1)\n+        bind.assert_called_once_with(1)\n+\n     def test_disabled_auto_bind_leaves_worker_unbound(self):\n         with (\n             patch.dict(\"os.environ\", {\"SGLANG_AUTO_NUMA_BIND\": \"0\"}),",
      "raw_url": "https://github.com/sgl-project/sglang/raw/51d5cb61e7804b4d173206a68a778779880c74bc/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_gpu_worker_cpu_threads.py",
      "sha": "976f4892164b3460ad04db1789cae97933a26e78",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/sgl-project/sglang/blob/51d5cb61e7804b4d173206a68a778779880c74bc/python%2Fsglang%2Fsrt%2Futils%2Fnuma_utils.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fnuma_utils.py?ref=51d5cb61e7804b4d173206a68a778779880c74bc",
      "deletions": 4,
      "filename": "python/sglang/srt/utils/numa_utils.py",
      "patch": "@@ -122,14 +122,18 @@ def _get_nvml_device_index(device_id: int) -> int:\n     return get_nvml_device_index(device_id)\n \n \n-def get_numa_node_if_available(server_args: ServerArgs, gpu_id: int) -> Optional[int]:\n+def get_numa_node_if_available(\n+    server_args: ServerArgs, gpu_id: int, cpu_only_ok: bool = False\n+) -> Optional[int]:\n     \"\"\"\n     Returns the NUMA node for the given GPU id. If it is not set in the server_args, it will try to query the NUMA node for the GPU.\n     If the NUMA node is not available, has already been configured externally, or the user lacks permission to set NUMA affinity, it will return None.\n \n     Args:\n         server_args: The server arguments.\n         gpu_id: The GPU id.\n+        cpu_only_ok: Also return the node when NUMA memory policy is not\n+            permitted, so the caller can still bind CPUs (no privilege needed).\n \n     Returns:\n         The NUMA node for the given GPU id or None if it is not available.\n@@ -138,7 +142,7 @@ def get_numa_node_if_available(server_args: ServerArgs, gpu_id: int) -> Optional\n         return server_args.numa_node[gpu_id]\n     if not envs.SGLANG_AUTO_NUMA_BIND.get():\n         return None\n-    if _is_numa_available():\n+    if _is_numa_available(require_mempolicy=not cpu_only_ok):\n         queried_numa_node = _query_numa_node_for_gpu(gpu_id)\n         if len(queried_numa_node) == 0:\n             return None\n@@ -183,7 +187,10 @@ def numa_bind_to_node(node: int):\n         os.sched_setaffinity(0, target_cpus)\n     else:\n         libnuma.numa_run_on_node(ctypes.c_int(node))\n-    libnuma.numa_set_preferred(ctypes.c_int(node))\n+    # Without memory-policy permission, CPU affinity alone keeps first-touch\n+    # allocations on the node.\n+    if _can_set_mempolicy():\n+        libnuma.numa_set_preferred(ctypes.c_int(node))\n \n \n class _Bitmask(ctypes.Structure):\n@@ -359,9 +366,11 @@ def _can_set_mempolicy() -> bool:\n         return False\n \n \n-def _is_numa_available() -> bool:\n+def _is_numa_available(require_mempolicy: bool = True) -> bool:\n     \"\"\"\n     Check if NUMA is available and not already configured externally.\n+    ``require_mempolicy=False`` accepts a host where only CPU affinity can be set\n+    (a container without SYS_NICE).\n     \"\"\"\n     if not (_is_cuda or _is_xpu):\n         return False\n@@ -377,6 +386,12 @@ def _is_numa_available() -> bool:\n         return False\n \n     if not _can_set_mempolicy():\n+        if not require_mempolicy:\n+            logger.info(\n+                \"User lacks permission to set NUMA memory policy; binding CPUs only. \"\n+                \"If using docker, --cap-add SYS_NICE also binds host memory.\"\n+            )\n+            return True\n         logger.warning(\n             \"User lacks permission to set NUMA affinity, skipping NUMA node configuration for GPU. If using docker, try adding --cap-add SYS_NICE to your docker run command.\"\n         )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/51d5cb61e7804b4d173206a68a778779880c74bc/python%2Fsglang%2Fsrt%2Futils%2Fnuma_utils.py",
      "sha": "51814ec86291d5a378e4b10d29623079523633c1",
      "status": "modified"
    },
    {
      "additions": 37,
      "blob_url": "https://github.com/sgl-project/sglang/blob/51d5cb61e7804b4d173206a68a778779880c74bc/test%2Fregistered%2Futils%2Ftest_numa_utils.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Futils%2Ftest_numa_utils.py?ref=51d5cb61e7804b4d173206a68a778779880c74bc",
      "deletions": 0,
      "filename": "test/registered/utils/test_numa_utils.py",
      "patch": "@@ -57,6 +57,42 @@ def test_returns_false_when_mempolicy_not_permitted(\n     ):\n         self.assertFalse(_is_numa_available())\n \n+    @patch(\"sglang.srt.utils.numa_utils._can_set_mempolicy\", return_value=False)\n+    @patch(\"sglang.srt.utils.numa_utils.shutil.which\", return_value=\"/usr/bin/numactl\")\n+    @patch(\"sglang.srt.utils.numa_utils._is_cuda\", True)\n+    @patch(\"os.path.isdir\", return_value=True)\n+    def test_cpu_only_accepted_when_mempolicy_not_permitted(\n+        self, _mock_isdir, _mock_which, _mock_mempolicy\n+    ):\n+        self.assertTrue(_is_numa_available(require_mempolicy=False))\n+\n+\n+class TestNumaBindWithoutMempolicy(unittest.TestCase):\n+    \"\"\"A container without SYS_NICE can set CPU affinity but not memory policy.\"\"\"\n+\n+    def _bind(self, mempolicy_ok: bool) -> MagicMock:\n+        libnuma = MagicMock()\n+        libnuma.numa_available.return_value = 0\n+        with (\n+            patch(\"sglang.srt.utils.numa_utils.get_libnuma\", return_value=libnuma),\n+            patch(\"sglang.srt.utils.numa_utils._node_cpus\", return_value={0, 1}),\n+            patch(\"os.sched_getaffinity\", return_value={0, 1, 2, 3}),\n+            patch(\"os.sched_setaffinity\") as setaffinity,\n+            patch(\n+                \"sglang.srt.utils.numa_utils._can_set_mempolicy\",\n+                return_value=mempolicy_ok,\n+            ),\n+        ):\n+            numa_bind_to_node(0)\n+        setaffinity.assert_called_once_with(0, {0, 1})\n+        return libnuma\n+\n+    def test_cpus_bound_and_memory_policy_skipped(self):\n+        self._bind(mempolicy_ok=False).numa_set_preferred.assert_not_called()\n+\n+    def test_memory_policy_set_when_permitted(self):\n+        self._bind(mempolicy_ok=True).numa_set_preferred.assert_called_once()\n+\n \n # Pin _is_xpu=False so these cases still reach the mocked pynvml on a real XPU\n # host, where _query_numa_node_for_gpu short-circuits into the XPU sysfs branch.\n@@ 