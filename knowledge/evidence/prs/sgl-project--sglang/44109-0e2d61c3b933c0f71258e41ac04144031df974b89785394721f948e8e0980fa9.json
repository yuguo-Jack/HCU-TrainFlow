      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fprotocol.py?ref=7cbf38d91bad62dc09cbef7536b1a716eec49316",
      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/openai/protocol.py",
      "patch": "@@ -742,6 +742,18 @@ class ChatCompletionMessageGenericParam(BaseModel):\n     tool_calls: Optional[List[ToolCall]] = Field(default=None, examples=[None])\n     tools: Optional[List[Tool]] = Field(default=None, examples=[None])\n \n+    @model_validator(mode=\"before\")\n+    @classmethod\n+    def _accept_reasoning_alias(cls, data):\n+        # vLLM accepts prior thinking as `reasoning`; keep it for the chat template.\n+        if (\n+            isinstance(data, dict)\n+            and data.get(\"reasoning_content\") is None\n+            and isinstance(data.get(\"reasoning\"), str)\n+        ):\n+            data = {**data, \"reasoning_content\": data[\"reasoning\"]}\n+        return data\n+\n     @field_validator(\"role\", mode=\"before\")\n     @classmethod\n     def _normalize_role(cls, v):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7cbf38d91bad62dc09cbef7536b1a716eec49316/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fprotocol.py",
      "sha": "5b9829cae4af7692e36bb5f018a2037087e62015",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/7cbf38d91bad62dc09cbef7536b1a716eec49316/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py?ref=7cbf38d91bad62dc09cbef7536b1a716eec49316",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/openai/test_serving_chat.py",
      "patch": "@@ -4688,6 +4688,28 @@ def test_missing_reasoning_history_still_rejected(self):\n                 ):\n                     self.chat._apply_jinja_template(request, None, False)\n \n+    def test_reasoning_history_accepts_vllm_field_name(self):\n+        self._use_preserved_reasoning_template()\n+        request = ChatCompletionRequest(\n+            model=\"x\",\n+            messages=[\n+                *self.basic_req.messages,\n+                {\"role\": \"assistant\", \"content\": \"Hello\", \"reasoning\": \"alias\"},\n+                {\n+                    \"role\": \"assistant\",\n+                    \"content\": \"Hello\",\n+                    \"reasoning\": \"alias\",\n+                    \"reasoning_content\": \"native\",\n+                },\n+                *self.basic_req.messages,\n+            ],\n+        )\n+        self.chat._apply_jinja_template(request, None, False)\n+        self.assertEqual(\n+            self.tm.tokenizer.encode.call_args.args[0],\n+            \"<think>alias</think><think>native</think>\",\n+        )\n+\n     def test_non_stream_reasoning_response_preserves_payload_whitespace(self):\n         self.chat.reasoning_parser = \"qwen3\"\n         self.template_manager.force_reasoning = False",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7cbf38d91bad62dc09cbef7536b1a716eec49316/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py",
