      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Faiter_backend.py?ref=a4bff5b446ccfe26392b4b9e7815181b146d9122",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/attention/aiter_backend.py",
      "patch": "@@ -205,6 +205,14 @@ def __init__(\n             (max_bs + 1,), dtype=torch.int64, device=model_runner.device\n         )\n         self._kv_indices_scratch: Optional[torch.Tensor] = None\n+        # Constant fp32 1.0 descale reused by the fp8 MLA prefill kernel: with\n+        # BF16 absorb the real scales are folded into the weights, so q/k/v\n+        # descale are all 1.0. Cache it once here to avoid a per-call\n+        # torch.ones((), ...) allocation + FillFunctor launch on the attention\n+        # critical path.\n+        self._one_scale = torch.ones(\n+            (), dtype=torch.float32, device=model_runner.device\n+        )\n \n         # Create prefill indices updater\n         if not skip_prefill:\n@@ -789,7 +797,7 @@ def mla_fp8_prefill_attn(\n             k = k.to(fp8_dtype)\n         if v.dtype != fp8_dtype:\n             v = v.to(fp8_dtype)\n-        one_scale = torch.ones((), dtype=torch.float32, device=q.device)\n+        one_scale = self._one_scale\n \n         tile_q = 256\n         reduce_indptr = self.forward_metadata.reduce_indptr",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a4bff5b446ccfe26392b4b9e7815181b146d9122/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Faiter_backend.py",
