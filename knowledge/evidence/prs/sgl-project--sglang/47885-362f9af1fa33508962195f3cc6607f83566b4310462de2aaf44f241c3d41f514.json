      "changes": 28,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Flayers%2Fattention%2Flayer.py?ref=4ef665036f505ad8d05700de40c5a3716fc15590",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/runtime/layers/attention/layer.py",
      "patch": "@@ -802,6 +802,34 @@ def forward(\n                 \"is_causal\": False,\n                 \"scale\": self.softmax_scale,\n             }\n+            # Experimental, opt-in NPU path for binary additive masks.\n+            # Keep SDPA for non-sentinel values and fully masked rows.\n+            # Do not cache this decision on a mutable tensor.\n+            if (\n+                os.environ.get(\"SGLANG_EXPERIMENTAL_NPU_FIA_MASKED_ATTENTION\") == \"1\"\n+                and q_.device.type == \"npu\"\n+                and mask.ndim == 4\n+                and torch.is_floating_point(mask)\n+                and hasattr(torch.ops.npu, \"npu_fused_infer_attention_score\")\n+            ):\n+                threshold = torch.finfo(mask.dtype).min / 2\n+                allowed = mask == 0\n+                blocked = mask <= threshold\n+                if bool(torch.all(allowed | blocked)) and bool(\n+                    torch.all(torch.any(allowed, dim=-1))\n+                ):\n+                    output, _ = torch.ops.npu.npu_fused_infer_attention_score(\n+                        q_,\n+                        k_,\n+                        v_,\n+                        atten_mask=blocked,\n+                        num_heads=q_.shape[1],\n+                        num_key_value_heads=k_.shape[1],\n+                        scale=self.softmax_scale,\n+                        input_layout=\"BNSD\",\n+                    )\n+                    return output.transpose(1, 2)\n+\n             with sdpa_context:\n                 return torch.nn.functional.scaled_dot_product_attention(\n                     q_,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4ef665036f505ad8d05700de40c5a3716fc15590/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Flayers%2Fattention%2Flayer.py",
