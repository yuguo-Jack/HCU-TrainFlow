      "deletions": 1,
      "filename": "python/sglang/srt/model_executor/runner/prefill_cuda_graph_runner.py",
      "patch": "@@ -300,6 +300,7 @@ class PrefillCudaGraphRunner(BaseCudaGraphRunner):\n \n     _use_draft_input_embeds = False\n     _fa4_prefill = False\n+    _body_drops_deepstack = False\n     _backend_can_run_prefill_cuda_graph = None\n     # The backend's batch-dependent check, judged from a ScheduleBatch for the DP vote.\n     _backend_vote_prefill_cuda_graph = None\n@@ -683,6 +684,12 @@ def __init__(self, model_runner: ModelRunner):\n                 ),\n                 None,\n             )\n+            # The body graph binds only input_embeds, so replaying a media\n+            # batch would drop the deepstack features its vision encoder adds.\n+            self._body_drops_deepstack = (\n+                \"input_deepstack_embeds\" in params\n+                and getattr(self.model_runner.model, \"num_deepstack_embeddings\", 0) > 0\n+            )\n \n         # --- aiter chip info pre-warming (AMD) -------------------------\n         maybe_pre_warm_aiter_chip_info()\n@@ -1318,7 +1325,9 @@ def can_replay_locally(\n         rank-uniform; forward-time-only checking cannot split the group).\n         \"\"\"\n         if contains_mm_inputs and (\n-            self._qwen_bcg_hc_sidechannel or self._qwen_bcg_mtp_draft\n+            self._qwen_bcg_hc_sidechannel\n+            or self._qwen_bcg_mtp_draft\n+            or self._body_drops_deepstack\n         ):\n             return False\n         # Full replay bypasses forward_extend's Python image-mask guard.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d1e588f4c254294d47e9a946334304935bbc3c60/python%2Fsglang%2Fsrt%2Fmodel_executor%2Frunner%2Fprefill_cuda_graph_runner.py",
      "sha": "06d75a0e695397ef22ba0524816a251a7c1508c1",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/d1e588f4c254294d47e9a946334304935bbc3c60/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_prefill_cuda_graph_runner.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_prefill_cuda_graph_runner.py?ref=d1e588f4c254294d47e9a946334304935bbc3c60",
      "deletions": 8,
      "filename": "test/registered/unit/model_executor/test_prefill_cuda_graph_runner.py",
      "patch": "@@ -628,6 +628,7 @@ def test_fa4_multimodal_batch_cannot_replay_text_only_full_graph(self):\n \n         Both the DP vote and forward-time gate reject multimodal batches;\n         image batches are rejected before image_token_ranges is installed.\n+        Media batches also fall back when the body graph drops deepstack.\n         \"\"\"\n         runner = PrefillCudaGraphRunner.__new__(PrefillCudaGraphRunner)\n         runner._capture_req_slots = 4\n@@ -657,22 +658,29 @@ def test_fa4_multimodal_batch_cannot_replay_text_only_full_graph(self):\n         )\n         audio = MultimodalInputs(mm_items=[MultimodalDataItem(modality=Modality.AUDIO)])\n         video = MultimodalInputs(mm_items=[MultimodalDataItem(modality=Modality.VIDEO)])\n-        for backend, fa4 in (\n-            (Backend.FULL, True),\n-            (Backend.FULL, False),\n-            (Backend.BREAKABLE, True),\n-            (Backend.TC_PIECEWISE, True),\n+        for backend, fa4, drops_deepstack in (\n+            (Backend.FULL, True, False),\n+            (Backend.FULL, False, False),\n+            (Backend.BREAKABLE, True, False),\n+            (Backend.TC_PIECEWISE, True, False),\n+            (Backend.BREAKABLE, False, True),\n         ):\n             runner.prefill_backend_name = backend\n             runner._is_full_backend = backend == Backend.FULL\n             runner._fa4_prefill = fa4\n+            runner._body_drops_deepstack = drops_deepstack\n             # Text -> mixed text/image -> text also checks that the fallback\n             # is per batch, not a permanent disabling of captured graphs.\n             for mm_inputs in (None, [None, image], [None, audio], [None, video], None):\n-                with self.subTest(backend=backend, fa4=fa4, mm_inputs=mm_inputs):\n+                with self.subTest(\n+                    backend=backend,\n+                    fa4=fa4,\n+                    drops_deepstack=drops_deepstack,\n+                    mm_inputs=mm_inputs,\n+                ):\n                     batch.mm_inputs = mm_inputs\n-                    expected = not (\n-                        backend == Backend.FULL and fa4 and mm_inputs is not None\n+                    expected = mm_inputs is None or not (\n+                        drops_deepstack or (backend == Backend.FULL and fa4)\n                     )\n                     self.assertEqual(runner.can_run_graph(batch), expected)\n                     schedule_batch = SimpleNamespace(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d1e588f4c254294d47e9a946334304935bbc3c60/test%2Fregistered%2Funit%2Fmodel_executor%2Ftest_prefill_cuda_graph_runner.py",
