      "deletions": 2,
      "filename": "python/sglang/multimodal_gen/runtime/distributed/group_coordinator.py",
      "patch": "@@ -371,11 +371,13 @@ def all_reduce(\n         # Bypass the function if we are using only 1 GPU.\n         if self.world_size == 1:\n             return input_\n+        # ReduceOp is compared by identity: Dynamo before torch 2.14 cannot trace\n+        # RedOpType.__eq__ and graph-breaks the compiled all-reduce on it.\n         elif (\n             torch.compiler.is_compiling()\n             and self.srt_custom_allreduce is not None\n             and not async_op\n-            and op == torch.distributed.ReduceOp.SUM\n+            and op is torch.distributed.ReduceOp.SUM\n             and not input_.is_cpu\n         ):\n             return diffusion_all_reduce(input_, group_name=self.unique_name)\n@@ -384,7 +386,7 @@ def all_reduce(\n             if (\n                 not async_op\n                 and custom_ar is not None\n-                and op == torch.distributed.ReduceOp.SUM\n+                and op is torch.distributed.ReduceOp.SUM\n                 and not input_.is_cpu\n                 and not custom_ar.disabled\n                 and custom_ar.should_custom_ar(input_)",
