      "deletions": 2,
      "filename": "python/sglang/srt/layers/cp/interleave.py",
      "patch": "@@ -112,8 +112,7 @@ def _interleave_shard(self, input_: Any) -> Any:\n         cp_size = self.cp_size\n         cp_rank = self.cp_rank\n         if isinstance(input_, (tuple, list)):\n-            indices = range(cp_rank, len(input_), cp_size)\n-            return input_[indices]\n+            return input_[cp_rank::cp_size]\n \n         tokens = len(input_)\n         if tokens % cp_size != 0:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/50eef04b59855dd44c8fd6e77577e0276e7b32f4/python%2Fsglang%2Fsrt%2Flayers%2Fcp%2Finterleave.py",
