      "deletions": 0,
      "filename": "python/sglang/srt/managers/tp_worker.py",
      "patch": "@@ -293,6 +293,7 @@ def __init__(\n         draft_attention_backend: Optional[str] = None,\n         random_seed: Optional[int] = None,\n         load_group: LoadGroup = _DEFAULT_LOAD_GROUP,\n+        tokenizer=None,\n     ):\n         # Parse args\n         self.server_args = server_args\n@@ -326,6 +327,9 @@ def __init__(\n             # A draft worker's tokenizer would only duplicate the target's:\n             # tokenizer_path always points at the target model.\n             self.tokenizer = self.processor = None\n+        elif tokenizer is not None:\n+            self.tokenizer = tokenizer\n+            self.processor = None\n         else:\n             if self.model_config.is_multimodal:\n                 self.processor = get_processor(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c12383aa0556f3feb646fc88acecb9449289f9e2/python%2Fsglang%2Fsrt%2Fmanagers%2Ftp_worker.py",
