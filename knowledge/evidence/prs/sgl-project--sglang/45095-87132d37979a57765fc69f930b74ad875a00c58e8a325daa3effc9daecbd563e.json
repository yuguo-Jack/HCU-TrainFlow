    {
      "additions": 34,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c12383aa0556f3feb646fc88acecb9449289f9e2/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Ftokenizer.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Ftokenizer.py?ref=c12383aa0556f3feb646fc88acecb9449289f9e2",
      "deletions": 3,
      "filename": "python/sglang/srt/utils/hf_transformers/tokenizer.py",
      "patch": "@@ -19,6 +19,7 @@\n from pathlib import Path\n from typing import Optional, Union\n \n+import msgspec\n from transformers import (\n     AutoTokenizer,\n     PreTrainedTokenizer,\n@@ -263,6 +264,38 @@ def _resolve_tokenizers_backend(tokenizer_name, *args, **common_kwargs):\n # ---------------------------------------------------------------------------\n \n \n+class _TokenizerComponents(msgspec.Struct):\n+    pre_tokenizer: msgspec.Raw = msgspec.Raw(b\"null\")\n+    decoder: msgspec.Raw = msgspec.Raw(b\"null\")\n+\n+\n+def _load_tokenizer_components(tokenizer_file):\n+    from tokenizers import Tokenizer as RawTokenizer\n+\n+    # Skip the vocabulary and merges: only these two components are needed by\n+    # the v5 compatibility fix. Let tokenizers deserialize its own component\n+    # formats, including nested sequences, using a tiny placeholder model.\n+    components = msgspec.json.decode(\n+        Path(tokenizer_file).read_bytes(), type=_TokenizerComponents\n+    )\n+    state = msgspec.json.encode(\n+        {\n+            \"version\": \"1.0\",\n+            \"pre_tokenizer\": components.pre_tokenizer,\n+            \"decoder\": components.decoder,\n+            \"model\": {\"type\": \"WordLevel\", \"vocab\": {}, \"unk_token\": \"[UNK]\"},\n+        }\n+    ).decode()\n+    try:\n+        return RawTokenizer.from_str(state)\n+    except Exception as exc:\n+        # The Rust binding reports malformed component state as a plain Python\n+        # Exception. Normalize it for the best-effort compatibility fix below.\n+        raise ValueError(\n+            f\"Invalid tokenizer components in {tokenizer_file}: {exc}\"\n+        ) from exc\n+\n+\n def _fix_v5_tokenizer_components(tokenizer, model_name_or_path, revision=None):\n     \"\"\"Fix pre_tokenizer/decoder when a v5 tokenizer class overwrites them.\n \n@@ -280,12 +313,10 @@ def _fix_v5_tokenizer_components(tokenizer, model_name_or_path, revision=None):\n         return\n \n     try:\n-        from tokenizers import Tokenizer as RawTokenizer\n-\n         tok_file = _resolve_local_or_cached_file(\n             model_name_or_path, \"tokenizer.json\", revision\n         )\n-        raw = RawTokenizer.from_file(tok_file)\n+        raw = _load_tokenizer_components(tok_file)\n     except FileNotFoundError:\n         return\n     except (OSError, ValueError, RuntimeError) as e:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c12383aa0556f3feb646fc88acecb9449289f9e2/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Ftokenizer.py",
      "sha": "6ebfd2e9e509ebe53786ef82cabe9f94dee95921",
      "status": "modified"
    },
    {
      "additions": 79,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c12383aa0556f3feb646fc88acecb9449289f9e2/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py",
      "changes": 80,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py?ref=c12383aa0556f3feb646fc88acecb9449289f9e2",
      "deletions": 1,
      "filename": "test/registered/unit/utils/test_hf_transformers.py",
      "patch": "@@ -6,14 +6,17 @@\n \n import inspect\n import io\n+import json\n import tempfile\n import unittest\n+from pathlib import Path\n from types import SimpleNamespace\n from unittest.mock import MagicMock, patch\n \n import numpy as np\n import torch\n from PIL import Image\n+from tokenizers import Tokenizer, decoders, models, pre_tokenizers\n from transformers import PretrainedConfig\n from transformers.image_processing_backends import PilBackend\n from transformers.image_processing_utils import BaseImageProcessor\n@@ -33,14 +36,89 @@\n     resolve_hf_gguf_reference,\n )\n from sglang.srt.utils.hf_transformers.config import _apply_gemma4_attention_overrides\n-from sglang.srt.utils.hf_transformers.tokenizer import _fix_special_tokens_pattern\n+from sglang.srt.utils.hf_transformers.tokenizer import (\n+    _fix_special_tokens_pattern,\n+    _fix_v5_tokenizer_components,\n+    _load_tokenizer_components,\n+)\n from sglang.srt.utils.hf_transformers_patches import normalize_rope_scaling_compat\n from sglang.test.ci.ci_register import register_cpu_ci\n from sglang.test.test_utils import CustomTestCase\n \n register_cpu_ci(est_time=7, suite=\"base-a-test-cpu\")\n \n \n+class TestTokenizerComponents(CustomTestCase):\n+    def test_component_fix_preserves_model_and_restores_nested_components(self):\n+        \"\"\"Repair v5's replacement components without rebuilding the vocabulary.\"\"\"\n+        original = Tokenizer(\n+            models.WordLevel({\"[UNK]\": 0, \"hello\": 1}, unk_token=\"[UNK]\")\n+        )\n+        original.pre_tokenizer = pre_tokenizers.Sequence(\n+            [\n+                pre_tokenizers.WhitespaceSplit(),\n+                pre_tokenizers.ByteLevel(add_prefix_space=False),\n+            ]\n+        )\n+        original.decoder = decoders.Sequence([decoders.ByteLevel()])\n+        with tempfile.TemporaryDirectory() as directory:\n+            path = Path(directory) / \"tokenizer.json\"\n+            original.save(str(path))\n+            loaded = Tokenizer.from_file(str(path))\n+            loaded.pre_tokenizer = pre_tokenizers.Whitespace()\n+            loaded.decoder = decoders.WordPiece()\n+            wrapper = SimpleNamespace(_tokenizer=loaded)\n+            _fix_v5_tokenizer_components(wrapper, directory)\n+            self.assertEqual(loaded.get_vocab(), original.get_vocab())\n+            self.assertEqual(\n+                loaded.encode(\"hello hello\").ids, original.encode(\"hello hello\").ids\n+            )\n+            self.assertEqual(loaded.decode([1, 1]), original.decode([1, 1]))\n+            self.assertEqual(\n+                loaded.pre_tokenizer.__getstate__(),\n+                original.pre_tokenizer.__getstate__(),\n+            )\n+            self.assertEqual(\n+                loaded.decoder.__getstate__(), original.decoder.__getstate__()\n+            )\n+\n+            # Same-class components intentionally keep the loader's settings,\n+            # matching the existing compatibility policy.\n+            loaded.decoder = decoders.WordPiece(prefix=\"##\")\n+            before = loaded.decoder.__getstate__()\n+            _fix_v5_tokenizer_components(wrapper, directory)\n+            self.assertEqual(loaded.decoder.__getstate__(), before)\n+\n+            data = json.loads(path.read_text())\n+            data[\"model\"] = {\"type\": \"ModelNotNeededForComponentLoading\"}\n+            path.write_text(json.dumps(data))\n+            components = _load_tokenizer_components(path)\n+            self.assertEqual(\n+                components.pre_tokenizer.__getstate__(),\n+                original.pre_tokenizer.__getstate__(),\n+            )\n+\n+    def test_absent_and_invalid_components_leave_loaded_tokenizer_usable(self):\n+        backend = Tokenizer(\n+            models.WordLevel({\"[UNK]\": 0, \"hello\": 1}, unk_token=\"[UNK]\")\n+        )\n+        backend.pre_tokenizer = pre_tokenizers.Whitespace()\n+        with tempfile.TemporaryDirectory() as directory:\n+            path = Path(directory) / \"tokenizer.json\"\n+            for contents in (\n+                \"{}\",\n+                '{\"pre_tokenizer\": null}',\n+                '{\"pre_tokenizer\": {\"type\": \"invalid\"}}',\n+                '{\"pre_tokenizer\":',\n+            ):\n+                with self.subTest(contents=contents):\n+                    path.write_text(contents)\n+                    _fix_v5_tokenizer_components(\n+                        SimpleNamespace(_tokenizer=backend), directory\n+                    )\n+                    self.assertEqual(backend.encode(\"hello hello\").ids, [1, 1])\n+\n+\n # ---------------------------------------------------------------------------\n # get_processor\n # ---------------------------------------------------------------------------",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c12383aa0556f3feb646fc88acecb9449289f9e2/test%2Fregistered%2Funit%2Futils%2Ftest_hf_transformers.py",
