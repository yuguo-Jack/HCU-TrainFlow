      "blob_url": "https://github.com/sgl-project/sglang/blob/79221609db3d177524e8362cc070b4a5c2661807/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py?ref=79221609db3d177524e8362cc070b4a5c2661807",
      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/openai/serving_chat.py",
      "patch": "@@ -1626,6 +1626,14 @@ def _apply_jinja_template(\n                 messages, request\n             )\n \n+            # `tools` is already gated on tool_choice != \"none\" upstream, so\n+            # request tools are omitted here; the encoders also render\n+            # message-level tool schemas, which must be stripped when tool\n+            # calls cannot be parsed.\n+            if request.tool_choice == \"none\":\n+                for msg in messages:\n+                    msg.pop(\"tools\", None)\n+\n             request_tools = request.tools if tools else None\n \n             # An empty system message hosts the request tools; dsv41 renders a",
      "raw_url": "https://github.com/sgl-project/sglang/raw/79221609db3d177524e8362cc070b4a5c2661807/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py",
      "sha": "26d4f44552806e04420847d5cc155e91b886eb7f",
      "status": "modified"
    },
    {
      "additions": 39,
      "blob_url": "https://github.com/sgl-project/sglang/blob/79221609db3d177524e8362cc070b4a5c2661807/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py?ref=79221609db3d177524e8362cc070b4a5c2661807",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/openai/test_serving_chat.py",
      "patch": "@@ -1572,6 +1572,45 @@ def test_dsv_tool_choice_none_omits_tools_from_prompt(self):\n                     prompt = self.tm.tokenizer.encode.call_args.args[0]\n                     self.assertEqual(\"calculator\" in prompt, expects_tools)\n \n+    def test_dsv_tool_choice_none_omits_message_level_tools_from_prompt(self):\n+        self.template_manager.chat_template_name = None\n+        self.template_manager.jinja_template_content_format = \"string\"\n+        self.chat._dsv4_reasoning_effort_profile = \"preview\"\n+        tool = {\n+            \"type\": \"function\",\n+            \"function\": {\n+                \"name\": \"calculator\",\n+                \"parameters\": {\"type\": \"object\"},\n+            },\n+        }\n+\n+        for chat_encoding_spec in (\"dsv4\", \"dsv32\", \"dsv41\"):\n+            with self.subTest(chat_encoding_spec=chat_encoding_spec):\n+                self.chat.chat_encoding_spec = chat_encoding_spec\n+                self.tm.tokenizer.encode.reset_mock()\n+                request = ChatCompletionRequest(\n+                    model=\"x\",\n+                    messages=[\n+                        {\n+                            \"role\": \"developer\",\n+                            \"content\": \"Follow the request.\",\n+                            \"tools\": [tool],\n+                        },\n+                        {\"role\": \"user\", \"content\": \"Solve 100 / 7.\"},\n+                    ],\n+                    tool_choice=\"none\",\n+                )\n+\n+                self.chat._process_messages(request, is_multimodal=False)\n+\n+                prompt = self.tm.tokenizer.encode.call_args.args[0]\n+                self.assertNotIn(\"## Tools\", prompt)\n+                self.assertNotIn(\"calculator\", prompt)\n+                # The strip happens on a copy; the wire request is untouched.\n+                self.assertEqual(\n+                    request.messages[0].tools[0].function.name, \"calculator\"\n+                )\n+\n     def test_kimi_k3_encoder_receives_wire_request_fields(self):\n         self.template_manager.chat_template_name = None\n         self.chat.chat_encoding_spec = \"kimi_k3\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/79221609db3d177524e8362cc070b4a5c2661807/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py",
