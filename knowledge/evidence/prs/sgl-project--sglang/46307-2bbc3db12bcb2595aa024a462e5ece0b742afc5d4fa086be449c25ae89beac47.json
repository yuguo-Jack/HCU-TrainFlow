      "deletions": 0,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -5727,6 +5727,10 @@ def _record_scheduler_state_for_paused_engine(self) -> None:\n             self.metrics_reporter.record_scheduler_idle()\n         else:\n             self.metrics_reporter.record_scheduler_active(time.monotonic_ns())\n+        if self.idle_sleeper is not None:\n+            self.maybe_sleep_on_idle()\n+        else:\n+            time.sleep(0.005)\n \n     def is_fully_idle(self, for_health_check=False, ignore_waiting=False) -> bool:\n         # Health check piggybacks on running requests in process_output.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6b9b4c91f5607f2df0c77e9096c8d006b91b080d/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
