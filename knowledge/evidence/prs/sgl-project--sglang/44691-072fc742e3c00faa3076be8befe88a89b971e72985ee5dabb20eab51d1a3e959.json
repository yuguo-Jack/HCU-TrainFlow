      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/7f6b43f09ef2819cc67e52e186dd45d5ac644685/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v4_platform_stage.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v4_platform_stage.py?ref=7f6b43f09ef2819cc67e52e186dd45d5ac644685",
      "deletions": 1,
      "filename": "python/sglang/srt/models/deepseek_v4_platform_stage.py",
      "patch": "@@ -113,7 +113,9 @@ def bind_next(self, next_layer):\n             return\n         self._next_layer = None\n         if isinstance(next_layer, NonCudaDecoderMixin) and next_layer.engram is None:\n-            self._next_layer = next_layer\n+            # A plain reference, not a submodule: registering it renames the next layer's\n+            # parameters to `layers.{i}._next_layer.*`, which later weight loads miss.\n+            object.__setattr__(self, \"_next_layer\", next_layer)\n \n     def refresh_mhc_norm_weight_cache(self):\n         super().refresh_mhc_norm_weight_cache()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7f6b43f09ef2819cc67e52e186dd45d5ac644685/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v4_platform_stage.py",
      "sha": "5d4971de8e21be82ec99a314268971956335d7e8",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/sgl-project/sglang/blob/7f6b43f09ef2819cc67e52e186dd45d5ac644685/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_v4_platform_dispatch.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_v4_platform_dispatch.py?ref=7f6b43f09ef2819cc67e52e186dd45d5ac644685",
      "deletions": 0,
      "filename": "test/registered/unit/models/test_deepseek_v4_platform_dispatch.py",
      "patch": "@@ -246,5 +246,29 @@ def test_non_cuda_partial_attention_cannot_fuse_mhc(self):\n             self.assertFalse(layer._can_fuse_attn_mhc)\n \n \n+class _LinkedLayer(platform_stage.NonCudaDecoderMixin, torch.nn.Module):\n+    def __init__(self):\n+        super().__init__()\n+        self.hc_pre_from_prev_sublayer = True\n+        self.engram = None\n+        self.weight = torch.nn.Parameter(torch.zeros(1))\n+\n+\n+class TestBindNext(unittest.TestCase):\n+    def test_linked_layers_keep_their_own_parameter_names(self):\n+        \"\"\"A layer linked to its successor must not adopt it as a submodule,\n+        or weight updates after the first load miss layers 1 and up.\"\"\"\n+        layers = torch.nn.ModuleList(_LinkedLayer() for _ in range(3))\n+        for _ in range(2):  # post_load_weights relinks after every load\n+            for i, layer in enumerate(layers):\n+                layer.bind_next(layers[i + 1] if i + 1 < len(layers) else None)\n+\n+        self.assertEqual(\n+            [name for name, _ in layers.named_parameters()],\n+            [\"0.weight\", \"1.weight\", \"2.weight\"],\n+        )\n+        self.assertIs(layers[0]._next_layer, layers[1])\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7f6b43f09ef2819cc67e52e186dd45d5ac644685/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_v4_platform_dispatch.py",
      "sha": "7d0e5627e629222608676c2f35bbb1ae792fd9d4",
      "status": "modified"
    }
