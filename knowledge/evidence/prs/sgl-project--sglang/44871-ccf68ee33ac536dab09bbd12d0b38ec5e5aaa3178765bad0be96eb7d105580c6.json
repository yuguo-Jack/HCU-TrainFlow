      "blob_url": "https://github.com/sgl-project/sglang/blob/dac66ab6ddf1d27c48218aa3ee4fdbdf291f336a/python%2Fsglang%2Fsrt%2Futils%2Frequest_logger.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Frequest_logger.py?ref=dac66ab6ddf1d27c48218aa3ee4fdbdf291f336a",
      "deletions": 4,
      "filename": "python/sglang/srt/utils/request_logger.py",
      "patch": "@@ -238,6 +238,16 @@ def _log(self, msg: str) -> None:\n             target.info(msg)\n \n \n+def _sequence_to_string_truncated(data: Union[List, Tuple], max_length: int) -> str:\n+    data = redact_watermark_secrets(data)\n+    if all(isinstance(v, (int, float, bool, type(None))) for v in data):\n+        return str(data)\n+    items = \", \".join(_dataclass_to_string_truncated(v, max_length) for v in data)\n+    if isinstance(data, tuple):\n+        return f\"({items},)\" if len(data) == 1 else f\"({items})\"\n+    return f\"[{items}]\"\n+\n+\n # TODO unify this w/ `_transform_data_for_logging` if we find performance enough\n def _dataclass_to_string_truncated(\n     data: Any, max_length: int = 2048, skip_names: Optional[Set[str]] = None\n@@ -254,12 +264,12 @@ def _dataclass_to_string_truncated(\n         if len(data) > max_length:\n             half_length = max_length // 2\n             return (\n-                str(redact_watermark_secrets(data[:half_length]))\n+                _sequence_to_string_truncated(data[:half_length], max_length)\n                 + \" ... \"\n-                + str(redact_watermark_secrets(data[-half_length:]))\n+                + _sequence_to_string_truncated(data[-half_length:], max_length)\n             )\n         else:\n-            return str(redact_watermark_secrets(data))\n+            return _sequence_to_string_truncated(data, max_length)\n     elif isinstance(data, dict):\n         data = redact_watermark_secrets(data)\n         return (\n@@ -302,7 +312,7 @@ def _transform_data_for_logging(\n     elif isinstance(data, (list, tuple)):\n         if len(data) > max_length:\n             half_length = max_length // 2\n-            return list(data[:half_length]) + [\"...\"] + list(data[-half_length:])\n+            data = list(data[:half_length]) + [\"...\"] + list(data[-half_length:])\n         return [_transform_data_for_logging(v, max_length) for v in data]\n     elif isinstance(data, dict):\n         data = redact_watermark_secrets(data)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/dac66ab6ddf1d27c48218aa3ee4fdbdf291f336a/python%2Fsglang%2Fsrt%2Futils%2Frequest_logger.py",
      "sha": "bd15e08e02023a30222f932c79786eb87a10aafe",
      "status": "modified"
    },
    {
      "additions": 51,
      "blob_url": "https://github.com/sgl-project/sglang/blob/dac66ab6ddf1d27c48218aa3ee4fdbdf291f336a/test%2Fregistered%2Funit%2Futils%2Ftest_request_logger_truncation.py",
      "changes": 51,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Futils%2Ftest_request_logger_truncation.py?ref=dac66ab6ddf1d27c48218aa3ee4fdbdf291f336a",
      "deletions": 0,
      "filename": "test/registered/unit/utils/test_request_logger_truncation.py",
      "patch": "@@ -0,0 +1,51 @@\n+import json\n+import unittest\n+\n+from sglang.srt.utils.request_logger import (\n+    _dataclass_to_string_truncated,\n+    _transform_data_for_logging,\n+)\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+MAX_LENGTH = 8\n+BIG = \"x\" * 10_000\n+\n+\n+class TestRequestLoggerListTruncation(CustomTestCase):\n+    def test_json_elided_list_truncates_elements(self):\n+        out = _transform_data_for_logging([BIG] * (MAX_LENGTH + 1), MAX_LENGTH)\n+\n+        self.assertEqual(len(out), MAX_LENGTH + 1)\n+        self.assertEqual(out[MAX_LENGTH // 2], \"...\")\n+        self.assertLess(len(json.dumps(out)), 1000)\n+\n+    def test_json_short_list_truncates_elements(self):\n+        out = _transform_data_for_logging([BIG] * MAX_LENGTH, MAX_LENGTH)\n+\n+        self.assertLess(len(json.dumps(out)), 1000)\n+\n+    def test_text_list_truncates_elements(self):\n+        for data in ([BIG] * MAX_LENGTH, [BIG] * (MAX_LENGTH + 1)):\n+            with self.subTest(length=len(data)):\n+                out = _dataclass_to_string_truncated(data, MAX_LENGTH)\n+\n+                self.assertLess(len(out), 1000)\n+\n+    def test_text_list_keeps_scalar_and_tuple_format(self):\n+        self.assertEqual(\n+            _dataclass_to_string_truncated([1, 2, 3], MAX_LENGTH), \"[1, 2, 3]\"\n+        )\n+        self.assertEqual(\n+            _dataclass_to_string_truncated(list(range(10)), MAX_LENGTH),\n+            \"[0, 1, 2, 3] ... [6, 7, 8, 9]\",\n+        )\n+        self.assertEqual(\n+            _dataclass_to_string_truncated((\"a\", \"b\"), MAX_LENGTH), \"('a', 'b')\"\n+        )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/dac66ab6ddf1d27c48218aa3ee4fdbdf291f336a/test%2Fregistered%2Funit%2Futils%2Ftest_request_logger_truncation.py",
