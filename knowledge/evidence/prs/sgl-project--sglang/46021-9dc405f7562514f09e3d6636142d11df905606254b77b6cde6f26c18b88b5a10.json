      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_diffusion_import_isolation.py?ref=be00be302e68c8fc5c0a38d416865c21d63e5c4e",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_diffusion_import_isolation.py",
      "patch": "@@ -3,6 +3,7 @@\n import os\n import subprocess\n import sys\n+import textwrap\n import unittest\n \n from sglang.test.test_utils import CustomTestCase\n@@ -61,6 +62,37 @@ def test_disabled_backend_does_not_import_mlx(self):\n             msg=f\"stdout={completed.stdout}\\nstderr={completed.stderr}\",\n         )\n \n+    def test_flux2_imports_without_intel_triton(self):\n+        # Importing flux_2 must not need Intel Triton; a subprocess keeps the\n+        # blocked import from leaking into this interpreter.\n+        script = textwrap.dedent(\n+            \"\"\"\n+            import importlib.abc\n+            import sys\n+\n+            import triton\n+            import triton.language  # import triton fully first, as CUDA would\n+\n+            class Blocker(importlib.abc.MetaPathFinder):\n+                def find_spec(self, name, path=None, target=None):\n+                    if name.startswith(\"triton.language.extra.intel\"):\n+                        raise ImportError(name)\n+                    return None\n+\n+            for mod in [m for m in sys.modules if \"extra.intel\" in m]:\n+                del sys.modules[mod]\n+            if hasattr(triton.language.extra, \"intel\"):\n+                del triton.language.extra.intel\n+            sys.meta_path.insert(0, Blocker())\n+\n+            import sglang.multimodal_gen.runtime.models.dits.flux_2  # noqa: F401\n+            \"\"\"\n+        )\n+        result = subprocess.run(\n+            [sys.executable, \"-c\", script], capture_output=True, text=True\n+        )\n+        self.assertEqual(result.returncode, 0, result.stderr[-2000:])\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/be00be302e68c8fc5c0a38d416865c21d63e5c4e/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_diffusion_import_isolation.py",
      "sha": "0219a91c84057d76ea00a4bbbe86dc7035038f96",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/be00be302e68c8fc5c0a38d416865c21d63e5c4e/test%2Fregistered%2Fkernels%2Fops%2Fdiffusion%2Ftest_flux2_xpu_norm_fusions.py",
      "changes": 45,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fdiffusion%2Ftest_flux2_xpu_norm_fusions.py?ref=be00be302e68c8fc5c0a38d416865c21d63e5c4e",
      "deletions": 43,
      "filename": "test/registered/kernels/ops/diffusion/test_flux2_xpu_norm_fusions.py",
      "patch": "@@ -1,12 +1,5 @@\n-\"\"\"FLUX.2 XPU LayerNorm+modulate and gated residual norm fast paths.\n+\"\"\"FLUX.2 XPU LayerNorm+modulate and gated residual norm fast paths.\"\"\"\n \n-The fusion cases need an Intel XPU; the Intel-Triton import regression runs\n-on any device, so the file is also registered on the CPU suite.\n-\"\"\"\n-\n-import subprocess\n-import sys\n-import textwrap\n import unittest\n from unittest.mock import patch\n \n@@ -21,10 +14,9 @@\n     xpu_gated_resnorm,\n     xpu_layernorm_modulate,\n )\n-from sglang.test.ci.ci_register import register_cpu_ci, register_xpu_ci\n+from sglang.test.ci.ci_register import register_xpu_ci\n from sglang.test.test_utils import CustomTestCase\n \n-register_cpu_ci(est_time=30, suite=\"base-a-test-cpu\")\n register_xpu_ci(est_time=30, suite=\"stage-b-test-1-gpu-xpu\")\n \n _HIDDEN = 6144\n@@ -51,39 +43,6 @@ def _inputs(rows: int, magnitude: float, seed: int, batch: int = 1):\n _CASES = ((512, 1.0, 0, 1), (17, 30.0, 1, 1), (64, 0.05, 2, 1), (64, 1.0, 3, 2))\n \n \n-class TestFlux2ImportWithoutIntelTriton(CustomTestCase):\n-    def test_flux2_imports_without_intel_triton(self):\n-        # Importing flux_2 must not need Intel Triton; a subprocess keeps the\n-        # blocked import from leaking into this interpreter.\n-        script = textwrap.dedent(\n-            \"\"\"\n-            import importlib.abc\n-            import sys\n-\n-            import triton\n-            import triton.language  # import triton fully first, as CUDA would\n-\n-            class Blocker(importlib.abc.MetaPathFinder):\n-                def find_spec(self, name, path=None, target=None):\n-                    if name.startswith(\"triton.language.extra.intel\"):\n-                        raise ImportError(name)\n-                    return None\n-\n-            for mod in [m for m in sys.modules if \"extra.intel\" in m]:\n-                del sys.modules[mod]\n-            if hasattr(triton.language.extra, \"intel\"):\n-                del triton.language.extra.intel\n-            sys.meta_path.insert(0, Blocker())\n-\n-            import sglang.multimodal_gen.runtime.models.dits.flux_2  # noqa: F401\n-            \"\"\"\n-        )\n-        result = subprocess.run(\n-            [sys.executable, \"-c\", script], capture_output=True, text=True\n-        )\n-        self.assertEqual(result.returncode, 0, result.stderr[-2000:])\n-\n-\n @unittest.skipUnless(_has_xpu(), \"requires an Intel XPU\")\n class TestFlux2XpuNormFusions(CustomTestCase):\n     def setUp(self):",
