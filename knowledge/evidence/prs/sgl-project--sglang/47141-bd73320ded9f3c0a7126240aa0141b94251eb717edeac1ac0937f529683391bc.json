      "changes": 13,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Ftokenizer.py?ref=556827ea88b7e1aacb917df69ade9fe3dc425d06",
      "deletions": 3,
      "filename": "python/sglang/srt/utils/hf_transformers/tokenizer.py",
      "patch": "@@ -510,6 +510,13 @@ def get_tokenizer(\n \n     tokenizer_name = _resolve_tokenizer_name(tokenizer_name, kwargs)\n \n+    # Callers that pin the model with get_tokenizer(..., revision=<sha>) put\n+    # the pin in kwargs. tokenizer_revision stays None unless it was passed\n+    # explicitly, and the post-load fixes must use the same pin.\n+    pinned_revision = (\n+        tokenizer_revision if tokenizer_revision is not None else kwargs.get(\"revision\")\n+    )\n+\n     common_kwargs = dict(\n         trust_remote_code=trust_remote_code,\n         tokenizer_revision=tokenizer_revision,\n@@ -518,7 +525,7 @@ def get_tokenizer(\n     )\n \n     try:\n-        if is_bare_tekken_checkpoint(tokenizer_name, tokenizer_revision):\n+        if is_bare_tekken_checkpoint(tokenizer_name, pinned_revision):\n             from transformers.tokenization_mistral_common import (\n                 MistralCommonTokenizer,\n             )\n@@ -532,7 +539,7 @@ def get_tokenizer(\n             )\n \n             tokenizer = MistralCommonTokenizer.from_pretrained(\n-                tokenizer_name, revision=tokenizer_revision\n+                tokenizer_name, revision=pinned_revision\n             )\n         else:\n             tokenizer = _auto_tokenizer_from_pretrained(\n@@ -550,7 +557,7 @@ def get_tokenizer(\n                     tokenizer_name, *args, **common_kwargs\n                 )\n \n-        return _apply_post_load_fixes(tokenizer, tokenizer_name, tokenizer_revision)\n+        return _apply_post_load_fixes(tokenizer, tokenizer_name, pinned_revision)\n     except Exception as e:\n         if tokenizer_backend == \"fastokens\":\n             raise RuntimeError(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/556827ea88b7e1aacb917df69ade9fe3dc425d06/python%2Fsglang%2Fsrt%2Futils%2Fhf_transformers%2Ftokenizer.py",
      "sha": "94b3aae7e8ac327c6e66937bdbd58bdc80aafd2c",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/sgl-project/sglang/blob/556827ea88b7e1aacb917df69ade9fe3dc425d06/test%2Fregistered%2Funit%2Ftokenizer%2Ftest_post_load_revision.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ftokenizer%2Ftest_post_load_revision.py?ref=556827ea88b7e1aacb917df69ade9fe3dc425d06",
      "deletions": 0,
      "filename": "test/registered/unit/tokenizer/test_post_load_revision.py",
      "patch": "@@ -0,0 +1,44 @@\n+import unittest\n+from unittest.mock import patch\n+\n+from sglang.srt.utils.hf_transformers.tokenizer import get_tokenizer\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestTokenizerPostLoadRevision(CustomTestCase):\n+    def _load(self, **kwargs):\n+        sentinel = object()\n+        with (\n+            patch(\n+                \"sglang.srt.utils.hf_transformers.tokenizer.is_bare_tekken_checkpoint\",\n+                return_value=False,\n+            ),\n+            patch(\n+                \"sglang.srt.utils.hf_transformers.tokenizer._auto_tokenizer_from_pretrained\",\n+                return_value=sentinel,\n+            ),\n+            patch(\n+                \"sglang.srt.utils.hf_transformers.tokenizer._apply_post_load_fixes\",\n+                side_effect=lambda tok, name, rev: tok,\n+            ) as fixes,\n+        ):\n+            got = get_tokenizer(\"org/model\", **kwargs)\n+        return got, sentinel, fixes\n+\n+    def test_revision_kwarg_reaches_post_load_fixes(self):\n+        got, sentinel, fixes = self._load(revision=\"abc123\")\n+        self.assertIs(got, sentinel)\n+        self.assertEqual(fixes.call_args.args[2], \"abc123\")\n+\n+    def test_explicit_tokenizer_revision_wins_over_revision_kwarg(self):\n+        _got, _sentinel, fixes = self._load(\n+            tokenizer_revision=\"pinned-sha\", revision=\"other-sha\"\n+        )\n+        self.assertEqual(fixes.call_args.args[2], \"pinned-sha\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/556827ea88b7e1aacb917df69ade9fe3dc425d06/test%2Fregistered%2Funit%2Ftokenizer%2Ftest_post_load_revision.py",
      "sha": "2c4400d667930b375a239f2a1b4512b94fc3990f",
      "status": "added"
    }
