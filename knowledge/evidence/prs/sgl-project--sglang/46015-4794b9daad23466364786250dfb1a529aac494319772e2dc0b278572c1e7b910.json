      "deletions": 1,
      "filename": ".github/workflows/pr-test-amd.yml",
      "patch": "@@ -634,7 +634,9 @@ jobs:\n       fail-fast: false\n       matrix:\n         rocm_version: ${{ fromJson(needs.check-changes.outputs.rocm_versions) }}\n-        runner: [linux-mi35x-gpu-1]\n+        # The linux-mi35x-gpu-1 pool has only 4 runners and PR runs keep it\n+        # backlogged for hours, so scheduled main runs use the 8-GPU pool.\n+        runner: ${{ fromJson(github.event_name == 'schedule' && '[\"linux-mi35x-gpu-8\"]' || '[\"linux-mi35x-gpu-1\"]') }}\n         part: [0, 1]\n     runs-on: ${{matrix.runner}}\n     steps:",
