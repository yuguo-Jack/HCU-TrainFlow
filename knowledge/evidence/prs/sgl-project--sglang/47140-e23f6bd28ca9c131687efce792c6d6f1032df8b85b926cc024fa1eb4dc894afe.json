      "blob_url": "https://github.com/sgl-project/sglang/blob/4b25986aee2617fdfd6f45bd773c2d8c0bbb0efa/python%2Fsglang%2Fsrt%2Ffunction_call%2Finternlm_detector.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Finternlm_detector.py?ref=4b25986aee2617fdfd6f45bd773c2d8c0bbb0efa",
      "deletions": 1,
      "filename": "python/sglang/srt/function_call/internlm_detector.py",
      "patch": "@@ -158,7 +158,9 @@ def parse_streaming_increment(\n         \"\"\"\n         Streaming incremental parsing for InternLM format.\n \n-        Supports a single tool call in streaming mode.\n+        Supports sequential tool calls. A later ``<|action_start|>`` may\n+        arrive without ``<|plugin|>`` in the same chunk; that prefix has to\n+        stay buffered or the rest of the call is dropped.\n         \"\"\"\n         self._buffer += new_text\n         current_text = self._buffer\n@@ -167,6 +169,10 @@ def parse_streaming_increment(\n         start = current_text.find(self.bot_token)\n         if start == -1:\n             # No tool call marker found\n+            # A split ``<|action_start|> <|plugin|>`` marker is not the full\n+            # bot token yet. Keep it so the next chunk can finish the call.\n+            if self._ends_with_partial_token(current_text, self.bot_token):\n+                return StreamingParseResult()\n             # If we've already processed tool calls, don't return text again\n             if self.current_tool_id > 0:\n                 self._buffer = \"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4b25986aee2617fdfd6f45bd773c2d8c0bbb0efa/python%2Fsglang%2Fsrt%2Ffunction_call%2Finternlm_detector.py",
      "sha": "252d33a94a2d85b902ecc42a3fdeb4f518a071f3",
      "status": "modified"
    },
    {
      "additions": 75,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4b25986aee2617fdfd6f45bd773c2d8c0bbb0efa/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_internlm_streaming_detector.py",
      "changes": 75,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_internlm_streaming_detector.py?ref=4b25986aee2617fdfd6f45bd773c2d8c0bbb0efa",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_internlm_streaming_detector.py",
      "patch": "@@ -0,0 +1,75 @@\n+import json\n+import unittest\n+\n+from sglang.srt.entrypoints.openai.protocol import Function, Tool\n+from sglang.srt.function_call.internlm_detector import InternlmDetector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+def _call(location: str) -> str:\n+    body = json.dumps(\n+        {\"name\": \"get_weather\", \"parameters\": {\"location\": location}},\n+        ensure_ascii=False,\n+    )\n+    return \"<|action_start|> <|plugin|>\\n\" + body + \"<|action_end|>\"\n+\n+\n+def _tools() -> list[Tool]:\n+    return [\n+        Tool(\n+            type=\"function\",\n+            function=Function(\n+                name=\"get_weather\",\n+                parameters={\n+                    \"type\": \"object\",\n+                    \"properties\": {\"location\": {\"type\": \"string\"}},\n+                },\n+            ),\n+        )\n+    ]\n+\n+\n+class TestInternlmStreamingSecondCall(CustomTestCase):\n+    def test_second_call_survives_split_start_marker(self):\n+        text = _call(\"Tokyo\") + _call(\"Paris\")\n+        marker = \"<|action_start|>\"\n+        second = text.find(marker, 1)\n+        chunks = [\n+            text[:second],\n+            text[second : second + len(marker)],\n+            text[second + len(marker) :],\n+        ]\n+        detector = InternlmDetector()\n+        names = []\n+        for chunk in chunks:\n+            result = detector.parse_streaming_increment(chunk, _tools())\n+            for call in result.calls:\n+                if call.name:\n+                    names.append(\n+                        (call.tool_index, call.name, json.loads(call.parameters))\n+                    )\n+        self.assertEqual(\n+            names,\n+            [\n+                (0, \"get_weather\", {\"location\": \"Tokyo\"}),\n+                (1, \"get_weather\", {\"location\": \"Paris\"}),\n+            ],\n+        )\n+\n+    def test_nonstreaming_still_returns_both_calls(self):\n+        text = _call(\"Tokyo\") + _call(\"Paris\")\n+        result = InternlmDetector().detect_and_parse(text, _tools())\n+        self.assertEqual(\n+            [call.name for call in result.calls], [\"get_weather\", \"get_weather\"]\n+        )\n+        self.assertEqual(\n+            [json.loads(call.parameters)[\"location\"] for call in result.calls],\n+            [\"Tokyo\", \"Paris\"],\n+        )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4b25986aee2617fdfd6f45bd773c2d8c0bbb0efa/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_internlm_streaming_detector.py",
