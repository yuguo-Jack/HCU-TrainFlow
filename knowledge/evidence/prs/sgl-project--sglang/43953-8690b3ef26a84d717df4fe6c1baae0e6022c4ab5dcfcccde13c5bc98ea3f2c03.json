  "files": [
    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a5cfff22a31b5875a5dd8db553a01c727f682347/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fserver_args%2Fauto_tune.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fserver_args%2Fauto_tune.py?ref=a5cfff22a31b5875a5dd8db553a01c727f682347",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/runtime/server_args/auto_tune.py",
      "patch": "@@ -690,6 +690,13 @@ def _default_layerwise_components_for_unset_placement(self) -> list[str]:\n         ):\n             # The legacy --dit-layerwise-offload flag is a DiT-only selector.\n             # Do not merge implicit defaults into that explicit mode.\n+            # Still apply the model's prefetch default. Leaving it at 0\n+            # streams one layer at a time and makes Wan 2.2 ~8x slower.\n+            if (\n+                args.dit_layerwise_offload is True\n+                or args.is_dit_layerwise_offload_selected\n+            ):\n+                self._set_default_dit_offload_prefetch_size()\n             return []\n \n         # `*_cpu_offload` is the component placement knob. If a user explicitly",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a5cfff22a31b5875a5dd8db553a01c727f682347/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fserver_args%2Fauto_tune.py",
      "sha": "f2f45f4f38b5e2b6974013d8f93f718daac4389c",
      "status": "modified"
    },
    {
      "additions": 49,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a5cfff22a31b5875a5dd8db553a01c727f682347/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_explicit_dit_offload_prefetch.py",
      "changes": 49,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_explicit_dit_offload_prefetch.py?ref=a5cfff22a31b5875a5dd8db553a01c727f682347",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_explicit_dit_offload_prefetch.py",
      "patch": "@@ -0,0 +1,49 @@\n+# SPDX-License-Identifier: Apache-2.0\n+\"\"\"An explicit DiT layerwise request still receives the model prefetch size.\"\"\"\n+\n+import unittest\n+from types import SimpleNamespace\n+\n+from sglang.multimodal_gen.runtime.server_args.auto_tune import ServerArgsAutoTuner\n+\n+\n+class _Args:\n+    def __init__(self, *, explicit_prefetch=False, performance_mode=\"auto\"):\n+        self.dit_layerwise_offload = True\n+        self.is_dit_layerwise_offload_selected = False\n+        self.performance_mode = performance_mode\n+        self.dit_offload_prefetch_size = 0.0\n+        self.pipeline_config = SimpleNamespace(\n+            task_type=SimpleNamespace(is_action_gen=lambda: False),\n+            get_model_deployment_config=lambda: SimpleNamespace(\n+                auto_dit_offload_prefetch_size=2\n+            ),\n+        )\n+        self._explicit_prefetch = explicit_prefetch\n+\n+    def is_arg_explicitly_set(self, name):\n+        return self._explicit_prefetch and name == \"dit_offload_prefetch_size\"\n+\n+\n+class TestExplicitDitOffloadPrefetch(unittest.TestCase):\n+    def _tuner(self, args):\n+        tuner = ServerArgsAutoTuner.__new__(ServerArgsAutoTuner)\n+        tuner.server_args = args\n+        return tuner\n+\n+    def test_explicit_layerwise_applies_model_prefetch_default(self):\n+        args = _Args()\n+        components = self._tuner(\n+            args\n+        )._default_layerwise_components_for_unset_placement()\n+        self.assertEqual(components, [])\n+        self.assertEqual(args.dit_offload_prefetch_size, 2)\n+\n+    def test_explicit_prefetch_size_is_left_alone(self):\n+        args = _Args(explicit_prefetch=True)\n+        self._tuner(args)._default_layerwise_components_for_unset_placement()\n+        self.assertEqual(args.dit_offload_prefetch_size, 0.0)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a5cfff22a31b5875a5dd8db553a01c727f682347/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_explicit_dit_offload_prefetch.py",
      "sha": "7fc4201dbc3bc43369301b80ddea0ace01fa9c16",
      "status": "added"
    }
  ],
