  "files": [
    {
      "additions": 23,
      "blob_url": "https://github.com/sgl-project/sglang/blob/dada15c9043e14975e407ca1af7d52cfb9ff255f/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmodels%2Fvaes%2Fautoencoder_kl_qwenimage21.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmodels%2Fvaes%2Fautoencoder_kl_qwenimage21.py?ref=dada15c9043e14975e407ca1af7d52cfb9ff255f",
      "deletions": 1,
      "filename": "python/sglang/multimodal_gen/runtime/models/vaes/autoencoder_kl_qwenimage21.py",
      "patch": "@@ -220,7 +220,29 @@ def forward(self, x):\n         qkv = qkv.reshape(batch_size * time, 1, channels * 3, -1)\n         qkv = qkv.permute(0, 1, 3, 2).contiguous()\n         q, k, v = qkv.chunk(3, dim=-1)\n-        x = F.scaled_dot_product_attention(q, k, v)\n+\n+        # Fix for ROCm non-determinism: when head_dim > 256, PyTorch's SDPA math\n+        # backend is not run-to-run deterministic on ROCm 7.2.1 at certain sequence\n+        # lengths (e.g., 4096 tokens for 1024x1024 images). Enable deterministic\n+        # algorithms temporarily around this call to ensure reproducibility.\n+        # See: https://github.com/sgl-project/sglang/issues/47801\n+        needs_deterministic_fix = (\n+            hasattr(torch.version, \"hip\")\n+            and torch.version.hip is not None\n+            and q.shape[-1] > 256\n+        )\n+\n+        if needs_deterministic_fix:\n+            prev_deterministic = torch.are_deterministic_algorithms_enabled()\n+            prev_warn_only = torch.is_deterministic_algorithms_warn_only_enabled()\n+            torch.use_deterministic_algorithms(True, warn_only=True)\n+            try:\n+                x = F.scaled_dot_product_attention(q, k, v)\n+            finally:\n+                torch.use_deterministic_algorithms(prev_deterministic, warn_only=prev_warn_only)\n+        else:\n+            x = F.scaled_dot_product_attention(q, k, v)\n+\n         x = (\n             x.squeeze(1)\n             .permute(0, 2, 1)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/dada15c9043e14975e407ca1af7d52cfb9ff255f/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmodels%2Fvaes%2Fautoencoder_kl_qwenimage21.py",
      "sha": "1527312cee14dfa2bd85d879f48793451502aa92",
      "status": "modified"
    }
