      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/58bf7fd1397f65990e0b51eaee00a4c73695e7a9/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_common%2Fdeepseek_weight_loader.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_common%2Fdeepseek_weight_loader.py?ref=58bf7fd1397f65990e0b51eaee00a4c73695e7a9",
      "deletions": 7,
      "filename": "python/sglang/srt/models/deepseek_common/deepseek_weight_loader.py",
      "patch": "@@ -660,8 +660,12 @@ def post_load_weights(\n                         if hasattr(self_attn.kv_b_proj, \"weight_scale\")\n                         else self_attn.kv_b_proj.weight_scale_inv\n                     )\n+                    # `format_ue8m0` is only stamped by quant methods that requant\n+                    # scales to UE8M0 (e.g. fp8/DeepGEMM). Quant methods like\n+                    # `humming` never stamp it, so read it defensively.\n                     is_ue8m0_uint8 = (\n-                        weight_scale.format_ue8m0 and weight_scale.dtype == torch.uint8\n+                        getattr(weight_scale, \"format_ue8m0\", False)\n+                        and weight_scale.dtype == torch.uint8\n                     )\n                     if _is_fp8_fnuz and not is_ue8m0_uint8:\n                         weight, weight_scale, _ = normalize_e4m3fn_to_e4m3fnuz(\n@@ -677,12 +681,9 @@ def post_load_weights(\n                         weight_scale = (weight_scale.to(torch.int32) << 23).view(\n                             torch.float32\n                         )\n-                    elif (\n-                        should_deepgemm_weight_requant_ue8m0(\n-                            weight_block_size=weight_block_size\n-                        )\n-                        and weight_scale.format_ue8m0\n-                    ):\n+                    elif should_deepgemm_weight_requant_ue8m0(\n+                        weight_block_size=weight_block_size\n+                    ) and getattr(weight_scale, \"format_ue8m0\", False):\n                         weight_scale = inverse_transform_scale_ue8m0(\n                             weight_scale, mn=weight.shape[-2]\n                         )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/58bf7fd1397f65990e0b51eaee00a4c73695e7a9/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_common%2Fdeepseek_weight_loader.py",
      "sha": "5277b94feff909bca99a463825eba7d0618649cb",
      "status": "modified"
    }
