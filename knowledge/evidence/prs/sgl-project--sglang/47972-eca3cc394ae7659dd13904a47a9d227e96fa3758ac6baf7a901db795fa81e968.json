      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0e28e42f11a252c32f62ce1472344a564f97e540/scripts%2Fci%2Famd%2Famd_ci_start_container.sh",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/scripts%2Fci%2Famd%2Famd_ci_start_container.sh?ref=0e28e42f11a252c32f62ce1472344a564f97e540",
      "deletions": 0,
      "filename": "scripts/ci/amd/amd_ci_start_container.sh",
      "patch": "@@ -287,6 +287,21 @@ case \"${ENABLE_CACHE_HOST,,}\" in\n     ;;\n esac\n \n+# Optional HF caching proxy set by the runner (HF_ENDPOINT must be a node IP,\n+# not 127.0.0.1). Fall back to huggingface.co if it doesn't answer.\n+HF_PROXY_ENV=()\n+if [[ -n \"${HF_ENDPOINT:-}\" ]]; then\n+  if curl -sf --max-time 5 -o /dev/null \"${HF_ENDPOINT%/}/healthz\"; then\n+    echo \"Using HF proxy: ${HF_ENDPOINT}\"\n+    HF_PROXY_ENV+=(-e \"HF_ENDPOINT=${HF_ENDPOINT}\")\n+    if [[ -n \"${HF_HUB_DISABLE_XET:-}\" ]]; then\n+      HF_PROXY_ENV+=(-e \"HF_HUB_DISABLE_XET=${HF_HUB_DISABLE_XET}\")\n+    fi\n+  else\n+    echo \"Warning: HF proxy ${HF_ENDPOINT} is not responding; downloading from huggingface.co directly\" >&2\n+  fi\n+fi\n+\n echo \"Launching container: ci_sglang\"\n docker run -dt --user root --device=/dev/kfd ${DEVICE_FLAG} \\\n   --ulimit nofile=65536:65536 \\\n@@ -299,6 +314,7 @@ docker run -dt --user root --device=/dev/kfd ${DEVICE_FLAG} \\\n   -e HF_HOME=/sgl-data/hf-cache \\\n   -e HF_HUB_ETAG_TIMEOUT=300 \\\n   -e HF_HUB_DOWNLOAD_TIMEOUT=300 \\\n+  ${HF_PROXY_ENV[@]+\"${HF_PROXY_ENV[@]}\"} \\\n   -e MIOPEN_USER_DB_PATH=/sgl-data/miopen-cache \\\n   -e MIOPEN_CUSTOM_CACHE_DIR=/sgl-data/miopen-cache \\\n   -e PYTHONPATH=\"/opt/tilelang:${PYTHONPATH:-}\" \\",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0e28e42f11a252c32f62ce1472344a564f97e540/scripts%2Fci%2Famd%2Famd_ci_start_container.sh",
      "sha": "b136c0bb964fc7999984caa8d52076f89bc55716",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0e28e42f11a252c32f62ce1472344a564f97e540/scripts%2Fci%2Famd%2Famd_ci_start_container_disagg.sh",
      "changes": 16,
