      "deletions": 3,
      "filename": "python/sglang/srt/function_call/glm4_moe_detector.py",
      "patch": "@@ -1145,9 +1145,15 @@ def generate_glm_grammar(\n         )\n     )\n \n-    ebnf_lines.append(\n-        f\"text_block ::= ( {extra_seperator} text_without_special_tokens )?\"\n-    )\n+    if required and functions:\n+        # A mandatory call must start within a bounded preamble; otherwise the\n+        # model can produce text until max_tokens while EOS is masked.\n+        # Excluding \"<\" also keeps every GLM special token out of the preamble.\n+        ebnf_lines.append(f\"text_block ::= ( {extra_seperator} [^<]{{0,256}} )?\")\n+    else:\n+        ebnf_lines.append(\n+            f\"text_block ::= ( {extra_seperator} text_without_special_tokens )?\"\n+        )\n \n     if functions:\n         ebnf_lines.extend(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fb7e44808a07452c57b66a0e6071dbee568643d7/python%2Fsglang%2Fsrt%2Ffunction_call%2Fglm4_moe_detector.py",
