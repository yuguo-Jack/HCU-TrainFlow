      "deletions": 0,
      "filename": "python/sglang/srt/mem_cache/memory_pool.py",
      "patch": "@@ -5280,6 +5280,16 @@ def set_mla_kv_buffer(\n                 cache_k_rope_fp4_sf,\n             )\n \n+    def move_kv_cache(self, tgt_loc: torch.Tensor, src_loc: torch.Tensor):\n+        super().move_kv_cache(tgt_loc, src_loc)\n+        if tgt_loc.numel() == 0:\n+            return\n+\n+        tgt_loc_flat = tgt_loc.view(-1).long()\n+        src_loc_flat = src_loc.view(-1).long()\n+        for kv_scale in self.kv_scale_buffer:\n+            kv_scale[tgt_loc_flat] = kv_scale[src_loc_flat]\n+\n \n class DSATokenToKVPool(MLATokenToKVPool):\n     quant_block_size = 128",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fa13d4ac19dc146d578f8f433d0e34e0cae23a19/python%2Fsglang%2Fsrt%2Fmem_cache%2Fmemory_pool.py",
      "sha": "bc662e374fa563abf969151e9f578d567ecfb1bc",
      "status": "modified"
    },
    {
      "additions": 37,
      "blob_url": "https://github.com/sgl-project/sglang/blob/fa13d4ac19dc146d578f8f433d0e34e0cae23a19/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_quantized_kv_pool.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_quantized_kv_pool.py?ref=fa13d4ac19dc146d578f8f433d0e34e0cae23a19",
      "deletions": 0,
      "filename": "test/registered/unit/mem_cache/test_quantized_kv_pool.py",
      "patch": "@@ -119,6 +119,43 @@ def test_quant_method_owns_buffers_and_store_path(self):\n         self.assertEqual(pool.k_buffer[0][loc].unique().tolist(), [1])\n         self.assertEqual(pool.v_buffer[0][loc].unique().tolist(), [2])\n \n+    def test_mla_fp4_move_kv_cache_moves_block_scales_with_data(self):\n+        \"\"\"move_kv_cache carries each slot's block scales with its FP4 data;\n+        stale target scales would dequantize the moved data wrong.\"\"\"\n+        from sglang.srt.mem_cache.memory_pool import MLATokenToKVPoolFP4\n+\n+        pool = MLATokenToKVPoolFP4(\n+            size=6,\n+            page_size=1,\n+            dtype=torch.bfloat16,\n+            kv_lora_rank=16,\n+            qk_rope_head_dim=16,\n+            layer_num=2,\n+            device=\"cpu\",\n+            enable_memory_saver=False,\n+        )\n+        for layer_id, (data, scale) in enumerate(\n+            zip(pool.kv_buffer, pool.kv_scale_buffer)\n+        ):\n+            data.copy_(torch.arange(data.numel()).reshape(data.shape) + 50 * layer_id)\n+            scale.copy_(\n+                torch.arange(scale.numel()).reshape(scale.shape) + 200 + 20 * layer_id\n+            )\n+        src_loc = torch.tensor([5, 6], dtype=torch.int64)\n+        tgt_loc = torch.tensor([1, 2], dtype=torch.int64)\n+        expected = [\n+            (data[src_loc].clone(), scale[src_loc].clone())\n+            for data, scale in zip(pool.kv_buffer, pool.kv_scale_buffer)\n+        ]\n+\n+        pool.move_kv_cache(tgt_loc, src_loc)\n+\n+        for (data, scale), (want_data, want_scale) in zip(\n+            zip(pool.kv_buffer, pool.kv_scale_buffer), expected\n+        ):\n+            self.assertTrue(torch.equal(data[tgt_loc], want_data))\n+            self.assertTrue(torch.equal(scale[tgt_loc], want_scale))\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/fa13d4ac19dc146d578f8f433d0e34e0cae23a19/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_quantized_kv_pool.py",
      "sha": "10945658b99625fe86c4e8c15dfc409211b3e613",
      "status": "modified"
    }
