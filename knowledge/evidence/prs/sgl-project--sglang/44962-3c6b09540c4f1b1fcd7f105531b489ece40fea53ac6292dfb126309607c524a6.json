      "blob_url": "https://github.com/sgl-project/sglang/blob/96190413e45e7f663ba1f3f08fb177d414aa3341/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py?ref=96190413e45e7f663ba1f3f08fb177d414aa3341",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/schedule_batch.py",
      "patch": "@@ -1476,8 +1476,11 @@ def is_prefill_only(self) -> bool:\n     @property\n     def output_ids_through_stop(self) -> array[int]:\n         \"\"\"Get the output ids through the stop condition. Stop position is included.\"\"\"\n+        max_new_tokens = self.sampling_params.max_new_tokens\n         if self.finished_len is not None:\n-            return self.output_ids[: self.finished_len]\n+            return self.output_ids[: min(self.finished_len, max_new_tokens)]\n+        if len(self.output_ids) > max_new_tokens:\n+            return self.output_ids[:max_new_tokens]\n         return self.output_ids\n \n     @property\n@@ -1953,6 +1956,13 @@ def update_finish_state(self, new_accepted_len: int = 1):\n         if self.to_finish:\n             self.finished_reason = self.to_finish\n             self.to_finish = None\n+            if len(self.output_ids) >= self.sampling_params.max_new_tokens:\n+                self.finished_len = self.sampling_params.max_new_tokens\n+            elif (\n+                self.finished_len is not None\n+                and self.finished_len > self.sampling_params.max_new_tokens\n+            ):\n+                self.finished_len = self.sampling_params.max_new_tokens\n             return\n \n         new_accepted_tokens = self.output_ids[-new_accepted_len:]",
      "raw_url": "https://github.com/sgl-project/sglang/raw/96190413e45e7f663ba1f3f08fb177d414aa3341/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "sha": "6282d4e406a39ee6bfbddbc77ccebe8e314f7506",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/96190413e45e7f663ba1f3f08fb177d414aa3341/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Foutput_streamer.py",
      "changes": 8,
