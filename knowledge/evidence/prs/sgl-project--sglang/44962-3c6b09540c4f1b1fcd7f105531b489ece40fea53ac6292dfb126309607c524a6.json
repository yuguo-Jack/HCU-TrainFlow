      "deletions": 1,
      "filename": "python/sglang/srt/managers/scheduler_components/output_streamer.py",
      "patch": "@@ -429,7 +429,13 @@ def accept(self, *, req: Req) -> None:\n             assert not req.finished_output\n             req.finished_output = True\n             if req.finished_len is None:\n-                req.finished_len = len(req.output_ids)\n+                req.finished_len = min(\n+                    len(req.output_ids), req.sampling_params.max_new_tokens\n+                )\n+            else:\n+                req.finished_len = min(\n+                    req.finished_len, req.sampling_params.max_new_tokens\n+                )\n             should_output = True\n         else:\n             if req.stream:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/96190413e45e7f663ba1f3f08fb177d414aa3341/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Foutput_streamer.py",
