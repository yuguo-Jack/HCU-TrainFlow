      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ca823fe4cfb4bba75360416929f74749721b9cb7/python%2Fsglang%2Fkernels%2Fjit%2Fcsrc%2Fkvcacheio%2Fstaged_write_back.cuh",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fjit%2Fcsrc%2Fkvcacheio%2Fstaged_write_back.cuh?ref=ca823fe4cfb4bba75360416929f74749721b9cb7",
      "deletions": 0,
      "filename": "python/sglang/kernels/jit/csrc/kvcacheio/staged_write_back.cuh",
      "patch": "@@ -102,6 +102,21 @@ inline bool try_copy_page_first_pages_batch(\n #if defined(USE_ROCM) || !defined(CUDA_VERSION) || (CUDA_VERSION < 12080)\n   return false;\n #else\n+  // cudaMemcpyBatchAsync writes to raw destination pointers without translating\n+  // host addresses. Registered host memory is only device-accessible at the\n+  // same VA when the device reports it; where it does not (e.g. GPU\n+  // paravirtualization), the batch call faults asynchronously, so take the\n+  // per-page fallback, whose cudaMemcpyAsync does the translation instead.\n+  int can_use_host_pointer = 0;\n+  const cudaError_t attr_err =\n+      cudaDeviceGetAttribute(&can_use_host_pointer, cudaDevAttrCanUseHostPointerForRegisteredMem, device_id);\n+  if (attr_err != cudaSuccess) {\n+    (void)cudaGetLastError();\n+    return false;\n+  }\n+  if (!can_use_host_pointer) {\n+    return false;\n+  }\n   host::RuntimeCheck(src_ptrs.size() == dst_ptrs.size(), \"Source and destination tensors must have the same count\");\n   constexpr size_t kLargeCopyThresholdBytes = 128 * 1024;\n   thread_local std::vector<CudaMemcpyBatchPtr> batch_srcs;",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ca823fe4cfb4bba75360416929f74749721b9cb7/python%2Fsglang%2Fkernels%2Fjit%2Fcsrc%2Fkvcacheio%2Fstaged_write_back.cuh",
      "sha": "3b52c3eccfb4b42dac2732028f0c04de59efc9ab",
      "status": "modified"
    }
  ],
  "inline_comments": [],
  "issue_comments": [
    {
      "body": "Still real on current main (93809202a3): `try_copy_page_first_pages_batch` in `staged_write_back.cuh` gates on CUDA/driver version only and never queries `cudaDevAttrCanUseHostPointerForRegisteredMem`, so on platforms where the attribute is 0 (WSL2 paravirtualization in #40232) the batch D2H still fails asynchronously with a sticky `cudaErrorIllegalAddress`. Three weeks without a review; could a maintainer add the run-ci label and take a look? The fallback is a per-call attribute query inside the helper, so platforms without device-visible host memory just take the per-page path.\n",
      "created_at": "2026-10-12T22:18:17Z",
      "html_url": "https://github.com/sgl-project/sglang/pull/40571#issuecomment-6133645635",
      "id": 6133645635,
