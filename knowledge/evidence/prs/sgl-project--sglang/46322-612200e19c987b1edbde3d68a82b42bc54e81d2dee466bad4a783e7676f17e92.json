      "additions": 27,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9e665a2f56b4158b4b89a8ed732973ac05b21727/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_awq_dequantize_func.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_awq_dequantize_func.py?ref=9e665a2f56b4158b4b89a8ed732973ac05b21727",
      "deletions": 0,
      "filename": "test/registered/unit/models/test_deepseek_awq_dequantize_func.py",
      "patch": "@@ -0,0 +1,27 @@\n+\"\"\"Regression test for the DeepSeek AWQ dequantize helper on CUDA.\"\"\"\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+import unittest\n+from unittest.mock import patch\n+\n+from sglang.srt.models.deepseek_common import utils as deepseek_utils\n+from sglang.test.test_utils import CustomTestCase\n+\n+\n+class TestAwqDequantizeFunc(CustomTestCase):\n+    @patch.object(deepseek_utils, \"_is_npu\", False)\n+    @patch.object(deepseek_utils, \"_is_hip\", False)\n+    @patch.object(deepseek_utils, \"_is_cuda\", True)\n+    def test_cuda_branch_resolves(self):\n+        \"\"\"The CUDA branch returns a dequantize callable; DeepSeek AWQ\n+        checkpoints with a quantized kv_b_proj call it while loading weights.\"\"\"\n+        awq_dequantize = deepseek_utils.awq_dequantize_func()\n+\n+        self.assertTrue(callable(awq_dequantize))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9e665a2f56b4158b4b89a8ed732973ac05b21727/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_awq_dequantize_func.py",
      "sha": "ef21bf3a24198b34f125eb03f0844a216a7973cd",
      "status": "added"
    }
