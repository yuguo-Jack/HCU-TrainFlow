      "blob_url": "https://github.com/sgl-project/sglang/blob/1b119970fce1016e0d7168c489e3cb7895f06a40/python%2Fsglang%2Fsrt%2Fobservability%2Fhttp_request_metrics.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fobservability%2Fhttp_request_metrics.py?ref=1b119970fce1016e0d7168c489e3cb7895f06a40",
      "deletions": 0,
      "filename": "python/sglang/srt/observability/http_request_metrics.py",
      "patch": "@@ -55,6 +55,14 @@ def __init__(self):\n \n _http_request_metrics: Optional[_HttpRequestMetrics] = None\n \n+# Probes and scrapes come from the orchestrator and from Prometheus, not from\n+# clients, so they stay out of the HTTP request metrics: a warming pod answers\n+# /ready with 503, which would read as an error rate, and a scrape every second\n+# adds one request per second to an idle server.\n+HTTP_METRICS_EXCLUDED_PATHS = frozenset(\n+    {\"/health\", \"/health_generate\", \"/ready\", \"/ping\", \"/metrics\"}\n+)\n+\n \n def init_http_request_metrics():\n     # Call after PROMETHEUS_MULTIPROC_DIR is set: prometheus_client picks its\n@@ -81,6 +89,8 @@ async def track_http_status_code(request, call_next):\n         # With recording all requests, we have the risk of high cardinality if requests have arbitrary unhandled paths.\n         # But given that SGLang engines with metrics enabled are usually behind routers this looks safe.\n         path, is_handled_path = _get_fastapi_request_path(request)\n+        if path in HTTP_METRICS_EXCLUDED_PATHS:\n+            return await call_next(request)\n         method = request.method\n         routing_key = request.headers.get(\"x-smg-routing-key\")\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1b119970fce1016e0d7168c489e3cb7895f06a40/python%2Fsglang%2Fsrt%2Fobservability%2Fhttp_request_metrics.py",
      "sha": "cbe4e6b0ebe46be149668164980953ec172bcc43",
      "status": "modified"
    },
    {
      "additions": 47,
      "blob_url": "https://github.com/sgl-project/sglang/blob/1b119970fce1016e0d7168c489e3cb7895f06a40/test%2Fregistered%2Funit%2Fobservability%2Ftest_http_request_metrics.py",
      "changes": 48,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fobservability%2Ftest_http_request_metrics.py?ref=1b119970fce1016e0d7168c489e3cb7895f06a40",
      "deletions": 1,
      "filename": "test/registered/unit/observability/test_http_request_metrics.py",
      "patch": "@@ -3,9 +3,11 @@\n register_cpu_ci(est_time=15, suite=\"base-a-test-cpu\")\n \n import unittest\n+from unittest import mock\n \n+from fastapi import FastAPI, Response\n from fastapi.testclient import TestClient\n-from prometheus_client import REGISTRY\n+from prometheus_client import REGISTRY, make_asgi_app\n \n import sglang.srt.entrypoints.http_server as http_server\n from sglang.srt.observability import http_request_metrics\n@@ -14,6 +16,50 @@\n UNKNOWN_PATH = \"/__no_such_route__\"\n \n \n+class TestHttpMetricsSkipProbes(CustomTestCase):\n+    def test_probes_and_scrapes_are_not_counted(self):\n+        app = FastAPI()\n+\n+        @app.get(\"/ready\")\n+        async def ready():\n+            return Response(status_code=503)  # a pod that is still loading\n+\n+        @app.get(\"/health\")\n+        async def health():\n+            return Response(status_code=200)\n+\n+        @app.post(\"/v1/chat/completions\")\n+        async def chat():\n+            return {\"ok\": True}\n+\n+        app.mount(\"/metrics\", make_asgi_app())\n+        http_request_metrics.add_http_request_metrics_middleware(app)\n+\n+        # A mock keeps this test off the process-wide metrics, which\n+        # TestHttpRequestMetrics expects to be uninitialized.\n+        metrics = mock.MagicMock()\n+        with mock.patch.object(http_request_metrics, \"_http_request_metrics\", metrics):\n+            client = TestClient(app)\n+            self.assertEqual(client.get(\"/ready\").status_code, 503)\n+            client.get(\"/health\")\n+            client.get(\"/metrics\")\n+            client.post(\"/v1/chat/completions\")\n+\n+        for series in (\"requests_total\", \"requests_active\", \"responses_total\"):\n+            endpoints = {\n+                call.kwargs[\"endpoint\"]\n+                for call in getattr(metrics, series).labels.call_args_list\n+            }\n+            self.assertEqual(endpoints, {\"/v1/chat/completions\"}, series)\n+\n+    def test_excluded_paths_are_served_routes(self):\n+        # /metrics is mounted at server startup, not on import.\n+        served = {getattr(route, \"path\", None) for route in http_server.app.routes}\n+        self.assertLessEqual(\n+            http_request_metrics.HTTP_METRICS_EXCLUDED_PATHS - {\"/metrics\"}, served\n+        )\n+\n+\n class TestHttpRequestMetrics(CustomTestCase):\n     def test_module_level_app_records_requests(self):\n         # Tokenizer workers re-import http_server and serve its module-level app,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1b119970fce1016e0d7168c489e3cb7895f06a40/test%2Fregistered%2Funit%2Fobservability%2Ftest_http_request_metrics.py",
