      "changes": 27,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Feplb%2Feplb_algorithms%2Fdeepseek_vec.py?ref=dc530354e52f1a0b098d3b4cf765c773abb20f22",
      "deletions": 16,
      "filename": "python/sglang/srt/eplb/eplb_algorithms/deepseek_vec.py",
      "patch": "@@ -9,27 +9,22 @@ def pack_groups(tokens_per_group: torch.Tensor, num_nodes: int) -> torch.Tensor:\n     assert num_groups % num_nodes == 0\n     groups_per_rank = num_groups // num_nodes\n \n-    indices = tokens_per_group.float().sort(-1, descending=True).indices.cpu()\n-    ret = torch.full_like(\n-        tokens_per_group, fill_value=-1, dtype=torch.int64, device=\"cpu\"\n-    )\n+    indices_list = tokens_per_group.float().sort(-1, descending=True).indices.tolist()\n+    tokens_per_group_list = tokens_per_group.tolist()\n+    ret_list = [[-1] * num_groups for _ in range(num_layers)]\n     for layer in range(num_layers):\n         node_tokens = [0] * num_nodes\n         node_groups = [0] * num_nodes\n-        for group in indices[layer]:\n-\n-            def key_func(rank: int) -> int:\n-                if node_groups[rank] >= groups_per_rank:\n-                    return 1, 0\n-                else:\n-                    return 0, node_tokens[rank]\n-\n-            rank = min(range(num_nodes), key=key_func)\n+        for group in indices_list[layer]:\n+            rank = min(\n+                (r for r in range(num_nodes) if node_groups[r] < groups_per_rank),\n+                key=node_tokens.__getitem__,\n+            )\n             assert node_groups[rank] < groups_per_rank\n-            ret[layer, group] = rank * groups_per_rank + node_groups[rank]\n-            node_tokens[rank] += tokens_per_group[layer, group]\n+            ret_list[layer][group] = rank * groups_per_rank + node_groups[rank]\n+            node_tokens[rank] += tokens_per_group_list[layer][group]\n             node_groups[rank] += 1\n-    return ret\n+    return torch.tensor(ret_list, dtype=torch.int64, device=\"cpu\")\n \n \n def make_redundant_experts_chunkwise(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/dc530354e52f1a0b098d3b4cf765c773abb20f22/python%2Fsglang%2Fsrt%2Feplb%2Feplb_algorithms%2Fdeepseek_vec.py",
      "sha": "90eb4658c9f4f7e2b8c1bc82f6c1a6cab27c6190",
      "status": "modified"
    },
    {
      "additions": 21,
      "blob_url": "https://github.com/sgl-project/sglang/blob/dc530354e52f1a0b098d3b4cf765c773abb20f22/test%2Fregistered%2Funit%2Feplb%2Ftest_balanced_packing.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Feplb%2Ftest_balanced_packing.py?ref=dc530354e52f1a0b098d3b4cf765c773abb20f22",
      "deletions": 0,
      "filename": "test/registered/unit/eplb/test_balanced_packing.py",
      "patch": "@@ -9,6 +9,7 @@\n import torch\n \n from sglang.srt.eplb.eplb_algorithms.deepseek import balanced_packing\n+from sglang.srt.eplb.eplb_algorithms.deepseek_vec import pack_groups\n from sglang.test.test_utils import CustomTestCase\n \n \n@@ -143,5 +144,25 @@ def test_many_layers(self):\n         self._check_unique_slots(pack_index, rank_in_pack, num_packs, groups_per_pack=2)\n \n \n+class TestPackGroups(CustomTestCase):\n+    \"\"\"Tests for pack_groups(tokens_per_group, num_nodes) in deepseek_vec.\"\"\"\n+\n+    def test_slots_unique_and_consistent_with_balanced_packing(self):\n+        torch.manual_seed(0)\n+        for num_layers, num_groups, num_nodes in [(3, 8, 2), (4, 64, 8), (2, 16, 4)]:\n+            groups_per_rank = num_groups // num_nodes\n+            weight = torch.randint(1, 10000, (num_layers, num_groups)).float()\n+            group_perm = pack_groups(weight, num_nodes=num_nodes)\n+            pack_index, rank_in_pack = balanced_packing(weight, num_packs=num_nodes)\n+            expected = pack_index * groups_per_rank + rank_in_pack\n+            self.assertEqual(group_perm.dtype, torch.int64)\n+            self.assertEqual(group_perm.device.type, \"cpu\")\n+            self.assertTrue(torch.equal(group_perm, expected))\n+            for layer in range(num_layers):\n+                self.assertEqual(\n+                    sorted(group_perm[layer].tolist()), list(range(num_groups))\n+                )\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/dc530354e52f1a0b098d3b4cf765c773abb20f22/test%2Fregistered%2Funit%2Feplb%2Ftest_balanced_packing.py",
      "sha": "cd74691fc343c5e4f218d61728a5cd066003b343",
      "status": "modified"
    }
