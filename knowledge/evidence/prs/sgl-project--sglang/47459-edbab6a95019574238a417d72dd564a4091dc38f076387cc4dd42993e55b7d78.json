      "deletions": 0,
      "filename": "test/registered/unit/server_args/test_server_args.py",
      "patch": "@@ -75,6 +75,7 @@\n     handle_data_parallelism,\n )\n from sglang.srt.arg_groups.pd_disaggregation_hook import handle_pd_disaggregation\n+from sglang.srt.arg_groups.platform_hook import handle_xpu_backends\n from sglang.srt.arg_groups.serving_hook import (\n     handle_crash_dump_env,\n     handle_deprecated_args,\n@@ -3360,6 +3361,36 @@ def test_lora_paths_keep_breakable_prefill_graph(self):\n         )\n \n \n+class TestXpuCudaGraphResolution(CustomTestCase):\n+    def test_xpu_tp_greater_than_one_disables_decode_graph(self):\n+        args = ServerArgs(\n+            model_path=\"dummy\",\n+            device=\"xpu\",\n+            tp_size=2,\n+            cuda_graph_backend_decode=\"full\",\n+        )\n+        handle_cuda_graph_config(args)\n+        handle_xpu_backends(args)\n+        self.assertEqual(\n+            resolution_result(args, \"cuda_graph_config\").decode.backend,\n+            Backend.DISABLED,\n+        )\n+\n+    def test_xpu_single_device_keeps_decode_graph(self):\n+        args = ServerArgs(\n+            model_path=\"dummy\",\n+            device=\"xpu\",\n+            tp_size=1,\n+            cuda_graph_backend_decode=\"full\",\n+        )\n+        handle_cuda_graph_config(args)\n+        handle_xpu_backends(args)\n+        self.assertEqual(\n+            resolution_result(args, \"cuda_graph_config\").decode.backend,\n+            Backend.FULL,\n+        )\n+\n+\n class TestBreakableCudaGraphMultimodalAllowlist(CustomTestCase):\n     \"\"\"The BCG \"multimodal model\" rule exempts archs on the BCG multimodal\n     opt-in allowlist (multimodal_breakable_cuda_graph_supported_model_archs).\"\"\"",
