      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx?ref=53cac5882a27ee782684bdf2ffffed78248495a0",
      "deletions": 0,
      "filename": "docs/docs/references/environment_variables.mdx",
      "patch": "@@ -1700,6 +1700,11 @@ SGLang supports various environment variables that can be used to configure its\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Enable deterministic inference (fixed reduction/accumulation order).</td>\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>false</code></td>\n     </tr>\n+    <tr>\n+      <td style={{padding: \"9px 12px\", fontWeight: 500, backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>SGLANG_KDA_FIXED_AUTOTUNE</code></td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Run three KDA prefill kernels (gate cumsum, chunk-local cumsum, chunk output) on one fixed config instead of the one Triton autotunes in each process, so their results do not change between restarts or pipeline ranks. Implied by deterministic inference; set it to get this without the flag, e.g. with an attention backend that deterministic inference refuses. Other autotuned kernels are unchanged.</td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>false</code></td>\n+    </tr>\n     <tr>\n       <td style={{padding: \"9px 12px\", fontWeight: 500, backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>SGLANG_USE_1STAGE_ALLREDUCE</code></td>\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Use the 1-stage all-reduce kernel on AMD (deterministic, fixed accumulation order). If unset, it is auto-enabled when deterministic inference is on.</td>",
      "raw_url": "https://github.com/sgl-project/sglang/raw/53cac5882a27ee782684bdf2ffffed78248495a0/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx",
      "sha": "044a6b62e4649f55b003af99700117d161fddd12",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/53cac5882a27ee782684bdf2ffffed78248495a0/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fcumsum.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fcumsum.py?ref=53cac5882a27ee782684bdf2ffffed78248495a0",
      "deletions": 1,
      "filename": "python/sglang/kernels/ops/attention/fla/cumsum.py",
      "patch": "@@ -9,7 +9,11 @@\n import triton.language as tl\n \n from sglang.kernels.ops.attention.fla.index import prepare_chunk_indices\n-from sglang.kernels.ops.attention.fla.utils import check_shared_mem, input_guard\n+from sglang.kernels.ops.attention.fla.utils import (\n+    check_shared_mem,\n+    deterministic_autotune_prune,\n+    input_guard,\n+)\n \n BS_LIST = [32, 64] if check_shared_mem() else [16, 32]\n \n@@ -77,6 +81,8 @@ def chunk_local_cumsum_scalar_kernel(\n         for num_warps in [2, 4, 8]\n     ],\n     key=[\"B\", \"H\", \"S\", \"BT\", \"IS_VARLEN\", \"REVERSE\", \"HAS_SCALE\"],\n+    # Pinned: the smallest BS, 4 warps.\n+    prune_configs_by={\"early_config_prune\": deterministic_autotune_prune(num_warps=4)},\n )\n @triton.jit(do_not_specialize=[\"T\"])\n def chunk_local_cumsum_vector_kernel(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/53cac5882a27ee782684bdf2ffffed78248495a0/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fcumsum.py",
      "sha": "386c58bbe48d159e8c6058aa62c6ff4e71e8dcae",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/sgl-project/sglang/blob/53cac5882a27ee782684bdf2ffffed78248495a0/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fkda.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fkda.py?ref=53cac5882a27ee782684bdf2ffffed78248495a0",
      "deletions": 0,
      "filename": "python/sglang/kernels/ops/attention/fla/kda.py",
      "patch": "@@ -28,6 +28,7 @@\n from sglang.kernels.ops.attention.fla.utils import (\n     autotune_cache_kwargs,\n     check_shared_mem,\n+    deterministic_autotune_prune,\n     is_intel,\n     is_nvidia,\n )\n@@ -763,6 +764,11 @@ def recompute_w_u_fwd(\n         for num_stages in [2, 3, 4]\n     ],\n     key=[\"BT\", \"IS_VARLEN\"],\n+    prune_configs_by={\n+        \"early_config_prune\": deterministic_autotune_prune(\n+            BK=64, BV=64, num_warps=4, num_stages=2\n+        )\n+    },\n )\n @triton.jit(do_not_specialize=[\"T\"])\n def chunk_gla_fwd_kernel_o(\n@@ -942,6 +948,9 @@ def softplus_fwd(x):\n         for num_warps in [2, 4, 8]\n     ],\n     key=[\"H\", \"S\", \"BT\", \"IS_VARLEN\", \"HAS_BETA\"],\n+    # The tl.cumsum below adds in an order set by BS and num_warps, so the\n+    # configs do not all give the same bits. Pinned: the smallest BS, 4 warps.\n+    prune_configs_by={\"early_config_prune\": deterministic_autotune_prune(num_warps=4)},\n )\n @triton.jit(do_not_specialize=[\"T\"])\n def kda_gate_chunk_cumsum_vector_kernel(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/53cac5882a27ee782684bdf2ffffed78248495a0/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fkda.py",
      "sha": "d100a105414f24c82cf7a26997a7767d837093f7",
      "status": "modified"
    },
    {
      "additions": 28,
      "blob_url": "https://github.com/sgl-project/sglang/blob/53cac5882a27ee782684bdf2ffffed78248495a0/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Futils.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Futils.py?ref=53cac5882a27ee782684bdf2ffffed78248495a0",
      "deletions": 1,
      "filename": "python/sglang/kernels/ops/attention/fla/utils.py",
      "patch": "@@ -9,12 +9,13 @@\n import sys\n from enum import Enum\n from functools import lru_cache\n-from typing import Any, Callable, Dict, Literal, Optional, Tuple\n+from typing import Any, Callable, Dict, List, Literal, Optional, Tuple\n \n import torch\n import triton\n from packaging import version\n \n+from sglang.srt.environ import envs\n from sglang.srt.utils.common import torch_release\n \n logger = logging.getLogger(__name__)\n@@ -33,6 +34,32 @@\n )\n \n \n+def deterministic_autotune_prune(**fixed: Any) -> Callable[..., List[triton.Config]]:\n+    \"\"\"Build an ``early_config_prune`` that keeps one config in deterministic mode.\n+\n+    An autotune without a disk cache is timed again in every process, so two\n+    runs, or two pipeline ranks of one run, can pick different configs. When a\n+    kernel's reduction order follows its config, they then compute different\n+    bits. With --enable-deterministic-inference or SGLANG_KDA_FIXED_AUTOTUNE=1,\n+    only the first listed config whose kwargs and launch options match ``fixed``\n+    is kept (e.g. ``num_warps=4``); otherwise all configs are kept.\n+    \"\"\"\n+\n+    def early_config_prune(configs, named_args, **kwargs):\n+        if not (\n+            envs.SGLANG_ENABLE_DETERMINISTIC_INFERENCE.get()\n+            or envs.SGLANG_KDA_FIXED_AUTOTUNE.get()\n+        ):\n+            return configs\n+        return [\n+            config\n+            for config in configs\n+            if all(config.all_kwargs().get(k) == v for k, v in fixed.items())\n+        ][:1]\n+\n+    return early_config_prune\n+\n+\n @lru_cache(maxsize=1)\n def check_environments():\n     \"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/53cac5882a27ee782684bdf2ffffed78248495a0/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Futils.py",
      "sha": "cdaecf6baf14d30a05d3d5164f62b6065e193947",
      "status": "modified"
    },
