      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Funquant.py?ref=49ade8535dbd6978a059f36cbcfdba697fd1cf4a",
      "deletions": 0,
      "filename": "python/sglang/srt/layers/quantization/unquant.py",
      "patch": "@@ -1009,10 +1009,15 @@ def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n             copy_or_rebind_param(\n                 layer, \"w13_weight\", shuffle_weight(layer.w13_weight.data, (16, 16))\n             )\n+            # copy_or_rebind_param copies the shuffled data into the existing\n+            # Parameter, which drops the is_shuffled marker set by shuffle_weight.\n+            # aiter.fused_moe uses it to select the preshuffled MoE kernels.\n+            layer.w13_weight.is_shuffled = True\n             torch.cuda.empty_cache()\n             copy_or_rebind_param(\n                 layer, \"w2_weight\", shuffle_weight(layer.w2_weight.data, (16, 16))\n             )\n+            layer.w2_weight.is_shuffled = True\n             torch.cuda.empty_cache()\n \n         # Pack weight for get better performance on CPU",
      "raw_url": "https://github.com/sgl-project/sglang/raw/49ade8535dbd6978a059f36cbcfdba697fd1cf4a/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Funquant.py",
