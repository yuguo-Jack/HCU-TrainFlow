      "additions": 11,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e9863483f0c844248def67661edcc26591d1c88d/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fmodelopt_quant.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fmodelopt_quant.py?ref=e9863483f0c844248def67661edcc26591d1c88d",
      "deletions": 9,
      "filename": "python/sglang/srt/layers/quantization/modelopt_quant.py",
      "patch": "@@ -2476,13 +2476,18 @@ def create_weights(\n         )\n         layer.register_parameter(\"w13_weight_scale\", w13_weight_scale)\n \n-        # TRTLLM replaces blockscale_swizzled with an alias to weight_scale\n-        # during process_weights_after_loading, so skip the expensive\n-        # swizzle+allocate here to avoid GPU memory fragmentation\n-        if (\n+        # Serialized CUTLASS checkpoints build these derived layouts after\n+        # loading. Swizzling uninitialized scales here doubles scale storage\n+        # during construction. TRTLLM and MegaMoE also defer their layouts.\n+        defer_blockscale_swizzle = (\n             self.enable_flashinfer_trtllm_moe\n             or get_moe_runner_backend().is_flashinfer_megamoe()\n-        ):\n+            or (\n+                self.quant_config.is_checkpoint_nvfp4_serialized\n+                and self.enable_flashinfer_cutlass_moe\n+            )\n+        )\n+        if defer_blockscale_swizzle:\n             layer.w13_blockscale_swizzled = None\n         else:\n             layer.w13_blockscale_swizzled = Parameter(\n@@ -2502,10 +2507,7 @@ def create_weights(\n         )\n         layer.register_parameter(\"w2_weight_scale\", w2_weight_scale)\n \n-        if (\n-            self.enable_flashinfer_trtllm_moe\n-            or get_moe_runner_backend().is_flashinfer_megamoe()\n-        ):\n+        if defer_blockscale_swizzle:\n             layer.w2_blockscale_swizzled = None\n         else:\n             layer.w2_blockscale_swizzled = Parameter(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e9863483f0c844248def67661edcc26591d1c88d/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fmodelopt_quant.py",
      "sha": "e12e3b93aef584daf23e5f5b4f48172d49d57855",
      "status": "modified"
