      "deletions": 1,
      "filename": "python/sglang/srt/managers/rust_server.py",
      "patch": "@@ -402,7 +402,7 @@ def launch(cls, scheduler: Scheduler) -> RustServer:\n \n         # Per-DP-rank HTTP port with client load balancing. `None` when DP is off,\n         # so the rank is not conflated with rank 0 of a one-rank group.\n-        dp_rank = scheduler.ps.attn_dp_rank if scheduler.ps.dp_size > 1 else None\n+        dp_rank = scheduler.ps.dp_rank if scheduler.ps.dp_size > 1 else None\n         if dp_rank is not None:\n             http_addr = f\"{get_serving().host}:{server_args.port + dp_rank}\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b3bf9f73b1dfcd2410dea4db4007bcb0eee43fb1/python%2Fsglang%2Fsrt%2Fmanagers%2Frust_server.py",
      "sha": "065b63118af49b43482677d36804f4783a236483",
      "status": "modified"
    },
    {
      "additions": 29,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b3bf9f73b1dfcd2410dea4db4007bcb0eee43fb1/test%2Fregistered%2Fdp_engine%2Ftest_data_parallelism.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fdp_engine%2Ftest_data_parallelism.py?ref=b3bf9f73b1dfcd2410dea4db4007bcb0eee43fb1",
      "deletions": 0,
      "filename": "test/registered/dp_engine/test_data_parallelism.py",
      "patch": "@@ -8,9 +8,11 @@\n from sglang.test.kits.eval_accuracy_kit import GSM8KMixin\n from sglang.test.test_utils import (\n     DEFAULT_MODEL_NAME_FOR_TEST,\n+    DEFAULT_SMALL_MODEL_NAME_FOR_TEST,\n     DEFAULT_TIMEOUT_FOR_SERVER_LAUNCH,\n     DEFAULT_URL_FOR_TEST,\n     CustomTestCase,\n+    is_rust_server_built,\n     popen_launch_server,\n )\n \n@@ -67,5 +69,32 @@ def test_get_memory_pool_size(self):\n         assert response.status_code == 200\n \n \n+@unittest.skipUnless(\n+    is_rust_server_built(),\n+    \"embedded rust server extension not built\",\n+)\n+class TestRustDataParallelism(CustomTestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        cls.base_url = DEFAULT_URL_FOR_TEST\n+        cls.process = popen_launch_server(\n+            DEFAULT_SMALL_MODEL_NAME_FOR_TEST,\n+            cls.base_url,\n+            timeout=DEFAULT_TIMEOUT_FOR_SERVER_LAUNCH,\n+            env={\"SGLANG_RUST_SERVER\": \"1\"},\n+            other_args=[\"--dp\", 2],\n+        )\n+\n+    @classmethod\n+    def tearDownClass(cls):\n+        kill_process_tree(cls.process.pid)\n+\n+    def test_nonzero_dp_rank_has_http_listener(self):\n+        # popen_launch_server already waits for rank 0's listener.\n+        host, port = self.base_url.rsplit(\":\", 1)\n+        response = requests.get(f\"{host}:{int(port) + 1}/health\", timeout=30)\n+        self.assertEqual(response.status_code, 200, response.text)\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b3bf9f73b1dfcd2410dea4db4007bcb0eee43fb1/test%2Fregistered%2Fdp_engine%2Ftest_data_parallelism.py",
      "sha": "7a0aa10b1799fa0e2b837e617d3606f6c78b0f9d",
