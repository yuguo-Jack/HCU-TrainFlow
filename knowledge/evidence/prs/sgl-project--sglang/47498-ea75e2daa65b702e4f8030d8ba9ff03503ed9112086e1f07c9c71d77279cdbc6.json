  "files": [
    {
      "additions": 21,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ac8b3965ac192e22f9b43e70df2443a03fbbd3f7/python%2Fsglang%2Fsrt%2Fconfigs%2Fnemotron_h.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fconfigs%2Fnemotron_h.py?ref=ac8b3965ac192e22f9b43e70df2443a03fbbd3f7",
      "deletions": 4,
      "filename": "python/sglang/srt/configs/nemotron_h.py",
      "patch": "@@ -163,6 +163,21 @@ class NemotronHConfig(PretrainedConfig):\n     model_type = \"nemotron_h\"\n     keys_to_ignore_at_inference = [\"past_key_values\"]\n \n+    _LAYER_TYPE_ALIASES = {\n+        \"linear_attention\": \"mamba\",\n+        \"full_attention\": \"attention\",\n+    }\n+\n+    @staticmethod\n+    def _canonicalize_layer_types(layers_block_type):\n+        \"\"\"Map transformers 5 layer names onto the names this config stores.\"\"\"\n+        if not isinstance(layers_block_type, list):\n+            return layers_block_type\n+        return [\n+            NemotronHConfig._LAYER_TYPE_ALIASES.get(block_type, block_type)\n+            for block_type in layers_block_type\n+        ]\n+\n     @staticmethod\n     def _validate_layers_block_type(\n         layers_block_type, expected_length=None, param_name=\"layers_block_type\"\n@@ -304,11 +319,13 @@ def __init__(\n         mamba_chunk_size = self._resolve_mamba_chunk_size(mamba_chunk_size, kwargs)\n \n         # Compatibility parsing: normalize legacy pattern fields into canonical list fields.\n-        layers_block_type = self._resolve_layers_block_type(\n-            layers_block_type, hybrid_override_pattern, kwargs\n+        layers_block_type = self._canonicalize_layer_types(\n+            self._resolve_layers_block_type(\n+                layers_block_type, hybrid_override_pattern, kwargs\n+            )\n         )\n-        mtp_layers_block_type = self._resolve_mtp_layers_block_type(\n-            mtp_layers_block_type, kwargs\n+        mtp_layers_block_type = self._canonicalize_layer_types(\n+            self._resolve_mtp_layers_block_type(mtp_layers_block_type, kwargs)\n         )\n \n         # num_hidden_layers is deprecated and ignored as a source of truth.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ac8b3965ac192e22f9b43e70df2443a03fbbd3f7/python%2Fsglang%2Fsrt%2Fconfigs%2Fnemotron_h.py",
      "sha": "0b647d92f2f97be31b9da6f7978ac6dafdf22437",
      "status": "modified"
    },
    {
      "additions": 29,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ac8b3965ac192e22f9b43e70df2443a03fbbd3f7/test%2Fregistered%2Funit%2Fconfigs%2Ftest_nemotron_h_layer_aliases.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fconfigs%2Ftest_nemotron_h_layer_aliases.py?ref=ac8b3965ac192e22f9b43e70df2443a03fbbd3f7",
      "deletions": 0,
      "filename": "test/registered/unit/configs/test_nemotron_h_layer_aliases.py",
      "patch": "@@ -0,0 +1,29 @@\n+\"\"\"transformers 5 Nemotron-H layer names load as the legacy names.\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.configs.nemotron_h import NemotronHConfig\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestNemotronHLayerAliases(CustomTestCase):\n+    def test_transformers_5_names_become_legacy_names(self):\n+        config = NemotronHConfig(\n+            layers_block_type=[\"linear_attention\", \"full_attention\", \"mlp\", \"moe\"],\n+            n_routed_experts=2,\n+            n_group=1,\n+        )\n+        self.assertEqual(config.layers_block_type, [\"mamba\", \"attention\", \"mlp\", \"moe\"])\n+\n+    def test_legacy_names_are_unchanged(self):\n+        config = NemotronHConfig(\n+            layers_block_type=[\"mamba\", \"attention\"],\n+        )\n+        self.assertEqual(config.layers_block_type, [\"mamba\", \"attention\"])\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ac8b3965ac192e22f9b43e70df2443a03fbbd3f7/test%2Fregistered%2Funit%2Fconfigs%2Ftest_nemotron_h_layer_aliases.py",
      "sha": "64b4f0611d9b30c11adfe931f709f0b3349352a8",
      "status": "added"
    }
  ],
