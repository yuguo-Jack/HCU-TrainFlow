  "files": [
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/931bb8cd1ffc8864f0f656d62f039799e5bee519/sgl-model-gateway%2FREADME.md",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/sgl-model-gateway%2FREADME.md?ref=931bb8cd1ffc8864f0f656d62f039799e5bee519",
      "deletions": 0,
      "filename": "sgl-model-gateway/README.md",
      "patch": "@@ -809,6 +809,7 @@ Set `--cors-allowed-origins` for browser access.\n - **Router API key (`--api-key`)** protects client access to router endpoints; all protected routes expect `Authorization: Bearer <key>`.\n - Workers listed in `--worker-urls` inherit the router API key automatically.\n - When adding workers dynamically, provide explicit API keys via payload or query string; they do **not** inherit automatically.\n+- When a worker API key is configured, the gateway sends it as `Authorization: Bearer <key>` for both the initial HTTP `/health` probe during registration and periodic HTTP health checks. This also supports workers behind proxies that require authentication for health endpoints.\n \n ```bash\n # Router and initial workers share the same key",
      "raw_url": "https://github.com/sgl-project/sglang/raw/931bb8cd1ffc8864f0f656d62f039799e5bee519/sgl-model-gateway%2FREADME.md",
      "sha": "bd056482c0ec7405aff8b71b2770c039783e4d9a",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/sgl-project/sglang/blob/931bb8cd1ffc8864f0f656d62f039799e5bee519/sgl-model-gateway%2Fsrc%2Fcore%2Fsteps%2Fworker%2Flocal%2Fdetect_connection.rs",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/sgl-model-gateway%2Fsrc%2Fcore%2Fsteps%2Fworker%2Flocal%2Fdetect_connection.rs?ref=931bb8cd1ffc8864f0f656d62f039799e5bee519",
      "deletions": 4,
      "filename": "sgl-model-gateway/src/core/steps/worker/local/detect_connection.rs",
      "patch": "@@ -18,16 +18,21 @@ async fn try_http_health_check(\n     url: &str,\n     timeout_secs: u64,\n     client: &Client,\n+    api_key: Option<&str>,\n ) -> Result<(), String> {\n     let is_https = url.starts_with(\"https://\");\n     let protocol = if is_https { \"https\" } else { \"http\" };\n     let clean_url = strip_protocol(url);\n     let health_url = format!(\"{}://{}/health\", protocol, clean_url);\n \n-    client\n+    let mut req = client\n         .get(&health_url)\n-        .timeout(Duration::from_secs(timeout_secs))\n-        .send()\n+        .timeout(Duration::from_secs(timeout_secs));\n+    if let Some(key) = api_key {\n+        req = req.bearer_auth(key);\n+    }\n+\n+    req.send()\n         .await\n         .and_then(reqwest::Response::error_for_status)\n         .map_err(|e| format!(\"Health check failed: {}\", e))?;\n@@ -110,7 +115,7 @@ impl StepExecutor<LocalWorkerWorkflowData> for DetectConnectionModeStep {\n         let runtime_type = config.runtime.as_deref();\n \n         let (http_result, grpc_result) = tokio::join!(\n-            try_http_health_check(&url, timeout, client),\n+            try_http_health_check(&url, timeout, client, config.api_key.as_deref()),\n             try_grpc_health_check(&url, timeout, runtime_type)\n         );\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/931bb8cd1ffc8864f0f656d62f039799e5bee519/sgl-model-gateway%2Fsrc%2Fcore%2Fsteps%2Fworker%2Flocal%2Fdetect_connection.rs",
      "sha": "574897a079e11cd591cebf37d7606efd200b335a",
      "status": "modified"
    },
    {
      "additions": 85,
      "blob_url": "https://github.com/sgl-project/sglang/blob/931bb8cd1ffc8864f0f656d62f039799e5bee519/sgl-model-gateway%2Ftests%2Frouting%2Fworker_discovery_test.rs",
      "changes": 85,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/sgl-model-gateway%2Ftests%2Frouting%2Fworker_discovery_test.rs?ref=931bb8cd1ffc8864f0f656d62f039799e5bee519",
      "deletions": 0,
      "filename": "sgl-model-gateway/tests/routing/worker_discovery_test.rs",
      "patch": "@@ -10,8 +10,93 @@ use crate::common::{\n \n #[cfg(test)]\n mod worker_discovery_tests {\n+    use axum::{\n+        http::{HeaderMap, StatusCode},\n+        routing::get,\n+        Router,\n+    };\n+    use smg::{\n+        core::{\n+            steps::{create_local_worker_workflow_data, DetectConnectionModeStep},\n+            ConnectionMode,\n+        },\n+        protocols::worker_spec::WorkerConfigRequest,\n+    };\n+    use tokio::net::TcpListener;\n+    use wfaas::{StepExecutor, StepResult, WorkflowContext, WorkflowError, WorkflowInstanceId};\n+\n     use super::*;\n \n+    async fn detect_worker_connection(\n+        required_key: Option<&str>,\n+        api_key: Option<&str>,\n+    ) -> (Result<StepResult, WorkflowError>, Option<ConnectionMode>) {\n+        let expected_auth = required_key.map(|key| format!(\"Bearer {key}\"));\n+        let app = Router::new().route(\n+            \"/health\",\n+            get(move |headers: HeaderMap| {\n+                let expected_auth = expected_auth.clone();\n+                async move {\n+                    let auth = headers.get(\"authorization\").and_then(|v| v.to_str().ok());\n+                    if auth == expected_auth.as_deref() {\n+                        StatusCode::OK\n+                    } else {\n+                        StatusCode::UNAUTHORIZED\n+                    }\n+                }\n+            }),\n+        );\n+        let listener = TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n+        let url = format!(\"http://{}\", listener.local_addr().unwrap());\n+        let server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });\n+\n+        let router_config = RouterConfig::builder()\n+            .regular_mode(vec![])\n+            .api_key(\"router-key\")\n+            .build_unchecked();\n+        let app_context = create_test_context(router_config).await;\n+        let config: WorkerConfigRequest = serde_json::from_value(serde_json::json!({\n+            \"url\": url,\n+            \"api_key\": api_key,\n+            \"health_check_timeout_secs\": 1,\n+        }))\n+        .unwrap();\n+        let data = create_local_worker_workflow_data(config, app_context);\n+        let mut context = WorkflowContext::new(WorkflowInstanceId::new(), data);\n+        let result = DetectConnectionModeStep.execute(&mut context).await;\n+\n+        server.abort();\n+        let _ = server.await;\n+        (result, context.data.connection_mode)\n+    }\n+\n+    /// A worker protecting /health must be detected as HTTP with its own key;\n+    /// missing or incorrect credentials must leave connection detection failed.\n+    #[tokio::test]\n+    async fn test_connection_detection_with_worker_api_key() {\n+        for key in [Some(\"worker-key\"), None, Some(\"wrong-key\")] {\n+            let (result, mode) = detect_worker_connection(Some(\"worker-key\"), key).await;\n+            if key == Some(\"worker-key\") {\n+                assert_eq!(result.unwrap(), StepResult::Success);\n+                assert_eq!(mode, Some(ConnectionMode::Http));\n+            } else {\n+                let WorkflowError::StepFailed { message, .. } = result.unwrap_err() else {\n+                    panic!(\"Expected a connection detection failure\");\n+                };\n+                assert!(message.contains(\"401\"), \"{message}\");\n+                assert_eq!(mode, None);\n+            }\n+        }\n+    }\n+\n+    /// A worker without a key must remain reachable without inheriting the router key.\n+    #[tokio::test]\n+    async fn test_connection_detection_without_worker_api_key() {\n+        let (result, mode) = detect_worker_connection(None, None).await;\n+        assert_eq!(result.unwrap(), StepResult::Success);\n+        assert_eq!(mode, Some(ConnectionMode::Http));\n+    }\n+\n     /// Normal path: model name is discovered from /server_info.\n     #[tokio::test]\n     async fn test_model_name_discovered_via_server_info() {",
