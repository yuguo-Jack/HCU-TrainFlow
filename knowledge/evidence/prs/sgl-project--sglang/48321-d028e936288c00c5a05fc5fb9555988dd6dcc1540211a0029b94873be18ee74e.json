      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/edec795a41c90d098be9f19f8572c2627e250530/python%2Fsglang%2Fkernels%2Fjit%2Fcsrc%2Fgemm%2Fconvrot_int8%2Fconvrot_int8_entry.cuh",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fjit%2Fcsrc%2Fgemm%2Fconvrot_int8%2Fconvrot_int8_entry.cuh?ref=edec795a41c90d098be9f19f8572c2627e250530",
      "deletions": 1,
      "filename": "python/sglang/kernels/jit/csrc/gemm/convrot_int8/convrot_int8_entry.cuh",
      "patch": "@@ -594,8 +594,15 @@ void dispatch_convrot_int8_gemm(const GemmOperands& op) {\n     } else {\n       run_convrot_int8_gemm_mma_sync<GemmShape<128, 128, 64>, GemmShape<64, 64, 64>, 5>(op);\n     }\n+  } else if (M >= 6144 && (op.K >= 8192 || N >= 16384)) {\n+    // Measured on RTX 5090 (170 SMs): from M = 6144 on, the wide tile runs the long-K\n+    // down projection and the wide up projection 3-8% faster; below that it leaves\n+    // too few CTAs per SM and loses to the 128x128 tile.\n+    run_convrot_int8_gemm_mma_sync<GemmShape<128, 256, 64>, GemmShape<64, 64, 64>, 3>(op);\n   } else {\n-    run_convrot_int8_gemm_mma_sync<GemmShape<128, 128, 64>, GemmShape<64, 64, 64>, 5>(op);\n+    // Three stages (48 KB) fit two CTAs per SM, which hides the epilogue and the wave\n+    // tail: 3-11% faster than five stages (80 KB, one CTA) from M = 512 to 8160.\n+    run_convrot_int8_gemm_mma_sync<GemmShape<128, 128, 64>, GemmShape<64, 64, 64>, 3>(op);\n   }\n }\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/edec795a41c90d098be9f19f8572c2627e250530/python%2Fsglang%2Fkernels%2Fjit%2Fcsrc%2Fgemm%2Fconvrot_int8%2Fconvrot_int8_entry.cuh",
