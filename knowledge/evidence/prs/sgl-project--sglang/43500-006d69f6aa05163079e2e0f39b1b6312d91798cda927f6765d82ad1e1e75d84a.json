      "patch": "@@ -229,6 +229,7 @@ def create_weights(\n                 weight_path=self.kt_config.weight_path,\n                 chunked_prefill_size=self.kt_config.chunked_prefill_size,\n                 method=self.kt_config.method,\n+                swiglu_limit=layer.moe_runner_config.swiglu_limit or 0.0,\n                 max_deferred_experts_per_token=layer_max_deferred,\n             )\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/29f7e588b30a0f2cbc59d05bf430ef3fd893a034/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Fkt_ep_wrapper.py",
