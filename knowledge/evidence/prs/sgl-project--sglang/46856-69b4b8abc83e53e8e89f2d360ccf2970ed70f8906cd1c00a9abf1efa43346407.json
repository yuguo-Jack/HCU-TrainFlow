      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Flinear%2Futils.py?ref=199d1873547f20b4a1838523b02cd095fdb2213e",
      "deletions": 9,
      "filename": "python/sglang/srt/layers/attention/linear/utils.py",
      "patch": "@@ -128,19 +128,25 @@ def build_verify_intermediate_state_indices(pool_size: int, device):\n     target_verify path: request slot i owns scratch row i.\n \n     The scratch is allocated with one extra padding row (the `+1` in\n-    MambaPool.SpeculativeState, index `pool_size`). Warmup and MLP-sync\n-    batches can be padded past the pool capacity — under DP attention\n-    `get_eager_max_batch_size` ceil-aligns the eager warmup bs to attn_tp —\n-    and the verify kernels index this table positionally up to that padded\n-    bs. Size the table to the padded maximum and clamp every out-of-pool row\n-    onto the padding row: pad rows race onto one discard row, which is\n-    value-irrelevant (same convention as the ragged-verify ghost row).\n+    MambaPool.SpeculativeState, index `pool_size`). Eager and CUDA graph\n+    batches can be padded past the pool capacity. Graph alignment can exceed\n+    eager alignment even without MLP-sync. The verify kernels index this\n+    table positionally up to the padded batch size, so cover both maxima\n+    and clamp every out-of-pool row onto the padding row. Pad rows share\n+    one discard row whose value is irrelevant, as in ragged verify.\n     \"\"\"\n     import torch\n \n-    from sglang.srt.utils.common import get_eager_max_batch_size\n+    from sglang.srt.utils.common import (\n+        get_cuda_graph_max_batch_size,\n+        get_eager_max_batch_size,\n+    )\n \n-    padded_bs = max(get_eager_max_batch_size(pool_size), pool_size)\n+    padded_bs = max(\n+        pool_size,\n+        get_eager_max_batch_size(pool_size),\n+        get_cuda_graph_max_batch_size(pool_size),\n+    )\n     indices = torch.arange(pool_size, dtype=torch.int32, device=device)\n     if padded_bs > pool_size:\n         indices = torch.cat(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/199d1873547f20b4a1838523b02cd095fdb2213e/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Flinear%2Futils.py",
      "sha": "6108649bbb2452ffa37fc0c6ec976836ff2295cc",
      "status": "modified"
    },
    {
      "additions": 31,
      "blob_url": "https://github.com/sgl-project/sglang/blob/199d1873547f20b4a1838523b02cd095fdb2213e/test%2Fregistered%2Funit%2Fspec%2Ftest_ngram_mamba_verify_update.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fspec%2Ftest_ngram_mamba_verify_update.py?ref=199d1873547f20b4a1838523b02cd095fdb2213e",
      "deletions": 0,
      "filename": "test/registered/unit/spec/test_ngram_mamba_verify_update.py",
      "patch": "@@ -362,5 +362,36 @@ def test_all_overrides_accept_the_call_kwargs(self):\n             )\n \n \n+class TestVerifyIntermediateStateIndices(CustomTestCase):\n+    def test_padding_rows_use_reserved_scratch_row(self):\n+        from sglang.srt.layers.attention.linear.utils import (\n+            build_verify_intermediate_state_indices,\n+        )\n+\n+        # Graph-only padding is the regression; also retain eager padding\n+        # and the unpadded/already-aligned cases.\n+        cases = [\n+            (5, 5, 8, [0, 1, 2, 3, 4, 5, 5, 5]),\n+            (5, 8, 6, [0, 1, 2, 3, 4, 5, 5, 5]),\n+            (5, 5, 5, [0, 1, 2, 3, 4]),\n+            (8, 8, 8, list(range(8))),\n+        ]\n+        for pool_size, eager_bs, graph_bs, expected in cases:\n+            with (\n+                self.subTest(pool_size=pool_size, eager_bs=eager_bs, graph_bs=graph_bs),\n+                patch(\n+                    \"sglang.srt.utils.common.get_eager_max_batch_size\",\n+                    return_value=eager_bs,\n+                ),\n+                patch(\n+                    \"sglang.srt.utils.common.get_cuda_graph_max_batch_size\",\n+                    return_value=graph_bs,\n+                ),\n+            ):\n+                indices = build_verify_intermediate_state_indices(pool_size, \"cpu\")\n+                self.assertEqual(indices.dtype, torch.int32)\n+                self.assertEqual(indices.tolist(), expected)\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/199d1873547f20b4a1838523b02cd095fdb2213e/test%2Fregistered%2Funit%2Fspec%2Ftest_ngram_mamba_verify_update.py",
