      "raw_url": "https://github.com/sgl-project/sglang/raw/f2761f2c6048e65777d7f0a6ce89684385cb06de/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fpost_training%2Frl_dataclasses.py",
