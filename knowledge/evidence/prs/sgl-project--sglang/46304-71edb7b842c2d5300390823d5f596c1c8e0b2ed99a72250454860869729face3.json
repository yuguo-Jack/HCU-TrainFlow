  "files": [
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9a1d30682f8d925111d2e9650cd0b7c09f32996a/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Floader.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Floader.py?ref=9a1d30682f8d925111d2e9650cd0b7c09f32996a",
      "deletions": 6,
      "filename": "python/sglang/kernels/jit/utils/compile/loader.py",
      "patch": "@@ -80,12 +80,8 @@ def load_jit(\n                         given entry points. Otherwise the sources must export\n                         from the C++ side themselves.\n     \"\"\"\n-    if is_hip_runtime():\n-        extra_cuda_cflags = [\n-            flag\n-            for flag in (extra_cuda_cflags or [])\n-            if flag not in (\"--use_fast_math\", \"-use_fast_math\")\n-        ]\n+    if is_hip_runtime() or envs.SGLANG_JIT_DISABLE_FAST_MATH.get():\n+        extra_cuda_cflags = _strip_fast_math_flags(list(extra_cuda_cflags or []))\n \n     if envs.SGLANG_JIT_LOG_RESOURCE_USAGE.get():\n         # nvcc reports through ptxas; hipcc through a clang remark pass.\n@@ -213,6 +209,14 @@ def _find_prebuilt(*, spec: BuildSpec, scope: pathlib.Path) -> pathlib.Path | No\n     return cache.find_prebuilt(scope=scope, module_name=spec.module_name)\n \n \n+_FAST_MATH_FLAGS = (\"--use_fast_math\", \"-use_fast_math\")\n+\n+\n+def _strip_fast_math_flags(flags: List[str]) -> List[str]:\n+    \"\"\"Drop nvcc's fast-math flag: never on HIP, on CUDA only when asked to.\"\"\"\n+    return [flag for flag in flags if flag not in _FAST_MATH_FLAGS]\n+\n+\n # Verified against hgcc 2.2: it is an nvcc-style driver and accepts\n # -Xcompiler, --use_fast_math, --expt-relaxed-constexpr and\n # --expt-extended-lambda; the genuinely unsupported options are the",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9a1d30682f8d925111d2e9650cd0b7c09f32996a/python%2Fsglang%2Fkernels%2Fjit%2Futils%2Fcompile%2Floader.py",
      "sha": "3e35f3c965f8443d3380fb9f33070fb153d7c358",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9a1d30682f8d925111d2e9650cd0b7c09f32996a/python%2Fsglang%2Fsrt%2Fenviron.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fenviron.py?ref=9a1d30682f8d925111d2e9650cd0b7c09f32996a",
      "deletions": 0,
      "filename": "python/sglang/srt/environ.py",
      "patch": "@@ -1395,6 +1395,11 @@ class Envs:\n     # is a hit on the second run, and a cache hit has nothing to report, so pair\n     # this with SGLANG_JIT_FORCE_RECOMPILE to see the report every time.\n     SGLANG_JIT_LOG_RESOURCE_USAGE = EnvBool(False)\n+    # Drop --use_fast_math from every JIT build, the way the HIP path already\n+    # does: a switch for ruling fast math in or out when chasing a numerical\n+    # difference. Changes the build flags, so it compiles into its own cache\n+    # entry and leaves the default build untouched.\n+    SGLANG_JIT_DISABLE_FAST_MATH = EnvBool(False)\n     # Drop the GB/s and TFLOPS columns from the benchmark marker's table.\n     SGLANG_JIT_BENCHMARK_DISABLE_LOG_BANDWIDTH = EnvBool(False)\n     SGLANG_JIT_BENCHMARK_DISABLE_LOG_FLOPS = EnvBool(False)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9a1d30682f8d925111d2e9650cd0b7c09f32996a/python%2Fsglang%2Fsrt%2Fenviron.py",
      "sha": "ef0b34d70b04aede32ce2817f1ad5ba109eec594",
      "status": "modified"
    },
    {
      "additions": 76,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9a1d30682f8d925111d2e9650cd0b7c09f32996a/test%2Fregistered%2Funit%2Fkernels%2Ftest_load_jit_fast_math.py",
      "changes": 76,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fkernels%2Ftest_load_jit_fast_math.py?ref=9a1d30682f8d925111d2e9650cd0b7c09f32996a",
      "deletions": 0,
      "filename": "test/registered/unit/kernels/test_load_jit_fast_math.py",
      "patch": "@@ -0,0 +1,76 @@\n+\"\"\"``load_jit``'s fast-math switch, checked on CPU with no compiler or device.\n+\n+``SGLANG_JIT_DISABLE_FAST_MATH`` drops nvcc's ``--use_fast_math`` from a CUDA\n+build the way the HIP path always has. The build is intercepted at ``BuildSpec``,\n+before ninja or the cache see it, so the flags asserted on are exactly the ones\n+that would have reached the compiler.\n+\"\"\"\n+\n+from __future__ import annotations\n+\n+import sys\n+from typing import List, Tuple\n+\n+import pytest\n+\n+from sglang.kernels.jit.utils.compile import loader\n+from sglang.srt.environ import envs\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+SWITCH = \"SGLANG_JIT_DISABLE_FAST_MATH\"\n+\n+\n+def test_strip_drops_both_spellings_and_keeps_the_rest_in_order():\n+    flags = [\"-O3\", \"--use_fast_math\", \"--ftz=false\", \"-use_fast_math\", \"-lineinfo\"]\n+    assert loader._strip_fast_math_flags(flags) == [\"-O3\", \"--ftz=false\", \"-lineinfo\"]\n+\n+\n+def test_strip_leaves_a_list_without_fast_math_alone():\n+    flags = [\"-O3\", \"--ftz=false\"]\n+    assert loader._strip_fast_math_flags(flags) == flags\n+    assert loader._strip_fast_math_flags([]) == []\n+\n+\n+class _Intercepted(Exception):\n+    \"\"\"Raised by the BuildSpec stand-in: load_jit stops before any build step.\"\"\"\n+\n+\n+def _cuda_cflags(monkeypatch, *, hip: bool, extra: List[str]) -> Tuple[str, ...]:\n+    \"\"\"The ``cuda_cflags`` load_jit hands to the build, with no device queried.\"\"\"\n+    monkeypatch.setattr(loader, \"is_hip_runtime\", lambda: hip)\n+    monkeypatch.setattr(loader, \"is_sail_runtime\", lambda: False)\n+    monkeypatch.setattr(loader, \"get_default_target_flags\", lambda: [\"-std=c++20\"])\n+    monkeypatch.delenv(\"SGLANG_JIT_LOG_RESOURCE_USAGE\", raising=False)\n+\n+    def record(**kwargs):\n+        raise _Intercepted(kwargs[\"cuda_cflags\"])\n+\n+    monkeypatch.setattr(loader, \"BuildSpec\", record)\n+    with pytest.raises(_Intercepted) as caught:\n+        loader.load_jit(\"fast_math_probe\", extra_cuda_cflags=extra)\n+    return caught.value.args[0]\n+\n+\n+def test_cuda_keeps_fast_math_by_default(monkeypatch):\n+    monkeypatch.delenv(SWITCH, raising=False)\n+    flags = _cuda_cflags(monkeypatch, hip=False, extra=[\"--use_fast_math\", \"-O3\"])\n+    assert flags == (\"-std=c++20\", \"--use_fast_math\", \"-O3\")\n+\n+\n+def test_cuda_drops_fast_math_when_the_switch_is_on(monkeypatch):\n+    with envs.SGLANG_JIT_DISABLE_FAST_MATH.override(True):\n+        flags = _cuda_cflags(monkeypatch, hip=False, extra=[\"--use_fast_math\", \"-O3\"])\n+    assert flags == (\"-std=c++20\", \"-O3\")\n+\n+\n+@pytest.mark.parametrize(\"switch\", [False, True])\n+def test_hip_drops_fast_math_regardless_of_the_switch(monkeypatch, switch):\n+    with envs.SGLANG_JIT_DISABLE_FAST_MATH.override(switch):\n+        flags = _cuda_cflags(monkeypatch, hip=True, extra=[\"--use_fast_math\", \"-O3\"])\n+    assert flags == (\"-std=c++20\", \"-O3\")\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(pytest.main([__file__, \"-v\"]))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9a1d30682f8d925111d2e9650cd0b7c09f32996a/test%2Fregistered%2Funit%2Fkernels%2Ftest_load_jit_fast_math.py",
      "sha": "d9b9cf8cdf0748fbfb492788e50708e14e7ce1fb",
      "status": "added"
    }
