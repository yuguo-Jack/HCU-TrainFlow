      "raw_url": "https://github.com/sgl-project/sglang/raw/3d14a0e88137d97d0e7e7a3a3080e6cfba69f368/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner_components%2Fspec_aux_hidden_state.py",
