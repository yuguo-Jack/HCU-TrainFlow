      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fencoder%2Freceiver.py?ref=f55e36d76f0361fa654da03d21f0dae411da3f62",
      "deletions": 3,
      "filename": "python/sglang/srt/disaggregation/encoder/receiver.py",
      "patch": "@@ -787,9 +787,12 @@ class WaitingMMRequestStatus(IntEnum):\n \n def _select_mm_processor_prompt(recv_req, mm_processor):\n     \"\"\"Mirror tokenizer-side prompt selection for scheduler-side EPD rebuilds.\"\"\"\n-    if mm_processor.prefer_tokenized_input and recv_req.input_ids is not None:\n-        return list(recv_req.input_ids)\n-    return recv_req.input_text or recv_req.input_ids\n+    # The scheduler holds input_ids as array(\"q\"); processors accept str or\n+    # list[int], not array.\n+    input_ids = None if recv_req.input_ids is None else list(recv_req.input_ids)\n+    if mm_processor.prefer_tokenized_input and input_ids is not None:\n+        return input_ids\n+    return recv_req.input_text or input_ids\n \n \n def create_part_req_id(original_req_id: str, part_idx: int) -> str:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f55e36d76f0361fa654da03d21f0dae411da3f62/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fencoder%2Freceiver.py",
      "sha": "38dd6f4b7728dd9294e612ddf63e9ea8683dc122",
      "status": "modified"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f55e36d76f0361fa654da03d21f0dae411da3f62/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_encode_receiver.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_encode_receiver.py?ref=f55e36d76f0361fa654da03d21f0dae411da3f62",
      "deletions": 0,
      "filename": "test/registered/unit/disaggregation/test_encode_receiver.py",
      "patch": "@@ -16,6 +16,7 @@\n     WaitingZmqRequest,\n     WaitingZmqRequestGrpc,\n     _ReceiveRegistrationRunner,\n+    _select_mm_processor_prompt,\n )\n from sglang.srt.disaggregation.utils import DisaggregationMode\n from sglang.srt.managers.io_struct import EncoderDispatchErrorReq\n@@ -395,5 +396,22 @@ def force_peer_failure(status, **kwargs):\n         self.assertEqual(len(abort_reqs), 1)\n \n \n+class TestSelectMMProcessorPrompt(CustomTestCase):\n+    def test_tokens_in_prompt_is_list(self):\n+        \"\"\"A tokens-in prompt reaches the processor as list[int], not array(\"q\");\n+        HTTP sends input_text=None and the gRPC servicer sends \"\".\"\"\"\n+        processor = SimpleNamespace(prefer_tokenized_input=False)\n+        for input_text in (None, \"\"):\n+            with self.subTest(input_text=input_text):\n+                recv_req = SimpleNamespace(\n+                    input_text=input_text, input_ids=array(\"q\", [1, 2, 3])\n+                )\n+\n+                prompt = _select_mm_processor_prompt(recv_req, processor)\n+\n+                self.assertIsInstance(prompt, list)\n+                self.assertEqual(prompt, [1, 2, 3])\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f55e36d76f0361fa654da03d21f0dae411da3f62/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_encode_receiver.py",
