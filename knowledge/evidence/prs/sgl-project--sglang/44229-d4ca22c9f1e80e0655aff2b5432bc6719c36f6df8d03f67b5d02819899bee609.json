      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fspeculative%2Ffrozen_kv_mtp_worker_v2.py?ref=24de84f05c1b13bdceaa4b70f2757cf3c313d816",
      "deletions": 2,
      "filename": "python/sglang/srt/speculative/frozen_kv_mtp_worker_v2.py",
      "patch": "@@ -748,15 +748,21 @@ def spec_v2_attn_backends(self) -> tuple:\n         )\n \n     def forward_batch_generation(\n-        self, batch: ScheduleBatch, on_publish=None, grammar_barrier=None\n+        self,\n+        batch: ScheduleBatch,\n+        on_publish=None,\n+        grammar_barrier=None,\n+        pp_proxy_tensors=None,\n     ):\n         # Mirrors EAGLEWorkerV2.forward_batch_generation; the only frozen-specific\n         # change is the idle draft-input (FrozenKVMTPDraftInput + recurrent hidden\n         # size). The draft / seed-based draft-extend hooks are FrozenKVMTPDraftWorker's.\n         if batch.forward_mode.is_extend() or batch.is_extend_in_batch:\n             # Target prefill (frozen is never standalone -> capture FULL hidden).\n             batch_output = self.target_worker.forward_batch_generation(\n-                batch, capture_hidden_mode=CaptureHiddenMode.FULL\n+                batch,\n+                pp_proxy_tensors=pp_proxy_tensors,\n+                capture_hidden_mode=CaptureHiddenMode.FULL,\n             )\n \n             # Spec_v2 convention: batch.seq_lens = length BEFORE this iter's tokens.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/24de84f05c1b13bdceaa4b70f2757cf3c313d816/python%2Fsglang%2Fsrt%2Fspeculative%2Ffrozen_kv_mtp_worker_v2.py",
      "sha": "0c684bd3237d23056a9661c6ba7b27dc3d6a8baf",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/24de84f05c1b13bdceaa4b70f2757cf3c313d816/python%2Fsglang%2Fsrt%2Fspeculative%2Funo_worker_v2.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fspeculative%2Funo_worker_v2.py?ref=24de84f05c1b13bdceaa4b70f2757cf3c313d816",
      "deletions": 4,
      "filename": "python/sglang/srt/speculative/uno_worker_v2.py",
      "patch": "@@ -413,8 +413,11 @@ def _forward_prefill(\n         self,\n         batch: ScheduleBatch,\n         on_publish,\n+        pp_proxy_tensors=None,\n     ) -> GenerationBatchResult:\n-        result = self.target_worker.forward_batch_generation(batch)\n+        result = self.target_worker.forward_batch_generation(\n+            batch, pp_proxy_tensors=pp_proxy_tensors\n+        )\n         if not isinstance(result.next_token_ids, torch.Tensor):\n             raise RuntimeError(\"UNO target prefill returned no sampled seed tensor.\")\n \n@@ -440,6 +443,7 @@ def _forward_decode_tree(\n         self,\n         batch: ScheduleBatch,\n         on_publish,\n+        pp_proxy_tensors=None,\n     ) -> GenerationBatchResult:\n         \"\"\"Run UNO's F-wide proposal pass, then native EAGLE Q-node verify.\"\"\"\n \n@@ -621,9 +625,10 @@ def _forward_decode(\n         self,\n         batch: ScheduleBatch,\n         on_publish,\n+        pp_proxy_tensors=None,\n     ) -> GenerationBatchResult:\n         if self.tree_mode:\n-            return self._forward_decode_tree(batch, on_publish)\n+            return self._forward_decode_tree(batch, on_publish, pp_proxy_tensors)\n \n         draft_state = batch.spec_info\n \n@@ -774,15 +779,16 @@ def forward_batch_generation(\n         batch: ScheduleBatch,\n         on_publish=None,\n         grammar_barrier=None,\n+        pp_proxy_tensors=None,\n     ) -> GenerationBatchResult:\n         del grammar_barrier\n         self._validate_batch(batch)\n \n         if batch.forward_mode == ForwardMode.EXTEND:\n-            return self._forward_prefill(batch, on_publish)\n+            return self._forward_prefill(batch, on_publish, pp_proxy_tensors)\n \n         if batch.forward_mode == ForwardMode.DECODE:\n-            return self._forward_decode(batch, on_publish)\n+            return self._forward_decode(batch, on_publish, pp_proxy_tensors)\n \n         raise RuntimeError(\n             f\"UNO expected an EXTEND or DECODE batch, got {batch.forward_mode}.\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/24de84f05c1b13bdceaa4b70f2757cf3c313d816/python%2Fsglang%2Fsrt%2Fspeculative%2Funo_worker_v2.py",
      "sha": "64d5dbff329048a1bd8e9083f1e81d63839b99e2",
