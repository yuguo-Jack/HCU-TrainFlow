      "patch": "@@ -165,6 +165,10 @@ def get_hidden_dim(\n                 if moe_inter is not None and n_shared is not None:\n                     inter = moe_inter * n_shared\n             return inter, config.hidden_size\n+        elif module_name == \"linear_fc1\":\n+            return config.intermediate_size, config.hidden_size\n+        elif module_name == \"linear_fc2\":\n+            return config.intermediate_size, config.hidden_size\n         elif module_name == \"fused_qkv_a_proj_with_mqa\":\n             q_lora_rank = getattr(config, \"q_lora_rank\", None) or 0\n             kv_lora_rank = config.kv_lora_rank\n@@ -254,6 +258,8 @@ def get_normalized_target_modules(\n         \"gate_proj\": \"gate_up_proj\",\n         \"up_proj\": \"gate_up_proj\",\n         \"out_proj\": \"out_proj\",\n+        \"linear_fc1\": \"linear_fc1\",\n+        \"linear_fc2\": \"linear_fc2\",\n         \"embed_tokens\": \"embed_tokens\",\n         \"vocab_emb\": \"embed_tokens\",\n         \"embeddings\": \"embed_tokens\",\n@@ -327,6 +333,8 @@ def get_target_module_name(full_module_name: str, target_modules: Set[str]) -> s\n     \"o_proj\",\n     \"out_proj\",\n     \"down_proj\",\n+    \"linear_fc1\",\n+    \"linear_fc2\",\n     \"down_proj_moe\",\n     \"down_proj_shared_moe\",\n     \"wo_ud\",\n@@ -373,6 +381,8 @@ def get_target_module_name(full_module_name: str, target_modules: Set[str]) -> s\n         \"up_proj\",\n         \"gate_up_proj\",\n         \"down_proj\",\n+        \"linear_fc1\",\n+        \"linear_fc2\",\n         \"fc1_latent_proj\",\n         \"fc2_latent_proj\",\n         \"embed_tokens\",",
