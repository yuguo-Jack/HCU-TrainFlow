      "deletions": 0,
      "filename": "python/sglang/srt/disaggregation/mooncake/conn.py",
      "patch": "@@ -2813,6 +2813,21 @@ def abort(self):\n         super().abort()\n         self.trace_ctx.abort(abort_info={\"reason\": \"Aborted\"})\n         self.trace_ctx.trace_req_finish()\n+        # notify decode side so it can abort the request immediately\n+        room = self.bootstrap_room\n+        infos = self.kv_mgr.transfer_infos.pop(room, None)\n+        if infos:\n+            for info in infos.values():\n+                try:\n+                    self.kv_mgr.sync_status_to_decode_endpoint(\n+                        info.endpoint,\n+                        info.dst_port,\n+                        room,\n+                        KVPoll.Failed,\n+                        self.kv_mgr.attn_tp_rank,\n+                    )\n+                except Exception:\n+                    pass\n \n \n class MooncakeKVReceiver(MooncakeFailureExceptionMixin, CommonKVReceiver):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9d6a779947fe97499e4eaa6ae24efa89e7dde807/python%2Fsglang%2Fsrt%2Fdisaggregation%2Fmooncake%2Fconn.py",
