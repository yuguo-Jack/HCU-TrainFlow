      "patch": "@@ -1865,6 +1865,7 @@ def init_kv_events_publisher(self) -> None:\n             send_metrics_from_scheduler=self.ipc_channels.send_metrics_from_scheduler,\n             max_running_requests=self.max_running_requests,\n             max_total_num_tokens=self.max_total_num_tokens,\n+            page_size=self.page_size,\n             get_stats=lambda: self.metrics_reporter.stats,\n         )\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bbc2d7e75b930f7e3d3480332d68583aaaca6aa2/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
