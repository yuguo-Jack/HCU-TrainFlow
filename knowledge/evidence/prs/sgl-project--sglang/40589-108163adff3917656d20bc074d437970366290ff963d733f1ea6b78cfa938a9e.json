    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/237258454eb92d4d7b7a895d7a8d7bb5d6d5317c/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fcompressed_tensors%2Fcompressed_tensors.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fcompressed_tensors%2Fcompressed_tensors.py?ref=237258454eb92d4d7b7a895d7a8d7bb5d6d5317c",
      "deletions": 3,
      "filename": "python/sglang/srt/layers/quantization/compressed_tensors/compressed_tensors.py",
      "patch": "@@ -416,9 +416,9 @@ def _check_scheme_supported(self, min_capability: int, error: bool = True) -> bo\n             supported = capability >= min_capability\n             if error and not supported:\n                 raise RuntimeError(\n-                    \"Quantization scheme is not supported for \",\n-                    f\"the current GPU. Min capability: {min_capability}. \",\n-                    f\"Current capability: {capability}.\",\n+                    \"Quantization scheme is not supported for \"\n+                    f\"the current GPU. Min capability: {min_capability}. \"\n+                    f\"Current capability: {capability}.\"\n                 )\n             return supported\n         else:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/237258454eb92d4d7b7a895d7a8d7bb5d6d5317c/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fcompressed_tensors%2Fcompressed_tensors.py",
      "sha": "54756ce712b282cef597f77115b159fd4cbef3ee",
      "status": "modified"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/sgl-project/sglang/blob/237258454eb92d4d7b7a895d7a8d7bb5d6d5317c/test%2Fregistered%2Funit%2Flayers%2Fquantization%2Ftest_compressed_tensors_config.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fquantization%2Ftest_compressed_tensors_config.py?ref=237258454eb92d4d7b7a895d7a8d7bb5d6d5317c",
      "deletions": 0,
      "filename": "test/registered/unit/layers/quantization/test_compressed_tensors_config.py",
      "patch": "@@ -0,0 +1,25 @@\n+\"\"\"CPU-only tests for compressed-tensors configuration helpers.\"\"\"\n+\n+from unittest.mock import patch\n+\n+import pytest\n+\n+from sglang.srt.layers.quantization.compressed_tensors.compressed_tensors import (\n+    CompressedTensorsConfig,\n+)\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+\n+def test_unsupported_capability_error_is_readable():\n+    config = CompressedTensorsConfig.__new__(CompressedTensorsConfig)\n+\n+    with patch(\"torch.cuda.get_device_capability\", return_value=(7, 5)):\n+        with pytest.raises(RuntimeError) as exc_info:\n+            config._check_scheme_supported(min_capability=80)\n+\n+    assert exc_info.value.args == (\n+        \"Quantization scheme is not supported for the current GPU. \"\n+        \"Min capability: 80. Current capability: 75.\",\n+    )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/237258454eb92d4d7b7a895d7a8d7bb5d6d5317c/test%2Fregistered%2Funit%2Flayers%2Fquantization%2Ftest_compressed_tensors_config.py",
      "sha": "612ae0a24d94d060df32917c9673b3bd5084eb53",
      "status": "added"
    }
