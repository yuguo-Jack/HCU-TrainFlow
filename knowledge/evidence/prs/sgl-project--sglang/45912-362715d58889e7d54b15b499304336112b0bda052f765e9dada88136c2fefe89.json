      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ae324ceea9afe5d981e27988af8b97c0318a932a/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdeepseek_v4_backend.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdeepseek_v4_backend.py?ref=ae324ceea9afe5d981e27988af8b97c0318a932a",
      "deletions": 4,
      "filename": "python/sglang/srt/layers/attention/deepseek_v4_backend.py",
      "patch": "@@ -3219,11 +3219,13 @@ def forward_low_ratio_sources(\n         if (\n             hoisted_req is not None\n             and hoisted_pos is not None\n-            and hoisted_pos.shape[0] == positions.shape[0]\n+            and hoisted_pos.shape[0] >= positions.shape[0]\n         ):\n-            # Bucket-sized under the prefill graph; an eager break sees the\n-            # live rows only and falls through.\n-            req, pos = hoisted_req, hoisted_pos\n+            # Bucket-sized under the prefill graph; an eager break sees only the\n+            # live rows, which lead them. In the late-layer tail forward_batch\n+            # still describes the full rows, so they cannot be rebuilt from it.\n+            num_rows = positions.shape[0]\n+            req, pos = hoisted_req[:num_rows], hoisted_pos[:num_rows]\n         else:\n             req = token_req_indices(forward_batch, num_tokens=positions.shape[0])\n             pos = positions",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ae324ceea9afe5d981e27988af8b97c0318a932a/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdeepseek_v4_backend.py",
      "sha": "41c33b61fc8f5539f8985776320466c8993bf8d1",
      "status": "modified"
    },
    {
      "additions": 45,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ae324ceea9afe5d981e27988af8b97c0318a932a/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v4.py",
      "changes": 59,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v4.py?ref=ae324ceea9afe5d981e27988af8b97c0318a932a",
      "deletions": 14,
      "filename": "python/sglang/srt/models/deepseek_v4.py",
      "patch": "@@ -849,6 +849,39 @@ def _low_ratio_sources_capture_stub(layer, x, q_lora, positions) -> None:\n )\n \n \n+def _low_ratio_sources_break(attn_backend, forward_batch) -> bool:\n+    \"\"\"Whether the ratio-1/2 sources run as an eager break: inside a breakable graph\n+    without two-level candidates, or in a decoder tail graph.\"\"\"\n+    return (\n+        forward_batch.forward_mode.is_extend()\n+        and is_in_breakable_cuda_graph()\n+        and (\n+            not getattr(attn_backend, \"low_ratio_prefill_graph\", False)\n+            or in_replay_tail_graph()\n+        )\n+    )\n+\n+\n+def deepseek_v4_write_tail_source_kv(layer, x, positions) -> None:\n+    # Like the sources: the eager compressor reads the live batch's rows, and the\n+    # backend marks the source layer at every replay.\n+    forward_batch = get_tc_piecewise_forward_context().forward_batch\n+    real_num_tokens = forward_batch.global_num_token_non_padded_cpu\n+    if real_num_tokens == 0:\n+        return\n+    get_attn_backend().write_tail_source_kv(\n+        layer=layer,\n+        x=x[:real_num_tokens],\n+        positions=positions[:real_num_tokens],\n+        forward_batch=forward_batch,\n+    )\n+\n+\n+bcg_deepseek_v4_write_tail_source_kv = eager_on_graph(True)(\n+    deepseek_v4_write_tail_source_kv\n+)\n+\n+\n def deepseek_v4_engram_hash_ids(hasher, input_ids: torch.Tensor) -> torch.Tensor:\n     # The hasher reads per-request rows, so it cannot run inside the CUDA graph.\n     forward_batch = get_tc_piecewise_forward_context().forward_batch\n@@ -2418,14 +2451,7 @@ def _forward_prepare(\n         if self.compress_ratio in (1, 2) and (\n             self.compressor is not None or self.indexer is not None\n         ):\n-            if (\n-                forward_batch.forward_mode.is_extend()\n-                and is_in_breakable_cuda_graph()\n-                and (\n-                    not getattr(attn_backend, \"low_ratio_prefill_graph\", False)\n-                    or in_replay_tail_graph()\n-                )\n-            ):\n+            if _low_ratio_sources_break(attn_backend, forward_batch):\n                 bcg_deepseek_v4_low_ratio_sources(self, x, q_lora, positions)\n             else:\n                 attn_backend.forward_low_ratio_sources(\n@@ -3972,12 +3998,17 @@ def _forward_layers_hc_pre_from_prev(\n                         source_x = fused_boundary_attn_input(source, state)\n                     else:\n                         source_x = mhc.combine(source.attn_hc, state)\n-                    attn_backend.write_tail_source_kv(\n-                        layer=source.self_attn,\n-                        x=source_x,\n-                        positions=positions,\n-                        forward_batch=forward_batch,\n-                    )\n+                    if _low_ratio_sources_break(attn_backend, forward_batch):\n+                        bcg_deepseek_v4_write_tail_source_kv(\n+                            source.self_attn, source_x, positions\n+                        )\n+                    else:\n+                        attn_backend.write_tail_source_kv(\n+                            layer=source.self_attn,\n+                            x=source_x,\n+                            positions=positions,\n+                            forward_batch=forward_batch,\n+                        )\n                 # Decode reaches back at most SWA_WINDOW positions.\n                 if tail_in_graph:\n                     # Eager break: re-run at replay so the backend swaps onto the",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ae324ceea9afe5d981e27988af8b97c0318a932a/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v4.py",
      "sha": "4674e99946c1eba93c136830324479dce05e7566",
      "status": "modified"
    },
    {
      "additions": 45,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ae324ceea9afe5d981e27988af8b97c0318a932a/test%2Fregistered%2Funit%2Flayers%2Ftest_dsv41_late_layer_tail_readers.py",
      "changes": 45,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Ftest_dsv41_late_layer_tail_readers.py?ref=ae324ceea9afe5d981e27988af8b97c0318a932a",
      "deletions": 0,
      "filename": "test/registered/unit/layers/test_dsv41_late_layer_tail_readers.py",
      "patch": "@@ -273,6 +273,51 @@ def idle_peer(out, local, group):\n             self.assertEqual(counts, [SWA_WINDOW, 0])\n \n \n+class TestTailSourceRows(CustomTestCase):\n+    \"\"\"An eager ratio-1/2 source break in the prefill graph's late-layer tail gets\n+    the tail's live rows, while forward_batch still describes the whole extend.\"\"\"\n+\n+    def test_eager_break_takes_the_leading_hoisted_rows(self):\n+        extend, block = 1792, 1792\n+        tail_pos = torch.arange(extend - SWA_WINDOW, extend)\n+        backend = object.__new__(DeepseekV4AttnBackend)\n+        backend.tail_source_kv_layer_id = None\n+        backend.low_ratios = (1, 2)\n+        backend.prefill_candidates = object()\n+        # The tail block: the live rows first, then padding rows.\n+        backend.forward_metadata = SimpleNamespace(\n+            low_ratio_req_indices=torch.cat(\n+                [torch.full((SWA_WINDOW,), 3), torch.full((block - SWA_WINDOW,), 9)]\n+            ),\n+            low_ratio_pos_i64=torch.cat(\n+                [tail_pos, torch.zeros(block - SWA_WINDOW, dtype=torch.int64)]\n+            ),\n+        )\n+        seen = {}\n+        backend._low_ratio_compress = lambda layer, x, req, pos, fb: seen.update(\n+            req=req, pos=pos\n+        )\n+        forward_batch = SimpleNamespace(\n+            forward_mode=ForwardMode.EXTEND,\n+            encoder_swa_replay=False,\n+            attn_cp_metadata=None,\n+            req_pool_indices=torch.tensor([3]),\n+            extend_seq_lens=torch.tensor([extend]),\n+        )\n+        with patch.object(\n+            deepseek_v4_backend, \"dsa_use_prefill_cp\", return_value=False\n+        ):\n+            backend.forward_low_ratio_sources(\n+                layer=SimpleNamespace(layer_id=20, compressor=object(), indexer=None),\n+                x=torch.zeros(SWA_WINDOW, 4),\n+                q_lora=None,\n+                positions=tail_pos,\n+                forward_batch=forward_batch,\n+            )\n+        self.assertTrue(torch.equal(seen[\"req\"], torch.full((SWA_WINDOW,), 3)))\n+        self.assertTrue(torch.equal(seen[\"pos\"], tail_pos))\n+\n+\n def _prefill_graph_replay(*, any_context, seq_len):\n     \"\"\"The backend's default replayed-context limit and the widths a replay gives\n     the full-row and tail metadata, for one request of ``seq_len`` tokens.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ae324ceea9afe5d981e27988af8b97c0318a932a/test%2Fregistered%2Funit%2Flayers%2Ftest_dsv41_late_layer_tail_readers.py",
      "sha": "1fcc12afb254c5c9575f233867704679d18ced7e",
      "status": "modified"
    }
