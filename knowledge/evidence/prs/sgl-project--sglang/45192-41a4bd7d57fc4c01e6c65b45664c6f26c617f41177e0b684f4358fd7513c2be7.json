      "changes": 14,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fserver_args%2Fserver_args.py?ref=61ef556a063e261e1696bd0ed09189cb8ab7b2f7",
      "deletions": 2,
      "filename": "python/sglang/multimodal_gen/runtime/server_args/server_args.py",
      "patch": "@@ -12,6 +12,7 @@\n import random\n import sys\n import tempfile\n+from collections.abc import Mapping\n from dataclasses import field\n from enum import Enum\n from typing import Any, List, Literal, Optional\n@@ -3731,7 +3732,7 @@ def load_config_file(config_file: str) -> dict[str, Any]:\n         \"\"\"Load a config file.\"\"\"\n         if config_file.endswith(\".json\"):\n             with open(config_file, \"r\") as f:\n-                return json.load(f)\n+                config = json.load(f)\n         elif config_file.endswith((\".yaml\", \".yml\")):\n             try:\n                 import yaml\n@@ -3741,10 +3742,19 @@ def load_config_file(config_file: str) -> dict[str, Any]:\n                     \"`pip install pyyaml`\"\n                 )\n             with open(config_file, \"r\") as f:\n-                return yaml.safe_load(f)\n+                config = yaml.safe_load(f)\n         else:\n             raise ValueError(f\"Unsupported config file format: {config_file}\")\n \n+        if config is None:\n+            return {}\n+        if not isinstance(config, Mapping):\n+            raise ValueError(\n+                f\"The config file must contain a mapping, got {type(config).__name__}: \"\n+                f\"{config_file}\"\n+            )\n+        return dict(config)\n+\n     @classmethod\n     def from_kwargs(cls, **kwargs: Any) -> \"ServerArgs\":\n         cls._reject_retired_args(kwargs)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/61ef556a063e261e1696bd0ed09189cb8ab7b2f7/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fserver_args%2Fserver_args.py",
      "sha": "fef66482e3843187b8a09d4297c49c5bdf404bf4",
      "status": "modified"
    },
    {
      "additions": 84,
      "blob_url": "https://github.com/sgl-project/sglang/blob/61ef556a063e261e1696bd0ed09189cb8ab7b2f7/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_server_args.py",
      "changes": 84,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_server_args.py?ref=61ef556a063e261e1696bd0ed09189cb8ab7b2f7",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_server_args.py",
      "patch": "@@ -930,6 +930,90 @@ def test_serve_cli_preserves_config_and_dynamic_unknown_args(self):\n             server_args.component_quantization_ignored_layers,\n         )\n \n+    def test_load_config_file_normalizes_empty_documents(self):\n+        for suffix, contents in (\n+            (\".yaml\", \"\"),\n+            (\".yaml\", \"# comment only\\n\"),\n+            (\".yaml\", \"null\\n\"),\n+            (\".json\", \"null\"),\n+        ):\n+            with self.subTest(suffix=suffix, contents=contents):\n+                with tempfile.NamedTemporaryFile(\"w\", suffix=suffix) as config_file:\n+                    config_file.write(contents)\n+                    config_file.flush()\n+                    self.assertEqual(ServerArgs.load_config_file(config_file.name), {})\n+\n+    def test_load_config_file_rejects_non_mapping_documents(self):\n+        for suffix, contents in (\n+            (\".yaml\", \"[]\\n\"),\n+            (\".yaml\", \"[value]\\n\"),\n+            (\".yaml\", \"text\\n\"),\n+            (\".yaml\", \"0\\n\"),\n+            (\".yaml\", \"false\\n\"),\n+            (\".yaml\", \"''\\n\"),\n+            (\".json\", \"[]\"),\n+            (\".json\", \"[1]\"),\n+            (\".json\", '\"text\"'),\n+            (\".json\", \"0\"),\n+            (\".json\", \"false\"),\n+            (\".json\", '\"\"'),\n+        ):\n+            with self.subTest(suffix=suffix, contents=contents):\n+                with tempfile.NamedTemporaryFile(\"w\", suffix=suffix) as config_file:\n+                    config_file.write(contents)\n+                    config_file.flush()\n+                    with self.assertRaisesRegex(\n+                        ValueError, \"config file must contain a mapping\"\n+                    ):\n+                        ServerArgs.load_config_file(config_file.name)\n+\n+    def test_load_config_file_preserves_mapping_documents(self):\n+        for suffix, contents in (\n+            (\".yaml\", \"model_path: /from/yaml\\nnum_gpus: 2\\n\"),\n+            (\".json\", '{\"model_path\": \"/from/json\", \"num_gpus\": 2}'),\n+        ):\n+            with self.subTest(suffix=suffix):\n+                with tempfile.NamedTemporaryFile(\"w\", suffix=suffix) as config_file:\n+                    config_file.write(contents)\n+                    config_file.flush()\n+                    self.assertEqual(\n+                        ServerArgs.load_config_file(config_file.name),\n+                        {\n+                            \"model_path\": f\"/from/{suffix.removeprefix('.')}\",\n+                            \"num_gpus\": 2,\n+                        },\n+                    )\n+\n+    def test_load_config_file_preserves_existing_errors(self):\n+        with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\") as config_file:\n+            with self.assertRaises(json.JSONDecodeError):\n+                ServerArgs.load_config_file(config_file.name)\n+\n+        with self.assertRaises(FileNotFoundError):\n+            ServerArgs.load_config_file(\"/missing/config.json\")\n+\n+        with self.assertRaisesRegex(ValueError, \"Unsupported config file format\"):\n+            ServerArgs.load_config_file(\"config.toml\")\n+\n+    def test_cli_rejects_non_mapping_config_before_merge(self):\n+        from sglang.multimodal_gen.runtime.entrypoints.cli.serve import (\n+            add_multimodal_gen_serve_args,\n+        )\n+\n+        with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\") as config_file:\n+            config_file.write(\"false\")\n+            config_file.flush()\n+            parser = FlexibleArgumentParser()\n+            add_multimodal_gen_serve_args(parser)\n+            argv = [\"--config\", config_file.name, \"--model-path\", \"/from/cli\"]\n+\n+            with patch.object(sys, \"argv\", [\"sglang\"] + argv):\n+                args, unknown_args = parser.parse_known_args(argv)\n+                with self.assertRaisesRegex(\n+                    ValueError, \"co