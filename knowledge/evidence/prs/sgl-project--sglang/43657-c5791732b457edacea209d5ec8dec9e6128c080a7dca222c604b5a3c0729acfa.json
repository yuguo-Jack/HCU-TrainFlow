  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/d590f63e949813a503d636d1b78a7c98b36e5bc7/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fkda_prefill_graph_track.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fkda_prefill_graph_track.py?ref=d590f63e949813a503d636d1b78a7c98b36e5bc7",
      "deletions": 6,
      "filename": "python/sglang/kernels/ops/attention/fla/kda_prefill_graph_track.py",
      "patch": "@@ -78,16 +78,16 @@ def _kda_track_ssm_kernel(\n     dst = tl.load(track_dst + r).to(tl.int64)\n     offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)\n     mask = offs < numel\n+    # Both branches yield the pool dtype: h_track is fp32 while the pool may\n+    # be bf16 (--mamba-ssm-dtype bfloat16).\n     if mode == 1:\n         src = tl.load(cache_indices + r).to(tl.int64)\n         val = tl.load(ssm_pool + src * stride_ssm_slot + offs, mask=mask)\n     else:\n-        val = tl.load(h_track + r.to(tl.int64) * stride_h_row + offs, mask=mask)\n-    tl.store(\n-        ssm_pool + dst * stride_ssm_slot + offs,\n-        val.to(ssm_pool.dtype.element_ty),\n-        mask=mask,\n-    )\n+        val = tl.load(h_track + r.to(tl.int64) * stride_h_row + offs, mask=mask).to(\n+            ssm_pool.dtype.element_ty\n+        )\n+    tl.store(ssm_pool + dst * stride_ssm_slot + offs, val, mask=mask)\n \n \n def kda_track_conv_window(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d590f63e949813a503d636d1b78a7c98b36e5bc7/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Ffla%2Fkda_prefill_graph_track.py",
      "sha": "4dbae519e66c3723a19cd42c2bf4e19b58bc0267",
      "status": "modified"
    },
    {
      "additions": 55,
      "blob_url": "https://github.com/sgl-project/sglang/blob/d590f63e949813a503d636d1b78a7c98b36e5bc7/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_kda_prefill_graph_track.py",
      "changes": 55,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_kda_prefill_graph_track.py?ref=d590f63e949813a503d636d1b78a7c98b36e5bc7",
      "deletions": 0,
      "filename": "test/registered/kernels/ops/attention/test_kda_prefill_graph_track.py",
      "patch": "@@ -0,0 +1,55 @@\n+\"\"\"Track copies of the CUDA-graph captured KDA extend against a torch reference.\n+\n+Mode 1 rows copy the row's own pool slot, mode 2 rows copy their fp32\n+chunk-boundary snapshot, mode 0 rows leave their destination untouched. The\n+pool is checked in fp32 and bf16 (--mamba-ssm-dtype bfloat16).\n+\"\"\"\n+\n+import unittest\n+\n+import torch\n+\n+from sglang.kernels.ops.attention.fla.kda_prefill_graph_track import (\n+    TRACK_CHUNK_STATE,\n+    TRACK_FINAL_STATE,\n+    TRACK_NONE,\n+    kda_track_ssm_state,\n+)\n+from sglang.test.ci.ci_register import register_cuda_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cuda_ci(est_time=10, stage=\"base-b-kernel-unit\", runner_config=\"1-gpu-large\")\n+\n+\n+@unittest.skipUnless(torch.cuda.is_available(), \"CUDA required\")\n+class TestKdaTrackSsmState(CustomTestCase):\n+    def _check(self, pool_dtype):\n+        torch.manual_seed(0)\n+        slots, heads, dim = 12, 4, 128\n+        pool = torch.randn(slots, heads, dim, dim, device=\"cuda\").to(pool_dtype)\n+        h_track = torch.randn(4, heads, dim, dim, device=\"cuda\", dtype=torch.float32)\n+        mode = torch.tensor(\n+            [TRACK_FINAL_STATE, TRACK_CHUNK_STATE, TRACK_NONE, TRACK_CHUNK_STATE],\n+            device=\"cuda\",\n+            dtype=torch.int32,\n+        )\n+        dst = torch.tensor([8, 9, 10, 11], device=\"cuda\", dtype=torch.int64)\n+        cache_indices = torch.tensor([1, 2, 3, 4], device=\"cuda\", dtype=torch.int32)\n+        expected = pool.clone()\n+        expected[8] = pool[1]\n+        expected[9] = h_track[1].to(pool_dtype)\n+        expected[11] = h_track[3].to(pool_dtype)\n+\n+        kda_track_ssm_state(pool, h_track, mode, dst, cache_indices)\n+        torch.cuda.synchronize()\n+        torch.testing.assert_close(pool, expected, rtol=0, atol=0)\n+\n+    def test_fp32_pool(self):\n+        self._check(torch.float32)\n+\n+    def test_bf16_pool(self):\n+        self._check(torch.bfloat16)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/d590f63e949813a503d636d1b78a7c98b36e5bc7/test%2Fregistered%2Fkernels%2Fops%2Fattention%2Ftest_kda_prefill_graph_track.py",
      "sha": "5898d0a728361be979a63e91c7e45d9f51e916ec",
      "status": "added"
    }
