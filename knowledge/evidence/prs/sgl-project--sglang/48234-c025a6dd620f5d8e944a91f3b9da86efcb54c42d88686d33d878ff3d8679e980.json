    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0ae98612d2023274b0a436d1ae71b05226773300/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v2.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v2.py?ref=0ae98612d2023274b0a436d1ae71b05226773300",
      "deletions": 0,
      "filename": "python/sglang/srt/models/deepseek_v2.py",
      "patch": "@@ -2638,8 +2638,12 @@ def q_b_proj_replicated_forward(self, x: torch.Tensor) -> torch.Tensor:\n \n     def q_b_proj_forward(self, q_lora: torch.Tensor) -> torch.Tensor:\n         if self._use_min_latency_q_b_gemm is None:\n+            # Like the fused QKV-A GEMM in prepare_qkv_latent: the min-latency\n+            # kernel only serves M <= 16, so a token's q would depend on the\n+            # batch size under deterministic inference.\n             self._use_min_latency_q_b_gemm = (\n                 self._q_b_proj_verified_shape\n+                and not get_exec().deterministic.enable_deterministic_inference\n                 and fused_a_gemm_weight_eligible(\n                     self.q_b_proj, backend=self.fused_a_gemm_backend\n                 )",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0ae98612d2023274b0a436d1ae71b05226773300/python%2Fsglang%2Fsrt%2Fmodels%2Fdeepseek_v2.py",
      "sha": "1bd8c14126f707fdcd3effcd1fdade79582ddc02",
      "status": "modified"
    },
    {
      "additions": 79,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0ae98612d2023274b0a436d1ae71b05226773300/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_q_b_proj_deterministic.py",
      "changes": 79,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_q_b_proj_deterministic.py?ref=0ae98612d2023274b0a436d1ae71b05226773300",
      "deletions": 0,
      "filename": "test/registered/unit/models/test_deepseek_q_b_proj_deterministic.py",
      "patch": "@@ -0,0 +1,79 @@\n+\"\"\"Hermetic unit tests: deterministic inference keeps q_b_proj on one GEMM.\n+\n+`q_b_proj_forward` sends 1 <= M <= 16 rows to the min-latency\n+`dsv3_fused_a_gemm` for verified q_b_proj weight shapes and larger M to the\n+regular linear. The two kernels round differently, so under deterministic\n+inference a token's q (and its logprobs) would depend on how many tokens share\n+the forward pass. `prepare_qkv_latent` already turns its min-latency GEMM off\n+in that mode; this pins the same for q_b_proj.\n+\n+Pure Python (no GPU, no model weights): the eligibility check, the fused GEMM\n+and `get_exec` are patched; `attn` is a lightweight fake.\n+\"\"\"\n+\n+import unittest\n+from types import SimpleNamespace\n+from unittest import mock\n+\n+import torch\n+\n+from sglang.srt.models import deepseek_v2\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+def _fake_attn():\n+    return SimpleNamespace(\n+        _use_min_latency_q_b_gemm=None,\n+        _q_b_proj_verified_shape=True,\n+        q_b_proj=lambda x: (torch.zeros(x.shape[0], 8), None),\n+        fused_a_gemm_backend=\"auto\",\n+        num_local_heads=2,\n+        qk_head_dim=4,\n+    )\n+\n+\n+def _exec(deterministic: bool):\n+    return SimpleNamespace(\n+        deterministic=SimpleNamespace(enable_deterministic_inference=deterministic)\n+    )\n+\n+\n+class TestQBProjMinLatencyGemm(CustomTestCase):\n+    def _forward(self, deterministic: bool, rows: int):\n+        attn = _fake_attn()\n+        with (\n+            mock.patch.object(\n+                deepseek_v2, \"get_exec\", return_value=_exec(deterministic)\n+            ),\n+            mock.patch.object(\n+                deepseek_v2, \"fused_a_gemm_weight_eligible\", return_value=True\n+            ),\n+            mock.patch.object(\n+                deepseek_v2,\n+                \"linear_with_fused_a_gemm\",\n+                side_effect=lambda layer, x, backend: torch.ones(x.shape[0], 8),\n+            ) as fused,\n+        ):\n+            q = deepseek_v2.DeepseekV2AttentionMLA.q_b_proj_forward(\n+                attn, torch.zeros(rows, 16)\n+            )\n+        return attn._use_min_latency_q_b_gemm, fused.called, tuple(q.shape)\n+\n+    def test_min_latency_gemm_used_by_default(self):\n+        enabled, called, shape = self._forward(deterministic=False, rows=4)\n+        self.assertTrue(enabled)\n+        self.assertTrue(called)\n+        self.assertEqual(shape, (4, 2, 4))\n+\n+    def test_deterministic_inference_disables_min_latency_gemm(self):\n+        enabled, called, shape = self._forward(deterministic=True, rows=4)\n+        self.assertFalse(enabled)\n+        self.assertFalse(called)\n+        self.assertEqual(shape, (4, 2, 4))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0ae98612d2023274b0a436d1ae71b05226773300/test%2Fregistered%2Funit%2Fmodels%2Ftest_deepseek_q_b_proj_deterministic.py",
      "sha": "f918c6b54eba65cca012d8539f4a4dc43e4dcc6f",
      "status": "added"
    }
