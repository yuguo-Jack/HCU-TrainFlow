  "files": [
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/efdc71b1a2e0183bd05607e949ebcb5e0638ca25/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmanagers%2Fmemory_managers%2Fcomponent_manager.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmanagers%2Fmemory_managers%2Fcomponent_manager.py?ref=efdc71b1a2e0183bd05607e949ebcb5e0638ca25",
      "deletions": 5,
      "filename": "python/sglang/multimodal_gen/runtime/managers/memory_managers/component_manager.py",
      "patch": "@@ -935,14 +935,14 @@ def _empty_cache_after_large_release(\n             return\n         if self._keep_ready_component_on_cuda():\n             return\n+        # Layerwise buffers are re-reserved by the next use of the same component;\n+        # returning them to the driver only adds cudaFree/cudaMalloc to every request.\n+        if isinstance(strategy, LayerwiseOffloadStrategy):\n+            return\n         released_device_storage = (\n             was_on_supported_device and not self._module_on_supported_device(module)\n         )\n-        released_layerwise_storage = isinstance(strategy, LayerwiseOffloadStrategy)\n-        should_empty_component_cache = (\n-            released_device_storage and not current_platform.is_npu()\n-        )\n-        if not (should_empty_component_cache or released_layerwise_storage):\n+        if not (released_device_storage and not current_platform.is_npu()):\n             return\n         if not torch.get_device_module().is_available():\n             return",
      "raw_url": "https://github.com/sgl-project/sglang/raw/efdc71b1a2e0183bd05607e949ebcb5e0638ca25/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmanagers%2Fmemory_managers%2Fcomponent_manager.py",
      "sha": "d4eff6952174e50600fccfb671bfe104fa761282",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/sgl-project/sglang/blob/efdc71b1a2e0183bd05607e949ebcb5e0638ca25/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_layerwise_offload.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_layerwise_offload.py?ref=efdc71b1a2e0183bd05607e949ebcb5e0638ca25",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_layerwise_offload.py",
      "patch": "@@ -3139,3 +3139,35 @@ def test_finish_offload_writeback_is_noop_when_idle():\n     )\n \n     finish_offload_writeback()\n+\n+\n+@pytest.mark.parametrize(\n+    \"strategy, was_on_device, still_on_device, expected_calls\",\n+    [\n+        (LayerwiseOffloadStrategy(), True, True, 0),\n+        (LayerwiseOffloadStrategy(), True, False, 0),\n+        (ComponentOffloadStrategy(), True, False, 1),\n+        (ComponentOffloadStrategy(), True, True, 0),\n+    ],\n+    ids=[\"layerwise\", \"layerwise-moved\", \"component-moved\", \"component-resident\"],\n+)\n+def test_large_release_keeps_layerwise_buffers_cached(\n+    monkeypatch, strategy, was_on_device, still_on_device, expected_calls\n+):\n+    device_module = SimpleNamespace(is_available=lambda: True, empty_cache=Mock())\n+    monkeypatch.setattr(torch, \"get_device_module\", lambda: device_module)\n+    manager = SimpleNamespace(\n+        _keep_ready_component_on_cuda=lambda: False,\n+        _module_on_supported_device=lambda module: still_on_device,\n+    )\n+    use = ComponentUse(\n+        stage_name=\"DenoisingStage\",\n+        component_name=\"transformer\",\n+        memory_intensive=True,\n+    )\n+\n+    ComponentResidencyManager._empty_cache_after_large_release(\n+        manager, use, strategy, torch.nn.Linear(2, 2), was_on_device\n+    )\n+\n+    assert device_module.empty_cache.call_count == expected_calls",
      "raw_url": "https://github.com/sgl-project/sglang/raw/efdc71b1a2e0183bd05607e949ebcb5e0638ca25/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_layerwise_offload.py",
      "sha": "21327893539cf92b545479e3e403e8d344964f31",
      "status": "modified"
    }
