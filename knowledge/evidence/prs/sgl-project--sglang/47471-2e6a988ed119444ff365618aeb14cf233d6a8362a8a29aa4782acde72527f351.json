      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/463bcd83a6d2f764afddd90d2c2147955c1977af/docs%2Fdocs%2Fdeveloper_guide%2Fbenchmark_and_profiling.mdx",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fdocs%2Fdeveloper_guide%2Fbenchmark_and_profiling.mdx?ref=463bcd83a6d2f764afddd90d2c2147955c1977af",
      "deletions": 0,
      "filename": "docs/docs/developer_guide/benchmark_and_profiling.mdx",
      "patch": "@@ -52,6 +52,14 @@ Use `bench_serving` by default unless there are specific needs.\n   python3 -m sglang.bench_serving --backend sglang --max-concurrency 16 --num-prompts 80 --random-input-len 256 --random-output-len 32 --dataset-name random\n   ```\n \n+When choosing random inputs for `python3 -m sglang.benchmark.serving`:\n+\n+- `--dataset-name random` samples tokens from ShareGPT and repeats or truncates them to the requested input lengths. It downloads ShareGPT from Hugging Face unless you provide a valid local ShareGPT JSON file with `--dataset-path`.\n+- `--dataset-name random --dataset-path /path/to/sharegpt.json` uses your local ShareGPT data without downloading the dataset.\n+- `--dataset-name random-ids` generates token IDs directly, without downloading a dataset. It produces a different input distribution from `random`; choose it explicitly rather than treating the two as interchangeable in benchmark comparisons.\n+\n+These options apply to the benchmark client on CPU, regardless of the server's hardware. For a fully offline run, you also need a running local server and locally available model and tokenizer files; use `--tokenizer /path/to/tokenizer` to load the client's tokenizer locally. Avoiding the dataset download alone does not make the entire benchmark offline.\n+\n **`bench_one_batch_server`** sends a single batch as one HTTP request to a running server. Due to only having a single batch, the server is never in a steady-state and metrics will be biased. Launch a server with `sglang.launch_server` first.\n \n   ```bash Command",
      "raw_url": "https://github.com/sgl-project/sglang/raw/463bcd83a6d2f764afddd90d2c2147955c1977af/docs%2Fdocs%2Fdeveloper_guide%2Fbenchmark_and_profiling.mdx",
      "sha": "67e3f686e2d0449b62ab904cedaca1025d0f1182",
      "status": "modified"
    },
    {
      "additions": 13,
      "blob_url": "https://github.com/sgl-project/sglang/blob/463bcd83a6d2f764afddd90d2c2147955c1977af/python%2Fsglang%2Fbenchmark%2Fdatasets%2Frandom.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fbenchmark%2Fdatasets%2Frandom.py?ref=463bcd83a6d2f764afddd90d2c2147955c1977af",
      "deletions": 4,
      "filename": "python/sglang/benchmark/datasets/random.py",
      "patch": "@@ -86,10 +86,19 @@ def sample_random_requests(\n \n         # Download sharegpt if necessary\n         if not is_file_valid_json(dataset_path):\n-            dataset_path = download_and_cache_hf_file(\n-                repo_id=SHAREGPT_REPO_ID,\n-                filename=SHAREGPT_FILENAME,\n-            )\n+            try:\n+                dataset_path = download_and_cache_hf_file(\n+                    repo_id=SHAREGPT_REPO_ID,\n+                    filename=SHAREGPT_FILENAME,\n+                )\n+            except Exception as exc:\n+                exc.add_note(\n+                    \"The 'random' dataset samples tokens from ShareGPT. \"\n+                    \"Provide a local ShareGPT JSON file with --dataset-path, \"\n+                    \"or use --dataset-name random-ids to generate token IDs \"\n+                    \"without downloading a dataset.\"\n+                )\n+                raise\n \n         # Load the dataset.\n         with open(dataset_path) as f:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/463bcd83a6d2f764afddd90d2c2147955c1977af/python%2Fsglang%2Fbenchmark%2Fdatasets%2Frandom.py",
      "sha": "19f9b130cde47c1b888b89165b970d251a5b639d",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/sgl-project/sglang/blob/463bcd83a6d2f764afddd90d2c2147955c1977af/python%2Fsglang%2Fbenchmark%2Fserving.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fbenchmark%2Fserving.py?ref=463bcd83a6d2f764afddd90d2c2147955c1977af",
      "deletions": 2,
      "filename": "python/sglang/benchmark/serving.py",
      "patch": "@@ -2342,10 +2342,17 @@ def cli_main():\n             \"longbench_v2\",\n             \"speed-bench\",\n         ],\n-        help=\"Name of the dataset to benchmark on.\",\n+        help=(\n+            \"Name of the dataset to benchmark on. 'random' samples tokens from \"\n+            \"ShareGPT (downloaded from Hugging Face unless --dataset-path is \"\n+            \"provided). 'random-ids' generates token IDs without a dataset download.\"\n+        ),\n     )\n     parser.add_argument(\n-        \"--dataset-path\", type=str, default=\"\", help=\"Path to the dataset.\"\n+        \"--dataset-path\",\n+        type=str,\n+        default=\"\",\n+        help=\"Path to the dataset. For 'random', provide a local ShareGPT JSON file to avoid downloading it.\",\n     )\n     parser.add_argument(\n         \"--dataset-offset\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/463bcd83a6d2f764afddd90d2c2147955c1977af/python%2Fsglang%2Fbenchmark%2Fserving.py",
      "sha": "a956c094b0203342ef0c930c5935d9cba615b3c7",
