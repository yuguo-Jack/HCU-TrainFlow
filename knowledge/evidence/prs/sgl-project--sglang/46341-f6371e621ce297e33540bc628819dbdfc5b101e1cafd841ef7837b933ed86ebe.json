      "blob_url": "https://github.com/sgl-project/sglang/blob/da2c7797c991c6f89fc2394ca9b69bd15fdc4064/scripts%2Fci%2Fcuda%2Fci_install_dependency.sh",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/scripts%2Fci%2Fcuda%2Fci_install_dependency.sh?ref=da2c7797c991c6f89fc2394ca9b69bd15fdc4064",
      "deletions": 1,
      "filename": "scripts/ci/cuda/ci_install_dependency.sh",
      "patch": "@@ -86,7 +86,10 @@ configure_environment() {\n         uv venv \"$UV_VENV\" --python \"$CI_PYTHON_VER\" --python-preference only-managed --seed\n     else\n         # Kept across jobs so installs stay incremental and path-keyed JIT caches hit.\n-        UV_VENV=\"/opt/sglang-ci-py${CI_PYTHON_VER}\"\n+        # A runner can keep it off a slow root disk; not SGLANG_CI_VENV_PATH, which\n+        # ci_cleanup_venv.sh deletes.\n+        UV_VENV=\"${SGLANG_CI_KEPT_VENV_DIR:-/opt/sglang-ci-py${CI_PYTHON_VER}}\"\n+        mkdir -p \"$(dirname \"$UV_VENV\")\"\n         # A cancelled install leaves dist-info that later installs treat as satisfied;\n         # rebuild unless the last install ran to completion.\n         UV_VENV_COMPLETE_MARKER=\"$UV_VENV/.install-complete\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/da2c7797c991c6f89fc2394ca9b69bd15fdc4064/scripts%2Fci%2Fcuda%2Fci_install_dependency.sh",
      "sha": "c1f669119cda1e287c3872657c57e02af0995981",
