    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2aa83bba1df0bc31385409b4150ba846c88c29e2/python%2Fsglang%2Fsrt%2Fspeculative%2Fdspark_components%2Fdspark_verify.py",
      "changes": 2,
