    {
      "additions": 40,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5b8a756475fd2b438e10e168bbdc99746ee3feea/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gemma4_detector_finish.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gemma4_detector_finish.py?ref=5b8a756475fd2b438e10e168bbdc99746ee3feea",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_gemma4_detector_finish.py",
      "patch": "@@ -0,0 +1,40 @@\n+\"\"\"Unit tests for Gemma4Detector finish() flush - no server, no model loading.\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.function_call.gemma4_detector import Gemma4Detector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n+\n+\n+class TestGemma4DetectorFinishFlush(unittest.TestCase):\n+    def setUp(self):\n+        self.d = Gemma4Detector()\n+        self.start = self.d.tool_call_start_token\n+\n+    def test_partial_tool_call_at_end_is_flushed(self):\n+        feed = \"hi \" + self.start + \"call:get_weather{city:\"\n+        r1 = self.d.parse_streaming_increment(feed, tools=[])\n+        self.assertEqual(r1.normal_text, \"hi \")\n+        self.assertNotEqual(self.d._buffer, \"\")\n+        r2 = self.d.finish([])\n+        self.assertNotEqual(r2.normal_text, \"\")\n+\n+    def test_clean_stream_finish_is_noop(self):\n+        self.d.parse_streaming_increment(\"just some text\", tools=[])\n+        r = self.d.finish([])\n+        self.assertEqual(r.normal_text, \"\")\n+        self.assertEqual(len(r.calls), 0)\n+\n+    def test_complete_call_not_duplicated_at_finish(self):\n+        eot = self.d.tool_call_end_token\n+        full = self.start + \"call:get_weather{city: 'Paris'}\" + eot\n+        self.d.parse_streaming_increment(full, tools=[])\n+        self.assertEqual(self.d._buffer, \"\")\n+        r = self.d.finish([])\n+        self.assertEqual(r.normal_text, \"\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5b8a756475fd2b438e10e168bbdc99746ee3feea/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gemma4_detector_finish.py",
      "sha": "e2d8c2a33c2c2d5cc84a5b9f788800ef44ccf621",
      "status": "added"
    },
    {
      "additions": 42,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5b8a756475fd2b438e10e168bbdc99746ee3feea/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_inkling_detector_finish.py",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_inkling_detector_finish.py?ref=5b8a756475fd2b438e10e168bbdc99746ee3feea",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_inkling_detector_finish.py",
      "patch": "@@ -0,0 +1,42 @@\n+\"\"\"Unit tests for InklingDetector finish() flush - no server, no model loading.\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.function_call.inkling_detector import InklingDetector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n+\n+\n+class TestInklingDetectorFinishFlush(unittest.TestCase):\n+    def setUp(self):\n+        self.d = InklingDetector()\n+        self.bot = self.d.bot_token\n+\n+    def test_partial_tool_call_at_end_is_flushed(self):\n+        feed = \"hi \" + self.bot + \"get_weather(city=\"\n+        r1 = self.d.parse_streaming_increment(feed, tools=[])\n+        self.assertEqual(r1.normal_text, \"hi \")\n+        self.assertNotEqual(self.d._buffer, \"\")\n+        r2 = self.d.finish([])\n+        self.assertIn(\"get_weather\", r2.normal_text)\n+\n+    def test_clean_stream_finish_is_noop(self):\n+        self.d.parse_streaming_increment(\"just some text\", tools=[])\n+        r = self.d.finish([])\n+        self.assertEqual(r.normal_text, \"\")\n+        self.assertEqual(len(r.calls), 0)\n+\n+    def test_complete_call_not_duplicated_at_finish(self):\n+        eot = self.d.eot_token\n+        full = (\n+            self.bot + '{\"name\": \"get_weather\", \"arguments\": {\"city\": \"Paris\"}}' + eot\n+        )\n+        self.d.parse_streaming_increment(full, tools=[])\n+        self.assertEqual(self.d._buffer, \"\")\n+        r = self.d.finish([])\n+        self.assertEqual(r.normal_text, \"\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5b8a756475fd2b438e10e168bbdc99746ee3feea/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_inkling_detector_finish.py",
      "sha": "7d58ba44846f725a4a75a7360be6dfe0167cb6d3",
      "status": "added"
    },
