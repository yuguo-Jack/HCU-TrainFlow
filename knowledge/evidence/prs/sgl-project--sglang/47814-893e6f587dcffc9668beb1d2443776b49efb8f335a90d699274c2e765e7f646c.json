      "blob_url": "https://github.com/sgl-project/sglang/blob/ff92e6f8e9500bca44eb5885210adfce851350c5/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Faiter_backend.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Faiter_backend.py?ref=ff92e6f8e9500bca44eb5885210adfce851350c5",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/attention/aiter_backend.py",
      "patch": "@@ -84,7 +84,7 @@\n from sglang.kernels.ops.attention.pad import pad_sequence_with_mask\n from sglang.kernels.ops.kvcache.cache_ops import launch_reshape_and_cache_flash\n from sglang.kernels.ops.quantization.fp8_kernel import fp8_dtype, scaled_fp8_quant\n-from sglang.srt.configs.model_config import AttentionArch\n+from sglang.srt.configs.model_config import AttentionArch, dsa_draft_shards_under_dcp\n from sglang.srt.environ import envs\n from sglang.srt.layers.attention.aiter_mla_gluon import (\n     log_mla_gluon_capability,\n@@ -421,6 +421,12 @@ def __init__(\n         self.use_mla = model_runner.model_config.attention_arch == AttentionArch.MLA\n \n         self.dcp_world_size = get_parallel().attn_dcp_size\n+        self._reject_mla_draft_under_dcp(\n+            use_mla=self.use_mla,\n+            dcp_world_size=self.dcp_world_size,\n+            is_draft_worker=model_runner.is_draft_worker,\n+            model_config=model_runner.model_config,\n+        )\n         self.mla_decode_backend = envs.SGLANG_AITER_MLA_DECODE_BACKEND.get().lower()\n         if self.mla_decode_backend not in (\"gluon\", \"asm\"):\n             raise ValueError(\n@@ -3655,6 +3661,25 @@ def _forward_extend_skip_prefix(\n         # See https://github.com/sgl-project/sglang/blob/98fce73d5bd0a25afe7d68443d314190b1c47e64/python/sglang/kernels/ops/attention/merge_state.py#L13-L15\n         return output, lse.transpose(0, 1).contiguous()\n \n+    @staticmethod\n+    def _reject_mla_draft_under_dcp(\n+        *, use_mla, dcp_world_size, is_draft_worker, model_config\n+    ):\n+        \"\"\"Reject an MLA draft model whose KV is replicated under DCP.\n+\n+        The MLA model code still routes such a draft's extend through its DCP\n+        decode branch without the step's keys, which this backend cannot run.\n+        \"\"\"\n+        if not (use_mla and is_draft_worker and dcp_world_size > 1):\n+            return\n+        if dsa_draft_shards_under_dcp(model_config.hf_config, dcp_world_size):\n+            return\n+        raise ValueError(\n+            f\"aiter cannot run an MLA draft model with --dcp-size {dcp_world_size}: \"\n+            \"its draft extend has no DCP path. Use --dcp-size 1, or a draft model \"\n+            \"without MLA attention.\"\n+        )\n+\n     @staticmethod\n     def _reject_target_verify_cross_layer_kv(k, v):\n         \"\"\"Reject cross-layer KV sharing on the legacy ragged target-verify path.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ff92e6f8e9500bca44eb5885210adfce851350c5/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Faiter_backend.py",
      "sha": "252b8fbcb20b81908b5c889eb9f13b17bf0b3320",
      "status": "modified"
    },
    {
      "additions": 56,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ff92e6f8e9500bca44eb5885210adfce851350c5/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_aiter_mla_draft_dcp_guard.py",
      "changes": 56,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_aiter_mla_draft_dcp_guard.py?ref=ff92e6f8e9500bca44eb5885210adfce851350c5",
      "deletions": 0,
      "filename": "test/registered/unit/layers/attention/test_aiter_mla_draft_dcp_guard.py",
      "patch": "@@ -0,0 +1,56 @@\n+\"\"\"Guard: aiter refuses an MLA draft model under decode context parallelism.\n+\n+An MLA draft (EAGLE, NEXTN, STANDALONE) with ``--dcp-size > 1`` crashed at\n+startup inside the aiter extend with an opaque ``AttributeError`` (\"'NoneType'\n+object has no attribute 'shape'\"): the MLA model code sends the draft extend\n+through its DCP decode branch without the step's keys. The guard fails loudly\n+instead. It is inert for targets, non-MLA drafts, DCP 1, and ROCm DSA drafts that\n+shard their KV like the target.\n+\"\"\"\n+\n+import unittest\n+from types import SimpleNamespace\n+from unittest.mock import patch\n+\n+from sglang.srt.layers.attention import aiter_backend\n+from sglang.srt.layers.attention.aiter_backend import AiterAttnBackend\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+def _reject(*, dsa_draft_shards=False, **overrides):\n+    kwargs = dict(\n+        use_mla=True,\n+        dcp_world_size=2,\n+        is_draft_worker=True,\n+        model_config=SimpleNamespace(hf_config=SimpleNamespace()),\n+    )\n+    kwargs.update(overrides)\n+    with patch.object(\n+        aiter_backend, \"dsa_draft_shards_under_dcp\", return_value=dsa_draft_shards\n+    ):\n+        AiterAttnBackend._reject_mla_draft_under_dcp(**kwargs)\n+\n+\n+class TestAiterMlaDraftDcpGuard(CustomTestCase):\n+    def test_raises_for_an_mla_draft_under_dcp(self):\n+        with self.assertRaises(ValueError) as ctx:\n+            _reject()\n+        self.assertIn(\"--dcp-size 2\", str(ctx.exception))\n+        self.assertIn(\"MLA draft\", str(ctx.exception))\n+\n+    def test_inert_for_targets_non_mla_drafts_and_dcp1(self):\n+        # These never read hf_config, so a model config without one still builds.\n+        bare = SimpleNamespace()\n+        _reject(is_draft_worker=False, model_config=bare)\n+        _reject(use_mla=False, model_config=bare)\n+        _reject(dcp_world_size=1, model_config=bare)\n+\n+    def test_inert_for_a_dsa_draft_that_shards_like_the_target(self):\n+        _reject(dsa_draft_shards=True)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ff92e6f8e9500bca44eb5885210adfce851350c5/test%2Fregistered%2Funit%2Flayers%2Fattention%2Ftest_aiter_mla_draft_dcp_guard.py",
      "sha": "dddd469efcb1c3ba35a99f80622454ff7cbc3897",
      "status": "added"
    }
