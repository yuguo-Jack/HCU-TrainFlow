    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0fa85900e974590dcf8b2a4126fe61ee9d0486f0/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py?ref=0fa85900e974590dcf8b2a4126fe61ee9d0486f0",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/qwen3_coder_detector.py",
      "patch": "@@ -137,6 +137,12 @@ def _convert_param_value(\n                 maybe_convert = (\n                     False if \".\" in param_value or \"e\" in param_value.lower() else True\n                 )\n+                if maybe_convert:\n+                    # Preserve integer literals before a float can round them.\n+                    try:\n+                        return int(param_value)\n+                    except ValueError:\n+                        pass\n                 param_value: float = float(param_value)\n                 if maybe_convert and param_value.is_integer():\n                     param_value = int(param_value)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0fa85900e974590dcf8b2a4126fe61ee9d0486f0/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py",
      "sha": "b0e936966d872e4d8ef19d08b1cac13a6a02a9eb",
      "status": "modified"
    },
    {
      "additions": 81,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0fa85900e974590dcf8b2a4126fe61ee9d0486f0/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_qwen3_coder_numeric_precision.py",
      "changes": 81,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_qwen3_coder_numeric_precision.py?ref=0fa85900e974590dcf8b2a4126fe61ee9d0486f0",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_qwen3_coder_numeric_precision.py",
      "patch": "@@ -0,0 +1,81 @@\n+import json\n+import unittest\n+\n+from sglang.srt.entrypoints.openai.protocol import Function, Tool\n+from sglang.srt.function_call.function_call_parser import FunctionCallParser\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=2, suite=\"base-a-test-cpu\")\n+\n+\n+class TestQwen3CoderNumericPrecision(unittest.TestCase):\n+    def check_value(self, schema, raw, expected):\n+        tools = [\n+            Tool(\n+                type=\"function\",\n+                function=Function(\n+                    name=\"lookup\",\n+                    parameters={\n+                        \"type\": \"object\",\n+                        \"properties\": {\"value\": schema},\n+                    },\n+                ),\n+            )\n+        ]\n+        text = (\n+            \"<tool_call><function=lookup><parameter=value>\"\n+            f\"{raw}</parameter></function></tool_call>\"\n+        )\n+        for parser_name in (\"qwen3_coder\", \"step3p5\", \"nanbeige\"):\n+            for chunk_size in (0, 1, 11, len(text)):\n+                with self.subTest(parser=parser_name, chunk_size=chunk_size, raw=raw):\n+                    parser = FunctionCallParser(tools, parser_name)\n+                    if chunk_size == 0:\n+                        normal, calls = parser.parse_non_stream(text)\n+                    else:\n+                        normal, calls = \"\", []\n+                        for offset in range(0, len(text), chunk_size):\n+                            content, delta = parser.parse_stream_chunk(\n+                                text[offset : offset + chunk_size]\n+                            )\n+                            normal += content\n+                            calls.extend(delta)\n+                    self.assertEqual(normal, \"\")\n+                    self.assertEqual(\n+                        [call.name for call in calls if call.name], [\"lookup\"]\n+                    )\n+                    self.assertTrue(all(call.tool_index == 0 for call in calls))\n+                    arguments = json.loads(\"\".join(call.parameters for call in calls))\n+                    self.assertEqual(arguments, {\"value\": expected})\n+                    self.assertIs(type(arguments[\"value\"]), type(expected))\n+\n+    def test_number_schema_preserves_large_integer_literals(self):\n+        for value in (\n+            9007199254740993,\n+            -9007199254740993,\n+            18446744073709551615,\n+            1790892345000000001,\n+        ):\n+            self.check_value({\"type\": \"number\"}, str(value), value)\n+        self.check_value({\"type\": \"number\"}, \" 9007199254740993 \", 9007199254740993)\n+\n+    def test_nullable_number_schema_preserves_large_integer_literals(self):\n+        self.check_value(\n+            {\"anyOf\": [{\"type\": \"number\"}, {\"type\": \"null\"}]},\n+            \"9007199254740993\",\n+            9007199254740993,\n+        )\n+\n+    def test_other_numeric_forms_are_unchanged(self):\n+        for raw, expected in ((\"42\", 42), (\"-12.5\", -12.5), (\"1.25e3\", 1250.0)):\n+            self.check_value({\"type\": \"number\"}, raw, expected)\n+        self.check_value({\"type\": \"number\"}, \"not-a-number\", \"not-a-number\")\n+        self.check_value({\"type\": \"number\"}, \"null\", None)\n+\n+    def test_integer_and_string_schemas_are_unchanged(self):\n+        self.check_value({\"type\": \"integer\"}, \"9007199254740993\", 9007199254740993)\n+        self.check_value({\"type\": \"string\"}, \"9007199254740993\", \"9007199254740993\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0fa85900e974590dcf8b2a4126fe61ee9d0486f0/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_qwen3_coder_numeric_precision.py",
      "sha": "277fc28ca39969591f919cdda9359992cda432b7",
      "status": "added"
    }
