  "files": [
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b7c34a995d127a4aad78133b2d69e77936a44f2f/python%2Fsglang%2Fsrt%2Fsampling%2Fsampling_params.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fsampling%2Fsampling_params.py?ref=b7c34a995d127a4aad78133b2d69e77936a44f2f",
      "deletions": 0,
      "filename": "python/sglang/srt/sampling/sampling_params.py",
      "patch": "@@ -226,6 +226,7 @@ def _max_length_from_subpattern(subpattern: sre_parse.SubPattern):\n     for token, value in subpattern:\n         if token in {\n             sre_parse.LITERAL,  # `value` is any one character\n+            sre_parse.NOT_LITERAL,  # Any character except `value`, e.g. `[^a]`\n             sre_parse.IN,  # Any character within `value`\n             sre_parse.ANY,  # \".\"\n         }:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b7c34a995d127a4aad78133b2d69e77936a44f2f/python%2Fsglang%2Fsrt%2Fsampling%2Fsampling_params.py",
      "sha": "31a6ef86842d71da23e2f77d8eaa7637a0a187c1",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b7c34a995d127a4aad78133b2d69e77936a44f2f/test%2Fregistered%2Funit%2Fsampling%2Ftest_sampling_params.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fsampling%2Ftest_sampling_params.py?ref=b7c34a995d127a4aad78133b2d69e77936a44f2f",
      "deletions": 0,
      "filename": "test/registered/unit/sampling/test_sampling_params.py",
      "patch": "@@ -343,6 +343,14 @@ def test_character_class(self):\n         \"\"\"Test that character class '[a-z]' gives max length 1.\"\"\"\n         self.assertEqual(get_max_seq_length(\"[a-z]\"), 1)\n \n+    def test_negated_literal(self):\n+        \"\"\"Test that negated literal '[^a]' still consumes exactly one character.\"\"\"\n+        self.assertEqual(get_max_seq_length(\"[^a]\"), 1)\n+\n+    def test_repeated_negated_literal(self):\n+        \"\"\"Test that repeated negated literal '[^a]{3}' uses the repeat upper bound.\"\"\"\n+        self.assertEqual(get_max_seq_length(\"[^a]{3}\"), 3)\n+\n     def test_dot_any(self):\n         \"\"\"Test that dot wildcard '.' gives max length 1.\"\"\"\n         self.assertEqual(get_max_seq_length(\".\"), 1)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b7c34a995d127a4aad78133b2d69e77936a44f2f/test%2Fregistered%2Funit%2Fsampling%2Ftest_sampling_params.py",
      "sha": "54f8a19f2935cb55db1ddac21551e2b66ef67512",
      "status": "modified"
    }
