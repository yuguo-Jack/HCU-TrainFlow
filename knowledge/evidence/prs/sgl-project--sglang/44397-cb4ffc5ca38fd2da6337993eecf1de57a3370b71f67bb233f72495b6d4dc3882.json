    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a096ba59529b5729dcdf1cbba86e3b2faac761d7/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=a096ba59529b5729dcdf1cbba86e3b2faac761d7",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -3454,7 +3454,7 @@ def _abort_on_queued_limit(self, recv_req: Req) -> bool:\n         # Reject the incoming request by default.\n         req_to_abort = recv_req\n         message = \"The request queue is full.\"\n-        if self.enable_priority_scheduling:\n+        if self.enable_priority_scheduling and self.waiting_queue:\n             # With priority scheduling, consider aboritng an existing request based on the priority.\n             # direction = 1  => smaller number = higher priority; -1 => larger number = higher priority.\n             # max(...) + (direction * priority, queue_time_start) picks the least-preferred request.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a096ba59529b5729dcdf1cbba86e3b2faac761d7/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "00e3310650a4458313fe5411e1c7b7d808fb3c67",
      "status": "modified"
    },
    {
      "additions": 20,
      "blob_url": "https://github.com/sgl-project/sglang/blob/a096ba59529b5729dcdf1cbba86e3b2faac761d7/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py?ref=a096ba59529b5729dcdf1cbba86e3b2faac761d7",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_scheduler_timeouts.py",
      "patch": "@@ -91,6 +91,26 @@ def setUp(self):\n         patcher.start()\n         self.addCleanup(patcher.stop)\n \n+    def test_zero_queue_limit_rejects_priority_requests_without_a_candidate(self):\n+        for low_priority_values_first in (False, True):\n+            with self.subTest(low_priority_values_first=low_priority_values_first):\n+                incoming = _req(\"incoming\")\n+                incoming.priority = 1\n+                s = _scheduler([])\n+                s.max_queued_requests = 0\n+                s.enable_priority_scheduling = True\n+                s.schedule_low_priority_values_first = low_priority_values_first\n+\n+                self.assertTrue(s._abort_on_queued_limit(incoming))\n+\n+                sender = s.ipc_channels.send_to_tokenizer.send_output\n+                sender.assert_called_once()\n+                abort, req = sender.call_args.args\n+                self.assertEqual(abort.rid, incoming.rid)\n+                self.assertEqual(abort.finished_reason[\"status_code\"], 503)\n+                self.assertIs(req, incoming)\n+                self.assertEqual(s.waiting_queue, [])\n+\n     def test_hicache_without_storage_uses_common_abort_cleanup(self):\n         candidate = _req(\"candidate\", wait_entry=1.0)\n         candidate.priority = 0",
      "raw_url": "https://github.com/sgl-project/sglang/raw/a096ba59529b5729dcdf1cbba86e3b2faac761d7/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_timeouts.py",
      "sha": "789cc793143d192ec16b5e4597451c7d182e492a",
      "status": "modified"
    }
