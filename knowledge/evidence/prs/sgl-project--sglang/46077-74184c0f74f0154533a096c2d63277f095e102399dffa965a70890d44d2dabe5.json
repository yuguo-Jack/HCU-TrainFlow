      "patch": "@@ -225,7 +225,7 @@ def position_embeddings(\n             else:\n                 pos_emb_3d = pos_emb_2d.unsqueeze(0).repeat(t, 1, 1) + self.time_weight[\n                     0:t\n-                ].to(pos_emb_2d.dtype)\n+                ].to(device=pos_emb_2d.device, dtype=pos_emb_2d.dtype)\n \n             pos_embs.append(pos_emb_3d.reshape(-1, pos_emb_3d.shape[-1]))\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/87ddff059768acc55b9fa5771a874c147e93bca6/python%2Fsglang%2Fsrt%2Fmodels%2Fkimi_k3_vl.py",
