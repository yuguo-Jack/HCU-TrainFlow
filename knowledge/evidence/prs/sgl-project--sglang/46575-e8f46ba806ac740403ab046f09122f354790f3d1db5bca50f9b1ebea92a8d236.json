      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fk2_v3_detector.py?ref=3b20177cefcea53185d682d70ac1a35965f2615e",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/k2_v3_detector.py",
      "patch": "@@ -522,6 +522,14 @@ def _argument_type(\n             # and JSON values have already been decoded with their true type.\n             schema_type = schema.get(\"type\")\n             if \"anyOf\" in schema or \"oneOf\" in schema:\n+                variants = [\n+                    cls._resolve_local_ref(variant, root_schema)\n+                    for variant in schema.get(\"anyOf\") or schema.get(\"oneOf\") or []\n+                ]\n+                non_null = [v for v in variants if not (v and v.get(\"type\") == \"null\")]\n+                # Optional[X] has one real branch, so this is not a guess.\n+                if len(non_null) == 1 and non_null[0]:\n+                    return infer_type_from_json_schema(non_null[0])\n                 return None\n             if (\n                 isinstance(schema_type, list)\n@@ -542,6 +550,9 @@ def _coerce_value(\n         inline_type: Optional[str] = None,\n         from_text: bool,\n     ) -> Any:\n+        # An explicit null is a value, not text to coerce to the schema type.\n+        if value is None or inline_type == \"null\":\n+            return None\n         target_type = cls._argument_type(tool_name, argument_name, tools) or inline_type\n         if target_type == \"any\":\n             return value",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3b20177cefcea53185d682d70ac1a35965f2615e/python%2Fsglang%2Fsrt%2Ffunction_call%2Fk2_v3_detector.py",
      "sha": "b2c28ed46d00320b6314a37d047c2a23cb34caa1",
      "status": "modified"
    },
    {
      "additions": 37,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3b20177cefcea53185d682d70ac1a35965f2615e/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_k2_v3_detector.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_k2_v3_detector.py?ref=3b20177cefcea53185d682d70ac1a35965f2615e",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_k2_v3_detector.py",
      "patch": "@@ -140,6 +140,43 @@ def test_xml_typed_union_uses_wire_value_type(self):\n         result = K2V3Detector().detect_and_parse(wire, [tool])\n         self.assertEqual(json.loads(result.calls[0].parameters), {\"id\": 123})\n \n+    def test_optional_string_keeps_text_and_null(self):\n+        \"\"\"Both spellings of Optional[str] keep text as text and null as null.\"\"\"\n+        tool = Tool(\n+            type=\"function\",\n+            function=Function(\n+                name=\"lookup\",\n+                parameters={\n+                    \"type\": \"object\",\n+                    \"properties\": {\n+                        \"any_of\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}]},\n+                        \"type_list\": {\"type\": [\"string\", \"null\"]},\n+                    },\n+                },\n+            ),\n+        )\n+\n+        def xml(key, value, arg_type=None):\n+            typed = f\"<ifm|arg_type>{arg_type}</ifm|arg_type>\" if arg_type else \"\"\n+            return (\n+                f\"<ifm|tool_call>lookup<ifm|arg_key>{key}</ifm|arg_key>{typed}\"\n+                f\"<ifm|arg_value>{value}</ifm|arg_value></ifm|tool_call>\"\n+            )\n+\n+        cases = [\n+            (xml(\"any_of\", \"123\"), {\"any_of\": \"123\"}),\n+            (xml(\"type_list\", \"null\", \"null\"), {\"type_list\": None}),\n+            (\n+                '<ifm|tool_call>{\"name\":\"lookup\",\"arguments\":{\"type_list\":null}}'\n+                \"</ifm|tool_call>\",\n+                {\"type_list\": None},\n+            ),\n+        ]\n+        for wire, expected in cases:\n+            with self.subTest(wire=wire):\n+                result = K2V3Detector().detect_and_parse(wire, [tool])\n+                self.assertEqual(json.loads(result.calls[0].parameters), expected)\n+\n     def test_non_string_json_function_name_is_forwarded_as_text(self):\n         wire = '<ifm|tool_call>{\"name\":123,\"arguments\":{}}</ifm|tool_call>'\n         result = K2V3Detector().detect_and_parse(wire, self.tools)",
