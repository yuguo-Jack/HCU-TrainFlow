  "files": [
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/50ae3f9e8d7500ecb73ad63c398dcaa0d9a35281/python%2Fsglang%2Fsrt%2Farg_groups%2Fcuda_graph_hook.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Fcuda_graph_hook.py?ref=50ae3f9e8d7500ecb73ad63c398dcaa0d9a35281",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/cuda_graph_hook.py",
      "patch": "@@ -636,6 +636,14 @@ def generate_prefill_cuda_graph_batch_sizes(max_bs: int):\n \n     capture_sizes = [s for s in capture_sizes if s <= max_bs]\n \n+    # The flag reads as an exact ceiling (\"Maximum batch size captured for\n+    # the prefill cuda graph\"), and the decode path already appends max_bs\n+    # when it falls between grid points. Do the same here so an off-grid\n+    # ceiling does not silently shrink the largest captured prefill bucket\n+    # (which post-capture KV sizing then treats as the real ceiling).\n+    if max_bs not in capture_sizes:\n+        capture_sizes.append(max_bs)\n+\n     return capture_sizes\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/50ae3f9e8d7500ecb73ad63c398dcaa0d9a35281/python%2Fsglang%2Fsrt%2Farg_groups%2Fcuda_graph_hook.py",
      "sha": "d49296292b842eb13af3b03683e7f1ed4470065e",
      "status": "modified"
    },
    {
      "additions": 48,
      "blob_url": "https://github.com/sgl-project/sglang/blob/50ae3f9e8d7500ecb73ad63c398dcaa0d9a35281/test%2Fregistered%2Fcpu%2Ftest_cuda_graph_batch_sizes.py",
      "changes": 48,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fcpu%2Ftest_cuda_graph_batch_sizes.py?ref=50ae3f9e8d7500ecb73ad63c398dcaa0d9a35281",
      "deletions": 0,
      "filename": "test/registered/cpu/test_cuda_graph_batch_sizes.py",
      "patch": "@@ -0,0 +1,48 @@\n+# SPDX-License-Identifier: Apache-2.0\n+\"\"\"Batch-size list generation for CUDA graph capture (issue #41923).\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.arg_groups.cuda_graph_hook import (\n+    generate_decode_cuda_graph_batch_sizes,\n+    generate_prefill_cuda_graph_batch_sizes,\n+)\n+from sglang.srt.server_args import ServerArgs\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=2, suite=\"stage-a-test-cpu-intel\")\n+register_cpu_ci(est_time=2, suite=\"base-b-test-cpu-arm64\")\n+\n+\n+class TestPrefillCudaGraphBatchSizes(CustomTestCase):\n+    def test_off_grid_ceiling_is_captured(self):\n+        # 3000 sits between grid points; the ceiling itself must be captured\n+        # instead of silently rounding down to 2816.\n+        sizes = generate_prefill_cuda_graph_batch_sizes(3000)\n+        self.assertEqual(sizes[-1], 3000)\n+\n+    def test_on_grid_ceiling_not_duplicated(self):\n+        sizes = generate_prefill_cuda_graph_batch_sizes(2048)\n+        self.assertEqual(sizes[-1], 2048)\n+        self.assertEqual(len(sizes), len(set(sizes)))\n+\n+    def test_ceiling_below_first_grid_point(self):\n+        self.assertEqual(generate_prefill_cuda_graph_batch_sizes(2), [2])\n+\n+    def test_list_stays_sorted(self):\n+        for max_bs in (3000, 4500, 4607, 5000, 6000, 10000):\n+            sizes = generate_prefill_cuda_graph_batch_sizes(max_bs)\n+            self.assertEqual(sizes, sorted(sizes))\n+            self.assertEqual(sizes[-1], max_bs)\n+\n+    def test_decode_ceiling_parity(self):\n+        # The decode path has always appended the ceiling; pin the parity the\n+        # prefill fix targets.\n+        server_args = ServerArgs(model_path=\"dummy\")\n+        capture_bs = generate_decode_cuda_graph_batch_sizes(server_args, 3000)\n+        self.assertEqual(capture_bs[-1], 3000)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/50ae3f9e8d7500ecb73ad63c398dcaa0d9a35281/test%2Fregistered%2Fcpu%2Ftest_cuda_graph_batch_sizes.py",
      "sha": "68d5eb3e5e22a779c0b072fc171191a12cb1bc02",
      "status": "added"
    }
  ],
  "inline_comments": [],
  "issue_comments": [
    {
      "body": "Still real on current main (93809202a3): `generate_prefill_cuda_graph_batch_sizes` still filters with `s <= max_bs` and never appends an off-grid `max_bs`, so `--cuda-graph-max-bs-prefill 3000` still silently captures only up to 2816 while decode and CPU graph both pin the ceiling. Could a maintainer add the run-ci label? Fix is three lines plus a regression test covering the off-grid and on-grid cases.\n",
