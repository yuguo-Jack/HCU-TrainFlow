      "filename": "python/sglang/srt/mem_cache/storage/mooncake_store/mooncake_direct_linker.py",
      "patch": "@@ -332,12 +332,12 @@ def load_layer_wise(\n                     )\n             for keys, _ in batches.values():\n                 result = self.storage.store.batch_get_session_start(keys)\n+                started.append(keys)\n                 if list(result) != [0] * len(keys):\n                     raise RuntimeError(\n                         f\"Mooncake get session start failed: keys={len(keys)}, \"\n                         f\"results={result}\"\n                     )\n-                started.append(keys)\n \n             for layer in range(self.num_layers):\n                 for name, (keys, locations) in batches.items():",
      "raw_url": "https://github.com/sgl-project/sglang/raw/925c63c2a870fbdc19d8e7cc55cbd3c0356bb362/python%2Fsglang%2Fsrt%2Fmem_cache%2Fstorage%2Fmooncake_store%2Fmooncake_direct_linker.py",
      "sha": "6371cd222fcbb04d50c42c404d5c81e5228618f0",
      "status": "modified"
    },
    {
      "additions": 55,
      "blob_url": "https://github.com/sgl-project/sglang/blob/925c63c2a870fbdc19d8e7cc55cbd3c0356bb362/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_cache_linker.py",
      "changes": 55,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_cache_linker.py?ref=925c63c2a870fbdc19d8e7cc55cbd3c0356bb362",
      "deletions": 0,
      "filename": "test/registered/unit/mem_cache/test_unified_cache_linker.py",
      "patch": "@@ -1053,6 +1053,61 @@ def test_offload_skips_node_already_stored_by_tree_core():\n     assert linker.queued_offloads == []\n \n \n+class TestMooncakeSessionCleanup(CustomTestCase):\n+    def test_partial_session_start_releases_successful_sessions(self):\n+        for previous_batch in (False, True):\n+            with self.subTest(previous_batch=previous_batch):\n+                sessions = set()\n+\n+                def start_sessions(keys):\n+                    statuses = [-1 if key == \"missing\" else 0 for key in keys]\n+                    sessions.update(\n+                        key for key, status in zip(keys, statuses) if status == 0\n+                    )\n+                    return statuses\n+\n+                store = SimpleNamespace(\n+                    batch_get_session_start=start_sessions,\n+                    batch_get_session_end=sessions.difference_update,\n+                )\n+                pool = SimpleNamespace(\n+                    prepare_locations=list,\n+                    get_prepared_layer_range_meta=lambda locations, layer: None,\n+                )\n+                linker = MooncakeDirectLinker.__new__(MooncakeDirectLinker)\n+                linker.num_layers = 1\n+                linker.storage = SimpleNamespace(\n+                    store=store,\n+                    _get_hybrid_page_component_keys=lambda keys, transfer: (keys, 1),\n+                    _tag_keys=lambda keys: keys,\n+                )\n+                linker.pools = {PoolName.KV: pool, PoolName.SWA: pool}\n+                linker.layer_done_counter = LayerWiseLoadCounter(1)\n+                index = linker.layer_done_counter.update_producer()\n+                transfers = []\n+                if previous_batch:\n+                    transfers.append(\n+                        PoolTransfer(\n+                            name=PoolName.KV,\n+                            keys=[\"earlier\"],\n+                            host_indices=torch.tensor([0]),\n+                        )\n+                    )\n+                transfers.append(\n+                    PoolTransfer(\n+                        name=PoolName.SWA,\n+                        keys=[\"present\", \"missing\"],\n+                        host_indices=torch.tensor([1, 2]),\n+                    )\n+                )\n+\n+                with self.assertLogs(MooncakeDirectLinker.__module__, level=\"ERROR\"):\n+                    linker.load_layer_wise(index, [transfers])\n+\n+                self.assertFalse(linker.layer_done_counter.finish(index))\n+                self.assertEqual(sessions, set())\n+\n+\n def test_layer_counter_reports_failure_after_the_forward():\n     ready = []\n     counter = LayerWiseLoadCounter(2, lambda index, layer: ready.append(layer))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/925c63c2a870fbdc19d8e7cc55cbd3c0356bb362/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_cache_linker.py",
      "sha": "13576a6fb408ec6b4e98a68d26fa1f6b65feeade",
