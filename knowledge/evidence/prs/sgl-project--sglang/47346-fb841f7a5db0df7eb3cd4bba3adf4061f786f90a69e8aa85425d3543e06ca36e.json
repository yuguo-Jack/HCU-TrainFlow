      "deletions": 1,
      "filename": "python/sglang/srt/distributed/parallel_state.py",
      "patch": "@@ -3542,7 +3542,7 @@ def _warn_if_called_from_outside(name: str, replacement: str):\n     def decorate(fn):\n         @functools.wraps(fn)\n         def wrapper(*args, **kwargs):\n-            if name not in _ALREADY_WARNED:\n+            if not torch.compiler.is_compiling() and name not in _ALREADY_WARNED:\n                 caller = sys._getframe(1).f_globals.get(\"__name__\", \"\")\n                 if not caller.startswith(_EXEMPT_CALLERS):\n                     _ALREADY_WARNED.add(name)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/14151f24f93d13cc305aa27348b503e2d6c2aa3c/python%2Fsglang%2Fsrt%2Fdistributed%2Fparallel_state.py",
