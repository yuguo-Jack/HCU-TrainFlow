  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/be169f20aa495f633c2ad4fcc6aff64f702bebc7/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py?ref=be169f20aa495f633c2ad4fcc6aff64f702bebc7",
      "deletions": 1,
      "filename": "python/sglang/srt/multimodal/processors/base_processor.py",
      "patch": "@@ -990,7 +990,10 @@ def _load_single_item(\n             if modality == Modality.IMAGE:\n                 img, _ = load_image(data, cls.gpu_image_decode)\n                 if isinstance(img, torch.Tensor):\n-                    return img  # JPEG already decoded on GPU by nvJPEG\n+                    # GPU JPEG decode can leave grayscale as 1 channel\n+                    # (torchvision decode_jpeg UNCHANGED). Expand to RGB so\n+                    # downstream processors that normalize with 3 means work.\n+                    return smart_to_rgb(img)\n                 # PIL decodes lazily; do it here in the io worker so the decode\n                 # doesn't run later on the event-loop thread.\n                 if discard_alpha_channel:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/be169f20aa495f633c2ad4fcc6aff64f702bebc7/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "sha": "bd84edf4261746a7bf768a0ea81d6ebf45c80866",
      "status": "modified"
    },
    {
      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/be169f20aa495f633c2ad4fcc6aff64f702bebc7/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py?ref=be169f20aa495f633c2ad4fcc6aff64f702bebc7",
      "deletions": 0,
      "filename": "python/sglang/srt/utils/common.py",
      "patch": "@@ -2002,9 +2002,25 @@ class VideoData:\n GPUImageDecodeMode = Union[bool, Literal[\"nvjpeg_fancy\"]]\n \n \n+def ensure_rgb_image_tensor(image: torch.Tensor) -> torch.Tensor:\n+    \"\"\"Expand a single-channel CHW/HW image tensor to 3-channel RGB.\n+\n+    ``torchvision.io.decode_jpeg`` with the default unchanged mode keeps\n+    grayscale JPEGs as ``[1, H, W]`` (or ``[H, W]``). Vision processors that\n+    normalize with three RGB channel means then fail with a broadcast error.\n+    \"\"\"\n+    if image.ndim == 2:\n+        image = image.unsqueeze(0)\n+    if image.ndim == 3 and image.shape[0] == 1:\n+        image = image.expand(3, -1, -1).contiguous()\n+    return image\n+\n+\n def smart_to_rgb(\n     image: Union[torch.Tensor, Image.Image],\n ) -> Union[torch.Tensor, Image.Image]:\n+    if isinstance(image, torch.Tensor):\n+        return ensure_rgb_image_tensor(image)\n     if not isinstance(image, Image.Image):\n         return image\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/be169f20aa495f633c2ad4fcc6aff64f702bebc7/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "sha": "78ad0e8ddb6257711b342b0011779eb38aded85b",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/sgl-project/sglang/blob/be169f20aa495f633c2ad4fcc6aff64f702bebc7/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_image_decode.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_image_decode.py?ref=be169f20aa495f633c2ad4fcc6aff64f702bebc7",
      "deletions": 0,
      "filename": "test/registered/unit/multimodal/test_base_processor_image_decode.py",
      "patch": "@@ -216,3 +216,47 @@ def __init__(self, *, sample_format, apply_exif_orientation):\n \n if __name__ == \"__main__\":\n     unittest.main()\n+\n+\n+class TestLoadSingleItemGrayscaleGpuTensor(CustomTestCase):\n+    \"\"\"GPU JPEG decode can leave grayscale as 1 channel; expand before return.\"\"\"\n+\n+    def test_single_channel_chw_tensor_expanded_to_rgb(self):\n+        gray = torch.full((1, 12, 10), 128, dtype=torch.uint8)\n+\n+        with patch.object(\n+            common,\n+            \"load_image\",\n+            return_value=(gray, (10, 12)),\n+        ):\n+            out = _StubProcessor._load_single_item(b\"fake\", Modality.IMAGE)\n+\n+        self.assertIsInstance(out, torch.Tensor)\n+        self.assertEqual(tuple(out.shape), (3, 12, 10))\n+        self.assertTrue(torch.equal(out[0], out[1]))\n+        self.assertTrue(torch.equal(out[1], out[2]))\n+\n+    def test_hw_grayscale_tensor_expanded_to_rgb(self):\n+        gray = torch.full((12, 10), 64, dtype=torch.uint8)\n+\n+        with patch.object(\n+            common,\n+            \"load_image\",\n+            return_value=(gray, (10, 12)),\n+        ):\n+            out = _StubProcessor._load_single_item(b\"fake\", Modality.IMAGE)\n+\n+        self.assertEqual(tuple(out.shape), (3, 12, 10))\n+\n+    def test_rgb_tensor_unchanged(self):\n+        rgb = torch.zeros((3, 8, 8), dtype=torch.uint8)\n+        rgb[1] = 1\n+\n+        with patch.object(\n+            common,\n+            \"load_image\",\n+            return_value=(rgb, (8, 8)),\n+        ):\n+            out = _StubProcessor._load_single_item(b\"fake\", Modality.IMAGE)\n+\n+        self.assertIs(out, rgb)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/be169f20aa495f633c2ad4fcc6aff64f702bebc7/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_image_decode.py",
      "sha": "71955977a8ebf0502c9805608675a6ae89dcab89",
      "status": "modified"
    }
