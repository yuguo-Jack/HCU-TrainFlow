      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fvision.py?ref=7051b41980caf5debf7f66905c93aa4ea4f38aa7",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/attention/vision.py",
      "patch": "@@ -931,10 +931,12 @@ def forward(\n         )[0]\n \n         if valid_indices is not None:\n+            output.zero_()\n             output.index_copy_(0, valid_indices, attn_output)\n         elif output.shape[0] != total_tokens:\n             # Single image: write the compact result into the front of the\n-            # pre-allocated padded output, leaving the padding rows as-is.\n+            # pre-allocated padded output, with finite zero padding.\n+            output.zero_()\n             output[:total_tokens].copy_(attn_output)\n         else:\n             output = attn_output",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7051b41980caf5debf7f66905c93aa4ea4f38aa7/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fvision.py",
