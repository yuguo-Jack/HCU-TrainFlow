      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py?ref=1473ee6e42769a8855f06eb0db3fcd4f6deb8e01",
      "deletions": 2,
      "filename": "python/sglang/srt/mem_cache/unified_radix_cache.py",
      "patch": "@@ -2904,8 +2904,8 @@ def _try_alloc_storage_hit(operation) -> bool:\n             request = operation.handle\n             info = self.ongoing_prefetch.get(request)\n             hit_tokens = operation.storage_hit_count\n-            if info is None:\n-                return True  # aborted/cleaned; nothing to retry\n+            if info is None or info.operation is not operation:\n+                return True  # aborted/reissued; nothing to retry for this operation\n             if operation.is_terminated():\n                 self.revoke_pending_prefetch(request)\n                 return True\n@@ -3024,6 +3024,9 @@ def _drain_and_alloc_storage_hit():\n                     if hit_tokens > 0:\n                         self.discard_storage_prefetch_accounting(request)\n                     continue\n+                # A reissued prefetch can reuse the handle before this query returns.\n+                if info.operation is not operation:\n+                    continue\n                 if hit_tokens > 0:\n                     self._record_storage_prefetch_hit(request, hit_tokens)\n                 if operation.is_terminated():",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1473ee6e42769a8855f06eb0db3fcd4f6deb8e01/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_radix_cache.py",
