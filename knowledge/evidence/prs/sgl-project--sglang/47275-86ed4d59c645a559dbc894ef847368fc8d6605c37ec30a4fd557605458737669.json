  "files": [
    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/588d73cddaaf023ac119da9cb1e7096a39fe5f4c/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_tokenize.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_tokenize.py?ref=588d73cddaaf023ac119da9cb1e7096a39fe5f4c",
      "deletions": 6,
      "filename": "python/sglang/srt/entrypoints/openai/serving_tokenize.py",
      "patch": "@@ -44,12 +44,13 @@ async def _handle_non_streaming_request(\n     ) -> Union[TokenizeResponse, ErrorResponse]:\n         try:\n             tokenizer = self.tokenizer_manager.tokenizer\n-            max_model_len = getattr(tokenizer, \"model_max_length\", -1)\n-            # ORJSON accepts signed negative and unsigned positive 64-bit integers.\n-            if isinstance(max_model_len, int) and not (\n-                -(2**63) <= max_model_len < 2**64\n-            ):\n-                max_model_len = self.tokenizer_manager.model_config.context_len\n+            # Report the limit the server actually enforces. Request\n+            # validation rejects prompts at or above context_len, and\n+            # /v1/models reports context_len as max_model_len, so the\n+            # tokenizer's own model_max_length (often much larger, e.g.\n+            # 131072 for a server running with context_len 40960) would\n+            # mislead clients budgeting prompts against this field.\n+            max_model_len = self.tokenizer_manager.model_config.context_len\n \n             if request.messages is not None:\n                 token_ids = self._tokenize_chat_request(request)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/588d73cddaaf023ac119da9cb1e7096a39fe5f4c/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_tokenize.py",
      "sha": "e224719b655c5e3791ab367b5c1b9fb2a15564e6",
      "status": "modified"
    },
    {
      "additions": 28,
      "blob_url": "https://github.com/sgl-project/sglang/blob/588d73cddaaf023ac119da9cb1e7096a39fe5f4c/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_tokenize.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_tokenize.py?ref=588d73cddaaf023ac119da9cb1e7096a39fe5f4c",
      "deletions": 4,
      "filename": "test/registered/unit/entrypoints/openai/test_serving_tokenize.py",
      "patch": "@@ -58,11 +58,13 @@ def _ids(text):\n     return [WORDS.index(word) for word in text.split()]\n \n \n-def _tokenize(serving, **body):\n+def _tokenize_response(serving, **body):\n     request = TokenizeRequest.model_validate(body)\n-    response = asyncio.run(\n-        serving._handle_non_streaming_request(request, request, None)\n-    )\n+    return asyncio.run(serving._handle_non_streaming_request(request, request, None))\n+\n+\n+def _tokenize(serving, **body):\n+    response = _tokenize_response(serving, **body)\n     if isinstance(response, TokenizeResponse):\n         return 200, response.tokens\n     return response.status_code, json.loads(response.body)[\"message\"]\n@@ -105,6 +107,28 @@ def test_formatting_options(self):\n             with self.subTest(prompt=prompt, special=special):\n                 self.assertEqual(_tokenize(serving, **body), (200, _ids(text)))\n \n+    def test_max_model_len_is_server_context_len(self):\n+        # Regression test for #41748: the tokenizer's model_max_length\n+        # (131072 for Qwen3-0.6B) must not leak into the response when\n+        # the server runs with a smaller context_len (4096 here, via\n+        # the mock tokenizer manager), since prompts at or above\n+        # context_len are rejected with a 400.\n+        serving = self._serving()\n+        serving.tokenizer_manager.tokenizer.model_max_length = 131072\n+        response = _tokenize_response(serving, prompt=\"hi\")\n+        self.assertIsInstance(response, TokenizeResponse)\n+        self.assertEqual(response.max_model_len, 4096)\n+        self.assertEqual(response.tokens, _ids(\"<bos> hi\"))\n+\n+        # Same for chat messages and for a batched prompt.\n+        response = _tokenize_response(serving, messages=HISTORY)\n+        self.assertIsInstance(response, TokenizeResponse)\n+        self.assertEqual(response.max_model_len, 4096)\n+        response = _tokenize_response(serving, prompt=[\"hi\", \"hello\"])\n+        self.assertIsInstance(response, TokenizeResponse)\n+        self.assertEqual(response.max_model_len, 4096)\n+        self.assertEqual(response.count, [2, 2])\n+\n     def test_options_that_cannot_apply_are_rejected(self):\n         chatml = self._serving(chat_template=\"chatml\")\n         self.assertEqual(_tokenize(chatml, messages=HISTORY)[0], 200)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/588d73cddaaf023ac119da9cb1e7096a39fe5f4c/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_tokenize.py",
      "sha": "5802d0d2858fac4e9a4b6285eaa2d990747c66dd",
      "status": "modified"
    }
