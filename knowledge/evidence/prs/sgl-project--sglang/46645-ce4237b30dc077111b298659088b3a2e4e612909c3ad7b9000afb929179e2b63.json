      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fconstrained%2Fbase_grammar_backend.py?ref=4628f7449ae3bf2272cbdb10e6bcfb81971e5978",
      "deletions": 0,
      "filename": "python/sglang/srt/constrained/base_grammar_backend.py",
      "patch": "@@ -368,6 +368,17 @@ def register_grammar_backend(name, init_func):\n     GRAMMAR_BACKEND_REGISTRY[name] = init_func\n \n \n+def grammar_stop_token_ids(tokenizer, eos_token_ids=None) -> Optional[set]:\n+    \"\"\"Every token id the scheduler finishes a request on. A stop token missing\n+    here is ordinary text to the grammar, so a constrained request could end on\n+    it before the grammar is complete.\"\"\"\n+    ids = set(eos_token_ids or ())\n+    if getattr(tokenizer, \"eos_token_id\", None) is not None:\n+        ids.add(tokenizer.eos_token_id)\n+    ids.update(getattr(tokenizer, \"additional_stop_token_ids\", None) or ())\n+    return ids or None\n+\n+\n def create_grammar_backend(\n     server_args: ServerArgs,\n     tokenizer,\n@@ -376,6 +387,7 @@ def create_grammar_backend(\n     think_end_ids: Optional[List[int]] = None,\n ) -> Optional[BaseGrammarBackend]:\n     name = get_exec().kernel.grammar_backend\n+    eos_token_ids = grammar_stop_token_ids(tokenizer, eos_token_ids)\n \n     # Custom grammar backend has the highest priority\n     if name in GRAMMAR_BACKEND_REGISTRY:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4628f7449ae3bf2272cbdb10e6bcfb81971e5978/python%2Fsglang%2Fsrt%2Fconstrained%2Fbase_grammar_backend.py",
      "sha": "3068637d73045801b49b64c2fac0c1f1f8ddf114",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4628f7449ae3bf2272cbdb10e6bcfb81971e5978/test%2Fregistered%2Funit%2Fconstrained%2Ftest_base_grammar_backend.py",
      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fconstrained%2Ftest_base_grammar_backend.py?ref=4628f7449ae3bf2272cbdb10e6bcfb81971e5978",
      "deletions": 0,
      "filename": "test/registered/unit/constrained/test_base_grammar_backend.py",
      "patch": "@@ -14,6 +14,7 @@\n import json\n import unittest\n from concurrent.futures import Future\n+from types import SimpleNamespace\n from unittest.mock import MagicMock, patch\n \n from sglang.srt.arg_groups.overrides import resolution_result\n@@ -24,6 +25,7 @@\n     GrammarStats,\n     InvalidGrammarObject,\n     create_grammar_backend,\n+    grammar_stop_token_ids,\n     register_grammar_backend,\n )\n from sglang.srt.runtime_context import get_context  # noqa: E402\n@@ -235,6 +237,19 @@ def init_fn(server_args, tokenizer, vocab_size, eos_token_ids):\n         self.assertEqual(received[\"vocab_size\"], 50000)\n         self.assertEqual(received[\"eos_token_ids\"], {0, 2})\n \n+    def test_custom_backend_receives_tokenizer_stop_tokens(self):\n+        received = {}\n+\n+        def init_fn(server_args, tokenizer, vocab_size, eos_token_ids):\n+            received[\"eos_token_ids\"] = eos_token_ids\n+            return MagicMock()\n+\n+        register_grammar_backend(\"capture_stop\", init_fn)\n+        args = self._make_server_args(\"capture_stop\")\n+        tokenizer = SimpleNamespace(eos_token_id=1, additional_stop_token_ids={3})\n+        create_grammar_backend(args, tokenizer, 50000, {0, 2})\n+        self.assertEqual(received[\"eos_token_ids\"], {0, 1, 2, 3})\n+\n     def test_custom_backend_skips_reasoner_wrapping(self):\n         \"\"\"Custom registered backends return directly, bypassing reasoner wrapping.\"\"\"\n         mock_inner = MagicMock(spec=BaseGrammarBackend)\n@@ -417,5 +432,14 @@ def test_nul_free_payload_still_dispatches(self):\n                 dispatch.assert_called_once_with(key_string)\n \n \n+class TestGrammarStopTokenIds(unittest.TestCase):\n+    def test_includes_every_scheduler_stop_token(self):\n+        tokenizer = SimpleNamespace(eos_token_id=163585, additional_stop_token_ids={7})\n+        self.assertEqual(\n+            grammar_stop_token_ids(tokenizer, {163586}), {7, 163585, 163586}\n+        )\n+        self.assertIsNone(grammar_stop_token_ids(SimpleNamespace(), None))\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/4628f7449ae3bf2272cbdb10e6bcfb81971e5978/test%2Fregistered%2Funit%2Fconstrained%2Ftest_base_grammar_backend.py",
