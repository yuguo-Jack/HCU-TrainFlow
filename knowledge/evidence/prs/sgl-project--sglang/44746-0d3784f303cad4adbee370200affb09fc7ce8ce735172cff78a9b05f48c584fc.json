      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Fallocator%2Funified_hybrid_swa.py?ref=ba33e75d49a9516452f21319556754642679713f",
      "deletions": 0,
      "filename": "python/sglang/srt/mem_cache/allocator/unified_hybrid_swa.py",
      "patch": "@@ -104,6 +104,7 @@ def __init__(\n             need_sort=need_sort,\n         )\n         self.unified_buffer = unified_buffer\n+        self._awaiting_resize = unified_buffer.post_capture_active\n         self._kvcache = kvcache\n         self.lazy_compaction = lazy_compaction\n \n@@ -1098,6 +1099,11 @@ def _fits_page_demand(\n \n     def ensure_capacity(self, full_tokens: int, swa_tokens: int) -> bool:\n         \"\"\"Gate one allocation and compact both sides on shortfall.\"\"\"\n+        if self._awaiting_resize:\n+            raise RuntimeError(\n+                \"UnifiedSWATokenToKVPoolAllocator cannot allocate before resize: \"\n+                \"post-capture capacity still spans the unbacked reservation\"\n+            )\n         if full_tokens < 0 or swa_tokens < 0:\n             return False\n         if full_tokens == 0 and swa_tokens == 0:\n@@ -1284,6 +1290,7 @@ def resize(self, config) -> None:\n                 host_capacity\n                 * self.unified_buffer.spec(allocator.sub_pool_name).entry_bytes()\n             )\n+        self._awaiting_resize = False\n \n \n class UnifiedMambaSWATokenToKVPoolAllocator(UnifiedSWAAllocatorBase):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ba33e75d49a9516452f21319556754642679713f/python%2Fsglang%2Fsrt%2Fmem_cache%2Fallocator%2Funified_hybrid_swa.py",
      "sha": "19929db26732a560ac4caa1ca2db66780d798948",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ba33e75d49a9516452f21319556754642679713f/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_post_capture_sizing.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_post_capture_sizing.py?ref=ba33e75d49a9516452f21319556754642679713f",
      "deletions": 6,
      "filename": "test/registered/unit/mem_cache/test_unified_post_capture_sizing.py",
      "patch": "@@ -156,6 +156,9 @@ def test_sizing_contract_is_enforced(self):\n         bundle = self._post_capture_bundle()\n         kvcache = bundle.token_to_kv_pool\n         allocator = bundle.token_to_kv_pool_allocator\n+        with self.subTest(\"allocation before finalize_backing\"):\n+            with self.assertRaisesRegex(RuntimeError, \"before resize\"):\n+                allocator.alloc(_PAGE_SIZE)\n         with self.subTest(\"resize before finalize_backing\"):\n             with self.assertRaisesRegex(RuntimeError, \"finalize_backing must run\"):\n                 allocator.resize(\n@@ -176,16 +179,17 @@ def test_sizing_contract_is_enforced(self):\n                 kvcache.finalize_backing(\n                     SimpleNamespace(unified_memory_pool_bytes=4096)\n                 )\n+        final = SimpleNamespace(unified_memory_pool_bytes=_FINAL_BYTES)\n+        kvcache.finalize_backing(final)\n+        with self.subTest(\"allocation between finalize_backing and resize\"):\n+            with self.assertRaisesRegex(RuntimeError, \"before resize\"):\n+                allocator.alloc(_PAGE_SIZE)\n+        allocator.resize(final)\n         with self.subTest(\"resize with live allocations\"):\n-            kvcache.finalize_backing(\n-                SimpleNamespace(unified_memory_pool_bytes=_FINAL_BYTES)\n-            )\n             handed = allocator.alloc(_PAGE_SIZE)\n             self.assertIsNotNone(handed)\n             with self.assertRaisesRegex(RuntimeError, \"non-empty\"):\n-                allocator.resize(\n-                    SimpleNamespace(unified_memory_pool_bytes=_FINAL_BYTES)\n-                )\n+                allocator.resize(final)\n             allocator.free(handed)\n \n         eager = _bundle(total_bytes=_FINAL_BYTES, post_capture_active=False)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ba33e75d49a9516452f21319556754642679713f/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_unified_post_capture_sizing.py",
      "sha": "7f670ab18efb07d5d22045633adeb52891247c3a",
      "status": "modified"
    }
