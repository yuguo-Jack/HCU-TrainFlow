      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fspeculative%2Fngram_worker.py?ref=aebaa4af165eed812ca911aa2638bfc21e1c0e3e",
      "deletions": 0,
      "filename": "python/sglang/srt/speculative/ngram_worker.py",
      "patch": "@@ -7,6 +7,7 @@\n from sglang.kernels.ops.speculative.cache_locs import (\n     assign_extend_cache_locs_func as assign_extend_cache_locs_func,\n )\n+from sglang.srt.environ import envs\n from sglang.srt.layers.logprob_processor import compute_spec_logprobs\n from sglang.srt.managers.schedule_batch import ScheduleBatch\n from sglang.srt.managers.scheduler import GenerationBatchResult\n@@ -485,6 +486,7 @@ def forward_batch_generation(\n                 logits_output,\n                 grammar_mask,\n                 watermark_state=self.model_runner.watermark_state,\n+                force_greedy_verify=envs.SGLANG_NGRAM_FORCE_GREEDY_VERIFY.get(),\n             )\n             new_seq_lens = batch.seq_lens + accept_lens\n             commit_mamba_states_after_verify(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aebaa4af165eed812ca911aa2638bfc21e1c0e3e/python%2Fsglang%2Fsrt%2Fspeculative%2Fngram_worker.py",
