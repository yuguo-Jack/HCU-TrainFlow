      "patch": "@@ -747,6 +747,7 @@ def eagle_sample(\n     *,\n     watermark_state: Optional[WatermarkState] = None,\n     watermark_full_mask: bool = True,\n+    force_greedy_verify: bool = False,\n ):\n     \"\"\"\n     Verify and find accepted tokens based on logits output and batch\n@@ -859,7 +860,7 @@ def eagle_sample(\n     target_predict = None\n     use_rejection_sampling = get_spec().speculative_use_rejection_sampling\n     if _verify_uses_greedy(\n-        is_all_greedy=sampling_info.is_all_greedy,\n+        is_all_greedy=sampling_info.is_all_greedy or force_greedy_verify,\n         is_cpu=_is_cpu,\n         is_hip=_is_hip,\n         is_xpu=_is_xpu,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/aebaa4af165eed812ca911aa2638bfc21e1c0e3e/python%2Fsglang%2Fsrt%2Fspeculative%2Feagle_utils.py",
