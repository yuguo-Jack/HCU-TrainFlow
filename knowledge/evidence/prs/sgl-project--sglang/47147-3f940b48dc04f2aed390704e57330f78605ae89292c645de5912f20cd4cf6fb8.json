  "files": [
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/57474076901af59de172266ddfd28af673a910f4/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py?ref=57474076901af59de172266ddfd28af673a910f4",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/layernorm.py",
      "patch": "@@ -481,7 +481,11 @@ def __init__(\n         if self.has_weight:\n             self.weight = nn.Parameter(torch.ones(hidden_size, dtype=weight_dtype))\n         else:\n-            self.weight = torch.ones(hidden_size, dtype=weight_dtype)\n+            # A buffer, not a plain attribute: the memory saver restores buffers after\n+            # release_memory_occupation, so the ones survive offload.\n+            self.register_buffer(\n+                \"weight\", torch.ones(hidden_size, dtype=weight_dtype), persistent=False\n+            )\n         self.variance_epsilon = eps\n         self.hidden_size = hidden_size\n         self.variance_size_override = (",
      "raw_url": "https://github.com/sgl-project/sglang/raw/57474076901af59de172266ddfd28af673a910f4/python%2Fsglang%2Fsrt%2Flayers%2Flayernorm.py",
      "sha": "73efcf08552fdd1c7b58aa93ffff56530396a510",
      "status": "modified"
    },
    {
      "additions": 38,
      "blob_url": "https://github.com/sgl-project/sglang/blob/57474076901af59de172266ddfd28af673a910f4/test%2Fregistered%2Funit%2Flayers%2Ftest_rmsnorm_weightless_buffer.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Flayers%2Ftest_rmsnorm_weightless_buffer.py?ref=57474076901af59de172266ddfd28af673a910f4",
      "deletions": 0,
      "filename": "test/registered/unit/layers/test_rmsnorm_weightless_buffer.py",
      "patch": "@@ -0,0 +1,38 @@\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+import unittest\n+\n+import torch\n+\n+from sglang.srt.layers.layernorm import RMSNorm\n+from sglang.srt.server_args import ServerArgs, set_global_server_args_for_scheduler\n+\n+\n+class TestWeightlessRMSNorm(unittest.TestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        set_global_server_args_for_scheduler(ServerArgs(model_path=\"dummy\"))\n+\n+    def test_weightless_norm_registers_its_ones_as_a_buffer(self):\n+        # release_memory_occupation restores the model's buffers after resume; a\n+        # plain tensor attribute in the weights region would come back as zeros.\n+        norm = RMSNorm(16, has_weight=False)\n+        self.assertIn(\"weight\", dict(norm.named_buffers()))\n+        self.assertNotIn(\"weight\", dict(norm.named_parameters()))\n+        self.assertNotIn(\"weight\", norm.state_dict())\n+        torch.testing.assert_close(norm.weight, torch.ones(16))\n+\n+    def test_weightless_norm_follows_module_dtype_and_device_moves(self):\n+        norm = RMSNorm(16, has_weight=False).to(torch.bfloat16)\n+        self.assertEqual(norm.weight.dtype, torch.bfloat16)\n+\n+    def test_weighted_norm_keeps_a_parameter(self):\n+        norm = RMSNorm(16)\n+        self.assertIn(\"weight\", dict(norm.named_parameters()))\n+        self.assertNotIn(\"weight\", dict(norm.named_buffers()))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/57474076901af59de172266ddfd28af673a910f4/test%2Fregistered%2Funit%2Flayers%2Ftest_rmsnorm_weightless_buffer.py",
      "sha": "e703708a6b00d94bb7c9dc5e747c289c91917eaa",
      "status": "added"
    }
