      "deletions": 0,
      "filename": ".github/workflows/dco-check.yml",
      "patch": "@@ -0,0 +1,59 @@\n+name: DCO Check\n+\n+on:\n+  pull_request:\n+    types: [opened, synchronize, reopened, edited]\n+\n+permissions:\n+  contents: read\n+\n+concurrency:\n+  group: dco-check-${{ github.event.pull_request.number }}\n+  cancel-in-progress: true\n+\n+jobs:\n+  dco:\n+    name: Developer Certificate of Origin\n+    runs-on: ubuntu-latest\n+    steps:\n+      - name: Checkout\n+        uses: actions/checkout@v4\n+        with:\n+          fetch-depth: 0\n+          persist-credentials: false\n+\n+      - name: Check DCO sign-off\n+        env:\n+          BASE_SHA: ${{ github.event.pull_request.base.sha }}\n+          HEAD_SHA: ${{ github.event.pull_request.head.sha }}\n+        run: |\n+          set -euo pipefail\n+\n+          # Resolve the range before looping so missing commits fail the check.\n+          commits=$(git rev-list --no-merges \"$BASE_SHA..$HEAD_SHA\")\n+          failed=0\n+          while IFS= read -r sha; do\n+            [[ -z \"$sha\" ]] && continue\n+\n+            message=$(git log -1 --format='%B' \"$sha\")\n+            trailers=$(printf '%s\\n' \"$message\" | git interpret-trailers --parse)\n+            if ! grep -Eq '^Signed-off-by: [^<>[:space:]][^<>]* <[^<>[:space:]@]+@[^<>[:space:]@]+>$' <<< \"$trailers\"; then\n+              echo \"::error::Commit $sha is missing a valid Signed-off-by trailer.\"\n+              echo \"  Subject: $(git log -1 --format='%s' \"$sha\")\"\n+              echo \"  Author:  $(git log -1 --format='%an <%ae>' \"$sha\")\"\n+              failed=1\n+            fi\n+          done <<< \"$commits\"\n+\n+          if [[ \"$failed\" -eq 1 ]]; then\n+            echo \"Every non-merge commit must end with a sign-off trailer:\"\n+            echo \"  Signed-off-by: Your Name <your.email@example.com>\"\n+            echo \"Use git commit -s for new commits.\"\n+            echo \"For your latest commit: git commit --amend --no-edit --signoff\"\n+            echo \"For your last N commits: git rebase --signoff HEAD~N\"\n+            echo \"Then update the PR with: git push --force-with-lease\"\n+            echo \"Only sign off contributions you can certify under https://developercertificate.org/\"\n+            exit 1\n+          fi\n+\n+          echo \"All non-merge commits have valid DCO sign-off trailers.\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bf2d469148d1639816b0ac076fe8e9e19ddab34e/.github%2Fworkflows%2Fdco-check.yml",
      "sha": "6d7d88e80ae6cb0a227793454a244180e71fe526",
      "status": "added"
    }
  ],
