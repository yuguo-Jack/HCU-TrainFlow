  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8b7c114a05999d4ea60dfd4852b2570e3b1bb5a8/python%2Fsglang%2Fsrt%2Fmodels%2Fqwen3_classification.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fqwen3_classification.py?ref=8b7c114a05999d4ea60dfd4852b2570e3b1bb5a8",
      "deletions": 0,
      "filename": "python/sglang/srt/models/qwen3_classification.py",
      "patch": "@@ -134,6 +134,9 @@ def __init__(\n     ) -> None:\n         super().__init__(config, quant_config, prefix)\n         self.score = nn.Linear(config.hidden_size, config.num_labels)\n+        # Standard Qwen3 checkpoints have no score.bias. Keep it neutral unless\n+        # an explicit bias is supplied by the checkpoint.\n+        nn.init.zeros_(self.score.bias)\n         # Use normalize=True for qwen3 embedding based on official implementation\n         # Reference: https://github.com/QwenLM/Qwen3-Embedding/blob/main/examples/qwen3_embedding_transformers.py#L55\n         # Official code: output = F.normalize(output, p=2, dim=1)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8b7c114a05999d4ea60dfd4852b2570e3b1bb5a8/python%2Fsglang%2Fsrt%2Fmodels%2Fqwen3_classification.py",
      "sha": "c728f6caa91801128506dfa9868e54acda12d3d1",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/sgl-project/sglang/blob/8b7c114a05999d4ea60dfd4852b2570e3b1bb5a8/test%2Fregistered%2Funit%2Fmodels%2Ftest_qwen3_classification_bias.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmodels%2Ftest_qwen3_classification_bias.py?ref=8b7c114a05999d4ea60dfd4852b2570e3b1bb5a8",
      "deletions": 0,
      "filename": "test/registered/unit/models/test_qwen3_classification_bias.py",
      "patch": "@@ -0,0 +1,44 @@\n+\"\"\"Checkpoint parity for the Qwen3 sequence-classification head.\"\"\"\n+\n+import unittest\n+from unittest.mock import patch\n+\n+import torch\n+from torch import nn\n+from transformers import Qwen3Config\n+\n+from sglang.srt.models.qwen3_classification import Qwen3ForSequenceClassification\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+class TestQwen3ClassificationBias(CustomTestCase):\n+    def test_checkpoint_bias(self):\n+        \"\"\"Missing bias must be neutral; an explicit checkpoint bias must survive.\"\"\"\n+        config = Qwen3Config(hidden_size=8, num_labels=3)\n+        weight = torch.arange(24, dtype=torch.float32).reshape(3, 8) / 10\n+        hidden_states = torch.arange(16, dtype=torch.float32).reshape(2, 8) / 10\n+        for bias in (None, torch.tensor([0.1, -0.2, 0.3])):\n+            with self.subTest(bias=bias):\n+                # The backbone is unrelated to head initialization and loading.\n+                with patch(\n+                    \"sglang.srt.models.qwen3_classification.Qwen3Model\",\n+                    return_value=nn.Identity(),\n+                ):\n+                    model = Qwen3ForSequenceClassification(config)\n+                checkpoint = [(\"score.weight\", weight)]\n+                if bias is not None:\n+                    checkpoint.append((\"score.bias\", bias))\n+                model.load_weights(iter(checkpoint))\n+                torch.testing.assert_close(\n+                    model.score(hidden_states),\n+                    nn.functional.linear(hidden_states, weight, bias),\n+                    rtol=0,\n+                    atol=0,\n+                )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/8b7c114a05999d4ea60dfd4852b2570e3b1bb5a8/test%2Fregistered%2Funit%2Fmodels%2Ftest_qwen3_classification_bias.py",
      "sha": "6a5c6030e389ac7ebc6994b309dd22113c797f64",
      "status": "added"
    }
  ],
