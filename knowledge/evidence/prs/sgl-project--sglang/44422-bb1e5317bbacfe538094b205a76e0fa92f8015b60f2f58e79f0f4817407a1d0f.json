    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0276104d406b8199ea6a410ce872f545645ba1a9/python%2Fsglang%2Fsrt%2Fmem_cache%2Fhicache_storage.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Fhicache_storage.py?ref=0276104d406b8199ea6a410ce872f545645ba1a9",
      "deletions": 1,
      "filename": "python/sglang/srt/mem_cache/hicache_storage.py",
      "patch": "@@ -417,7 +417,7 @@ def __init__(\n             self.config_suffix += f\"_cp{attn_cp_rank}_{attn_cp_size}\"\n \n         if not os.path.exists(self.file_path) and tp_rank == 0 and attn_cp_rank == 0:\n-            os.makedirs(self.file_path)\n+            os.makedirs(self.file_path, exist_ok=True)\n             logger.info(f\"Created HiCacheFile storage directory at {self.file_path}\")\n \n         # Metadata cache positive lookup toggle & TTL",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0276104d406b8199ea6a410ce872f545645ba1a9/python%2Fsglang%2Fsrt%2Fmem_cache%2Fhicache_storage.py",
      "sha": "d154ed17a8db894198a025ca72c21bbdc1b89870",
      "status": "modified"
    },
    {
      "additions": 106,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0276104d406b8199ea6a410ce872f545645ba1a9/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_hicache_file_directory_race.py",
      "changes": 106,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_hicache_file_directory_race.py?ref=0276104d406b8199ea6a410ce872f545645ba1a9",
      "deletions": 0,
      "filename": "test/registered/unit/mem_cache/test_hicache_file_directory_race.py",
      "patch": "@@ -0,0 +1,106 @@\n+\"\"\"CPU-only directory initialization checks; no server or GPU required.\"\"\"\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n+\n+import os\n+import tempfile\n+import threading\n+import unittest\n+from concurrent.futures import ThreadPoolExecutor\n+from unittest import mock\n+\n+from sglang.srt.mem_cache.hicache_storage import HiCacheFile, HiCacheStorageConfig\n+from sglang.test.test_utils import CustomTestCase\n+\n+\n+def _config(path, *, pp_rank=0, tp_rank=0):\n+    return HiCacheStorageConfig(\n+        tp_rank=tp_rank,\n+        tp_size=2,\n+        pp_rank=pp_rank,\n+        pp_size=2,\n+        attn_cp_rank=0,\n+        attn_cp_size=1,\n+        is_mla_model=False,\n+        enable_storage_metrics=False,\n+        is_page_first_layout=True,\n+        model_name=\"directory-test\",\n+        extra_config={\n+            \"file_storage_path\": path,\n+            \"enable_metadata_cache\": False,\n+            \"max_size\": 0,\n+            \"min_free_space\": 0,\n+        },\n+    )\n+\n+\n+class TestHiCacheFileDirectoryCreation(CustomTestCase):\n+    def setUp(self):\n+        self.environment = mock.patch.dict(os.environ)\n+        self.environment.start()\n+        os.environ.pop(\"SGLANG_HICACHE_FILE_BACKEND_STORAGE_DIR\", None)\n+\n+    def tearDown(self):\n+        self.environment.stop()\n+\n+    def test_pipeline_rank_zero_workers_can_create_one_directory(self):\n+        with tempfile.TemporaryDirectory() as parent:\n+            path = os.path.join(parent, \"shared\")\n+            checked_absent = threading.Barrier(2)\n+            real_exists = os.path.exists\n+\n+            def exists(candidate):\n+                result = real_exists(candidate)\n+                if os.fspath(candidate) == path:\n+                    # Force both workers to observe the real absent directory\n+                    # before either proceeds; do not fake mkdir's result.\n+                    checked_absent.wait(timeout=5)\n+                return result\n+\n+            errors = []\n+            backends = []\n+            with mock.patch(\"os.path.exists\", side_effect=exists):\n+                with ThreadPoolExecutor(max_workers=2) as pool:\n+                    futures = [\n+                        pool.submit(HiCacheFile, _config(path, pp_rank=rank))\n+                        for rank in (0, 1)\n+                    ]\n+                    for future in futures:\n+                        try:\n+                            backends.append(future.result(timeout=10))\n+                        except Exception as error:\n+                            errors.append(error)\n+            self.assertEqual(errors, [])\n+            self.assertEqual(len(backends), 2)\n+            self.assertTrue(os.path.isdir(path))\n+            self.assertNotEqual(backends[0].config_suffix, backends[1].config_suffix)\n+\n+    def test_existing_directory_is_preserved(self):\n+        with tempfile.TemporaryDirectory() as path:\n+            sentinel = os.path.join(path, \"keep\")\n+            with open(sentinel, \"w\") as stream:\n+                stream.write(\"unchanged\")\n+            backend = HiCacheFile(_config(path))\n+            self.assertEqual(backend.file_path, path)\n+            with open(sentinel) as stream:\n+                self.assertEqual(stream.read(), \"unchanged\")\n+\n+    def test_nonzero_tp_rank_keeps_existing_directory_policy(self):\n+        with tempfile.TemporaryDirectory() as parent:\n+            path = os.path.join(parent, \"absent\")\n+            backend = HiCacheFile(_config(path, tp_rank=1))\n+            self.assertEqual(backend.file_path, path)\n+            self.assertFalse(os.path.exists(path))\n+\n+    def test_creation_permission_error_is_not_swallowed(self):\n+        with tempfile.TemporaryDirectory() as parent:\n+            path = os.path.join(parent, \"absent\")\n+            with mock.patch(\"os.makedirs\", side_effect=PermissionError(\"denied\")):\n+                with self.assertRaises(PermissionError):\n+                    HiCacheFile(_config(path))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0276104d406b8199ea6a410ce872f545645ba1a9/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_hicache_file_directory_race.py",
      "sha": "2f8d74770a61243cf91d21dd14c42e38c95205ae",
      "status": "added"
    }
