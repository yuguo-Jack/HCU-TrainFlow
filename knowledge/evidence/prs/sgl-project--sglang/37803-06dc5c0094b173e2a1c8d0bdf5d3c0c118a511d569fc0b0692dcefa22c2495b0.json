      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/4756cf25a0d7f1170f9c9e79b80dc707cf35e01c/test%2Fregistered%2Fkernels%2Fops%2Fmoe%2Ftest_moe_preprocess.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fkernels%2Fops%2Fmoe%2Ftest_moe_preprocess.py?ref=4756cf25a0d7f1170f9c9e79b80dc707cf35e01c",
      "deletions": 0,
      "filename": "test/registered/kernels/ops/moe/test_moe_preprocess.py",
      "patch": "@@ -6,6 +6,7 @@\n import pytest\n import torch\n \n+from sglang.kernels.ops.moe import inkling_moe\n from sglang.kernels.ops.moe.inkling_moe import (\n     SMALL_M_BLOCK_SIZE_M,\n     compute_grouped_gemm_metadata,\n@@ -23,6 +24,12 @@\n TOPK = 6\n \n \n+@pytest.mark.parametrize(\"is_sm12x, expected\", [(True, 3), (False, 4)])\n+def test_small_grouped_gemm_stage_policy(monkeypatch, is_sm12x: bool, expected: int):\n+    monkeypatch.setattr(inkling_moe, \"is_sm120_supported\", lambda: is_sm12x)\n+    assert inkling_moe._small_m_grouped_gemm_num_stages() == expected\n+\n+\n def _reference(topk_ids_flat: torch.Tensor):\n     reorder_topk_ids, reorder_ids = torch.sort(\n         topk_ids_flat.to(torch.int16), stable=True",
