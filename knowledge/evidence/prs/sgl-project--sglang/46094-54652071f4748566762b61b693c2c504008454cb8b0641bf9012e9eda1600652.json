      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fprotocol.py?ref=ae560c64b6ff6f452e52b00ceabe453bbf5911a8",
      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/openai/protocol.py",
      "patch": "@@ -59,6 +59,7 @@\n     ConfigDict,\n     Field,\n     StrictBool,\n+    computed_field,\n     field_serializer,\n     field_validator,\n     model_serializer,\n@@ -206,6 +207,10 @@ def _serialize(self, handler):\n         return data\n \n \n+class CompletionTokensDetails(BaseModel):\n+    reasoning_tokens: int = 0\n+\n+\n class UsageInfo(BaseModel):\n     prompt_tokens: int = 0\n     total_tokens: int = 0\n@@ -214,6 +219,12 @@ class UsageInfo(BaseModel):\n     prompt_tokens_details: Optional[PromptTokensDetails] = None\n     reasoning_tokens: Optional[int] = 0\n \n+    @computed_field\n+    @property\n+    def completion_tokens_details(self) -> CompletionTokensDetails:\n+        # Derive both wire fields from the same cumulative counter.\n+        return CompletionTokensDetails(reasoning_tokens=self.reasoning_tokens or 0)\n+\n \n class StreamOptions(BaseModel):\n     include_usage: Optional[bool] = False",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ae560c64b6ff6f452e52b00ceabe453bbf5911a8/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fprotocol.py",
      "sha": "cd877a133563208ad0edd8a5fe584ce9515a65d8",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ae560c64b6ff6f452e52b00ceabe453bbf5911a8/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_protocol.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_protocol.py?ref=ae560c64b6ff6f452e52b00ceabe453bbf5911a8",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/openai/test_protocol.py",
      "patch": "@@ -38,10 +38,32 @@\n     UsageInfo,\n )\n from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n \n register_cpu_ci(est_time=7, suite=\"base-a-test-cpu\")\n \n \n+class TestReasoningUsage(CustomTestCase):\n+    def test_reasoning_details_follow_the_cumulative_counter(self):\n+        for count in (None, 0, 7):\n+            with self.subTest(count=count):\n+                usage = UsageInfo(reasoning_tokens=count)\n+                for payload in (\n+                    usage.model_dump(),\n+                    json.loads(usage.model_dump_json()),\n+                ):\n+                    self.assertEqual(payload[\"reasoning_tokens\"], count)\n+                    self.assertEqual(\n+                        payload[\"completion_tokens_details\"],\n+                        {\"reasoning_tokens\": count or 0},\n+                    )\n+                usage.reasoning_tokens = 11\n+                self.assertEqual(\n+                    usage.model_dump()[\"completion_tokens_details\"],\n+                    {\"reasoning_tokens\": 11},\n+                )\n+\n+\n class TestCompletionRequest(unittest.TestCase):\n     \"\"\"Test CompletionRequest protocol model\"\"\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ae560c64b6ff6f452e52b00ceabe453bbf5911a8/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_protocol.py",
      "sha": "e992f2153a239309369e2abdfcf8fc64c34ca0ff",
      "status": "modified"
    }
