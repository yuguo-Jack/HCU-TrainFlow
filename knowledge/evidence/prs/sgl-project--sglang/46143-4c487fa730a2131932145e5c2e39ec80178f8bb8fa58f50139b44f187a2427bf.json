      "filename": "python/sglang/lang/backend/runtime_endpoint.py",
      "patch": "@@ -347,7 +347,7 @@ def _assert_success(self, res):\n \n \n def compute_normalized_prompt_logprobs(input_logprobs):\n-    values = [x[0] for x in input_logprobs if x[0]]\n+    values = [x[0] for x in input_logprobs if x[0] is not None]\n     return sum(values) / len(values)\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/eb99459dc20704ba3379636abff71ac0cb9d160c/python%2Fsglang%2Flang%2Fbackend%2Fruntime_endpoint.py",
      "sha": "1b78a176d95c4d4fb52915020cbcca45a8314dac",
