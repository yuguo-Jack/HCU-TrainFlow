      "additions": 13,
      "blob_url": "https://github.com/sgl-project/sglang/blob/90b8049d325bc63049782a360f6c93527af275a0/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_tree_core.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_tree_core.py?ref=90b8049d325bc63049782a360f6c93527af275a0",
      "deletions": 4,
      "filename": "python/sglang/srt/mem_cache/unified_cache/unified_tree_core.py",
      "patch": "@@ -2903,10 +2903,19 @@ def adjust_component_size(\n         cd = node.component_data[component_type]\n         if node is self.root_node or cd.value is None:\n             return\n-        if cd.lock_ref > 0:\n-            self.component_protected_size_[component_type] += delta\n-        else:\n-            self.component_evictable_size_[component_type] += delta\n+        protected = cd.lock_ref > 0\n+        sizes = (\n+            self.component_protected_size_\n+            if protected\n+            else self.component_evictable_size_\n+        )\n+        current = sizes[component_type]\n+        if current + delta < 0:\n+            raise ValueError(\n+                f\"invalid size delta {delta} for node {node_id} component \"\n+                f\"{component_type}: current={current}, protected={protected}\"\n+            )\n+        sizes[component_type] = current + delta\n \n     def get_component_device_value(\n         self, node_id: NodeId, component_type: ComponentType",
      "raw_url": "https://github.com/sgl-project/sglang/raw/90b8049d325bc63049782a360f6c93527af275a0/python%2Fsglang%2Fsrt%2Fmem_cache%2Funified_cache%2Funified_tree_core.py",
