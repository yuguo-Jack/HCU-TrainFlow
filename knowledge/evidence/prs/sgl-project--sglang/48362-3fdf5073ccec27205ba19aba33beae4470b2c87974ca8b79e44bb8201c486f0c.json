      "blob_url": "https://github.com/sgl-project/sglang/blob/be155dc83515ca6929fc6b7ac210a987c21c4e46/python%2Fsglang%2Ftest%2Frunners.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Ftest%2Frunners.py?ref=be155dc83515ca6929fc6b7ac210a987c21c4e46",
      "deletions": 1,
      "filename": "python/sglang/test/runners.py",
      "patch": "@@ -104,6 +104,21 @@ def get_token_ids_logprobs(logits, token_ids):\n     return logprobs\n \n \n+def _disable_chat_template_rendering(model) -> None:\n+    # sentence-transformers >= 6 renders plain text through the backbone's chat\n+    # template (the \"message\" modality); SGLang embeds the raw text.\n+    from sentence_transformers import __version__ as st_version\n+\n+    if int(st_version.split(\".\")[0]) < 6:\n+        return\n+    transformer = model[0]\n+    if \"message\" in transformer.modality_config:\n+        del transformer.modality_config[\"message\"]\n+        transformer.input_formatter.supported_modalities = list(\n+            transformer.modality_config.keys()\n+        )\n+\n+\n def _get_sentence_transformer_embedding_model(\n     model_path, torch_dtype, matryoshka_dim: Optional[int] = None\n ):\n@@ -126,9 +141,16 @@ def _get_sentence_transformer_embedding_model(\n         # BOS/EOS behavior matches between the HF reference and SRT.\n         _fix_v5_add_bos_eos_token(model.tokenizer, model_path)\n     else:  # if no pre-trained sentence-transformers model\n+        from sentence_transformers import __version__ as st_version\n         from sentence_transformers import models\n \n-        word_embedding_model = models.Transformer(model_path).to(dtype=torch_dtype)\n+        # Force causal attention as in the branch above; the kwarg was renamed in v6.\n+        config_kw = (\n+            \"config_kwargs\" if int(st_version.split(\".\")[0]) >= 6 else \"config_args\"\n+        )\n+        word_embedding_model = models.Transformer(\n+            model_path, **{config_kw: {\"is_causal\": True}}\n+        ).to(dtype=torch_dtype)\n         # In transformers v5, composite configs (e.g. Qwen2VLConfig) may not\n         # expose hidden_size at the top level.  Patch it from the text sub-config\n         # so sentence_transformers' get_word_embedding_dimension() works.\n@@ -147,6 +169,7 @@ def _get_sentence_transformer_embedding_model(\n             modules=[word_embedding_model, pooling_model], truncate_dim=matryoshka_dim\n         )\n \n+    _disable_chat_template_rendering(model)\n     return model.to(get_device())\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/be155dc83515ca6929fc6b7ac210a987c21c4e46/python%2Fsglang%2Ftest%2Frunners.py",
      "sha": "11cfec1196b0dd61f46ab0a70570dd43f4c9bf31",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/be155dc83515ca6929fc6b7ac210a987c21c4e46/test%2Fregistered%2Fprefill_only%2Ftest_embedding_models.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fprefill_only%2Ftest_embedding_models.py?ref=be155dc83515ca6929fc6b7ac210a987c21c4e46",
      "deletions": 0,
      "filename": "test/registered/prefill_only/test_embedding_models.py",
      "patch": "@@ -20,6 +20,7 @@\n import torch\n from transformers import AutoConfig, AutoTokenizer\n \n+from sglang.srt.utils import is_xpu\n from sglang.test.ci.ci_register import register_amd_ci, register_cuda_ci\n from sglang.test.runners import DEFAULT_PROMPTS, HFRunner, SRTRunner\n from sglang.test.test_utils import (\n@@ -99,12 +100,15 @@ def assert_close_prefill_logits(\n             hf_outputs = hf_runner.forward(truncated_prompts)\n \n         attention_backend = \"triton\" if is_in_amd_ci() else None\n+        # On a 24 GB XPU the 8B models leave too few KV tokens at the default fraction for the ~6.4k-token prompt.\n+        srt_kwargs = {\"mem_fraction_static\": 0.85} if is_xpu() else {}\n         with SRTRunner(\n             model_path,\n             tp_size=tp_size,\n             torch_dtype=torch_dtype,\n             model_type=\"embedding\",\n             attention_backend=attention_backend,\n+            **srt_kwargs,\n             json_model_override_args=(\n                 {\"matryoshka_dimensions\": [matryoshka_dim]} if matryoshka_dim else None\n             ),",
      "raw_url": "https://github.com/sgl-project/sglang/raw/be155dc83515ca6929fc6b7ac210a987c21c4e46/test%2Fregistered%2Fprefill_only%2Ftest_embedding_models.py",
      "sha": "0404483ef90130d584eb75a37e829054cc2be18f",
      "status": "modified"
