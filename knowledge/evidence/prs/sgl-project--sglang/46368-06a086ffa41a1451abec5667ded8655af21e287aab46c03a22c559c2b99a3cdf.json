      "changes": 11,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fgemma4_detector.py?ref=b6c59a9418c1cbe6c802884e5b7054928822412d",
      "deletions": 6,
      "filename": "python/sglang/srt/function_call/gemma4_detector.py",
      "patch": "@@ -377,9 +377,10 @@ def parse_streaming_increment(\n \n                                 calls.append(\n                                     ToolCallItem(\n-                                        tool_index=self._tool_indices.get(\n-                                            func_name, -1\n-                                        ),\n+                                        # Streaming deltas index tool calls by\n+                                        # their order in the response, not by\n+                                        # the tool's position in the request.\n+                                        tool_index=self.current_tool_id,\n                                         name=func_name,\n                                         parameters=\"\",\n                                     )\n@@ -408,9 +409,7 @@ def parse_streaming_increment(\n \n                             calls.append(\n                                 ToolCallItem(\n-                                    tool_index=self._tool_indices.get(\n-                                        self.current_func_name, -1\n-                                    ),\n+                                    tool_index=self.current_tool_id,\n                                     parameters=json.dumps(\n                                         arguments, ensure_ascii=False\n                                     ),",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b6c59a9418c1cbe6c802884e5b7054928822412d/python%2Fsglang%2Fsrt%2Ffunction_call%2Fgemma4_detector.py",
      "sha": "a218cfdb2168255b7509ddbcaf5746408d2c3850",
      "status": "modified"
    },
    {
      "additions": 49,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b6c59a9418c1cbe6c802884e5b7054928822412d/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gemma4_streaming_index.py",
      "changes": 49,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gemma4_streaming_index.py?ref=b6c59a9418c1cbe6c802884e5b7054928822412d",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_gemma4_streaming_index.py",
      "patch": "@@ -0,0 +1,49 @@\n+\"\"\"Unit tests for Gemma4Detector streaming tool-call indices - no server.\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.entrypoints.openai.protocol import Function, Tool\n+from sglang.srt.function_call.gemma4_detector import Gemma4Detector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=3, suite=\"base-a-test-cpu\")\n+\n+\n+def _tools():\n+    return [\n+        Tool(\n+            type=\"function\",\n+            function=Function(name=\"f\", parameters={\"type\": \"object\"}),\n+        ),\n+        Tool(\n+            type=\"function\",\n+            function=Function(name=\"g\", parameters={\"type\": \"object\"}),\n+        ),\n+    ]\n+\n+\n+class TestGemma4StreamingIndex(CustomTestCase):\n+    def test_tool_index_follows_call_order(self):\n+        # OpenAI streaming deltas index tool calls by their order in the\n+        # response, not by the tool's position in the request tools array.\n+        detector = Gemma4Detector()\n+        result = detector.parse_streaming_increment(\n+            \"<|tool_call>call:g{x: 1}<tool_call|><|tool_call>call:f{y: 2}<tool_call|>\",\n+            _tools(),\n+        )\n+        self.assertEqual(\n+            [(c.name, c.tool_index) for c in result.calls],\n+            [(\"g\", 0), (None, 0), (\"f\", 1), (None, 1)],\n+        )\n+\n+    def test_single_later_tool_indexes_from_zero(self):\n+        detector = Gemma4Detector()\n+        result = detector.parse_streaming_increment(\n+            \"<|tool_call>call:g{x: 1}<tool_call|>\", _tools()\n+        )\n+        self.assertEqual([c.tool_index for c in result.calls], [0, 0])\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b6c59a9418c1cbe6c802884e5b7054928822412d/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_gemma4_streaming_index.py",
      "sha": "c02f993687afd87fe8279f55851bb04fb5d9456f",
      "status": "added"
    }
  ],
