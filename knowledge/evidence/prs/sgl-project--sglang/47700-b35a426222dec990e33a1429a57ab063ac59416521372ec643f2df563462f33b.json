      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_pp_mixin.py?ref=1bde99eee902a55a77de49bd020e68b1b9a8efb9",
      "deletions": 0,
      "filename": "python/sglang/srt/managers/scheduler_pp_mixin.py",
      "patch": "@@ -938,6 +938,15 @@ def _pp_recv_proxy_tensors(self: Scheduler) -> Optional[PPProxyTensors]:\n                 expected_kind=\"proxy\",\n                 all_gather_group=(self.attn_tp_group),\n             )\n+            # Record the forward stream on each received tensor to prevent\n+            # the caching allocator from recycling the memory before the\n+            # forward pass completes. This fixes a race condition when\n+            # pp_async_batch_depth > pp_size / 2 where the next recv can\n+            # overwrite tensors while the previous forward is still queued.\n+            # See: https://github.com/sgl-project/sglang/issues/47613\n+            for t in tensor_dict.values():\n+                if isinstance(t, torch.Tensor) and t.is_cuda:\n+                    t.record_stream(self.forward_stream)\n             pp_proxy_tensors = PPProxyTensors(tensor_dict)\n         return pp_proxy_tensors\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/1bde99eee902a55a77de49bd020e68b1b9a8efb9/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_pp_mixin.py",
      "sha": "6656f50eee819495b0f825cff5305c4732098b2e",
      "status": "modified"
    }
  ],
