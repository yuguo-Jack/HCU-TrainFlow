  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e0f04d8d4a877056c9f4d7540e73bd7741484bd7/docker%2Frocm.Dockerfile",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docker%2Frocm.Dockerfile?ref=e0f04d8d4a877056c9f4d7540e73bd7741484bd7",
      "deletions": 0,
      "filename": "docker/rocm.Dockerfile",
      "patch": "@@ -622,10 +622,16 @@ RUN pip uninstall -y aiter\n # block AITER_COMMIT overrides that predate that rule. The working tree was just\n # produced by a fresh `git clone` above, so there are no real user changes to\n # preserve.\n+# cherry pick ROCm/aiter#6042 to unpeel the 64-bit sparse MLA loop below Triton 3.8, may be removed in next aiter upgrade.\n+# Use its squash-merge commit on main: the PR-branch commit predates ROCm/aiter#6159 and no longer applies.\n+# gfx1250 keeps skipping it.\n # apply fix for v4 fp4 indexer, may be removed in next aiter upgrade\n RUN git clone ${AITER_REPO} \\\n  && cd aiter \\\n  && git checkout -f ${AITER_COMMIT} \\\n+ && if [ \"${GPU_ARCH_LIST}\" != \"gfx1250\" ]; then \\\n+    git cherry-pick --no-commit 57e2c6b42e17d926a6bb5378ce0d07d93520bd3f; \\\n+ fi \\\n  && sed -i 's/from functools import lru_cache/from functools import cache/' aiter/ops/flydsl/kernels/mqa_logits/pa_mqa_logits_fp4_prefill.py \\\n  && sed -i 's/@lru_cache(maxsize=32)/@cache/' aiter/ops/flydsl/kernels/mqa_logits/pa_mqa_logits_fp4_prefill.py \\\n  && git submodule update --init --recursive \\",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e0f04d8d4a877056c9f4d7540e73bd7741484bd7/docker%2Frocm.Dockerfile",
      "sha": "e9de1c19bcb91cc94bb40c07a7a7dee8ec5c9ac8",
      "status": "modified"
    }
  ],
  "inline_comments": [],
  "issue_comments": [
    {
      "body": "Closing, per @1am9trash:\r\n\r\n> This shouldn't be needed. New perf move to ROCm 10, so ROCm 7.2 only needs to run correctly. Otherwise we keep piling patches into the Docker image.\r\n\r\nThe ROCm 10 images ship Triton 3.8 and don't need this patch. ROCm/aiter#6042 will come in with the next AITER pin bump.\r\n",
      "created_at": "2026-10-19T13:48:18Z",
