  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/26aacf22ce6c3e2b9accc37007392e3a513ed17c/docs%2Fdocs%2Fadvanced_features%2Fserver_arguments.mdx",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fdocs%2Fadvanced_features%2Fserver_arguments.mdx?ref=26aacf22ce6c3e2b9accc37007392e3a513ed17c",
      "deletions": 0,
      "filename": "docs/docs/advanced_features/server_arguments.mdx",
      "patch": "@@ -324,6 +324,12 @@ Please consult the documentation below and [server_args.py](https://github.com/s\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}>`200`</td>\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Type: int</td>\n     </tr>\n+    <tr>\n+      <td style={{padding: \"9px 12px\", fontWeight: 500, backgroundColor: \"rgba(255,255,255,0.02)\"}}>`--max-payload-size`</td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Maximum size of an incoming HTTP request payload in bytes. Requests exceeding this limit will be rejected with a 413 (Request Entity Too Large). Applies to both Uvicorn and Granian (HTTP/1.1 and HTTP/2) backends. Increase this to accept large JSON bodies such as base64-encoded multimodal inputs. Default is 10 MB.</td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}>`10485760`</td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Type: int</td>\n+    </tr>\n </tbody>\n </table>\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/26aacf22ce6c3e2b9accc37007392e3a513ed17c/docs%2Fdocs%2Fadvanced_features%2Fserver_arguments.mdx",
      "sha": "ad0eee5d0b91648dab2bc6a1132418b017864bfd",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/26aacf22ce6c3e2b9accc37007392e3a513ed17c/python%2Fsglang%2Fsrt%2Farg_groups%2Ffield_order.py",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Ffield_order.py?ref=26aacf22ce6c3e2b9accc37007392e3a513ed17c",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/field_order.py",
      "patch": "@@ -129,6 +129,7 @@\n     \"enable_http2\",\n     \"http2_max_concurrent_streams\",\n     \"http2_initial_connection_window_size\",\n+    \"max_payload_size\",\n     \"ssl_keyfile\",\n     \"ssl_certfile\",\n     \"ssl_ca_certs\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/26aacf22ce6c3e2b9accc37007392e3a513ed17c/python%2Fsglang%2Fsrt%2Farg_groups%2Ffield_order.py",
      "sha": "7aef007137428744924f7bf9f59d2709ca2fa0a0",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/26aacf22ce6c3e2b9accc37007392e3a513ed17c/python%2Fsglang%2Fsrt%2Farg_groups%2Ffields%2Fserving.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Ffields%2Fserving.py?ref=26aacf22ce6c3e2b9accc37007392e3a513ed17c",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/fields/serving.py",
      "patch": "@@ -130,6 +130,14 @@ class Serving(msgspec.Struct):\n         \"Initial connection-level HTTP/2 receive window in bytes (1024 to \"\n         \"2^31 - 1). Only applies with --enable-http2.\",\n     ] = 1024 * 1024\n+    max_payload_size: A[\n+        int,\n+        \"Maximum size of an incoming HTTP request payload in bytes. Requests \"\n+        \"exceeding this limit will be rejected with a 413 (Request Entity Too \"\n+        \"Large). Applies to both Uvicorn and Granian (HTTP/1.1 and HTTP/2) \"\n+        \"backends. Increase this to accept large JSON bodies such as base64-\"\n+        \"encoded multimodal inputs. Default is 10 MB.\",\n+    ] = 10 * 1024 * 1024\n \n     # -------------------------------------------------------------------------\n     # SSL/TLS",
      "raw_url": "https://github.com/sgl-project/sglang/raw/26aacf22ce6c3e2b9accc37007392e3a513ed17c/python%2Fsglang%2Fsrt%2Farg_groups%2Ffields%2Fserving.py",
      "sha": "29070ea98acf3a50e6131bd09762fd991892e788",
      "status": "modified"
    },
    {
      "additions": 13,
      "blob_url": "https://github.com/sgl-project/sglang/blob/26aacf22ce6c3e2b9accc37007392e3a513ed17c/python%2Fsglang%2Fsrt%2Fentrypoints%2Fhttp_server.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fhttp_server.py?ref=26aacf22ce6c3e2b9accc37007392e3a513ed17c",
      "deletions": 4,
      "filename": "python/sglang/srt/entrypoints/http_server.py",
      "patch": "@@ -2712,17 +2712,19 @@ def _reserve_reuseport_socket(config: uvicorn.Config) -> socket.socket:\n         raise SystemExit(1) from error\n \n \n-def _granian_http1_settings():\n+def _granian_http1_settings(max_buffer_size: int = 10 * 1024 * 1024):\n     from granian.http import HTTP1Settings\n \n+    kwargs = {\"max_buffer_size\": max_buffer_size}\n     if not envs.SGLANG_TIMEOUT_KEEP_ALIVE.is_set():\n-        return HTTP1Settings()\n+        return HTTP1Settings(**kwargs)\n     timeout_s = envs.SGLANG_TIMEOUT_KEEP_ALIVE.get()\n     if timeout_s <= 0:\n         raise ValueError(\n             f\"SGLANG_TIMEOUT_KEEP_ALIVE must be a positive number of seconds, got {timeout_s}\"\n         )\n-    return HTTP1Settings(header_read_timeout=timeout_s * 1000)\n+    kwargs[\"header_read_timeout\"] = timeout_s * 1000\n+    return HTTP1Settings(**kwargs)\n \n \n def _run_granian_server(\n@@ -2731,6 +2733,7 @@ def _run_granian_server(\n     log_level,\n     http2_max_concurrent_streams,\n     http2_initial_connection_window_size,\n+    max_payload_size=10 * 1024 * 1024,\n     tokenizer_manager=None,\n     tokenizer_worker_num=1,\n     ssl_certfile=None,\n@@ -2768,9 +2771,10 @@ def _run_granian_server(\n         port=port,\n         interface=Interfaces.ASGI,\n         http=HTTPModes.auto,\n-        http1_settings=_granian_http1_settings(),\n+        http1_settings=_granian_http1_settings(max_buffer_size=max_payload_size),\n         http2_settings=HTTP2Settings(\n             initial_connection_window_size=http2_initial_connection_window_size,\n+            initial_stream_window_size=max_payload_size,\n             max_concurrent_streams=http2_max_concurrent_streams,\n         ),\n         log_level=log_level,\n@@ -2910,6 +2914,7 @@ def _setup_and_run_http_server(\n                     http2_initial_connection_window_size=(\n                         get_serving().http2_initial_connection_window_size\n                     ),\n+                    max_payload_size=