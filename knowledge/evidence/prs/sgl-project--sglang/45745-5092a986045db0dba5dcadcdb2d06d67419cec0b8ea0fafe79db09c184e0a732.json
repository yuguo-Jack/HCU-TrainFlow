  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3458c1f1900fbbaffc237d74491f30e6f8cf288c/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsv4%2Fdsv41_sparse.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsv4%2Fdsv41_sparse.py?ref=3458c1f1900fbbaffc237d74491f30e6f8cf288c",
      "deletions": 2,
      "filename": "python/sglang/srt/layers/attention/dsv4/dsv41_sparse.py",
      "patch": "@@ -287,5 +287,6 @@ def scores(\n     ) -> torch.Tensor:\n         \"\"\"q [t, H, d], k [n, d], weights [t, H] -> [t, n], summed over all heads.\"\"\"\n         s = torch.einsum(\"bhd,nd->bhn\", q, k)\n-        s = (s.relu() * weights.unsqueeze(-1)).sum(dim=1)\n-        return s.float()\n+        # In place: the [t, H, n] product is the largest prefill transient.\n+        s.relu_().mul_(weights.unsqueeze(-1))\n+        return s.sum(dim=1).float()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3458c1f1900fbbaffc237d74491f30e6f8cf288c/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsv4%2Fdsv41_sparse.py",
      "sha": "fe0eaf58e4239dfa1410f4e88935ece5607e0f3f",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3458c1f1900fbbaffc237d74491f30e6f8cf288c/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsv4%2Fv41_indexer%2Fscoring.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsv4%2Fv41_indexer%2Fscoring.py?ref=3458c1f1900fbbaffc237d74491f30e6f8cf288c",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/attention/dsv4/v41_indexer/scoring.py",
      "patch": "@@ -323,7 +323,7 @@ def dense_prefill_topk(\n # ---------- torch ----------\n \n \n-# Arbitrary cap on one bf16 [rows, heads, lc] score chunk; transients run ~3x this.\n+# Arbitrary cap on one bf16 [rows, heads, lc] score chunk; scores() works in place.\n _TORCH_SCORE_BUDGET_BYTES = 1 << 30\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3458c1f1900fbbaffc237d74491f30e6f8cf288c/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fdsv4%2Fv41_indexer%2Fscoring.py",
