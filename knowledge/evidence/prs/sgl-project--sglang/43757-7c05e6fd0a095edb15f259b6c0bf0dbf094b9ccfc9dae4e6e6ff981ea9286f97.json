  "files": [
    {
      "additions": 14,
      "blob_url": "https://github.com/sgl-project/sglang/blob/24dc5671d698c0a2f33035e54e5daf3e30d3109b/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=24dc5671d698c0a2f33035e54e5daf3e30d3109b",
      "deletions": 0,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -5156,6 +5156,10 @@ def is_fully_idle(self, for_health_check=False, ignore_waiting=False) -> bool:\n         # Waiting queues: waiting + bootstrapping + preallocation + kv transfer (decode)\n         if not ignore_waiting:\n             idle &= len(self.waiting_queue) == 0\n+        else:\n+            # A PD-decode request waiting with its transferred KV still owns\n+            # its request row; a flush would free it.\n+            idle &= not any(r.kv.holds_kv for r in self.waiting_queue)\n \n         if (\n             for_health_check\n@@ -5618,6 +5622,16 @@ def pause_generation(self, recv_req: PauseGenerationReqInput):\n         ):\n             retract_reqs.append(self.chunked_req)\n \n+        if self.disaggregation_mode == DisaggregationMode.DECODE:\n+            # Transferred requests wait for a slot holding their row and KV;\n+            # retract them too, so their KV is rebuilt under the new weights.\n+            staged = [r for r in self.waiting_queue if r.kv.holds_kv]\n+            if staged:\n+                self.waiting_queue = [\n+                    r for r in self.waiting_queue if not r.kv.holds_kv\n+                ]\n+                retract_reqs += staged\n+\n         self.last_batch = None\n         self.cur_batch_for_debug = None\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/24dc5671d698c0a2f33035e54e5daf3e30d3109b/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "5e548aef47cc21a4abc7831e6d516d007c202b60",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/24dc5671d698c0a2f33035e54e5daf3e30d3109b/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_flush_cache_after_retract.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_flush_cache_after_retract.py?ref=24dc5671d698c0a2f33035e54e5daf3e30d3109b",
      "deletions": 1,
      "filename": "test/registered/unit/managers/test_scheduler_flush_cache_after_retract.py",
      "patch": "@@ -13,9 +13,11 @@\n register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n \n \n-def _make_req(is_retracted: bool) -> MagicMock:\n+def _make_req(is_retracted: bool, holds_kv: bool = False) -> MagicMock:\n     req = MagicMock()\n     req.is_retracted = is_retracted\n+    # Retracted and never-scheduled requests hold no request row.\n+    req.kv.holds_kv = holds_kv\n     return req\n \n \n@@ -85,6 +87,18 @@ def test_flush_cache_succeeds_on_mixed_queue_while_paused(self):\n         self.assertTrue(scheduler.flush_cache())\n         scheduler.tree_cache.reset.assert_called_once()\n \n+    def test_paused_flush_refuses_waiting_req_holding_kv(self):\n+        \"\"\"A PD-decode request whose KV has arrived waits holding its request\n+        row; a paused flush would free KV it still owns.\"\"\"\n+        scheduler = self._new_scheduler()\n+        scheduler.waiting_queue = [\n+            _make_req(is_retracted=False),\n+            _make_req(is_retracted=False, holds_kv=True),\n+        ]\n+\n+        self.assertFalse(scheduler.flush_cache())\n+        scheduler.tree_cache.reset.assert_not_called()\n+\n     def test_is_fully_idle_default_ignores_nothing(self):\n         \"\"\"Regression guard: every other is_fully_idle() caller passes no args,\n         so a non-empty waiting_queue must still report not-idle by default.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/24dc5671d698c0a2f33035e54e5daf3e30d3109b/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_flush_cache_after_retract.py",
      "sha": "f46c35492da03ed01232804e8bd32ff411e2305f",
      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/sgl-project/sglang/blob/24dc5671d698c0a2f33035e54e5daf3e30d3109b/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_pause_generation.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_pause_generation.py?ref=24dc5671d698c0a2f33035e54e5daf3e30d3109b",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_scheduler_pause_generation.py",
      "patch": "@@ -647,6 +647,39 @@ def test_pd_decode_retract_requeues_for_rebootstrap(self):\n         mock_retract_all.assert_called_once()\n         self.assertEqual(mock_retract_all.call_args.kwargs[\"offload_kv\"], False)\n \n+    def test_pd_decode_retract_includes_transferred_waiting_reqs(self):\n+        \"\"\"A transferred request waiting for a running slot holds a request row\n+        and KV; retract must rebuild it too, so a paused flush cannot free it.\"\"\"\n+        scheduler = self._new_scheduler()\n+        scheduler.disaggregation_mode = DisaggregationMode.DECODE\n+        scheduler.disagg_decode_prealloc_queue = MagicMock()\n+\n+        def _req(rid, req_pool_idx):\n+            return SimpleNamespace(\n+                rid=rid,\n+                finished=lambda: False,\n+                output_ids=[7],\n+                time_stats=MagicMock(),\n+                kv=SimpleNamespace(holds_kv=req_pool_idx is not None),\n+            )\n+\n+        running = _req(\"running\", 0)\n+        staged = _req(\"staged\", 1)\n+        unstaged = _req(\"unstaged\", None)\n+        scheduler.running_batch.reqs = [running]\n+        scheduler.waiting_queue = [staged, unstaged]\n+\n+        with patch(\"sglang.srt.managers.scheduler.retract_all\") as mock_retract_all:\n+            scheduler.pause_generation(PauseGenerationReqInput(mode=\"retract\"))\n+\n+        self.assertEqual(mock_retract_all.call_args.kwargs[\"reqs\"], [running, staged])\n+        self.assertEqual(scheduler.waiting_queue, [unstaged])\n+        held = [\n+            c.args[0]\n+            for c in scheduler.disagg_decode_prealloc_queue.hold_rebootstrap.call_args_list\n+        ]\n+        self.assertEqual(held, [running, staged])\n+\n     def test_pd_decode_retract_completes_offload_before_free(self):\n         \"\"\"PD decode retract must not free KV an offload copy is still reading, and\n         must not leave offload acks that keep the paused engine from going idle.\"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/24dc5671d698c0a2f33035e54e5daf3e30d3109b/test%2Fregistered%2Funit%2Fmanagers%2Ftest_scheduler_pause_generation.py",
      "sha": "103fff5f0ab4361b8280b15784b650cfb36ea244",
      "status": "modified"
    }
