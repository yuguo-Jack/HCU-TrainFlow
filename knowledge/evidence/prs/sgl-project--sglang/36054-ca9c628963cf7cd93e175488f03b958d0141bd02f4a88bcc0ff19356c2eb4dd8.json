  "files": [
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/692877aaf61a91b049342de68aba03dbd5b3a4dc/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx?ref=692877aaf61a91b049342de68aba03dbd5b3a4dc",
      "deletions": 1,
      "filename": "docs/docs/references/environment_variables.mdx",
      "patch": "@@ -1381,7 +1381,7 @@ SGLang supports various environment variables that can be used to configure its\n     </tr>\n     <tr>\n       <td style={{padding: \"9px 12px\", fontWeight: 500, backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>SGLANG_ENABLE_WAR_BARRIER</code></td>\n-      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Force-enable the write-after-read barrier for the overlap scheduler even when CUDA is not detected (e.g. AMD/ROCm). On CUDA the barrier is always enabled.</td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>Force-enable the write-after-read barrier for the overlap scheduler on platforms where it is not enabled automatically. The barrier is always enabled on CUDA and ROCm.</td>\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>false</code></td>\n     </tr>\n     <tr>",
      "raw_url": "https://github.com/sgl-project/sglang/raw/692877aaf61a91b049342de68aba03dbd5b3a4dc/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx",
      "sha": "ac7d8e306d6ef1d87673b6b035ca0a7ebcadd878",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/692877aaf61a91b049342de68aba03dbd5b3a4dc/python%2Fsglang%2Fsrt%2Fenviron.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fenviron.py?ref=692877aaf61a91b049342de68aba03dbd5b3a4dc",
      "deletions": 2,
      "filename": "python/sglang/srt/environ.py",
      "patch": "@@ -578,8 +578,8 @@ class Envs:\n     # and reducing the impact of sampling overhead on the critical path.\n     SGLANG_ENABLE_DELAY_SAMPLE = EnvBool(False)\n     # Force-enable the WAR (write-after-read) barrier for the overlap scheduler\n-    # even when is_cuda() is False (e.g. AMD/ROCm). On CUDA the barrier is\n-    # already enabled regardless of this flag (see start_event_loop).\n+    # on platforms where it is not enabled automatically. CUDA and ROCm enable\n+    # the barrier regardless of this flag (see start_event_loop).\n     SGLANG_ENABLE_WAR_BARRIER = EnvBool(False)\n     # Force the WAR barrier to wait for the whole forward instead of the\n     # read-done fastpath event.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/692877aaf61a91b049342de68aba03dbd5b3a4dc/python%2Fsglang%2Fsrt%2Fenviron.py",
      "sha": "e6c9ea8406c38ad0d6d2969026d3affb78f2fedd",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/692877aaf61a91b049342de68aba03dbd5b3a4dc/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=692877aaf61a91b049342de68aba03dbd5b3a4dc",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -1727,7 +1727,9 @@ def run_event_loop(self) -> None:\n                 _redraws += 1\n         # The global WAR barrier fences the scheduler's next shared-buffer write\n         # on the previous forward's read of the unified memory pool.\n-        self._war_barrier_enabled = is_cuda() or envs.SGLANG_ENABLE_WAR_BARRIER.get()\n+        self._war_barrier_enabled = (\n+            is_cuda() or _is_hip or envs.SGLANG_ENABLE_WAR_BARRIER.get()\n+        )\n         with self.device_module.StreamContext(self.schedule_stream):\n             dispatch_event_loop(self)\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/692877aaf61a91b049342de68aba03dbd5b3a4dc/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "aa191696e8d57a4615bcc711957adf461d3fd51a",
      "status": "modified"
    }
