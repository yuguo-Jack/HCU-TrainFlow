      "filename": "python/sglang/srt/entrypoints/openai/serving_chat.py",
      "patch": "@@ -3008,6 +3008,12 @@ def _get_reasoning_from_request(self, request: ChatCompletionRequest) -> bool:\n             # output into reasoning_content.\n             return request.reasoning_effort not in (None, \"none\", \"no_think\")\n \n+        if self.reasoning_parser == \"inkling\":\n+            effort = self._parse_inkling_reasoning_effort(request.reasoning_effort)\n+            if effort is None:\n+                effort = self._inkling_default_reasoning_effort\n+            return effort != 0.0\n+\n         config = self.template_manager.reasoning_config\n         if config is None:\n             # Fallback to parser-level defaults when template toggle config",
      "raw_url": "https://github.com/sgl-project/sglang/raw/74926c0a538c4e97f2f12ee87f277a4ef3e0a021/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py",
