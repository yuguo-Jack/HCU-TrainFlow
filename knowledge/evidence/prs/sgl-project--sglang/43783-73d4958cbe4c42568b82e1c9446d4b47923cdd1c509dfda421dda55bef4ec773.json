  "files": [
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/14f9b086e74f4532338be05a4ed2b7192871df1d/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx?ref=14f9b086e74f4532338be05a4ed2b7192871df1d",
      "deletions": 0,
      "filename": "docs/docs/references/environment_variables.mdx",
      "patch": "@@ -431,6 +431,11 @@ SGLang supports various environment variables that can be used to configure its\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>FlashInfer workspace size in bytes (default ≈ 384 MiB).</td>\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>402653184</code></td>\n     </tr>\n+    <tr>\n+      <td style={{padding: \"9px 12px\", fontWeight: 500, backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>SGLANG_TRTLLM_WORKSPACE_MB</code></td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>TRT-LLM MLA attention workspace size in MB. The prefill softmax-stats region grows with the chunked prefill batch; a 64K-token batch needs ~175 MB. Raise this (e.g. <code>512</code>) when <code>chunked-prefill-size</code> is 32768 or larger.</td>\n+      <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>150</code></td>\n+    </tr>\n     <tr>\n       <td style={{padding: \"9px 12px\", fontWeight: 500, backgroundColor: \"rgba(255,255,255,0.02)\"}}><code>SGLANG_EAGER_INPUT_NO_COPY</code></td>\n       <td style={{padding: \"9px 12px\", backgroundColor: \"rgba(255,255,255,0.05)\"}}>In eager forward, wrap the ForwardBatch's own tensors instead of copying them into the CUDA graph buffer registry (skips a per-iter device-to-device copy).</td>",
      "raw_url": "https://github.com/sgl-project/sglang/raw/14f9b086e74f4532338be05a4ed2b7192871df1d/docs%2Fdocs%2Freferences%2Fenvironment_variables.mdx",
      "sha": "29849fd6f2b6b54bd6e00297724179e45d42767f",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/14f9b086e74f4532338be05a4ed2b7192871df1d/python%2Fsglang%2Fsrt%2Fenviron.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fenviron.py?ref=14f9b086e74f4532338be05a4ed2b7192871df1d",
      "deletions": 0,
      "filename": "python/sglang/srt/environ.py",
      "patch": "@@ -1088,6 +1088,10 @@ class Envs:\n     SGLANG_FLASHINFER_USE_PAGED = EnvBool(False)\n     # Default to the pick from flashinfer\n     SGLANG_FLASHINFER_WORKSPACE_SIZE = EnvInt(384 * 1024 * 1024)\n+    # TRT-LLM MLA attention workspace in MB. The prefill softmax-stats region\n+    # grows with the chunked prefill batch; a 64K-token batch needs ~175 MB.\n+    # Raise this (e.g. 512) when chunked-prefill-size >= 32768.\n+    SGLANG_TRTLLM_WORKSPACE_MB = EnvInt(150)\n     # Per-rank dispatch capacity of the FlashInfer MoE A2A dispatcher. Unset\n     # sizes it from the per-rank prefill chunk, with a 4096 floor.\n     SGLANG_FLASHINFER_NUM_MAX_DISPATCH_TOKENS_PER_RANK = EnvInt(None)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/14f9b086e74f4532338be05a4ed2b7192871df1d/python%2Fsglang%2Fsrt%2Fenviron.py",
      "sha": "7eba647fff4cf53f50f6c978070d4968972ac7fd",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/14f9b086e74f4532338be05a4ed2b7192871df1d/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Ftrtllm_mla_backend.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Ftrtllm_mla_backend.py?ref=14f9b086e74f4532338be05a4ed2b7192871df1d",
      "deletions": 4,
      "filename": "python/sglang/srt/layers/attention/trtllm_mla_backend.py",
      "patch": "@@ -84,9 +84,6 @@\n \n logger = logging.getLogger(__name__)\n \n-# Constants\n-DEFAULT_WORKSPACE_SIZE_MB = 150  # Memory workspace size in MB\n-\n # Block constraint from flashinfer requirements\n # From flashinfer.decode._check_trtllm_gen_mla_shape:\n #   block_num % (128 / block_size) == 0\n@@ -250,7 +247,7 @@ def __init__(\n         self.needs_cpu_seq_lens |= self._kv_shard_pool is not None\n \n         # Workspace allocation\n-        self.workspace_size = DEFAULT_WORKSPACE_SIZE_MB * 1024 * 1024\n+        self.workspace_size = envs.SGLANG_TRTLLM_WORKSPACE_MB.get() * 1024 * 1024\n         if self.backend == \"cute-dsl\":\n             # Separate buffer from trtllm-gen (see note above); safe to share\n             # among cute-dsl instances.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/14f9b086e74f4532338be05a4ed2b7192871df1d/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Ftrtllm_mla_backend.py",
      "sha": "d976066d738c01145c498475f2cc542d4a0cfb83",
      "status": "modified"
    }
