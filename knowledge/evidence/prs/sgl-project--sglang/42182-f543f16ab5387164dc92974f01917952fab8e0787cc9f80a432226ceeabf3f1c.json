      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2d16556b6a544cf407b6185ecf26f000334e9919/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Ftoken_dispatcher%2Fascend_tp.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Ftoken_dispatcher%2Fascend_tp.py?ref=2d16556b6a544cf407b6185ecf26f000334e9919",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/moe/token_dispatcher/ascend_tp.py",
      "patch": "@@ -98,7 +98,9 @@ def dispatch(\n         self, hidden_states: torch.Tensor, topk_output: TopKOutput\n     ) -> AscendTPDispatchOutput:\n         topk_weights, topk_ids, _ = topk_output\n-        topk_weights = topk_weights.to(hidden_states.dtype)\n+        # Keep routing weights in FP32: npu_moe_finalize_routing consumes\n+        # FP32 scales; downcasting discards precision (issue #39351).\n+        topk_weights = topk_weights.to(torch.float32)\n         topk_ids = topk_ids.to(torch.int32)\n         top_k = topk_weights.shape[-1]\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2d16556b6a544cf407b6185ecf26f000334e9919/python%2Fsglang%2Fsrt%2Flayers%2Fmoe%2Ftoken_dispatcher%2Fascend_tp.py",
      "sha": "84e6763482d51be3b4969258566af7f337f08a10",
      "status": "modified"
    }
