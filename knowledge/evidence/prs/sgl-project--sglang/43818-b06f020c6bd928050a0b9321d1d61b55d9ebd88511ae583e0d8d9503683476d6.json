  "files": [
    {
      "additions": 78,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9313b3f61d5d60a6e6c1468cf5a0ece270d45e83/benchmark%2Fscheduler%2Fbench_num_new_pages.py",
      "changes": 78,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/benchmark%2Fscheduler%2Fbench_num_new_pages.py?ref=9313b3f61d5d60a6e6c1468cf5a0ece270d45e83",
      "deletions": 0,
      "filename": "benchmark/scheduler/bench_num_new_pages.py",
      "patch": "@@ -0,0 +1,78 @@\n+import argparse\n+import statistics\n+import time\n+from collections.abc import Callable\n+\n+import torch\n+\n+from sglang.srt.utils.common import get_num_new_pages\n+\n+\n+def _legacy_count(seq_lens: torch.Tensor, page_size: int) -> int:\n+    return (seq_lens % page_size == 1).int().sum().item()\n+\n+\n+def _current_count(seq_lens: torch.Tensor, page_size: int) -> int:\n+    return get_num_new_pages(seq_lens, page_size=page_size, decode=True)\n+\n+\n+def _measure_us(\n+    fn: Callable[[torch.Tensor, int], int],\n+    seq_lens: torch.Tensor,\n+    page_size: int,\n+    iterations: int,\n+    repeats: int,\n+) -> float:\n+    samples = []\n+    for _ in range(repeats):\n+        start_ns = time.perf_counter_ns()\n+        for _ in range(iterations):\n+            fn(seq_lens, page_size)\n+        samples.append((time.perf_counter_ns() - start_ns) / iterations / 1_000)\n+    return statistics.median(samples)\n+\n+\n+def main() -> None:\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument(\"--batch-sizes\", nargs=\"+\", type=int, default=[1, 8, 32, 128])\n+    parser.add_argument(\"--iterations\", type=int, default=20_000)\n+    parser.add_argument(\"--page-size\", type=int, default=64)\n+    parser.add_argument(\"--repeats\", type=int, default=7)\n+    args = parser.parse_args()\n+\n+    print(f\"{'batch':>7} {'legacy_us':>12} {'current_us':>12} {'speedup':>10}\")\n+    for batch_size in args.batch_sizes:\n+        seq_lens = torch.arange(1, batch_size + 1, dtype=torch.int64)\n+        expected = _legacy_count(seq_lens, args.page_size)\n+        actual = _current_count(seq_lens, args.page_size)\n+        if actual != expected:\n+            raise RuntimeError(\n+                f\"page count mismatch for batch={batch_size}: {actual} != {expected}\"\n+            )\n+\n+        for _ in range(100):\n+            _legacy_count(seq_lens, args.page_size)\n+            _current_count(seq_lens, args.page_size)\n+\n+        legacy_us = _measure_us(\n+            _legacy_count,\n+            seq_lens,\n+            args.page_size,\n+            args.iterations,\n+            args.repeats,\n+        )\n+        current_us = _measure_us(\n+            _current_count,\n+            seq_lens,\n+            args.page_size,\n+            args.iterations,\n+            args.repeats,\n+        )\n+        print(\n+            f\"{batch_size:7d} {legacy_us:12.3f} {current_us:12.3f} \"\n+            f\"{legacy_us / current_us:9.2f}x\"\n+        )\n+\n+\n+if __name__ == \"__main__\":\n+    main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9313b3f61d5d60a6e6c1468cf5a0ece270d45e83/benchmark%2Fscheduler%2Fbench_num_new_pages.py",
      "sha": "343c1352d90ea6dfd9e9a3a11a19e1843044f5b0",
      "status": "added"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9313b3f61d5d60a6e6c1468cf5a0ece270d45e83/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py?ref=9313b3f61d5d60a6e6c1468cf5a0ece270d45e83",
      "deletions": 2,
      "filename": "python/sglang/srt/utils/common.py",
      "patch": "@@ -4884,7 +4884,7 @@ def get_num_new_pages(\n     page_size: int,\n     prefix_lens: Optional[torch.Tensor] = None,\n     decode: bool = False,\n-) -> torch.Tensor:\n+) -> int:\n     \"\"\"\n     Get the number of new pages for the given prefix and sequence lengths.\n     We use cpu tensors to avoid blocking kernel launch.\n@@ -4895,7 +4895,7 @@ def get_num_new_pages(\n     if prefix_lens is None or decode:\n         # NOTE: Special case for handling decode, which prefix lens is `seq_lens - 1`.\n         assert decode\n-        return (seq_lens % page_size == 1).int().sum().item()\n+        return torch.count_nonzero(seq_lens % page_size == 1).item()\n \n     assert prefix_lens.device == cpu_device\n     num_pages_after = (seq_lens + page_size - 1) // page_size",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9313b3f61d5d60a6e6c1468cf5a0ece270d45e83/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "sha": "70e312c4517c22a9f657f132c7ad33d61e16c5fc",
      "status": "modified"
    },
    {
      "additions": 38,
      "blob_url": "https://github.com/sgl-project/sglang/blob/9313b3f61d5d60a6e6c1468cf5a0ece270d45e83/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_num_new_pages.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_num_new_pages.py?ref=9313b3f61d5d60a6e6c1468cf5a0ece270d45e83",
      "deletions": 0,
      "filename": "test/registered/unit/mem_cache/test_num_new_pages.py",
      "patch": "@@ -0,0 +1,38 @@\n+import unittest\n+\n+import torch\n+from torch.utils._python_dispatch import TorchDispatchMode\n+\n+from sglang.srt.utils.common import get_num_new_pages\n+from sglang.test.ci.ci_register import register_cpu_ci, register_xpu_ci\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+register_xpu_ci(est_time=5, suite=\"stage-a-test-1-gpu-xpu\")\n+\n+\n+class _OperationRecorder(TorchDispatchMode):\n+    def __init__(self):\n+        self.operations = set()\n+\n+    def __torch_dispatch__(self, func, types, args=(), kwargs=None):\n+        self.operations.add(str(func))\n+        return func(*args, **(kwargs or {}))\n+\n+\n+class TestGetNumNewPages(unittest.TestCase):\n+    def test_decode_counts_page_boundaries_without_dtype_conversion(self):\n+        # Given: four requests, two of which start a new KV page on decode.\n+        seq_lens = torch.tensor([1, 2, 65, 130], dtype=torch.int64)\n+\n+        # When: the host-side decode allocator counts new pages.\n+        recorder = _OperationRecorder()\n+        with recorder:\n+            result = get_num_new_pages(seq_lens, page_size=64, decode=True)\n+\n+        # Then: the count is correct and the boolean mask is not copied to int32.\n+        self.assertEqual(result, 2)\n+        self.assertNotIn(\"aten._to_copy.default\", recorder.operations)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/9313b3f61d5d60a6e6c1468cf5a0ece270d45e83/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_num_new_pages.py",
      "sha": "d3314b9c8e66952d8a5ecfdb2b2c6b3940dfea39",
      "status": "added"
    }
