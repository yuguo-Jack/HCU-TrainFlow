      "additions": 39,
      "blob_url": "https://github.com/sgl-project/sglang/blob/f2aad50c4163d047d740fd61defea2d122ac5d30/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_chat.py",
      "changes": 39,
