      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py?ref=f2aad50c4163d047d740fd61defea2d122ac5d30",
      "deletions": 4,
      "filename": "python/sglang/srt/entrypoints/openai/serving_chat.py",
      "patch": "@@ -3066,10 +3066,18 @@ def _get_reasoning_from_request(self, request: ChatCompletionRequest) -> bool:\n                 )\n             if mode in (\"explicit_thinking\", \"explicit_enable_thinking\"):\n                 toggle = mode.replace(\"explicit_\", \"\")\n-                return (\n-                    request.chat_template_kwargs is not None\n-                    and request.chat_template_kwargs.get(toggle) is True\n-                )\n+                kwargs = request.chat_template_kwargs or {}\n+                if toggle in kwargs:\n+                    return kwargs.get(toggle) is True\n+                # dsv4/dsv41 encoding treats a missing thinking kwarg as\n+                # SGLANG_DEFAULT_THINKING and appends the thinking opener.\n+                # The parser must use that same default: the opener is not\n+                # in the completion, so leaving reasoning off leaks the\n+                # thinking block into content. enable_thinking templates do\n+                # not read this env, so they stay opt-in.\n+                if toggle == \"thinking\":\n+                    return bool(envs.SGLANG_DEFAULT_THINKING.get())\n+                return False\n             logger.warning(\n                 \"Unknown reasoning_default mode '%s', defaulting to reasoning disabled\",\n                 mode,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f2aad50c4163d047d740fd61defea2d122ac5d30/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_chat.py",
      "sha": "394ec53d734619bab1718c324e71323ec0a32a70",
