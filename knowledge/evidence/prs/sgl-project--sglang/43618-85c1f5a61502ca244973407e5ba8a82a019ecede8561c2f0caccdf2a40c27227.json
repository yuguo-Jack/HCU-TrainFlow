      "patch": "@@ -174,6 +174,7 @@ def test_emit_mixed_batch_separates_prefill_and_decode(self):\n             reqs=[prefill_a, prefill_b, decode_req],\n             decoding_reqs=[decode_req],\n             prefix_lens=[2, 3, decode_req.seqlen - 1],\n+            extend_lens=[4, 8, 1],\n             prefill_stats=PrefillStats(\n                 log_input_tokens=12,\n                 log_hit_tokens=5,",
