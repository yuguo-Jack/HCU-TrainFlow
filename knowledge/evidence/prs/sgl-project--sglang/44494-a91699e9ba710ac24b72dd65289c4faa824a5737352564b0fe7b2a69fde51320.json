      "blob_url": "https://github.com/sgl-project/sglang/blob/29ce689c6ea58f0e85891165d438b4fedbcfd509/python%2Fsglang%2Fsrt%2Fobservability%2Fcpu_monitor.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fobservability%2Fcpu_monitor.py?ref=29ce689c6ea58f0e85891165d438b4fedbcfd509",
      "deletions": 0,
      "filename": "python/sglang/srt/observability/cpu_monitor.py",
      "patch": "@@ -23,6 +23,10 @@ def monitor():\n             delta = (curr_times.user - last_times.user) + (\n                 curr_times.system - last_times.system\n             )\n+            if delta < 0:\n+                # CRIU restore restarts the process CPU clock near zero. Its\n+                # current reading is CPU time since restore, not a decrement.\n+                delta = curr_times.user + curr_times.system\n             cpu_seconds_total.labels(component=component).inc(delta)\n             last_times = curr_times\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/29ce689c6ea58f0e85891165d438b4fedbcfd509/python%2Fsglang%2Fsrt%2Fobservability%2Fcpu_monitor.py",
      "sha": "f6fa54b1a27a9f0d657b312561420e5b71eb8446",
      "status": "modified"
    },
    {
      "additions": 54,
      "blob_url": "https://github.com/sgl-project/sglang/blob/29ce689c6ea58f0e85891165d438b4fedbcfd509/test%2Fregistered%2Funit%2Fobservability%2Ftest_cpu_monitor.py",
      "changes": 54,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fobservability%2Ftest_cpu_monitor.py?ref=29ce689c6ea58f0e85891165d438b4fedbcfd509",
      "deletions": 0,
      "filename": "test/registered/unit/observability/test_cpu_monitor.py",
      "patch": "@@ -96,6 +96,60 @@ def controlled_sleep(seconds):\n         # Iteration 2: (4.0 - 2.5) + (2.0 - 1.0) = 2.5 (proves last_times updated)\n         self.assertAlmostEqual(inc_calls[1].args[0], 2.5)\n \n+    def test_repeated_cpu_clock_resets_preserve_counter(self):\n+        from prometheus_client import CollectorRegistry, Counter\n+\n+        from sglang.srt.observability.cpu_monitor import start_cpu_monitor_thread\n+\n+        registry = CollectorRegistry()\n+        counter = Counter(\n+            \"test_process_cpu_seconds_total\",\n+            \"CPU time\",\n+            [\"component\"],\n+            registry=registry,\n+        )\n+        labeled = counter.labels(component=\"restored\")\n+        CpuTimes = namedtuple(\"CpuTimes\", [\"user\", \"system\"])\n+        readings = [\n+            CpuTimes(10.0, 5.0),\n+            CpuTimes(10.25, 5.25),  # Normal increment.\n+            CpuTimes(0.1, 0.05),  # First restore.\n+            CpuTimes(0.3, 0.15),  # Increment from the new baseline.\n+            CpuTimes(0.01, 0.02),  # Second restore.\n+            CpuTimes(0.11, 0.12),\n+        ]\n+        with (\n+            patch(\"prometheus_client.Counter\", return_value=counter),\n+            patch(\n+                \"sglang.srt.observability.cpu_monitor.psutil.Process\"\n+            ) as mock_process,\n+            patch(\n+                \"sglang.srt.observability.cpu_monitor.time.sleep\",\n+                side_effect=[None] * 5 + [SystemExit],\n+            ),\n+            patch(\n+                \"sglang.srt.observability.cpu_monitor.threading.Thread\"\n+            ) as mock_thread,\n+            patch.object(labeled, \"inc\", wraps=labeled.inc) as increment,\n+        ):\n+            mock_process.return_value.cpu_times.side_effect = readings\n+            start_cpu_monitor_thread(\"restored\")\n+            # Run the monitor synchronously so any counter error fails the test.\n+            with self.assertRaises(SystemExit):\n+                mock_thread.call_args.kwargs[\"target\"]()\n+\n+        self.assertEqual(increment.call_count, 5)\n+        for call, expected in zip(\n+            increment.call_args_list, (0.5, 0.15, 0.3, 0.03, 0.2)\n+        ):\n+            self.assertAlmostEqual(call.args[0], expected)\n+        self.assertAlmostEqual(\n+            registry.get_sample_value(\n+                \"test_process_cpu_seconds_total\", {\"component\": \"restored\"}\n+            ),\n+            1.18,\n+        )\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/29ce689c6ea58f0e85891165d438b4fedbcfd509/test%2Fregistered%2Funit%2Fobservability%2Ftest_cpu_monitor.py",
      "sha": "01f20c7f4eca6a62aa4073e1c0f53ec7c0eb6382",
      "status": "modified"
    }
