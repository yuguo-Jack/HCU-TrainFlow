      "additions": 30,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3edaf21465f309eaa3d98974b8a30f526d776b67/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmodels%2Fvaes%2Fcosmos3_avae.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmodels%2Fvaes%2Fcosmos3_avae.py?ref=3edaf21465f309eaa3d98974b8a30f526d776b67",
      "deletions": 1,
      "filename": "python/sglang/multimodal_gen/runtime/models/vaes/cosmos3_avae.py",
      "patch": "@@ -8,8 +8,9 @@\n \n import torch\n from torch import nn\n-from torch.nn.utils import weight_norm\n+from torch.nn.utils import remove_weight_norm, weight_norm\n \n+from sglang.multimodal_gen.runtime.distributed import get_local_torch_device\n from sglang.multimodal_gen.runtime.managers.memory_managers.layerwise_offload import (\n     LayerwiseOffloadableModuleMixin,\n )\n@@ -188,6 +189,7 @@ def __init__(self, config: dict[str, Any]) -> None:\n                 _cfg(config, \"dec_c_mults\", default=[1, 2, 4, 8, 16])\n             ),\n         )\n+        self.register_load_state_dict_post_hook(_fold_weight_norm)\n \n     @property\n     def temporal_compression_factor(self) -> int:\n@@ -220,4 +222,31 @@ def decode(self, latent: torch.Tensor) -> torch.Tensor:\n         return audio.squeeze(0) if squeeze else audio\n \n \n+def _fold_weight_norm(module: nn.Module, incompatible_keys: Any) -> None:\n+    \"\"\"Fold each weight norm into its convolution once the checkpoint is loaded.\n+\n+    The weight norm hook recomputes the weight at every forward and keeps it\n+    on the module beside weight_g and weight_v, so decode held a second copy\n+    of every weight on the device. Folding on the device that runs decode\n+    computes exactly the weights the hook did, and writing them into the\n+    weight_v storage keeps the parameter layout the load created.\n+    \"\"\"\n+    device = get_local_torch_device()\n+    for m in module.modules():\n+        if not hasattr(m, \"weight_g\"):\n+            continue\n+        storage = m.weight_v.detach()\n+        requires_grad = m.weight_v.requires_grad\n+        home = storage.device\n+        m.to(device)\n+        remove_weight_norm(m)\n+        with torch.no_grad():\n+            storage.copy_(m.weight)\n+        m.weight = nn.Parameter(storage, requires_grad=requires_grad)\n+        m.to(home)\n+    if device.type != \"cpu\":\n+        # Release the fold's temporaries so the device keeps only the weights.\n+        torch.get_device_module(device).empty_cache()\n+\n+\n EntryClass = Cosmos3AVAEAudioTokenizer",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3edaf21465f309eaa3d98974b8a30f526d776b67/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fmodels%2Fvaes%2Fcosmos3_avae.py",
      "sha": "20b1b9b4effab8788cb043314e1637e9d401c182",
      "status": "modified"
    },
    {
      "additions": 23,
      "blob_url": "https://github.com/sgl-project/sglang/blob/3edaf21465f309eaa3d98974b8a30f526d776b67/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_cosmos3.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_cosmos3.py?ref=3edaf21465f309eaa3d98974b8a30f526d776b67",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_cosmos3.py",
      "patch": "@@ -883,6 +883,29 @@ def test_batched_action_decode_keeps_batch_dimension(self):\n         self.assertEqual(output.action_pred.shape, (2, 4, 3))\n \n \n+class TestCosmos3AudioTokenizer(unittest.TestCase):\n+    def test_load_folds_weight_norm(self):\n+        from sglang.multimodal_gen.runtime.models.vaes.cosmos3_avae import (\n+            Cosmos3AVAEAudioTokenizer,\n+        )\n+\n+        config = {\n+            \"dec_dim\": 4,\n+            \"dec_c_mults\": [1, 2],\n+            \"dec_strides\": [2, 2],\n+            \"vocoder_input_dim\": 8,\n+        }\n+        reference = Cosmos3AVAEAudioTokenizer(config)\n+        tokenizer = Cosmos3AVAEAudioTokenizer(config)\n+        tokenizer.load_state_dict(reference.state_dict())\n+\n+        self.assertFalse(\n+            [n for n, _ in tokenizer.named_parameters() if n.endswith(\"_g\")]\n+        )\n+        latent = torch.randn(1, 8, 5)\n+        torch.testing.assert_close(tokenizer.decode(latent), reference.decode(latent))\n+\n+\n class TestCosmos3ModelResolution(unittest.TestCase):\n     \"\"\"Verify Cosmos3 checkpoints resolve to the native SGLang pipeline.\"\"\"\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/3edaf21465f309eaa3d98974b8a30f526d776b67/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_cosmos3.py",
      "sha": "d278e701cbab34a79215d24c390f4fd9b038317e",
      "status": "modified"
    }
