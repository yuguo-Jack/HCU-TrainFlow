      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Farg_groups%2Fspeculative_hook.py?ref=56056a5b337f36d7163f7354253c8d4bd14e05b4",
      "deletions": 0,
      "filename": "python/sglang/srt/arg_groups/speculative_hook.py",
      "patch": "@@ -1026,6 +1026,24 @@ def _handle_eagle_family(server_args: ServerArgs) -> None:\n             cfg.speculative_algorithm,\n         )\n \n+    # SGLANG_1093_CHUNKED_PREFILL_DEFAULT\n+    # Disabled chunked prefill under EAGLE/NEXTN lets one exclusive prefill\n+    # starve decode and blows multi-turn TPOT. Default to 1024; an explicit\n+    # positive --chunked-prefill-size is left unchanged.\n+    _cps = cfg.chunked_prefill_size\n+    if _cps is None or _cps <= 0:\n+        declare_resolution(\n+            server_args,\n+            \"_handle_eagle_family\",\n+            chunked_prefill_size=1024,\n+        )\n+        logger.warning(\n+            \"chunked_prefill_size was disabled (%s); reset to 1024 for \"\n+            \"EAGLE/NEXTN speculative decoding to reduce multi-turn TPOT \"\n+            \"bubbles. Override with an explicit positive --chunked-prefill-size.\",\n+            _cps,\n+        )\n+\n     model_arch = model_config_of(server_args).hf_config.architectures[0]\n     if model_arch in [\n         \"DeepseekV32ForCausalLM\",",
      "raw_url": "https://github.com/sgl-project/sglang/raw/56056a5b337f36d7163f7354253c8d4bd14e05b4/python%2Fsglang%2Fsrt%2Farg_groups%2Fspeculative_hook.py",
      "sha": "ced272f133ba38c6672cfc78bd5a2c3545fb2b8f",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/sgl-project/sglang/blob/56056a5b337f36d7163f7354253c8d4bd14e05b4/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py?ref=56056a5b337f36d7163f7354253c8d4bd14e05b4",
      "deletions": 0,
      "filename": "python/sglang/srt/managers/scheduler.py",
      "patch": "@@ -3965,6 +3965,18 @@ def _get_new_batch_prefill_raw(\n             prefill_tile_block_m=prefill_tile_block_m,\n         )\n \n+        # SGLANG_1093_DECODE_PREFER_V2\n+        # Prefill-first scheduling: any prefill batch (including chunked_req\n+        # continuation) fully preempts decode. Under speculative decoding\n+        # without mixed chunk, defer all prefills while decode is running so\n+        # multi-turn ITL/TPOT stays stable.\n+        if (\n+            not self.spec_algorithm.is_none()\n+            and not self.is_mixed_chunk\n+            and not running_batch.is_empty()\n+        ):\n+            return None, running_batch\n+\n         if self.chunked_req is not None:\n             self.chunked_req.init_next_round_input()\n             adder.chunked_req_limit = self.policy.shortest_prefill_chunk_limit(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/56056a5b337f36d7163f7354253c8d4bd14e05b4/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler.py",
      "sha": "eddbd3e1cc00d88110649dc41e39e18dbc7da5d3",
