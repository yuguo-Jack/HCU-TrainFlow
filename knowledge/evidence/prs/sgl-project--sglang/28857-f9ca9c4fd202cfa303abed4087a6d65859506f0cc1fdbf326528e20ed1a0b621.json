      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fgemma4_detector.py?ref=0af75a5c5d8237eb0e4bebbe4cec12cdbc5a186f",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/gemma4_detector.py",
      "patch": "@@ -88,6 +88,11 @@ def _parse_gemma4_array(arr_str: str) -> list:\n             sub_start = i + 1\n             i += 1\n             while i < n and depth > 0:\n+                if arr_str[i : i + len(STRING_DELIM)] == STRING_DELIM:\n+                    i += len(STRING_DELIM)\n+                    next_delim = arr_str.find(STRING_DELIM, i)\n+                    i = next_delim + len(STRING_DELIM) if next_delim != -1 else n\n+                    continue\n                 if arr_str[i] == \"[\":\n                     depth += 1\n                 elif arr_str[i] == \"]\":\n@@ -100,6 +105,8 @@ def _parse_gemma4_array(arr_str: str) -> list:\n             val_start = i\n             while i < n and arr_str[i] not in (\",\", \"]\"):\n                 i += 1\n+            if i == val_start:\n+                break\n             items.append(_parse_gemma4_value(arr_str[val_start:i]))\n \n     return items",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0af75a5c5d8237eb0e4bebbe4cec12cdbc5a186f/python%2Fsglang%2Fsrt%2Ffunction_call%2Fgemma4_detector.py",
