    {
      "additions": 4,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2d19d1e5641af5fb16363769c90c8c98a61c8ef8/python%2Fsglang%2Fsrt%2Fentrypoints%2Fhttp_request_decompression.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fhttp_request_decompression.py?ref=2d19d1e5641af5fb16363769c90c8c98a61c8ef8",
      "deletions": 2,
      "filename": "python/sglang/srt/entrypoints/http_request_decompression.py",
      "patch": "@@ -58,15 +58,17 @@ async def __call__(self, scope, receive, send):\n             )(scope, receive, send)\n \n         # Collect request body.\n-        body = b\"\"\n+        # Join once at the end: repeated `bytes +=` recopies the whole buffer per chunk.\n+        chunks = []\n         more_body = True\n         while more_body:\n             message = await receive()\n             # Incomplete body (e.g. client disconnect); hand off to later stages.\n             if message[\"type\"] != \"http.request\":\n                 return await self.app(scope, receive, send)\n-            body += message.get(\"body\", b\"\")\n+            chunks.append(message.get(\"body\", b\"\"))\n             more_body = message.get(\"more_body\", False)\n+        body = b\"\".join(chunks)\n \n         # Decompress off the event loop by releasing the GIL around the C decompress.\n         try:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2d19d1e5641af5fb16363769c90c8c98a61c8ef8/python%2Fsglang%2Fsrt%2Fentrypoints%2Fhttp_request_decompression.py",
      "sha": "5cbcc5f4ea4964a20f404e1f65b829e4dad02c4e",
      "status": "modified"
    },
    {
      "additions": 38,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2d19d1e5641af5fb16363769c90c8c98a61c8ef8/test%2Fregistered%2Fcpu%2Ftest_request_decompression.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fcpu%2Ftest_request_decompression.py?ref=2d19d1e5641af5fb16363769c90c8c98a61c8ef8",
      "deletions": 0,
      "filename": "test/registered/cpu/test_request_decompression.py",
      "patch": "@@ -99,6 +99,44 @@ def test_chunked_body_reassembled(self):\n         seen, _ = _drive(scope, [(COMPRESSED[:half], True), (COMPRESSED[half:], False)])\n         self.assertEqual(seen[\"body\"], PAYLOAD)\n \n+    def test_many_small_chunks_reassembled(self):\n+        scope = {\"type\": \"http\", \"headers\": [(b\"x-body-compressed\", b\"zstd\")]}\n+        pieces = [COMPRESSED[i : i + 1] for i in range(len(COMPRESSED))]\n+        chunks = [(piece, True) for piece in pieces[:-1]] + [(pieces[-1], False)]\n+        seen, sent = _drive(scope, chunks)\n+        self.assertEqual(seen[\"body\"], PAYLOAD)\n+        self.assertEqual(sent, [])\n+\n+    def test_empty_chunks_are_ignored(self):\n+        half = len(COMPRESSED) // 2\n+        scope = {\"type\": \"http\", \"headers\": [(b\"x-body-compressed\", b\"zstd\")]}\n+        chunks = [\n+            (b\"\", True),\n+            (COMPRESSED[:half], True),\n+            (b\"\", True),\n+            (COMPRESSED[half:], True),\n+            (b\"\", False),\n+        ]\n+        seen, _ = _drive(scope, chunks)\n+        self.assertEqual(seen[\"body\"], PAYLOAD)\n+\n+    def test_body_chunks_are_not_concatenated_pairwise(self):\n+        # `buffer += chunk` recopies the whole buffer per chunk (quadratic in\n+        # the number of chunks); a bytes subclass makes that path observable.\n+        class NoConcat(bytes):\n+            def __radd__(self, other):\n+                raise AssertionError(\"body chunks must be joined once, not appended\")\n+\n+        half = len(COMPRESSED) // 2\n+        scope = {\"type\": \"http\", \"headers\": [(b\"x-body-compressed\", b\"zstd\")]}\n+        chunks = [\n+            (NoConcat(COMPRESSED[:half]), True),\n+            (NoConcat(COMPRESSED[half:]), False),\n+        ]\n+        seen, sent = _drive(scope, chunks)\n+        self.assertEqual(seen[\"body\"], PAYLOAD)\n+        self.assertEqual(sent, [])\n+\n     def test_bad_body_returns_400(self):\n         scope = {\"type\": \"http\", \"headers\": [(b\"x-body-compressed\", b\"zstd\")]}\n         seen, sent = _drive(scope, [(b\"not-zstd-data\", False)])",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2d19d1e5641af5fb16363769c90c8c98a61c8ef8/test%2Fregistered%2Fcpu%2Ftest_request_decompression.py",
      "sha": "3e87d654956e77c0318cd52dc44da178e30b88d3",
