  "files": [
    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c6fc992125056f8875f13fba00202ddf5acd604d/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py?ref=c6fc992125056f8875f13fba00202ddf5acd604d",
      "deletions": 1,
      "filename": "python/sglang/srt/managers/schedule_batch.py",
      "patch": "@@ -2044,8 +2044,22 @@ def _check_str_based_finish(self, new_accepted_len: int = 1):\n                     else:\n                         finished_len = None\n                     if finished_len is not None:\n+                        # Store the matched span, not the pattern. The\n+                        # detokenizer trims with a literal find, so \"[0-9]+\"\n+                        # would be left in the text and no_stop_trim could\n+                        # not keep or drop it.\n+                        if matched:\n+                            matched_text = matched.group(0)\n+                        else:\n+                            stopped = self.tokenizer.decode(\n+                                self.output_ids[:finished_len]\n+                            )\n+                            found = re.search(stop_regex_str, stopped)\n+                            matched_text = (\n+                                found.group(0) if found is not None else stop_regex_str\n+                            )\n                         self.finished_reason = FINISHED_MATCHED_REGEX(\n-                            matched=stop_regex_str\n+                            matched=matched_text\n                         )\n                         self.finished_len = finished_len\n                         return True",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c6fc992125056f8875f13fba00202ddf5acd604d/python%2Fsglang%2Fsrt%2Fmanagers%2Fschedule_batch.py",
      "sha": "d4a26a96fefe52d2cfbf27f5519bb94bf39264c7",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c6fc992125056f8875f13fba00202ddf5acd604d/test%2Fregistered%2Funit%2Fmanagers%2Ftest_stop_str_speculative.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_stop_str_speculative.py?ref=c6fc992125056f8875f13fba00202ddf5acd604d",
      "deletions": 2,
      "filename": "test/registered/unit/managers/test_stop_str_speculative.py",
      "patch": "@@ -28,6 +28,8 @@\n     63: \".\",\n     70: \"X\",\n     71: \"Y\",\n+    80: \"1\",\n+    81: \"2\",\n }\n \n # \"STOP\" (index 3) sits 6 tokens back: outside the old (stop_str_max_len + 1)\n@@ -133,7 +135,7 @@ def test_stop_regex_end_anchored_trims_at_first_match(self):\n         req = _make_req([60, 61, 62, 63], stop_regex=[r\"\\.$\"])\n         req.update_finish_state(new_accepted_len=4)\n         self.assertTrue(req.finished())\n-        self.assertEqual(req.finished_reason.matched, r\"\\.$\")\n+        self.assertEqual(req.finished_reason.matched, \".\")\n         self.assertEqual(req.finished_len, 2)\n \n     def test_stop_regex_end_anchored_midchunk(self):\n@@ -142,9 +144,15 @@ def test_stop_regex_end_anchored_midchunk(self):\n         req = _make_req([60, 61, 62], stop_regex=[r\"[.!?]\\s*$\"])\n         req.update_finish_state(new_accepted_len=3)\n         self.assertTrue(req.finished())\n-        self.assertEqual(req.finished_reason.matched, r\"[.!?]\\s*$\")\n+        self.assertEqual(req.finished_reason.matched, \".\")\n         self.assertEqual(req.finished_len, 2)\n \n+    def test_stop_regex_records_the_matched_span(self):\n+        req = _make_req([10, 80, 81, 20], stop_regex=[r\"[0-9]+\"])\n+        req.update_finish_state(new_accepted_len=4)\n+        self.assertTrue(req.finished())\n+        self.assertEqual(req.finished_reason.matched, \"12\")\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c6fc992125056f8875f13fba00202ddf5acd604d/test%2Fregistered%2Funit%2Fmanagers%2Ftest_stop_str_speculative.py",
      "sha": "d1f1d6345b2807465cfb9f5131f0addeedb4a17a",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c6fc992125056f8875f13fba00202ddf5acd604d/test%2Fregistered%2Funit%2Fmanagers%2Ftest_trim_matched_stop.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_trim_matched_stop.py?ref=c6fc992125056f8875f13fba00202ddf5acd604d",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_trim_matched_stop.py",
      "patch": "@@ -71,6 +71,13 @@ def test_token_gpt_oss_call_kept(self):\n             [1, 2, GPT_OSS_CALL_TOKEN],\n         )\n \n+    def test_regex_span_trims_and_no_stop_trim_keeps_it(self):\n+        # The scheduler stores the matched span (\"42\"), not the pattern \"[0-9]+\".\n+        self.assertEqual(_trim(\"answer 42\", \"42\", False), \"answer \")\n+        self.assertEqual(_trim(\"answer 42\", \"42\", True), \"answer 42\")\n+        # A literal search for the pattern itself cannot trim the number.\n+        self.assertEqual(_trim(\"answer 42\", \"[0-9]+\", False), \"answer 42\")\n+\n     def test_token_tool_close_kept(self):\n         self.assertEqual(_trim([1, 2, 3], 3, False, tool_close=[3]), [1, 2, 3])\n         self.assertEqual(_trim([1, 2, 4], 4, False, tool_close=[3]), [1, 2])",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c6fc992125056f8875f13fba00202ddf5acd604d/test%2Fregistered%2Funit%2Fmanagers%2Ftest_trim_matched_stop.py",
      "sha": "41602b2464fb7cebc1da70260b46e2c11873f39e",
      "status": "modified"
    }
