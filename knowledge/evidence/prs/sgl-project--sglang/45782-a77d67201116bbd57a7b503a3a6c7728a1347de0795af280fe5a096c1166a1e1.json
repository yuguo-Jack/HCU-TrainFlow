  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/778ad1f7080de0aa8170041338c19a3af14bc94c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fpipelines_core%2Flora%2Fpipeline.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fpipelines_core%2Flora%2Fpipeline.py?ref=778ad1f7080de0aa8170041338c19a3af14bc94c",
      "deletions": 3,
      "filename": "python/sglang/multimodal_gen/runtime/pipelines_core/lora/pipeline.py",
      "patch": "@@ -1379,9 +1379,12 @@ def _merge_cache_for(\n             # Cache entries are CPU mappings. Rebinding a resident accelerator\n             # parameter to one would leave the module split across devices.\n             return None\n-        if dist.is_initialized() and dist.get_world_size() > 1:\n-            # Sharded weights would need per-rank stores; not worth it until a\n-            # multi-GPU consumer deployment exists.\n+        if self.server_args.tp_size > 1 or self.server_args.use_fsdp_inference:\n+            # Sharded weights differ per rank, so one entry per module name\n+            # would be wrong for all but one of them. Sequence- and\n+            # data-parallel replicas hold the same full weights on every rank;\n+            # those ranks can share one entry, because the merge is\n+            # deterministic and each file is written through an atomic rename.\n             return None\n         adapters = [\n             (path, strength, self.server_args.lora_alpha)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/778ad1f7080de0aa8170041338c19a3af14bc94c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fpipelines_core%2Flora%2Fpipeline.py",
      "sha": "72027116ed0ce21281a788c0caa9be6522832e11",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/778ad1f7080de0aa8170041338c19a3af14bc94c/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_lora_pipeline.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_lora_pipeline.py?ref=778ad1f7080de0aa8170041338c19a3af14bc94c",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_lora_pipeline.py",
      "patch": "@@ -39,6 +39,8 @@ def _make_pipeline(layer: BaseLayerWithLoRA) -> _TestLoRAPipeline:\n         lora_alpha=None,\n         lora_merge_mode=\"dynamic\",\n         model_path=\"/model\",\n+        tp_size=1,\n+        use_fsdp_inference=False,\n     )\n     pipeline.lora_initialized = True\n     pipeline.lora_adapters = defaultdict(dict)\n@@ -142,6 +144,26 @@ def test_merge_cache_only_accepts_cpu_backed_weights():\n     assert resident_cache is None\n \n \n+def test_merge_cache_serves_replicated_replicas_only():\n+    \"\"\"Sequence-/data-parallel ranks hold the same weights, so they share one\n+    cache entry; sharded ranks would all collide on one entry and must not.\"\"\"\n+    pipeline = _make_pipeline(_make_layer())\n+\n+    def cache():\n+        return pipeline._merge_cache_for(\n+            \"transformer\", pipeline.lora_layers, [\"/adapter\"], [1.0], enabled=True\n+        )\n+\n+    assert cache() is not None\n+\n+    pipeline.server_args.tp_size = 2\n+    assert cache() is None\n+\n+    pipeline.server_args.tp_size = 1\n+    pipeline.server_args.use_fsdp_inference = True\n+    assert cache() is None\n+\n+\n def test_zero_copy_snapshot_is_limited_to_cpu_backed_layers():\n     assert not _use_owned_base_snapshot(False, \"cpu\")\n     assert not _use_owned_base_snapshot(False, \"meta\")",
      "raw_url": "https://github.com/sgl-project/sglang/raw/778ad1f7080de0aa8170041338c19a3af14bc94c/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_lora_pipeline.py",
      "sha": "7bf6179c534281e0ac5465d9af4307fd05a6e455",
      "status": "modified"
    }
