      "blob_url": "https://github.com/sgl-project/sglang/blob/2f832612a1262f2b8d7027ebc2c80e33236912c8/python%2Fsglang%2Fsrt%2Fmodel_executor%2Frunner_backend%2Fbreakable_cuda_graph_backend.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodel_executor%2Frunner_backend%2Fbreakable_cuda_graph_backend.py?ref=2f832612a1262f2b8d7027ebc2c80e33236912c8",
      "deletions": 0,
      "filename": "python/sglang/srt/model_executor/runner_backend/breakable_cuda_graph_backend.py",
      "patch": "@@ -18,6 +18,7 @@\n \n from __future__ import annotations\n \n+import dataclasses\n from contextlib import contextmanager\n from typing import TYPE_CHECKING, Any, Callable, Dict, Optional\n \n@@ -26,6 +27,7 @@\n from sglang.srt.distributed.device_communicators.pynccl_allocator import (\n     set_graph_pool_id,\n )\n+from sglang.srt.layers.logits_processor import LogitsProcessorOutput\n from sglang.srt.model_executor.forward_batch_info import PPProxyTensors\n from sglang.srt.model_executor.runner_backend.base_cuda_graph_backend import (\n     BaseCudaGraphBackend,\n@@ -191,6 +193,15 @@ def _alloc_full_buffer(self, output: Any, size: int) -> Any:\n                     for key, t in output.tensors.items()\n                 }\n             )\n+        if isinstance(output, LogitsProcessorOutput):\n+            return dataclasses.replace(\n+                output,\n+                **{\n+                    f.name: self._alloc_full_buffer(getattr(output, f.name), size)\n+                    for f in dataclasses.fields(output)\n+                    if torch.is_tensor(getattr(output, f.name))\n+                },\n+            )\n         if isinstance(output, tuple):\n             return tuple(self._alloc_full_buffer(o, size) for o in output)\n         if isinstance(output, list):\n@@ -204,6 +215,15 @@ def _slice_output(self, output: Any, num_tokens: int) -> Any:\n             return output[:num_tokens]\n         if isinstance(output, PPProxyTensors):\n             return output[:num_tokens]\n+        if isinstance(output, LogitsProcessorOutput):\n+            return dataclasses.replace(\n+                output,\n+                **{\n+                    f.name: self._slice_output(getattr(output, f.name), num_tokens)\n+                    for f in dataclasses.fields(output)\n+                    if torch.is_tensor(getattr(output, f.name))\n+                },\n+            )\n         if isinstance(output, tuple):\n             return tuple(self._slice_output(item, num_tokens) for item in output)\n         if isinstance(output, list):\n@@ -236,6 +256,16 @@ def _copy_output_to_buffer(\n                     tensor, output_buffer.tensors[key], num_tokens\n                 )\n             return\n+        if isinstance(output, LogitsProcessorOutput) and isinstance(\n+            output_buffer, LogitsProcessorOutput\n+        ):\n+            for f in dataclasses.fields(output):\n+                value = getattr(output, f.name)\n+                if torch.is_tensor(value):\n+                    self._copy_output_to_buffer(\n+                        value, getattr(output_buffer, f.name), num_tokens\n+                    )\n+            return\n         if (isinstance(output, list) and isinstance(output_buffer, list)) or (\n             isinstance(output, tuple) and isinstance(output_buffer, tuple)\n         ):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2f832612a1262f2b8d7027ebc2c80e33236912c8/python%2Fsglang%2Fsrt%2Fmodel_executor%2Frunner_backend%2Fbreakable_cuda_graph_backend.py",
