  "files": [
    {
      "additions": 11,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0fe039f8333f563a7a929d14926fef0aac6a6df4/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py?ref=0fe039f8333f563a7a929d14926fef0aac6a6df4",
      "deletions": 1,
      "filename": "python/sglang/srt/multimodal/processors/base_processor.py",
      "patch": "@@ -65,6 +65,11 @@\n _is_npu = is_npu()\n _is_xpu = is_xpu()\n \n+# A fork-started ProcessPoolExecutor forks all max_workers on the first submit, so\n+# defaulting to os.cpu_count() on a many-core host (e.g. 512) makes the first\n+# preprocess request blow its REQUEST_TIMEOUT budget. SGLANG_CPU_WORKERS overrides.\n+_DEFAULT_MAX_CPU_WORKERS = 16\n+\n \n @dataclasses.dataclass\n class BaseMultiModalProcessorOutput:\n@@ -535,7 +540,12 @@ def _create_cpu_executor(self) -> concurrent.futures.ProcessPoolExecutor:\n         start_method = \"spawn\" if self.mm_feature_transport == \"cuda_vmm\" else \"fork\"\n         return concurrent.futures.ProcessPoolExecutor(\n             mp_context=mp.get_context(start_method),\n-            max_workers=int(os.environ.get(\"SGLANG_CPU_WORKERS\", os.cpu_count())),\n+            max_workers=int(\n+                os.environ.get(\n+                    \"SGLANG_CPU_WORKERS\",\n+                    min(os.cpu_count() or 1, _DEFAULT_MAX_CPU_WORKERS),\n+                )\n+            ),\n             initializer=_forget_parent_executor_wakeups,\n         )\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0fe039f8333f563a7a929d14926fef0aac6a6df4/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "sha": "19bc574db5e86526bdeaa24e1013bf9d6776e31f",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0fe039f8333f563a7a929d14926fef0aac6a6df4/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_cpu_pool.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_cpu_pool.py?ref=0fe039f8333f563a7a929d14926fef0aac6a6df4",
      "deletions": 0,
      "filename": "test/registered/unit/multimodal/test_base_processor_cpu_pool.py",
      "patch": "@@ -0,0 +1,44 @@\n+\"\"\"The multimodal CPU preprocess pool defaults to at most 16 workers on many-core hosts.\"\"\"\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+import os\n+import unittest\n+from types import SimpleNamespace\n+from unittest.mock import patch\n+\n+from sglang.srt.multimodal.processors.base_processor import BaseMultimodalProcessor\n+from sglang.test.test_utils import CustomTestCase\n+\n+\n+def _max_workers(cpu_count, env=None):\n+    stub = SimpleNamespace(mm_feature_transport=\"shm\")\n+    with (\n+        patch.dict(os.environ, env or {}, clear=False),\n+        patch(\"os.cpu_count\", return_value=cpu_count),\n+        patch(\"concurrent.futures.ProcessPoolExecutor\") as pool,\n+    ):\n+        if env is None:\n+            os.environ.pop(\"SGLANG_CPU_WORKERS\", None)\n+        BaseMultimodalProcessor._create_cpu_executor(stub)\n+    return pool.call_args.kwargs[\"max_workers\"]\n+\n+\n+class TestCpuPoolSize(CustomTestCase):\n+    def test_capped_on_many_core_host(self):\n+        self.assertEqual(_max_workers(512), 16)\n+\n+    def test_small_host_uses_all_cores(self):\n+        self.assertEqual(_max_workers(4), 4)\n+\n+    def test_unknown_cpu_count(self):\n+        self.assertEqual(_max_workers(None), 1)\n+\n+    def test_env_override(self):\n+        self.assertEqual(_max_workers(512, {\"SGLANG_CPU_WORKERS\": \"64\"}), 64)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0fe039f8333f563a7a929d14926fef0aac6a6df4/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_base_processor_cpu_pool.py",
      "sha": "21704c589eb627d2e3076aa298b67be817ed2c44",
      "status": "added"
    }
