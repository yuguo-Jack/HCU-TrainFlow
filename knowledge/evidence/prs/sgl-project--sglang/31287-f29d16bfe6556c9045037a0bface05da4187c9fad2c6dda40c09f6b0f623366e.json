      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/0663be2c3e5b7b2ca382fece5585f03c375fc900/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py?ref=0663be2c3e5b7b2ca382fece5585f03c375fc900",
      "deletions": 0,
      "filename": "python/sglang/srt/utils/common.py",
      "patch": "@@ -2399,6 +2399,13 @@ def _get_fastapi_request_path(request) -> Tuple[str, bool]:\n     from starlette.routing import Match\n \n     for route in request.app.routes:\n+        # FastAPI >= 0.137 stores lazy `_IncludedRouter` objects (BaseRoute\n+        # subclasses without a `.path` attribute) in `app.routes` for anything\n+        # mounted via `include_router` (e.g. `/v1/loads`). Accessing\n+        # `route.path` on those raises AttributeError and turns every request\n+        # into a 500. Skip path-less routes.\n+        if getattr(route, \"path\", None) is None:\n+            continue\n         match, child_scope = route.matches(request.scope)\n         if match == Match.FULL:\n             return route.path, True",
      "raw_url": "https://github.com/sgl-project/sglang/raw/0663be2c3e5b7b2ca382fece5585f03c375fc900/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "sha": "b06fef39aafbe0cfbc9c18888510ae8eb92cb6a3",
      "status": "modified"
    }
