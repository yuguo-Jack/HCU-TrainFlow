      "changes": 39,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_hermes_detector.py?ref=19269b757c34255dc1c6c7a9eae42f094599ec23",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_hermes_detector.py",
      "patch": "@@ -172,6 +172,45 @@ def test_streaming_text_then_tool_call(self):\n         params = json.loads(full_params)\n         self.assertEqual(params[\"city\"], \"Tokyo\")\n \n+    def test_streaming_held_back_text_keeps_order_across_tool_call(self):\n+        # \"</\" is held back as a possible \"</tool_call>\"; it must come out\n+        # before \"b\", not after the tool call.\n+        detector = HermesDetector()\n+        chunks = [\n+            \"a</\",\n+            \"b<tool_call>\",\n+            '{\"name\": \"get_weather\", \"arguments\": {\"city\": \"Paris\"}}',\n+            \"</tool_call>\",\n+            \"done\",\n+        ]\n+        all_normal_text = \"\"\n+        for chunk in chunks:\n+            result = detector.parse_streaming_increment(chunk, self.tools)\n+            all_normal_text += result.normal_text\n+\n+        self.assertEqual(all_normal_text, \"a</bdone\")\n+\n+    def test_streaming_end_tag_not_leaked_between_parallel_calls(self):\n+        detector = HermesDetector()\n+        chunks = [\n+            \"<tool_call>\",\n+            '{\"name\": \"get_weather\", \"arguments\": {\"city\": \"Paris\"}}',\n+            \"</tool_call>\\n<tool_call>\",\n+            '{\"name\": \"search\", \"arguments\": {\"query\": \"food\"}}',\n+            \"</tool_call>\",\n+        ]\n+        all_calls = []\n+        all_normal_text = \"\"\n+        for chunk in chunks:\n+            result = detector.parse_streaming_increment(chunk, self.tools)\n+            all_calls.extend(result.calls)\n+            all_normal_text += result.normal_text\n+\n+        self.assertNotIn(\"</tool_call>\", all_normal_text)\n+        self.assertEqual(\n+            [c.name for c in all_calls if c.name], [\"get_weather\", \"search\"]\n+        )\n+\n \n if __name__ == \"__main__\":\n     import unittest",
      "raw_url": "https://github.com/sgl-project/sglang/raw/19269b757c34255dc1c6c7a9eae42f094599ec23/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_hermes_detector.py",
