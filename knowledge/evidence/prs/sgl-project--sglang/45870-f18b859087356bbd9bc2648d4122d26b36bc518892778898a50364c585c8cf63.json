      "blob_url": "https://github.com/sgl-project/sglang/blob/ed22d79e10c86c9df9de1e3defd05728e35b6d12/.github%2Fworkflows%2Fpr-test-amd.yml",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Fworkflows%2Fpr-test-amd.yml?ref=ed22d79e10c86c9df9de1e3defd05728e35b6d12",
      "deletions": 2,
      "filename": ".github/workflows/pr-test-amd.yml",
      "patch": "@@ -758,7 +758,11 @@ jobs:\n       )\n     strategy:\n       fail-fast: false\n-      max-parallel: 1\n+      # One at a time serialized image x partition, so the 7.2 schedule ran\n+      # its 8 jobs back to back. Four on mi300 matches\n+      # stage-b-test-1-gpu-small-amd on the same pool; other runner_arch\n+      # dispatches keep one.\n+      max-parallel: ${{ (inputs.runner_arch || 'mi300') == 'mi300' && 4 || 1 }}\n       matrix:\n         rocm_version: ${{ fromJson(needs.check-changes.outputs.rocm_versions) }}\n         part: [0, 1, 2, 3]\n@@ -908,7 +912,9 @@ jobs:\n       )\n     strategy:\n       fail-fast: false\n-      max-parallel: 1\n+      # Two on mi300, so a run's partitions (or its two 7.2 images) overlap\n+      # instead of running back to back; other runner_arch dispatches keep one.\n+      max-parallel: ${{ (inputs.runner_arch || 'mi300') == 'mi300' && 2 || 1 }}\n       matrix:\n         rocm_version: ${{ fromJson(needs.check-changes.outputs.rocm_versions) }}\n         # run_suite.py load-balances the suite's parametrized cases and",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ed22d79e10c86c9df9de1e3defd05728e35b6d12/.github%2Fworkflows%2Fpr-test-amd.yml",
