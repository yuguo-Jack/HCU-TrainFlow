    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c6ad2a8266e44475715a6a1599436730161b0fff/.github%2Fpull_request_template.md",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Fpull_request_template.md?ref=c6ad2a8266e44475715a6a1599436730161b0fff",
      "deletions": 1,
      "filename": ".github/pull_request_template.md",
      "patch": "@@ -1,7 +1,7 @@\n <!-- Thank you for your contribution! Please follow these guidelines to enhance your pull request. If anything is unclear, submit your PR and reach out to maintainers for assistance. Join our Slack community at https://slack.sglang.io to discuss further. -->\n \n <!-- PR title: [Type] scope: title, or [Type] [Hardware] scope: title.\n-Type: Feat, Fix, Refactor, Perf, Doc, Test, CI, or Chore.\n+Type: Feat, Model, Fix, Refactor, Perf, Doc, Test, CI, or Chore.\n Scope: any module or model name (no fixed list or letter-case restriction), e.g. attention, qwen3, or flash-attn.\n Hardware: optional single tag without spaces. Use uppercase hardware tags (AMD, NVIDIA, NPU, MI300X), except for exactly these four spellings: Intel, Apple, Huawei, Ascend.\n Title: no letter-case restriction.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c6ad2a8266e44475715a6a1599436730161b0fff/.github%2Fpull_request_template.md",
      "sha": "86476d06d9c3f9b8e744af3223b3a14414ce33f4",
      "status": "modified"
    },
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c6ad2a8266e44475715a6a1599436730161b0fff/.github%2Fscripts%2Fpr-title.test.cjs",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Fscripts%2Fpr-title.test.cjs?ref=c6ad2a8266e44475715a6a1599436730161b0fff",
      "deletions": 1,
      "filename": ".github/scripts/pr-title.test.cjs",
      "patch": "@@ -71,9 +71,11 @@ const valid = [\n   'Revert \"A legacy title without tags or scope\"',\n   'Revert \"Revert \"[Fix] attention: Fix output\"\"',\n   'Revert \"x\"',\n-  ...['Feat', 'Fix', 'Refactor', 'Perf', 'Doc', 'Test', 'CI', 'Chore']\n+  ...['Feat', 'Model', 'Fix', 'Refactor', 'Perf', 'Doc', 'Test', 'CI', 'Chore']\n     .map(type => `[${type}] attention: Update implementation`),\n   '[Feat] qwen3: Add model support',\n+  '[Model] flux: Add model support',\n+  '[Model] [NVIDIA] Qwen3.5: Add model support',\n   '[Perf] [AMD] flash-attn: Optimize decode performance',\n   '[Fix] [Intel] sgl-kernel: Fix output',\n   '[Fix] [NVIDIA] model/qwen3: Fix output',\n@@ -107,6 +109,9 @@ const invalid = [\n   'Fix KV cache indexing',\n   '[Fix] Fix KV cache indexing',\n   '[Feature] model: Add support',\n+  '[model] flux: Add model support',\n+  '[MODEL] flux: Add model support',\n+  '[Model] Add model support',\n   '[fix] attention: Fix output',\n   '[Fix][AMD] attention: Fix output',\n   '[Fix] [AMD][NVIDIA] attention: Fix output',",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c6ad2a8266e44475715a6a1599436730161b0fff/.github%2Fscripts%2Fpr-title.test.cjs",
      "sha": "aa5ed567f35f929b0a6285849b7ad92c49072d84",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/c6ad2a8266e44475715a6a1599436730161b0fff/.github%2Fworkflows%2Fpr-title.yml",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/.github%2Fworkflows%2Fpr-title.yml?ref=c6ad2a8266e44475715a6a1599436730161b0fff",
      "deletions": 1,
      "filename": ".github/workflows/pr-title.yml",
      "patch": "@@ -26,7 +26,7 @@ jobs:\n               ...context.repo,\n               pull_number: context.issue.number,\n             });\n-            const types = ['Feat', 'Fix', 'Refactor', 'Perf', 'Doc', 'Test', 'CI', 'Chore'];\n+            const types = ['Feat', 'Model', 'Fix', 'Refactor', 'Perf', 'Doc', 'Test', 'CI', 'Chore'];\n             const pattern = new RegExp(\n               String.raw`^\\[(${types.join('|')})\\] (?:\\[([A-Za-z0-9][A-Za-z0-9._+-]*)\\] )?` +\n               String.raw`[A-Za-z0-9]+(?:[._/-][A-Za-z0-9]+)*: \\S(?:[^\\r\\n]*\\S)?$`",
      "raw_url": "https://github.com/sgl-project/sglang/raw/c6ad2a8266e44475715a6a1599436730161b0fff/.github%2Fworkflows%2Fpr-title.yml",
