    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/60f6d42a62c87dccc6c9a232c67d93f089722f77/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_responses.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_responses.py?ref=60f6d42a62c87dccc6c9a232c67d93f089722f77",
      "deletions": 1,
      "filename": "python/sglang/srt/entrypoints/openai/serving_responses.py",
      "patch": "@@ -668,7 +668,8 @@ def _is_thinking_enabled_for_request(self, request: ResponsesRequest) -> bool:\n             if mode in (\"thinking\", \"enable_thinking\"):\n                 return effort != \"none\"\n             if mode in (\"explicit_thinking\", \"explicit_enable_thinking\"):\n-                return False\n+                # effort is the explicit opt-in here; chat_template_kwargs never reaches this endpoint\n+                return effort is not None and effort != \"none\"\n             return False\n         if config.special_case == \"always\":\n             return True",
      "raw_url": "https://github.com/sgl-project/sglang/raw/60f6d42a62c87dccc6c9a232c67d93f089722f77/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fserving_responses.py",
      "sha": "776a49522dbf019cf68c0244186b7482e9a68dd5",
      "status": "modified"
    },
    {
      "additions": 35,
      "blob_url": "https://github.com/sgl-project/sglang/blob/60f6d42a62c87dccc6c9a232c67d93f089722f77/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_responses.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_responses.py?ref=60f6d42a62c87dccc6c9a232c67d93f089722f77",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/openai/test_serving_responses.py",
      "patch": "@@ -660,5 +660,40 @@ def test_developer_message_skips_unsupported_tool_types(self):\n         self.assertIsNotNone(msg)\n \n \n+class ExplicitThinkingEffortTestCase(unittest.TestCase):\n+    \"\"\"reasoning.effort is the only way to ask for thinking on this endpoint:\n+    chat_template_kwargs is not part of the Responses request, so gating\n+    explicit-thinking parsers on it left the template thinking with the\n+    detector switched off, and the transcript plus the close tag reached the\n+    client as the answer.\"\"\"\n+\n+    def _enabled(self, effort, mode=\"explicit_thinking\"):\n+        serving = make_serving()\n+        serving.reasoning_parser = \"deepseek-v4\"\n+        serving.template_manager.force_reasoning = False\n+        serving.template_manager.reasoning_config = None\n+        serving._reasoning_detector = Mock(reasoning_default=mode)\n+        request = ResponsesRequest(\n+            model=\"x\",\n+            input=\"hi\",\n+            reasoning={\"effort\": effort} if effort is not None else None,\n+        )\n+        return serving._is_thinking_enabled_for_request(request)\n+\n+    def test_effort_enables_thinking(self):\n+        for effort in (\"low\", \"medium\", \"high\"):\n+            self.assertTrue(self._enabled(effort), effort)\n+\n+    def test_no_effort_leaves_thinking_off(self):\n+        self.assertFalse(self._enabled(None))\n+\n+    def test_effort_none_leaves_thinking_off(self):\n+        self.assertFalse(self._enabled(\"none\"))\n+\n+    def test_explicit_enable_thinking_mode_matches(self):\n+        self.assertTrue(self._enabled(\"medium\", mode=\"explicit_enable_thinking\"))\n+        self.assertFalse(self._enabled(None, mode=\"explicit_enable_thinking\"))\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/60f6d42a62c87dccc6c9a232c67d93f089722f77/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_serving_responses.py",
      "sha": "9e0b684c6574363bfa93364886b94b500cc24826",
      "status": "modified"
    }
