    "title": "[Fix] openai_api: Reject unsupported mask in /v1/images/edits instead of silently ignoring it",
    "updated_at": "2026-10-16T01:06:41Z",
    "url": "https://api.github.com/repos/sgl-project/sglang/pulls/43552",
    "user": {
      "avatar_url": "https://avatars.githubusercontent.com/u/265981728?v=4",
