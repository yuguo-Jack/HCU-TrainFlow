    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e67db0f7c37602e02abecc1924cf4b79a944e1fe/python%2Fsglang%2Fsrt%2Fmanagers%2Fmm_utils.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fmm_utils.py?ref=e67db0f7c37602e02abecc1924cf4b79a944e1fe",
      "deletions": 5,
      "filename": "python/sglang/srt/managers/mm_utils.py",
      "patch": "@@ -263,18 +263,20 @@ def pad_mm_token_pairs(\n     data_start_token_ids identifies new items, so slices can reuse an item's pad value.\n     By default, every start token begins a new item.\n     \"\"\"\n-    if data_start_token_ids is None:\n-        data_start_token_ids = [s for s, _e in data_token_pairs]\n     assert_int64_array(input_ids, \"input_ids\")\n     pad_values = [item.pad_value for item in mm_inputs.mm_items]\n     mm_inputs.data_offsets = []\n-    if data_token_pairs is None:\n-        data_token_pairs = [mm_inputs.im_start_id, mm_inputs.im_end_id]\n+    if data_token_pairs is None and (\n+        mm_inputs.im_start_id is not None and mm_inputs.im_end_id is not None\n+    ):\n+        data_token_pairs = [(mm_inputs.im_start_id, mm_inputs.im_end_id)]\n     if data_token_pairs is None:\n         print_warning_once(\n             \"No data_token_pairs provided, RadixAttention might be influenced.\"\n         )\n         return input_ids\n+    if data_start_token_ids is None:\n+        data_start_token_ids = [s for s, _e in data_token_pairs]\n     start_token_ids = {s for s, _e in data_token_pairs}\n     end_tokens_ids = {e for _s, e in data_token_pairs}\n \n@@ -385,7 +387,7 @@ def __init__(\n         \"\"\"\n         self.data_token_id_pairs = data_token_pairs\n         self.data_start_token_ids = data_start_token_ids or [\n-            s for s, _e in data_token_pairs\n+            s for s, _e in data_token_pairs or []\n         ]\n \n     def pad_input_tokens(self, input_ids: array, mm_inputs: MultimodalInputs) -> array:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e67db0f7c37602e02abecc1924cf4b79a944e1fe/python%2Fsglang%2Fsrt%2Fmanagers%2Fmm_utils.py",
      "sha": "4611d321949166010afdbf5c9cbf625935df03f6",
      "status": "modified"
    },
    {
      "additions": 71,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e67db0f7c37602e02abecc1924cf4b79a944e1fe/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_pad_token_pairs.py",
      "changes": 71,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_pad_token_pairs.py?ref=e67db0f7c37602e02abecc1924cf4b79a944e1fe",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_mm_pad_token_pairs.py",
      "patch": "@@ -0,0 +1,71 @@\n+\"\"\"Unit tests for pad_mm_token_pairs when no explicit token pairs are given.\"\"\"\n+\n+import unittest\n+from array import array\n+\n+from sglang.srt.managers.mm_utils import (\n+    MultiModalityDataPaddingPatternTokenPairs,\n+    pad_mm_token_pairs,\n+)\n+from sglang.srt.managers.schedule_batch import (\n+    Modality,\n+    MultimodalDataItem,\n+    MultimodalInputs,\n+)\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+START, END = 10, 11\n+\n+\n+def _item() -> MultimodalDataItem:\n+    item = MultimodalDataItem(modality=Modality.IMAGE)\n+    item.set_hash(0xABCD)\n+    return item\n+\n+\n+class TestPadMMTokenPairsFallback(CustomTestCase):\n+    def test_none_pairs_without_ids_returns_input_unchanged(self):\n+        ids = array(\"q\", [1, START, 5, 5, END, 2])\n+        mm_inputs = MultimodalInputs(mm_items=[_item()])\n+\n+        out = pad_mm_token_pairs(ids, mm_inputs, data_token_pairs=None)\n+\n+        self.assertEqual(list(out), list(ids))\n+        self.assertEqual(mm_inputs.data_offsets, [])\n+\n+    def test_none_pairs_falls_back_to_mm_inputs_start_end_ids(self):\n+        item = _item()\n+        ids = array(\"q\", [1, START, 5, 5, END, 2])\n+        mm_inputs = MultimodalInputs(\n+            mm_items=[item], im_start_id=START, im_end_id=END\n+        )\n+\n+        out = pad_mm_token_pairs(ids, mm_inputs, data_token_pairs=None)\n+\n+        self.assertEqual(list(out[:2]), [1, START])\n+        self.assertEqual(list(out[2:4]), item.padding_sequence(2))\n+        self.assertEqual(list(out[4:]), [END, 2])\n+        self.assertEqual(mm_inputs.data_offsets, [1])\n+\n+    def test_empty_pairs_returns_input_unchanged(self):\n+        ids = array(\"q\", [1, 2, 3])\n+        mm_inputs = MultimodalInputs(mm_items=[_item()])\n+\n+        out = pad_mm_token_pairs(ids, mm_inputs, data_token_pairs=[])\n+\n+        self.assertEqual(list(out), [1, 2, 3])\n+\n+    def test_legacy_pattern_class_accepts_none_pairs(self):\n+        ids = array(\"q\", [1, 2, 3])\n+        mm_inputs = MultimodalInputs(mm_items=[_item()])\n+\n+        pattern = MultiModalityDataPaddingPatternTokenPairs(data_token_pairs=None)\n+\n+        self.assertEqual(list(pattern.pad_input_tokens(ids, mm_inputs)), [1, 2, 3])\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e67db0f7c37602e02abecc1924cf4b79a944e1fe/test%2Fregistered%2Funit%2Fmanagers%2Ftest_mm_pad_token_pairs.py",
