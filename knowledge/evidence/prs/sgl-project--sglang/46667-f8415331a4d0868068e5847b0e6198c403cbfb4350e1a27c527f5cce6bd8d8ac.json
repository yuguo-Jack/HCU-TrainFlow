    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/6e662481eecb148cff7a9deaf5d269fee08ebebe/python%2Fsglang%2Fsrt%2Ffunction_call%2Finternlm_detector.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Finternlm_detector.py?ref=6e662481eecb148cff7a9deaf5d269fee08ebebe",
      "deletions": 2,
      "filename": "python/sglang/srt/function_call/internlm_detector.py",
      "patch": "@@ -158,7 +158,7 @@ def parse_streaming_increment(\n         \"\"\"\n         Streaming incremental parsing for InternLM format.\n \n-        Supports a single tool call in streaming mode.\n+        Supports multiple sequential tool calls in streaming mode.\n         \"\"\"\n         self._buffer += new_text\n         current_text = self._buffer\n@@ -169,7 +169,11 @@ def parse_streaming_increment(\n             # No tool call marker found\n             # If we've already processed tool calls, don't return text again\n             if self.current_tool_id > 0:\n-                self._buffer = \"\"\n+                # Keep a suffix that may be the beginning of the next marker.\n+                # InternLM emits <|action_start|> and <|plugin|> as separate\n+                # tokens, so dropping the partial marker loses later calls.\n+                if not self._ends_with_partial_token(current_text, self.bot_token):\n+                    self._buffer = \"\"\n                 return StreamingParseResult(normal_text=\"\")\n \n             # Check if buffer could be partial start of bot_token",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6e662481eecb148cff7a9deaf5d269fee08ebebe/python%2Fsglang%2Fsrt%2Ffunction_call%2Finternlm_detector.py",
      "sha": "99e5c24c155dcdd4d6e60cd47a59a2dc55afe68e",
      "status": "modified"
    },
    {
      "additions": 57,
      "blob_url": "https://github.com/sgl-project/sglang/blob/6e662481eecb148cff7a9deaf5d269fee08ebebe/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_internlm_detector.py",
      "changes": 57,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_internlm_detector.py?ref=6e662481eecb148cff7a9deaf5d269fee08ebebe",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_internlm_detector.py",
      "patch": "@@ -0,0 +1,57 @@\n+import json\n+\n+import pytest\n+\n+from sglang.srt.entrypoints.openai.protocol import Function, Tool\n+from sglang.srt.function_call.internlm_detector import InternlmDetector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=1, suite=\"base-a-test-cpu\")\n+\n+\n+def _make_tools():\n+    return [\n+        Tool(\n+            type=\"function\",\n+            function=Function(\n+                name=name,\n+                parameters={\"type\": \"object\"},\n+            ),\n+        )\n+        for name in (\"get_weather\", \"get_time\")\n+    ]\n+\n+\n+def test_streaming_multiple_calls_with_split_start_marker():\n+    chunks = [\n+        \"Checking.\",\n+        \"<|action_start|>\",\n+        \" \",\n+        \"<|plugin|>\",\n+        \"\\n\",\n+        '{\"name\":\"get_weather\",\"parameters\":{\"city\":\"Tokyo\"}}',\n+        \"<|action_end|>\",\n+        \"\\n\",\n+        \"<|action_start|>\",\n+        \" \",\n+        \"<|plugin|>\",\n+        \"\\n\",\n+        '{\"name\":\"get_time\",\"parameters\":{\"city\":\"Paris\"}}',\n+        \"<|action_end|>\",\n+    ]\n+\n+    detector = InternlmDetector()\n+    calls = []\n+    for chunk in chunks:\n+        calls.extend(detector.parse_streaming_increment(chunk, _make_tools()).calls)\n+\n+    assert [(call.tool_index, call.name) for call in calls] == [\n+        (0, \"get_weather\"),\n+        (1, \"get_time\"),\n+    ]\n+    assert json.loads(calls[0].parameters) == {\"city\": \"Tokyo\"}\n+    assert json.loads(calls[1].parameters) == {\"city\": \"Paris\"}\n+\n+\n+if __name__ == \"__main__\":\n+    raise SystemExit(pytest.main([__file__]))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/6e662481eecb148cff7a9deaf5d269fee08ebebe/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_internlm_detector.py",
      "sha": "a43e47ac1414a0ec471fc9fd9f62327407483063",
      "status": "added"
    }
