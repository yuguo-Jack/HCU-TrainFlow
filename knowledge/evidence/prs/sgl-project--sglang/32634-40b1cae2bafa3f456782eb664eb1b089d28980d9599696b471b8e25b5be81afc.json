      "changes": 21,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fprotocol.py?ref=bfe7c7bc0c104d1e78802528a2577d04f74deacf",
      "deletions": 0,
      "filename": "python/sglang/srt/entrypoints/openai/protocol.py",
      "patch": "@@ -717,6 +717,10 @@ class ToolChoice(BaseModel):\n ]\n \n \n+class ChatCompletionThinkingParam(BaseModel):\n+    type: Literal[\"disabled\", \"adaptive\"]\n+\n+\n class ChatCompletionRequest(BaseModel):\n     # Ordered by official OpenAI API documentation\n     # https://platform.openai.com/docs/api-reference/chat/create\n@@ -774,6 +778,11 @@ class ChatCompletionRequest(BaseModel):\n         \"models that expose a maximum-effort tier above 'high'; models that don't \"\n         \"support it treat it the same as 'high'.\",\n     )\n+    thinking: Optional[ChatCompletionThinkingParam] = Field(\n+        default=None,\n+        description=\"Minimax reasoning control. 'disabled' disables reasoning and \"\n+        \"'adaptive' enables it.\",\n+    )\n     task: Optional[\n         Literal[\"action\", \"query\", \"authority\", \"domain\", \"title\", \"read_url\"]\n     ] = Field(\n@@ -877,6 +886,18 @@ def validate_reasoning_effort_type(cls, value):\n     def normalize_reasoning_inputs(cls, values: Dict):\n         r = values.get(\"reasoning\")\n         thinking = None\n+        minimax_thinking = values.get(\"thinking\")\n+        if isinstance(minimax_thinking, dict):\n+            thinking_type = minimax_thinking.get(\"type\")\n+            if thinking_type in {\"disabled\", \"adaptive\"}:\n+                ctk = values.get(\"chat_template_kwargs\")\n+                if not isinstance(ctk, dict):\n+                    ctk = {}\n+                ctk.setdefault(\n+                    \"thinking_mode\",\n+                    \"disabled\" if thinking_type == \"disabled\" else \"enabled\",\n+                )\n+                values[\"chat_template_kwargs\"] = ctk\n \n         if r is not None and isinstance(r, dict):\n             effort = r.get(\"effort\")",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bfe7c7bc0c104d1e78802528a2577d04f74deacf/python%2Fsglang%2Fsrt%2Fentrypoints%2Fopenai%2Fprotocol.py",
      "sha": "5b5b2b48267b89444326fc1fae5d9abfd9fedef5",
      "status": "modified"
    },
    {
      "additions": 36,
      "blob_url": "https://github.com/sgl-project/sglang/blob/bfe7c7bc0c104d1e78802528a2577d04f74deacf/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_protocol.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_protocol.py?ref=bfe7c7bc0c104d1e78802528a2577d04f74deacf",
      "deletions": 0,
      "filename": "test/registered/unit/entrypoints/openai/test_protocol.py",
      "patch": "@@ -259,6 +259,42 @@ def test_chat_completion_reasoning_effort_none_overrides_enabled(self):\n         self.assertFalse(request.chat_template_kwargs.get(\"thinking\"))\n         self.assertFalse(request.chat_template_kwargs.get(\"enable_thinking\"))\n \n+    def test_chat_completion_minimax_thinking_disabled(self):\n+        request = ChatCompletionRequest(\n+            model=\"MiniMaxAI/MiniMax-M3\",\n+            messages=[{\"role\": \"user\", \"content\": \"Hello\"}],\n+            thinking={\"type\": \"disabled\"},\n+        )\n+        self.assertEqual(request.thinking.type, \"disabled\")\n+        self.assertEqual(\n+            request.chat_template_kwargs,\n+            {\"thinking_mode\": \"disabled\"},\n+        )\n+\n+    def test_chat_completion_minimax_thinking_adaptive(self):\n+        request = ChatCompletionRequest(\n+            model=\"MiniMaxAI/MiniMax-M3\",\n+            messages=[{\"role\": \"user\", \"content\": \"Hello\"}],\n+            thinking={\"type\": \"adaptive\"},\n+        )\n+        self.assertEqual(request.thinking.type, \"adaptive\")\n+        self.assertEqual(\n+            request.chat_template_kwargs,\n+            {\"thinking_mode\": \"enabled\"},\n+        )\n+\n+    def test_chat_completion_minimax_thinking_keeps_explicit_template_mode(self):\n+        request = ChatCompletionRequest(\n+            model=\"MiniMaxAI/MiniMax-M3\",\n+            messages=[{\"role\": \"user\", \"content\": \"Hello\"}],\n+            thinking={\"type\": \"adaptive\"},\n+            chat_template_kwargs={\"thinking_mode\": \"disabled\"},\n+        )\n+        self.assertEqual(\n+            request.chat_template_kwargs,\n+            {\"thinking_mode\": \"disabled\"},\n+        )\n+\n     def test_chat_completion_extended_reasoning_effort_levels(self):\n         \"\"\"Extended effort levels work in both supported request forms.\"\"\"\n         from pydantic import ValidationError",
      "raw_url": "https://github.com/sgl-project/sglang/raw/bfe7c7bc0c104d1e78802528a2577d04f74deacf/test%2Fregistered%2Funit%2Fentrypoints%2Fopenai%2Ftest_protocol.py",
