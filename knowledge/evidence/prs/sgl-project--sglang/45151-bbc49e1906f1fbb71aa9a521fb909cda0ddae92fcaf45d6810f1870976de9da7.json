  "files": [
    {
      "additions": 16,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b071b90d48a0e0eaf4187d734c9e86e1cdc5487a/python%2Fsglang%2Fsrt%2Fspeculative%2Feagle_worker_v2.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fspeculative%2Feagle_worker_v2.py?ref=b071b90d48a0e0eaf4187d734c9e86e1cdc5487a",
      "deletions": 2,
      "filename": "python/sglang/srt/speculative/eagle_worker_v2.py",
      "patch": "@@ -220,6 +220,21 @@ def __init__(\n \n         self.plan_stream, self.plan_stream_ctx = get_plan_stream(self.device)\n \n+        # The draft model builds its own embed_tokens/lm_head while loading and\n+        # only hands them over to the target's tensors in init_lm_head(). Do it\n+        # here, before the scheduler profiles free memory for the target KV\n+        # pool: otherwise the duplicate draft tensors are still resident when\n+        # the pool is sized and the KV cache is permanently undersized.\n+        self._embed_and_head_shared = False\n+        self._share_embed_and_head()\n+\n+    def _share_embed_and_head(self):\n+        if self._embed_and_head_shared:\n+            return\n+        self.init_token_map()\n+        self.init_lm_head()\n+        self._embed_and_head_shared = True\n+\n     def alloc_memory_pool(\n         self,\n         memory_pool_config=None,\n@@ -234,8 +249,7 @@ def alloc_memory_pool(\n             req_to_token_pool=req_to_token_pool,\n             token_to_kv_pool_allocator=token_to_kv_pool_allocator,\n         )\n-        self.init_token_map()\n-        self.init_lm_head()\n+        self._share_embed_and_head()\n \n         if get_spec().speculative_use_rejection_sampling:\n             target_vocab_size = self.target_worker.model_config.vocab_size",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b071b90d48a0e0eaf4187d734c9e86e1cdc5487a/python%2Fsglang%2Fsrt%2Fspeculative%2Feagle_worker_v2.py",
      "sha": "faa10623d376089f6848555afbc227b1b38aa13a",
      "status": "modified"
    },
    {
      "additions": 56,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b071b90d48a0e0eaf4187d734c9e86e1cdc5487a/test%2Fregistered%2Funit%2Fspec%2Ftest_eagle_share_embed_and_head.py",
      "changes": 56,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fspec%2Ftest_eagle_share_embed_and_head.py?ref=b071b90d48a0e0eaf4187d734c9e86e1cdc5487a",
      "deletions": 0,
      "filename": "test/registered/unit/spec/test_eagle_share_embed_and_head.py",
      "patch": "@@ -0,0 +1,56 @@\n+\"\"\"The EAGLE/MTP draft must share target embed/head before KV sizing.\n+\n+The draft model allocates its own embed_tokens/lm_head while it loads. If those\n+duplicates are still resident when the scheduler profiles free memory for the\n+target KV pool, the pool is permanently undersized. The worker therefore binds\n+them to the target in __init__ and only re-uses the bound state later.\n+\"\"\"\n+\n+import unittest\n+from types import SimpleNamespace\n+from unittest.mock import MagicMock, patch\n+\n+from sglang.srt.speculative import eagle_worker_v2\n+from sglang.srt.speculative.eagle_worker_v2 import EagleDraftWorker\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=1, suite=\"base-a-test-cpu\")\n+\n+\n+class TestShareEmbedAndHead(CustomTestCase):\n+    def _worker(self):\n+        worker = object.__new__(EagleDraftWorker)\n+        worker._embed_and_head_shared = False\n+        worker.init_token_map = MagicMock()\n+        worker.init_lm_head = MagicMock()\n+        return worker\n+\n+    def test_share_runs_only_once(self):\n+        worker = self._worker()\n+        order = []\n+        worker.init_token_map.side_effect = lambda: order.append(\"token_map\")\n+        worker.init_lm_head.side_effect = lambda: order.append(\"lm_head\")\n+\n+        worker._share_embed_and_head()\n+        worker._share_embed_and_head()\n+\n+        worker.init_token_map.assert_called_once_with()\n+        worker.init_lm_head.assert_called_once_with()\n+        self.assertEqual(order, [\"token_map\", \"lm_head\"])\n+\n+    def test_alloc_memory_pool_reuses_shared_state(self):\n+        worker = self._worker()\n+        worker.draft_worker = MagicMock()\n+        worker._share_embed_and_head()\n+\n+        spec = SimpleNamespace(speculative_use_rejection_sampling=False)\n+        with patch.object(eagle_worker_v2, \"get_spec\", return_value=spec):\n+            worker.alloc_memory_pool()\n+\n+        worker.init_token_map.assert_called_once_with()\n+        worker.init_lm_head.assert_called_once_with()\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b071b90d48a0e0eaf4187d734c9e86e1cdc5487a/test%2Fregistered%2Funit%2Fspec%2Ftest_eagle_share_embed_and_head.py",
      "sha": "e527ada49d099f6af2d6a49d83ea7e0fbca83e67",
      "status": "added"
    }
  ],
