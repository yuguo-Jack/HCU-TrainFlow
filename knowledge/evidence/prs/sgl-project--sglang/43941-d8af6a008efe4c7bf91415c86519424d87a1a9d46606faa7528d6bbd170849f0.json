  "files": [
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/244e0a1f0c5ccf5cbfff27bfdd51e4708e9e307c/python%2Fsglang%2Fsrt%2Fparser%2Fchat_parsing%2Fresponse_parser.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fparser%2Fchat_parsing%2Fresponse_parser.py?ref=244e0a1f0c5ccf5cbfff27bfdd51e4708e9e307c",
      "deletions": 1,
      "filename": "python/sglang/srt/parser/chat_parsing/response_parser.py",
      "patch": "@@ -47,7 +47,14 @@ def _coerce(raw: str, types: tuple[str, ...]) -> Any:\n     for type_name in types:\n         try:\n             if type_name == \"integer\":\n-                return int(raw)\n+                try:\n+                    return int(raw)\n+                except ValueError:\n+                    # JSON Schema integers include whole numbers written as floats, e.g. \"3.0\"\n+                    number = float(raw)\n+                    if not number.is_integer():\n+                        continue\n+                    return int(number)\n             if type_name == \"number\":\n                 number = float(raw)\n                 if number != number or number in (float(\"inf\"), float(\"-inf\")):",
      "raw_url": "https://github.com/sgl-project/sglang/raw/244e0a1f0c5ccf5cbfff27bfdd51e4708e9e307c/python%2Fsglang%2Fsrt%2Fparser%2Fchat_parsing%2Fresponse_parser.py",
      "sha": "ccef5b0c688ff059b37fef29ed557d2ac0ad40c2",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/244e0a1f0c5ccf5cbfff27bfdd51e4708e9e307c/test%2Fregistered%2Funit%2Fparser%2Ftest_chat_parsing.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fparser%2Ftest_chat_parsing.py?ref=244e0a1f0c5ccf5cbfff27bfdd51e4708e9e307c",
      "deletions": 0,
      "filename": "test/registered/unit/parser/test_chat_parsing.py",
      "patch": "@@ -1446,6 +1446,14 @@ def test_coerce_tool_calls_casts_declared_types(self):\n     def test_coerce_falls_back_to_raw_on_failure(self):\n         self.assertEqual(_coerce(\"not-a-number\", (\"integer\",)), \"not-a-number\")\n \n+    def test_coerce_integer_accepts_whole_number_floats(self):\n+        self.assertEqual(_coerce(\"3.0\", (\"integer\",)), 3)\n+        self.assertIsInstance(_coerce(\"3.0\", (\"integer\",)), int)\n+        self.assertEqual(_coerce(\"3.5\", (\"integer\",)), \"3.5\")\n+        self.assertEqual(_coerce(\"3.5\", (\"integer\", \"number\")), 3.5)\n+        self.assertEqual(_coerce(\"inf\", (\"integer\",)), \"inf\")\n+        self.assertEqual(_coerce(\"NaN\", (\"integer\",)), \"NaN\")\n+\n     def test_coerce_handles_any_of_and_null(self):\n         self.assertEqual(_coerce(\"5\", (\"integer\", \"null\")), 5)\n         self.assertIsNone(_coerce(\"null\", (\"integer\", \"null\")))",
      "raw_url": "https://github.com/sgl-project/sglang/raw/244e0a1f0c5ccf5cbfff27bfdd51e4708e9e307c/test%2Fregistered%2Funit%2Fparser%2Ftest_chat_parsing.py",
      "sha": "1937128ed703c92bd9f72a523eaf938ea0aad57e",
      "status": "modified"
    }
