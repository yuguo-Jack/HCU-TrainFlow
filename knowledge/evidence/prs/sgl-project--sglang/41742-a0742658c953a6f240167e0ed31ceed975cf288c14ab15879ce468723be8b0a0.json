      "blob_url": "https://github.com/sgl-project/sglang/blob/ac8b84ab82d7384ff04964d4810633c920d6097f/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fkv_cache.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fkv_cache.py?ref=ac8b84ab82d7384ff04964d4810633c920d6097f",
      "deletions": 0,
      "filename": "python/sglang/srt/layers/quantization/kv_cache.py",
      "patch": "@@ -49,6 +49,21 @@ def apply(self, layer: torch.nn.Module) -> torch.Tensor:\n         raise RuntimeError(f\"{self.__class__.__name__}.apply should not be called.\")\n \n     def process_weights_after_loading(self, layer) -> None:\n+        if layer.k_scale.numel() != 1 or layer.v_scale.numel() != 1:\n+            raise ValueError(\n+                \"Only support per-tensor scaling factor for fp8 KV cache, got \"\n+                f\"k_scale shape={tuple(layer.k_scale.shape)} \"\n+                f\"v_scale shape={tuple(layer.v_scale.shape)}\"\n+            )\n+        k_scale_cpu = layer.k_scale.to(\"cpu\")\n+        v_scale_cpu = layer.v_scale.to(\"cpu\")\n+        if not (\n+            torch.isfinite(k_scale_cpu).all() and torch.isfinite(v_scale_cpu).all()\n+        ):\n+            raise ValueError(\n+                \"fp8 KV cache scales must be finite, got \"\n+                f\"k_scale={k_scale_cpu.item()} v_scale={v_scale_cpu.item()}\"\n+            )\n         if layer.k_scale > 0.0 and layer.v_scale > 0.0:\n             # We prefer to use separate k_scale and v_scale if present\n             k_scale = layer.k_scale.to(\"cpu\").tolist()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ac8b84ab82d7384ff04964d4810633c920d6097f/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fkv_cache.py",
      "sha": "8125984116fa9b8e5285bbc28ec3eb89fa36d4f9",
      "status": "modified"
    },
