      "changes": 30,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fbase_format_detector.py?ref=888b3466cf2ce3497d3bf98221f3c0a47c6720b2",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/base_format_detector.py",
      "patch": "@@ -1,3 +1,4 @@\n+import inspect\n import json\n import logging\n from abc import ABC, abstractmethod\n@@ -13,6 +14,7 @@\n     StructuralTag = Any\n     get_model_structural_tag = None\n \n+\n from sglang.srt.entrypoints.openai.protocol import Tool, ToolChoice\n from sglang.srt.environ import envs\n from sglang.srt.function_call.core_types import (\n@@ -29,6 +31,17 @@\n logger = logging.getLogger(__name__)\n \n \n+def _xgrammar_supports_token_markers() -> bool:\n+    \"\"\"True when the installed xgrammar accepts ``token_markers``.\"\"\"\n+    if get_model_structural_tag is None:\n+        return False\n+    try:\n+        params = inspect.signature(get_model_structural_tag).parameters\n+    except (TypeError, ValueError):\n+        return False\n+    return \"token_markers\" in params\n+\n+\n class BaseFormatDetector(ABC):\n     \"\"\"Base class providing two sets of interfaces: one-time and streaming incremental.\"\"\"\n \n@@ -388,6 +401,16 @@ def get_structural_tag_name(self) -> Optional[str]:\n         \"\"\"Return the XGrammar model name for native structural tags, if supported.\"\"\"\n         return None\n \n+    def use_structural_tag_token_markers(self) -> bool:\n+        \"\"\"Whether XGrammar should match this format's control markers as tokens.\n+\n+        Only enable this for formats whose markers (e.g. ``<tool_call>``) are\n+        dedicated single tokens in the tokenizer. It is applied only when the\n+        installed xgrammar supports ``token_markers``; otherwise the text\n+        trigger is used.\n+        \"\"\"\n+        return False\n+\n     def get_structural_tag(\n         self,\n         tools: Union[List[Tool], None] = None,\n@@ -423,12 +446,19 @@ def get_structural_tag(\n             if isinstance(tool_choice, ToolChoice)\n             else tool_choice\n         )\n+        extra_kwargs = {}\n+        if (\n+            self.use_structural_tag_token_markers()\n+            and _xgrammar_supports_token_markers()\n+        ):\n+            extra_kwargs[\"token_markers\"] = True\n         return get_model_structural_tag(\n             model=structural_tag_name,\n             tools=converted_tools,\n             tool_choice=converted_tool_choice,\n             reasoning=thinking_mode,\n             parallel_tool_calls=parallel_tool_calls,\n+            **extra_kwargs,\n         )\n \n     def get_auto_tool_call_structural_tag(",
      "raw_url": "https://github.com/sgl-project/sglang/raw/888b3466cf2ce3497d3bf98221f3c0a47c6720b2/python%2Fsglang%2Fsrt%2Ffunction_call%2Fbase_format_detector.py",
      "sha": "33d3d5c8f211f008ca8f3df0802c8d9250876796",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/888b3466cf2ce3497d3bf98221f3c0a47c6720b2/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py?ref=888b3466cf2ce3497d3bf98221f3c0a47c6720b2",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/qwen3_coder_detector.py",
      "patch": "@@ -481,3 +481,8 @@ def structure_info(self) -> _GetInfoFunc:\n \n     def get_structural_tag_name(self) -> str:\n         return \"qwen_3_coder\"\n+\n+    def use_structural_tag_token_markers(self) -> bool:\n+        # <tool_call> is a dedicated token in the qwen3 coder tokenizer, so\n+        # match it by token id instead of the text \"<tool_call>\\n<function=\".\n+        return True",
      "raw_url": "https://github.com/sgl-project/sglang/raw/888b3466cf2ce3497d3bf98221f3c0a47c6720b2/python%2Fsglang%2Fsrt%2Ffunction_call%2Fqwen3_coder_detector.py",
      "sha": "3077ef0eaaaedb153d52e1a3228770f882074410",
      "status": "modified"
    },
    {
      "additions": 101,
      "blob_url": "https://github.com/sgl-project/sglang/blob/888b3466cf2ce3497d3bf98221f3c0a47c6720b2/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_qwen3_coder_token_markers.py",
      "changes": 101,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_qwen3_coder_token_markers.py?ref=888b3466cf2ce3497d3bf98221f3c0a47c6720b2",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_qwen3_coder_token_markers.py",
      "patch": "@@ -0,0 +1,101 @@\n+\"\"\"Unit tests for qwen3_coder xgrammar token_markers feature detection.\"\"\"\n+\n+import unittest\n+from unittest.mock import patch\n+\n+from sglang.srt.entrypoints.openai.protocol import Function, Tool\n+from sglang.srt.function_call import base_format_detector\n+from sglang.srt.function_call.base_format_detector import BaseFormatDetector\n+from sglang.srt.function_call.qwen3_coder_detector import Qwen3CoderDetector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(1.0, \"base-a-test-cpu\")\n+\n+\n+def _tool() -> Tool:\n+    return Tool(\n+        type=\"function\",\n+        function=Function(\n+            name=\"get_weather\",\n+            parameters={\n+                \"type\": \"object\",\n+                \"properties\": {\"city\": {\"type\": \"string\"}},\n+                \"required\": [\"city\"],\n+            },\n+        ),\n+    )\n+\n+\n+class _Recorder:\n+    def __init__(self):\n+        self.kwargs = None\n+\n+    def record(self, kwargs):\n+        self.kwargs = kwargs\n+        return \"tag\"\n+\n+\n+def _new_api(recorder):\n+    def get_model_structural_tag(\n+        model,\n+        tools=None,\n+        tool_choice=\"auto\",\n+        reasoning=\"enabled\",\n+        parallel_tool_calls=True,\n+        token_markers=False,\n+    ):\n+        return recorder.record(\n+            dict(model=model, reasoning=reasoning, token_markers=token_markers)\n+        )\n+\n+    return get_model_structural_tag\n+\n+\n+def _old_api(recorder):\n+    def get_model_structural_tag(\n+        model,\n+        tools=None,\n+        tool_choice=\"auto\",\n+        reasoning=\"enabled\",\n+        parallel_tool_calls=True,\n+    ):\n+        return recorder.record(dict(model=model, reasoning=reasoning))\n+\n+    return get_model_structural_tag\n+\n+\n+class _OtherDetector(Qwen3CoderDetector):\n+    def use_structural_tag_token_markers(self) -> bool:\n+        return BaseFormatDetector.use_structural_tag_token_markers(self)\n+\n+\n+class TestQwen3CoderTokenMarkers(unittest.TestCase):\n+    def _call(self, api_factory, detector):\n+        recorder = _Recorder()\n+        with patch.object(\n+            base_format_detector, \"get_model_structural_tag\", api_factory(recorder)\n+        ):\n+            result = detector.get_structural_tag(tools=[_tool()], tool_choice=\"auto\")\n+        self.assertEqual(result, \"tag\")\n+        return recorder.kwargs\n+\n+    def test_token_markers_passed_when_supported(self):\n+        kwargs = self._call(_new_api, Qwen3CoderDetector())\n+        self.assertEqual(kwargs[\"model\"], \"qwen_3_coder\")\n+        self.assertIs(kwargs[\"token_markers\"], True)\n+\n+    def test_falls_back_to_text_trigger_on_old_xgrammar(self):\n+        kwargs = self._call(_old_api, Qwen3CoderDetector())\n+        self.assertNotIn(\"token_markers\", kwargs)\n+\n+    def test_not_passed_for_detectors_without_opt_in(self):\n+        kwargs = self._call(_new_api, _OtherDetector())\n+        self.assertIs(kwargs[\"token_markers\"], False)\n+\n+    def test_no_xgrammar(self):\n+        with patch.object(base_format_detector, \"get_model_structural_tag\", None):\n+            self.assertIsNone(Qwen3CoderDetector().get_structural_tag(tools=[_tool()]))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/888b3466cf2ce3497d3bf98221f3c0a47c6720b2/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_qwen3_coder_token_markers.py",
      "sha": "825ae51a6e791d8a9393c51b4e16e60128da4e6b",
      "status": "added"
    }
