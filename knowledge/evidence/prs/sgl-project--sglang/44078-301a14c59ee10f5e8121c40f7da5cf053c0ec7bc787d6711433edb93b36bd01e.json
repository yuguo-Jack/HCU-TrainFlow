      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Ftokenizer_manager.py?ref=b603b9a2998c8d6d1348f41ab3c08e4531b7fdc2",
      "deletions": 3,
      "filename": "python/sglang/srt/managers/tokenizer_manager.py",
      "patch": "@@ -1439,10 +1439,29 @@ def _validate_joint_schema_request(\n     def _validate_mm_limits(\n         self, obj: Union[GenerateReqInput, EmbeddingReqInput]\n     ) -> None:\n-        if not get_mm().limit_mm_data_per_request:\n-            return\n+        # Build the effective per-modality limits dict.\n+        # If the user explicitly set --limit-mm-data-per-request, use it as-is\n+        # (an empty dict means \"no limits\"). Otherwise apply sensible defaults\n+        # to prevent OOM from unbounded multi-image requests (each 4K image\n+        # costs roughly ~1 GiB GPU memory with the fast image processor).\n+        from sglang.srt.multimodal.processors.base_processor import (\n+            BaseMultimodalProcessor,\n+        )\n+\n+        DEFAULT_IMAGE_NUM_LIMITATION = (\n+            BaseMultimodalProcessor.DEFAULT_IMAGE_NUM_LIMITATION\n+        )\n+\n+        user_limits = get_mm().limit_mm_data_per_request\n+        if user_limits is None:\n+            limits = {\"image\": DEFAULT_IMAGE_NUM_LIMITATION}\n+        else:\n+            limits = user_limits\n+            if not limits:\n+                # Empty dict: user explicitly disabled all limits\n+                return\n \n-        for modality, limit in get_mm().limit_mm_data_per_request.items():\n+        for modality, limit in limits.items():\n             data = getattr(obj, f\"{modality}_data\", None)\n             if data:\n                 count = len(data) if isinstance(data, list) else 1",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b603b9a2998c8d6d1348f41ab3c08e4531b7fdc2/python%2Fsglang%2Fsrt%2Fmanagers%2Ftokenizer_manager.py",
      "sha": "6d66d50d7ca73d79843372deb820ddd73c9fef48",
      "status": "modified"
    },
    {
      "additions": 33,
      "blob_url": "https://github.com/sgl-project/sglang/blob/b603b9a2998c8d6d1348f41ab3c08e4531b7fdc2/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py?ref=b603b9a2998c8d6d1348f41ab3c08e4531b7fdc2",
      "deletions": 0,
      "filename": "python/sglang/srt/multimodal/processors/base_processor.py",
      "patch": "@@ -239,6 +239,10 @@ class BaseMultimodalProcessor(ABC):\n     # `process_and_combine_mm_data` -- resolves that clone instead of\n     # `self._processor`, so isolation does not depend on the subclass.\n     supports_mm_processor_concurrency = True\n+    # Default max number of images per request. Subclasses may override.\n+    # Each 4K image costs roughly ~1 GiB GPU memory with the fast image\n+    # processor, so unbounded multi-image requests can easily OOM.\n+    DEFAULT_IMAGE_NUM_LIMITATION = 5\n \n     def __init__(\n         self, hf_config, server_args, _processor, transport_mode, *args, **kwargs\n@@ -1201,12 +1205,41 @@ def validate_mm_data(\n           item whose format is one of the two above).\n \n         Empty or None lists are considered valid.\n+\n+        Additionally enforces ``DEFAULT_IMAGE_NUM_LIMITATION`` to prevent OOM\n+        from unbounded multi-image requests.\n         \"\"\"\n \n         BaseMultimodalProcessor._validate_one_modality(Modality.IMAGE, image_data)\n         BaseMultimodalProcessor._validate_one_modality(Modality.VIDEO, video_data)\n         BaseMultimodalProcessor._validate_one_modality(Modality.AUDIO, audio_data)\n \n+        # Enforce default image count limit as a defensive safeguard.\n+        # Respect the user-provided --limit-mm-data-per-request override if set.\n+        image_limit = BaseMultimodalProcessor._resolve_effective_image_limit()\n+        if image_data and len(image_data) > image_limit:\n+            raise ValueError(\n+                f\"Image count {len(image_data)} exceeds the limit of \"\n+                f\"{image_limit} per request. \"\n+                f\"Use --limit-mm-data-per-request '{{}}' to disable this limit, \"\n+                f\"or specify an image entry to override it \"\n+                f\"(e.g. '{{\\\"image\\\": 10}}').\"\n+            )\n+\n+    @staticmethod\n+    def _resolve_effective_image_limit() -> int:\n+        \"\"\"Return the effective image count limit for the current server config.\n+\n+        Uses the user-provided ``--limit-mm-data-per-request`` image entry when\n+        set; otherwise falls back to ``DEFAULT_IMAGE_NUM_LIMITATION``. A user\n+        value of ``0`` disables the check.\n+        \"\"\"\n+        user_limits = get_mm().limit_mm_data_per_request\n+        if user_limits is not None and isinstance(user_limits, dict):\n+            if \"image\" in user_limits:\n+                return user_limits[\"image\"]\n+        return BaseMultimodalProcessor.DEFAULT_IMAGE_NUM_LIMITATION\n+\n     def _process_loaded_mm_data(self, modality, raw_data, result):\n         images, videos, audios = [], [], []\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/b603b9a2998c8d6d1348f41ab3c08e4531b7fdc2/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fbase_processor.py",
      "sha": "7e2811b77f358b7e6fba6ed2f82edc7358f14661",
      "status": "modified"
