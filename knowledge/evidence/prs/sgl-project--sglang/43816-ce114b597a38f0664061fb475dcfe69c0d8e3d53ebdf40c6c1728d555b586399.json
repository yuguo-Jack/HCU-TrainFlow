      "blob_url": "https://github.com/sgl-project/sglang/blob/7bbc59bf531639e9044e3e4e51c2a1946f631050/python%2Fsglang%2Fsrt%2Fmem_cache%2Fstorage%2Fseaweedfs%2Fseaweedfs_store.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmem_cache%2Fstorage%2Fseaweedfs%2Fseaweedfs_store.py?ref=7bbc59bf531639e9044e3e4e51c2a1946f631050",
      "deletions": 1,
      "filename": "python/sglang/srt/mem_cache/storage/seaweedfs/seaweedfs_store.py",
      "patch": "@@ -111,6 +111,13 @@ def __init__(\n         self.config = SeaweedFSConfig.from_extra_config(storage_config.extra_config)\n         scope = [self.config.prefix.strip(\"/\")] if self.config.prefix else []\n         self.key_prefix = \"/\".join(scope + key_scope(storage_config))\n+        # MLA KV is replicated across TP ranks, but every rank backs up its own\n+        # Mamba shard (see should_backup), so Mamba keys always carry the TP rank.\n+        self._mamba_rank_tag = (\n+            f\".tp{storage_config.tp_rank}of{storage_config.tp_size}\"\n+            if storage_config.is_mla_model\n+            else \"\"\n+        )\n         self._s3 = _make_s3_client(self.config)\n         self._executor = ThreadPoolExecutor(max_workers=self.config.max_workers)\n         self._ensure_bucket()\n@@ -301,7 +308,11 @@ def batch_set_v1(\n \n     def _component_key(self, key: str, pool_name) -> str:\n         name = getattr(pool_name, \"value\", pool_name)\n-        return key if name == PoolName.KV.value else f\"{key}.{name}\"\n+        if name == PoolName.KV.value:\n+            return key\n+        if name == PoolName.MAMBA.value:\n+            return f\"{key}.{name}{self._mamba_rank_tag}\"\n+        return f\"{key}.{name}\"\n \n     def batch_exists_v2(\n         self,",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7bbc59bf531639e9044e3e4e51c2a1946f631050/python%2Fsglang%2Fsrt%2Fmem_cache%2Fstorage%2Fseaweedfs%2Fseaweedfs_store.py",
      "sha": "b209beb213653e23027e3f2d8aaa10ab0fbf07e2",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/sgl-project/sglang/blob/7bbc59bf531639e9044e3e4e51c2a1946f631050/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_hicache_seaweedfs_storage.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_hicache_seaweedfs_storage.py?ref=7bbc59bf531639e9044e3e4e51c2a1946f631050",
      "deletions": 2,
      "filename": "test/registered/unit/mem_cache/test_hicache_seaweedfs_storage.py",
      "patch": "@@ -291,8 +291,8 @@ def test_mla_ranks_share_objects(self):\n     # the backend only touches it through the host-pool page API, so what this\n     # proves is the per-pool object naming, routing and hit policies.\n \n-    def _v2_store(self, layout=\"page_first\"):\n-        store = self._store()\n+    def _v2_store(self, layout=\"page_first\", **store_kwargs):\n+        store = self._store(**store_kwargs)\n         kv, side = _host_pool(layout), _host_pool(layout)\n         store.register_mem_host_pool_v2(kv, PoolName.KV)\n         store.register_mem_host_pool_v2(side, PoolName.MAMBA)\n@@ -325,6 +325,28 @@ def test_v2_round_trip_is_bit_exact_per_pool(self):\n                     for i in range(NUM_PAGES):\n                         self.assertTrue(torch.equal(_page(pool, i), expected[p][i]))\n \n+    def test_v2_mla_mamba_state_stays_per_rank(self):\n+        # Every MLA TP rank backs up its own Mamba shard; replicated KV is shared.\n+        ranks = [self._v2_store(tp_rank=r, tp_size=2, is_mla=True) for r in (0, 1)]\n+        keys = ranks[0][3]\n+        for store, _, _, _, transfers in ranks:\n+            transfers[1].keys = keys\n+            self.assertEqual(\n+                store.batch_set_v2(transfers[1:])[PoolName.MAMBA], [True] * NUM_PAGES\n+            )\n+        for store, _, side, _, transfers in ranks:\n+            expected = [_page(side, i) for i in range(NUM_PAGES)]\n+            side.kv_buffer.zero_()\n+            self.assertEqual(\n+                store.batch_get_v2(transfers[1:])[PoolName.MAMBA], [True] * NUM_PAGES\n+            )\n+            for i in range(NUM_PAGES):\n+                self.assertTrue(torch.equal(_page(side, i), expected[i]))\n+        self.assertEqual(\n+            ranks[0][0]._component_key(\"k\", PoolName.KV),\n+            ranks[1][0]._component_key(\"k\", PoolName.KV),\n+        )\n+\n     def test_v2_kv_pages_are_the_v1_objects(self):\n         # KV pages keep their v1 object names, so v1 and v2 share one cache;\n         # side-pool pages are separate objects and never overwrite them.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/7bbc59bf531639e9044e3e4e51c2a1946f631050/test%2Fregistered%2Funit%2Fmem_cache%2Ftest_hicache_seaweedfs_storage.py",
      "sha": "7c6c82ee0995f2507cee08d70f8e92781f4f7968",
