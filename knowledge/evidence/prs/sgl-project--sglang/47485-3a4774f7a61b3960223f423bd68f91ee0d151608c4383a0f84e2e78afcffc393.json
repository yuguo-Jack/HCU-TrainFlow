  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/sgl-project/sglang/blob/72157cfbd4e6d82ca172bf871833959c43a32ac5/python%2Fsglang%2Fsrt%2Fenviron.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fenviron.py?ref=72157cfbd4e6d82ca172bf871833959c43a32ac5",
      "deletions": 0,
      "filename": "python/sglang/srt/environ.py",
      "patch": "@@ -1101,6 +1101,9 @@ class Envs:\n     # ROCPROFILER_REGISTER_LIBRARY.\n     SGLANG_ROCM_KEEP_INHERITED_ROCPROFILER_REGISTER = EnvBool(False)\n     SGLANG_ROCM_DISABLE_LINEARQUANT = EnvBool(False)\n+    # Run the BF16 lm_head through aiter tgemm, as gfx1250 always does,\n+    # so its tuned rows apply instead of hipBLASLt's heuristic (measured on gfx950).\n+    SGLANG_OPT_AITER_LM_HEAD_GEMM = EnvBool(False)\n     USE_ROCM_AITER_ROPE_BACKEND = EnvStr(\"0\")\n     # Enable dual-stream MoE (shared experts vs routed experts) on the\n     # ROCm/AITER path. Requires GPU_MAX_HW_QUEUES>=5 to avoid HW-queue serialization.",
      "raw_url": "https://github.com/sgl-project/sglang/raw/72157cfbd4e6d82ca172bf871833959c43a32ac5/python%2Fsglang%2Fsrt%2Fenviron.py",
      "sha": "d0944869a0446135b57c8f4e841ccfac7bb5e1d7",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/sgl-project/sglang/blob/72157cfbd4e6d82ca172bf871833959c43a32ac5/python%2Fsglang%2Fsrt%2Flayers%2Flogits_processor.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Flogits_processor.py?ref=72157cfbd4e6d82ca172bf871833959c43a32ac5",
      "deletions": 1,
      "filename": "python/sglang/srt/layers/logits_processor.py",
      "patch": "@@ -80,7 +80,11 @@\n _is_npu = is_npu()\n _is_cpu = is_cpu()\n # On gfx1250, torch.mm for a bf16 lm_head is slower than aiter's GEMM.\n-_use_aiter_lm_head = is_hip() and envs.SGLANG_USE_AITER.get() and is_gfx1250_supported()\n+_use_aiter_lm_head = (\n+    is_hip()\n+    and envs.SGLANG_USE_AITER.get()\n+    and (is_gfx1250_supported() or envs.SGLANG_OPT_AITER_LM_HEAD_GEMM.get())\n+)\n if _use_aiter_lm_head:\n     from aiter.tuned_gemm import tgemm\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/72157cfbd4e6d82ca172bf871833959c43a32ac5/python%2Fsglang%2Fsrt%2Flayers%2Flogits_processor.py",
      "sha": "2c159fd4c38cfbbcca96f2e1b82899d77998725d",
      "status": "modified"
    }
