      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e2e8d99c2f7d75388b5deeb84a126389128bf5af/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdecode_attention.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdecode_attention.py?ref=e2e8d99c2f7d75388b5deeb84a126389128bf5af",
      "deletions": 2,
      "filename": "python/sglang/kernels/ops/attention/decode_attention.py",
      "patch": "@@ -121,8 +121,9 @@ def _keep_scheduler_splits() -> bool:\n \n \n def _grouped_head_tiles(head_num: int, kv_group_num: int) -> int:\n-    \"\"\"Stage-1's grid extent along heads.\"\"\"\n-    return triton.cdiv(head_num, min(_GROUPED_BLOCK_H, kv_group_num))\n+    \"\"\"Stage-1's grid extent along heads: a whole number of tiles per KV head.\"\"\"\n+    kv_head_num = triton.cdiv(head_num, kv_group_num)\n+    return kv_head_num * triton.cdiv(kv_group_num, _GROUPED_BLOCK_H)\n \n \n def _mla_bucket(batch: int) -> _MlaBucket:\n@@ -596,6 +597,13 @@ def _fwd_grouped_kernel_stage1(\n         VALID_BLOCK_H: tl.constexpr = kv_group_num\n     cur_head = cur_head_id * VALID_BLOCK_H + tl.arange(0, BLOCK_H)\n     mask_h = cur_head < (cur_head_id + 1) * VALID_BLOCK_H\n+    # Each KV head owns whole tiles, so a group that is not a multiple of BLOCK_H\n+    # ends in a partly filled tile: index the heads from the group's start.\n+    if kv_group_num % VALID_BLOCK_H != 0:\n+        tile_in_group = cur_head_id % tl.cdiv(kv_group_num, BLOCK_H)\n+        head_in_group = tile_in_group * BLOCK_H + tl.arange(0, BLOCK_H)\n+        cur_head = cur_kv_head * kv_group_num + head_in_group\n+        mask_h = head_in_group < kv_group_num\n     mask_h = mask_h & (cur_head < q_head_num)\n \n     offs_d = tl.arange(0, BLOCK_DMODEL)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e2e8d99c2f7d75388b5deeb84a126389128bf5af/python%2Fsglang%2Fkernels%2Fops%2Fattention%2Fdecode_attention.py",
      "sha": "4dc6ad8c3fcbd765ae49cb67b6e8e138a586bbc2",
      "status": "modified"
    },
    {
      "additions": 8,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e2e8d99c2f7d75388b5deeb84a126389128bf5af/test%2Fregistered%2Fattention%2Ftest_triton_attention_kernels.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Fattention%2Ftest_triton_attention_kernels.py?ref=e2e8d99c2f7d75388b5deeb84a126389128bf5af",
      "deletions": 0,
      "filename": "test/registered/attention/test_triton_attention_kernels.py",
      "patch": "@@ -842,6 +842,14 @@ def test_decode_attention(self):\n         for B, H_Q, H_KV, D in configs:\n             self._test_decode_attention_once(B, H_Q, H_KV, D)\n \n+    def test_decode_attention_gqa_group_above_tile(self):\n+        \"\"\"Every query head reads its own KV head when a GQA group is wider than\n+        the grouped kernel's 16-head tile, also when it is not a multiple of 16.\"\"\"\n+        # groups of 24 (GLM-4-32B at TP 1) and 20, then 8, 16 and 32\n+        for H_Q, H_KV in ((48, 2), (40, 2), (16, 2), (32, 2), (64, 2)):\n+            with self.subTest(H_Q=H_Q, H_KV=H_KV):\n+                self._test_decode_attention_once(2, H_Q, H_KV, 128)\n+\n     def _test_grouped_decode_attention_once(self, B, S, H_Q, H_KV, D, D_V):\n         dtype = torch.bfloat16\n         device = get_device()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e2e8d99c2f7d75388b5deeb84a126389128bf5af/test%2Fregistered%2Fattention%2Ftest_triton_attention_kernels.py",
      "sha": "d8b4447edbf1e0d57b05a748dbb874bb35e58a77",
      "status": "modified"
    }
