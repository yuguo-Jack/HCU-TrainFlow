  "files": [
    {
      "additions": 6,
      "blob_url": "https://github.com/sgl-project/sglang/blob/126c154e5fe6d34db09bf50401d99f845a3ef8d8/docker%2Frocm.Dockerfile",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/docker%2Frocm.Dockerfile?ref=126c154e5fe6d34db09bf50401d99f845a3ef8d8",
      "deletions": 1,
      "filename": "docker/rocm.Dockerfile",
      "patch": "@@ -696,7 +696,12 @@ PY\n # Build Mooncake\n ENV PATH=$PATH:/usr/local/go/bin\n \n-RUN if [ \"$BUILD_MOONCAKE\" = \"1\" ]; then \\\n+# The rocm/pytorch base images ship the deadsnakes PPA, which nothing in this\n+# build installs from. Drop it so a Launchpad outage (503 on the PPA index)\n+# can't fail `apt update` here, in Mooncake's dependencies.sh, or in any\n+# later apt-get update step.\n+RUN rm -f /etc/apt/sources.list.d/*deadsnakes* && \\\n+    if [ \"$BUILD_MOONCAKE\" = \"1\" ]; then \\\n      apt update && apt install -y zip unzip wget && \\\n      apt install -y gcc make libtool autoconf  librdmacm-dev rdmacm-utils infiniband-diags ibverbs-utils perftest ethtool  libibverbs-dev rdma-core && \\\n      apt install -y openssh-server openmpi-bin openmpi-common libopenmpi-dev && \\",
      "raw_url": "https://github.com/sgl-project/sglang/raw/126c154e5fe6d34db09bf50401d99f845a3ef8d8/docker%2Frocm.Dockerfile",
      "sha": "ba2b126225f29df1c3135e4e4b8250db5d5c50a7",
      "status": "modified"
    }
