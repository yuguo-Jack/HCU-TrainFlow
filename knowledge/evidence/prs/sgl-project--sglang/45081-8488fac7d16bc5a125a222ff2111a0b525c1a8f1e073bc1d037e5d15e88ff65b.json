      "additions": 22,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e1b2c2a88b386dd953c040cad9c68db846aeb711/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fgguf.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fgguf.py?ref=e1b2c2a88b386dd953c040cad9c68db846aeb711",
      "deletions": 3,
      "filename": "python/sglang/srt/layers/quantization/gguf.py",
      "patch": "@@ -12,9 +12,7 @@\n from gguf import GGMLQuantizationType as WeightType\n from torch.nn.parameter import Parameter, UninitializedParameter\n \n-from sglang.srt.hardware_backend.npu.quantization.moe_methods import (\n-    NPUUnquantMoEMethod,\n-)\n+from sglang.srt.hardware_backend.npu.quantization.moe_methods import NPUUnquantMoEMethod\n from sglang.srt.hardware_backend.npu.utils import npu_format_cast\n from sglang.srt.layers.linear import LinearBase\n from sglang.srt.layers.moe.moe_runner import MoeRunner, MoeRunnerConfig\n@@ -189,6 +187,27 @@ def dequantize_gguf_weight(\n     return ggml_dequantize(qweight, qweight_type, *shape, dtype)\n \n \n+def get_gguf_dequantized_weight(\n+    module: torch.nn.Module, dtype: torch.dtype\n+) -> torch.Tensor:\n+    \"\"\"Return a dense weight for a possibly GGUF-quantized module.\n+\n+    GGUF-quantized embedding and lm_head modules hold packed ``qweight`` and\n+    expose no ``.weight``. Speculative decoding hands the target embedding and\n+    output head to the draft model, so the caller needs a dense tensor.\n+    Dequantize once and cache it on the module.\n+    \"\"\"\n+    if hasattr(module, \"weight\"):\n+        return module.weight\n+    cached = getattr(module, \"_gguf_dequantized_weight\", None)\n+    if cached is None:\n+        cached = dequantize_gguf_weight(\n+            module.qweight, module.qweight_type.weight_type, dtype\n+        )\n+        module._gguf_dequantized_weight = cached\n+    return cached\n+\n+\n def fused_mul_mat_gguf(\n     x: torch.Tensor, qweight: torch.Tensor, qweight_type: int\n ) -> torch.Tensor:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/e1b2c2a88b386dd953c040cad9c68db846aeb711/python%2Fsglang%2Fsrt%2Flayers%2Fquantization%2Fgguf.py",
      "sha": "ca8e2b85a3ca9d263c4822fe671305e7cc3d94da",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/e1b2c2a88b386dd953c040cad9c68db846aeb711/python%2Fsglang%2Fsrt%2Fmodels%2Fqwen3_next.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodels%2Fqwen3_next.py?ref=e1b2c2a88b386dd953c040cad9c68db846aeb711",
      "deletions": 10,
      "filename": "python/sglang/srt/models/qwen3_next.py",
      "patch": "@@ -19,14 +19,8 @@\n     AuxHiddenStateAccumulator,\n     AuxHiddenStateList,\n )\n-from sglang.srt.layers.dp_attention import (\n-    is_dp_attention_enabled,\n-)\n-from sglang.srt.layers.layer_boundary import (\n-    append_stages,\n-    declare_attn,\n-    declare_ffn,\n-)\n+from sglang.srt.layers.dp_attention import is_dp_attention_enabled\n+from sglang.srt.layers.layer_boundary import append_stages, declare_attn, declare_ffn\n from sglang.srt.layers.layer_boundary.residual import batch as residual_batch\n from sglang.srt.layers.layernorm import GemmaRMSNorm\n from sglang.srt.layers.linear import (\n@@ -1051,7 +1045,14 @@ def forward(\n         )\n \n     def get_embed_and_head(self):\n-        return self.model.embed_tokens.weight, self.lm_head.weight\n+        from sglang.srt.layers.quantization.gguf import get_gguf_dequantized_weight\n+\n+        return (\n+            get_gguf_dequantized_weight(\n+                self.model.embed_tokens, self.config.torch_dtype\n+            ),\n+            get_gguf_dequantized_weight(self.lm_head, self.config.torch_dtype),\n+        )\n \n     def get_input_embeddings(self) -> nn.Embedding:\n         return self.model.embed_tokens\n@@ -1065,7 +1066,11 @@ def set_embed_and_head(self, embed, head):\n         torch.cuda.synchronize()\n \n     def get_embed(self):\n-        return self.model.embed_tokens.weight\n+        from sglang.srt.layers.quantization.gguf import get_gguf_dequantized_weight\n+\n+        return get_gguf_dequantized_weight(\n+            self.model.embed_tokens, self.config.torch_dtype\n+        )\n \n     def set_embed(self, embed):\n         # NOTE: If draft hidden size != target hidden size, the embed weight cannot be shared for EAGLE3",
