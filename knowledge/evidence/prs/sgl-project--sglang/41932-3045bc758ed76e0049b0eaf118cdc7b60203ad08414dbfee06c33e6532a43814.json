      "deletions": 2,
      "filename": "python/sglang/srt/layers/attention/qsa/sparse_attn.py",
      "patch": "@@ -270,12 +270,15 @@ def _sparse_gqa_chunk_prefill(\n     )\n \n \n-def sparse_gqa_fwd_interface_triton_ck(q, k, v, indices, cu_q, cu_k, kv_lens, scale):\n+def sparse_gqa_fwd_interface_triton_ck(\n+    q, k, v, indices, cu_q, cu_k, kv_lens, scale, *, max_q=None\n+):\n     k, v = k.contiguous(), v.contiguous()\n     total_q, num_q_heads, head_dim = q.shape\n     num_kv_heads = k.shape[1]\n     group_size = num_q_heads // num_kv_heads\n-    max_q = int((cu_q[1:] - cu_q[:-1]).max().item())\n+    if max_q is None:\n+        max_q = int((cu_q[1:] - cu_q[:-1]).max().item())\n     block_m = max(16, triton.next_power_of_2(group_size))\n     block_n, warps, stages = _get_best_config(total_q)\n     out = torch.empty_like(q)",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2a01e90822f4afa6d7d893dcf09dc69f99376e54/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fqsa%2Fsparse_attn.py",
      "sha": "de8f4910ac03c5cea7a2843b2c4c9eefa1a1bda0",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/2a01e90822f4afa6d7d893dcf09dc69f99376e54/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fqwen_sparse_attn_backend.py",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fqwen_sparse_attn_backend.py?ref=2a01e90822f4afa6d7d893dcf09dc69f99376e54",
      "deletions": 3,
      "filename": "python/sglang/srt/layers/attention/qwen_sparse_attn_backend.py",
      "patch": "@@ -1496,9 +1496,7 @@ def forward_extend(\n             )\n             for i in range(len(sequence_lens))\n         ]\n-        sequence_lens_tensor = torch.tensor(\n-            sequence_lens, dtype=torch.int32, device=q.device\n-        )\n+        sequence_lens_tensor = forward_batch.seq_lens\n         cu_seqlens_k = F.pad(sequence_lens_tensor.cumsum(0), (1, 0)).contiguous()\n         output = sparse_gqa_fwd_interface_triton_ck(\n             q.contiguous(),\n@@ -1509,6 +1507,7 @@ def forward_extend(\n             cu_seqlens_k,\n             sequence_lens_tensor,\n             layer.scaling,\n+            max_q=max(extend_lens, default=1),\n         )\n         return self._pad_extend_output(output, num_output_rows)\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/2a01e90822f4afa6d7d893dcf09dc69f99376e54/python%2Fsglang%2Fsrt%2Flayers%2Fattention%2Fqwen_sparse_attn_backend.py",
      "sha": "38dccd992e2ff923bbbc4ea715577fd21c6abf69",
