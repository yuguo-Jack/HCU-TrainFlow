    {
      "additions": 15,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5c0a5200c7bec47192744acc2c3d4abc0470375c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Floader%2Fcomponent_loaders%2Ftransformer_loader.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Floader%2Fcomponent_loaders%2Ftransformer_loader.py?ref=5c0a5200c7bec47192744acc2c3d4abc0470375c",
      "deletions": 6,
      "filename": "python/sglang/multimodal_gen/runtime/loader/component_loaders/transformer_loader.py",
      "patch": "@@ -69,6 +69,18 @@ def _minimax_h3_adaln_cache_key_filter(name: str) -> bool:\n     return \".adaln_proj.linear.\" not in name\n \n \n+def _resolve_minimax_h3_adaln_variant(model_variant: str | None) -> str:\n+    # FastH3 ships a single t2va-distilled partition and rejects an explicit\n+    # --model-variant, so an unset variant must fall back to the default fl2va\n+    # partition used for checkpoint selection.\n+    variant = model_variant or \"fl2va\"\n+    if variant not in (\"fl2va\", \"ref2va\"):\n+        raise ValueError(\n+            \"MiniMax H3 AdaLN cache requires --model-variant fl2va or ref2va\"\n+        )\n+    return variant\n+\n+\n def _default_quantized_attention_backend(\n     quant_spec: TransformerQuantLoadSpec, server_args: ServerArgs\n ) -> AttentionBackendEnum | None:\n@@ -425,14 +437,11 @@ def load_customized(\n                 raise ValueError(\n                     \"--minimax-h3-adaln-cache-path is only supported by MiniMax H3\"\n                 )\n-            if component_server_args.model_variant not in (\"fl2va\", \"ref2va\"):\n-                raise ValueError(\n-                    \"MiniMax H3 AdaLN cache requires --model-variant fl2va or ref2va\"\n-                )\n-            init_params[\"adaln_cache_path\"] = adaln_cache_path\n-            init_params[\"adaln_cache_model_variant\"] = (\n+            variant = _resolve_minimax_h3_adaln_variant(\n                 component_server_args.model_variant\n             )\n+            init_params[\"adaln_cache_path\"] = adaln_cache_path\n+            init_params[\"adaln_cache_model_variant\"] = variant\n             checkpoint_key_filter = _minimax_h3_adaln_cache_key_filter\n         if component_server_args.minimax_h3_adaln_online:\n             if not is_minimax_h3:",
      "raw_url": "https://github.com/sgl-project/sglang/raw/5c0a5200c7bec47192744acc2c3d4abc0470375c/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Floader%2Fcomponent_loaders%2Ftransformer_loader.py",
      "sha": "ce0e53f339e759dbdc15c52aa456ecc897ad38cd",
      "status": "modified"
    },
    {
      "additions": 23,
      "blob_url": "https://github.com/sgl-project/sglang/blob/5c0a5200c7bec47192744acc2c3d4abc0470375c/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_minimax_h3_adaln_cache.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Ftest%2Funit%2Ftest_minimax_h3_adaln_cache.py?ref=5c0a5200c7bec47192744acc2c3d4abc0470375c",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/test/unit/test_minimax_h3_adaln_cache.py",
      "patch": "@@ -14,6 +14,9 @@\n     maybe_init_distributed_environment_and_model_parallel,\n     model_parallel_is_initialized,\n )\n+from sglang.multimodal_gen.runtime.loader.component_loaders.transformer_loader import (\n+    _resolve_minimax_h3_adaln_variant,\n+)\n from sglang.multimodal_gen.runtime.models.dits.minimax_h3_adaln_cache import (\n     MiniMaxH3AdalnCache,\n )\n@@ -564,3 +567,23 @@ def test_weights_updater_rejects_tensor_update_in_online_cache_mode(tmp_path):\n     assert not ok\n     assert \"update_weights_from_disk\" in message\n     assert torch.equal(model.probe, torch.zeros(2))\n+\n+\n+def test_adaln_variant_defaults_to_fl2va_when_unset():\n+    \"\"\"FastH3 rejects --model-variant, so an unset variant must still resolve.\n+\n+    FastH3PipelineConfig forbids passing --model-variant while the sidecar\n+    branch used to require one explicitly, deadlocking the only supported\n+    FastH3 + AdaLN cache path.\n+    \"\"\"\n+    assert _resolve_minimax_h3_adaln_variant(None) == \"fl2va\"\n+\n+\n+@pytest.mark.parametrize(\"variant\", [\"fl2va\", \"ref2va\"])\n+def test_adaln_variant_passes_through_supported_values(variant):\n+    assert _resolve_minimax_h3_adaln_variant(variant) == variant\n+\n+\n+def test_adaln_variant_rejects_unsupported_value():\n+    with pytest.raises(ValueError, match=\"fl2va or ref2va\"):\n+        _resolve_minimax_h3_adaln_variant(\"t2va\")",
