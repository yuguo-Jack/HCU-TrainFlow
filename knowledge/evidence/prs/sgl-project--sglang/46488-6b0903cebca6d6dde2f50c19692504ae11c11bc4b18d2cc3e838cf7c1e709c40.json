  "files": [
    {
      "additions": 1,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad972633b7d64f8af1c62d87faaae915c581b96a/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fqwen_vl.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fqwen_vl.py?ref=ad972633b7d64f8af1c62d87faaae915c581b96a",
      "deletions": 1,
      "filename": "python/sglang/srt/multimodal/processors/qwen_vl.py",
      "patch": "@@ -261,7 +261,7 @@ async def preprocess_video(\n     nframes = smart_nframes(\n         video_config, total_frames=total_frames, video_fps=video_fps\n     )\n-    idx = np.linspace(0, total_frames - 1, num=nframes, dtype=np.int64)\n+    idx = np.rint(np.linspace(0, total_frames - 1, num=nframes)).astype(np.int64)\n     idx = np.unique(idx)\n \n     video = vr.get_frames_as_tensor(idx.tolist())",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad972633b7d64f8af1c62d87faaae915c581b96a/python%2Fsglang%2Fsrt%2Fmultimodal%2Fprocessors%2Fqwen_vl.py",
      "sha": "1f4c0700a169300b373ae1db31a9e52b98bef043",
      "status": "modified"
    },
    {
      "additions": 60,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad972633b7d64f8af1c62d87faaae915c581b96a/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_qwen_vl_frame_indices.py",
      "changes": 60,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_qwen_vl_frame_indices.py?ref=ad972633b7d64f8af1c62d87faaae915c581b96a",
      "deletions": 0,
      "filename": "test/registered/unit/multimodal/test_qwen_vl_frame_indices.py",
      "patch": "@@ -0,0 +1,60 @@\n+\"\"\"Unit tests for video frame-index sampling in qwen_vl ``preprocess_video``.\n+\n+Frame indices must be rounded (not truncated) so the sampled frames match\n+qwen-vl-utils, which uses ``torch.linspace(...).round().long()``.\n+\"\"\"\n+\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+import asyncio\n+import unittest\n+from unittest.mock import MagicMock, patch\n+\n+import torch\n+\n+from sglang.srt.multimodal.processors.qwen_vl import preprocess_video\n+from sglang.srt.utils.video_decoder import VideoDecoderWrapper\n+from sglang.test.test_utils import CustomTestCase\n+\n+\n+def _fake_video(total_frames, fps=2.0):\n+    vr = MagicMock(spec=VideoDecoderWrapper)\n+    vr.__len__.return_value = total_frames\n+    vr.avg_fps = fps\n+    vr.get_frames_as_tensor.side_effect = lambda idx: torch.zeros(\n+        len(idx), 28, 28, 3, dtype=torch.uint8\n+    )\n+    return vr\n+\n+\n+class TestQwenVLFrameIndices(CustomTestCase):\n+    def _sampled_indices(self, total_frames, nframes):\n+        vr = _fake_video(total_frames)\n+        # is_cpu=True skips pin_memory, which needs CUDA.\n+        with patch(\n+            \"sglang.srt.multimodal.processors.qwen_vl.is_cpu\", return_value=True\n+        ):\n+            _, metadata = asyncio.run(\n+                preprocess_video(vr, video_config={\"nframes\": nframes})\n+            )\n+        requested = vr.get_frames_as_tensor.call_args.args[0]\n+        self.assertEqual(requested, metadata[\"frames_indices\"].tolist())\n+        return requested\n+\n+    def test_indices_are_rounded(self):\n+        # linspace(0, 11, 4) = [0, 3.67, 7.33, 11]; truncation would give 3 for 3.67.\n+        self.assertEqual(self._sampled_indices(12, 4), [0, 4, 7, 11])\n+\n+    def test_matches_qwen_vl_utils(self):\n+        for total_frames, nframes in [(12, 4), (100, 6), (37, 8), (301, 16)]:\n+            with self.subTest(total_frames=total_frames, nframes=nframes):\n+                expected = (\n+                    torch.linspace(0, total_frames - 1, nframes).round().long()\n+                ).tolist()\n+                self.assertEqual(self._sampled_indices(total_frames, nframes), expected)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad972633b7d64f8af1c62d87faaae915c581b96a/test%2Fregistered%2Funit%2Fmultimodal%2Ftest_qwen_vl_frame_indices.py",
      "sha": "562ac22392cf8429198b37c086fdc743f4f02bd8",
      "status": "added"
    }
  ],
