    },
    {
      "additions": 37,
      "blob_url": "https://github.com/sgl-project/sglang/blob/642d5e17a7c8e60890e4f7013b86bf95d66f1b0a/test%2Fregistered%2Funit%2Fconstrained%2Ftest_xgrammar_backend.py",
      "changes": 37,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fconstrained%2Ftest_xgrammar_backend.py?ref=642d5e17a7c8e60890e4f7013b86bf95d66f1b0a",
      "deletions": 0,
      "filename": "test/registered/unit/constrained/test_xgrammar_backend.py",
      "patch": "@@ -0,0 +1,37 @@\n+import unittest\n+\n+from xgrammar import TokenizerInfo\n+\n+from sglang.srt.constrained.xgrammar_backend import XGrammarGrammarBackend\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+_VOCAB = [chr(c) for c in range(32, 127)]\n+_SCHEMA = (\n+    '{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"},'\n+    '\"b\":{\"type\":\"array\",\"items\":{\"type\":\"integer\"}}},\"required\":[\"a\",\"b\"]}'\n+)\n+\n+\n+class _CharTokenizer:\n+    def init_xgrammar(self):\n+        return TokenizerInfo(_VOCAB), None\n+\n+\n+class TestXGrammarJsonWhitespace(CustomTestCase):\n+    def _accepts(self, text: str, *, any_whitespace: bool) -> bool:\n+        backend = XGrammarGrammarBackend(\n+            _CharTokenizer(), vocab_size=len(_VOCAB), any_whitespace=any_whitespace\n+        )\n+        return backend.dispatch_json(_SCHEMA).matcher.accept_string(text)\n+\n+    def test_disable_any_whitespace_constrains_to_compact_json(self):\n+        \"\"\"--constrained-json-disable-any-whitespace must produce compact JSON.\"\"\"\n+        self.assertTrue(self._accepts('{\"a\":1,\"b\":[2,3]}', any_whitespace=False))\n+        self.assertFalse(self._accepts('{\"a\": 1, \"b\": [2, 3]}', any_whitespace=False))\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/642d5e17a7c8e60890e4f7013b86bf95d66f1b0a/test%2Fregistered%2Funit%2Fconstrained%2Ftest_xgrammar_backend.py",
      "sha": "e4484b94668e2d00f8eff6c90ff4dc361df84653",
      "status": "added"
    }
  ],
