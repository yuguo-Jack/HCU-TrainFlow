      "filename": "python/sglang/srt/constrained/xgrammar_backend.py",
      "patch": "@@ -394,6 +394,7 @@ def dispatch_json(self, key_string: str) -> BaseGrammarObject:\n                 ctx = self.grammar_compiler.compile_json_schema(\n                     schema=key_string,\n                     any_whitespace=self.any_whitespace,\n+                    separators=None if self.any_whitespace else (\",\", \":\"),\n                     max_whitespace_cnt=self.max_whitespace_cnt,\n                 )\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/642d5e17a7c8e60890e4f7013b86bf95d66f1b0a/python%2Fsglang%2Fsrt%2Fconstrained%2Fxgrammar_backend.py",
