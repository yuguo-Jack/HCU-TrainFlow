    {
      "additions": 21,
      "blob_url": "https://github.com/sgl-project/sglang/blob/951cf6385ca95a028ddb025388ada4b2889ffb7b/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fprofiler_manager.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fprofiler_manager.py?ref=951cf6385ca95a028ddb025388ada4b2889ffb7b",
      "deletions": 8,
      "filename": "python/sglang/srt/managers/scheduler_components/profiler_manager.py",
      "patch": "@@ -143,20 +143,27 @@ def _init_profile(\n         if start_step:\n             self.profiler_start_forward_ct = max(start_step, self.get_forward_ct() + 1)\n \n-        if num_steps:\n-            if self.profile_by_stage:\n-                self.profiler_prefill_ct = 0\n-                self.profiler_decode_ct = 0\n+        if self.profile_by_stage:\n+            # Counters must exist even when num_steps is omitted. Otherwise\n+            # the first prefill does None += 1 and kills every scheduler.\n+            self.profiler_prefill_ct = 0\n+            self.profiler_decode_ct = 0\n+            if num_steps:\n                 self.profiler_target_prefill_ct = num_steps\n                 self.profiler_target_decode_ct = num_steps\n-            elif start_step:\n+            else:\n+                self.profiler_target_prefill_ct = None\n+                self.profiler_target_decode_ct = None\n+\n+        if num_steps and not self.profile_by_stage:\n+            if start_step:\n                 self.profiler_target_forward_ct = (\n                     self.profiler_start_forward_ct + num_steps\n                 )\n             else:\n                 self.profiler_target_forward_ct = self.get_forward_ct() + num_steps + 1\n             # The caller will be notified when reaching profiler_target_forward_ct\n-        else:\n+        elif not self.profile_by_stage:\n             self.profiler_target_forward_ct = None\n \n         return ProfileReqOutput(success=True, message=\"Succeeded\")\n@@ -420,7 +427,10 @@ def _profile_batch_predicate(self, batch: ScheduleBatch):\n                 if self.profiler_prefill_ct == 0:\n                     self._start_profile(batch.forward_mode)\n                 self.profiler_prefill_ct += 1\n-                if self.profiler_prefill_ct > self.profiler_target_prefill_ct:\n+                if (\n+                    self.profiler_target_prefill_ct is not None\n+                    and self.profiler_prefill_ct > self.profiler_target_prefill_ct\n+                ):\n                     if self.profile_in_progress:\n                         self._stop_profile(stage=ForwardMode.EXTEND)\n             elif batch.forward_mode.is_decode():\n@@ -434,7 +444,10 @@ def _profile_batch_predicate(self, batch: ScheduleBatch):\n                         return\n                     self._start_profile(batch.forward_mode)\n                 self.profiler_decode_ct += 1\n-                if self.profiler_decode_ct > self.profiler_target_decode_ct:\n+                if (\n+                    self.profiler_target_decode_ct is not None\n+                    and self.profiler_decode_ct > self.profiler_target_decode_ct\n+                ):\n                     if self.profile_in_progress:\n                         self._stop_profile(stage=ForwardMode.DECODE)\n             elif batch.forward_mode.is_idle() or batch.forward_mode.is_prebuilt():",
      "raw_url": "https://github.com/sgl-project/sglang/raw/951cf6385ca95a028ddb025388ada4b2889ffb7b/python%2Fsglang%2Fsrt%2Fmanagers%2Fscheduler_components%2Fprofiler_manager.py",
      "sha": "5e4329f2494130c4b04caaa2364dbf343423498c",
      "status": "modified"
    },
    {
      "additions": 66,
      "blob_url": "https://github.com/sgl-project/sglang/blob/951cf6385ca95a028ddb025388ada4b2889ffb7b/test%2Fregistered%2Funit%2Fmanagers%2Ftest_profile_by_stage_without_steps.py",
      "changes": 66,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fmanagers%2Ftest_profile_by_stage_without_steps.py?ref=951cf6385ca95a028ddb025388ada4b2889ffb7b",
      "deletions": 0,
      "filename": "test/registered/unit/managers/test_profile_by_stage_without_steps.py",
      "patch": "@@ -0,0 +1,66 @@\n+\"\"\"profile_by_stage without num_steps must not crash the scheduler.\"\"\"\n+\n+import unittest\n+from types import SimpleNamespace\n+\n+from sglang.srt.managers.scheduler_components.profiler_manager import (\n+    SchedulerProfilerManager,\n+)\n+from sglang.test.ci.ci_register import register_cpu_ci\n+from sglang.test.test_utils import CustomTestCase\n+\n+register_cpu_ci(est_time=5, suite=\"base-a-test-cpu\")\n+\n+\n+def _prefill_batch():\n+    return SimpleNamespace(\n+        forward_mode=SimpleNamespace(\n+            is_prefill=lambda: True,\n+            is_decode=lambda: False,\n+            is_idle=lambda: False,\n+            is_prebuilt=lambda: False,\n+        )\n+    )\n+\n+\n+class TestProfileByStageWithoutNumSteps(CustomTestCase):\n+    def test_omitted_num_steps_counts_prefill_without_raising(self):\n+        manager = SchedulerProfilerManager.__new__(SchedulerProfilerManager)\n+        manager.profile_in_progress = False\n+        manager.profile_by_stage = False\n+        manager.get_forward_ct = lambda: 0\n+        manager.profiler_start_forward_ct = None\n+        manager.profiler_target_forward_ct = None\n+        manager.profiler_prefill_ct = None\n+        manager.profiler_decode_ct = None\n+        manager.profiler_target_prefill_ct = None\n+        manager.profiler_target_decode_ct = None\n+        manager.merge_profiles = False\n+        manager.detailed_annotations = False\n+        manager.torch_profiler = None\n+        started = []\n+        manager._start_profile = lambda stage=None: started.append(stage)\n+        manager._stop_profile = lambda stage=None: None\n+\n+        result = SchedulerProfilerManager._init_profile(\n+            manager,\n+            \"/tmp\",\n+            None,\n+            None,\n+            [\"CPU\"],\n+            False,\n+            False,\n+            True,\n+            \"id\",\n+        )\n+        self.assertTrue(result.success)\n+        self.assertEqual(manager.profiler_prefill_ct, 0)\n+        self.assertIsNone(manager.profiler_target_prefill_ct)\n+\n+        SchedulerProfilerManager._profile_batch_predicate(manager, _prefill_batch())\n+        self.assertEqual(manager.profiler_prefill_ct, 1)\n+        self.assertEqual(len(started), 1)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/951cf6385ca95a028ddb025388ada4b2889ffb7b/test%2Fregistered%2Funit%2Fmanagers%2Ftest_profile_by_stage_without_steps.py",
      "sha": "c6eb6c5b3e8413d4b4f2af8be97ab9e6752876cd",
      "status": "added"
    }
  ],
