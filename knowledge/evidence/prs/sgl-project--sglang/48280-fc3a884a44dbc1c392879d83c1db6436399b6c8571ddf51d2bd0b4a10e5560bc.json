      "changes": 24,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fconstrained%2Ftest_reasoner_grammar_backend.py?ref=f6e8079db678cd0dd7473517610258ba0358d8a7",
      "deletions": 0,
      "filename": "test/registered/unit/constrained/test_reasoner_grammar_backend.py",
      "patch": "@@ -878,5 +878,29 @@ def test_dedup_guard_skips_reaccept_after_generation(self):\n         inner_grammar.accept_token.assert_not_called()\n \n \n+class TestTokenSequenceMatcher(CustomTestCase):\n+    def test_advance_after_full_match_with_overlapping_pattern(self):\n+        from sglang.srt.utils.token_sequence_matcher import TokenSequenceMatcher\n+\n+        matcher = TokenSequenceMatcher([1, 2, 1])\n+        states = []\n+        matched = 0\n+        for token in (1, 2, 1, 2, 1, 9, 1, 2, 1):\n+            matched = matcher.advance(matched, token)\n+            states.append(matched)\n+        self.assertEqual(states, [1, 2, 3, 2, 3, 0, 1, 2, 3])\n+\n+    def test_advance_after_full_match_single_token_pattern(self):\n+        from sglang.srt.utils.token_sequence_matcher import TokenSequenceMatcher\n+\n+        matcher = TokenSequenceMatcher([7])\n+        states = []\n+        matched = 0\n+        for token in (7, 7, 8, 7):\n+            matched = matcher.advance(matched, token)\n+            states.append(matched)\n+        self.assertEqual(states, [1, 1, 0, 1])\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/f6e8079db678cd0dd7473517610258ba0358d8a7/test%2Fregistered%2Funit%2Fconstrained%2Ftest_reasoner_grammar_backend.py",
