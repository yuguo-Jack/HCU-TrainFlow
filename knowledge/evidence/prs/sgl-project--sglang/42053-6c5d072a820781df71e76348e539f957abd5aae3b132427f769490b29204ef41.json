      "additions": 12,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad35d65bdd7197653478bc7a49956240c5b213e5/python%2Fsglang%2Fsrt%2Ffunction_call%2Fdots_detector.py",
      "changes": 12,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fdots_detector.py?ref=ad35d65bdd7197653478bc7a49956240c5b213e5",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/dots_detector.py",
      "patch": "@@ -353,3 +353,15 @@ def structure_info(self) -> _GetInfoFunc:\n             end=f\"}}{self.eot_token}\",\n             trigger=self.bot_token,\n         )\n+\n+    def finish(self, tools):\n+        normal = \"\"\n+        if self._buffer:\n+            leftover = self._buffer\n+            if leftover.strip() == self.eot_token:\n+                # A trailing closing tag is syntax residue, not user text.\n+                self._buffer = \"\"\n+            else:\n+                normal = leftover\n+                self._buffer = \"\"\n+        return StreamingParseResult(normal_text=normal, calls=[])",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad35d65bdd7197653478bc7a49956240c5b213e5/python%2Fsglang%2Fsrt%2Ffunction_call%2Fdots_detector.py",
      "sha": "0559cc8c7a4d812bce15fb5b909b34e60509b48d",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad35d65bdd7197653478bc7a49956240c5b213e5/python%2Fsglang%2Fsrt%2Ffunction_call%2Fllama32_detector.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Ffunction_call%2Fllama32_detector.py?ref=ad35d65bdd7197653478bc7a49956240c5b213e5",
      "deletions": 0,
      "filename": "python/sglang/srt/function_call/llama32_detector.py",
      "patch": "@@ -142,3 +142,10 @@ def structure_info(self) -> _GetInfoFunc:\n             end=\"}\",\n             trigger=\"<|python_tag|>\",\n         )\n+\n+    def finish(self, tools):\n+        normal = \"\"\n+        if self._buffer:\n+            normal = self._buffer\n+            self._buffer = \"\"\n+        return StreamingParseResult(normal_text=normal, calls=[])",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad35d65bdd7197653478bc7a49956240c5b213e5/python%2Fsglang%2Fsrt%2Ffunction_call%2Fllama32_detector.py",
      "sha": "2b25584b0feda747a998d5f68988804d2756e2d4",
      "status": "modified"
    },
    {
      "additions": 68,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad35d65bdd7197653478bc7a49956240c5b213e5/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_dots_detector_finish.py",
      "changes": 68,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_dots_detector_finish.py?ref=ad35d65bdd7197653478bc7a49956240c5b213e5",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_dots_detector_finish.py",
      "patch": "@@ -0,0 +1,68 @@\n+\"\"\"Unit tests for DotsToolDetector finish() flush - no server, no model loading.\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.entrypoints.openai.protocol import Tool\n+from sglang.srt.function_call.dots_detector import DotsToolDetector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n+\n+LT = chr(60)  # <\n+GT = chr(62)  # >\n+\n+TOOL = Tool(\n+    type=\"function\",\n+    function={\n+        \"name\": \"get_weather\",\n+        \"description\": \"x\",\n+        \"parameters\": {\"type\": \"object\", \"properties\": {\"city\": {\"type\": \"string\"}}},\n+    },\n+)\n+\n+\n+class TestDotsToolDetectorFinishFlush(unittest.TestCase):\n+    def setUp(self):\n+        self.d = DotsToolDetector()\n+\n+    def test_partial_tool_call_at_end_is_flushed(self):\n+        feed = \"hi \" + self.d.bot_token + \"get_weather(city='P\"\n+        self.d.parse_streaming_increment(feed, tools=[TOOL])\n+        self.assertNotEqual(self.d._buffer, \"\")\n+        r = self.d.finish([TOOL])\n+        self.assertNotEqual(r.normal_text, \"\")\n+\n+    def test_clean_stream_finish_is_noop(self):\n+        self.d.parse_streaming_increment(\"just some text\", tools=[TOOL])\n+        r = self.d.finish([TOOL])\n+        self.assertEqual(r.normal_text, \"\")\n+        self.assertEqual(len(r.calls), 0)\n+\n+    def test_complete_call_not_duplicated_at_finish(self):\n+        full = (\n+            self.d.bot_token\n+            + LT\n+            + 'invoke name=\"get_weather\"'\n+            + GT\n+            + LT\n+            + 'parameter name=\"city\"'\n+            + GT\n+            + \"Paris\"\n+            + LT\n+            + \"/parameter\"\n+            + GT\n+            + LT\n+            + \"/invoke\"\n+            + GT\n+            + self.d.eot_token\n+        )\n+        self.d.parse_streaming_increment(full, tools=[TOOL])\n+        # The state machine may leave the closing tag until the next parse;\n+        # finish() must not release it as user text.\n+        r = self.d.finish([TOOL])\n+        self.assertEqual(r.normal_text, \"\")\n+        self.assertEqual(self.d._buffer, \"\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad35d65bdd7197653478bc7a49956240c5b213e5/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_dots_detector_finish.py",
      "sha": "02c36ed9b3024437dc45a0813dc62025515aa323",
      "status": "added"
    },
    {
      "additions": 50,
      "blob_url": "https://github.com/sgl-project/sglang/blob/ad35d65bdd7197653478bc7a49956240c5b213e5/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_llama32_detector_finish.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_llama32_detector_finish.py?ref=ad35d65bdd7197653478bc7a49956240c5b213e5",
      "deletions": 0,
      "filename": "test/registered/unit/function_call/test_llama32_detector_finish.py",
      "patch": "@@ -0,0 +1,50 @@\n+\"\"\"Unit tests for Llama32Detector finish() flush - no server, no model loading.\"\"\"\n+\n+import unittest\n+\n+from sglang.srt.entrypoints.openai.protocol import Tool\n+from sglang.srt.function_call.llama32_detector import Llama32Detector\n+from sglang.test.ci.ci_register import register_cpu_ci\n+\n+register_cpu_ci(est_time=10, suite=\"base-a-test-cpu\")\n+\n+TOOL = Tool(\n+    type=\"function\",\n+    function={\n+        \"name\": \"get_weather\",\n+        \"description\": \"x\",\n+        \"parameters\": {\"type\": \"object\", \"properties\": {\"city\": {\"type\": \"string\"}}},\n+    },\n+)\n+\n+\n+class TestLlama32DetectorFinishFlush(unittest.TestCase):\n+    def setUp(self):\n+        self.d = Llama32Detector()\n+\n+    def test_partial_tool_call_at_end_is_flushed(self):\n+        feed = \"hi \" + self.d.bot_token + \"get_weather(city='P\"\n+        self.d.parse_streaming_increment(feed, tools=[TOOL])\n+        self.assertNotEqual(self.d._buffer, \"\")\n+        r = self.d.finish([TOOL])\n+        self.assertNotEqual(r.normal_text, \"\")\n+\n+    def test_clean_stream_finish_is_noop(self):\n+        self.d.parse_streaming_increment(\"just some text\", tools=[TOOL])\n+        r = self.d.finish([TOOL])\n+        self.assertEqual(r.normal_text, \"\")\n+        self.assertEqual(len(r.calls), 0)\n+\n+    def test_complete_call_not_duplicated_at_finish(self):\n+        full = self.d.bot_token + \"get_weather(city='Paris')\"\n+        self.d.parse_streaming_increment(full, tools=[TOOL])\n+        # The llama-3.2 format keeps the python block buffered until it can\n+        # resolve the call; at end of stream finish() flushes it instead of\n+        # silently dropping it.\n+        r = self.d.finish([TOOL])\n+        self.assertIn(\"get_weather\", r.normal_text)\n+        self.assertEqual(self.d._buffer, \"\")\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ad35d65bdd7197653478bc7a49956240c5b213e5/test%2Fregistered%2Funit%2Ffunction_call%2Ftest_llama32_detector_finish.py",
      "sha": "a8177467e62c175bee78f769975c63b90286e102",
      "status": "added"
    }
