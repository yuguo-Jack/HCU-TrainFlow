    {
      "additions": 41,
      "blob_url": "https://github.com/sgl-project/sglang/blob/52a08a8ab3af789d4b8bd018803564048aa8cb09/test%2Fregistered%2Funit%2Fbench%2Ftest_bench_serving_prompt_len.py",
      "changes": 41,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fbench%2Ftest_bench_serving_prompt_len.py?ref=52a08a8ab3af789d4b8bd018803564048aa8cb09",
      "deletions": 0,
      "filename": "test/registered/unit/bench/test_bench_serving_prompt_len.py",
      "patch": "@@ -88,6 +88,7 @@ def _run(self, request_func, prompt, prompt_tokens, stream=True, extra=None):\n         outputs = out if isinstance(out, list) else [out]\n         for o in outputs:\n             self.assertTrue(o.success, o.error)\n+            self.assertEqual(o.generated_text, \"hi\")\n         return [o.prompt_len for o in outputs]\n \n     def test_single_request(self):\n@@ -108,6 +109,23 @@ def test_single_request(self):\n                 )\n                 self.assertEqual(lens, [expected])\n \n+    def test_single_request_honors_stream_override(self):\n+        cases = [\n+            (True, {\"stream\": False}),\n+            (False, {\"stream\": True, \"stream_options\": {\"include_usage\": True}}),\n+        ]\n+        for stream, extra in cases:\n+            with self.subTest(stream=stream, extra=extra):\n+                lens = self._run(\n+                    async_request_openai_chat_completions,\n+                    \"hello\",\n+                    [123],\n+                    stream=stream,\n+                    extra=extra,\n+                )\n+                self.assertEqual(lens, [123])\n+                self.assertEqual(self.server.bodies[0][\"stream\"], extra[\"stream\"])\n+\n     def test_multi_turn_requests_usage_per_round(self):\n         per_round = [100, 250, 400]\n         multi_turn = wrap_multi_turn_request_func(\n@@ -134,6 +152,29 @@ def test_multi_turn_requests_usage_per_round(self):\n                     [b[\"stream_options\"] for b in self.server.bodies], [sent] * 3\n                 )\n \n+    def test_multi_turn_usage_follows_stream_override(self):\n+        multi_turn = wrap_multi_turn_request_func(\n+            async_request_openai_chat_completions, backend=\"sglang-oai-chat\"\n+        )\n+        per_round = [100, 250]\n+        for stream in (True, False):\n+            extra = {\"stream\": not stream}\n+            with self.subTest(stream=stream):\n+                lens = self._run(\n+                    multi_turn,\n+                    [\"one\", \"two\"],\n+                    per_round,\n+                    stream=stream,\n+                    extra=extra,\n+                )\n+                self.assertEqual(lens, per_round)\n+                expected_options = None if stream else {\"include_usage\": True}\n+                self.assertEqual(\n+                    [b.get(\"stream_options\") for b in self.server.bodies],\n+                    [expected_options] * 2,\n+                )\n+                self.assertEqual(extra, {\"stream\": not stream})\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/52a08a8ab3af789d4b8bd018803564048aa8cb09/test%2Fregistered%2Funit%2Fbench%2Ftest_bench_serving_prompt_len.py",
