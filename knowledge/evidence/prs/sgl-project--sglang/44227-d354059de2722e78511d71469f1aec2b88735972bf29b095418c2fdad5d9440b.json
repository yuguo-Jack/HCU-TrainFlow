      "deletions": 3,
      "filename": "python/sglang/benchmark/serving.py",
      "patch": "@@ -497,7 +497,7 @@ async def async_request_openai_chat_completions(\n                 url=api_url, json=payload, headers=headers\n             ) as response:\n                 if response.status == 200:\n-                    if args.disable_stream:\n+                    if not payload[\"stream\"]:\n                         # Non-streaming response\n                         response_json = await response.json()\n                         message = response_json[\"choices\"][0][\"message\"]\n@@ -1355,8 +1355,8 @@ async def f(\n             # which a streamed response only carries when asked for. Default the\n             # key rather than the object, so a user's stream_options still gets\n             # it, while an explicit include_usage=false is kept.\n-            if not args.disable_stream:\n-                body = inner_input.extra_request_body\n+            body = inner_input.extra_request_body\n+            if body.get(\"stream\", not args.disable_stream):\n                 options = body.get(\"stream_options\") or {}\n                 options.setdefault(\"include_usage\", True)\n                 body[\"stream_options\"] = options",
      "raw_url": "https://github.com/sgl-project/sglang/raw/52a08a8ab3af789d4b8bd018803564048aa8cb09/python%2Fsglang%2Fbenchmark%2Fserving.py",
      "sha": "be20c19958795444e361dcf8d111b05138916e82",
