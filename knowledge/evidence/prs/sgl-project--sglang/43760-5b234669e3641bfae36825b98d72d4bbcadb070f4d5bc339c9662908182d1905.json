      "changes": 5,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner.py?ref=38cb2ab0b6fdf5b0f02d2c1bac374c4a8e50b0b9",
      "deletions": 0,
      "filename": "python/sglang/srt/model_executor/model_runner.py",
      "patch": "@@ -1155,6 +1155,11 @@ def init_cuda_graphs(self, capture_decode_cuda_graph: bool = True):\n         self.eager_runner = capture.eager_runner\n         self.prefill_cuda_graph_runner = capture.prefill.runner\n         self.decode_cuda_graph_runner = capture.decode.runner\n+        # Reuse startup decode graphs on a subsequent PD role switch.\n+        self.decode_cuda_graph_captured = self.decode_cuda_graph_runner is not None\n+        self.decode_cuda_graph_capture_bs = list(\n+            getattr(self.decode_cuda_graph_runner, \"capture_bs\", []) or []\n+        )\n         self.graph_memory_usage = capture.memory_usage\n         self.graph_time_usage = capture.time_usage\n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/38cb2ab0b6fdf5b0f02d2c1bac374c4a8e50b0b9/python%2Fsglang%2Fsrt%2Fmodel_executor%2Fmodel_runner.py",
      "sha": "52f0055382e49970e065d1e9fadac0d493b76af9",
      "status": "modified"
    },
    {
      "additions": 42,
      "blob_url": "https://github.com/sgl-project/sglang/blob/38cb2ab0b6fdf5b0f02d2c1bac374c4a8e50b0b9/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_pd_role_switch.py",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_pd_role_switch.py?ref=38cb2ab0b6fdf5b0f02d2c1bac374c4a8e50b0b9",
      "deletions": 0,
      "filename": "test/registered/unit/disaggregation/test_pd_role_switch.py",
      "patch": "@@ -597,5 +597,47 @@ def test_teardown_invokes_release(self):\n         s.tree_cache.reset.assert_called_once_with()\n \n \n+class TestStartupDecodeGraphReuse(unittest.TestCase):\n+    def test_switch_reuses_startup_graph_or_captures_when_missing(self):\n+        from sglang.srt.managers.tp_worker import TpModelWorker\n+        from sglang.srt.model_executor import model_runner as mr\n+\n+        for graph in (SimpleNamespace(capture_bs=[1, 2, 4]), None):\n+            with self.subTest(captured_at_startup=graph is not None):\n+                rc.reset_context()\n+                try:\n+                    rc.get_context().set_server_args(ServerArgs(model_path=\"dummy\"))\n+                    runner = mr.ModelRunner.__new__(mr.ModelRunner)\n+                    runner.model = MagicMock()\n+                    runner.decode_cuda_graph_captured = False\n+                    runner.decode_cuda_graph_capture_bs = []\n+                    runner.init_decode_cuda_graph = MagicMock()\n+                    capture = SimpleNamespace(\n+                        eager_runner=MagicMock(),\n+                        prefill=SimpleNamespace(runner=None),\n+                        decode=SimpleNamespace(runner=graph),\n+                        memory_usage=None,\n+                        time_usage=None,\n+                    )\n+                    with (\n+                        patch.object(mr, \"capture_cuda_graphs\", return_value=capture),\n+                        patch.object(mr, \"prebuild_deepep_v2_buffer\"),\n+                    ):\n+                        runner.init_cuda_graphs()\n+                    worker = SimpleNamespace(model_runner=runner)\n+                    self.assertEqual(\n+                        TpModelWorker.get_decode_cuda_graph_bs(worker),\n+                        [1, 2, 4] if graph is not None else [],\n+                    )\n+                    runner.ensure_decode_cuda_graphs()\n+                    if graph is not None:\n+                        runner.init_decode_cuda_graph.assert_not_called()\n+                        self.assertIs(runner.decode_cuda_graph_runner, graph)\n+                    else:\n+                        runner.init_decode_cuda_graph.assert_called_once_with()\n+                finally:\n+                    rc.reset_context()\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/38cb2ab0b6fdf5b0f02d2c1bac374c4a8e50b0b9/test%2Fregistered%2Funit%2Fdisaggregation%2Ftest_pd_role_switch.py",
      "sha": "b5b700e9399e53a8bdc0927b8b4de62b1d461b2d",
      "status": "modified"
    }
