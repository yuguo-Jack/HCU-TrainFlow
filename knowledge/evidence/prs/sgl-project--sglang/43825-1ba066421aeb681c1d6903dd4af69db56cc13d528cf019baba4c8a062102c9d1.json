      "deletions": 1,
      "filename": "python/sglang/kernels/ops/sampling/murmur_hash.py",
      "patch": "@@ -9,7 +9,7 @@ def rotl32(x, r: tl.constexpr) -> tl.uint32:\n     rotate left 32-bit integer x by r bits\n     e.g. x = 01110001, r = 2 -> 11000101\n     \"\"\"\n-    x = x.to(tl.uint64)\n+    x = x.to(tl.uint64) & 0xFFFFFFFF\n     return ((x << r) | (x >> (32 - r))) & 0xFFFFFFFF\n \n ",
      "raw_url": "https://github.com/sgl-project/sglang/raw/ebcec6e4a5416066688e6a5eb71af7476cf21ed7/python%2Fsglang%2Fkernels%2Fops%2Fsampling%2Fmurmur_hash.py",
