    {
      "additions": 10,
      "blob_url": "https://github.com/sgl-project/sglang/blob/48100cb059768ec7f4a9dbb3a50acb15aeb5325d/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py?ref=48100cb059768ec7f4a9dbb3a50acb15aeb5325d",
      "deletions": 0,
      "filename": "python/sglang/srt/utils/common.py",
      "patch": "@@ -1042,6 +1042,16 @@ def is_gfx95_supported():\n         return False\n \n \n+@lru_cache(maxsize=1)\n+def is_gfx1250_supported():\n+    \"\"\"Whether the device is an AMD gfx1250 GPU (MI450 / MI45x).\"\"\"\n+    if torch.version.hip:\n+        gcn_arch = torch.cuda.get_device_properties(0).gcnArchName\n+        return any(gfx in gcn_arch for gfx in [\"gfx1250\"])\n+    else:\n+        return False\n+\n+\n @lru_cache(maxsize=1)\n def is_gfx942_supported():\n     \"\"\"",
      "raw_url": "https://github.com/sgl-project/sglang/raw/48100cb059768ec7f4a9dbb3a50acb15aeb5325d/python%2Fsglang%2Fsrt%2Futils%2Fcommon.py",
