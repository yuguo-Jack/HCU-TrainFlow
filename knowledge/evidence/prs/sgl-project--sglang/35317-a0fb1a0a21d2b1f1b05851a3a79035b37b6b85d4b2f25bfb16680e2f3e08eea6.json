      "additions": 20,
      "blob_url": "https://github.com/sgl-project/sglang/blob/48100cb059768ec7f4a9dbb3a50acb15aeb5325d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fplatforms%2F__init__.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fplatforms%2F__init__.py?ref=48100cb059768ec7f4a9dbb3a50acb15aeb5325d",
      "deletions": 1,
      "filename": "python/sglang/multimodal_gen/runtime/platforms/__init__.py",
      "patch": "@@ -115,7 +115,26 @@ def rocm_platform_plugin() -> str | None:\n         finally:\n             amdsmi.amdsmi_shut_down()\n     except Exception as e:\n-        logger.debug(\"ROCm platform is unavailable: %s\", e)\n+        logger.debug(\"ROCm platform is unavailable via amdsmi: %s\", e)\n+\n+    if not is_rocm:\n+        # amdsmi is optional and absent from some ROCm images; without this,\n+        # detection falls through to CpuPlatform with no error.\n+        try:\n+            import torch\n+\n+            if (\n+                getattr(torch.version, \"hip\", None) is not None\n+                and torch.cuda.is_available()\n+                and torch.cuda.device_count() > 0\n+            ):\n+                is_rocm = True\n+                logger.warning(\n+                    \"ROCm detected via torch, but amdsmi is unavailable. Install \"\n+                    \"amdsmi for full platform introspection.\"\n+                )\n+        except Exception as exc:\n+            logger.debug(\"torch ROCm detection failed: %s\", exc)\n \n     return (\n         \"sglang.multimodal_gen.runtime.platforms.rocm.RocmPlatform\" if is_rocm else None",
      "raw_url": "https://github.com/sgl-project/sglang/raw/48100cb059768ec7f4a9dbb3a50acb15aeb5325d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fplatforms%2F__init__.py",
      "sha": "653b292fc1df80b3e65fa139b68cf58ebfbde44b",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/sgl-project/sglang/blob/48100cb059768ec7f4a9dbb3a50acb15aeb5325d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fplatforms%2Faiter.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/sgl-project/sglang/contents/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fplatforms%2Faiter.py?ref=48100cb059768ec7f4a9dbb3a50acb15aeb5325d",
      "deletions": 0,
      "filename": "python/sglang/multimodal_gen/runtime/platforms/aiter.py",
      "patch": "@@ -2,6 +2,7 @@\n \n from sglang.srt.utils import (\n     get_bool_env_var,\n+    is_gfx1250_supported,\n     is_gfx95_supported,\n     is_gfx942_supported,\n     is_hip,\n@@ -10,3 +11,4 @@\n USE_AITER = get_bool_env_var(\"SGLANG_USE_AITER\") and is_hip()\n USE_AITER_GFX942 = USE_AITER and is_gfx942_supported()\n USE_AITER_GFX95 = USE_AITER and is_gfx95_supported()\n+USE_AITER_GFX1250 = USE_AITER and is_gfx1250_supported()",
      "raw_url": "https://github.com/sgl-project/sglang/raw/48100cb059768ec7f4a9dbb3a50acb15aeb5325d/python%2Fsglang%2Fmultimodal_gen%2Fruntime%2Fplatforms%2Faiter.py",
