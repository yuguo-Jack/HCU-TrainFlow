  "files": [
    {
      "additions": 11,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/fb50a49aff14e8bfb5500c6104970778d17f873a/src%2Fmegatron%2Fbridge%2Ftraining%2Ftokenizers%2Fconfig.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Ftraining%2Ftokenizers%2Fconfig.py?ref=fb50a49aff14e8bfb5500c6104970778d17f873a",
      "deletions": 4,
      "filename": "src/megatron/bridge/training/tokenizers/config.py",
      "patch": "@@ -85,11 +85,18 @@ def __post_init__(self) -> None:\n         # Don't pad vocab size since MBridge does it's own padding\n         self.pad_vocab_size = False\n \n-        # HuggingFace tokenizer kwargs\n-        self.tokenizer_hf_no_use_fast = not self.hf_tokenizer_kwargs.get(\"use_fast\", True)\n-        self.tokenizer_hf_no_include_special_tokens = not self.hf_tokenizer_kwargs.get(\"include_special_tokens\", True)\n-        self.trust_remote_code = self.hf_tokenizer_kwargs.get(\"trust_remote_code\", False)\n+        # HuggingFace tokenizer kwargs. Only a key the deprecated dict actually\n+        # carries overrides the field that replaced it, the way\n+        # _resolve_hf_tokenizer_revision does it. Reading the dict unconditionally\n+        # reset all three fields to their fallbacks on every construction, which is\n+        # the opposite of what the warning below asks for.\n         if self.hf_tokenizer_kwargs:\n+            if \"use_fast\" in self.hf_tokenizer_kwargs:\n+                self.tokenizer_hf_no_use_fast = not self.hf_tokenizer_kwargs[\"use_fast\"]\n+            if \"include_special_tokens\" in self.hf_tokenizer_kwargs:\n+                self.tokenizer_hf_no_include_special_tokens = not self.hf_tokenizer_kwargs[\"include_special_tokens\"]\n+            if \"trust_remote_code\" in self.hf_tokenizer_kwargs:\n+                self.trust_remote_code = self.hf_tokenizer_kwargs[\"trust_remote_code\"]\n             warn_rank_0(\n                 \"`hf_tokenizer_kwargs` is deprecated and will be removed soon. \"\n                 \"Please, use `tokenizer_hf_no_use_fast` / `tokenizer_hf_no_include_special_tokens` / \"",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/fb50a49aff14e8bfb5500c6104970778d17f873a/src%2Fmegatron%2Fbridge%2Ftraining%2Ftokenizers%2Fconfig.py",
      "sha": "c4ca1ec398f79f5d8176225318d63299c6024657",
      "status": "modified"
    },
    {
      "additions": 40,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/fb50a49aff14e8bfb5500c6104970778d17f873a/tests%2Funit_tests%2Ftraining%2Ftest_config.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Ftraining%2Ftest_config.py?ref=fb50a49aff14e8bfb5500c6104970778d17f873a",
      "deletions": 0,
      "filename": "tests/unit_tests/training/test_config.py",
      "patch": "@@ -5241,6 +5241,46 @@ def test_config_success(self):\n         assert config.tokenizer_hf_no_use_fast == (not use_fast)\n         assert config.tokenizer_sentencepiece_legacy == legacy\n \n+    def test_direct_hf_fields_survive_post_init(self):\n+        \"\"\"The fields the deprecation warning points at must not be reset on construction.\"\"\"\n+        config = TokenizerConfig(\n+            tokenizer_type=\"HuggingFaceTokenizer\",\n+            tokenizer_model=\"/path/to/tokenizer\",\n+            trust_remote_code=True,\n+            tokenizer_hf_no_use_fast=True,\n+            tokenizer_hf_no_include_special_tokens=True,\n+        )\n+\n+        assert config.trust_remote_code is True\n+        assert config.tokenizer_hf_no_use_fast is True\n+        assert config.tokenizer_hf_no_include_special_tokens is True\n+\n+    def test_hf_tokenizer_kwargs_still_overrides_the_fields_it_carries(self):\n+        \"\"\"A key the deprecated dict supplies wins; one it omits leaves the field alone.\"\"\"\n+        config = TokenizerConfig(\n+            tokenizer_type=\"HuggingFaceTokenizer\",\n+            tokenizer_model=\"/path/to/tokenizer\",\n+            hf_tokenizer_kwargs={\"use_fast\": False, \"trust_remote_code\": True},\n+            tokenizer_hf_no_use_fast=False,\n+            trust_remote_code=False,\n+            tokenizer_hf_no_include_special_tokens=True,\n+        )\n+\n+        assert config.tokenizer_hf_no_use_fast is True\n+        assert config.trust_remote_code is True\n+        assert config.tokenizer_hf_no_include_special_tokens is True\n+\n+    def test_hf_tokenizer_kwargs_accepts_none(self):\n+        \"\"\"The field is typed as optional, so None must not reach a .get call.\"\"\"\n+        config = TokenizerConfig(\n+            tokenizer_type=\"HuggingFaceTokenizer\",\n+            tokenizer_model=\"/path/to/tokenizer\",\n+            hf_tokenizer_kwargs=None,\n+            trust_remote_code=True,\n+        )\n+\n+        assert config.trust_remote_code is True\n+\n     def test_config_failure(self):\n         tokenizer_model = \"/path/to/tokenizer\"\n         tokenizer_type = \"HuggingFaceTokenizer\"",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/fb50a49aff14e8bfb5500c6104970778d17f873a/tests%2Funit_tests%2Ftraining%2Ftest_config.py",
      "sha": "502725ffd2825e0b5d6f339e25092ea8b1ee1810",
      "status": "modified"
    }
  ],
