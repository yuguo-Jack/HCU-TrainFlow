      "deletions": 1,
      "filename": "src/megatron/bridge/perf_recipes/gpt_oss/b200/gpt_oss.py",
      "patch": "@@ -13,6 +13,7 @@\n # limitations under the License.\n \"\"\"B200 performance recipes for GPT-OSS.\"\"\"\n \n+from megatron.bridge.perf_recipes._common import _enable_ncclep\n from megatron.bridge.perf_recipes.environment import COMMON_PERF_ENV_VARS\n from megatron.bridge.perf_recipes.gpt_oss.common import (\n     ConfigContainer,\n@@ -23,7 +24,7 @@\n \n \n def gpt_oss_120b_pretrain_64gpu_b200_bf16_config() -> ConfigContainer:\n-    \"\"\"GPT-OSS 120B pretrain: 64× B200, BF16, GBS=1280.\"\"\"\n+    \"\"\"GPT-OSS 120B pretrain: 64× B200, BF16, GBS=1280, NCCL EP.\"\"\"\n     cfg = gpt_oss_120b_pretrain_config()\n     cfg.mixed_precision = _perf_precision(\"bf16\")\n     cfg.model.moe_router_fusion = True\n@@ -40,6 +41,9 @@ def gpt_oss_120b_pretrain_64gpu_b200_bf16_config() -> ConfigContainer:\n     cfg.model.recompute_granularity = \"selective\"\n \n     _benchmark_common(cfg)\n+    _enable_ncclep(cfg)\n+    # Grouped tensors ran slower on this eager (no CUDA graph) BF16 recipe, so keep the default grouped MLP path.\n+    cfg.model.moe_use_grouped_tensor = False\n     # Keep process settings next to the recipe so users can see the exact benchmark environment.\n     cfg.env_vars = {\n         **COMMON_PERF_ENV_VARS,\n@@ -51,6 +55,8 @@ def gpt_oss_120b_pretrain_64gpu_b200_bf16_config() -> ConfigContainer:\n         \"TORCH_NCCL_AVOID_RECORD_STREAMS\": 1,\n         # NCCL user-buffer and launch settings.\n         \"NCCL_NVLS_ENABLE\": 0,\n+        # Pull/push mode requires each EP8 group to stay within one NVL8 domain.\n+        \"NCCL_EP_HT_EM_PULL_PUSH\": 1,\n         # Transformer Engine overlap settings for this model.\n         \"NVTE_BWD_LAYERNORM_SM_MARGIN\": 20,\n         \"NVTE_FWD_LAYERNORM_SM_MARGIN\": 20,",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/76b617537455c7e0677e97824db0807ece8b89f8/src%2Fmegatron%2Fbridge%2Fperf_recipes%2Fgpt_oss%2Fb200%2Fgpt_oss.py",
      "sha": "fece7c6ce48171c7375a0b0c11c79de7afb889bd",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/76b617537455c7e0677e97824db0807ece8b89f8/src%2Fmegatron%2Fbridge%2Fperf_recipes%2Fgpt_oss%2Fb300%2Fgpt_oss.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Fperf_recipes%2Fgpt_oss%2Fb300%2Fgpt_oss.py?ref=76b617537455c7e0677e97824db0807ece8b89f8",
      "deletions": 6,
      "filename": "src/megatron/bridge/perf_recipes/gpt_oss/b300/gpt_oss.py",
      "patch": "@@ -13,6 +13,7 @@\n # limitations under the License.\n \"\"\"B300 performance recipes for GPT-OSS.\"\"\"\n \n+from megatron.bridge.perf_recipes._common import _enable_ncclep\n from megatron.bridge.perf_recipes.environment import COMMON_PERF_ENV_VARS\n from megatron.bridge.perf_recipes.gpt_oss.common import (\n     ConfigContainer,\n@@ -221,7 +222,7 @@ def gpt_oss_20b_pretrain_64gpu_b300_fp8mx_config() -> ConfigContainer:\n \n \n def gpt_oss_120b_pretrain_64gpu_b300_bf16_config() -> ConfigContainer:\n-    \"\"\"GPT-OSS 120B pretrain: 64× B300, BF16, GBS=1280.\"\"\"\n+    \"\"\"GPT-OSS 120B pretrain: 64× B300, BF16, GBS=1280, NCCL EP.\"\"\"\n     cfg = gpt_oss_120b_pretrain_config()\n     cfg.mixed_precision = _perf_precision(\"bf16\")\n     cfg.model.moe_router_fusion = True\n@@ -242,6 +243,9 @@ def gpt_oss_120b_pretrain_64gpu_b300_bf16_config() -> ConfigContainer:\n     cfg.model.cuda_graph_scope = [\"attn\", \"moe_router\", \"moe_preprocess\"]\n \n     _benchmark_common(cfg)\n+    _enable_ncclep(cfg)\n+    # Keep per-expert token counts on-device for grouped GEMM.\n+    cfg.model.moe_use_grouped_tensor = True\n     # Keep process settings next to the recipe so users can see the exact benchmark environment.\n     cfg.env_vars = {\n         **COMMON_PERF_ENV_VARS,\n@@ -253,11 +257,8 @@ def gpt_oss_120b_pretrain_64gpu_b300_bf16_config() -> ConfigContainer:\n         \"TORCH_NCCL_AVOID_RECORD_STREAMS\": 1,\n         # NCCL user-buffer and launch settings.\n         \"NCCL_NVLS_ENABLE\": 0,\n-        # HybridEP topology for the target system.\n-        \"NUM_OF_HYBRID_EP_RANKS_PER_NVLINK_DOMAIN\": 8,\n-        \"NUM_OF_TOKENS_PER_CHUNK_COMBINE_API\": 128,\n-        \"NVLINK_DOMAIN_SIZE\": 8,\n-        \"USE_MNNVL\": 0,\n+        # Pull/push mode requires each EP8 group to stay within one NVL8 domain.\n+        \"NCCL_EP_HT_EM_PULL_PUSH\": 1,\n         # Transformer Engine overlap settings for this model.\n         \"NVTE_BWD_LAYERNORM_SM_MARGIN\": 20,\n         \"NVTE_FWD_LAYERNORM_SM_MARGIN\": 20,",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/76b617537455c7e0677e97824db0807ece8b89f8/src%2Fmegatron%2Fbridge%2Fperf_recipes%2Fgpt_oss%2Fb300%2Fgpt_oss.py",
