      "additions": 9,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/aa27147bfea192844ef59b5818a8ff35bfc18588/scripts%2Finference%2Ftext_generation.py",
      "changes": 10,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/scripts%2Finference%2Ftext_generation.py?ref=aa27147bfea192844ef59b5818a8ff35bfc18588",
      "deletions": 1,
      "filename": "scripts/inference/text_generation.py",
      "patch": "@@ -18,6 +18,7 @@\n \n import argparse\n import logging\n+import socket\n import sys\n from pathlib import Path\n \n@@ -29,6 +30,7 @@\n     if _path.exists() and str(_path) not in sys.path:\n         sys.path.append(str(_path))\n \n+import torch\n import torch.distributed as dist\n from megatron.core.inference.apis import MegatronLLM, SamplingParams\n from megatron.core.inference.contexts import StaticInferenceContext\n@@ -151,12 +153,18 @@ def _generate_with_dynamic_engine(\n         return_log_probs=args.return_log_probs,\n         enable_chunked_prefill=args.enable_chunked_prefill,\n     )\n+    coordinator_host = args.coordinator_host\n+    if args.use_coordinator and coordinator_host is None:\n+        # ZMQ binds local interfaces or numeric addresses, not DNS hostnames.\n+        coordinator_host = socket.gethostbyname(socket.gethostname())\n+    # Release unused checkpoint-loading buffers for NCCL communicator allocations.\n+    torch.cuda.empty_cache()\n     with MegatronLLM(\n         model=model,\n         tokenizer=tokenizer,\n         inference_config=inference_config,\n         use_coordinator=args.use_coordinator,\n-        coordinator_host=args.coordinator_host,\n+        coordinator_host=coordinator_host,\n         coordinator_port=args.coordinator_port,\n     ) as llm:\n         if llm.is_primary_rank:",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/aa27147bfea192844ef59b5818a8ff35bfc18588/scripts%2Finference%2Ftext_generation.py",
      "sha": "9431ff3d3b95311c9b98e20b3b7d0d2712a2bb5a",
      "status": "modified"
    },
    {
      "additions": 163,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/aa27147bfea192844ef59b5818a8ff35bfc18588/tests%2Funit_tests%2Fscripts%2Ftest_text_generation_entrypoint.py",
      "changes": 165,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Fscripts%2Ftest_text_generation_entrypoint.py?ref=aa27147bfea192844ef59b5818a8ff35bfc18588",
      "deletions": 2,
      "filename": "tests/unit_tests/scripts/test_text_generation_entrypoint.py",
      "patch": "@@ -17,11 +17,14 @@\n from __future__ import annotations\n \n import importlib.util\n+import socket\n import sys\n import types\n+from collections.abc import Iterator\n from pathlib import Path\n \n import pytest\n+import torch\n \n \n _REPO_ROOT = Path(__file__).resolve().parents[3]\n@@ -46,7 +49,8 @@ def _add_no_args(parser: object) -> object:\n \n \n @pytest.fixture\n-def text_generation_entrypoint(monkeypatch: pytest.MonkeyPatch):\n+def text_generation_entrypoint(monkeypatch: pytest.MonkeyPatch) -> Iterator[types.ModuleType]:\n+    monkeypatch.setattr(torch.cuda, \"empty_cache\", lambda: None)\n     shared_helpers = {\n         \"HFTokenizerAdapter\": _PassthroughInit,\n         \"add_distributed_args\": _add_no_args,\n@@ -114,7 +118,7 @@ def text_generation_entrypoint(monkeypatch: pytest.MonkeyPatch):\n \n \n def _args(**overrides: object) -> types.SimpleNamespace:\n-    values = {\n+    values: dict[str, object] = {\n         \"use_legacy_generation\": True,\n         \"use_coordinator\": False,\n         \"ep\": 1,\n@@ -233,3 +237,160 @@ def generate(self, _prompts: list[str], _sampling_params: object) -> list[types.\n             prompts=[\"Hello world\"],\n             sampling_params=object(),\n         )\n+\n+\n+@pytest.mark.unit\n+@pytest.mark.parametrize(\n+    (\"use_coordinator\", \"explicit_host\", \"expected_host\"),\n+    [\n+        (True, None, \"192.0.2.12\"),\n+        (True, \"192.0.2.20\", \"192.0.2.20\"),\n+        (True, \"explicit.example.test\", \"explicit.example.test\"),\n+        (False, None, None),\n+    ],\n+)\n+def test_dynamic_generation_resolves_default_coordinator_address(\n+    text_generation_entrypoint: types.ModuleType,\n+    monkeypatch: pytest.MonkeyPatch,\n+    use_coordinator: bool,\n+    explicit_host: str | None,\n+    expected_host: str | None,\n+) -> None:\n+    received: dict[str, object] = {}\n+    resolved: list[str] = []\n+\n+    def resolve(host: str) -> str:\n+        resolved.append(host)\n+        return \"192.0.2.12\"\n+\n+    class _WorkerLLM:\n+        is_primary_rank = False\n+\n+        def __init__(self, **kwargs: object) -> None:\n+            received.update(kwargs)\n+\n+        def __enter__(self) -> _WorkerLLM:\n+            return self\n+\n+        def __exit__(self, *_args: object) -> None:\n+            return None\n+\n+    monkeypatch.setattr(text_generation_entrypoint, \"MegatronLLM\", _WorkerLLM)\n+    # Patch the standard module so this test also exercises the unfixed entrypoint.\n+    monkeypatch.setattr(socket, \"gethostname\", lambda: \"worker.example.test\")\n+    monkeypatch.setattr(socket, \"gethostbyname\", resolve)\n+    args = types.SimpleNamespace(\n+        max_new_tokens=16,\n+        max_seq_length=128,\n+        max_batch_size=1,\n+        tp=1,\n+        block_size_tokens=8,\n+        kv_cache_buffer_size_gb=20.0,\n+        max_tokens=None,\n+        return_log_probs=False,\n+        enable_chunked_prefill=False,\n+        use_coordinator=use_coordinator,\n+        coordinator_host=explicit_host,\n+        coordinator_port=12345,\n+    )\n+    text_generation_entrypoint._generate_with_dynamic_engine(\n+        args,\n+        model=object(),\n+        tokenizer=types.SimpleNamespace(tokenize=lambda _prompt: [1, 2]),\n+        prompts=[\"Hello world\"],\n+        sampling_params=object(),\n+    )\n+    assert received[\"coordinator_host\"] == expected_host\n+    assert received[\"coordinator_port\"] == 12345\n+    assert resolved == ([\"worker.example.test\"] if use_coordinator and explicit_host is None else [])\n+\n+\n+@pytest.mark.unit\n+def test_dynamic_generation_propagates_address_resolution_failure(\n+    text_generation_entrypoint: types.ModuleType,\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    def resolve(host: str) -> str:\n+        raise socket.gaierror(\"unresolvable node\")\n+\n+    def unexpected_engine(**kwargs: object) -> None:\n+        pytest.fail(\"Do not construct the engine after address resolution fails\")\n+\n+    monkeypatch.setattr(socket, \"gethostbyname\", resolve)\n+    monkeypatch.setattr(text_generation_entrypoint, \"MegatronLLM\", unexpected_engine)\n+    args = types.SimpleNamespace(\n+        max_new_tokens=16,\n+        max_seq_length=128,\n+        max_batch_size=1,\n+        tp=1,\n+        block_size_tokens=8,\n+        kv_cache_buffer_size_gb=20.0,\n+        max_tokens=None,\n+        return_log_probs=False,\n+        enable_chunked_prefill=False,\n+        use_coordinator=True,\n+        coordinator_host=None,\n+        coordinator_port=None,\n+    )\n+    with pytest.raises(socket.gaierror, match=\"unresolvable node\"):\n+        text_generation_entrypoint._generate_with_dynamic_engine(\n+            args,\n+            model=object(),\n+            tokenizer=types.SimpleNamespace(tokenize=lambda _prompt: [1, 2]),\n+            prompts=[\"Hello world\"],\n+            sampling_params=object(),\n+        )\n+\n+\n+@pytest.mark.unit\n+@pytest.mark.parametrize(\"use_coordinator\", [True, False])\n+def test_dynamic_generation_releases_cached_memory_before_engine_setup(\n+    text_generation_entrypoint: types.ModuleType,\n+    monkeypatch: pytest.MonkeyPatch,\n+    use_coordinator: bool,\n+) -> None:\n+    events: list[str] = []\n+    model = object()\n+\n+    class _WorkerLLM:\n+        is_primary_rank = False\n+\n+        def __init__(self, **kwargs: object) -> None:\n+            assert events == [\"cache_released\"]\n+            assert kwargs[\"model\"] is model\n+            assert kwargs[\"use_coordinator\"] is use_coordinator\n+            inference_config = kwargs[\"inference_config\"]\n+            assert isinstance(inference_config, dict)\n+            assert inference_config[\"kv_cache_buffer_size_gb\"] == 20.0\n+            events.append(\"engine_created\")\n+\n+        def __enter__(self) -> _WorkerLLM:\n+            return self\n+\n+        def __exit__(self, *_args: object) -> None:\n+            return None\n+\n+    monkeypatch.setattr(torch.cuda, \"empty_cache\", lambda: events.append(\"cache_released\"))\n+    monkeypatch.setattr(text_generation_entrypoint, \"MegatronLLM\", _WorkerLLM)\n+    args = types.SimpleNamespace(\n+        max_new_tokens=16,\n+        max_seq_length=128,\n+        max_batch_size=1,\n+        tp=1,\n+        block_size_tokens=8,\n+        kv_cache_buffer_size_gb=20.0,\n+        max_tokens=None,\n+        return_log_probs=False,\n+        enable_chunked_prefill=False,\n+        use_coordinator=use_coordinator,\n+        coordinator_host=\"192.0.2.12\" if use_coordinator else None,\n+        coordinator_port=None,\n+    )\n+    text_generation_entrypoint._generate_with_dynamic_engine(\n+        args,\n+        model=model,\n+        tokenizer=types.SimpleNamespace(tokenize=lambda _prompt: [1, 2]),\n+        prompts=[\"Hello world\"],\n+        sampling_params=object(),\n+    )\n+    assert events == [\"cache_released\", \"engine_created\"]",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/aa27147bfea192844ef59b5818a8ff35bfc18588/tests%2Funit_tests%2Fscripts%2Ftest_text_generation_entrypoint.py",
