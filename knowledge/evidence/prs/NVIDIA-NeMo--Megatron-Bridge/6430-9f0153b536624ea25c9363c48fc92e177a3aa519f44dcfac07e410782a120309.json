ia-cudnn-frontend/nvidia_cudnn_frontend-1.31.0-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl\", hash = \"sha256:3171f102254136418f24b4470dfa5419f34b03d9d792a4b773cf65c7a37e6bf8\" },\n+    { url = \"https://pypi.nvidia.com/nvidia-cudnn-frontend/nvidia_cudnn_frontend-1.31.0-cp312-cp312-win_amd64.whl\", hash = \"sha256:786c7dc590d436338c55b74e3204fc2adb4739acafb1a5e46ce032282e601e2e\" },\n ]\n \n [[package]]",
