      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/2bb03f66f36474d4f78637aab4b22557397369f3/.github%2Fworkflows%2Fcicd-main.yml",
      "changes": 41,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/.github%2Fworkflows%2Fcicd-main.yml?ref=2bb03f66f36474d4f78637aab4b22557397369f3",
      "deletions": 0,
      "filename": ".github/workflows/cicd-main.yml",
      "patch": "@@ -1384,3 +1384,44 @@ jobs:\n           path: |\n             .coverage\n           include-hidden-files: true\n+\n+  notify-nightly-failure:\n+    name: Notify scheduled CI failure\n+    runs-on: ubuntu-latest\n+    environment: main\n+    needs:\n+      - ephemeral-runner-routing\n+      - pre-flight\n+      - configure\n+      - lint-check\n+      - cicd-wait-in-queue\n+      - cicd-compute-build-matrix\n+      - cicd-container-build\n+      - cicd-import-check\n+      - cicd-unit-tests-core\n+      - cicd-unit-tests-diffusion\n+      - generate-test-matrix\n+      - cicd-functional-tests-l0\n+      - cicd-functional-tests-l1\n+      - cicd-functional-tests-l2\n+      - cicd-functional-tests-flaky\n+      - generate-gb200-test-matrix\n+      - cicd-functional-tests-gb200-l0\n+      - cicd-functional-tests-gb200-l1\n+      - cicd-functional-tests-gb200-l2\n+      - cicd-functional-tests-gb200-flaky\n+      - Nemo_CICD_Test\n+      - Coverage\n+    permissions: {}\n+    # Keep setup failures visible even when downstream jobs are skipped.\n+    if: >-\n+      ${{ always() && !cancelled() && failure() &&\n+          github.repository == 'NVIDIA-NeMo/Megatron-Bridge' &&\n+          github.event_name == 'schedule' &&\n+          github.ref_name == github.event.repository.default_branch }}\n+    steps:\n+      - name: Notify CI alerts channel\n+        uses: NVIDIA-NeMo/FW-CI-templates/.github/actions/notify-ci-failure@631c404d00a9e60afc591cd071d35d2e18f82fc6\n+        with:\n+          needs-json: ${{ toJSON(needs) }}\n+          webhook: ${{ secrets.SLACK_WEBHOOK }}",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/2bb03f66f36474d4f78637aab4b22557397369f3/.github%2Fworkflows%2Fcicd-main.yml",
      "sha": "d4b441a55933a7075ea499ba25f451ff095ba1d0",
