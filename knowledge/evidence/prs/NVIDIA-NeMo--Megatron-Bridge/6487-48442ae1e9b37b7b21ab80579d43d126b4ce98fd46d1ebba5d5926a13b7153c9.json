      "additions": 23,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/309c87a2929de548771b05d288fe694aba06a0f1/examples%2Fconversion%2Fconvert_megatron_mimo.py",
      "changes": 26,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/examples%2Fconversion%2Fconvert_megatron_mimo.py?ref=309c87a2929de548771b05d288fe694aba06a0f1",
      "deletions": 3,
      "filename": "examples/conversion/convert_megatron_mimo.py",
      "patch": "@@ -44,6 +44,7 @@\n import logging\n import os\n import sys\n+from datetime import timedelta\n \n import torch\n import torch.distributed as dist\n@@ -235,7 +236,7 @@ def run_export(\n         logger.info(\"MIMO -> HF export complete (wrote %s)\", hf_path)\n \n \n-def _init_distributed() -> None:\n+def _init_distributed(distributed_timeout_minutes: int) -> None:\n     \"\"\"Initialize ``torch.distributed`` from torchrun environment variables.\"\"\"\n     if dist.is_initialized():\n         return\n@@ -247,7 +248,14 @@ def _init_distributed() -> None:\n         backend = \"nccl\"\n     else:\n         backend = \"gloo\"\n-    dist.init_process_group(backend=backend, rank=rank, world_size=world_size)\n+    # Inactive component ranks can wait while rank 0 writes an entire route.\n+    # Large checkpoints on shared storage can exceed NCCL's default timeout.\n+    dist.init_process_group(\n+        backend=backend,\n+        rank=rank,\n+        world_size=world_size,\n+        timeout=timedelta(minutes=distributed_timeout_minutes),\n+    )\n \n \n _DTYPE_MAP = {\"float32\": torch.float32, \"float16\": torch.float16, \"bfloat16\": torch.bfloat16}\n@@ -256,6 +264,16 @@ def _init_distributed() -> None:\n def _add_common_args(parser: argparse.ArgumentParser) -> None:\n     \"\"\"Shared CLI flags between import and export subcommands.\"\"\"\n     parser.add_argument(\"--hf-model\", required=True, help=\"HuggingFace model ID or local path.\")\n+    parser.add_argument(\n+        \"--distributed-timeout-minutes\",\n+        type=int,\n+        default=120,\n+        help=(\n+            \"Process-group timeout in minutes (default: 120). Must cover a full route's export, \"\n+            \"including checkpoint I/O. Increase for large models on slow storage. \"\n+            \"Only applies when this CLI initializes the default process group.\"\n+        ),\n+    )\n     parser.add_argument(\n         \"--component\",\n         action=\"append\",\n@@ -328,9 +346,11 @@ def main(argv: list[str] | None = None) -> int:\n         return 1\n \n     logging.basicConfig(level=getattr(logging, args.log_level))\n+    if args.distributed_timeout_minutes <= 0:\n+        parser.error(\"--distributed-timeout-minutes must be positive\")\n     torch_dtype = _DTYPE_MAP[args.torch_dtype]\n \n-    _init_distributed()\n+    _init_distributed(args.distributed_timeout_minutes)\n     try:\n         if args.command == \"import\":\n             run_import(",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/309c87a2929de548771b05d288fe694aba06a0f1/examples%2Fconversion%2Fconvert_megatron_mimo.py",
      "sha": "75a9d3aa6bd7f835e9912accff650bdbcbd5054f",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/309c87a2929de548771b05d288fe694aba06a0f1/examples%2Fmegatron_mimo%2Fnemotron_omni%2Fconversion.sh",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/examples%2Fmegatron_mimo%2Fnemotron_omni%2Fconversion.sh?ref=309c87a2929de548771b05d288fe694aba06a0f1",
      "deletions": 0,
      "filename": "examples/megatron_mimo/nemotron_omni/conversion.sh",
      "patch": "@@ -34,6 +34,8 @@ WORKSPACE=${WORKSPACE:-/workspace}\n MEGATRON_PATH=${MEGATRON_PATH:-\"${WORKSPACE}/nemotron-omni-mimo\"}\n HF_PATH=${HF_PATH:-\"${WORKSPACE}/nemotron-omni-mimo-export-hf\"}\n TORCH_DTYPE=${TORCH_DTYPE:-bfloat16}\n+# Idle ranks may wait for a whole route to be written to shared storage.\n+DISTRIBUTED_TIMEOUT_MINUTES=${DISTRIBUTED_TIMEOUT_MINUTES:-120}\n \n LANGUAGE_TP=${LANGUAGE_TP:-2}\n LANGUAGE_DP=${LANGUAGE_DP:-1}\n@@ -54,6 +56,7 @@ if [[ \"${PHASE}\" == import || \"${PHASE}\" == all ]]; then\n         --component \"images=tp=${VISION_TP},dp=${VISION_DP},rank_offset=0\" \\\n         --component \"language=tp=${LANGUAGE_TP},dp=${LANGUAGE_DP},ep=${LANGUAGE_EP},etp=${LANGUAGE_ETP},rank_offset=${VISION_RANKS}\" \\\n         --torch-dtype \"${TORCH_DTYPE}\" \\\n+        --distributed-timeout-minutes \"${DISTRIBUTED_TIMEOUT_MINUTES}\" \\\n         --trust-remote-code\n fi\n \n@@ -68,5 +71,6 @@ if [[ \"${PHASE}\" == export || \"${PHASE}\" == all ]]; then\n         --component \"language=tp=${LANGUAGE_TP},dp=${LANGUAGE_DP},ep=${LANGUAGE_EP},etp=${LANGUAGE_ETP},rank_offset=0\" \\\n         --component \"images=tp=${VISION_TP},dp=${VISION_DP},rank_offset=${LANGUAGE_RANKS}\" \\\n         --torch-dtype \"${TORCH_DTYPE}\" \\\n+        --distributed-timeout-minutes \"${DISTRIBUTED_TIMEOUT_MINUTES}\" \\\n         --trust-remote-code\n fi",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/309c87a2929de548771b05d288fe694aba06a0f1/examples%2Fmegatron_mimo%2Fnemotron_omni%2Fconversion.sh",
      "sha": "c9d0e5b551163f1a9247a6d720751f00bea9a470",
      "status": "modified"
    },
    {
      "additions": 51,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/309c87a2929de548771b05d288fe694aba06a0f1/tests%2Funit_tests%2Fexamples%2Ftest_convert_megatron_mimo_cli.py",
      "changes": 52,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Fexamples%2Ftest_convert_megatron_mimo_cli.py?ref=309c87a2929de548771b05d288fe694aba06a0f1",
      "deletions": 1,
      "filename": "tests/unit_tests/examples/test_convert_megatron_mimo_cli.py",
      "patch": "@@ -14,7 +14,7 @@\n \n \"\"\"Unit tests for the generic ``examples/conversion/convert_megatron_mimo.py`` CLI parser.\n \n-Covers only the model-agnostic ``--component name=tp=N,...`` parsing logic.\n+Covers component parsing, command dispatch, and distributed timeout configuration.\n The end-to-end conversion path needs GPUs and torchrun.\n \"\"\"\n \n@@ -23,6 +23,8 @@\n import importlib.util\n import pathlib\n import sys\n+from datetime import timedelta\n+from unittest.mock import Mock\n \n import pytest\n \n@@ -213,3 +215,51 @@ def export_ckpt(self, *args, **kwargs):\n             (),\n             {\"megatron_path\": \"/ckpt\", \"hf_path\": \"/hf\", \"show_progress\": True},\n         )\n+\n+\n+@pytest.mark.unit\n+class TestDistributedTimeout:\n+    @pytest.mark.parametrize(\n+        \"command, timeout_args, expected\",\n+        [(\"export\", [], 120), (\"import\", [\"--distributed-timeout-minutes\", \"180\"], 180)],\n+    )\n+    def test_main_initializes_group_with_timeout(self, cli, monkeypatch, command, timeout_args, expected):\n+        monkeypatch.setenv(\"RANK\", \"1\")\n+        monkeypatch.setenv(\"WORLD_SIZE\", \"8\")\n+        monkeypatch.setenv(\"LOCAL_RANK\", \"1\")\n+        monkeypatch.setattr(cli.dist, \"is_initialized\", lambda: False)\n+        monkeypatch.setattr(cli.torch.cuda, \"is_available\", lambda: True)\n+        monkeypatch.setattr(cli.torch.cuda, \"set_device\", Mock())\n+        init = Mock()\n+        monkeypatch.setattr(cli.dist, \"init_process_group\", init)\n+        run = Mock()\n+        monkeypatch.setattr(cli, f\"run_{command}\", run)\n+        args = [command, \"--hf-model\", \"hf\", \"--component\", \"language=tp=1\", \"--megatron-path\", \"/ckpt\"]\n+        if command == \"export\":\n+            args += [\"--hf-path\", \"/hf\"]\n+\n+        assert cli.main(args + timeout_args) == 0\n+\n+        init.assert_called_once()\n+        assert init.call_args.kwargs[\"timeout\"] == timedelta(minutes=expected)\n+        run.assert_called_once()\n+\n+    def test_zero_timeout_rejected_before_initialization(self, cli, monkeypatch):\n+        init = Mock()\n+        monkeypatch.setattr(cli, \"_init_distributed\", init)\n+        with pytest.raises(SystemExit) as exc:\n+            cli.main(\n+                [\n+                    \"import\",\n+                    \"--hf-model\",\n+                    \"hf\",\n+                    \"--component\",\n+                    \"language=tp=1\",\n+                    \"--megatron-path\",\n+                    \"/ckpt\",\n+                    \"--distributed-timeout-minutes\",\n+                    \"0\",\n+                ]\n+            )\n+        assert exc.value.code == 2\n+        init.assert_not_called()",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/309c87a2929de548771b05d288fe694aba06a0f1/tests%2Funit_tests%2Fexamples%2Ftest_convert_megatron_mimo_cli.py",
      "sha": "1369acaf6e4e5c5dd021bb9bb861f0ef7bb1f7aa",
      "status": "modified"
    }
