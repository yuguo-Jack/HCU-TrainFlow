      "filename": "src/megatron/bridge/recipes/qwen_vl/gb200/qwen35_vl.py",
      "patch": "@@ -50,7 +50,10 @@ def qwen35_vl_27b_pretrain_16gpu_gb200_bf16_mock_config() -> ConfigContainer:\n     cfg.model.pipeline_dtype = None\n     cfg.model.virtual_pipeline_model_parallel_size = None\n     cfg.model.context_parallel_size = 1\n-    cfg.model.sequence_parallel = False\n+    # Sequence parallelism whenever TP > 1: without it, Megatron-Core leaves the\n+    # GatedDeltaNet out_norm gradient as a per-rank partial sum across TP ranks\n+    # (NVIDIA/Megatron-LM#7613), so the replicated weight drifts apart.\n+    cfg.model.sequence_parallel = True\n     cfg.model.calculate_per_token_loss = True\n \n     cfg.train.global_batch_size = 32",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/96f4c7df3498a58bba67ce43c4e9ba05968b2de5/src%2Fmegatron%2Fbridge%2Frecipes%2Fqwen_vl%2Fgb200%2Fqwen35_vl.py",
