      "changes": 20,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Frecipes%2Fqwen_vl%2Fh100%2Fqwen35_vl.py?ref=96f4c7df3498a58bba67ce43c4e9ba05968b2de5",
      "deletions": 4,
      "filename": "src/megatron/bridge/recipes/qwen_vl/h100/qwen35_vl.py",
      "patch": "@@ -197,7 +197,10 @@ def qwen35_vl_27b_pretrain_16gpu_h100_bf16_mock_config() -> ConfigContainer:\n     cfg.model.pipeline_dtype = torch.bfloat16\n     cfg.model.virtual_pipeline_model_parallel_size = None\n     cfg.model.context_parallel_size = 1\n-    cfg.model.sequence_parallel = False\n+    # Sequence parallelism whenever TP > 1: without it, Megatron-Core leaves the\n+    # GatedDeltaNet out_norm gradient as a per-rank partial sum across TP ranks\n+    # (NVIDIA/Megatron-LM#7613), so the replicated weight drifts apart.\n+    cfg.model.sequence_parallel = True\n     cfg.model.freeze_language_model = False\n     cfg.model.freeze_vision_model = True\n     cfg.model.freeze_vision_projection = False\n@@ -697,7 +700,10 @@ def qwen35_vl_4b_sft_2gpu_h100_bf16_config() -> ConfigContainer:\n     cfg.model.pipeline_dtype = None\n     cfg.model.virtual_pipeline_model_parallel_size = None\n     cfg.model.context_parallel_size = 1\n-    cfg.model.sequence_parallel = False\n+    # Sequence parallelism whenever TP > 1: without it, Megatron-Core leaves the\n+    # GatedDeltaNet out_norm gradient as a per-rank partial sum across TP ranks\n+    # (NVIDIA/Megatron-LM#7613), so the replicated weight drifts apart.\n+    cfg.model.sequence_parallel = True\n \n     # VLM-specific settings\n     cfg.model.freeze_language_model = False\n@@ -798,7 +804,10 @@ def qwen35_vl_9b_sft_4gpu_h100_bf16_config() -> ConfigContainer:\n     cfg.model.pipeline_dtype = None\n     cfg.model.virtual_pipeline_model_parallel_size = None\n     cfg.model.context_parallel_size = 1\n-    cfg.model.sequence_parallel = False\n+    # Sequence parallelism whenever TP > 1: without it, Megatron-Core leaves the\n+    # GatedDeltaNet out_norm gradient as a per-rank partial sum across TP ranks\n+    # (NVIDIA/Megatron-LM#7613), so the replicated weight drifts apart.\n+    cfg.model.sequence_parallel = True\n \n     # VLM-specific settings\n     cfg.model.freeze_language_model = False\n@@ -897,7 +906,10 @@ def qwen35_vl_27b_sft_16gpu_h100_bf16_config() -> ConfigContainer:\n     cfg.model.pipeline_dtype = torch.bfloat16\n     cfg.model.virtual_pipeline_model_parallel_size = None\n     cfg.model.context_parallel_size = 1\n-    cfg.model.sequence_parallel = False\n+    # Sequence parallelism whenever TP > 1: without it, Megatron-Core leaves the\n+    # GatedDeltaNet out_norm gradient as a per-rank partial sum across TP ranks\n+    # (NVIDIA/Megatron-LM#7613), so the replicated weight drifts apart.\n+    cfg.model.sequence_parallel = True\n \n     # VLM-specific settings\n     cfg.model.freeze_language_model = False",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/96f4c7df3498a58bba67ce43c4e9ba05968b2de5/src%2Fmegatron%2Fbridge%2Frecipes%2Fqwen_vl%2Fh100%2Fqwen35_vl.py",
