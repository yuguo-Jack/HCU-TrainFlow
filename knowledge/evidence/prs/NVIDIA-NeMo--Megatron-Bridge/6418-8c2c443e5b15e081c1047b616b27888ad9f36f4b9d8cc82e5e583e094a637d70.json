  "files": [
    {
      "additions": 35,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/7ad21f3c4decb82fc7adea3b7d6f69fc876dc5e7/src%2Fmegatron%2Fbridge%2Fmodels%2Fhf_pretrained%2Fstate.py",
      "changes": 45,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Fmodels%2Fhf_pretrained%2Fstate.py?ref=7ad21f3c4decb82fc7adea3b7d6f69fc876dc5e7",
      "deletions": 10,
      "filename": "src/megatron/bridge/models/hf_pretrained/state.py",
      "patch": "@@ -845,17 +845,27 @@ def save_generator(\n         all_saved_keys = set()\n         total_saved_tensor_bytes = 0\n \n+        unexpected_keys: list[str] = []\n+\n         for name, tensor in generator:\n             all_yielded_keys.add(name)\n             if name not in all_expected_keys:\n                 if strict:\n-                    raise KeyError(\n-                        f\"Tensor '{name}' from generator not found in the original model structure. \"\n-                        \"Re-run with strict=False to save the partial checkpoint instead of failing.\"\n-                    )\n+                    # Recorded and raised after the loop, not here. The comment\n+                    # above says why: the other ranks are inside\n+                    # ``for _ in generator: pass`` driving their side of the\n+                    # export collectives, so leaving the generator mid-stream\n+                    # blocks them until the process-group timeout instead of\n+                    # failing.\n+                    unexpected_keys.append(name)\n                 else:\n                     print(f\"Warning: tensor '{name}' from generator not found in original model structure. Skipping.\")\n-                    continue\n+                continue\n+\n+            if unexpected_keys:\n+                # Already failing. Keep pulling so the other ranks finish, and\n+                # write nothing further, as raising on the first offender did.\n+                continue\n \n             buffered_tensors[name] = tensor\n \n@@ -889,6 +899,12 @@ def save_generator(\n                 del files_to_save[filename]\n                 del remaining_keys_by_file[filename]\n \n+        if unexpected_keys:\n+            raise KeyError(\n+                f\"Tensor '{unexpected_keys[0]}' from generator not found in the original model structure. \"\n+                \"Re-run with strict=False to save the partial checkpoint instead of failing.\"\n+            )\n+\n         # --- Final Reporting ---\n         if files_to_save:\n             if strict:\n@@ -1105,13 +1121,22 @@ def write_shard(fname: str, tensors_to_save: Dict[str, torch.Tensor]) -> bool:\n         for name, tensor in generator:\n             if name not in key_to_filename_map:\n                 if strict:\n-                    raise KeyError(\n-                        f\"Tensor '{name}' from generator not found in the original model structure. \"\n-                        \"Re-run with strict=False to save the partial checkpoint instead of failing.\"\n-                    )\n+                    # Recorded rather than raised, the way the duplicate-key\n+                    # branch below already does it, and for the reason the\n+                    # comment on the strict-mode check gives: every rank both\n+                    # produces and consumes this generator, so leaving it\n+                    # mid-stream hangs the others on the trailing collectives\n+                    # instead of failing.\n+                    if local_export_error is None:\n+                        local_export_error = (\n+                            f\"Rank {rank}: Tensor '{name}' from generator not found in the original \"\n+                            \"model structure. Re-run with strict=False to save the partial checkpoint \"\n+                            \"instead of failing.\"\n+                        )\n+                        buffered_tensors.clear()\n                 else:\n                     print(f\"Warning: tensor '{name}' from generator not found in original model structure. Skipping.\")\n-                    continue\n+                continue\n \n             if is_saver_rank:\n                 fname = key_to_filename_map[name]",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/7ad21f3c4decb82fc7adea3b7d6f69fc876dc5e7/src%2Fmegatron%2Fbridge%2Fmodels%2Fhf_pretrained%2Fstate.py",
      "sha": "9a3b2435210bb2f8d6fdaaa9a3118fd124b6d6c9",
      "status": "modified"
    },
    {
      "additions": 68,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/7ad21f3c4decb82fc7adea3b7d6f69fc876dc5e7/tests%2Funit_tests%2Fmodels%2Ftest_hf_pretrained_state.py",
      "changes": 68,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Fmodels%2Ftest_hf_pretrained_state.py?ref=7ad21f3c4decb82fc7adea3b7d6f69fc876dc5e7",
      "deletions": 0,
      "filename": "tests/unit_tests/models/test_hf_pretrained_state.py",
      "patch": "@@ -126,6 +126,74 @@ def test_save_generator_strict_false_writes_nested_partial_shard(tmp_path) -> No\n     assert index_data[\"weight_map\"] == {\"model.present\": shard_filename}\n \n \n+def test_save_generator_strict_drains_the_generator_before_raising(tmp_path) -> None:\n+    \"\"\"Strict mode must still pull the generator dry.\n+\n+    ``save_generator`` says it itself: the ranks that are not writing sit in\n+    ``for _ in generator: pass`` to drive their side of the export collectives.\n+    Leaving the generator mid-stream on the writing rank blocks them until the\n+    process-group timeout instead of failing.\n+    \"\"\"\n+    shard_filename = \"model-00001-of-00001.safetensors\"\n+    _write_safetensors_index(\n+        tmp_path,\n+        {\n+            \"model.first\": shard_filename,\n+            \"model.second\": shard_filename,\n+        },\n+    )\n+    source = SafeTensorsStateSource(tmp_path)\n+    output_path = tmp_path / \"output\"\n+    pulled: list[str] = []\n+\n+    def generator() -> Iterator[tuple[str, torch.Tensor]]:\n+        pulled.append(\"model.first\")\n+        yield \"model.first\", torch.ones(1)\n+        pulled.append(\"surprise.weight\")\n+        yield \"surprise.weight\", torch.ones(1)\n+        pulled.append(\"model.second\")\n+        yield \"model.second\", torch.ones(1)\n+\n+    with pytest.raises(KeyError, match=\"surprise.weight\"):\n+        source.save_generator(generator(), output_path, strict=True)\n+\n+    assert pulled == [\"model.first\", \"surprise.weight\", \"model.second\"]\n+    # Nothing is written past the first unexpected key, as raising on it did.\n+    assert not (output_path / shard_filename).exists()\n+\n+\n+def test_distributed_save_generator_strict_drains_the_generator(tmp_path, monkeypatch) -> None:\n+    \"\"\"Same invariant on the distributed path, where every rank both produces and\n+    consumes the generator. The strict-mode check already aggregates per-rank\n+    status \"so all ranks raise consistently (avoids hangs on the trailing\n+    barriers)\", and the error it raises says the ranks drained the generator.\"\"\"\n+    shard_filename = \"model-00001-of-00001.safetensors\"\n+    _write_safetensors_index(\n+        tmp_path,\n+        {\n+            \"model.first\": shard_filename,\n+            \"model.second\": shard_filename,\n+        },\n+    )\n+    _mock_single_rank_distributed(monkeypatch)\n+    source = SafeTensorsStateSource(tmp_path)\n+    output_path = tmp_path / \"output\"\n+    pulled: list[str] = []\n+\n+    def generator() -> Iterator[tuple[str, torch.Tensor]]:\n+        pulled.append(\"model.first\")\n+        yield \"model.first\", torch.ones(1)\n+        pulled.append(\"surprise.weight\")\n+        yield \"surprise.weight\", torch.ones(1)\n+        pulled.append(\"model.second\")\n+        yield \"model.second\", torch.ones(1)\n+\n+    with pytest.raises(RuntimeError, match=\"drained the tensor generator\"):\n+        source.save_generator(generator(), output_path, strict=True, distributed_save=True)\n+\n+    assert pulled == [\"model.first\", \"surprise.weight\", \"model.second\"]\n+\n+\n @pytest.mark.parametrize(\"distributed_save\", [False, True])\n def test_save_generator_recomputes_index_total_size(tmp_path, monkeypatch, distributed_save: bool) -> None:\n     first_shard = \"model-00001-of-00002.safetensors\"",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/7ad21f3c4decb82fc7adea3b7d6f69fc876dc5e7/tests%2Funit_tests%2Fmodels%2Ftest_hf_pretrained_state.py",
      "sha": "83c008008d6923e9d3b63ae19e4eda667ea6db53",
      "status": "modified"
    }
