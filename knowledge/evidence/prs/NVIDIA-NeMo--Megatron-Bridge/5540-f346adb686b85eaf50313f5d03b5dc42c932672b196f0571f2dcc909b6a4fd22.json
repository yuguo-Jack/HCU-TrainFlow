_version = 2\n+\n+        pretrain(cfg, forward_step)\n+        torch.distributed.barrier()\n+\n     @pytest.mark.run_only_on(\"GPU\")\n     def test_fsdp_pretrain_save_resume(self, tmp_path):\n         \"\"\"",
