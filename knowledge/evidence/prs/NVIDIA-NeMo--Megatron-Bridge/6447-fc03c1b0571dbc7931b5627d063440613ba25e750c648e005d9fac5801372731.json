      "deletions": 2,
      "filename": "docker/Dockerfile.fw_final",
      "patch": "@@ -72,11 +72,15 @@ RUN \\\n     BASE_RUNTIME_UV_ARGS=\"\" && \\\n     if [ \"${MBRIDGE_PRESERVE_BASE_RUNTIME:-False}\" = \"True\" ]; then \\\n         BASE_RUNTIME_UV_ARGS=\"--no-install-package nvidia-cudnn-frontend --no-install-package transformer-engine --no-install-package transformer-engine-torch\"; \\\n+    elif [ -n \"$CUDNN_FRONTEND_GIT_REF\" ]; then \\\n+        BASE_RUNTIME_UV_ARGS=\"--no-install-package nvidia-cudnn-frontend\"; \\\n     fi && \\\n     uv sync --no-cache-dir --all-groups --inexact ${BASE_RUNTIME_UV_ARGS} && \\\n     if [ -n \"$CUDNN_FRONTEND_GIT_REF\" ] && [ \"${MBRIDGE_PRESERVE_BASE_RUNTIME:-False}\" != \"True\" ]; then \\\n-        uv pip install --no-cache-dir --no-deps --reinstall \\\n-            \"nvidia-cudnn-frontend @ git+https://github.com/NVIDIA/cudnn-frontend.git@${CUDNN_FRONTEND_GIT_REF}\"; \\\n+        uv pip install --no-config --no-cache-dir --no-deps --reinstall \\\n+            \"nvidia-cudnn-frontend @ git+https://github.com/NVIDIA/cudnn-frontend.git@${CUDNN_FRONTEND_GIT_REF}\" && \\\n+        CUDNN_FRONTEND_GIT_REF=\"$CUDNN_FRONTEND_GIT_REF\" python -c \\\n+            'import importlib.metadata as m, json, os, sys; source = m.distribution(\"nvidia-cudnn-frontend\").read_text(\"direct_url.json\"); sys.exit(0 if json.loads(source)[\"vcs_info\"][\"commit_id\"] == os.environ[\"CUDNN_FRONTEND_GIT_REF\"] else \"cuDNN Frontend Git ref mismatch\")'; \\\n     fi && \\\n     python /opt/preserve_base_runtime.py check /opt/base-runtime-packages.json && \\\n     uv pip list && \\",
