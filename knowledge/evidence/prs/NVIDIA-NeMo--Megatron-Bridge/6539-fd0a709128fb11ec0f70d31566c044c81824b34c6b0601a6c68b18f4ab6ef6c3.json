      "deletions": 4,
      "filename": ".github/workflows/release-freeze.yml",
      "patch": "@@ -32,10 +32,15 @@ on:\n         description: Dry-run of code-freeze\n         required: false\n         default: true\n+permissions:\n+  contents: read\n+\n jobs:\n   code-freeze:\n-    uses: NVIDIA-NeMo/FW-CI-templates/.github/workflows/_code_freeze.yml@bfdb5e35067fd8cd91ce21fca4eb1072ffd7ab8c # v1.4.2\n+    uses: NVIDIA-NeMo/FW-CI-templates/.github/workflows/_code_freeze.yml@61445a177938967f70c94094b98402e979452151 # github app authentication\n     with:\n+      app-id: ${{ vars.BOT_ID }}\n+      environment-name: main\n       library-name: Megatron-Bridge\n       python-package: megatron.bridge\n       has-src-dir: true\n@@ -44,11 +49,10 @@ jobs:\n       dry-run: ${{ inputs.dry-run }}\n       next-pre-release: \"\"\n       next-dev: \"\"\n-      use-pat: true\n     secrets:\n       SLACK_WEBHOOK: ${{ secrets.SLACK_MAIN_CHANNEL_WEBHOOK }}\n       SLACK_WEBHOOK_ADMIN: ${{ secrets.SLACK_TEAM_GROUP_ID }}\n-      PAT: ${{ secrets.PAT }}\n+      BOT_KEY: ${{ secrets.BOT_KEY }}\n \n   bump-docs-versions:\n     needs: [code-freeze]\n@@ -57,11 +61,20 @@ jobs:\n       VERSION: ${{ needs.code-freeze.outputs.release-branch }}\n       DRY_RUN: ${{ inputs.dry-run }}\n     steps:\n+      - name: Generate GitHub App token\n+        id: app-token\n+        uses: actions/create-github-app-token@bcd2ba49218906704ab6c1aa796996da409d3eb1 # v3.2.0\n+        with:\n+          app-id: ${{ vars.BOT_ID }}\n+          private-key: ${{ secrets.BOT_KEY }}\n+          permission-contents: write\n+          permission-administration: write\n+\n       - name: Checkout repository\n         uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6\n         with:\n           ref: main\n-          token: ${{ secrets.PAT }}\n+          token: ${{ steps.app-token.outputs.token }}\n \n       - name: Configure git\n         run: |",
