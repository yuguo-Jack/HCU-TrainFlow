    {
      "additions": 16,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/acb9a76021d23ac5d4f952d924891d97ce0b8d6e/src%2Fmegatron%2Fbridge%2Ftraining%2Finprocess_restart.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Ftraining%2Finprocess_restart.py?ref=acb9a76021d23ac5d4f952d924891d97ce0b8d6e",
      "deletions": 2,
      "filename": "src/megatron/bridge/training/inprocess_restart.py",
      "patch": "@@ -75,6 +75,8 @@ def inprocess_restart(train_fn: Callable, config: InProcessRestartConfig, global\n             )\n         )\n \n+    finalize_errors: list[Exception] = []\n+\n     def destroy_state():\n         \"\"\"Comprehensive state cleanup for in-process restart.\"\"\"\n \n@@ -86,8 +88,20 @@ def destroy_state():\n             global_state.reset_for_restart()\n         except Exception as e:\n             logger.error(f\"destroy_state failed: {type(e).__name__}: {e}\", exc_info=True)\n-\n-    finalize = [inprocess.finalize.ThreadedFinalize(timeout=timedelta(seconds=10), fn=destroy_state)]\n+            finalize_errors.append(e)\n+\n+    class RaiseFinalizeError(inprocess.finalize.Finalize):\n+        def __call__(self, state: inprocess.state.FrozenState) -> inprocess.state.FrozenState:\n+            if finalize_errors:\n+                raise finalize_errors.pop()\n+            return state\n+\n+    # Compose runs right-to-left. Relay cleanup errors after the worker joins,\n+    # because ThreadedFinalize does not propagate exceptions from its thread.\n+    finalize = [\n+        RaiseFinalizeError(),\n+        inprocess.finalize.ThreadedFinalize(timeout=timedelta(seconds=10), fn=destroy_state),\n+    ]\n \n     if config.empty_cuda_cache:\n         finalize.append(inprocess.finalize.ThreadedFinalize(timeout=timedelta(seconds=10), fn=torch.cuda.empty_cache))",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/acb9a76021d23ac5d4f952d924891d97ce0b8d6e/src%2Fmegatron%2Fbridge%2Ftraining%2Finprocess_restart.py",
      "sha": "43e573b789b92caa3d9fac66e9998ab7e4f145e2",
      "status": "modified"
    },
    {
      "additions": 52,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/acb9a76021d23ac5d4f952d924891d97ce0b8d6e/tests%2Funit_tests%2Ftraining%2Ftest_inprocess_restart.py",
      "changes": 52,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Ftraining%2Ftest_inprocess_restart.py?ref=acb9a76021d23ac5d4f952d924891d97ce0b8d6e",
      "deletions": 0,
      "filename": "tests/unit_tests/training/test_inprocess_restart.py",
      "patch": "@@ -26,6 +26,58 @@\n class TestInProcessRestart:\n     \"\"\"Test cases for the inprocess_restart function.\"\"\"\n \n+    @pytest.mark.parametrize(\"empty_cuda_cache\", [False, True])\n+    @pytest.mark.parametrize(\"failure_site\", [None, \"destroy_global_state\", \"reset_for_restart\"])\n+    def test_finalize_propagates_cleanup_errors(self, empty_cuda_cache, failure_site):\n+        \"\"\"Use native threaded finalization to surface incomplete cleanup to NVRx.\"\"\"\n+        from nvidia_resiliency_ext.inprocess.state import State\n+\n+        config = InProcessRestartConfig(\n+            enabled=True,\n+            active_world_size=1,\n+            granularity=\"rank\",\n+            empty_cuda_cache=empty_cuda_cache,\n+        )\n+        global_state = MagicMock(spec=GlobalState)\n+        cleanup_error = RuntimeError(\"incomplete restart cleanup\")\n+        state = State(rank=0, world_size=1, active_rank=0, active_world_size=1).freeze()\n+\n+        with (\n+            patch.dict(os.environ, {\"MASTER_PORT\": \"29500\"}),\n+            patch(\"megatron.bridge.training.inprocess_restart.warnings.warn\"),\n+            patch(\"nvidia_resiliency_ext.inprocess.Wrapper\") as wrapper,\n+            patch(\"megatron.bridge.training.initialize.destroy_global_state\") as destroy_global_state,\n+            patch(\"torch.cuda.is_available\", return_value=True),\n+            patch(\"torch.cuda.is_initialized\", return_value=True),\n+            patch(\"torch.cuda.current_device\", return_value=0),\n+            patch(\"torch.cuda.set_device\"),\n+            patch(\"torch.cuda.empty_cache\") as empty_cache,\n+        ):\n+            inprocess_restart(MagicMock(), config, global_state)\n+            finalize = wrapper.call_args.kwargs[\"finalize\"]\n+            if failure_site == \"destroy_global_state\":\n+                destroy_global_state.side_effect = cleanup_error\n+            elif failure_site == \"reset_for_restart\":\n+                global_state.reset_for_restart.side_effect = cleanup_error\n+\n+            if failure_site is None:\n+                assert finalize(state) is state\n+            else:\n+                with pytest.raises(RuntimeError, match=\"incomplete restart cleanup\") as raised:\n+                    finalize(state)\n+                assert raised.value is cleanup_error\n+                if failure_site == \"destroy_global_state\":\n+                    global_state.reset_for_restart.assert_not_called()\n+\n+                # A later successful cleanup must not replay an earlier error.\n+                destroy_global_state.side_effect = None\n+                global_state.reset_for_restart.side_effect = None\n+                assert finalize(state) is state\n+\n+            destroy_global_state.assert_called()\n+            global_state.reset_for_restart.assert_called()\n+            assert empty_cache.call_count == (1 if failure_site is None else 2) * empty_cuda_cache\n+\n     def test_inprocess_restart_honors_max_iterations(self):\n         \"\"\"Test that a finite retry limit aborts before the next attempt.\"\"\"\n         from nvidia_resiliency_ext.inprocess.exception import RestartAbort",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/acb9a76021d23ac5d4f952d924891d97ce0b8d6e/tests%2Funit_tests%2Ftraining%2Ftest_inprocess_restart.py",
      "sha": "7160e71d9ff01cc7c2db40ab8f7fb13c41f44949",
      "status": "modified"
