      "additions": 16,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/f64464930e7841389be9a6fb7a406e01386862ef/tests%2Funit_tests%2Fmodels%2Fhf_pretrained%2Ftest_state_dict.py",
      "changes": 16,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Fmodels%2Fhf_pretrained%2Ftest_state_dict.py?ref=f64464930e7841389be9a6fb7a406e01386862ef",
      "deletions": 0,
      "filename": "tests/unit_tests/models/hf_pretrained/test_state_dict.py",
      "patch": "@@ -200,6 +200,22 @@ def test_contains_method(self, mock_model):\n         assert \"transformer.wte.weight\" in state_dict\n         assert \"missing.key\" not in state_dict\n \n+    def test_membership_follows_wrapped_get_all_keys(self, mock_model):\n+        \"\"\"Membership tracks a temporarily wrapped source.get_all_keys (as the Kimi bridges do).\"\"\"\n+        state_dict = StateDict(mock_model.state_dict())\n+        source = state_dict.source\n+        assert \"lm_head.virtual\" not in state_dict  # build the key set before wrapping\n+\n+        original_get_all_keys = source.get_all_keys\n+        source.get_all_keys = lambda: original_get_all_keys() + [\"lm_head.virtual\"]\n+        try:\n+            assert \"lm_head.virtual\" in state_dict\n+        finally:\n+            source.get_all_keys = original_get_all_keys\n+\n+        assert \"lm_head.virtual\" not in state_dict\n+        assert \"lm_head.weight\" in state_dict\n+\n \n class TestStateDictTensorLoading:\n     \"\"\"Test tensor loading functionality.\"\"\"",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/f64464930e7841389be9a6fb7a406e01386862ef/tests%2Funit_tests%2Fmodels%2Fhf_pretrained%2Ftest_state_dict.py",
      "sha": "b43bed46b3b6cb6735cde605631bdb0b757b2490",
      "status": "modified"
    }
