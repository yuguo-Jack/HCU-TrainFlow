      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Fpeft%2Futils.py?ref=4da9918175a5bd8d50b86806ddb1776a0825a3cc",
      "deletions": 1,
      "filename": "src/megatron/bridge/peft/utils.py",
      "patch": "@@ -774,7 +774,7 @@ def wildcard_match(pattern: str, key: Optional[str]) -> Optional[bool]:\n     \"\"\"\n     if key is None:\n         return None\n-    regex_pattern = re.compile(\"^\" + pattern.replace(\"*\", \"(.*)\") + \"$\")\n+    regex_pattern = re.compile(\"^\" + pattern.replace(\".\", r\"\\.\").replace(\"*\", \"(.*)\") + \"$\")\n     match = regex_pattern.match(key)\n     return match is not None\n ",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/4da9918175a5bd8d50b86806ddb1776a0825a3cc/src%2Fmegatron%2Fbridge%2Fpeft%2Futils.py",
      "sha": "c8a1aab57ab22c4faaf14699019ade2fb9d53569",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/4da9918175a5bd8d50b86806ddb1776a0825a3cc/tests%2Funit_tests%2Fpeft%2Ftest_module_matcher.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Fpeft%2Ftest_module_matcher.py?ref=4da9918175a5bd8d50b86806ddb1776a0825a3cc",
      "deletions": 0,
      "filename": "tests/unit_tests/peft/test_module_matcher.py",
      "patch": "@@ -71,6 +71,25 @@ def test_default_initialization(self):\n         assert matcher.exclude_modules == []\n         assert len(matcher.canonical_mapping) == 0\n \n+    @pytest.mark.unit\n+    @pytest.mark.parametrize(\"mode\", [\"target\", \"exclude\", \"canonical\"])\n+    def test_layer_wildcards_preserve_path_separators(self, mode: str) -> None:\n+        \"\"\"Selecting the first two layers must not include layers 10 through 19.\"\"\"\n+        patterns = [\"*.layers.0.*.linear_qkv\", \"*.layers.1.*.linear_qkv\"]\n+        if mode == \"exclude\":\n+            matcher = ModuleMatcher(target_modules=[], exclude_modules=patterns)\n+        elif mode == \"canonical\":\n+            matcher = ModuleMatcher(canonical_mapping={pattern: {\"linear_qkv\"} for pattern in patterns})\n+        else:\n+            matcher = ModuleMatcher(target_modules=patterns)\n+        module = nn.Linear(2, 2)\n+        selected = [\n+            layer\n+            for layer in range(24)\n+            if matcher.match(module, name=\"linear_qkv\", prefix=f\"decoder.layers.{layer}.self_attention\")\n+        ]\n+        assert selected == (list(range(2, 24)) if mode == \"exclude\" else [0, 1])\n+\n     def test_custom_target_modules(self):\n         \"\"\"Test ModuleMatcher with custom target modules.\"\"\"\n         target_modules = [\"linear_qkv\", \"linear_proj\"]",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/4da9918175a5bd8d50b86806ddb1776a0825a3cc/tests%2Funit_tests%2Fpeft%2Ftest_module_matcher.py",
      "sha": "ae3300e4b67068f21359bdb767bec860aca9dedf",
      "status": "modified"
    }
