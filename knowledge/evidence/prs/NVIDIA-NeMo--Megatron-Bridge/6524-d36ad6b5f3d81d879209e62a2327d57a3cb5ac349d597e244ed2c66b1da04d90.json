      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/docker%2FREADME.md?ref=611ebce0925f73f40eb5f38a33bbc71134ae3bb8",
      "deletions": 1,
      "filename": "docker/README.md",
      "patch": "@@ -250,7 +250,6 @@ docker build \\\n | `NEMO_EXPORT_DEPLOY_COMMIT` | NeMo Export-Deploy git commit SHA |\n | `NEMO_EVALUATOR_COMMIT` | NeMo Evaluator git commit SHA |\n | `NEMO_RUN_COMMIT` | NeMo Run git commit SHA |\n-| `CUDNN_FRONTEND_GIT_REF` | Commit of [NVIDIA/cudnn-frontend](https://github.com/NVIDIA/cudnn-frontend) (`feat/1.29.0-megatron`) installed over the PyPI cuDNN frontend after the environment sync; empty keeps the PyPI wheel. Docker-only, outside `fw_pyproject.toml`; skipped when `PRESERVE_BASE_RUNTIME=True`. |\n \n ---\n ",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/611ebce0925f73f40eb5f38a33bbc71134ae3bb8/docker%2FREADME.md",
      "sha": "3db8399c6153d35b9095fa8ec5a20795c456d206",
      "status": "modified"
    },
