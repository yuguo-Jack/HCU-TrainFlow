      "deletions": 13,
      "filename": "docker/Dockerfile.fw_final",
      "patch": "@@ -57,11 +57,6 @@ RUN    pushd /opt/Export-Deploy && \\\n         echo \"Container built with NeMo-Run commit hash: $NEMO_RUN_COMMIT\" && \\\n     popd\n \n-# cuDNN Frontend is replaced after the sync below with this ref of NVIDIA/cudnn-frontend\n-# (feat/1.29.0-megatron). Docker-only: outside fw_pyproject.toml and uv.lock. Set empty to keep the\n-# PyPI wheel.\n-ARG CUDNN_FRONTEND_GIT_REF=8924d4b41fd678ba1b98cd7f98bb78b222637573\n-\n # Sync environment\n COPY --chmod=644 docker/common/fw_pyproject.toml /opt/NeMo-FW/pyproject.toml\n COPY --chmod=644 docker/common/_version.py docker/common/print_sha.sh /opt/NeMo-FW/\n@@ -72,16 +67,8 @@ RUN \\\n     BASE_RUNTIME_UV_ARGS=\"\" && \\\n     if [ \"${MBRIDGE_PRESERVE_BASE_RUNTIME:-False}\" = \"True\" ]; then \\\n         BASE_RUNTIME_UV_ARGS=\"--no-install-package nvidia-cudnn-frontend --no-install-package transformer-engine --no-install-package transformer-engine-torch\"; \\\n-    elif [ -n \"$CUDNN_FRONTEND_GIT_REF\" ]; then \\\n-        BASE_RUNTIME_UV_ARGS=\"--no-install-package nvidia-cudnn-frontend\"; \\\n     fi && \\\n     uv sync --no-cache-dir --all-groups --inexact ${BASE_RUNTIME_UV_ARGS} && \\\n-    if [ -n \"$CUDNN_FRONTEND_GIT_REF\" ] && [ \"${MBRIDGE_PRESERVE_BASE_RUNTIME:-False}\" != \"True\" ]; then \\\n-        uv pip install --no-config --no-cache-dir --no-deps --reinstall \\\n-            \"nvidia-cudnn-frontend @ git+https://github.com/NVIDIA/cudnn-frontend.git@${CUDNN_FRONTEND_GIT_REF}\" && \\\n-        CUDNN_FRONTEND_GIT_REF=\"$CUDNN_FRONTEND_GIT_REF\" python -c \\\n-            'import importlib.metadata as m, json, os, sys; source = m.distribution(\"nvidia-cudnn-frontend\").read_text(\"direct_url.json\"); sys.exit(0 if json.loads(source)[\"vcs_info\"][\"commit_id\"] == os.environ[\"CUDNN_FRONTEND_GIT_REF\"] else \"cuDNN Frontend Git ref mismatch\")'; \\\n-    fi && \\\n     python /opt/preserve_base_runtime.py check /opt/base-runtime-packages.json && \\\n     uv pip list && \\\n     chmod +x print_sha.sh && \\",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/611ebce0925f73f40eb5f38a33bbc71134ae3bb8/docker%2FDockerfile.fw_final",
      "sha": "f029622fcc4a0184bf17aeca9e9aa470be24e7d0",
      "status": "modified"
    },
    {
      "additions": 0,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/611ebce0925f73f40eb5f38a33bbc71134ae3bb8/docker%2FREADME.md",
