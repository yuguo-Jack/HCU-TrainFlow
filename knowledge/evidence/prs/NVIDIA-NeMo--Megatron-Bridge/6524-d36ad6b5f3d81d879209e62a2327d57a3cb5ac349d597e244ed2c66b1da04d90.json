      "changes": 2,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/docker%2Fcommon%2Ffw_pyproject.toml?ref=611ebce0925f73f40eb5f38a33bbc71134ae3bb8",
      "deletions": 1,
      "filename": "docker/common/fw_pyproject.toml",
      "patch": "@@ -69,7 +69,7 @@ override-dependencies = [\n     \"packaging>=25.0\",\n     \"nvidia-pytriton>=0.7.0\",\n     \"flashinfer-python==0.6.18.post1\",          # Match flashinfer-cubin installed by MBridge\n-    \"nvidia-cudnn-frontend==1.29.0\",            # Match MBridge; override PyPI MCore's older dev pin\n+    \"nvidia-cudnn-frontend==1.29.1\",           # Match MBridge; override PyPI MCore's older dev pin\n     \"urllib3>=2.0.7\",\n     \"sh==2.2.4\",\n     \"jupyter-core==5.8.1\",",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/611ebce0925f73f40eb5f38a33bbc71134ae3bb8/docker%2Fcommon%2Ffw_pyproject.toml",
