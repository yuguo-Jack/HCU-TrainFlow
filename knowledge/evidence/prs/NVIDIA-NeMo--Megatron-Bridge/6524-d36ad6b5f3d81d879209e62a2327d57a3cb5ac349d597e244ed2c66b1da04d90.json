      "deletions": 5,
      "filename": "uv.lock",
      "patch": "@@ -27,7 +27,7 @@ overrides = [\n     { name = \"langchain\", specifier = \">=0.3.28\" },\n     { name = \"langchain-core\", specifier = \">=0.3.80\" },\n     { name = \"mlflow\", specifier = \">=3.16.0\" },\n-    { name = \"nvidia-cudnn-frontend\", specifier = \"==1.29.0\" },\n+    { name = \"nvidia-cudnn-frontend\", specifier = \"==1.29.1\" },\n     { name = \"nvidia-cutlass-dsl\", extras = [\"cu13\"], marker = \"sys_platform == 'never'\" },\n     { name = \"nvidia-modelopt\", specifier = \"==0.47.0\", index = \"https://pypi.nvidia.com/\" },\n     { name = \"onnx\", marker = \"python_full_version < '3.13'\", specifier = \">=1.21.0\" },\n@@ -2938,16 +2938,16 @@ wheels = [\n \n [[package]]\n name = \"nvidia-cudnn-frontend\"\n-version = \"1.29.0\"\n+version = \"1.29.1\"\n source = { registry = \"https://pypi.nvidia.com/\" }\n dependencies = [\n     { name = \"apache-tvm-ffi\" },\n     { name = \"nvidia-cutlass-dsl\", extra = [\"cu13\"], marker = \"sys_platform == 'never'\" },\n ]\n wheels = [\n-    { url = \"https://pypi.nvidia.com/nvidia-cudnn-frontend/nvidia_cudnn_frontend-1.29.0-cp312-cp312-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl\", hash = \"sha256:a3fb92256890b3027e59bb25a468ad2b8a474d2910e394edcf0b1c1015463f78\" },\n-    { url = \"https://pypi.nvidia.com/nvidia-cudnn-frontend/nvidia_cudnn_frontend-1.29.0-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl\", hash = \"sha256:596c9b7591457b4b49227fa2e22bd5960957a198e4336ce9ada8b5d2a1e4a5a1\" },\n-    { url = \"https://pypi.nvidia.com/nvidia-cudnn-frontend/nvidia_cudnn_frontend-1.29.0-cp312-cp312-win_amd64.whl\", hash = \"sha256:06e46b829c9f1c470e8aa78581a3af3a7041d869d7590a0e55aff6f2638be39e\" },\n+    { url = \"https://pypi.nvidia.com/nvidia-cudnn-frontend/nvidia_cudnn_frontend-1.29.1-cp312-cp312-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl\", hash = \"sha256:928d9f06b19a8b81ae67a3eb18205814c3647a0bbdd0c1634777dedc7e38bf1c\" },\n+    { url = \"https://pypi.nvidia.com/nvidia-