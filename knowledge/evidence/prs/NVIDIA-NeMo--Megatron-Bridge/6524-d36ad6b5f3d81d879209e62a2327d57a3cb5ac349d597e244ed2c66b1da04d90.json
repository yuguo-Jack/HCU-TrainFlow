      "filename": "pyproject.toml",
      "patch": "@@ -142,7 +142,7 @@ override-dependencies = [\n     \"langchain>=0.3.28\",                                    # To address CVE-2025-65106\n     \"langchain-core>=0.3.80\",                               # To address CVE-2025-65106\n     \"onnx>=1.21.0; python_version < '3.13'\",                # onnx<1.21 has missing lower bound on ml-dtypes, uses float4_e2m1fn (requires ml-dtypes>=0.5.0)\n-    \"nvidia-cudnn-frontend==1.29.0\",\n+    \"nvidia-cudnn-frontend==1.29.1\",\n     # Match MCore main: cuDNN Frontend 1.29 needs the newer TileLang/TVM FFI family.\n     \"tilelang==0.1.12\",\n     \"apache-tvm-ffi==0.1.11\",",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/611ebce0925f73f40eb5f38a33bbc71134ae3bb8/pyproject.toml",
