      "changes": 6,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Ftraining%2Fcheckpointing.py?ref=e5c2fd90f0824c8d070ac24bbe028c373eebd489",
      "deletions": 1,
      "filename": "src/megatron/bridge/training/checkpointing.py",
      "patch": "@@ -3836,7 +3836,11 @@ def _load_global_dist_base_checkpoint(\n     )\n     load_strategy = TorchDistLoadShardedStrategy()\n     if ckpt_cfg.fully_parallel_load:\n-        load_strategy = FullyParallelLoadStrategyWrapper(load_strategy, _checkpoint_dp_cp_group(pg_collection))\n+        load_strategy = FullyParallelLoadStrategyWrapper(\n+            load_strategy,\n+            _checkpoint_dp_cp_group(pg_collection),\n+            per_rank_object_load=ckpt_cfg.ckpt_fully_parallel_load_per_rank_objects,\n+        )\n     if checkpointing_context is not None:\n         checkpointing_context[\"load_strategy\"] = load_strategy\n     validate_sharding_integrity = True",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/e5c2fd90f0824c8d070ac24bbe028c373eebd489/src%2Fmegatron%2Fbridge%2Ftraining%2Fcheckpointing.py",
      "sha": "83523bf2df25589ce355b7645096ea4ccae7d461",
      "status": "modified"
    },
    {
      "additions": 39,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/e5c2fd90f0824c8d070ac24bbe028c373eebd489/tests%2Funit_tests%2Ftraining%2Ftest_checkpointing.py",
      "changes": 39,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Ftraining%2Ftest_checkpointing.py?ref=e5c2fd90f0824c8d070ac24bbe028c373eebd489",
      "deletions": 0,
      "filename": "tests/unit_tests/training/test_checkpointing.py",
      "patch": "@@ -102,6 +102,45 @@ class _DummyClass:\n     save_sharded_modelopt_state = None\n \n \n+@pytest.mark.unit\n+@pytest.mark.parametrize(\"per_rank_objects\", [False, True])\n+def test_global_checkpoint_load_forwards_per_rank_objects(per_rank_objects):\n+    \"\"\"The configured object-loading policy must reach the real Core strategy.\"\"\"\n+    from megatron.bridge.training import checkpointing\n+\n+    config = CheckpointConfig(\n+        async_save=False,\n+        fully_parallel_load=True,\n+        ckpt_fully_parallel_load_per_rank_objects=per_rank_objects,\n+    )\n+    group = Mock()\n+    pg = SimpleNamespace(dp_cp=Mock(), dp_cp_gtp_remat=group)\n+    context = {}\n+    with (\n+        patch.object(checkpointing, \"TorchDistLoadShardedStrategy\") as base_strategy,\n+        patch.object(checkpointing.dist_checkpointing, \"load\", return_value={\"model\": {}}) as load,\n+    ):\n+        result = checkpointing._load_global_dist_base_checkpoint(\n+            \"checkpoint\",\n+            config,\n+            False,\n+            {\"model\": {}},\n+            1,\n+            False,\n+            checkpoint_path_override=\"checkpoint/iter_0000001\",\n+            checkpointing_context=context,\n+            pg_collection=pg,\n+        )\n+\n+    strategy = load.call_args.args[2]\n+    assert isinstance(strategy, checkpointing.FullyParallelLoadStrategyWrapper)\n+    assert strategy.per_rank_object_load is per_rank_objects\n+    assert strategy.parallelization_group is group\n+    assert strategy.base_strategy is base_strategy.return_value\n+    assert context[\"load_strategy\"] is strategy\n+    assert result[0] == {\"model\": {}}\n+\n+\n def test_checkpoint_group_includes_gtp_and_supports_older_collections():\n     replica_group = Mock()\n     distribution_group = Mock()",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/e5c2fd90f0824c8d070ac24bbe028c373eebd489/tests%2Funit_tests%2Ftraining%2Ftest_checkpointing.py",
      "sha": "fdc2a997db381c10541bd61b5666581d451a7cd9",
      "status": "modified"
    }
