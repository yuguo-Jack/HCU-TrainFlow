      "additions": 9,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/8485413082e3ce6cab53f809067f450e9899eed2/docker%2FDockerfile.fw_final",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/docker%2FDockerfile.fw_final?ref=8485413082e3ce6cab53f809067f450e9899eed2",
      "deletions": 0,
      "filename": "docker/Dockerfile.fw_final",
      "patch": "@@ -57,6 +57,11 @@ RUN    pushd /opt/Export-Deploy && \\\n         echo \"Container built with NeMo-Run commit hash: $NEMO_RUN_COMMIT\" && \\\n     popd\n \n+# cuDNN Frontend is replaced after the sync below with this ref of NVIDIA/cudnn-frontend\n+# (feat/1.29.0-megatron). Docker-only: outside fw_pyproject.toml and uv.lock. Set empty to keep the\n+# PyPI wheel.\n+ARG CUDNN_FRONTEND_GIT_REF=8924d4b41fd678ba1b98cd7f98bb78b222637573\n+\n # Sync environment\n COPY --chmod=644 docker/common/fw_pyproject.toml /opt/NeMo-FW/pyproject.toml\n COPY --chmod=644 docker/common/_version.py docker/common/print_sha.sh /opt/NeMo-FW/\n@@ -69,6 +74,10 @@ RUN \\\n         BASE_RUNTIME_UV_ARGS=\"--no-install-package nvidia-cudnn-frontend --no-install-package transformer-engine --no-install-package transformer-engine-torch\"; \\\n     fi && \\\n     uv sync --no-cache-dir --all-groups --inexact ${BASE_RUNTIME_UV_ARGS} && \\\n+    if [ -n \"$CUDNN_FRONTEND_GIT_REF\" ] && [ \"${MBRIDGE_PRESERVE_BASE_RUNTIME:-False}\" != \"True\" ]; then \\\n+        uv pip install --no-cache-dir --no-deps --reinstall \\\n+            \"nvidia-cudnn-frontend @ git+https://github.com/NVIDIA/cudnn-frontend.git@${CUDNN_FRONTEND_GIT_REF}\"; \\\n+    fi && \\\n     python /opt/preserve_base_runtime.py check /opt/base-runtime-packages.json && \\\n     uv pip list && \\\n     chmod +x print_sha.sh && \\",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/8485413082e3ce6cab53f809067f450e9899eed2/docker%2FDockerfile.fw_final",
      "sha": "635dcca7a233a855282783301436cd2421d37324",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/8485413082e3ce6cab53f809067f450e9899eed2/docker%2FREADME.md",
      "changes": 1,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/docker%2FREADME.md?ref=8485413082e3ce6cab53f809067f450e9899eed2",
      "deletions": 0,
      "filename": "docker/README.md",
      "patch": "@@ -250,6 +250,7 @@ docker build \\\n | `NEMO_EXPORT_DEPLOY_COMMIT` | NeMo Export-Deploy git commit SHA |\n | `NEMO_EVALUATOR_COMMIT` | NeMo Evaluator git commit SHA |\n | `NEMO_RUN_COMMIT` | NeMo Run git commit SHA |\n+| `CUDNN_FRONTEND_GIT_REF` | Commit of [NVIDIA/cudnn-frontend](https://github.com/NVIDIA/cudnn-frontend) (`feat/1.29.0-megatron`) installed over the PyPI cuDNN frontend after the environment sync; empty keeps the PyPI wheel. Docker-only, outside `fw_pyproject.toml`; skipped when `PRESERVE_BASE_RUNTIME=True`. |\n \n ---\n ",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/8485413082e3ce6cab53f809067f450e9899eed2/docker%2FREADME.md",
      "sha": "f69f61bbb13608a8134a379f46149ed1b100ca47",
      "status": "modified"
    }
