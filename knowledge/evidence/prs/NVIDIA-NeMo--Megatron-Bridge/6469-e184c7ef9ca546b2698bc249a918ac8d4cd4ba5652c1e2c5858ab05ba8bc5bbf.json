      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Ftraining%2Fcheckpointing.py?ref=0de0e5c78169ed7a8ef89b66521f48974b488c2d",
      "deletions": 4,
      "filename": "src/megatron/bridge/training/checkpointing.py",
      "patch": "@@ -2909,6 +2909,7 @@ def _load_checkpoint_from_path(\n         - num_floating_point_operations_so_far: The total FLOPs computed so far.\n     \"\"\"\n     cfg = state.cfg\n+    wrapped_model = model\n     model = unwrap_model(model)\n     pg_collection = pg_collection or get_pg_collection(model)\n     ckpt_format = cfg.checkpoint.ckpt_format\n@@ -3336,14 +3337,15 @@ def _load_checkpoint_from_path(\n         )\n         load_strict = False if is_peft_resume else strict\n \n-        if len(model) == 1:\n-            _load_model_state_dict(model[0], state_dict[\"model\"], load_strict)\n+        if len(wrapped_model) == 1:\n+            # MFSDP V2's adapter also refreshes BF16 compute weights after loading main weights.\n+            _load_model_state_dict(wrapped_model[0], state_dict[\"model\"], load_strict)\n         else:\n-            for i in range(len(model)):\n+            for i, model_chunk in enumerate(wrapped_model):\n                 model_key = \"model%d\" % i\n                 if model_key not in state_dict:\n                     continue\n-                _load_model_state_dict(model[i], state_dict[model_key], load_strict)\n+                _load_model_state_dict(model_chunk, state_dict[model_key], load_strict)\n \n     checkpoint_version = get_checkpoint_version()\n     print_rank_0(f\" checkpoint version {checkpoint_version}\")",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/0de0e5c78169ed7a8ef89b66521f48974b488c2d/src%2Fmegatron%2Fbridge%2Ftraining%2Fcheckpointing.py",
      "sha": "5ee5ea5b95e67c8712b367aa386b422cf02007aa",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/0de0e5c78169ed7a8ef89b66521f48974b488c2d/src%2Fmegatron%2Fbridge%2Ftraining%2Fconfig.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Ftraining%2Fconfig.py?ref=0de0e5c78169ed7a8ef89b66521f48974b488c2d",
      "deletions": 3,
      "filename": "src/megatron/bridge/training/config.py",
      "patch": "@@ -1161,8 +1161,8 @@ def _validate_and_apply_megatron_fsdp_v2_configs(self) -> None:\n \n         MFSDP V2 owns its sharded parameter and gradient storage, so it must use\n         its dedicated optimizer rather than Bridge's distributed-optimizer path.\n-        Checkpointing and tensor/pipeline parallelism remain intentionally unsupported\n-        upstream and are rejected here before model construction.\n+        Tensor/pipeline parallelism remains unsupported and is rejected here\n+        before model construction. Checkpoints use the fsdp_dtensor format.\n         \"\"\"\n         if not self.model.bf16 or self.model.fp16 or not self.optimizer.bf16 or self.optimizer.fp16:\n             raise ValueError(\"MFSDP V2 requires BF16 training (model.bf16=True and optimizer.bf16=True).\")\n@@ -1190,7 +1190,8 @@ def _validate_and_apply_megatron_fsdp_v2_configs(self) -> None:\n         if self.rng.data_parallel_random_init:\n             raise ValueError(\"MFSDP V2 does not support data_parallel_random_init.\")\n         if self.checkpoint.save is not None or self.checkpoint.load is not None:\n-            raise ValueError(\"MFSDP V2 checkpoint save and load are not yet supported.\")\n+            if self.checkpoint.ckpt_format != \"fsdp_dtensor\":\n+                raise ValueError(\"MFSDP V2 requires the fsdp_dtensor checkpointing format.\")\n         if self.checkpoint.pretrained_checkpoint is not None:\n             raise ValueError(\"MFSDP V2 checkpoint loading is not yet supported.\")\n         if self.optimizer.loss_scale is not None:",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/0de0e5c78169ed7a8ef89b66521f48974b488c2d/src%2Fmegatron%2Fbridge%2Ftraining%2Fconfig.py",
      "sha": "a20e07ee675f84000cba4e4daf21e38dd2233efe",
