  "files": [
    {
      "additions": 3,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/67c27cb8b7532f369ce7ae72de29e4dece3dd12d/.github%2Factions%2Ftest-template%2Faction.yml",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/.github%2Factions%2Ftest-template%2Faction.yml?ref=67c27cb8b7532f369ce7ae72de29e4dece3dd12d",
      "deletions": 0,
      "filename": ".github/actions/test-template/action.yml",
      "patch": "@@ -122,6 +122,9 @@ runs:\n         echo \"::group::Start test container\"\n         if [[ \"$MOUNT_FS\" == \"true\" ]]; then\n           VOLUME_ARGS=\"--volume ${{ inputs.test-data-path }}:/home/TestData --env HF_HUB_OFFLINE=1\"\n+          # The shared offline cache may be read-only to the container user.\n+          # All ranks in these single-container jobs share this writable lock directory.\n+          VOLUME_ARGS+=\" --env MEGATRON_CONFIG_LOCK_DIR=/home/ubuntu/.cache/huggingface\"\n           HF_HOME=/home/TestData/HF_HOME\n           NEMO_HOME=/home/TestData/nemo_home\n         else",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/67c27cb8b7532f369ce7ae72de29e4dece3dd12d/.github%2Factions%2Ftest-template%2Faction.yml",
      "sha": "f340bdae783381a9209a2d151d7ace87c30fdfa4",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/67c27cb8b7532f369ce7ae72de29e4dece3dd12d/tests%2Funit_tests%2Fci%2Ftest_test_template.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Fci%2Ftest_test_template.py?ref=67c27cb8b7532f369ce7ae72de29e4dece3dd12d",
      "deletions": 0,
      "filename": "tests/unit_tests/ci/test_test_template.py",
      "patch": "@@ -85,3 +85,35 @@ def test_container_startup_cannot_override_gcp_test_environment(\n         \"NVTE_FLASH_ATTN_V3\": \"0\",\n         \"NVTE_FLASH_ATTN_V4\": \"0\",\n     }\n+\n+\n+@pytest.mark.parametrize(\"mount_fs\", [True, False])\n+def test_mounted_cache_uses_container_local_config_locks(tmp_path: Path, mount_fs: bool) -> None:\n+    action = yaml.safe_load(ACTION.read_text())\n+    start = next(step[\"run\"] for step in action[\"runs\"][\"steps\"] if step.get(\"name\") == \"Start container\")\n+    expressions = {\n+        \"inputs.test-data-path\": \"/shared/test-data\",\n+        \"github.run_id\": \"123\",\n+        \"inputs.runner\": \"nemo-ci-gcp-gpu-x2\",\n+        \"inputs.shard-id\": \"\",\n+        \"inputs.num-shards\": \"\",\n+        \"inputs.container-image\": \"test-image\",\n+        \"inputs.timeout\": \"1\",\n+    }\n+    start = re.sub(r\"\\$\\{\\{\\s*(.*?)\\s*\\}\\}\", lambda match: expressions[match[1]], start)\n+    docker = tmp_path / \"docker\"\n+    docker.write_text('#!/bin/sh\\n[ \"$1\" != run ] || printf \"%s\\\\n\" \"$@\" > docker-args\\n')\n+    docker.chmod(0o755)\n+    env = {**os.environ, \"PATH\": f\"{tmp_path}:{os.environ['PATH']}\", \"MOUNT_FS\": str(mount_fs).lower()}\n+    subprocess.run([\"bash\", \"-c\", start], cwd=tmp_path, env=env, check=True, capture_output=True, text=True)\n+    args = (tmp_path / \"docker-args\").read_text().splitlines()\n+    container_env = dict(args[i + 1].split(\"=\", 1) for i, arg in enumerate(args) if arg == \"--env\")\n+    if mount_fs:\n+        assert container_env[\"HF_HOME\"] == \"/home/TestData/HF_HOME\"\n+        assert container_env[\"HF_HUB_OFFLINE\"] == \"1\"\n+        assert container_env[\"MEGATRON_CONFIG_LOCK_DIR\"] == \"/home/ubuntu/.cache/huggingface\"\n+        assert args[args.index(\"--volume\") + 1] == \"/shared/test-data:/home/TestData\"\n+    else:\n+        assert \"MEGATRON_CONFIG_LOCK_DIR\" not in container_env\n+        assert \"HF_HUB_OFFLINE\" not in container_env\n+        assert \"--volume\" not in args",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/67c27cb8b7532f369ce7ae72de29e4dece3dd12d/tests%2Funit_tests%2Fci%2Ftest_test_template.py",
      "sha": "73a5104465ff501a1a6f54f1ea0139c972b8ad15",
      "status": "modified"
    }
