      "changes": 12,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Fmodels%2Fconversion%2Fmodel_bridge.py?ref=04c9ff7a5a30e612ad656e81c2ed2a8ba05199c8",
      "deletions": 0,
      "filename": "src/megatron/bridge/models/conversion/model_bridge.py",
      "patch": "@@ -626,6 +626,14 @@ def postprocess_hf_export_weights(self, path: Path) -> None:\n         (\"mscale_all_dim\", \"yarn_mscale_all_dim\"),\n     ]\n \n+    # Hugging Face YaRN defaults (transformers' _compute_yarn_parameters) for keys a\n+    # checkpoint omits: (megatron_param, default)\n+    YARN_HF_DEFAULTS = [\n+        (\"yarn_beta_fast\", 32.0),\n+        (\"yarn_beta_slow\", 1.0),\n+        (\"yarn_correction_range_round_to_int\", True),\n+    ]\n+\n     # MLA rope scaling field mapping: (hf_rope_scaling_key, megatron_mla_param)\n     # These are applied for MLA models (DeepSeek, Kimi, etc.) which use MLATransformerConfig\n     # Uses direct field names without yarn_ prefix (e.g., mscale, rotary_scaling_factor)\n@@ -735,6 +743,10 @@ def _hf_config_to_megatron_kwargs(self, hf_config: PretrainedConfig) -> dict[str\n                         provider_kwargs[megatron_key] = value\n                 if \"truncate\" in rope_scaling:\n                     provider_kwargs[\"yarn_correction_range_round_to_int\"] = rope_scaling[\"truncate\"]\n+                # Apply Hugging Face YaRN defaults for omitted keys. Megatron Core passes these\n+                # fields to YarnRotaryEmbedding explicitly, so None would override its defaults.\n+                for megatron_key, default in self.YARN_HF_DEFAULTS:\n+                    provider_kwargs.setdefault(megatron_key, default)\n         elif is_mla_provider:\n             if rope_type not in (None, \"default\"):\n                 logger.warning(",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/04c9ff7a5a30e612ad656e81c2ed2a8ba05199c8/src%2Fmegatron%2Fbridge%2Fmodels%2Fconversion%2Fmodel_bridge.py",
      "sha": "ac623672083ac8ae0b2da91bdb2c88ec35e69def",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/04c9ff7a5a30e612ad656e81c2ed2a8ba05199c8/src%2Fmegatron%2Fbridge%2Fmodels%2Fqwen%2Fqwen3_bridge.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Fmodels%2Fqwen%2Fqwen3_bridge.py?ref=04c9ff7a5a30e612ad656e81c2ed2a8ba05199c8",
      "deletions": 7,
      "filename": "src/megatron/bridge/models/qwen/qwen3_bridge.py",
      "patch": "@@ -59,14 +59,8 @@ def hf_config_to_model_config_kwargs(self, hf_config: PretrainedConfig) -> dict[\n             rope_scaling=False,\n             rope_scaling_factor=1.0,\n         )\n-        # The shared mapping already selects \"yarn\" for YaRN-scaled checkpoints.\n+        # The shared mapping already selects \"yarn\" and its Hugging Face defaults for YaRN-scaled checkpoints.\n         config_kwargs.setdefault(\"position_embedding_type\", \"rope\")\n-        if config_kwargs[\"position_embedding_type\"] == \"yarn\":\n-            # Qwen3 YaRN configs usually omit these keys; apply the Hugging Face defaults\n-            # instead of passing None to Megatron Core.\n-            config_kwargs.setdefault(\"yarn_beta_fast\", 32.0)\n-            config_kwargs.setdefault(\"yarn_beta_slow\", 1.0)\n-            config_kwargs.setdefault(\"yarn_correction_range_round_to_int\", True)\n         return config_kwargs\n \n     def hf_config_to_provider_kwargs(self, hf_config: PretrainedConfig) -> dict[str, Any]:",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/04c9ff7a5a30e612ad656e81c2ed2a8ba05199c8/src%2Fmegatron%2Fbridge%2Fmodels%2Fqwen%2Fqwen3_bridge.py",
