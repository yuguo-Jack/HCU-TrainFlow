      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/a5a4f6f3bb8973cdcdcb67ccb9719de5bd98f0c8/src%2Fmegatron%2Fbridge%2Fperf_recipes%2Fdeepseek%2Fgb300%2Fdeepseek_v3.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/src%2Fmegatron%2Fbridge%2Fperf_recipes%2Fdeepseek%2Fgb300%2Fdeepseek_v3.py?ref=a5a4f6f3bb8973cdcdcb67ccb9719de5bd98f0c8",
      "deletions": 1,
      "filename": "src/megatron/bridge/perf_recipes/deepseek/gb300/deepseek_v3.py",
      "patch": "@@ -473,7 +473,9 @@ def deepseek_v3_pretrain_256gpu_gb300_fp8mx_hsdp_config() -> ConfigContainer:\n     cfg.train.global_batch_size = 1024\n \n     cfg.ddp.outer_dp_sharding_strategy = \"optim\"\n-    cfg.ddp.expert_outer_dp_sharding_strategy = \"no_shard\"\n+    # Megatron-FSDP v1 applies outer_dp_sharding_strategy to expert parameters as well and\n+    # ignores this field; v2 honors it. Keep both sharding expert optimizer state over DP-outer.\n+    cfg.ddp.expert_outer_dp_sharding_strategy = \"optim\"\n     cfg.ddp.num_distributed_optimizer_instances = 4\n \n     cfg.model.fp8_param_gather = True",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/a5a4f6f3bb8973cdcdcb67ccb9719de5bd98f0c8/src%2Fmegatron%2Fbridge%2Fperf_recipes%2Fdeepseek%2Fgb300%2Fdeepseek_v3.py",
      "sha": "82146da1da5305383e4ac48377853855c71be28e",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/blob/a5a4f6f3bb8973cdcdcb67ccb9719de5bd98f0c8/tests%2Funit_tests%2Frecipes%2Ftest_gb300_ncclep_perf_recipes.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA-NeMo/Megatron-Bridge/contents/tests%2Funit_tests%2Frecipes%2Ftest_gb300_ncclep_perf_recipes.py?ref=a5a4f6f3bb8973cdcdcb67ccb9719de5bd98f0c8",
      "deletions": 0,
      "filename": "tests/unit_tests/recipes/test_gb300_ncclep_perf_recipes.py",
      "patch": "@@ -170,6 +170,15 @@ def test_gb300_deepseek_hsdp_uses_hybridep() -> None:\n     assert cfg.env_vars.keys().isdisjoint(_NCCL_EP_ENV)\n \n \n+def test_gb300_deepseek_hsdp_shards_expert_optimizer_state_over_dp_outer() -> None:\n+    # Megatron-FSDP v1 shards expert optimizer state with outer_dp_sharding_strategy; v2 reads\n+    # expert_outer_dp_sharding_strategy, so both must agree for v1 and v2 to train the same way.\n+    cfg = _build(\"deepseek.gb300.deepseek_v3\", \"deepseek_v3_pretrain_256gpu_gb300_fp8mx_hsdp_config\")\n+\n+    assert cfg.ddp.num_distributed_optimizer_instances > 1\n+    assert cfg.ddp.expert_outer_dp_sharding_strategy == cfg.ddp.outer_dp_sharding_strategy == \"optim\"\n+\n+\n @pytest.mark.parametrize((\"module_name\", \"factory_name\"), _VRNVL72_NON_NCCLEP_RECIPES, ids=lambda value: value)\n def test_vrnvl72_recipes_left_off_nccl_ep_do_not_inherit_it(module_name: str, factory_name: str) -> None:\n     cfg = _build(module_name, factory_name)",
      "raw_url": "https://github.com/NVIDIA-NeMo/Megatron-Bridge/raw/a5a4f6f3bb8973cdcdcb67ccb9719de5bd98f0c8/tests%2Funit_tests%2Frecipes%2Ftest_gb300_ncclep_perf_recipes.py",
      "sha": "688ab0813b23695b0e5262b261e43706ebd876f0",
      "status": "modified"
    }
