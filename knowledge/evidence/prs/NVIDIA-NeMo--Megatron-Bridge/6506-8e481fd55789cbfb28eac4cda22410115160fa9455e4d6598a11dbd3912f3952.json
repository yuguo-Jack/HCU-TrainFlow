      "filename": ".github/autobot/review-config.yml",
      "patch": "@@ -0,0 +1,9 @@\n+# .github/autobot/review-config.yml\n+# Read from the default branch; changes take effect after merge.\n+# Formal verdicts require approval.enabled and active membership in an eligible team.\n+approval:\n+  enabled: true\n+  eligible_teams:\n+    - lm_team\n+    - lm_maintainers\n+    - automation",
