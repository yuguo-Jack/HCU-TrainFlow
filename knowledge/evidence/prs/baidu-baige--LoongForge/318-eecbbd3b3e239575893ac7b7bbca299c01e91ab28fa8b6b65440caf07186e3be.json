      "patch": "@@ -63,7 +63,7 @@ gpu = [\n     # NLP / dataset utils\n     \"jsonlines==4.0.0\",\n     \"ftfy==6.1.3\",\n-    \"nltk==3.10.3\",\n+    \"nltk==3.10.4\",\n     \"py-cpuinfo==9.0.0\",\n     # Monitoring / logging\n     \"wandb==0.24.2\",",
