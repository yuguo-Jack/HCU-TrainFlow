  "files": [
    {
      "additions": 32,
      "blob_url": "https://github.com/baidu-baige/LoongForge/blob/bb58dc5f4b29b232bd2b426e3cc7c2daf0166a15/tests%2Fllm_vlm%2Funit%2Ftest_ckpt_util_shard_pattern.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/baidu-baige/LoongForge/contents/tests%2Fllm_vlm%2Funit%2Ftest_ckpt_util_shard_pattern.py?ref=bb58dc5f4b29b232bd2b426e3cc7c2daf0166a15",
      "deletions": 0,
      "filename": "tests/llm_vlm/unit/test_ckpt_util_shard_pattern.py",
      "patch": "@@ -0,0 +1,32 @@\n+# Copyright 2026 The LoongForge Authors.\n+# SPDX-License-Identifier: Apache-2.0\n+# Purpose: Verify sharded HuggingFace safetensors loading.\n+\n+\"\"\"Checks for loading sharded HuggingFace checkpoints in conversion tools.\"\"\"\n+\n+import sys\n+from pathlib import Path\n+\n+import pytest\n+import torch\n+from safetensors.torch import save_file\n+\n+# tests/llm_vlm/unit -> tests/llm_vlm -> tests -> repo root, then repo-root tools/\n+sys.path.insert(0, str(Path(__file__).resolve().parents[3] / \"tools\"))\n+\n+from mcore_checkpoint_convert.utils.ckpt_util import load_huggingface_checkpoint\n+\n+\n+@pytest.mark.parametrize(\n+    \"pattern\",\n+    [\n+        \"model-{:05d}-of-{:05d}.safetensors\",\n+        \"model-{:05d}-of-{:06d}.safetensors\",  # e.g. DeepSeek-V3 / Kimi-K2 shards\n+        \"model.safetensors-{:05d}-of-{:05d}.safetensors\",\n+    ],\n+)\n+def test_load_sharded_checkpoint_keeps_filename_padding(tmp_path, pattern):\n+    save_file({\"a\": torch.ones(1)}, str(tmp_path / pattern.format(1, 2)))\n+    save_file({\"b\": torch.zeros(1)}, str(tmp_path / pattern.format(2, 2)))\n+\n+    assert sorted(load_huggingface_checkpoint(str(tmp_path))) == [\"a\", \"b\"]",
      "raw_url": "https://github.com/baidu-baige/LoongForge/raw/bb58dc5f4b29b232bd2b426e3cc7c2daf0166a15/tests%2Fllm_vlm%2Funit%2Ftest_ckpt_util_shard_pattern.py",
      "sha": "31473564014ed0a742e5de92053f9f08fee943e2",
      "status": "added"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/baidu-baige/LoongForge/blob/bb58dc5f4b29b232bd2b426e3cc7c2daf0166a15/tools%2Fmcore_checkpoint_convert%2Futils%2Fckpt_util.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/baidu-baige/LoongForge/contents/tools%2Fmcore_checkpoint_convert%2Futils%2Fckpt_util.py?ref=bb58dc5f4b29b232bd2b426e3cc7c2daf0166a15",
      "deletions": 4,
      "filename": "tools/mcore_checkpoint_convert/utils/ckpt_util.py",
      "patch": "@@ -24,11 +24,11 @@ def _detect_shard_pattern(path):\n     \"\"\"\n     for name in os.listdir(path):\n         # Pattern 1: model-00001-of-00016.safetensors  (split_torch_state_dict_into_shards)\n-        if re.match(r\"^model-\\d+-of-\\d+\\.safetensors$\", name):\n-            return \"model-{:05d}-of-{:05d}.safetensors\"\n         # Pattern 2: model.safetensors-00001-of-00016.safetensors  (original HF hub)\n-        if re.match(r\"^model\\.safetensors-\\d+-of-\\d+\\.safetensors$\", name):\n-            return \"model.safetensors-{:05d}-of-{:05d}.safetensors\"\n+        m = re.match(r\"^(model-|model\\.safetensors-)(\\d+)-of-(\\d+)\\.safetensors$\", name)\n+        if m:\n+            # Keep the zero-padding widths used on disk, e.g. model-00001-of-000163.\n+            return f\"{m.group(1)}{{:0{len(m.group(2))}d}}-of-{{:0{len(m.group(3))}d}}.safetensors\"\n     raise FileNotFoundError(\n         f\"No sharded safetensors files found in {path}. \"\n         \"Expected files matching 'model-*-of-*.safetensors' or 'model.safetensors-*-of-*.safetensors'.\"",
      "raw_url": "https://github.com/baidu-baige/LoongForge/raw/bb58dc5f4b29b232bd2b426e3cc7c2daf0166a15/tools%2Fmcore_checkpoint_convert%2Futils%2Fckpt_util.py",
      "sha": "440eef841ec36c9edc5d84fbeb4c06db493c6afc",
      "status": "modified"
    }
  ],
