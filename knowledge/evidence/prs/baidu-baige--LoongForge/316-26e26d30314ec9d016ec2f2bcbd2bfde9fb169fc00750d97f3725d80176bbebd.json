  "files": [
    {
      "additions": 29,
      "blob_url": "https://github.com/baidu-baige/LoongForge/blob/17eb1cec2ad6220ce786e8a0d41b120ff4e8ea0d/loongforge%2Fembodied%2Feval%2Fservers%2Floongforge_server.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/baidu-baige/LoongForge/contents/loongforge%2Fembodied%2Feval%2Fservers%2Floongforge_server.py?ref=17eb1cec2ad6220ce786e8a0d41b120ff4e8ea0d",
      "deletions": 0,
      "filename": "loongforge/embodied/eval/servers/loongforge_server.py",
      "patch": "@@ -81,6 +81,34 @@ def start_health_server(port: int, ckpt_path: str) -> None:\n     thread.start()\n \n \n+def _release_loader_cached_memory() -> None:\n+    \"\"\"Return allocator-cached blocks left over by model loading to the driver.\n+\n+    Several factories build in fp32 and cast to bf16 at the end (pi05, xvla,\n+    GR00T, DreamZero), and some stage the checkpoint tensors on the GPU before\n+    copying them into the parameters. PyTorch keeps those freed blocks in its\n+    caching allocator, so ``nvidia-smi`` shows the transient high-water mark\n+    instead of the live weight size. On a shared card that memory is invisible\n+    to other processes (e.g. a co-located simulator) until it is released.\n+\n+    Only cached blocks are freed; live parameters are untouched. Called before\n+    warmup so the warmup activations populate a clean cache.\n+    \"\"\"\n+    import torch\n+\n+    if not torch.cuda.is_available():\n+        return\n+    reserved_before = torch.cuda.memory_reserved()\n+    torch.cuda.empty_cache()\n+    reserved_after = torch.cuda.memory_reserved()\n+    if reserved_after != reserved_before:\n+        logging.info(\n+            \"Released allocator-cached memory after model load: reserved %.2f GiB -> %.2f GiB\",\n+            reserved_before / 2**30,\n+            reserved_after / 2**30,\n+        )\n+\n+\n def main() -> None:\n     \"\"\"Run main.\"\"\"\n     import argparse\n@@ -98,6 +126,7 @@ def main() -> None:\n \n     logging.basicConfig(level=logging.INFO, force=True)\n     model_spec = build_model_spec(server_args, raw_model_dict)\n+    _release_loader_cached_memory()\n     _warmup_model(model_spec)\n     policy = GenericPredictActionPolicy(\n         model=model_spec.model,",
      "raw_url": "https://github.com/baidu-baige/LoongForge/raw/17eb1cec2ad6220ce786e8a0d41b120ff4e8ea0d/loongforge%2Fembodied%2Feval%2Fservers%2Floongforge_server.py",
      "sha": "1744affe73bc1c55f494b87849f828e83f4d5e30",
      "status": "modified"
    },
    {
      "additions": 44,
      "blob_url": "https://github.com/baidu-baige/LoongForge/blob/17eb1cec2ad6220ce786e8a0d41b120ff4e8ea0d/loongforge%2Fembodied%2Feval%2Funit_tests%2Ftest_server_memory_release.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/baidu-baige/LoongForge/contents/loongforge%2Fembodied%2Feval%2Funit_tests%2Ftest_server_memory_release.py?ref=17eb1cec2ad6220ce786e8a0d41b120ff4e8ea0d",
      "deletions": 0,
      "filename": "loongforge/embodied/eval/unit_tests/test_server_memory_release.py",
      "patch": "@@ -0,0 +1,44 @@\n+# Copyright 2026 The LoongForge Authors.\n+# SPDX-License-Identifier: Apache-2.0\n+\n+\"\"\"Tests for releasing allocator-cached memory after model loading.\"\"\"\n+\n+from __future__ import annotations\n+\n+import torch\n+\n+from loongforge.embodied.eval.servers import loongforge_server\n+\n+\n+def test_release_cached_memory_calls_empty_cache_on_cuda(monkeypatch) -> None:\n+    calls = {\"empty_cache\": 0, \"reserved\": 0}\n+\n+    def fake_reserved() -> int:\n+        calls[\"reserved\"] += 1\n+        return 16 * 2**30 if calls[\"reserved\"] == 1 else 8 * 2**30\n+\n+    def fake_empty_cache() -> None:\n+        calls[\"empty_cache\"] += 1\n+\n+    monkeypatch.setattr(torch.cuda, \"is_available\", lambda: True)\n+    monkeypatch.setattr(torch.cuda, \"memory_reserved\", fake_reserved)\n+    monkeypatch.setattr(torch.cuda, \"empty_cache\", fake_empty_cache)\n+\n+    loongforge_server._release_loader_cached_memory()\n+\n+    assert calls[\"empty_cache\"] == 1\n+    assert calls[\"reserved\"] == 2\n+\n+\n+def test_release_cached_memory_is_a_noop_without_cuda(monkeypatch) -> None:\n+    calls = {\"empty_cache\": 0}\n+\n+    def fake_empty_cache() -> None:\n+        calls[\"empty_cache\"] += 1\n+\n+    monkeypatch.setattr(torch.cuda, \"is_available\", lambda: False)\n+    monkeypatch.setattr(torch.cuda, \"empty_cache\", fake_empty_cache)\n+\n+    loongforge_server._release_loader_cached_memory()\n+\n+    assert calls[\"empty_cache\"] == 0",
      "raw_url": "https://github.com/baidu-baige/LoongForge/raw/17eb1cec2ad6220ce786e8a0d41b120ff4e8ea0d/loongforge%2Fembodied%2Feval%2Funit_tests%2Ftest_server_memory_release.py",
      "sha": "00b58c5aaeccadfdab2f465be89b902e18218722",
      "status": "added"
    }
  ],
