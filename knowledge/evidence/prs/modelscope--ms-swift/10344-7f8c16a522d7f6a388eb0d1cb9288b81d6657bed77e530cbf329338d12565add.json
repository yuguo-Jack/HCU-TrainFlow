      "additions": 5,
      "blob_url": "https://github.com/modelscope/ms-swift/blob/29dd512a687acf9f6c4ec48e19cfab44eb3c3bf6/swift%2Futils%2Fio_utils.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/swift%2Futils%2Fio_utils.py?ref=29dd512a687acf9f6c4ec48e19cfab44eb3c3bf6",
      "deletions": 1,
      "filename": "swift/utils/io_utils.py",
      "patch": "@@ -117,6 +117,10 @@ def update_last_checkpoint_symlink(checkpoint_dir: str) -> Optional[str]:\n     target is relative (just the checkpoint directory name) so the output directory stays movable, and it is\n     swapped in with `os.replace` so readers never observe a missing link. Returns the link path, or None if it\n     could not be created (e.g. a filesystem without symlink support).\n+\n+    The staging symlink carries the pid of this writer: a fixed name (`last-checkpoint.tmp`) let two\n+    concurrent saves remove each other's staging link, so one caller could publish another's target and a\n+    second could lose its staging path entirely (#10336).\n     \"\"\"\n     if not os.path.isdir(checkpoint_dir):\n         return None\n@@ -125,7 +129,7 @@ def update_last_checkpoint_symlink(checkpoint_dir: str) -> Optional[str]:\n     if os.path.lexists(link_path) and not os.path.islink(link_path):\n         logger.warning(f'`{link_path}` already exists and is not a symlink; skip updating it.')\n         return None\n-    tmp_path = f'{link_path}.tmp'\n+    tmp_path = f'{link_path}.{os.getpid()}.tmp'\n     try:\n         if os.path.lexists(tmp_path):\n             os.remove(tmp_path)",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/29dd512a687acf9f6c4ec48e19cfab44eb3c3bf6/swift%2Futils%2Fio_utils.py",
      "sha": "ce6ab6c6a390fe5cf309c58f892aa2f25ad0c02a",
      "status": "modified"
    },
    {
      "additions": 24,
      "blob_url": "https://github.com/modelscope/ms-swift/blob/29dd512a687acf9f6c4ec48e19cfab44eb3c3bf6/tests%2Futils%2Ftest_io_utils.py",
      "changes": 25,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/tests%2Futils%2Ftest_io_utils.py?ref=29dd512a687acf9f6c4ec48e19cfab44eb3c3bf6",
      "deletions": 1,
      "filename": "tests/utils/test_io_utils.py",
      "patch": "@@ -57,7 +57,30 @@ def test_last_checkpoint_symlink(self):\n \n         update_last_checkpoint_symlink(self._make_checkpoint(4))\n         self.assertEqual(os.readlink(link_path), 'checkpoint-4')\n-        self.assertFalse(os.path.lexists(f'{link_path}.tmp'))\n+        # The staging link carries this writer's pid and is consumed by the replace.\n+        self.assertFalse(os.path.lexists(f'{link_path}.{os.getpid()}.tmp'))\n+\n+    def test_last_checkpoint_symlink_concurrent_writers(self):\n+        # Two saves interleaving must not publish each other's target: with a\n+        # shared `last-checkpoint.tmp` staging name, writer A's replace could\n+        # land writer B's checkpoint and B could lose its staging link (#10336).\n+        link_path = os.path.join(self.tmp_dir, LAST_CHECKPOINT_SYMLINK)\n+        stage_a = update_last_checkpoint_symlink(self._make_checkpoint(2))\n+        self.assertEqual(stage_a, link_path)\n+        # Writer B stages under its own pid while A's replace is \"in flight\".\n+        pid_b = os.getpid() + 1\n+        tmp_b = f'{link_path}.{pid_b}.tmp'\n+        os.symlink('checkpoint-3', tmp_b)\n+\n+        # A's next update only touches its own staging name: B's survives.\n+        update_last_checkpoint_symlink(self._make_checkpoint(4))\n+        self.assertEqual(os.readlink(link_path), 'checkpoint-4')\n+        self.assertEqual(os.readlink(tmp_b), 'checkpoint-3')\n+        self.assertFalse(os.path.lexists(f'{link_path}.{os.getpid()}.tmp'))\n+\n+        # And when B does publish, it lands B's own target.\n+        os.replace(tmp_b, link_path)\n+        self.assertEqual(os.readlink(link_path), 'checkpoint-3')\n \n     def test_last_checkpoint_symlink_skips_unusable_targets(self):\n         # A checkpoint whose directory is not there yet must not be linked.",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/29dd512a687acf9f6c4ec48e19cfab44eb3c3bf6/tests%2Futils%2Ftest_io_utils.py",
      "sha": "361a9c544a391c6bfa3aa6fd125fdbedabc7bf86",
