      "filename": "swift/utils/utils.py",
      "patch": "@@ -40,6 +40,10 @@ def check_json_format(obj: Any, token_safe: bool = True) -> Any:\n     if isinstance(obj, (torch.dtype, torch.device)):\n         obj = str(obj)\n         return obj[len('torch.'):] if obj.startswith('torch.') else obj\n+    if isinstance(obj, np.generic):  # e.g. np.float32/np.int64/np.bool_\n+        return check_json_format(obj.item(), token_safe)\n+    if isinstance(obj, np.ndarray):\n+        return check_json_format(obj.tolist(), token_safe)\n \n     if isinstance(obj, Sequence):\n         res = []",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/ea1ac6fbca0e535adba302d3a9a816b49ea3cccd/swift%2Futils%2Futils.py",
      "sha": "f79df4a717dc6671b21c85196df9f9e3be43be68",
