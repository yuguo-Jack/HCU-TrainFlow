      "changes": 3,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/swift%2Fcallbacks%2Factivation_cpu_offload.py?ref=f8cff747c5a420fdf9671770b0c522455ea95f61",
      "deletions": 1,
      "filename": "swift/callbacks/activation_cpu_offload.py",
      "patch": "@@ -19,7 +19,8 @@\n \n \n def _get_unique_tensor_key(tensor):\n-    key = (tensor.untyped_storage().data_ptr() + tensor.storage_offset(), tensor.dtype)\n+    # Views with the same starting address can contain different values or numbers of elements.\n+    key = (tensor.device, tensor.data_ptr(), tensor.dtype, tensor.shape, tensor.stride())\n     return key\n \n ",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/f8cff747c5a420fdf9671770b0c522455ea95f61/swift%2Fcallbacks%2Factivation_cpu_offload.py",
      "sha": "6e88ebabcd023670dc58932c88f86de7030ea482",
