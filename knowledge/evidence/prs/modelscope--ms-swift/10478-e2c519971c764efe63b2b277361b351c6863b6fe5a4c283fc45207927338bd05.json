    },
    {
      "additions": 88,
      "blob_url": "https://github.com/modelscope/ms-swift/blob/e6586382d2cf0eab30f7e8a43bfeb349da842240/tests%2Futils%2Ftest_multi_turn_response_prefix.py",
      "changes": 88,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/tests%2Futils%2Ftest_multi_turn_response_prefix.py?ref=e6586382d2cf0eab30f7e8a43bfeb349da842240",
      "deletions": 0,
      "filename": "tests/utils/test_multi_turn_response_prefix.py",
      "patch": "@@ -0,0 +1,88 @@\n+from swift.rlhf_trainers.utils import replace_assistant_response_with_ids\n+\n+\n+def test_non_thinking_prefix_is_added_to_every_generated_assistant_turn():\n+    messages = [\n+        {\n+            'role': 'user',\n+            'content': 'Q1'\n+        },\n+        {\n+            'role': 'assistant',\n+            'content': 'A'\n+        },\n+        {\n+            'role': 'user',\n+            'content': 'Q2'\n+        },\n+        {\n+            'role': 'assistant',\n+            'content': 'B'\n+        },\n+    ]\n+\n+    result = replace_assistant_response_with_ids(\n+        messages,\n+        completion_ids=[[11], [12]],\n+        loss_mask=[[1], [1]],\n+        non_thinking_prefix_ids=[9, 8],\n+    )\n+\n+    assert result[1]['content'] == {'loss_scale': [0, 0, 1], 'token_ids': [9, 8, 11]}\n+    assert result[3]['content'] == {'loss_scale': [0, 0, 1], 'token_ids': [9, 8, 12]}\n+\n+\n+def test_each_turn_handles_an_existing_masked_prefix_independently():\n+    messages = [\n+        {\n+            'role': 'user',\n+            'content': 'Q1'\n+        },\n+        {\n+            'role': 'assistant',\n+            'content': 'A'\n+        },\n+        {\n+            'role': 'user',\n+            'content': 'Q2'\n+        },\n+        {\n+            'role': 'assistant',\n+            'content': 'B'\n+        },\n+    ]\n+\n+    result = replace_assistant_response_with_ids(\n+        messages,\n+        completion_ids=[[9, 8, 11], [12]],\n+        loss_mask=[[0, 0, 1], [1]],\n+        non_thinking_prefix_ids=[9, 8],\n+    )\n+\n+    assert result[1]['content'] == {'loss_scale': [0, 0, 1], 'token_ids': [9, 8, 11]}\n+    assert result[3]['content'] == {'loss_scale': [0, 0, 1], 'token_ids': [9, 8, 12]}\n+\n+\n+def test_sampled_prefix_values_are_preserved_as_actions():\n+    messages = [\n+        {\n+            'role': 'user',\n+            'content': 'Q1'\n+        },\n+        {\n+            'role': 'assistant',\n+            'content': 'A'\n+        },\n+    ]\n+\n+    result = replace_assistant_response_with_ids(\n+        messages,\n+        completion_ids=[[11, 9, 8]],\n+        loss_mask=[[1, 1, 1]],\n+        non_thinking_prefix_ids=[9, 8],\n+    )\n+\n+    assert result[1]['content'] == {\n+        'loss_scale': [0, 0, 1, 1, 1],\n+        'token_ids': [9, 8, 11, 9, 8],\n+    }",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/e6586382d2cf0eab30f7e8a43bfeb349da842240/tests%2Futils%2Ftest_multi_turn_response_prefix.py",
      "sha": "f846b7e2a514ede36c6b4189413e984c9dbd05d9",
      "status": "added"
    }
