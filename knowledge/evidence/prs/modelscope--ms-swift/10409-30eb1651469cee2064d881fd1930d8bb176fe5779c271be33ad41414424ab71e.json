    {
      "additions": 16,
      "blob_url": "https://github.com/modelscope/ms-swift/blob/de22af26da1cf6185e10d61d9e8f1b4956db070e/swift%2Frl_core%2Fadvantage.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/swift%2Frl_core%2Fadvantage.py?ref=de22af26da1cf6185e10d61d9e8f1b4956db070e",
      "deletions": 1,
      "filename": "swift/rl_core/advantage.py",
      "patch": "@@ -128,7 +128,7 @@ def compute_advantages_dynamic(\n         prompt_ids: Length-N list of prompt identifiers.\n         request_ids: Length-N list of request identifiers (may have duplicates).\n         advantage_estimator: ``'grpo'``, ``'rloo'``, or ``'reinforce_plus_plus'``.\n-        scale_rewards: ``'batch'``, ``'group'``, ``'none'``.\n+        scale_rewards: ``'batch'``, ``'group'``, ``'none'``, or ``'gdpo'``.\n         kl_in_reward: Subtract ref model KL from rewards (pre-normalization).\n         beta: Ref model KL penalty coefficient.\n         kl_values: ``[N]`` ref model KL values.\n@@ -197,6 +197,21 @@ def compute_advantages_dynamic(\n                 idx_t = torch.tensor(idxs, device=device)\n                 r_group = unique_rewards[idx_t]\n                 prompt_stds[idx_t] = r_group.std() if len(idxs) > 1 else 0.0\n+        elif scale_rewards == 'gdpo':\n+            # Same as compute_advantages: normalize each reward function within its prompt group,\n+            # sum with the reward weights, then normalize the sum over the batch.\n+            unique_rewards_per_func = rewards_per_func[unique_indices]\n+            summed = torch.zeros(len(unique_rewards), device=device)\n+            for i in range(unique_rewards_per_func.shape[1]):\n+                norm_i = torch.zeros(len(unique_rewards), device=device)\n+                for pid, idxs in prompt_to_indices.items():\n+                    idx_t = torch.tensor(idxs, device=device)\n+                    r_i = unique_rewards_per_func[idx_t, i]\n+                    g_std = nanstd(r_i.unsqueeze(0), dim=1) + 1e-8\n+                    norm_i[idx_t] = torch.nan_to_num((r_i - torch.nanmean(r_i)) / g_std, nan=0.0)\n+                summed = summed + reward_weights[i] * norm_i\n+            request_advantages = (summed - summed.mean()) / (summed.std() + 1e-8)\n+            prompt_stds = None\n         else:\n             prompt_stds = None\n ",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/de22af26da1cf6185e10d61d9e8f1b4956db070e/swift%2Frl_core%2Fadvantage.py",
      "sha": "41d9c68c9ced472cec99987b63851403adc1c253",
      "status": "modified"
    },
    {
      "additions": 38,
      "blob_url": "https://github.com/modelscope/ms-swift/blob/de22af26da1cf6185e10d61d9e8f1b4956db070e/tests%2Ftrain%2Ftest_grpo_dynamic_advantages.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/tests%2Ftrain%2Ftest_grpo_dynamic_advantages.py?ref=de22af26da1cf6185e10d61d9e8f1b4956db070e",
      "deletions": 0,
      "filename": "tests/train/test_grpo_dynamic_advantages.py",
      "patch": "@@ -0,0 +1,38 @@\n+# Copyright (c) ModelScope Contributors. All rights reserved.\n+import torch\n+\n+from swift.rl_core.advantage import compute_advantages, compute_advantages_dynamic\n+\n+\n+def _rewards(num_prompts=3, num_generations=4, num_funcs=2, seed=0):\n+    torch.manual_seed(seed)\n+    rewards_per_func = torch.randn(num_prompts * num_generations, num_funcs)\n+    rewards_per_func[1, 1] = float('nan')  # a reward function that skipped one completion\n+    reward_weights = torch.tensor([1.0, 0.5])[:num_funcs]\n+    prompt_ids = [f'p{i // num_generations}' for i in range(num_prompts * num_generations)]\n+    request_ids = [f'r{i}' for i in range(num_prompts * num_generations)]\n+    return rewards_per_func, reward_weights, prompt_ids, request_ids\n+\n+\n+def test_dynamic_gdpo_matches_fixed_group_gdpo():\n+    rewards_per_func, reward_weights, prompt_ids, request_ids = _rewards()\n+    expected, _ = compute_advantages(rewards_per_func, reward_weights, num_generations=4, scale_rewards='gdpo')\n+    advantages, _ = compute_advantages_dynamic(\n+        rewards_per_func, reward_weights, prompt_ids, request_ids, scale_rewards='gdpo')\n+    torch.testing.assert_close(advantages, expected)\n+\n+\n+def test_dynamic_gdpo_maps_repeated_requests_back():\n+    rewards_per_func, reward_weights, prompt_ids, request_ids = _rewards()\n+    expected, _ = compute_advantages_dynamic(\n+        rewards_per_func, reward_weights, prompt_ids, request_ids, scale_rewards='gdpo')\n+    # a multi-turn request contributes two rows with the same rewards\n+    rewards_per_func = torch.cat([rewards_per_func, rewards_per_func[5:6]])\n+    advantages, _ = compute_advantages_dynamic(\n+        rewards_per_func,\n+        reward_weights,\n+        prompt_ids + [prompt_ids[5]],\n+        request_ids + [request_ids[5]],\n+        scale_rewards='gdpo')\n+    torch.testing.assert_close(advantages[:-1], expected)\n+    torch.testing.assert_close(advantages[-1], expected[5])",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/de22af26da1cf6185e10d61d9e8f1b4956db070e/tests%2Ftrain%2Ftest_grpo_dynamic_advantages.py",
      "sha": "cb9c112ce5871706fd5f12d16abaede7c179c616",
      "status": "added"
    }
