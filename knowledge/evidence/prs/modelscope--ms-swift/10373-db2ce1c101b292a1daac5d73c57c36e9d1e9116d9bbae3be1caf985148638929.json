      "additions": 45,
      "blob_url": "https://github.com/modelscope/ms-swift/blob/06892b1d9ddef881aafda01768c89719120986eb/swift%2Fray%2Fmegatron%2Fcheckpoint_engine%2Fhccl.py",
      "changes": 49,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/swift%2Fray%2Fmegatron%2Fcheckpoint_engine%2Fhccl.py?ref=06892b1d9ddef881aafda01768c89719120986eb",
      "deletions": 4,
      "filename": "swift/ray/megatron/checkpoint_engine/hccl.py",
      "patch": "@@ -7,7 +7,11 @@\n \"\"\"\n from __future__ import annotations\n \n+import hashlib\n+import hmac\n import os\n+import pickle\n+import secrets\n import time\n import torch\n import zmq\n@@ -35,6 +39,7 @@ class HCCLMasterMetadata:\n     zmq_port: int\n     dist_ip: str\n     dist_port: int\n+    auth_key: str = ''  # HMAC shared secret for authenticating ZMQ control messages\n \n \n def _stateless_init_hccl(\n@@ -119,6 +124,7 @@ def __init__(\n         self.ip: Optional[str] = None\n         self.zmq_port: Optional[int] = None\n         self.dist_port: Optional[int] = None\n+        self.auth_key: str = ''  # HMAC shared secret, generated by the master\n \n     def _new_socket(self, socket_type: int) -> zmq.Socket:\n         assert self._zmq_ctx is not None\n@@ -127,16 +133,40 @@ def _new_socket(self, socket_type: int) -> zmq.Socket:\n         return socket\n \n     def _recv_pyobj(self, where: str) -> Any:\n+        \"\"\"Receive a pickled object after verifying its HMAC signature.\n+\n+        The raw bytes are received first; the HMAC is checked *before*\n+        ``pickle.loads`` runs, so a crafted pickle from an untrusted\n+        peer can never reach the deserializer.\"\"\"\n         assert self.socket is not None\n         try:\n-            return self.socket.recv_pyobj()\n+            msg = self.socket.recv(copy=True)\n         except zmq.error.Again as e:\n             raise RuntimeError(f'HCCL metadata timeout ({self.meta_timeout_s}s) waiting at {where}.') from e\n+        if not self.auth_key:\n+            # No key configured — fall back to original recv_pyobj behaviour.\n+            return pickle.loads(msg) if isinstance(msg, (bytes, bytearray)) else self.socket.recv_pyobj()\n+        if len(msg) < 32:\n+            raise RuntimeError(f'Rejecting short ZMQ message at {where}: {len(msg)} bytes (< HMAC size 32).')\n+        received_hmac = msg[:32]\n+        payload = msg[32:]\n+        expected_hmac = hmac.new(self.auth_key.encode(), payload, hashlib.sha256).digest()\n+        if not hmac.compare_digest(received_hmac, expected_hmac):\n+            raise RuntimeError(f'HMAC verification failed for ZMQ message at {where}; '\n+                               'refusing to deserialize untrusted payload.')\n+        return pickle.loads(payload)\n \n     def _send_pyobj(self, payload: Any, where: str) -> None:\n+        \"\"\"Send a pickled object with an HMAC signature prepended.\"\"\"\n         assert self.socket is not None\n+        data = pickle.dumps(payload)\n+        if self.auth_key:\n+            sig = hmac.new(self.auth_key.encode(), data, hashlib.sha256).digest()\n+            msg = sig + data\n+        else:\n+            msg = data\n         try:\n-            self.socket.send_pyobj(payload)\n+            self.socket.send(msg)\n         except zmq.error.Again as e:\n             raise RuntimeError(f'HCCL metadata timeout ({self.meta_timeout_s}s) sending at {where}.') from e\n \n@@ -145,6 +175,7 @@ def _start_zmq_server(self):\n         self.ip = ray.util.get_node_ip_address().strip('[]')\n         self.zmq_port = _find_free_port()\n         self.dist_port = _find_free_port()\n+        self.auth_key = secrets.token_hex(32)  # 256-bit shared secret\n \n         self._zmq_ctx = zmq.Context()\n         self.socket = self._new_socket(zmq.REP)\n@@ -158,6 +189,7 @@ def _start_zmq_server(self):\n     def _connect_zmq_client(self, metadata: HCCLMasterMetadata):\n         self._zmq_ctx = zmq.Context()\n         self.socket = self._new_socket(zmq.REQ)\n+        self.auth_key = metadata.auth_key  # inherit the master's HMAC secret\n         if _is_valid_ipv6_address(metadata.zmq_ip):\n             address = f'tcp://[{metadata.zmq_ip}]:{metadata.zmq_port}'\n             self.socket.setsockopt(zmq.IPV6, 1)\n@@ -171,7 +203,11 @@ def prepare(self) -> Optional[HCCLMasterMetadata]:\n         if self._prepared:\n             if self.is_master:\n                 return HCCLMasterMetadata(\n-                    zmq_ip=self.ip, zmq_port=self.zmq_port, dist_ip=self.ip, dist_port=self.dist_port)\n+                    zmq_ip=self.ip,\n+                    zmq_port=self.zmq_port,\n+                    dist_ip=self.ip,\n+                    dist_port=self.dist_port,\n+                    auth_key=self.auth_key)\n             return None\n \n         self.send_buf = torch.zeros(self.bucket_size, dtype=torch.uint8, device='npu')\n@@ -180,7 +216,12 @@ def prepare(self) -> Optional[HCCLMasterMetadata]:\n         if self.is_master:\n             self._start_zmq_server()\n             self._prepared = True\n-            return HCCLMasterMetadata(zmq_ip=self.ip, zmq_port=self.zmq_port, dist_ip=self.ip, dist_port=self.dist_port)\n+            return HCCLMasterMetadata(\n+                zmq_ip=self.ip,\n+                zmq_port=self.zmq_port,\n+                dist_ip=self.ip,\n+                dist_port=self.dist_port,\n+                auth_key=self.auth_key)\n \n         self._prepared = True\n         return None",
