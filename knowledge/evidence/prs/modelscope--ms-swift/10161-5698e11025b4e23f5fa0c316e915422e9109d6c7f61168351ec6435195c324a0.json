      "patch": "@@ -3,10 +3,10 @@\n from bitsandbytes.optim.optimizer import Optimizer2State\n \n from swift.utils import synchronize\n-from .galore_projector import GaLoreProjector\n+from .galore_projector import GaLoreOptimizerState, GaLoreProjector\n \n \n-class AdamW8bit(Optimizer2State):\n+class AdamW8bit(GaLoreOptimizerState, Optimizer2State):\n \n     def __init__(self,\n                  params,",
      "raw_url": "https://github.com/modelscope/ms-swift/raw/762ef67d5e4feab1c952b01318c08ecf1db5b1ea/swift%2Foptimizers%2Fgalore%2Fadamw8bit.py",
      "sha": "aad73739f17d751d9ed39bf3c4ec73c226d32570",
