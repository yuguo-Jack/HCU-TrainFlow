      "changes": 4,
      "contents_url": "https://api.github.com/repos/modelscope/ms-swift/contents/swift%2Foptimizers%2Fgalore%2Fadamw8bit.py?ref=762ef67d5e4feab1c952b01318c08ecf1db5b1ea",
