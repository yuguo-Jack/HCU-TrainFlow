      "additions": 44,
      "blob_url": "https://github.com/NVIDIA/TransformerEngine/blob/3db839ea3f14728948b01f85a5e9527a9f740879/tests%2Fpytorch%2Fattention%2Frun_graph_cache.py",
      "changes": 44,
      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/tests%2Fpytorch%2Fattention%2Frun_graph_cache.py?ref=3db839ea3f14728948b01f85a5e9527a9f740879",
      "deletions": 0,
      "filename": "tests/pytorch/attention/run_graph_cache.py",
      "patch": "@@ -12,6 +12,8 @@\n   rescale  the same execution with only softmax_scale changed -- should hit the cache and reuse the plans,\n            since attn_scale is normalized out of the cache key\n   reshape  a query differing in max_seqlen -- should miss and recreate the graphs\n+  thd      executions with different packed sequence counts in one token bucket\n+           should share their forward/backward graphs and plans\n \"\"\"\n \n import os\n@@ -71,6 +73,37 @@ def execute(config: ModelConfig, softmax_scale: float) -> None:\n     torch.cuda.synchronize()\n \n \n+def execute_thd(cumulative_lengths) -> None:\n+    \"\"\"Exercise plan reuse when only the number of packed sequences changes.\"\"\"\n+    block = DotProductAttention(\n+        8,\n+        64,\n+        attention_dropout=0.0,\n+        qkv_format=\"thd\",\n+        attn_mask_type=\"padding_causal\",\n+        layer_number=1,\n+    ).to(dtype=DTYPE, device=\"cuda\")\n+    q, k, v = [\n+        torch.randn(1024, 8, 64, dtype=DTYPE, device=\"cuda\", requires_grad=True) for _ in range(3)\n+    ]\n+    cu_seqlens = torch.tensor(cumulative_lengths, dtype=torch.int32, device=\"cuda\")\n+    out = block(\n+        q,\n+        k,\n+        v,\n+        cu_seqlens_q=cu_seqlens,\n+        cu_seqlens_kv=cu_seqlens,\n+        cu_seqlens_q_padded=cu_seqlens,\n+        cu_seqlens_kv_padded=cu_seqlens,\n+        max_seqlen_q=512,\n+        max_seqlen_kv=512,\n+        pad_between_seqs=False,\n+    )\n+    assert _attention_backends[\"use_fused_attention\"]\n+    out.backward(torch.randn_like(out))\n+    torch.cuda.synchronize()\n+\n+\n def main() -> int:\n     torch.manual_seed(1234)\n     config = ModelConfig(2, 512, 8, 64)\n@@ -99,6 +132,17 @@ def main() -> int:\n     mark_phase(\"reshape\")\n     query(reshaped)\n \n+    capability = torch.cuda.get_device_capability()\n+    if capability >= (9, 0) and capability != (12, 0):\n+        # Keep tokens and max_seqlen fixed so only the packed sequence count varies.\n+        mark_phase(\"thd_first\")\n+        execute_thd([0, 512, 1024])\n+        mark_phase(\"thd_repack\")\n+        execute_thd([0, 256, 512, 1024])\n+        mark_phase(\"thd_replay\")\n+        execute_thd([0, 512, 1024])\n+        print(\"[CACHE-TEST] thd=1\", flush=True)\n+\n     mark_phase(\"done\")\n     return 0\n ",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/3db839ea3f14728948b01f85a5e9527a9f740879/tests%2Fpytorch%2Fattention%2Frun_graph_cache.py",
      "sha": "a04f6fe81093911200176cc71161371237bacd1f",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/NVIDIA/TransformerEngine/blob/3db839ea3f14728948b01f85a5e9527a9f740879/tests%2Fpytorch%2Fattention%2Ftest_attention.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/tests%2Fpytorch%2Fattention%2Ftest_attention.py?ref=3db839ea3f14728948b01f85a5e9527a9f740879",
      "deletions": 0,
      "filename": "tests/pytorch/attention/test_attention.py",
      "patch": "@@ -630,6 +630,15 @@ def expect(phase, event, expected, reason, actual=None, pass_name=pass_name):\n             actual=len(miss_keys[\"reshape\"][pass_name]),\n         )\n \n+        if \"[CACHE-TEST] thd=1\" in result.stdout:\n+            expect(\"thd_first\", \"CREATE_GRAPH\", 1, \"expected one cold THD graph\")\n+            expect(\"thd_first\", \"BUILD_PLANS\", 1, \"expected one cold THD plan\")\n+            for phase in (\"thd_repack\", \"thd_replay\"):\n+                expect(phase, \"MISS\", 0, \"packed counts in one bucket should share a graph\")\n+                expect(phase, \"CREATE_GRAPH\", 0, \"packed count forced a new graph\")\n+                expect(phase, \"BUILD_PLANS\", 0, \"packed count recompiled the plan\")\n+                expect(phase, \"EXECUTE\", \"1+\", \"THD fused attention never ran\")\n+\n \n @pytest.mark.parametrize(\"dtype\", param_types)\n @pytest.mark.parametrize(\"model_configs\", [model_configs_base])",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/3db839ea3f14728948b01f85a5e9527a9f740879/tests%2Fpytorch%2Fattention%2Ftest_attention.py",
      "sha": "ca53ff9cca4af9e50aafc72b1030e8e5c17b0711",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/NVIDIA/TransformerEngine/blob/3db839ea3f14728948b01f85a5e9527a9f740879/transformer_engine%2Fcommon%2Ffused_attn%2Fconfig_and_params.cpp",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/transformer_engine%2Fcommon%2Ffused_attn%2Fconfig_and_params.cpp?ref=3db839ea3f14728948b01f85a5e9527a9f740879",
      "deletions": 7,
      "filename": "transformer_engine/common/fused_attn/config_and_params.cpp",
      "patch": "@@ -88,13 +88,21 @@ void FusedAttnConfig::derive() {\n   is_mxfp8_fwd = is_mxfp8 && is_o_in_f16;\n   is_mxfp8_bwd = is_mxfp8 && is_dqkv_in_f16;\n \n-  // Use cu_seqlens vs actual_seqlens for THD or padding masks\n+  // Use ragged (TH1) or dense (BHS1) graphs and stats\n+  const int sm_arch = cuda::sm_arch(cuda::current_device());\n+  uses_ragged_graph = sm_arch >= 90 && sm_arch != 120;\n+  uses_ragged_stats = is_ragged_q && uses_ragged_graph;\n+  const bool buckets_the_batch = (is_ragged_q || is_ragged_kv) && uses_ragged_graph;\n+\n+  // Direct cu_seqlens buffers have actual_batch + 1 entries and cannot describe a\n+  // bucketed batch. Convert lengths and offsets for ragged graphs so packed\n+  // sequence counts can share plans without reading beyond the input buffers.\n   const size_t cudnn_runtime_version = cudnnGetVersion();\n   const bool is_fp8_dtype = (qkv_dtype == kNVTEFloat8E4M3 || qkv_dtype == kNVTEFloat8E5M2);\n   const size_t min_frontend_version = is_fp8_dtype ? 12600 : 12500;\n   const size_t min_cudnn_version = is_fp8_dtype ? 92500 : 92400;\n   uses_cu_seqlens_directly =\n-      CUDNN_FRONTEND_VERSION >= min_frontend_version &&\n+      !buckets_the_batch && CUDNN_FRONTEND_VERSION >= min_frontend_version &&\n       (CUDNN_VERSION >= min_cudnn_version && cudnn_runtime_version >= min_cudnn_version) &&\n       !is_dropout;\n \n@@ -104,11 +112,6 @@ void FusedAttnConfig::derive() {\n   bucketed_num_tokens_q = is_ragged_q ? fused_attn::get_max_tokens(num_tokens_q) : 0;\n   bucketed_num_tokens_kv = is_ragged_kv ? fused_attn::get_max_tokens(num_tokens_kv) : 0;\n \n-  // Use ragged (TH1) or dense (BHS1) graphs and stats\n-  const int sm_arch = cuda::sm_arch(cuda::current_device());\n-  uses_ragged_graph = sm_arch >= 90 && sm_arch != 120;\n-  uses_ragged_stats = is_ragged_q && uses_ragged_graph;\n-  const bool buckets_the_batch = (is_ragged_q || is_ragged_kv) && uses_ragged_graph;\n   graph_batch_size_fwd =\n       (buckets_the_batch && !uses_cu_seqlens_directly) ? bucketed_batch_size : batch_size;\n   graph_batch_size_bwd = buckets_the_batch ? bucketed_batch_size : batch_size;",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/3db839ea3f14728948b01f85a5e9527a9f740879/transformer_engine%2Fcommon%2Ffused_attn%2Fconfig_and_params.cpp",
      "sha": "bdd895daf51fe5fceee9facdf91e51ce31660abf",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "This does safeguard the situation when we bucket the batch size and use cu_seqlens for the graph, but it also disables most of the THD use cases, if we are on sm90+ and not sm120. It's supposed to be an optimization for THD fwd.\n\nI'm approving the PR, but we probably should also look into whether cuDNN can stop reading at cu_seqlens.shape[0], which is [actual_b+1] instead of [bucketed_b+1]. Maybe there's something we can do about it, without losing the optimization (use_cu_seqlens_directly) opportunity.",
      "created_at": "2026-10-17T00:18:45Z",
      "diff_hunk": "@@ -88,13 +88,21 @@ void FusedAttnConfig::derive() {\n   is_mxfp8_fwd = is_mxfp8 && is_o_in_f16;\n   is_mxfp8_bwd = is_mxfp8 && is_dqkv_in_f16;\n \n-  // Use cu_seqlens vs actual_seqlens for THD or padding masks\n+  // Use ragged (TH1) or dense (BHS1) graphs and stats\n+  const int sm_arch = cuda::sm_arch(cuda::current_device());\n+  uses_ragged_graph = sm_arch >= 90 && sm_arch != 120;\n+  uses_ragged_stats = is_ragged_q && uses_ragged_graph;\n+  const bool buckets_the_batch = (is_ragged_q || is_ragged_kv) && uses_ragged_graph;\n+\n+  // Direct cu_seqlens buffers have actual_batch + 1 entries and cannot describe a\n+  // bucketed batch. Convert lengths and offsets for ragged graphs so packed\n+  // sequence counts can share plans without reading beyond the input buffers.\n   const size_t cudnn_runtime_version = cudnnGetVersion();\n   const bool is_fp8_dtype = (qkv_dtype == kNVTEFloat8E4M3 || qkv_dtype == kNVTEFloat8E5M2);\n   const size_t min_frontend_version = is_fp8_dtype ? 12600 : 12500;\n   const size_t min_cudnn_version = is_fp8_dtype ? 92500 : 92400;\n   uses_cu_seqlens_directly =\n-      CUDNN_FRONTEND_VERSION >= min_frontend_version &&\n+      !buckets_the_batch && CUDNN_FRONTEND_VERSION >= min_frontend_version &&",
      "html_url": "https://github.com/NVIDIA/TransformerEngine/pull/3700#discussion_r4300448198",
      "id": 4300448198,
