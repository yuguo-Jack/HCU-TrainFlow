  "issue_comments": [
    {
      "body": "The recv_capacity_per_rank per layer could be different but smaller than the one we bootstrapped with. This is a feature, not a bug. Thus, a fix is not expected.",
      "created_at": "2026-10-20T21:35:45Z",
      "html_url": "https://github.com/NVIDIA/TransformerEngine/pull/3618#issuecomment-6302040343",
      "id": 6302040343,
      "updated_at": "2026-10-20T21:35:45Z",
      "user": {
        "login": "phu0ngng"
      }
    },
    {
      "body": "Thanks for clarifying. I had treated the bootstrapped receive capacity as an exact per-layer requirement rather than an upper bound. That would reject the supported smaller per-layer capacities you described. Keeping this PR closed; no replacement fix is planned for that behavior.",
      "created_at": "2026-10-21T05:58:13Z",
      "html_url": "https://github.com/NVIDIA/TransformerEngine/pull/3618#issuecomment-6309188604",
      "id": 6309188604,
