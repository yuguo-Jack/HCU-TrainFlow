      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/transformer_engine%2Fcommon%2Fcast%2Fcore%2Fgrouped_tma.cuh?ref=da4361e99c98eda63f7e94cb9090e61fb6a51c5a",
      "deletions": 1,
      "filename": "transformer_engine/common/cast/core/grouped_tma.cuh",
      "patch": "@@ -104,8 +104,11 @@ __device__ __forceinline__ void modify_base_tensor_map(const CUtensorMap base_te\n   }\n }\n \n+// Must have internal linkage like g_tensor_maps. Otherwise, before CUDA 13.0 (nvcc\n+// -static-global-template-stub=false), the host stubs from every TU are merged, so the launch\n+// writes another TU's g_tensor_maps and the consumer kernel reads an empty table.\n template <typename IType, typename OType>\n-__global__ void __launch_bounds__(THREADS_PER_WARP)\n+static __global__ void __launch_bounds__(THREADS_PER_WARP)\n     update_tma_descriptors(const __grid_constant__ CUtensorMap base_tensor_map_input,\n                            const __grid_constant__ CUtensorMap base_tensor_map_act_input,\n                            const __grid_constant__ CUtensorMap base_tensor_map_output_rowwise,",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/da4361e99c98eda63f7e94cb9090e61fb6a51c5a/transformer_engine%2Fcommon%2Fcast%2Fcore%2Fgrouped_tma.cuh",
      "sha": "1e7f67e5301be80bb62ca71c967bf62476fc3ba6",
      "status": "modified"
    }
