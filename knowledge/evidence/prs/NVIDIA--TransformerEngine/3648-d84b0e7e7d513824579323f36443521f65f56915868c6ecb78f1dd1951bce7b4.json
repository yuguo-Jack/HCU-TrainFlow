    {
      "additions": 17,
      "blob_url": "https://github.com/NVIDIA/TransformerEngine/blob/00cb0378209c748776cd04a6d4d4ebe311851c17/tests%2Fcpp_distributed%2FCMakeLists.txt",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/tests%2Fcpp_distributed%2FCMakeLists.txt?ref=00cb0378209c748776cd04a6d4d4ebe311851c17",
      "deletions": 0,
      "filename": "tests/cpp_distributed/CMakeLists.txt",
      "patch": "@@ -56,6 +56,10 @@ find_package(CUDAToolkit REQUIRED)\n find_package(OpenMP REQUIRED)\n find_package(MPI REQUIRED)\n \n+option(NVTE_WITH_CUTEDSL\n+       \"Link the tests against libpython, required when libtransformer_engine.so was built with NVTE_WITH_CUTEDSL=ON\"\n+       \"$ENV{NVTE_WITH_CUTEDSL}\")\n+\n # -- NCCL core ----------------------------------------------------------------\n # Anchor on libnccl and derive nccl.h from the same install prefix so the\n # header and library can't drift across installs.\n@@ -127,6 +131,19 @@ add_executable(test_ep test_ep.cu ../cpp/test_common.cu)\n target_include_directories(test_ep PRIVATE ${EP_TEST_COMMON_INCLUDES})\n target_link_libraries(test_ep PUBLIC ${EP_TEST_COMMON_LIBS})\n \n+if(NVTE_WITH_CUTEDSL)\n+  # Executables that link libtransformerengine.so must also link to the Python::Python to provide\n+  # the definitions of these CPython symbols at runtime via dynamic linking.\n+  # Find the interpreter too so older CMake versions use its version to locate libpython.\n+  find_package(Python COMPONENTS Interpreter Development.Embed REQUIRED)\n+  foreach(test_target test_comm_gemm test_ep)\n+    target_link_libraries(${test_target} PRIVATE\n+                          \"-Wl,--no-as-needed\"\n+                          Python::Python\n+                          \"-Wl,--as-needed\")\n+  endforeach()\n+endif()\n+\n # Do NOT use gtest_discover_tests - these binaries require multi-process\n # launch via run_test_ep.sh, not direct single-process execution.\n message(STATUS \"EP distributed tests enabled (NCCL EP loaded from libnccl_ep.so at runtime)\")",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/00cb0378209c748776cd04a6d4d4ebe311851c17/tests%2Fcpp_distributed%2FCMakeLists.txt",
      "sha": "2dd7b301c14743e40efe54e17f610a41eaafcb3e",
      "status": "modified"
    }
  ],
