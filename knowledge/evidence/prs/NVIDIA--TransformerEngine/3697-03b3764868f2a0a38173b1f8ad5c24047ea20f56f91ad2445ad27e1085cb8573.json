  "inline_comments": [
    {
      "_links": {
        "html": {
          "href": "https://github.com/NVIDIA/TransformerEngine/pull/3697#discussion_r4297983244"
        },
        "pull_request": {
          "href": "https://api.github.com/repos/NVIDIA/TransformerEngine/pulls/3697"
