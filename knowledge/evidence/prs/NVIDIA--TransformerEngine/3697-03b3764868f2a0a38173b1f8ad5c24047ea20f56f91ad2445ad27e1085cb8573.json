  "files": [
    {
      "additions": 82,
      "blob_url": "https://github.com/NVIDIA/TransformerEngine/blob/59a8dbdbcc422a6206a3128a0ce4a0d2c3a6f16a/tests%2Fjax%2Ftest_gemm_partitioning.py",
      "changes": 85,
      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/tests%2Fjax%2Ftest_gemm_partitioning.py?ref=59a8dbdbcc422a6206a3128a0ce4a0d2c3a6f16a",
      "deletions": 3,
      "filename": "tests/jax/test_gemm_partitioning.py",
      "patch": "@@ -55,8 +55,10 @@ def _arg_info(shape, spec):\n     return SimpleNamespace(ndim=len(shape), size=int(np.prod(shape)), sharding=sharding)\n \n \n-def _parse(lhs_shape, lhs_spec, rhs_shape, rhs_spec, contracting_dims):\n-    \"\"\"Run the partition spec inference for a plain (non-collective) GEMM.\"\"\"\n+def _parse(\n+    lhs_shape, lhs_spec, rhs_shape, rhs_spec, contracting_dims, collective_op=CollectiveOp.NONE\n+):\n+    \"\"\"Run the partition spec inference for a GEMM (plain by default).\"\"\"\n     scalar = _arg_info((0,), None)  # scales / bias / alpha / beta (unused for NO_SCALING)\n     arg_infos = (\n         _arg_info(lhs_shape, lhs_spec),\n@@ -71,7 +73,7 @@ def _parse(lhs_shape, lhs_spec, rhs_shape, rhs_spec, contracting_dims):\n         arg_infos,\n         contracting_dims,\n         transpose_batch_sequence=False,\n-        collective_op=CollectiveOp.NONE,\n+        collective_op=collective_op,\n         scaling_mode=ScalingMode.NO_SCALING,\n     )\n     lhs_specs, _, rhs_specs, *_ = operand_specs\n@@ -293,6 +295,65 @@ def _parse(lhs_shape, lhs_spec, rhs_shape, rhs_spec, contracting_dims):\n         (\"fsdp\", \"tp\"),\n         None,\n     ),\n+    # --- RHS non-contracting dims sharded by an axis that also shards the LHS. ---\n+    # EP shards both the token dim and the weight -> gather the weight, not the activation\n+    # (keeping both would put \"expert\" on two output dims).\n+    \"ep_shared_axis_gathers_weight\": Case(\n+        (\"fsdp\", \"expert\"),\n+        dict(fsdp_resource=\"fsdp\", ep_resource=\"expert\"),\n+        (128, 512),\n+        ((\"fsdp\", \"expert\"), None),\n+        (512, 256),\n+        (None, \"expert\"),\n+        ((1,), (0,)),\n+        ((\"fsdp\", \"expert\"), None),\n+        (None, None),\n+        ((\"fsdp\", \"expert\"), None),\n+        None,\n+    ),\n+    # Only the shared axis is dropped from a compound weight spec; \"tp\" stays sharded.\n+    \"ep_shared_axis_keeps_other_axes\": Case(\n+        _TP_AXES,\n+        _MR_TP,\n+        (128, 512),\n+        ((\"fsdp\", \"expert\"), None),\n+        (512, 256),\n+        (None, (\"expert\", \"tp\")),\n+        ((1,), (0,)),\n+        ((\"fsdp\", \"expert\"), None),\n+        (None, \"tp\"),\n+        ((\"fsdp\", \"expert\"), \"tp\"),\n+        None,\n+    ),\n+    # FSDP gathers only the fsdp axis of a compound weight spec.\n+    \"fsdp_compound_keeps_other_axes\": Case(\n+        (\"fsdp\", \"tp\"),\n+        dict(fsdp_resource=\"fsdp\", tp_resource=\"tp\"),\n+        (128, 512),\n+        (\"fsdp\", None),\n+        (512, 256),\n+        (None, (\"fsdp\", \"tp\")),\n+        ((1,), (0,)),\n+        (\"fsdp\", None),\n+        (None, \"tp\"),\n+        (\"fsdp\", \"tp\"),\n+        None,\n+    ),\n+    # Sequence parallelism: tpsp shards the sequence and the weight -> gather the sequence\n+    # (Megatron-SP all-gather) and keep the weight sharded.\n+    \"tpsp_shared_axis_gathers_sequence\": Case(\n+        (\"fsdp\", \"tpsp\"),\n+        dict(fsdp_resource=\"fsdp\", tpsp_resource=\"tpsp\"),\n+        (4, 128, 512),\n+        (\"fsdp\", \"tpsp\", None),\n+        (512, 256),\n+        (None, \"tpsp\"),\n+        ((2,), (0,)),\n+        (\"fsdp\", None, None),\n+        (None, \"tpsp\"),\n+        (\"fsdp\", None, \"tpsp\"),\n+        None,\n+    ),\n }\n \n \n@@ -310,6 +371,24 @@ def test_partition_specs(self, case):\n         assert out_specs == case.exp_out\n         assert reduce_spec == case.exp_reduce\n \n+    def test_collective_all_gather_keeps_weight_sharded(self):\n+        \"\"\"Collective GEMM AG gathers the tpsp sequence in-kernel, so the weight stays sharded.\"\"\"\n+        with _mesh((\"fsdp\", \"tpsp\")), global_shard_guard(\n+            MeshResource(fsdp_resource=\"fsdp\", tpsp_resource=\"tpsp\")\n+        ):\n+            lhs_specs, rhs_specs, out_specs, reduce_spec = _parse(\n+                (4, 128, 512),\n+                (\"fsdp\", \"tpsp\", None),\n+                (512, 256),\n+                (None, \"tpsp\"),\n+                ((2,), (0,)),\n+                collective_op=CollectiveOp.ALL_GATHER,\n+            )\n+        assert lhs_specs == (\"fsdp\", \"tpsp\", None)\n+        assert rhs_specs == (None, \"tpsp\")\n+        assert out_specs == (\"fsdp\", None, \"tpsp\")\n+        assert reduce_spec is None\n+\n \n if __name__ == \"__main__\":\n     pytest.main([__file__, \"-v\"])",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/59a8dbdbcc422a6206a3128a0ce4a0d2c3a6f16a/tests%2Fjax%2Ftest_gemm_partitioning.py",
      "sha": "767992666f7f3f0051119c6df250e70b6c6bb498",
      "status": "modified"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/NVIDIA/TransformerEngine/blob/59a8dbdbcc422a6206a3128a0ce4a0d2c3a6f16a/transformer_engine%2Fjax%2Fcpp_extensions%2Fgemm.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/transformer_engine%2Fjax%2Fcpp_extensions%2Fgemm.py?ref=59a8dbdbcc422a6206a3128a0ce4a0d2c3a6f16a",
      "deletions": 10,
      "filename": "transformer_engine/jax/cpp_extensions/gemm.py",
      "patch": "@@ -1003,17 +1003,16 @@ def _retain_axes(spec, keep):\n             lhs_cspecs = (None,) * len(lhs_cspecs)\n             rhs_cspecs = (None,) * len(rhs_cspecs)\n \n-            # Non-contracting dims of RHS always needs to be gathered along the FSDP axis\n+            # Non-contracting dims of RHS always needs to be gathered along the FSDP axis, and\n+            # along any FSDP-like axis (e.g. EP) that also shards a non-contracting dim of LHS.\n+            # Otherwise the LHS would be gathered below instead, which is far more traffic for\n+            # activations. TP/TPSP axes are excluded since sequence parallelism (incl. collective\n+            # GEMM) relies on gathering the LHS sequence dim instead of the weight.\n+            lhs_non_c_axes = {a for s in lhs_non_cspecs for a in _convert_axis_spec_to_list(s)}\n+            lhs_non_c_axes -= {gsr.tp_resource, gsr.tpsp_resource}\n+            rhs_gather_axes = lhs_non_c_axes | {gsr.fsdp_resource}\n             rhs_non_cspecs = tuple(\n-                (\n-                    None\n-                    if spec is not None\n-                    and (\n-                        spec == gsr.fsdp_resource\n-                        or (isinstance(spec, tuple) and gsr.fsdp_resource in spec)\n-                    )\n-                    else spec\n-                )\n+                _retain_axes(spec, set(_convert_axis_spec_to_list(spec)) - rhs_gather_axes)\n                 for spec in rhs_non_cspecs\n             )\n ",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/59a8dbdbcc422a6206a3128a0ce4a0d2c3a6f16a/transformer_engine%2Fjax%2Fcpp_extensions%2Fgemm.py",
      "sha": "c840c9b35f5b79de162ed8c5df791a570b66ec46",
      "status": "modified"
    }
