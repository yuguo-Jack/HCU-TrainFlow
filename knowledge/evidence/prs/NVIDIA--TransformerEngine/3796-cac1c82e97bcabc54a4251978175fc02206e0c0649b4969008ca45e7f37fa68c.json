      "changes": 9,
      "contents_url": "https://api.github.com/repos/NVIDIA/TransformerEngine/contents/transformer_engine%2Fpytorch%2Fattention%2Fdot_product_attention%2Fflex_attention.py?ref=78e584ffb92cd72f0697d59012a2e4907412cc64",
      "deletions": 0,
      "filename": "transformer_engine/pytorch/attention/dot_product_attention/flex_attention.py",
      "patch": "@@ -270,12 +270,21 @@ def _finalize_cudnn_graph(graph) -> int:\n \n     graph.validate()\n     graph.build_operation_graph()\n+    # Only the cuDNN backend implements score_mod. cuDNN frontend 1.31 can offer its Python SDPA\n+    # engines for these graphs, and those engines run plain attention without the modifier.\n+    graph.deselect_engines([\"sdpa_fwd\", \"sdpa_bwd\"])\n     try:\n         graph.create_execution_plans([cudnn.heur_mode.A, cudnn.heur_mode.FALLBACK])\n         graph.check_support()\n     except cudnn.cudnnGraphNotSupportedError as exc:\n         raise RuntimeError(f\"cuDNN Flex Attention SDPA graph is not supported: {exc}\") from exc\n     graph.build_plans(cudnn.build_plan_policy.HEURISTICS_CHOICE)\n+    selected_engine = getattr(graph, \"selected_engine\", None)\n+    if selected_engine is not None:\n+        raise RuntimeError(\n+            f\"cuDNN frontend {cudnn.__version__} selected {selected_engine} for a score_mod graph. \"\n+            \"Only the cuDNN backend implements score_mod.\"\n+        )\n     return max(graph.get_workspace_size(), 1)\n \n ",
      "raw_url": "https://github.com/NVIDIA/TransformerEngine/raw/78e584ffb92cd72f0697d59012a2e4907412cc64/transformer_engine%2Fpytorch%2Fattention%2Fdot_product_attention%2Fflex_attention.py",
