  "files": [
    {
      "additions": 2,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/7bd268da30a9e6c4cbe976967c377f0fd09fed8b/tools%2Fconvergence_test%2FREADME.md",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tools%2Fconvergence_test%2FREADME.md?ref=7bd268da30a9e6c4cbe976967c377f0fd09fed8b",
      "deletions": 1,
      "filename": "tools/convergence_test/README.md",
      "patch": "@@ -29,7 +29,8 @@ tools/convergence_test/run_convergence_test.sh --model megatron/mixtral_8x7B_v0.\n # MaxText, rocm/jax-training image\n tools/convergence_test/run_convergence_test.sh --model maxtext/llama3.2_1B        # ~45 min\n tools/convergence_test/run_convergence_test.sh --model maxtext/llama2_7B          # ~85 min\n-tools/convergence_test/run_convergence_test.sh --model maxtext/llama2_7B-nanoo_fp8\n+tools/convergence_test/run_convergence_test.sh --model maxtext/llama2_7B-nanoo_fp8 # CDNA3\n+tools/convergence_test/run_convergence_test.sh --model maxtext/llama2_7B-fp8       # CDNA4\n tools/convergence_test/run_convergence_test.sh --model maxtext/mixtral_8x7B       # ~75 min\n \n # Another corpus, and results kept somewhere else",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/7bd268da30a9e6c4cbe976967c377f0fd09fed8b/tools%2Fconvergence_test%2FREADME.md",
      "sha": "0e26e38f7a30114a680c98cee443492a726a23dd",
      "status": "modified"
    },
    {
      "additions": 79,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/7bd268da30a9e6c4cbe976967c377f0fd09fed8b/tools%2Fconvergence_test%2Fconfigs%2Fmaxtext%2Fllama2_7B-fp8-convergence.yaml",
      "changes": 79,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tools%2Fconvergence_test%2Fconfigs%2Fmaxtext%2Fllama2_7B-fp8-convergence.yaml?ref=7bd268da30a9e6c4cbe976967c377f0fd09fed8b",
      "deletions": 0,
      "filename": "tools/convergence_test/configs/maxtext/llama2_7B-fp8-convergence.yaml",
      "patch": "@@ -0,0 +1,79 @@\n+work_group: ${PRIMUS_TEAM:amd}\n+user_name: ${PRIMUS_USER:root}\n+exp_name: ${PRIMUS_EXP_NAME:llama2_7B-fp8-maxtext-convergence}\n+workspace: ${PRIMUS_WORKSPACE:./output}\n+\n+# Llama-2-7B fp8 convergence test, MaxText backend: configs/maxtext/llama2_7B\n+# with FP8 GEMMs, as in examples/maxtext/configs/MI355X/llama2_7B-fp8-pretrain.yaml.\n+# Compare it against the bf16 run of the same recipe.\n+#\n+# 'fp8' is the OCP e4m3/e5m2 format, implemented by MI355X (CDNA4). On MI300X\n+# and MI325X (CDNA3) use llama2_7B-nanoo_fp8-convergence.yaml instead, which\n+# selects the fnuz variant; the examples/maxtext configs draw the same line.\n+#\n+#   tools/convergence_test/run_convergence_test.sh --model maxtext/llama2_7B-fp8\n+\n+modules:\n+  pre_trainer:\n+    framework: maxtext\n+    config: pre_trainer.yaml\n+    model: llama2_7B.yaml\n+    overrides:\n+      run_name: llama2_7B-fp8-maxtext-convergence\n+      base_output_directory: ./output\n+      enable_tensorboard: true\n+      profiler: \"\"\n+\n+      quantization: \"fp8\"\n+\n+      steps: 1000\n+      per_device_batch_size: 16\n+      max_target_length: 4096\n+\n+      learning_rate: 1.5e-4\n+      lr_schedule_type: cosine\n+      learning_rate_final_fraction: 0.1\n+      warmup_steps_fraction: 0.1\n+      learning_rate_schedule_steps: -1\n+      adam_b1: 0.9\n+      adam_b2: 0.95\n+      adam_eps: 1.0e-8\n+      adam_weight_decay: 0.1\n+      gradient_clipping_threshold: 1.0\n+\n+      # fp32 master weights and Adam moments; compute stays in bf16 outside the\n+      # FP8 GEMMs.\n+      weight_dtype: float32\n+      dtype: bfloat16\n+\n+      # parallel: FSDP across the node, data parallel across nodes\n+      ici_fsdp_parallelism: -1\n+      ici_data_parallelism: 1\n+      dcn_data_parallelism: -1\n+      dcn_fsdp_parallelism: 1\n+      remat_policy: minimal_with_context\n+\n+      # data\n+      dataset_type: grain\n+      grain_file_type: parquet\n+      grain_train_files: ${PRIMUS_CONVERGENCE_DATA:./data/convergence/fineweb-edu-llama-2-7b-hf-maxtext-4096}/train-*.parquet\n+      grain_eval_files: ${PRIMUS_CONVERGENCE_DATA:./data/convergence/fineweb-edu-llama-2-7b-hf-maxtext-4096}/valid-*.parquet\n+      train_data_columns: [\"tokens\"]\n+      eval_data_columns: [\"tokens\"]\n+      tokenize_train_data: false\n+      tokenize_eval_data: false\n+      tokenizer_type: huggingface\n+      tokenizer_path: ${PRIMUS_CONVERGENCE_DATA:./data/convergence/fineweb-edu-llama-2-7b-hf-maxtext-4096}/tokenizer\n+      packing: true\n+      grain_worker_count: 4\n+      enable_data_shuffling: true\n+      data_shuffle_seed: 0\n+      init_weights_seed: 0\n+\n+      # validation loss every 100 steps over 10 x 128 x 4096 = 5.2M tokens\n+      eval_interval: 100\n+      eval_steps: 10\n+\n+      # ckpt\n+      enable_checkpointing: false\n+      async_checkpointing: false",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/7bd268da30a9e6c4cbe976967c377f0fd09fed8b/tools%2Fconvergence_test%2Fconfigs%2Fmaxtext%2Fllama2_7B-fp8-convergence.yaml",
      "sha": "7397d15ae5cf8afbd81b85ecbc05f8c5d5225bfc",
      "status": "added"
    }
  ],
