  "files": [
    {
      "additions": 1,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/52f66b58d0b742198bfc31bfac6f24d25114e76f/primus%2Fbackends%2Fmegatron%2Fpatches%2Fdelayed_fp8_scaling_patches.py",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/primus%2Fbackends%2Fmegatron%2Fpatches%2Fdelayed_fp8_scaling_patches.py?ref=52f66b58d0b742198bfc31bfac6f24d25114e76f",
      "deletions": 1,
      "filename": "primus/backends/megatron/patches/delayed_fp8_scaling_patches.py",
      "patch": "@@ -269,7 +269,7 @@ def _patched_train_step(\n         iteration=None,\n         **train_kwargs,  # pg_collection / p2p_communicator on newer Megatron\n     ):\n-        if \"iter\" not in _prefetch_state and tp_size == 1:\n+        if \"iter\" not in _prefetch_state and tp_size == 1 and data_iterator is not None:\n             if isinstance(data_iterator, (list, tuple)):\n                 # Virtual pipeline parallel passes a list of per-chunk iterators,\n                 # which the single-stream prefetcher cannot wrap. Skip prefetch",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/52f66b58d0b742198bfc31bfac6f24d25114e76f/primus%2Fbackends%2Fmegatron%2Fpatches%2Fdelayed_fp8_scaling_patches.py",
      "sha": "abe0279b32726bf60d318366dabcb7932a6476e4",
      "status": "modified"
    },
    {
      "additions": 101,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/52f66b58d0b742198bfc31bfac6f24d25114e76f/tests%2Funit_tests%2Fbackends%2Fmegatron%2Ftest_delayed_fp8_prefetch_none_iterator.py",
      "changes": 101,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tests%2Funit_tests%2Fbackends%2Fmegatron%2Ftest_delayed_fp8_prefetch_none_iterator.py?ref=52f66b58d0b742198bfc31bfac6f24d25114e76f",
      "deletions": 0,
      "filename": "tests/unit_tests/backends/megatron/test_delayed_fp8_prefetch_none_iterator.py",
      "patch": "@@ -0,0 +1,101 @@\n+###############################################################################\n+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.\n+#\n+# See LICENSE for license information.\n+###############################################################################\n+\n+\"\"\"\n+Regression test: ``patch_grad_zero_and_data_prefetch`` must not wrap a\n+``None`` data iterator.\n+\n+With PP>=3, Megatron builds no dataset on the middle pipeline stages, so\n+``train_step`` receives ``data_iterator=None`` there. Wrapping it in a\n+``CudaPrefetchIterator`` raised ``TypeError: 'NoneType' object is not an\n+iterator`` on the first step (#1335).\n+\n+Level 1: Pure Python, no GPU (Megatron and CUDA streams are stubbed).\n+\n+Run:\n+    python -m pytest \\\n+      tests/unit_tests/backends/megatron/test_delayed_fp8_prefetch_none_iterator.py -v\n+\"\"\"\n+\n+import sys\n+from types import ModuleType, SimpleNamespace\n+\n+import pytest\n+import torch\n+\n+from primus.backends.megatron.patches import delayed_fp8_scaling_patches as dfp\n+from primus.core.patches import PatchContext\n+\n+\n+class _FakeStream:\n+    def wait_stream(self, stream):\n+        pass\n+\n+\n+@pytest.fixture\n+def stub_megatron(monkeypatch):\n+    \"\"\"Install stub Megatron modules and CUDA streams; return the stub\n+    ``megatron.training.training`` module.\"\"\"\n+\n+    def _original_train_step(\n+        forward_step_func,\n+        data_iterator,\n+        model,\n+        optimizer,\n+        opt_param_scheduler,\n+        config,\n+        forward_backward_func,\n+        iteration=None,\n+    ):\n+        return forward_backward_func(data_iterator=data_iterator)\n+\n+    mods = {\n+        name: ModuleType(name)\n+        for name in (\n+            \"megatron\",\n+            \"megatron.training\",\n+            \"megatron.training.training\",\n+            \"megatron.core\",\n+            \"megatron.core.distributed\",\n+        )\n+    }\n+    mods[\"megatron\"].training = mods[\"megatron.training\"]\n+    mods[\"megatron\"].core = mods[\"megatron.core\"]\n+    mods[\"megatron.training\"].training = mods[\"megatron.training.training\"]\n+    mods[\"megatron.core\"].distributed = mods[\"megatron.core.distributed\"]\n+    mods[\"megatron.training.training\"].train_step = _original_train_step\n+    mods[\"megatron.core.distributed\"].DistributedDataParallel = type(\"DistributedDataParallel\", (), {})\n+    for name, mod in mods.items():\n+        monkeypatch.setitem(sys.modules, name, mod)\n+\n+    monkeypatch.setattr(torch.cuda, \"Stream\", _FakeStream)\n+    monkeypatch.setattr(torch.cuda, \"current_stream\", lambda: _FakeStream())\n+    monkeypatch.setitem(dfp._PREFETCH_HANDLE, \"state\", None)\n+    return mods[\"megatron.training.training\"]\n+\n+\n+def test_none_data_iterator_skips_prefetch(stub_megatron):\n+    \"\"\"A middle pipeline stage (data_iterator=None, TP=1) must pass None\n+    through to forward_backward_func without building a prefetcher.\"\"\"\n+    params = SimpleNamespace(tensor_model_parallel_size=1, bf16=True)\n+    ctx = PatchContext(\n+        backend=\"megatron\",\n+        phase=\"before_train\",\n+        extra={\"module_config\": SimpleNamespace(params=params)},\n+    )\n+    dfp.patch_grad_zero_and_data_prefetch(ctx)\n+\n+    seen = {}\n+\n+    def forward_backward_func(**kwargs):\n+        seen[\"data_iterator\"] = kwargs[\"data_iterator\"]\n+        return \"ok\"\n+\n+    result = stub_megatron.train_step(None, None, None, None, None, None, forward_backward_func, iteration=1)\n+\n+    assert result == \"ok\"\n+    assert seen[\"data_iterator\"] is None\n+    assert \"iter\" not in dfp.get_prefetch_state()",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/52f66b58d0b742198bfc31bfac6f24d25114e76f/tests%2Funit_tests%2Fbackends%2Fmegatron%2Ftest_delayed_fp8_prefetch_none_iterator.py",
      "sha": "71b36b79247cc006eaf6fa3a145f0d7bc6d1d3ee",
      "status": "added"
    }
