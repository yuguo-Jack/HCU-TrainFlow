      "changes": 28,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/primus%2Fconfigs%2Fmodules%2Fmegatron_bridge%2Fpost_trainer.yaml?ref=b7a7dfee62960c586fd90b8b673a72578a110df9",
      "deletions": 0,
      "filename": "primus/configs/modules/megatron_bridge/post_trainer.yaml",
      "patch": "@@ -7,3 +7,31 @@ extends:\n \n # # Mark as trainable module\n trainable: true\n+\n+\n+# main control flag\n+enable_primus_turbo: false\n+\n+# feature control flags\n+use_turbo_attention: false\n+use_turbo_parallel_linear: false\n+use_turbo_grouped_mlp: false\n+moe_use_fused_router_with_aux_score: false\n+\n+# inner features flags\n+enable_turbo_attention_float8 : false\n+\n+\n+# deepep\n+use_turbo_deepep: false\n+turbo_deepep_num_cu: 32\n+turbo_deepep_use_comm_stream: false\n+\n+# sync-free moe\n+turbo_sync_free_moe_stage: 0\n+\n+# use turbo fused activation_with_probs to optmize redundant computation\n+use_turbo_fused_act_with_probs: false\n+\n+# layer norm\n+use_turbo_rms_norm: false",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/b7a7dfee62960c586fd90b8b673a72578a110df9/primus%2Fconfigs%2Fmodules%2Fmegatron_bridge%2Fpost_trainer.yaml",
