      "blob_url": "https://github.com/AMD-AGI/Primus/blob/f19604c9c28b228f461d7db1cdfc067a8885f334/primus%2Fbackends%2Fmegatron%2Fflux_pretrain_trainer.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/primus%2Fbackends%2Fmegatron%2Fflux_pretrain_trainer.py?ref=f19604c9c28b228f461d7db1cdfc067a8885f334",
      "deletions": 5,
      "filename": "primus/backends/megatron/flux_pretrain_trainer.py",
      "patch": "@@ -20,6 +20,9 @@\n import torch.nn as nn\n \n from primus.backends.megatron.diffusion_trainer import DiffusionPretrainTrainer\n+from primus.backends.megatron.training.diffusion.rng import (\n+    seed_training_rng_per_dp_rank,\n+)\n from primus.backends.megatron.training.diffusion.schedulers import (\n     FlowMatchEulerDiscreteScheduler,\n )\n@@ -260,6 +263,8 @@ def forward_step(self, data_iterator, model, return_schedule_plan=False):\n \n         On the first call, sets a per-DP-rank random seed so that each data-parallel\n         rank independently samples timesteps and noise (matching NeMo's approach).\n+        The seed also depends on the resume iteration, so a resumed run does not\n+        replay the step-0 draws.\n \n         Args:\n             data_iterator: Data iterator\n@@ -273,13 +278,15 @@ def forward_step(self, data_iterator, model, return_schedule_plan=False):\n             from megatron.core import parallel_state\n             from megatron.training import get_args\n \n-            seed = get_args().seed\n+            args = get_args()\n             dp_rank = parallel_state.get_data_parallel_rank()\n-            per_rank_seed = seed + 100 * dp_rank\n-            torch.manual_seed(per_rank_seed)\n-            torch.cuda.manual_seed(per_rank_seed)\n+            iteration = getattr(args, \"iteration\", 0) or 0\n+            per_rank_seed = seed_training_rng_per_dp_rank(args.seed, dp_rank, iteration)\n             self._training_rng_seeded = True\n-            log_rank_0(f\"Per-DP-rank training seed: {per_rank_seed} \" f\"(base={seed}, dp_rank={dp_rank})\")\n+            log_rank_0(\n+                f\"Per-DP-rank training seed: {per_rank_seed} \"\n+                f\"(base={args.seed}, dp_rank={dp_rank}, iteration={iteration})\"\n+            )\n \n         return super().forward_step(data_iterator, model, return_schedule_plan=return_schedule_plan)\n ",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/f19604c9c28b228f461d7db1cdfc067a8885f334/primus%2Fbackends%2Fmegatron%2Fflux_pretrain_trainer.py",
      "sha": "f9611ab350945f3e0a8b0f70703c23d3ef966569",
      "status": "modified"
    },
    {
      "additions": 22,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/f19604c9c28b228f461d7db1cdfc067a8885f334/primus%2Fbackends%2Fmegatron%2Ftraining%2Fdiffusion%2Frng.py",
      "changes": 22,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/primus%2Fbackends%2Fmegatron%2Ftraining%2Fdiffusion%2Frng.py?ref=f19604c9c28b228f461d7db1cdfc067a8885f334",
      "deletions": 0,
      "filename": "primus/backends/megatron/training/diffusion/rng.py",
      "patch": "@@ -0,0 +1,22 @@\n+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.\n+# Licensed under the Apache License, Version 2.0.\n+\n+\"\"\"Training RNG seeding shared by the Megatron diffusion trainers.\"\"\"\n+\n+import torch\n+\n+# Larger than any 100 * dp_rank offset, so no two (dp_rank, iteration) pairs share a seed.\n+_ITERATION_SEED_STRIDE = 1_000_003\n+\n+\n+def seed_training_rng_per_dp_rank(seed: int, dp_rank: int, iteration: int = 0) -> int:\n+    \"\"\"Seed the CPU and CUDA generators so each data-parallel rank draws its own noise and timesteps.\n+\n+    ``iteration`` is the step training resumes from. A fresh run (``iteration == 0``)\n+    keeps the ``seed + 100 * dp_rank`` seed; a resumed run gets a different one\n+    instead of replaying the step-0 draws.\n+    \"\"\"\n+    per_rank_seed = seed + 100 * dp_rank + _ITERATION_SEED_STRIDE * iteration\n+    torch.manual_seed(per_rank_seed)\n+    torch.cuda.manual_seed(per_rank_seed)\n+    return per_rank_seed",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/f19604c9c28b228f461d7db1cdfc067a8885f334/primus%2Fbackends%2Fmegatron%2Ftraining%2Fdiffusion%2Frng.py",
      "sha": "ccbfd2b4c7f5844349a81791d537b75ab6ada5f8",
      "status": "added"
    },
    {
      "additions": 23,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/f19604c9c28b228f461d7db1cdfc067a8885f334/tests%2Funit_tests%2Fbackends%2Fmegatron%2Fdiffusion%2Ftraining%2Ftest_flux_trainer.py",
      "changes": 23,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tests%2Funit_tests%2Fbackends%2Fmegatron%2Fdiffusion%2Ftraining%2Ftest_flux_trainer.py?ref=f19604c9c28b228f461d7db1cdfc067a8885f334",
      "deletions": 0,
      "filename": "tests/unit_tests/backends/megatron/diffusion/training/test_flux_trainer.py",
      "patch": "@@ -117,6 +117,29 @@ def test_flux_trainer_scheduler_lazy_initialization(self, monkeypatch: pytest.Mo\n         scheduler2 = trainer.scheduler\n         assert scheduler2 is scheduler1\n \n+    def test_resumed_forward_step_does_not_replay_step0_draws(self, monkeypatch: pytest.MonkeyPatch):\n+        import megatron.core.parallel_state as parallel_state\n+        import megatron.training\n+        import torch\n+\n+        from primus.backends.megatron.diffusion_trainer import DiffusionPretrainTrainer\n+\n+        monkeypatch.setattr(parallel_state, \"get_data_parallel_rank\", lambda *a, **k: 1)\n+        monkeypatch.setattr(\n+            DiffusionPretrainTrainer,\n+            \"forward_step\",\n+            lambda self, *a, **k: torch.rand(8),\n+        )\n+\n+        def first_step_draws(iteration):\n+            monkeypatch.setattr(\n+                megatron.training, \"get_args\", lambda: SimpleNamespace(seed=1234, iteration=iteration)\n+            )\n+            return _build_flux_trainer(monkeypatch).forward_step(None, None)\n+\n+        assert torch.equal(first_step_draws(0), first_step_draws(0))\n+        assert not torch.equal(first_step_draws(0), first_step_draws(500))\n+\n \n def _create_encoding_files(directory):\n     \"\"\"Create minimal t5_empty.npy and clip_empty.npy in a directory.\"\"\"",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/f19604c9c28b228f461d7db1cdfc067a8885f334/tests%2Funit_tests%2Fbackends%2Fmegatron%2Fdiffusion%2Ftraining%2Ftest_flux_trainer.py",
      "sha": "a47345d5f1e322da12adec1a65de466e3bedcc16",
      "status": "modified"
    },
    {
      "additions": 35,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/f19604c9c28b228f461d7db1cdfc067a8885f334/tests%2Funit_tests%2Fbackends%2Fmegatron%2Fdiffusion%2Ftraining%2Ftest_training_rng.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tests%2Funit_tests%2Fbackends%2Fmegatron%2Fdiffusion%2Ftraining%2Ftest_training_rng.py?ref=f19604c9c28b228f461d7db1cdfc067a8885f334",
      "deletions": 0,
      "filename": "tests/unit_tests/backends/megatron/diffusion/training/test_training_rng.py",
      "patch": "@@ -0,0 +1,35 @@\n+# Copyright (c) 2026, Advanced Micro Devices, Inc. All rights reserved.\n+# Licensed under the Apache License, Version 2.0.\n+\n+\"\"\"Unit tests for the per-DP-rank diffusion training seed.\"\"\"\n+\n+import torch\n+\n+from primus.backends.megatron.training.diffusion.rng import (\n+    seed_training_rng_per_dp_rank,\n+)\n+\n+\n+def _draws(seed, dp_rank, iteration):\n+    seed_training_rng_per_dp_rank(seed, dp_rank, iteration)\n+    return torch.rand(8)\n+\n+\n+class TestSeedTrainingRngPerDpRank:\n+    def test_fresh_run_keeps_per_rank_seed(self):\n+        assert seed_training_rng_per_dp_rank(1234, 3) == 1234 + 300\n+        assert seed_training_rng_per_dp_rank(1234, 3, iteration=0) == 1234 + 300\n+\n+    def test_same_inputs_give_same_draws(self):\n+        assert torch.equal(_draws(1234, 1, 500), _draws(1234, 1, 500))\n+\n+    def test_resume_does_not_replay_step0_draws(self):\n+        assert not torch.equal(_draws(1234, 0, 0), _draws(1234, 0, 500))\n+\n+    def test_ranks_and_iterations_do_not_collide(self):\n+        seeds = {\n+            seed_training_rng_per_dp_rank(1234, dp_rank, iteration)\n+            for dp_rank in range(256)\n+            for iteration in (0, 1, 500, 10_000)\n+        }\n+        assert len(seeds) == 256 * 4",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/f19604c9c28b228f461d7db1cdfc067a8885f334/tests%2Funit_tests%2Fbackends%2Fmegatron%2Fdiffusion%2Ftraining%2Ftest_training_rng.py",
      "sha": "8657c27fad647227436d23d09b9c246fb5ff4a05",
      "status": "added"
    }
