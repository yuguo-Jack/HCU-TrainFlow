      "deletions": 0,
      "filename": "examples/megatron/configs/MI355X/deepseek_v2_lite-FP8-pretrain.yaml",
      "patch": "@@ -75,7 +75,11 @@ modules:\n       # Turbo\n       enable_primus_turbo: true\n       use_turbo_attention: true\n+      use_turbo_gemm: true\n       use_turbo_grouped_gemm: true\n+      # hipBLASLt, the default FP8 tensorwise GEMM backend, fails with\n+      # HIPBLAS_STATUS_INTERNAL_ERROR on this model's backward GEMMs.\n+      turbo_gemm_backend: \"fp8:triton\"\n \n       # deepep\n       use_turbo_deepep: true",
