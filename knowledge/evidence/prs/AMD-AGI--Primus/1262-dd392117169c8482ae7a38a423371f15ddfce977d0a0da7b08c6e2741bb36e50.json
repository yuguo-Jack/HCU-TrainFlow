  "files": [
    {
      "additions": 2,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Fchat_zebra_llama.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tools%2Fhybrid%2Fchat_zebra_llama.py?ref=8cc079eb954702c2da1c85ceaf11f18c4dea9b28",
      "deletions": 2,
      "filename": "tools/hybrid/chat_zebra_llama.py",
      "patch": "@@ -4,7 +4,7 @@\n \n Loads:\n   - model code from: tools/hybrid/modeling_zebra_llama.py\n-  - weights from:    output/zebra_mamba_1B_hybrid_hf_iter_0020000\n+  - weights from:    output/zebra_llama_kda_1B_hf_iter_0028000\n                      (the default output of tools/hybrid/convert_zebra_llama_to_hf.sh)\n \n Notes:\n@@ -45,7 +45,7 @@ def main() -> None:\n     parser.add_argument(\n         \"--checkpoint\",\n         type=str,\n-        default=\"output/zebra_mamba_1B_hybrid_hf_iter_0020000\",\n+        default=\"output/zebra_llama_kda_1B_hf_iter_0028000\",\n         help=\"Path to converted HF checkpoint directory\",\n     )\n     parser.add_argument(",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Fchat_zebra_llama.py",
      "sha": "2d456706b61df100b1eb7494871d34acb793e249",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Fconvert_zebra_llama_to_hf.sh",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tools%2Fhybrid%2Fconvert_zebra_llama_to_hf.sh?ref=8cc079eb954702c2da1c85ceaf11f18c4dea9b28",
      "deletions": 2,
      "filename": "tools/hybrid/convert_zebra_llama_to_hf.sh",
      "patch": "@@ -1,4 +1,7 @@\n #!/bin/bash\n+# This converter targets the KDA + MLA architecture implemented by\n+# modeling_zebra_llama.py. Mamba2 and GDN hybrids have their own converters,\n+# convert_mamba_hybrid_to_fla_hf.py and convert_gdn_hybrid_to_fla_hf.py.\n python tools/hybrid/convert_zebra_llama_to_hf.py \\\n-    --checkpoint-path output/zebra_llama_mamba_1B_BF16-pretrain/iter_0020000 \\\n-    --output-dir output/zebra_mamba_1B_hybrid_hf_iter_0020000\n+    --checkpoint-path output/zebra_llama_kda_1B_BF16-pretrain/iter_0028000 \\\n+    --output-dir output/zebra_llama_kda_1B_hf_iter_0028000",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Fconvert_zebra_llama_to_hf.sh",
      "sha": "f85f32338048a4fda8d36203cedc8753d53626a1",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Fmodeling_zebra_llama.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tools%2Fhybrid%2Fmodeling_zebra_llama.py?ref=8cc079eb954702c2da1c85ceaf11f18c4dea9b28",
      "deletions": 2,
      "filename": "tools/hybrid/modeling_zebra_llama.py",
      "patch": "@@ -1,13 +1,18 @@\n \"\"\"\n-Zebra hybrid: Hybrid Mamba + Multi-Latent Attention (MLA) Model (HuggingFace).\n+Zebra hybrid: Hybrid KDA + Multi-Latent Attention (MLA) Model (HuggingFace).\n \n This is a pragmatic HF implementation intended for:\n - loading converted Megatron checkpoints\n - running `generate()` / lm-eval\n \n+The layer stack is built from KDA, MLA and MLP blocks only. Mamba2 and GDN\n+hybrids are served by convert_mamba_hybrid_to_fla_hf.py and\n+convert_gdn_hybrid_to_fla_hf.py instead; the ``mamba_*`` fields on\n+ZebraLlamaConfig are retained only so older checkpoints keep loading.\n+\n Notes / simplifications:\n - KV cache is intentionally NOT supported (generation works, but is slower).\n-- Mamba mixer is a Megatron-shaped *simplified* implementation (not the full SSM scan).\n+- KDA mixer is a pure-PyTorch chunked implementation (no mamba_ssm dependency).\n - MLA follows Megatron’s tensorization and YaRN RoPE knobs, but uses PyTorch ops.\n \"\"\"\n ",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Fmodeling_zebra_llama.py",
      "sha": "8ecc09a7e227d3d0253f2bb5a7ac749363553cf8",
      "status": "modified"
    },
    {
      "additions": 1,
      "blob_url": "https://github.com/AMD-AGI/Primus/blob/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Frun_zebra_eval.sh",
      "changes": 2,
      "contents_url": "https://api.github.com/repos/AMD-AGI/Primus/contents/tools%2Fhybrid%2Frun_zebra_eval.sh?ref=8cc079eb954702c2da1c85ceaf11f18c4dea9b28",
      "deletions": 1,
      "filename": "tools/hybrid/run_zebra_eval.sh",
      "patch": "@@ -3,7 +3,7 @@\n # accept lm-eval's --model / --model_args. The converted checkpoint carries no\n # tokenizer files, so --tokenizer must point at the base model.\n python3 tools/hybrid/lm_harness_eval.py \\\n-    --model_path output/zebra_mamba_1B_hybrid_hf_iter_0020000 \\\n+    --model_path output/zebra_llama_kda_1B_hf_iter_0028000 \\\n     --tokenizer meta-llama/Llama-3.2-1B \\\n     --dtype bfloat16 \\\n     --tasks arc_easy,arc_challenge,hellaswag,winogrande,piqa,race,openbookqa \\",
      "raw_url": "https://github.com/AMD-AGI/Primus/raw/8cc079eb954702c2da1c85ceaf11f18c4dea9b28/tools%2Fhybrid%2Frun_zebra_eval.sh",
      "sha": "74c5eed3c133299ac17a26142d7013101410734d",
      "status": "modified"
    }
