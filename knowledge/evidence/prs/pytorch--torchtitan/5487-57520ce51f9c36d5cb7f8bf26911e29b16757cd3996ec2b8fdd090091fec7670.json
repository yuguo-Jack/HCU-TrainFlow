      "blob_url": "https://github.com/pytorch/torchtitan/blob/2f04caa5ed03fed2e80f295584ea73ceb205fa3e/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_generator.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_generator.py?ref=2f04caa5ed03fed2e80f295584ea73ceb205fa3e",
      "deletions": 0,
      "filename": "tests/rl/unit_tests/cpu/test_generator.py",
      "patch": "@@ -195,6 +195,23 @@ def fill_state_dict(*args, **kwargs):\n     asyncio.run(main())\n \n \n+def test_prefetch_model_state_dict_raises_when_a_weight_is_not_published():\n+    async def main():\n+        generator = Generator.__new__(Generator)\n+        # \"expert_bias\" is unpublished and raises; the vllm_attn scale is generator-only and is exempt.\n+        generator._prefetched_model_state_dict = {\n+            \"weight\": \"old\",\n+            \"expert_bias\": \"old\",\n+            \"layers.0.attention.inner_attention.vllm_attn._k_scale\": \"old\",\n+        }\n+        get_state_dict = AsyncMock(return_value={\"weight\": \"fetched\"})\n+        with patch.object(generator_module.ts, \"get_state_dict\", get_state_dict):\n+            with pytest.raises(RuntimeError, match=r\"1 of .*'expert_bias'\"):\n+                await generator.prefetch_model_state_dict()\n+\n+    asyncio.run(main())\n+\n+\n def _dispatcher(*, rank=0, dp_degree=1, tp_degree=1, dp_routing_strategy=None):\n     \"\"\"A bare RequestDispatcher; broadcast_group is unused unless ``setup`` runs.\"\"\"\n     return RequestDispatcher(",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/2f04caa5ed03fed2e80f295584ea73ceb205fa3e/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_generator.py",
      "sha": "5d5bd68de7ce534afcfec677931fceba49b9af21",
      "status": "modified"
    },
    {
      "additions": 13,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/2f04caa5ed03fed2e80f295584ea73ceb205fa3e/torchtitan%2Frl%2Fgenerator%2Fgenerator.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fgenerator%2Fgenerator.py?ref=2f04caa5ed03fed2e80f295584ea73ceb205fa3e",
      "deletions": 1,
      "filename": "torchtitan/rl/generator/generator.py",
      "patch": "@@ -444,12 +444,24 @@ async def prefetch_model_state_dict(self) -> None:\n         \"\"\"Fetch weights into pinned CPU memory without interrupting generation.\"\"\"\n         # Async RL uses a StorageVolume snapshot so generators do not read\n         # live trainer GPU tensors while optimizer steps may be mutating them.\n-        await ts.get_state_dict(\n+        fetched_state_dict = await ts.get_state_dict(\n             \"model_state_dict\",\n             user_state_dict=self._prefetched_model_state_dict,\n             strict=False,\n             direct_rdma=False,\n         )\n+        # strict=False skips weights the trainer didn't publish; they would silently keep their old values.\n+        # vLLM's attention scales exist only in the generator, so they are exempt.\n+        unpublished = sorted(\n+            key\n+            for key in self._prefetched_model_state_dict\n+            if \".vllm_attn.\" not in key and key not in fetched_state_dict\n+        )\n+        if unpublished:\n+            raise RuntimeError(\n+                f\"The trainer did not publish {len(unpublished)} of the generator's weights \"\n+                f\"(first 5: {unpublished[:5]}). Check that the trainer and generator model configs match.\"\n+            )\n \n     async def close(self) -> None:\n         \"\"\"Stop the engine loop, which releases the dispatcher and the engine on exit.\"\"\"",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/2f04caa5ed03fed2e80f295584ea73ceb205fa3e/torchtitan%2Frl%2Fgenerator%2Fgenerator.py",
      "sha": "757f7be65da5a932794d2c13df649f6324d50313",
      "status": "modified"
    }
