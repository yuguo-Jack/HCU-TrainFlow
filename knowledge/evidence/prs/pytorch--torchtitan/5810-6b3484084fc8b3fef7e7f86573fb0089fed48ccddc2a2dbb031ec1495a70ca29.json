    {
      "additions": 33,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/be9d4b8b5f008697cc8114cf70cb536521c9edd1/torchtitan%2Fexperiments%2Fgraph_trainer%2Fsubgraph_regions.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fexperiments%2Fgraph_trainer%2Fsubgraph_regions.py?ref=be9d4b8b5f008697cc8114cf70cb536521c9edd1",
      "deletions": 0,
      "filename": "torchtitan/experiments/graph_trainer/subgraph_regions.py",
      "patch": "@@ -521,6 +521,39 @@ def make_outer_arg(\n     return region_node\n \n \n+def outline_backward_subgraph_pass(gm, example_inputs=None):\n+    \"\"\"Pass to outline backward regions into invoke_subgraph calls.\n+\n+    This allows to force Inductor compilation to materialize the saved for\n+    backward Tensors, as invoke_subgraphs subgraph is compiled independently.\n+    Without outlining inductor can decide to avoid materialization and do\n+    recompute from arguments, which breaks our contract of MUST_SAVE picked\n+    activations.\n+    \"\"\"\n+    regions = []\n+    current_region = []\n+    for node in gm.graph.nodes:\n+        if node.op not in (\"placeholder\", \"output\") and node.meta.get(\n+            \"autograd_backward\", False\n+        ):\n+            current_region.append(node)\n+        elif node.op != \"get_attr\" and current_region:\n+            regions.append(current_region)\n+            current_region = []\n+    if current_region:\n+        regions.append(current_region)\n+\n+    for index, region_nodes in enumerate(regions):\n+        mark_invoke_subgraph(\n+            gm.graph,\n+            region_nodes,\n+            region_name_prefix=f\"backward_subgraph_{index}\",\n+        )\n+    gm.graph.lint()\n+    gm.recompile()\n+    return gm\n+\n+\n def _record_subgraph_region(\n     module: torch.fx.GraphModule,\n     region_node: Node,",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/be9d4b8b5f008697cc8114cf70cb536521c9edd1/torchtitan%2Fexperiments%2Fgraph_trainer%2Fsubgraph_regions.py",
