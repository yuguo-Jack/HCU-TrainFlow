      "changes": 7,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fexperiments%2Ftorchft%2Fconfig%2Fjob_config.py?ref=5a1e6272e14c890bf6fab784aaaf843d23b79782",
      "deletions": 0,
      "filename": "torchtitan/experiments/torchft/config/job_config.py",
      "patch": "@@ -17,6 +17,13 @@ class FaultTolerance(TorchFTManager.Config):\n     Extends TorchFTManager.Config to also support Streaming DiLoCo\n     \"\"\"\n \n+    local_sgd_offload_to_cpu: bool = False\n+    \"\"\"\n+    Stage averaged LocalSGD parameters on CPU until the quorum commits.\n+    This reduces peak accelerator memory at synchronization time at the cost\n+    of host transfers and host memory.\n+    \"\"\"\n+\n     sync_steps: int = 5\n     \"\"\"\n     Number of steps to wait before performing synchronization. This is only used when \"semi_sync_method\"",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/5a1e6272e14c890bf6fab784aaaf843d23b79782/torchtitan%2Fexperiments%2Ftorchft%2Fconfig%2Fjob_config.py",
