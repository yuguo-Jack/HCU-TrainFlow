      "additions": 42,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/32975ec6f5d5c32e8718927c66828ad9ab74244c/tests%2Funit_tests%2Fgpu%2Fmodels%2Fcommon%2Ftest_rmsnorm_compile.py",
      "changes": 42,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fgpu%2Fmodels%2Fcommon%2Ftest_rmsnorm_compile.py?ref=32975ec6f5d5c32e8718927c66828ad9ab74244c",
      "deletions": 0,
      "filename": "tests/unit_tests/gpu/models/common/test_rmsnorm_compile.py",
      "patch": "@@ -0,0 +1,42 @@\n+# Copyright (c) Meta Platforms, Inc. and affiliates.\n+# All rights reserved.\n+#\n+# This source code is licensed under the BSD-style license found in the\n+# LICENSE file in the root directory of this source tree.\n+\n+import pytest\n+import torch\n+\n+from torchtitan.distributed.local_compile import apply_local_compile\n+from torchtitan.models.common import RMSNorm\n+\n+\n+pytestmark = pytest.mark.skipif(not torch.cuda.is_available(), reason=\"needs CUDA\")\n+\n+\n+@pytest.mark.parametrize(\"shape\", [(64, 2048), (64, 8, 128)])\n+def test_rmsnorm_region_matches_eager(shape):\n+    torch.manual_seed(0)\n+    norm = RMSNorm.Config(normalized_shape=shape[-1], eps=1e-6).build().cuda()\n+    with torch.no_grad():\n+        norm.weight.uniform_(0.5, 1.5)\n+    norm = norm.to(torch.bfloat16)\n+    x = torch.randn(shape, device=\"cuda\", dtype=torch.bfloat16)\n+\n+    def run(regions):\n+        apply_local_compile(regions)\n+        norm.weight.grad = None\n+        leaf = x.clone().requires_grad_()\n+        out = norm(leaf)\n+        out.backward(torch.ones_like(out))\n+        return out, leaf.grad, norm.weight.grad\n+\n+    try:\n+        expected = run([])\n+        actual = run([\"rmsnorm\"])\n+    finally:\n+        apply_local_compile([])\n+        torch._dynamo.reset()\n+\n+    for actual_tensor, expected_tensor in zip(actual, expected, strict=True):\n+        torch.testing.assert_close(actual_tensor, expected_tensor, atol=2e-2, rtol=2e-2)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/32975ec6f5d5c32e8718927c66828ad9ab74244c/tests%2Funit_tests%2Fgpu%2Fmodels%2Fcommon%2Ftest_rmsnorm_compile.py",
      "sha": "bb22a80bb133f2de75fe5f3f683f4471cd132c89",
      "status": "added"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/32975ec6f5d5c32e8718927c66828ad9ab74244c/torchtitan%2Fmodels%2Fcommon%2Fnn_modules.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Fnn_modules.py?ref=32975ec6f5d5c32e8718927c66828ad9ab74244c",
      "deletions": 2,
      "filename": "torchtitan/models/common/nn_modules.py",
      "patch": "@@ -20,6 +20,9 @@\n \n import torch\n import torch.nn as nn\n+import torch.nn.functional as F\n+\n+from torchtitan.distributed.local_compile import local_compile\n \n from torchtitan.models.base.module import Module\n \n@@ -150,9 +153,13 @@ def __init__(self, config: Config):\n \n     # ShardingConfig keys use \"input\" for both RMSNorm and LayerNorm; some\n     # PyTorch versions name the RMSNorm argument \"x\".\n-    # pyrefly: ignore[bad-param-name-override]\n+    # Opt-in region: eager rms_norm runs ATen's layer-norm kernels (one\n+    # forward, separate input- and weight-grad backward kernels); compiling\n+    # fuses each direction into one Triton kernel. Limit 16, not the default\n+    # 8: every norm shape in a model (residual stream, per-head q/k) shares it.\n+    @local_compile(\"rmsnorm\", batch_invariant=False, recompile_limit=16)\n     def forward(self, input: torch.Tensor) -> torch.Tensor:\n-        return super().forward(input)\n+        return F.rms_norm(input, self.normalized_shape, self.weight, self.eps)\n \n \n __all__ = [",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/32975ec6f5d5c32e8718927c66828ad9ab74244c/torchtitan%2Fmodels%2Fcommon%2Fnn_modules.py",
      "sha": "9c969b82b3e909fa09bbca65e96f5d272ddc12aa",
      "status": "modified"
    }
  ],
