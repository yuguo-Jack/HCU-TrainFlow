    {
      "additions": 6,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/a59b3eef49bfb8c5012a164e1689fdb3ae444b4d/torchtitan%2Frl%2FREADME.md",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2FREADME.md?ref=a59b3eef49bfb8c5012a164e1689fdb3ae444b4d",
      "deletions": 0,
      "filename": "torchtitan/rl/README.md",
      "patch": "@@ -175,6 +175,12 @@ python -m torchtitan.rl.train \\\n   --output-dir outputs/rl/my_experiment\n ```\n \n+On a single host, set `CUDA_VISIBLE_DEVICES` on this command to select physical\n+GPUs. The trainer receives the first GPUs in the list, followed by the\n+generators. For a recipe with two trainer and two generator GPUs, setting\n+`CUDA_VISIBLE_DEVICES=4,5,6,7` assigns GPUs 4-5 to training and 6-7 to\n+generation. Without the variable, allocation starts at GPU 0 as before.\n+\n ## Experiments\n \n ### DAPO Math: reference experiment",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/a59b3eef49bfb8c5012a164e1689fdb3ae444b4d/torchtitan%2Frl%2FREADME.md",
      "sha": "97253ff42e81fb6c1ffe96b9ad9b09e82d3d7dd8",
      "status": "modified"
    },
    {
      "additions": 31,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/a59b3eef49bfb8c5012a164e1689fdb3ae444b4d/torchtitan%2Frl%2Factors%2Fmonarch%2Fprovisioning.py",
      "changes": 38,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Factors%2Fmonarch%2Fprovisioning.py?ref=a59b3eef49bfb8c5012a164e1689fdb3ae444b4d",
      "deletions": 7,
      "filename": "torchtitan/rl/actors/monarch/provisioning.py",
      "patch": "@@ -8,6 +8,7 @@\n CPU meshes on the controller host, and the Monarch client's shutdown.\"\"\"\n \n import logging\n+import os\n from collections.abc import Callable\n from dataclasses import dataclass\n \n@@ -68,7 +69,7 @@ def _bootstrap_generator() -> None:\n \n \n class PerHostProvisioner:\n-    \"\"\"Allocates non-overlapping GPU ranges within a single host.\n+    \"\"\"Allocates non-overlapping GPUs within a single host.\n \n     On the same host, the trainer and generator run on separate GPU\n     meshes (e.g. GPUs 0-3 for training, GPUs 4-7 for generation). Each\n@@ -77,8 +78,11 @@ class PerHostProvisioner:\n     returned env vars are applied to the spawned process via ``bootstrap_command``.\n     \"\"\"\n \n-    def __init__(self, total_gpus: int = 8):\n+    def __init__(self, total_gpus: int = 8, *, gpu_ids: list[str] | None = None):\n         self.total_gpus = total_gpus\n+        self.gpu_ids = (\n+            [str(gpu_id) for gpu_id in range(total_gpus)] if gpu_ids is None else gpu_ids\n+        )\n         self.next_gpu = 0\n \n     @property\n@@ -93,15 +97,34 @@ def allocate(\n                 f\"Requested {num_gpus} GPUs but only {self.available} \"\n                 f\"available (total={self.total_gpus}, allocated={self.next_gpu})\"\n             )\n-        gpu_ids = list(range(self.next_gpu, self.next_gpu + num_gpus))\n+        gpu_ids = self.gpu_ids[self.next_gpu : self.next_gpu + num_gpus]\n         self.next_gpu += num_gpus\n \n-        env = {\"CUDA_VISIBLE_DEVICES\": \",\".join(str(g) for g in gpu_ids)}\n+        env = {\"CUDA_VISIBLE_DEVICES\": \",\".join(gpu_ids)}\n         if extra_env:\n             env.update(extra_env)\n         return env\n \n \n+def _local_gpu_ids(total_gpus: int) -> list[str] | None:\n+    visible_devices = os.environ.get(\"CUDA_VISIBLE_DEVICES\")\n+    if visible_devices is None:\n+        return None\n+\n+    gpu_ids = [gpu_id.strip() for gpu_id in visible_devices.split(\",\")]\n+    if not all(gpu_ids) or len(set(gpu_ids)) != len(gpu_ids):\n+        raise ValueError(\n+            \"CUDA_VISIBLE_DEVICES must contain distinct, nonempty GPU IDs; \"\n+            f\"got {visible_devices!r}\"\n+        )\n+    if len(gpu_ids) < total_gpus:\n+        raise ValueError(\n+            f\"CUDA_VISIBLE_DEVICES lists {len(gpu_ids)} GPUs, but the trainer \"\n+            f\"and generators need {total_gpus}: {visible_devices!r}\"\n+        )\n+    return gpu_ids[:total_gpus]\n+\n+\n @dataclass\n class HostMeshes:\n     trainer: HostMesh\n@@ -264,10 +287,11 @@ def spawn_proc_mesh(\n             for gen_host_mesh in generator_host_meshes\n         ]\n     else:\n-        # Single-node mode: partition GPUs on this_host() via\n-        # CUDA_VISIBLE_DEVICES\n+        # Single-node mode: partition the controller's visible GPUs between roles.\n         host_mesh = this_host()\n-        provisioner = PerHostProvisioner(total_gpus=total_gpus)\n+        provisioner = PerHostProvisioner(\n+            total_gpus=total_gpus, gpu_ids=_local_gpu_ids(total_gpus)\n+        )\n         trainer_mesh = host_mesh.spawn_procs(\n             per_host={\"gpus\": trainer_world_size},\n             bootstrap=_preimport_torch,",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/a59b3eef49bfb8c5012a164e1689fdb3ae444b4d/torchtitan%2Frl%2Factors%2Fmonarch%2Fprovisioning.py",
