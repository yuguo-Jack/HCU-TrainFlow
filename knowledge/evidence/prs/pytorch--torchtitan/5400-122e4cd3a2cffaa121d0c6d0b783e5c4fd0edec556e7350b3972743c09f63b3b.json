      "additions": 87,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/bd5958684be08b50462c81cb3847ac474c4888c2/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_flex_attention.py",
      "changes": 89,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_flex_attention.py?ref=bd5958684be08b50462c81cb3847ac474c4888c2",
      "deletions": 2,
      "filename": "tests/unit_tests/cpu/models/common/test_flex_attention.py",
      "patch": "@@ -9,9 +9,14 @@\n from unittest.mock import patch\n \n import torch\n-from torch.nn.attention.flex_attention import create_block_mask\n+from torch.nn.attention.flex_attention import and_masks, create_block_mask\n \n-from torchtitan.models.common.attention import FlexInnerAttention\n+from torchtitan.models.common.attention import (\n+    FlexInnerAttention,\n+    get_causal_mask_mod,\n+    get_document_mask_mod,\n+    SlidingWindowFlexInnerAttention,\n+)\n \n \n class TestFlexInnerAttentionLayouts(unittest.TestCase):\n@@ -78,5 +83,85 @@ def out_transform(out_THV, lse_TH):\n         torch.testing.assert_close(out_THV, q_THK)\n \n \n+# Six packed documents in one 16-token sequence. Positions reset to 0 at each\n+# document start.\n+PACKED_POSITIONS = torch.tensor(\n+    [0, 1, 2, 0, 1, 0, 1, 2, 0, 1, 0, 1, 2, 3, 0, 1], dtype=torch.int32\n+)\n+# One document per sequence: block_causal and causal must agree here.\n+SINGLE_DOC_POSITIONS = torch.arange(16, dtype=torch.int32)\n+SEQ_LEN = 16\n+MASK_BLOCK_SIZE = 4\n+\n+\n+def _dense(mask_mods, seq_len: int) -> torch.Tensor:\n+    \"\"\"Materialize composed mask_mods into a [seq_len, seq_len] bool matrix.\"\"\"\n+    composed = and_masks(*mask_mods)\n+    b = h = torch.tensor(0)\n+    return torch.tensor(\n+        [\n+            [\n+                bool(composed(b, h, torch.tensor(q), torch.tensor(kv)))\n+                for kv in range(seq_len)\n+            ]\n+            for q in range(seq_len)\n+        ]\n+    )\n+\n+\n+def _mods(positions: torch.Tensor, mask_type: str) -> list:\n+    return FlexInnerAttention.Config(mask_type=mask_type)._causal_mask_mods(positions)\n+\n+\n+class TestFlexMaskType(unittest.TestCase):\n+    def test_mask_mods_match_mask_type(self) -> None:\n+        for positions in (PACKED_POSITIONS, SINGLE_DOC_POSITIONS):\n+            causal = _dense([get_causal_mask_mod()], SEQ_LEN)\n+            same_doc = _dense([get_document_mask_mod(positions)], SEQ_LEN)\n+            for mask_type, expected in (\n+                (\"block_causal\", causal & same_doc),\n+                (\"causal\", causal),\n+            ):\n+                with self.subTest(\n+                    single_doc=positions is SINGLE_DOC_POSITIONS, mask_type=mask_type\n+                ):\n+                    torch.testing.assert_close(\n+                        _dense(_mods(positions, mask_type), SEQ_LEN), expected\n+                    )\n+\n+    def test_block_causal_blocks_more_than_causal(self) -> None:\n+        causal = _dense(_mods(PACKED_POSITIONS, \"causal\"), SEQ_LEN)\n+        block_causal = _dense(_mods(PACKED_POSITIONS, \"block_causal\"), SEQ_LEN)\n+        # block_causal never allows what causal blocks, and allows strictly less.\n+        self.assertTrue(bool((block_causal <= causal).all()))\n+        self.assertLess(int(block_causal.sum()), int(causal.sum()))\n+\n+    def test_unknown_mask_type_refused(self) -> None:\n+        with self.assertRaises(ValueError):\n+            _mods(PACKED_POSITIONS, \"casual\")\n+\n+    def test_configs_default_to_block_causal_and_honor_mask_type(self) -> None:\n+        for name, make in (\n+            (\"flex\", lambda **kw: FlexInnerAttention.Config(**kw)),\n+            (\n+                \"sliding_window\",\n+                lambda **kw: SlidingWindowFlexInnerAttention.Config(\n+                    window_size=8, **kw\n+                ),\n+            ),\n+        ):\n+            with self.subTest(config=name):\n+                self.assertEqual(make().mask_type, \"block_causal\")\n+                block_causal = make(\n+                    block_size=MASK_BLOCK_SIZE\n+                ).build_attention_metadata(PACKED_POSITIONS)\n+                causal = make(\n+                    block_size=MASK_BLOCK_SIZE, mask_type=\"causal\"\n+                ).build_attention_metadata(PACKED_POSITIONS)\n+                self.assertFalse(\n+                    bool(torch.equal(block_causal.to_dense(), causal.to_dense()))\n+                )\n+\n+\n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/bd5958684be08b50462c81cb3847ac474c4888c2/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_flex_attention.py",
      "sha": "ede3a57f8c9e1d2bec2e63f2627311d8f6cb40a7",
      "status": "modified"
    },
    {
      "additions": 41,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/bd5958684be08b50462c81cb3847ac474c4888c2/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py",
      "changes": 50,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py?ref=bd5958684be08b50462c81cb3847ac474c4888c2",
      "deletions": 9,
      "filename": "torchtitan/models/common/attention/attention.py",
      "patch": "@@ -14,7 +14,7 @@\n \n from collections.abc import Callable\n from dataclasses import dataclass, field\n-from typing import Any, ClassVar, NamedTuple, TYPE_CHECKING, TypeAlias\n+from typing import Any, ClassVar, Literal, NamedTuple, TYPE_CHECKING, TypeAlias\n \n import spmd_types as spmd\n import torch\n@@ -297,6 +297,42 @@ class FlexInnerAttention(InnerAttention):\n     class Config(InnerAttention.Config):\n         block_size: int | tuple[int, int] = _DEFAULT_SPARSE_BLOCK_SIZE\n         kernel_options: dict = field(default_factory=dict)\n+        mask_type: Literal[\"block_causal\", \"causal\"] = \"block_causal\"\n+        \"\"\"\n+        Causal mask for the flex path. ``\"block_causal\"`` (default) is causal\n+        within each packed document: it reads ``positions``, which reset to 0 at\n+        each document start. ``\"causal\"`` is plain causal over the whole\n+        sequence and does not read ``positions``. The two are equivalent when\n+        each sequence holds one document; ``\"causal\"`` is only correct in that\n+        case.\n+        \"\"\"\n+\n+        def _causal_mask_mods(\n+            self, positions: torch.Tensor\n+        ) -> list[_mask_mod_signature]:\n+            \"\"\"Return the causal mask_mods that ``mask_type`` selects.\n+\n+            Args:\n+                positions: Per-token position tensor with shape ``[T]``, reset\n+                    to 0 at each packed-document start.\n+\n+            Returns:\n+                The mask_mods to compose with ``and_masks``.\n+\n+            Raises:\n+                ValueError: If ``mask_type`` is not a known value.\n+            \"\"\"\n+            if self.mask_type == \"causal\":\n+                return [get_causal_mask_mod()]\n+            if self.mask_type == \"block_causal\":\n+                return [\n+                    get_causal_mask_mod(),\n+                    get_efficient_causal_mask_mod_for_packed_document(positions),\n+                ]\n+            raise ValueError(\n+                f\"mask_type={self.mask_type!r} is not known. \"\n+                \"Use 'block_causal' or 'causal'.\"\n+            )\n \n         def build_attention_metadata(\n             self,\n@@ -306,14 +342,11 @@ def build_attention_metadata(\n             max_num_documents: int | None = None,\n             max_context_length: int | None = None,\n         ) -> FlexAttentionMetadata:\n-            \"\"\"Build the standard document-causal FlexAttention BlockMask.\"\"\"\n+            \"\"\"Build the causal FlexAttention BlockMask selected by ``mask_type``.\"\"\"\n             del padding_mask, max_num_documents, max_context_length\n             seq_len = positions.shape[0]\n             return create_attention_mask(\n-                and_masks(\n-                    get_causal_mask_mod(),\n-                    get_efficient_causal_mask_mod_for_packed_document(positions),\n-                ),\n+                and_masks(*self._causal_mask_mods(positions)),\n                 1,\n                 None,\n                 seq_len,\n@@ -479,13 +512,12 @@ def build_attention_metadata(\n             max_num_documents: int | None = None,\n             max_context_length: int | None = None,\n         ) -> FlexAttentionMetadata:\n-            \"\"\"Build the document-causal sliding-window FlexAttention BlockMask.\"\"\"\n+            \"\"\"Build the sliding-window BlockMask selected by ``mask_type``.\"\"\"\n             del padding_mask, max_num_documents, max_context_length\n             seq_len = positions.shape[0]\n             return create_attention_mask(\n                 and_masks(\n-                    get_causal_mask_mod(),\n-                    get_efficient_causal_mask_mod_for_packed_document(positions),\n+                    *self._causal_mask_mods(positions),\n                     get_sliding_window_mask_mod(self.window_size),\n                 ),\n                 1,",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/bd5958684be08b50462c81cb3847ac474c4888c2/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py",
      "sha": "a1bb86d528af8c7d70d731caa77c3cfe016316a3",
