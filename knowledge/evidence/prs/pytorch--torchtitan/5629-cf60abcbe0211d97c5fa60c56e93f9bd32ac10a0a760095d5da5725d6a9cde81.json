  "files": [
    {
      "additions": 12,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/ed02f3e4588b055cc485ad4d5107ba554210ce6c/torchtitan%2Fexperiments%2Fgraph_trainer%2Fcpu_offload.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fexperiments%2Fgraph_trainer%2Fcpu_offload.py?ref=ed02f3e4588b055cc485ad4d5107ba554210ce6c",
      "deletions": 2,
      "filename": "torchtitan/experiments/graph_trainer/cpu_offload.py",
      "patch": "@@ -52,6 +52,7 @@\n     _is_backward_node,\n     _NOT_IN_LAYERS,\n )\n+from torchtitan.experiments.graph_trainer.mutation_utils import mutation_deps\n \n logger = logging.getLogger(__name__)\n \n@@ -544,6 +545,7 @@ def apply_cpu_offload_pass(\n         return gm\n \n     # 3. Insert offload/reload/wait_tensor ops.\n+    writes_by_base = mutation_deps(gm.graph)\n     total_bytes = 0\n     wait_offload_map: dict[Node, Node] = {}\n \n@@ -560,8 +562,16 @@ def apply_cpu_offload_pass(\n         # that tlparse/graph dumps show stacktraces and module_fqn.\n         src_meta = {k: v for k, v in node.meta.items() if k not in (\"val\", \"recompute\")}\n \n-        # --- Forward: async GPU->CPU offload right after production ---\n-        with gm.graph.inserting_after(node):\n+        # --- Forward: async GPU->CPU offload after the last forward write ---\n+        # ao.offload snapshots the tensor when it runs, so it must follow any\n+        # in-place write into this storage (e.g. through a view); otherwise\n+        # backward reloads the pre-write value. Without writes this is right\n+        # after production.\n+        forward_writes = [\n+            w for w in writes_by_base.get(node, []) if not _is_backward_node(w)\n+        ]\n+        offload_anchor = forward_writes[-1] if forward_writes else node\n+        with gm.graph.inserting_after(offload_anchor):\n             offload_node = gm.graph.call_function(\n                 torch.ops.ao.offload.default,\n                 args=(node,),",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/ed02f3e4588b055cc485ad4d5107ba554210ce6c/torchtitan%2Fexperiments%2Fgraph_trainer%2Fcpu_offload.py",
      "sha": "4dbba2b7f34b53626b4f21c3b9f649a73bc2c58c",
      "status": "modified"
    },
    {
      "additions": 129,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/ed02f3e4588b055cc485ad4d5107ba554210ce6c/torchtitan%2Fexperiments%2Fgraph_trainer%2Ftests%2Ftest_cpu_offload.py",
      "changes": 129,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fexperiments%2Fgraph_trainer%2Ftests%2Ftest_cpu_offload.py?ref=ed02f3e4588b055cc485ad4d5107ba554210ce6c",
      "deletions": 0,
      "filename": "torchtitan/experiments/graph_trainer/tests/test_cpu_offload.py",
      "patch": "@@ -900,3 +900,132 @@ def test_single_layer_tagged(self):\n         self.assertGreater(\n             len(tagged), 0, \"Single layer nodes can be tagged (last_layer_id=None)\"\n         )\n+\n+    def test_offload_follows_forward_write_through_view(self):\n+        \"\"\"The D2H copy must start after in-place writes into the offloaded storage.\n+\n+        ``ao.offload`` snapshots the tensor when it runs. Here the forward pass\n+        writes into ``mm`` through a view after producing it, and backward reads\n+        ``mm`` itself, so offloading right after ``mm`` would reload the\n+        pre-write value.\n+        \"\"\"\n+        from torchtitan.experiments.graph_trainer.cpu_offload import (\n+            apply_cpu_offload_pass,\n+            tag_all_offloadable_activations,\n+        )\n+\n+        graph = torch.fx.Graph()\n+        x = graph.placeholder(\"x\")\n+        x.meta[\"val\"] = self._make_fake_val()\n+\n+        def fwd(target, args, val, fqn=\"layers.0.block\"):\n+            node = graph.call_function(target, args=args)\n+            node.meta[\"autograd_backward\"] = False\n+            node.meta[\"custom\"] = {\"module_fqn\": fqn}\n+            node.meta[\"val\"] = val\n+            return node\n+\n+        mm = fwd(torch.ops.aten.mm.default, (x, x), self._make_fake_val())\n+        flat = fwd(\n+            torch.ops.aten.view.default, (mm, [-1]), self._make_fake_val((4096,))\n+        )\n+        half = fwd(\n+            torch.ops.aten.slice.Tensor,\n+            (flat, 0, 0, 2048),\n+            self._make_fake_val((2048,)),\n+        )\n+        write = fwd(\n+            torch.ops.aten.add_.Tensor, (half, 1.0), self._make_fake_val((2048,))\n+        )\n+        mm2 = fwd(\n+            torch.ops.aten.mm.default, (mm, mm), self._make_fake_val(), \"layers.1.block\"\n+        )\n+        bwd = graph.call_function(torch.ops.aten.mm.default, args=(mm2, mm))\n+        bwd.meta[\"autograd_backward\"] = True\n+        bwd.meta[\"custom\"] = {\"module_fqn\": \"layers.0.block\"}\n+        bwd.meta[\"val\"] = self._make_fake_val()\n+        graph.output(bwd)\n+        gm = torch.fx.GraphModule(torch.nn.Module(), graph)\n+\n+        tag_all_offloadable_activations(gm)\n+        self.assertIs(mm.meta.get(\"recompute\"), CheckpointPolicy.MUST_CPU_OFFLOAD)\n+        apply_cpu_offload_pass(gm, prefetch_lookahead=0)\n+\n+        (offload,) = gm.graph.find_nodes(\n+            op=\"call_function\", target=torch.ops.ao.offload.default\n+        )\n+        self.assertIs(offload.args[0], mm)\n+        node_pos = {n: i for i, n in enumerate(gm.graph.nodes)}\n+        self.assertGreater(node_pos[offload], node_pos[write])\n+\n+    def test_sac_and_offload_with_forward_view_write_matches_eager(self):\n+        \"\"\"End to end: offloading a tensor written through a view keeps gradients.\"\"\"\n+        from types import SimpleNamespace\n+\n+        from torchtitan.config.parallelism import ParallelismConfig\n+        from torchtitan.experiments.graph_trainer.common_utils import (\n+            annotate_module_fqns,\n+        )\n+        from torchtitan.experiments.graph_trainer.configs import (\n+            GraphTrainerCompileConfig,\n+        )\n+        from torchtitan.experiments.graph_trainer.cpu_offload import (\n+            apply_cpu_offload_pass,\n+        )\n+        from torchtitan.experiments.graph_trainer.make_fx_tracer import (\n+            minimal_fx_tracer,\n+            run_traced,\n+        )\n+        from torchtitan.experiments.graph_trainer.memory_policy import (\n+            tag_with_memory_policy_pass,\n+        )\n+        from torchtitan.experiments.graph_trainer.selective_activation_remat import (\n+            selective_activation_remat_pass,\n+        )\n+\n+        class Layer(torch.nn.Module):\n+            def __init__(self, dim):\n+                super().__init__()\n+                self.lin = torch.nn.Linear(dim, dim, bias=False)\n+\n+            def forward(self, x):\n+                h = self.lin(x)\n+                h.view(-1)[: h.numel() // 2].add_(1.0)\n+                return h * h\n+\n+        class Model(torch.nn.Module):\n+            def __init__(self):\n+                super().__init__()\n+                # Offload tagging finds layers by \"layers.<i>\" module FQNs.\n+                self.layers = torch.nn.Sequential(*(Layer(256) for _ in range(3)))\n+\n+            def forward(self, x):\n+                return self.layers(x)\n+\n+        torch.manual_seed(0)\n+        model = Model().cuda()\n+        inputs = torch.randn(128, 256, device=\"cuda\")\n+\n+        def step(inp):\n+            loss = model(inp).sum()\n+            return list(torch.autograd.grad(loss, tuple(model.parameters())))\n+\n+        expected = step(inputs)\n+        annotate_module_fqns(model)\n+        traced = minimal_fx_tracer(step, module=model)(inputs)\n+        config = SimpleNamespace(\n+            compile=GraphTrainerCompileConfig(memory_policy=\"sac_and_offload\"),\n+            parallelism=ParallelismConfig(),\n+        )\n+        tag_with_memory_policy_pass(traced.gm, config=config)\n+        traced.gm = apply_cpu_offload_pass(traced.gm)\n+        traced.gm = selective_activation_remat_pass(traced.gm)\n+        self.assertTrue(\n+            traced.gm.graph.find_nodes(\n+                op=\"call_function\", target=torch.ops.ao.offload.default\n+            )\n+        )\n+\n+        grads = run_traced(traced, module=model)(inputs)\n+        for grad, ref in zip(grads, expected, strict=True):\n+            self.assertEqual(grad, ref, atol=0, rtol=0)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/ed02f3e4588b055cc485ad4d5107ba554210ce6c/torchtitan%2Fexperiments%2Fgraph_trainer%2Ftests%2Ftest_cpu_offload.py",
      "sha": "76b3b8b421accf336e31a63ef7b96030de7d5092",
      "status": "modified"
