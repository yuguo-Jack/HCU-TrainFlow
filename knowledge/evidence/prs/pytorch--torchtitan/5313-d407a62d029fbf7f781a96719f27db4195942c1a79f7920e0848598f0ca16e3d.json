    {
      "additions": 58,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/c1424fc60b9607811f780b72f52319b58c1b03c8/tests%2Funit_tests%2Fcpu%2Ftest_seed_checkpoint_launch.py",
      "changes": 58,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Ftest_seed_checkpoint_launch.py?ref=c1424fc60b9607811f780b72f52319b58c1b03c8",
      "deletions": 0,
      "filename": "tests/unit_tests/cpu/test_seed_checkpoint_launch.py",
      "patch": "@@ -0,0 +1,58 @@\n+# Copyright (c) Meta Platforms, Inc. and affiliates.\n+# All rights reserved.\n+#\n+# This source code is licensed under the BSD-style license found in the\n+# LICENSE file in the root directory of this source tree.\n+\n+from types import SimpleNamespace\n+\n+import pytest\n+\n+from torchtitan.train import _require_seed_checkpoint_launch\n+\n+\n+def _patch_world_size(monkeypatch: pytest.MonkeyPatch, world_size: int) -> None:\n+    monkeypatch.setattr(\n+        \"torchtitan.train.torch.distributed.is_initialized\", lambda: True\n+    )\n+    monkeypatch.setattr(\n+        \"torchtitan.train.torch.distributed.get_world_size\", lambda: world_size\n+    )\n+\n+\n+def test_seed_checkpoint_accepts_one_device_without_world_size(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    monkeypatch.delenv(\"WORLD_SIZE\", raising=False)\n+    _patch_world_size(monkeypatch, 1)\n+\n+    _require_seed_checkpoint_launch(SimpleNamespace(checkpointer=object()))\n+\n+\n+def test_seed_checkpoint_rejects_multiple_devices(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    _patch_world_size(monkeypatch, 4)\n+\n+    with pytest.raises(ValueError, match=r\"single device.*world size 4\"):\n+        _require_seed_checkpoint_launch(SimpleNamespace(checkpointer=object()))\n+\n+\n+def test_seed_checkpoint_rejects_missing_checkpointer(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    _patch_world_size(monkeypatch, 1)\n+\n+    with pytest.raises(ValueError, match=r\"configure checkpointer\"):\n+        _require_seed_checkpoint_launch(SimpleNamespace(checkpointer=None))\n+\n+\n+def test_seed_checkpoint_rejects_uninitialized_process_group(\n+    monkeypatch: pytest.MonkeyPatch,\n+) -> None:\n+    monkeypatch.setattr(\n+        \"torchtitan.train.torch.distributed.is_initialized\", lambda: False\n+    )\n+\n+    with pytest.raises(ValueError, match=r\"initialized single-device\"):\n+        _require_seed_checkpoint_launch(SimpleNamespace(checkpointer=object()))",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/c1424fc60b9607811f780b72f52319b58c1b03c8/tests%2Funit_tests%2Fcpu%2Ftest_seed_checkpoint_launch.py",
      "sha": "82253567b3916226eefbccf8a1b5d96156940822",
      "status": "added"
    },
    {
      "additions": 25,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/c1424fc60b9607811f780b72f52319b58c1b03c8/torchtitan%2Ftrain.py",
      "changes": 32,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Ftrain.py?ref=c1424fc60b9607811f780b72f52319b58c1b03c8",
      "deletions": 7,
      "filename": "torchtitan/train.py",
      "patch": "@@ -5,7 +5,6 @@\n # LICENSE file in the root directory of this source tree.\n \n import logging\n-import os\n from typing import cast\n \n import torch\n@@ -19,6 +18,30 @@\n logger = logging.getLogger(__name__)\n \n \n+def _require_seed_checkpoint_launch(config: Trainer.Config) -> None:\n+    \"\"\"Reject a seed checkpoint that would shard initialization across ranks.\n+\n+    Distributed init has already chosen the process-group world size: ``NGPU``\n+    in fake mode, and the launched process count under ``torchrun``. Pure fake\n+    does not set ``WORLD_SIZE``.\n+    \"\"\"\n+    if not torch.distributed.is_initialized():\n+        raise ValueError(\n+            \"Must create a seed checkpoint on an initialized single-device \"\n+            \"process group.\"\n+        )\n+    world_size = torch.distributed.get_world_size()\n+    if world_size != 1:\n+        raise ValueError(\n+            \"Must create a seed checkpoint using a single device, to disable \"\n+            f\"sharding. Got world size {world_size}.\"\n+        )\n+    if config.checkpointer is None:\n+        raise ValueError(\n+            \"Must configure checkpointer when creating a seed checkpoint.\"\n+        )\n+\n+\n def main() -> None:\n     \"\"\"Main entry point for training.\"\"\"\n     init_logger()\n@@ -46,12 +69,7 @@ def main() -> None:\n         trainer = config.build()\n \n         if config.create_seed_checkpoint:\n-            assert (\n-                int(os.environ[\"WORLD_SIZE\"]) == 1\n-            ), \"Must create seed checkpoint using a single device, to disable sharding.\"\n-            assert (\n-                config.checkpointer is not None\n-            ), \"Must configure checkpointer when creating a seed checkpoint.\"\n+            _require_seed_checkpoint_launch(config)\n             trainer.engine.save_checkpoint(last_step=True)\n             logger.info(\"Created seed checkpoint\")\n         else:",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/c1424fc60b9607811f780b72f52319b58c1b03c8/torchtitan%2Ftrain.py",
      "sha": "1159530897e1eaa2ab4db509e8a154dce0faf42c",
      "status": "modified"
    }
