      "blob_url": "https://github.com/pytorch/torchtitan/blob/fac6df0b7805542710af8000aaf2264c9b7865c8/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_metrics.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_metrics.py?ref=fac6df0b7805542710af8000aaf2264c9b7865c8",
      "deletions": 1,
      "filename": "tests/rl/unit_tests/cpu/test_metrics.py",
      "patch": "@@ -694,10 +694,14 @@ def test_wandb_with_log_dir(self, tmp_path, monkeypatch) -> None:\n         # `wandb.init` was called with our log_dir + config_dict.\n         assert captured.get(\"dir\") == log_dir\n         assert captured.get(\"config\") == config_dict\n+        fake_wandb.define_metric.assert_any_call(\"trainer/step\")\n+        fake_wandb.define_metric.assert_any_call(\"*\", step_metric=\"trainer/step\")\n \n         # `log` forwards to the stub.\n         logger_inst.log(3, [m.Metric(\"k\", m.NoReduce(1.0))])\n-        fake_wandb.log.assert_called_once_with({\"k\": 1.0}, step=3, commit=True)\n+        fake_wandb.log.assert_called_once_with(\n+            {\"k\": 1.0, \"trainer/step\": 3}, commit=True\n+        )\n \n         # `close` calls `wandb.finish` when there's a run.\n         fake_wandb.run = MagicMock()",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/fac6df0b7805542710af8000aaf2264c9b7865c8/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_metrics.py",
      "sha": "4e74970b96fed224711367f3fb7f17705f7fddc7",
      "status": "modified"
    },
    {
      "additions": 32,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/fac6df0b7805542710af8000aaf2264c9b7865c8/tests%2Funit_tests%2Fcpu%2Fobservability%2Ftest_wandb_logger.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fobservability%2Ftest_wandb_logger.py?ref=fac6df0b7805542710af8000aaf2264c9b7865c8",
      "deletions": 1,
      "filename": "tests/unit_tests/cpu/observability/test_wandb_logger.py",
      "patch": "@@ -5,7 +5,7 @@\n # LICENSE file in the root directory of this source tree.\n \n import sys\n-from unittest.mock import MagicMock\n+from unittest.mock import MagicMock, call\n \n import pytest\n \n@@ -33,3 +33,34 @@ def test_wandb_run_tags_are_split(tmp_path, monkeypatch, env_value, expected):\n     WandBLogger(log_dir=str(tmp_path))\n \n     assert fake_wandb.init.call_args.kwargs[\"tags\"] == expected\n+\n+\n+def test_wandb_default_logs_with_explicit_step(tmp_path, monkeypatch):\n+    fake_wandb = MagicMock()\n+    monkeypatch.setitem(sys.modules, \"wandb\", fake_wandb)\n+\n+    logger = WandBLogger(log_dir=str(tmp_path))\n+    logger.log({\"loss/mean\": 0.25}, step=3)\n+\n+    fake_wandb.define_metric.assert_not_called()\n+    fake_wandb.log.assert_called_once_with({\"loss/mean\": 0.25}, step=3, commit=True)\n+\n+\n+def test_wandb_custom_step_logs_validation_after_training(tmp_path, monkeypatch):\n+    fake_wandb = MagicMock()\n+    monkeypatch.setitem(sys.modules, \"wandb\", fake_wandb)\n+\n+    logger = WandBLogger(log_dir=str(tmp_path), step_metric=\"trainer/step\")\n+    logger.log({\"validation_reward/_mean\": 0.1}, step=0)\n+    logger.log({\"rollout_reward/_mean\": 0.5}, step=150)\n+    logger.log({\"validation_reward/_mean\": 0.17}, step=150)\n+\n+    assert fake_wandb.define_metric.call_args_list == [\n+        call(\"trainer/step\"),\n+        call(\"*\", step_metric=\"trainer/step\"),\n+    ]\n+    assert fake_wandb.log.call_args_list == [\n+        call({\"validation_reward/_mean\": 0.1, \"trainer/step\": 0}, commit=True),\n+        call({\"rollout_reward/_mean\": 0.5, \"trainer/step\": 150}, commit=True),\n+        call({\"validation_reward/_mean\": 0.17, \"trainer/step\": 150}, commit=True),\n+    ]",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/fac6df0b7805542710af8000aaf2264c9b7865c8/tests%2Funit_tests%2Fcpu%2Fobservability%2Ftest_wandb_logger.py",
      "sha": "05a58cfd5916aae5fbec269e0607cb250db2b05d",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/fac6df0b7805542710af8000aaf2264c9b7865c8/torchtitan%2Fobservability%2Fmetrics.py",
      "changes": 13,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fobservability%2Fmetrics.py?ref=fac6df0b7805542710af8000aaf2264c9b7865c8",
      "deletions": 1,
      "filename": "torchtitan/observability/metrics.py",
      "patch": "@@ -170,12 +170,15 @@ def __init__(\n         log_dir: str,\n         config_dict: dict[str, Any] | None = None,\n         tag: str | None = None,\n+        *,\n+        step_metric: str | None = None,\n     ):\n         # Import wandb here to avoid startup import\n         import wandb\n \n         self.wandb = wandb\n         self.tag = tag\n+        self.step_metric = step_metric\n \n         # Create logging directory\n         os.makedirs(log_dir, exist_ok=True)\n@@ -199,14 +202,22 @@ def __init__(\n             dir=log_dir,\n             config=config_dict,\n         )\n+        if step_metric is not None:\n+            # Validation may follow training at the same model step; W&B's\n+            # internal commit index must still advance between those logs.\n+            self.wandb.define_metric(step_metric)\n+            self.wandb.define_metric(\"*\", step_metric=step_metric)\n         logger.info(\"WandB logging enabled\")\n \n     def log(self, metrics: dict[str, Any], step: int) -> None:\n         wandb_metrics = {\n             (k if self.tag is None else f\"{self.tag}/{k}\"): v\n             for k, v in metrics.items()\n         }\n-        self.wandb.log(wandb_metrics, step=step, commit=True)\n+        if self.step_metric is None:\n+            self.wandb.log(wandb_metrics, step=step, commit=True)\n+        else:\n+            self.wandb.log({**wandb_metrics, self.step_metric: step}, commit=True)\n \n     def close(self) -> None:\n         if self.wandb.run is not None:",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/fac6df0b7805542710af8000aaf2264c9b7865c8/torchtitan%2Fobservability%2Fmetrics.py",
      "sha": "1ee1f64a945d2bd12be009be3ca4e896d52696dd",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/fac6df0b7805542710af8000aaf2264c9b7865c8/torchtitan%2Frl%2Fobservability%2Fmetrics%2FREADME.md",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fobservability%2Fmetrics%2FREADME.md?ref=fac6df0b7805542710af8000aaf2264c9b7865c8",
      "deletions": 0,
      "filename": "torchtitan/rl/observability/metrics/README.md",
      "patch": "@@ -145,6 +145,11 @@ add the corresponding backend at build time. Both require `log_dir` to be\n passed to `MetricsProcessor.Config.build(...)`. `WANDB_PROJECT` defaults to\n `titan_rl`; set the env var or `wandb_project=` on the config to override.\n \n+RL metrics use `trainer/step` as their W&B step metric. Use that axis when\n+plotting optimizer steps: training and post-training validation at the final\n+step are separate W&B events with the same `trainer/step` value. W&B's internal\n+`_step` counts logging events, not optimizer updates.\n+\n ## vLLM engine metrics\n \n `VllmOtelStatLogger` exports engine-level rollout metrics through",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/fac6df0b7805542710af8000aaf2264c9b7865c8/torchtitan%2Frl%2Fobservability%2Fmetrics%2FREADME.md",
      "sha": "58ad83c4e12314bbcd465405da47ae3275cc486d",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/fac6df0b7805542710af8000aaf2264c9b7865c8/torchtitan%2Frl%2Fobservability%2Fmetrics%2Fprocessor.py",
      "changes": 8,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fobservability%2Fmetrics%2Fprocessor.py?ref=fac6df0b7805542710af8000aaf2264c9b7865c8",
      "deletions": 1,
      "filename": "torchtitan/rl/observability/metrics/processor.py",
      "patch": "@@ -121,7 +121,13 @@ def __init__(\n             )\n         if config.enable_wandb:\n             os.environ.setdefault(\"WANDB_PROJECT\", config.wandb_project)\n-            self._backends.append(WandBLogger(log_dir=log_dir, config_dict=job_config))\n+            self._backends.append(\n+                WandBLogger(\n+                    log_dir=log_dir,\n+                    config_dict=job_config,\n+                    step_metric=\"trainer/step\",\n+                )\n+            )\n         if config.enable_tensorboard:\n             self._backends.append(TensorBoardLogger(log_dir=log_dir))\n ",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/fac6df0b7805542710af8000aaf2264c9b7865c8/torchtitan%2Frl%2Fobservability%2Fmetrics%2Fprocessor.py",
