      "additions": 5,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/7d5098cb4dbc6bc9bc81812dcb9da98bf786ac14/.flake8",
      "changes": 5,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/.flake8?ref=7d5098cb4dbc6bc9bc81812dcb9da98bf786ac14",
      "deletions": 0,
      "filename": ".flake8",
      "patch": "@@ -10,6 +10,11 @@ max-line-length = 120\n # N803,N806 allow caps and mixed case in function params. This is to work with Triton kernel coding style.\n ignore =\n     E203,E305,E402,E501,E721,E741,F405,F821,F841,F999,W503,W504,C408,E302,W291,E303,N812,N817,E731,N803,N806\n+    # E704 flags `def f(...) -> T: ...` (ellipsis-only body). That form is what the\n+    # formatter emits -- `ruff format` reports these files as already formatted and\n+    # collapses an expanded body back onto one line -- so the violation cannot be\n+    # fixed from the source side without fighting the formatter.\n+    E704\n     # shebang has extra meaning in fbcode lints, so I think it's not worth trying\n     # to line this up with executable bit\n     EXE001,",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/7d5098cb4dbc6bc9bc81812dcb9da98bf786ac14/.flake8",
      "sha": "a083693b46463652f3e63dc504f764fa052fbf2e",
      "status": "modified"
    }
