      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_vllm_attention.py?ref=26cef5ac4d2b9dfd4c6c935bd39ec03a038e70d8",
      "deletions": 0,
      "filename": "tests/rl/unit_tests/cpu/test_vllm_attention.py",
      "patch": "@@ -0,0 +1,27 @@\n+# Copyright (c) Meta Platforms, Inc. and affiliates.\n+# All rights reserved.\n+#\n+# This source code is licensed under the BSD-style license found in the\n+# LICENSE file in the root directory of this source tree.\n+\n+from unittest.mock import patch\n+\n+import pytest\n+\n+import torchtitan.rl.generator.vllm.attention as vllm_attention\n+\n+\n+@pytest.mark.parametrize(\n+    \"backend\",\n+    [\n+        vllm_attention.TorchTitanVarlenInnerAttentionBackend,\n+        vllm_attention.TorchTitanVarlenInnerAttentionDiffKVBackend,\n+    ],\n+)\n+@pytest.mark.parametrize(\"flash_impl, page_size\", [(\"FA4\", 128), (\"FA3\", 16)])\n+def test_kv_page_size_follows_flash_impl(backend, flash_impl, page_size):\n+    \"\"\"FA4 gets 128-token pages (its TMA path); other impls keep vLLM's default of 16.\"\"\"\n+    with patch.object(\n+        vllm_attention, \"get_cuda_flash_attention_impl\", return_value=flash_impl\n+    ):\n+        assert backend.get_preferred_block_size(16) == page_size",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/26cef5ac4d2b9dfd4c6c935bd39ec03a038e70d8/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_vllm_attention.py",
      "sha": "d742a098b8758c92707ea283ec1b6efed0c641d3",
      "status": "added"
    },
    {
      "additions": 28,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/26cef5ac4d2b9dfd4c6c935bd39ec03a038e70d8/torchtitan%2Frl%2Fgenerator%2Fvllm%2Fattention.py",
      "changes": 31,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fgenerator%2Fvllm%2Fattention.py?ref=26cef5ac4d2b9dfd4c6c935bd39ec03a038e70d8",
      "deletions": 3,
      "filename": "torchtitan/rl/generator/vllm/attention.py",
      "patch": "@@ -19,7 +19,7 @@\n from torch.nn.attention.varlen import AuxRequest\n from vllm.model_executor.layers.attention import Attention\n from vllm.model_executor.layers.attention.attention import get_attention_context\n-from vllm.v1.attention.backend import AttentionCGSupport, AttentionType\n+from vllm.v1.attention.backend import AttentionCGSupport, AttentionType, MultipleOf\n from vllm.v1.attention.backends.flash_attn import (\n     FlashAttentionBackend,\n     FlashAttentionImpl,\n@@ -43,8 +43,31 @@\n logger = logging.getLogger(__name__)\n \n \n+class _FA4PageSize:\n+    \"\"\"Ask vLLM for 128-token KV pages when FA4 runs attention.\n+\n+        page size     FA4 loads K/V with     decode 256 x 32k    prefill 2k on 32k\n+        16 (vLLM's)   a slower gather        1478 us             566 us\n+        128           one bulk copy (TMA)    1246 us             515 us\n+\n+    The bulk copy needs a page to hold exactly one 128-key tile. vLLM already picks\n+    128 for head dim 256. Cost: prefix-cache reuse in whole 128-token pages, and up to\n+    127 KV slots wasted per sequence. Numbers: GB300, Muse Spark (head dim 64), one\n+    attention call.\n+    \"\"\"\n+\n+    @classmethod\n+    def get_supported_kernel_block_sizes(\n+        cls, *args: Any, **kwargs: Any\n+    ) -> list[int | MultipleOf]:\n+        # *args: newer vLLM passes the layer's KV cache spec, older passes nothing.\n+        if get_cuda_flash_attention_impl() == \"FA4\":\n+            return [128]\n+        return super().get_supported_kernel_block_sizes(*args, **kwargs)\n+\n+\n @register_backend(AttentionBackendEnum.CUSTOM)\n-class TorchTitanVarlenInnerAttentionBackend(FlashAttentionBackend):\n+class TorchTitanVarlenInnerAttentionBackend(_FA4PageSize, FlashAttentionBackend):\n     \"\"\"Custom vLLM attention backend using PyTorch's native FlashAttention kernel.\n \n     This class is not directly referenced in user code. It is registered into\n@@ -76,7 +99,9 @@ class TorchTitanVarlenInnerAttentionMetadataBuilder(\n         return TorchTitanVarlenInnerAttentionMetadataBuilder\n \n \n-class TorchTitanVarlenInnerAttentionDiffKVBackend(FlashAttentionDiffKVBackend):\n+class TorchTitanVarlenInnerAttentionDiffKVBackend(\n+    _FA4PageSize, FlashAttentionDiffKVBackend\n+):\n     \"\"\"PyTorch varlen backend using vLLM's unequal K/V cache support.\"\"\"\n \n     @staticmethod",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/26cef5ac4d2b9dfd4c6c935bd39ec03a038e70d8/torchtitan%2Frl%2Fgenerator%2Fvllm%2Fattention.py",
      "sha": "e08705ee31c8542c4220e68eaceada316e12ebd6",
      "status": "modified"
    }
