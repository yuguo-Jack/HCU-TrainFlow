      "changes": 38,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_linear.py?ref=41c13be536375b40c6119358d26f8c02d1fa07ea",
      "deletions": 4,
      "filename": "tests/unit_tests/cpu/models/common/test_linear.py",
      "patch": "@@ -426,11 +426,41 @@ def test_raises_under_autocast(self):\n                 inplace(torch.randn(6, 8))\n             reference(torch.randn(6, 8))\n \n-    def test_raises_when_traced(self):\n+    def test_ignored_under_torch_compile(self):\n+        # fullgraph: Dynamo traces F.linear rather than breaking the graph.\n         inplace, reference = _linear_pair()\n-        with self.assertRaisesRegex(RuntimeError, \"inplace_wgrad_accum=False\"):\n-            torch.compile(inplace, backend=\"eager\", fullgraph=True)(torch.randn(6, 8))\n-        torch.compile(reference, backend=\"eager\", fullgraph=True)(torch.randn(6, 8))\n+        inputs = [torch.randn(6, 8) for _ in range(2)]\n+        for module in (inplace, reference):\n+            compiled = torch.compile(module, backend=\"aot_eager\", fullgraph=True)\n+            for x in inputs:\n+                compiled(x).sum().backward()\n+        self.assertTrue(torch.equal(inplace.weight.grad, reference.weight.grad))\n+\n+    def test_full_ac_under_torch_compile(self):\n+        # A compiled checkpointed block must trace every Linear the same way in\n+        # the forward and the recompute.\n+        from torchtitan.distributed.activation_checkpoint import FullAC\n+        from torchtitan.models.common.feed_forward import FeedForward\n+\n+        class Model(nn.Module):\n+            def __init__(self, layer: nn.Module) -> None:\n+                super().__init__()\n+                self.layers = nn.ModuleDict({\"0\": layer})\n+\n+            def forward(self, x: torch.Tensor) -> torch.Tensor:\n+                return self.layers[\"0\"](x)\n+\n+        model = Model(\n+            FeedForward.Config(\n+                w13=Linear.Config(in_features=8, out_features=16, num_linears=2),\n+                w2=Linear.Config(in_features=16, out_features=8),\n+            ).build()\n+        )\n+        FullAC.Config().build().apply(model)\n+        x = torch.randn(2, 3, 8, requires_grad=True)\n+        compiled = torch.compile(model, backend=\"aot_eager\")\n+        compiled(x).sum().backward()\n+        self.assertIsNotNone(x.grad)\n \n \n if __name__ == \"__main__\":",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/41c13be536375b40c6119358d26f8c02d1fa07ea/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_linear.py",
      "sha": "086d8ee43be4e691a9e06f25b6ed54f1ad7e027b",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/41c13be536375b40c6119358d26f8c02d1fa07ea/tests%2Funit_tests%2Fgpu%2Fmodels%2Fcommon%2Ftest_hi_mid_lo_linear.py",
      "changes": 19,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fgpu%2Fmodels%2Fcommon%2Ftest_hi_mid_lo_linear.py?ref=41c13be536375b40c6119358d26f8c02d1fa07ea",
      "deletions": 4,
      "filename": "tests/unit_tests/gpu/models/common/test_hi_mid_lo_linear.py",
      "patch": "@@ -440,10 +440,21 @@ def run(module):\n         assert _relative_error(actual, exact) <= _relative_error(expected, exact)\n \n \n-def test_inplace_wgrad_accum_raises_under_compile():\n-    x = torch.randn(4, 256, device=\"cuda\", dtype=torch.bfloat16)\n-    with pytest.raises(Exception, match=\"inplace_wgrad_accum=False\"):\n-        torch.compile(_lm_head(), fullgraph=True)(x)\n+def test_inplace_wgrad_accum_ignored_under_compile():\n+    # torch.compile traces the ordinary WGRAD instead of breaking the graph.\n+    inputs = [\n+        torch.randn(4, 256, device=\"cuda\", dtype=torch.bfloat16) for _ in range(2)\n+    ]\n+    lm_heads = []\n+    for inplace_wgrad_accum in (True, False):\n+        torch.manual_seed(0)\n+        lm_head = _lm_head()\n+        lm_head.inplace_wgrad_accum = inplace_wgrad_accum\n+        compiled = torch.compile(lm_head, fullgraph=True)\n+        for x in inputs:\n+            compiled(x).float().sum().backward()\n+        lm_heads.append(lm_head)\n+    assert torch.equal(lm_heads[0].weight.grad, lm_heads[1].weight.grad)\n \n \n def _run_fsdp_accumulates_chunk_weight_grads(rank, world_size, port):",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/41c13be536375b40c6119358d26f8c02d1fa07ea/tests%2Funit_tests%2Fgpu%2Fmodels%2Fcommon%2Ftest_hi_mid_lo_linear.py",
      "sha": "5e2c15cd033cd64da295c5d364347b17a577c305",
      "status": "modified"
    },
    {
      "additions": 19,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/41c13be536375b40c6119358d26f8c02d1fa07ea/torchtitan%2Fmodels%2Fcommon%2Finplace_wgrad_accum.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Finplace_wgrad_accum.py?ref=41c13be536375b40c6119358d26f8c02d1fa07ea",
      "deletions": 11,
      "filename": "torchtitan/models/common/inplace_wgrad_accum.py",
      "patch": "@@ -26,9 +26,9 @@\n     return ..., grad_weight, ...\n \n Clearing ``.grad`` and returning the same buffer lets AccumulateGrad reattach\n-it without a copy, instead of adding it to itself. Tracing (torch.compile,\n-GraphTrainer) cannot represent the read-and-clear of ``.grad``, so those paths\n-set ``inplace_wgrad_accum=False``.\n+it without a copy, instead of adding it to itself. Tracing cannot represent\n+the read-and-clear of ``.grad``: under torch.compile the option is ignored, and\n+GraphTrainer sets ``inplace_wgrad_accum=False``.\n \"\"\"\n \n import torch\n@@ -41,20 +41,28 @@ def uses_inplace_wgrad_accum(\n ) -> bool:\n     \"\"\"Whether this forward's backward adds its WGRAD into ``weight.grad`` in place.\n \n-    False when ``inplace_wgrad_accum`` is off or no WGRAD will be computed\n-    (grad mode off, or a frozen weight). Raises when it is on but cannot run,\n-    rather than silently falling back to an ordinary WGRAD: a traced forward\n-    (torch.compile, or GraphTrainer's make_fx, which does not set\n-    is_compiling, hence the proxy mode check), or a weight that is not the leaf\n-    parameter whose ``.grad`` autograd populates.\n+    False when ``inplace_wgrad_accum`` is off, no WGRAD will be computed (grad\n+    mode off, or a frozen weight), or Dynamo is tracing: the compiled graph\n+    then uses the ordinary WGRAD formula and AccumulateGrad adds it. Raising\n+    under Dynamo would not reach the user: Dynamo treats the exception as a\n+    graph break and reruns the frame eagerly, where this check passes, so the\n+    forward mixes compiled and eager code (and activation checkpointing's\n+    recompute can diverge from it).\n+\n+    Raises when it is on but cannot run, rather than silently falling back to\n+    an ordinary WGRAD: under GraphTrainer's make_fx, which does not set\n+    is_compiling, or for a weight that is not the leaf parameter whose\n+    ``.grad`` autograd populates.\n     \"\"\"\n     if not (inplace_wgrad_accum and torch.is_grad_enabled() and weight.requires_grad):\n         return False\n+    if torch.compiler.is_compiling():\n+        return False\n     module_name = type(module).__qualname__\n-    if torch.compiler.is_compiling() or get_proxy_mode() is not None:\n+    if get_proxy_mode() is not None:\n         raise RuntimeError(\n             f\"{module_name} has inplace_wgrad_accum=True but is being traced \"\n-            \"(torch.compile or GraphTrainer). A traced backward cannot add into \"\n+            \"by make_fx (GraphTrainer). A traced backward cannot add into \"\n             \"weight.grad in place; set inplace_wgrad_accum=False.\"\n         )\n     if not weight.is_leaf:",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/41c13be536375b40c6119358d26f8c02d1fa07ea/torchtitan%2Fmodels%2Fcommon%2Finplace_wgrad_accum.py",
      "sha": "12cf46d2c28058512c215ad65460bc6418d4cc0a",
      "status": "modified"
    },
    {
      "additions": 4,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/41c13be536375b40c6119358d26f8c02d1fa07ea/torchtitan%2Fmodels%2Fcommon%2Flinear.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Flinear.py?ref=41c13be536375b40c6119358d26f8c02d1fa07ea",
      "deletions": 3,
      "filename": "torchtitan/models/common/linear.py",
      "patch": "@@ -57,9 +57,10 @@ class Config(Module.Config):\n         \"\"\"Whether a later WGRAD (a microbatch with gradient sync disabled, or a\n         ``ChunkedLossWrapper`` chunk) is added into the existing ``weight.grad``\n         in the GEMM epilogue instead of a separate AccumulateGrad add and its\n-        full-size temporary. Tracing cannot represent this, so torch.compile and\n-        GraphTrainer must set it to False; forward raises if it is traced with\n-        this on. Subclasses whose compute cannot do it reject True.\"\"\"\n+        full-size temporary. Tracing cannot represent this: torch.compile\n+        ignores it, and GraphTrainer must set it to False (forward raises under\n+        make_fx with this on). Subclasses whose compute cannot do it reject\n+        True.\"\"\"\n \n     def __init__(self, config: Config):\n         super().__init__(",
