    {
      "additions": 28,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/dce08601dba75e20b61bdba224ce8195ace73a85/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_token_dispatcher.py",
      "changes": 28,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_token_dispatcher.py?ref=dce08601dba75e20b61bdba224ce8195ace73a85",
      "deletions": 0,
      "filename": "tests/unit_tests/cpu/models/common/test_token_dispatcher.py",
      "patch": "@@ -0,0 +1,28 @@\n+# Copyright (c) Meta Platforms, Inc. and affiliates.\n+# All rights reserved.\n+#\n+# This source code is licensed under the BSD-style license found in the\n+# LICENSE file in the root directory of this source tree.\n+\n+import unittest\n+\n+import torch\n+\n+import torchtitan.models.common.moe.token_dispatcher as token_dispatcher\n+\n+\n+class TestArgsortExpertIds(unittest.TestCase):\n+    def test_narrow_key_argsort_matches_int64_argsort(self):\n+        torch.manual_seed(0)\n+        for num_experts in (5, 300, 40000):  # uint8, int16 and int64 keys\n+            ids_N = torch.randint(0, num_experts, (4096,))\n+            self.assertTrue(\n+                torch.equal(\n+                    token_dispatcher._argsort_expert_ids(ids_N, num_experts),\n+                    torch.argsort(ids_N, stable=True),\n+                )\n+            )\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/dce08601dba75e20b61bdba224ce8195ace73a85/tests%2Funit_tests%2Fcpu%2Fmodels%2Fcommon%2Ftest_token_dispatcher.py",
      "sha": "b66a3945b21d95b2a790e38357017a616d683226",
      "status": "added"
    },
    {
      "additions": 18,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/dce08601dba75e20b61bdba224ce8195ace73a85/torchtitan%2Fmodels%2Fcommon%2Fmoe%2Ftoken_dispatcher.py",
      "changes": 20,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Fmoe%2Ftoken_dispatcher.py?ref=dce08601dba75e20b61bdba224ce8195ace73a85",
      "deletions": 2,
      "filename": "torchtitan/models/common/moe/token_dispatcher.py",
      "patch": "@@ -119,8 +119,8 @@ def _local_reorder(\n             topk_scores_experts_sorted_N: ``(N,)`` scores in expert-sorted order\n         \"\"\"\n         # Reorder the token indices to match the order of the experts where N = T*K\n-        token_indices_experts_sorted_N = torch.argsort(\n-            topk_expert_ids_TK.view(-1), stable=True\n+        token_indices_experts_sorted_N = _argsort_expert_ids(\n+            topk_expert_ids_TK.view(-1), self.num_experts\n         )\n         topk_scores_experts_sorted_N = topk_scores_TK.view(-1)[\n             token_indices_experts_sorted_N\n@@ -218,6 +218,22 @@ def _score_and_scatter_add(\n         )\n \n \n+def _argsort_expert_ids(expert_ids_N: torch.Tensor, num_experts: int) -> torch.Tensor:\n+    \"\"\"``torch.argsort(expert_ids_N, stable=True)``, sorted on the narrowest integer type\n+    that holds the expert ids.\n+\n+    The CUDA radix sort makes one pass per key byte, so int64 ids take 8 passes and\n+    uint8 ids 1. Same order. GB300, 32,768 routes: 69 us as int64, 24 as uint8.\n+    \"\"\"\n+    # num_experts is a Python int fixed by the model config, so compile resolves this\n+    # branch once: no graph break, and the same dtype in training and inference.\n+    if num_experts <= 256:\n+        expert_ids_N = expert_ids_N.to(torch.uint8)\n+    elif num_experts <= 2**15:\n+        expert_ids_N = expert_ids_N.to(torch.int16)\n+    return torch.argsort(expert_ids_N, stable=True)\n+\n+\n class BaseEPTokenDispatcher(LocalTokenDispatcher, ABC):\n     \"\"\"Base class for EP token dispatchers.\n ",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/dce08601dba75e20b61bdba224ce8195ace73a85/torchtitan%2Fmodels%2Fcommon%2Fmoe%2Ftoken_dispatcher.py",
      "sha": "3d1b5530abf84b1902d0f3ab5cacdf360f283ae1",
      "status": "modified"
    }
