      "deletions": 1,
      "filename": "tests/unit_tests/cpu/observability/test_wandb_logger.py",
      "patch": "@@ -5,7 +5,7 @@\n # LICENSE file in the root directory of this source tree.\n \n import sys\n-from unittest.mock import MagicMock\n+from unittest.mock import call, MagicMock\n \n import pytest\n \n@@ -33,3 +33,20 @@ def test_wandb_run_tags_are_split(tmp_path, monkeypatch, env_value, expected):\n     WandBLogger(log_dir=str(tmp_path))\n \n     assert fake_wandb.init.call_args.kwargs[\"tags\"] == expected\n+\n+\n+def test_wandb_commit_keeps_validation_in_the_training_row(tmp_path, monkeypatch):\n+    fake_wandb = MagicMock()\n+    monkeypatch.setitem(sys.modules, \"wandb\", fake_wandb)\n+    wandb_logger = WandBLogger(log_dir=str(tmp_path))\n+\n+    wandb_logger.log({\"loss\": 1.0}, step=10)\n+    wandb_logger.log({\"validation/loss\": 2.0}, step=10)\n+    wandb_logger.commit()\n+    wandb_logger.commit()\n+\n+    assert fake_wandb.log.call_args_list == [\n+        call({\"loss\": 1.0}, step=10),\n+        call({\"validation/loss\": 2.0}, step=10),\n+        call({}, step=10, commit=True),\n+    ]",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/c662560eef1c427bd49f42cb28ef0897379aef55/tests%2Funit_tests%2Fcpu%2Fobservability%2Ftest_wandb_logger.py",
      "sha": "40921865b0e0430a34000521ab6b7cc83a9a9c9c",
      "status": "modified"
    },
