    {
      "additions": 30,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6/tests%2Funit_tests%2Fcpu%2Ftest_varlen_attention.py",
      "changes": 30,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Ftest_varlen_attention.py?ref=1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6",
      "deletions": 0,
      "filename": "tests/unit_tests/cpu/test_varlen_attention.py",
      "patch": "@@ -13,6 +13,7 @@\n \n import spmd_types as spmd\n import torch\n+from torch.nn.attention import sdpa_kernel, SDPBackend\n \n from torchtitan.distributed.parallelism_context import MeshAxisName\n from torchtitan.distributed.spmd_types import _per_axis_types\n@@ -220,6 +221,35 @@ def _identity_varlen(q_THK, k_THK, v_THV, *args, **kwargs):\n \n         self.assertEqual(logits_TV.shape, (num_tokens, 2048))\n \n+    def test_varlen_attn_runs_flash_not_cudnn(self):\n+        \"\"\"torch's varlen_attn tries cuDNN first; only Flash runs the FA3/FA4 that __init__ activates.\"\"\"\n+        q_THK = torch.randn(5, 2, 4)\n+        positions_T = torch.tensor([0, 1, 0, 1, 2])\n+        metadata = create_varlen_metadata_for_document(positions_T)\n+        inner_attention = VarlenInnerAttention.Config().build()\n+        enabled_backends = []\n+\n+        def _record_enabled_backends(q, k, v, *args, **kwargs):\n+            enabled_backends.append(\n+                {\n+                    \"flash\": torch.backends.cuda.flash_sdp_enabled(),\n+                    \"cudnn\": torch.backends.cuda.cudnn_sdp_enabled(),\n+                }\n+            )\n+            return q\n+\n+        with (\n+            # Importing vLLM (another test may have) disables cuDNN process-wide.\n+            sdpa_kernel([SDPBackend.CUDNN_ATTENTION, SDPBackend.FLASH_ATTENTION]),\n+            patch(\n+                \"torchtitan.models.common.attention.attention._varlen_attn\",\n+                side_effect=_record_enabled_backends,\n+            ),\n+        ):\n+            inner_attention(q_THK, q_THK, q_THK, attention_metadata=metadata)\n+\n+        self.assertEqual(enabled_backends, [{\"flash\": True, \"cudnn\": False}])\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6/tests%2Funit_tests%2Fcpu%2Ftest_varlen_attention.py",
      "sha": "5502a9b8253a4dbb0457a056a5b9dcf4809df3d4",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py",
      "changes": 27,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py?ref=1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6",
      "deletions": 12,
      "filename": "torchtitan/models/common/attention/attention.py",
      "patch": "@@ -254,18 +254,21 @@ def forward(\n \n         varlen_attn_fn = varlen_attn if out_transform is None else varlen_attn_with_lse\n \n-        result = varlen_attn_fn(\n-            q_THK.to(torch.bfloat16),\n-            k_THK.to(torch.bfloat16),\n-            v_THV.to(torch.bfloat16),\n-            cu_seq_q,\n-            cu_seq_k,\n-            max_q,\n-            max_k,\n-            scale=scale,\n-            window_size=self.window_size,\n-            **varlen_kwargs,\n-        )\n+        # On SM90/SM100/SM103, torch's varlen_attn runs cuDNN whenever cuDNN supports\n+        # the batch; pin Flash so the FA3/FA4 activated in __init__ runs.\n+        with sdpa_kernel(SDPBackend.FLASH_ATTENTION):\n+            result = varlen_attn_fn(\n+                q_THK.to(torch.bfloat16),\n+                k_THK.to(torch.bfloat16),\n+                v_THV.to(torch.bfloat16),\n+                cu_seq_q,\n+                cu_seq_k,\n+                max_q,\n+                max_k,\n+                scale=scale,\n+                window_size=self.window_size,\n+                **varlen_kwargs,\n+            )\n \n         # varlen_attn returns the packed output (T, H, V), plus the LSE when an\n         # out_transform epilogue was requested.",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py",
      "sha": "a9de3e932d2d8c1eac5450c26b564d1a0251f6fa",
      "status": "modified"
    },
    {
      "additions": 20,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6/torchtitan%2Frl%2Fmodel%2Fattention.py",
      "changes": 35,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fmodel%2Fattention.py?ref=1c0cf7353a1d8a86fbc22cbb10f354b16a0dd7d6",
      "deletions": 15,
      "filename": "torchtitan/rl/model/attention.py",
      "patch": "@@ -15,6 +15,8 @@\n from torch.nn.attention import (\n     activate_flash_attention_impl,\n     current_flash_attention_impl,\n+    sdpa_kernel,\n+    SDPBackend,\n )\n from torch.nn.attention.varlen import AuxRequest\n from torchtitan.distributed.batch_invariant import is_in_batch_invariant_mode\n@@ -253,21 +255,24 @@ def forward(\n         if self.out_transform is not None:\n             extra_kwargs[\"return_aux\"] = AuxRequest(lse=True)\n \n-        result = torch.nn.attention.varlen.varlen_attn_out(\n-            output[:num_actual_tokens],\n-            query[:num_actual_tokens],\n-            key_cache,\n-            value_cache,\n-            cu_seqlens_q,\n-            cu_seqlens_k,\n-            max_seqlen_q,\n-            max_seqlen_k,\n-            scale=self.scale,\n-            window_size=sliding_window_size,\n-            block_table=block_table,\n-            seqused_k=seqused_k,\n-            **extra_kwargs,\n-        )\n+        # Same pin as VarlenInnerAttention.forward. vLLM's import disables cuDNN SDP\n+        # today; don't rely on that side effect.\n+        with sdpa_kernel(SDPBackend.FLASH_ATTENTION):\n+            result = torch.nn.attention.varlen.varlen_attn_out(\n+                output[:num_actual_tokens],\n+                query[:num_actual_tokens],\n+                key_cache,\n+                value_cache,\n+                cu_seqlens_q,\n+                cu_seqlens_k,\n+                max_seqlen_q,\n+                max_seqlen_k,\n+                scale=self.scale,\n+                window_size=sliding_window_size,\n+                block_table=block_table,\n+                seqused_k=seqused_k,\n+                **extra_kwargs,\n+            )\n         if self.out_transform is None:\n             return result\n ",
