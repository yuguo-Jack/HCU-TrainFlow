      "changes": 12,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_verifiers_terminal_bench.py?ref=d4540e6db22adaa278db14216374b35e0293aebf",
      "deletions": 3,
      "filename": "tests/rl/unit_tests/cpu/test_verifiers_terminal_bench.py",
      "patch": "@@ -153,8 +153,8 @@ def test_agent_runs_inside_docker_and_verifier_uses_same_taskset() -> None:\n \n def test_env_server_workers_skip_the_trainer_imports(monkeypatch) -> None:\n     \"\"\"A pool worker loads the broker's ``__main__``, runs the pickled ``log_setup``, then\n-    resolves the env config, whose taskset id is the local alias. It must find the taskset\n-    and the harness without importing torch, vLLM or Monarch.\n+    resolves the env config, whose taskset id is the local alias, and imports the tokenizer.\n+    It must find the taskset and the harness without importing torch, vLLM or Monarch.\n     \"\"\"\n     captured = {}\n \n@@ -168,6 +168,10 @@ def serve_env(**kwargs) -> None:\n     monkeypatch.setitem(sys.modules, \"__main__\", sys.modules[\"__main__\"])\n     monkeypatch.setenv(\"no_proxy\", \"\")\n     monkeypatch.setenv(\"NO_PROXY\", \"\")\n+    # It also sets three glibc variables for the workers; preset them so monkeypatch restores them.\n+    monkeypatch.setenv(\"MALLOC_ARENA_MAX\", \"2\")\n+    monkeypatch.setenv(\"MALLOC_MMAP_THRESHOLD_\", \"65536\")\n+    monkeypatch.setenv(\"MALLOC_TRIM_THRESHOLD_\", \"0\")\n     config = _rollouter_config(TRAIN_DATASET, EVAL_DATASET).verifiers_env_server\n     env_server._run_env_server_process(\n         environment=env_config_data(config.environment),\n@@ -182,11 +186,13 @@ def serve_env(**kwargs) -> None:\n     assert not hasattr(captured[\"main\"], \"__file__\")\n     worker = f\"\"\"\n import pickle, sys\n+import verifiers.v1.serve.pool  # the worker's spawn target, imported before log_setup runs\n from verifiers.v1.utils.loaders import load_harness, resolve_env_config\n pickle.loads({captured[\"log_setup\"]!r})()\n env_config = resolve_env_config(pickle.loads({captured[\"config_data\"]!r}))\n print(type(load_harness(env_config.agent.harness)).__name__)\n-print([name for name in (\"torch\", \"vllm\", \"monarch\") if name in sys.modules])\n+from transformers import AutoTokenizer\n+print([name for name in (\"torch\", \"vllm\", \"monarch\") if sys.modules.get(name) is not None])\n \"\"\"\n     result = subprocess.run(\n         [sys.executable, \"-c\", worker], capture_output=True, text=True, check=False",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/d4540e6db22adaa278db14216374b35e0293aebf/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_verifiers_terminal_bench.py",
      "sha": "9e3744842fb38d65823b66020c230bc887e6bca3",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/d4540e6db22adaa278db14216374b35e0293aebf/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fenv_server.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fenv_server.py?ref=d4540e6db22adaa278db14216374b35e0293aebf",
      "deletions": 0,
      "filename": "torchtitan/rl/examples/verifiers/env_server.py",
      "patch": "@@ -45,6 +45,13 @@ def _run_env_server_process(\n     no_proxy = \",\".join(filter(None, (no_proxy, \"127.0.0.1\", \"localhost\")))\n     os.environ[\"no_proxy\"] = no_proxy\n     os.environ[\"NO_PROXY\"] = no_proxy\n+    # Pool workers read these when they start.\n+    # 2 malloc pools, since a worker mostly runs one event loop; assigned to override the controller host's cap.\n+    os.environ[\"MALLOC_ARENA_MAX\"] = \"2\"\n+    # Blocks of 64 KB or more get their own mmap, so a finished episode's memory goes back to the OS.\n+    os.environ.setdefault(\"MALLOC_MMAP_THRESHOLD_\", \"65536\")\n+    # Give free memory at the top of each heap back to the OS at once (glibc's default keeps up to 128 KB).\n+    os.environ.setdefault(\"MALLOC_TRIM_THRESHOLD_\", \"0\")\n \n     # Registered here too: resolve_env_config imports the taskset before serve_env runs log_setup.\n     if local_taskset_module is not None:",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/d4540e6db22adaa278db14216374b35e0293aebf/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fenv_server.py",
      "sha": "774062247d22d5d2e747429579f962d46e6960c0",
      "status": "modified"
    },
    {
      "additions": 12,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/d4540e6db22adaa278db14216374b35e0293aebf/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fworker_setup.py",
      "changes": 17,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fworker_setup.py?ref=d4540e6db22adaa278db14216374b35e0293aebf",
      "deletions": 5,
      "filename": "torchtitan/rl/examples/verifiers/worker_setup.py",
      "patch": "@@ -17,12 +17,19 @@\n \n \n def setup_env_server_worker(level: str, local_taskset_module: str | None) -> None:\n-    \"\"\"Route Verifiers logs to stderr at `level`, and make the local taskset importable.\n-\n-    Verifiers runs it in the env server and in each pool worker it spawns:\n-        pool worker without it:  import_taskset(alias) -> ModuleNotFoundError, worker exits\n-        pool worker with it:     import_taskset(alias) -> the local taskset module\n+    \"\"\"Block torch, route Verifiers logs to stderr at `level`, and register the local taskset.\n+\n+    Verifiers runs it first in the env server and in each pool worker it spawns:\n+        env server   torch already imported through torchtitan -> left as is\n+        pool worker  `import torch` raises ImportError, so the renderer's tokenizer loads\n+                     without torch (Qwen3.5 renderer: 776 -> 341 MB anonymous memory)\n+        pool worker  import_taskset(alias) -> the local taskset module\n+                     (without this hook: ModuleNotFoundError, and the worker exits)\n+    A taskset that imports torch fails in pool workers: give it num_workers=1, so the env\n+    server serves its rollouts itself.\n     \"\"\"\n+    if \"torch\" not in sys.modules:\n+        sys.modules[\"torch\"] = None\n     setup_logging(level)\n     if local_taskset_module is not None:\n         register_local_taskset_alias(local_taskset_module)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/d4540e6db22adaa278db14216374b35e0293aebf/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fworker_setup.py",
      "sha": "95fc46856b03c81d4de4f146b426688884d58ba5",
      "status": "modified"
    }
