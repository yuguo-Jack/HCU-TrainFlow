      "changes": 20,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fcomponents%2Fdata%2Ftest_multimodal_audio_utils.py?ref=1354637a265dcb11c6b4aa525006344c15c4dedd",
      "deletions": 0,
      "filename": "tests/unit_tests/cpu/components/data/test_multimodal_audio_utils.py",
      "patch": "@@ -87,3 +87,23 @@ def test_resample_waveform_interpolates_channels_last_input():\n             dtype=torch.float32,\n         ),\n     )\n+\n+\n+def test_resample_waveform_keeps_source_positions_on_long_clips():\n+    # Each sample's value is its own index, so every output sample should\n+    # equal the exact source position it was interpolated from.\n+    source_sample_rate, target_sample_rate = 44_100, 16_000\n+    waveform = torch.arange(30 * source_sample_rate, dtype=torch.float64)[:, None]\n+\n+    result = resample_waveform(\n+        waveform,\n+        source_sample_rate=source_sample_rate,\n+        target_sample_rate=target_sample_rate,\n+    )\n+\n+    expected = (\n+        torch.arange(result.shape[0], dtype=torch.float64)\n+        * source_sample_rate\n+        / target_sample_rate\n+    )\n+    torch.testing.assert_close(result[:, 0], expected, rtol=0, atol=1e-4)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/1354637a265dcb11c6b4aa525006344c15c4dedd/tests%2Funit_tests%2Fcpu%2Fcomponents%2Fdata%2Ftest_multimodal_audio_utils.py",
      "sha": "3f8f4215ab4da8e74cab52733475d8f85736c8c1",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/1354637a265dcb11c6b4aa525006344c15c4dedd/torchtitan%2Fcomponents%2Fdata%2Fmultimodal%2Futils%2Faudio.py",
      "changes": 14,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fcomponents%2Fdata%2Fmultimodal%2Futils%2Faudio.py?ref=1354637a265dcb11c6b4aa525006344c15c4dedd",
      "deletions": 7,
      "filename": "torchtitan/components/data/multimodal/utils/audio.py",
      "patch": "@@ -81,15 +81,15 @@ def resample_waveform(\n         1,\n         num_input_samples * target_sample_rate // source_sample_rate,\n     )\n-    output_indices = torch.arange(\n-        num_output_samples,\n-        dtype=torch.float32,\n-        device=waveform.device,\n+    # Integer math: float32 positions lose sub-sample precision on long clips.\n+    scaled_indices = (\n+        torch.arange(num_output_samples, device=waveform.device) * source_sample_rate\n     )\n-    source_positions = output_indices * source_sample_rate / target_sample_rate\n-    lower_indices = source_positions.floor().to(torch.int64)\n+    lower_indices = scaled_indices // target_sample_rate\n     upper_indices = (lower_indices + 1).clamp(max=num_input_samples - 1)\n-    upper_weights = (source_positions - lower_indices).unsqueeze(1)\n+    upper_weights = (\n+        (scaled_indices % target_sample_rate).to(torch.float32) / target_sample_rate\n+    ).unsqueeze(1)\n \n     lower_values = waveform[lower_indices]\n     upper_values = waveform[upper_indices]",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/1354637a265dcb11c6b4aa525006344c15c4dedd/torchtitan%2Fcomponents%2Fdata%2Fmultimodal%2Futils%2Faudio.py",
      "sha": "44110e88e8140504dc9bb3d95f71f16b42aa6723",
