      "blob_url": "https://github.com/pytorch/torchtitan/blob/1e565b52735c403e37cdc2eb5342c86dddecc75d/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Fattention%2Fattention.py?ref=1e565b52735c403e37cdc2eb5342c86dddecc75d",
      "deletions": 0,
      "filename": "torchtitan/models/common/attention/attention.py",
      "patch": "@@ -508,10 +508,14 @@ def build_attention_metadata(\n         \"triton.cudagraphs\": False,\n     }\n \n+    # fullgraph=True: a graph break or a 17th graph raises, instead of silently running flex eagerly.\n+    # recompile_limit=16: one compile serves every layer; Muse Spark needs 10 graphs (default 8).\n     # pyrefly: ignore[no-matching-overload]\n     _compiled_flex_attn: ClassVar[Callable] = torch.compile(\n         flex_attention,\n+        fullgraph=True,\n         options=inductor_configs,\n+        recompile_limit=16,\n     )\n \n     def __init__(self, config: Config) -> None:",
