      "additions": 40,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/9e0a20554af5d6b03857f2386938b215f9706a11/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_verifiers.py",
      "changes": 40,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_verifiers.py?ref=9e0a20554af5d6b03857f2386938b215f9706a11",
      "deletions": 0,
      "filename": "tests/rl/unit_tests/cpu/test_verifiers.py",
      "patch": "@@ -30,6 +30,7 @@\n     VerifiersRollouter,\n )\n from torchtitan.rl.types import Completion\n+from verifiers.v1.errors import model_error, OverlongPromptError\n \n \n def test_trainable_token_spans() -> None:\n@@ -409,6 +410,45 @@ async def generate_fn(*args, **kwargs):\n     asyncio.run(run_test())\n \n \n+def test_generation_server_rejects_prompt_without_room_for_output() -> None:\n+    async def run_test() -> None:\n+        prompt_lengths = []\n+\n+        async def generate_fn(prompt_token_ids, **kwargs):\n+            prompt_lengths.append(len(prompt_token_ids))\n+            raise RuntimeError(\"generator reached\")\n+\n+        server = GenerationServer.Config(max_rollout_tokens=8).build()\n+        server.set_generate_fn(generate_fn)\n+        await server.start()\n+        try:\n+            async with ClientSession() as session:\n+                statuses, errors = [], []\n+                for num_tokens in (7, 8, 9):\n+                    response = await session.post(\n+                        f\"http://{server.host}:{server.port}/inference/v1/generate\",\n+                        headers={\"X-Session-ID\": \"group=1/rollout=2\"},\n+                        json={\n+                            \"token_ids\": [1] * num_tokens,\n+                            \"sampling_params\": {\n+                                \"torchtitan_group_id\": 1,\n+                                \"stop_token_ids\": [99],\n+                            },\n+                        },\n+                    )\n+                    statuses.append(response.status)\n+                    errors.append((await response.json())[\"error\"])\n+        finally:\n+            await server.close()\n+\n+        assert prompt_lengths == [7]\n+        assert statuses == [500, 400, 400]\n+        # Verifiers ends the rollout as context_length on OverlongPromptError.\n+        assert isinstance(model_error(errors[1]), OverlongPromptError)\n+\n+    asyncio.run(run_test())\n+\n+\n def test_parse_sampling_config_requires_stop_token_ids() -> None:\n     with pytest.raises(ValueError, match=\"stop_token_ids\"):\n         _parse_sampling_config({\"temperature\": 1.0})",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/9e0a20554af5d6b03857f2386938b215f9706a11/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_verifiers.py",
      "sha": "1eb04fdab4743cbb658cb22d6dd9c03197a175ab",
      "status": "modified"
    },
    {
      "additions": 10,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/9e0a20554af5d6b03857f2386938b215f9706a11/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fgeneration_server.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fgeneration_server.py?ref=9e0a20554af5d6b03857f2386938b215f9706a11",
      "deletions": 1,
      "filename": "torchtitan/rl/examples/verifiers/generation_server.py",
      "patch": "@@ -68,7 +68,8 @@ class Config(Configurable.Config):\n         \"\"\"Listening port; zero requests an ephemeral port.\"\"\"\n \n         max_rollout_tokens: int\n-        \"\"\"Inclusive upper bound for the rendered prompt length.\n+        \"\"\"Context length; set it to the generator's ``max_model_len``.\n+        Prompts of this many tokens or more get a 400.\n \n         The server advertises this value as ``max_model_len`` through\n         ``GET /v1/models`` so Verifiers can reject longer prompts before\n@@ -178,6 +179,14 @@ async def _handle_generate_request(self, request: web.Request) -> web.Response:\n             prompt_token_ids = _validate_token_ids(\n                 body.get(\"token_ids\"), field_name=\"token_ids\"\n             )\n+            # vLLM needs room for one output token. Verifiers reads this wording as an\n+            # overlong prompt and ends the rollout as context_length.\n+            if len(prompt_token_ids) >= self.max_rollout_tokens:\n+                raise ValueError(\n+                    f\"This model's maximum context length is {self.max_rollout_tokens} \"\n+                    f\"tokens, and the prompt has {len(prompt_token_ids)} tokens, \"\n+                    \"leaving no room for an output token\"\n+                )\n             sampling_params = body.get(\"sampling_params\")\n             if not isinstance(sampling_params, dict):\n                 raise ValueError(\"sampling_params must be an object\")",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/9e0a20554af5d6b03857f2386938b215f9706a11/torchtitan%2Frl%2Fexamples%2Fverifiers%2Fgeneration_server.py",
      "sha": "3799b02582b2a4f961a679a9e78900660038030e",
      "status": "modified"
    }
