      "additions": 36,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/e0e794bdae98b89729c9431990138cd336ee8761/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_runtime_env.py",
      "changes": 36,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_runtime_env.py?ref=e0e794bdae98b89729c9431990138cd336ee8761",
      "deletions": 0,
      "filename": "tests/rl/unit_tests/cpu/test_runtime_env.py",
      "patch": "@@ -9,6 +9,8 @@\n import os\n from unittest.mock import patch\n \n+import pytest\n+\n from torchtitan.rl._env import apply_env_defaults, RL_ENV_DEFAULTS\n \n \n@@ -29,3 +31,37 @@ def test_apply_env_defaults_preserves_existing_values() -> None:\n \n         assert os.environ[\"NCCL_DEBUG\"] == \"INFO\"\n         assert os.environ[\"UNRELATED\"] == \"value\"\n+\n+\n+@pytest.mark.parametrize(\"key\", [\"PYTORCH_ALLOC_CONF\", \"PYTORCH_CUDA_ALLOC_CONF\"])\n+@pytest.mark.parametrize(\"value\", [\"\", \"expandable_segments:False\"])\n+def test_apply_env_defaults_preserves_allocator_alias(key: str, value: str) -> None:\n+    with patch.dict(os.environ, {key: value}, clear=True):\n+        apply_env_defaults()\n+        apply_env_defaults()\n+\n+        assert os.environ[\"PYTORCH_ALLOC_CONF\"] == value\n+        assert os.environ[\"PYTORCH_CUDA_ALLOC_CONF\"] == value\n+\n+\n+def test_apply_env_defaults_preserves_distinct_allocator_aliases() -> None:\n+    explicit = {\n+        \"PYTORCH_ALLOC_CONF\": \"expandable_segments:False\",\n+        \"PYTORCH_CUDA_ALLOC_CONF\": \"max_split_size_mb:128\",\n+    }\n+    with patch.dict(os.environ, explicit, clear=True):\n+        apply_env_defaults()\n+\n+        for key, value in explicit.items():\n+            assert os.environ[key] == value\n+\n+\n+def test_apply_env_defaults_warns_before_copying_allocator_alias() -> None:\n+    with (\n+        patch.dict(\n+            os.environ, {\"PYTORCH_ALLOC_CONF\": \"expandable_segments:False\"}, clear=True\n+        ),\n+        patch.dict(\"sys.modules\", {\"torch\": object()}),\n+        pytest.warns(UserWarning, match=\"torch.*already been imported\"),\n+    ):\n+        apply_env_defaults()",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/e0e794bdae98b89729c9431990138cd336ee8761/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_runtime_env.py",
      "sha": "217e2fe0835b71516b66a3b7d2eeb9575cd3c0e6",
      "status": "modified"
    },
    {
      "additions": 7,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/e0e794bdae98b89729c9431990138cd336ee8761/torchtitan%2Frl%2F_env.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2F_env.py?ref=e0e794bdae98b89729c9431990138cd336ee8761",
      "deletions": 0,
      "filename": "torchtitan/rl/_env.py",
      "patch": "@@ -33,5 +33,12 @@ def apply_env_defaults() -> None:\n             \"importing torch.\",\n             stacklevel=2,\n         )\n+    # An explicit setting under either name must take precedence over defaults.\n+    allocator_conf = os.environ.get(\n+        \"PYTORCH_CUDA_ALLOC_CONF\", os.environ.get(\"PYTORCH_ALLOC_CONF\")\n+    )\n+    if allocator_conf is not None:\n+        os.environ.setdefault(\"PYTORCH_ALLOC_CONF\", allocator_conf)\n+        os.environ.setdefault(\"PYTORCH_CUDA_ALLOC_CONF\", allocator_conf)\n     for key, value in RL_ENV_DEFAULTS.items():\n         os.environ.setdefault(key, value)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/e0e794bdae98b89729c9431990138cd336ee8761/torchtitan%2Frl%2F_env.py",
      "sha": "e7149cf65aea4ad80b62e010ea2e3f2fa9e951f8",
      "status": "modified"
    }
