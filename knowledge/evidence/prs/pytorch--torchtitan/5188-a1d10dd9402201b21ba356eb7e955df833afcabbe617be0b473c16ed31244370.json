      "changes": 7,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_dapo_math.py?ref=44c85de67b288f43ceb594877a4f2cb279ca2d5b",
      "deletions": 0,
      "filename": "tests/rl/unit_tests/cpu/test_dapo_math.py",
      "patch": "@@ -124,6 +124,13 @@ def test_math_verifier_requires_a_boxed_answer() -> None:\n     assert score_math_response(\"work mentions 34\", \"34\") == 0.0\n \n \n+def test_math_verifier_parses_non_integer_gold_answers() -> None:\n+    assert score_math_response(r\"\\boxed{2\\sqrt{3}}\", r\"2\\sqrt{3}\") == 1.0\n+    assert score_math_response(r\"\\boxed{2}\", r\"2\\sqrt{3}\") == 0.0\n+    assert score_math_response(r\"\\boxed{(1,2)}\", \"(1,2)\") == 1.0\n+    assert score_math_response(r\"\\boxed{\\frac{\\pi}{4}}\", r\"\\pi/4\") == 1.0\n+\n+\n def test_math_verifier_uses_the_last_boxed_answer() -> None:\n     response = r\"Work: \\boxed{2003^{2002^{2001}}}\" \"\\n\" r\"Answer: \\boxed{34}\"\n     assert score_math_response(response, \"34\") == 1.0",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/44c85de67b288f43ceb594877a4f2cb279ca2d5b/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_dapo_math.py",
      "sha": "71b76629729143c832266dce4d3b328d2d588044",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/44c85de67b288f43ceb594877a4f2cb279ca2d5b/torchtitan%2Frl%2Fexamples%2Fdapo_math%2Fmath_verify_pool.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fexamples%2Fdapo_math%2Fmath_verify_pool.py?ref=44c85de67b288f43ceb594877a4f2cb279ca2d5b",
      "deletions": 1,
      "filename": "torchtitan/rl/examples/dapo_math/math_verify_pool.py",
      "patch": "@@ -112,7 +112,9 @@ def score_math_response(response: str, ground_truth: str) -> float:\n         return 0.0\n \n     try:\n-        gold = parse(ground_truth, parsing_timeout=None)\n+        # Box the gold like the prediction: a bare `2\\sqrt{3}` parses as 2, and a\n+        # bare `(1,2)` or `\\pi/4` parses to nothing.\n+        gold = parse(_BOXED_START + ground_truth + \"}\", parsing_timeout=None)\n         prediction = parse(prediction, parsing_timeout=None)\n         return float(bool(gold) and verify(gold, prediction, timeout_seconds=None))\n     except Exception:",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/44c85de67b288f43ceb594877a4f2cb279ca2d5b/torchtitan%2Frl%2Fexamples%2Fdapo_math%2Fmath_verify_pool.py",
      "sha": "5b0f54e932f34c2b5230bcdc594f5d277b0480eb",
      "status": "modified"
    }
