      "blob_url": "https://github.com/pytorch/torchtitan/blob/d8a5b6d0ca123da735984e64b6060d4f888c50ae/tests%2Funit_tests%2Fcpu%2Ftest_flux_default_asset_paths.py",
      "changes": 29,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Ftest_flux_default_asset_paths.py?ref=d8a5b6d0ca123da735984e64b6060d4f888c50ae",
      "deletions": 0,
      "filename": "tests/unit_tests/cpu/test_flux_default_asset_paths.py",
      "patch": "@@ -0,0 +1,29 @@\n+# Copyright (c) Meta Platforms, Inc. and affiliates.\n+# All rights reserved.\n+#\n+# This source code is licensed under the BSD-style license found in the\n+# LICENSE file in the root directory of this source tree.\n+\n+from pathlib import Path\n+\n+from torchtitan.models.flux.configs import FluxEncoderConfig, Inference\n+\n+\n+def test_flux_dataclass_defaults_use_shipped_asset_paths():\n+    encoder = FluxEncoderConfig()\n+    inference = Inference()\n+\n+    assert \"experiments/flux\" not in encoder.autoencoder_path\n+    assert \"experiments/flux\" not in inference.prompts_path\n+    assert encoder.autoencoder_path == \"assets/hf/FLUX.1-dev/ae.safetensors\"\n+\n+    repo_root = Path(__file__).parents[3]\n+    prompts_file = (repo_root / inference.prompts_path).resolve()\n+    shipped_prompts = (\n+        repo_root / \"torchtitan/models/flux/inference/prompts.txt\"\n+    ).resolve()\n+    assert prompts_file.is_file()\n+    assert prompts_file == shipped_prompts\n+\n+    launcher = (repo_root / \"torchtitan/models/flux/run_infer.sh\").read_text()\n+    assert \"models/flux/run_train.sh\" not in launcher",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/d8a5b6d0ca123da735984e64b6060d4f888c50ae/tests%2Funit_tests%2Fcpu%2Ftest_flux_default_asset_paths.py",
      "sha": "e19f4da1b385aed3a952afdf8188b0f6b1df64f8",
      "status": "added"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/d8a5b6d0ca123da735984e64b6060d4f888c50ae/torchtitan%2Fmodels%2Fflux%2Fconfigs.py",
      "changes": 6,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fflux%2Fconfigs.py?ref=d8a5b6d0ca123da735984e64b6060d4f888c50ae",
      "deletions": 4,
      "filename": "torchtitan/models/flux/configs.py",
      "patch": "@@ -15,9 +15,7 @@ class FluxEncoderConfig:\n     \"\"\"Override for the T5 text encoder version/path. Empty uses the flavor default.\"\"\"\n     clip_encoder: str = \"\"\n     \"\"\"Override for the CLIP encoder version/path. Empty uses the flavor default.\"\"\"\n-    autoencoder_path: str = (\n-        \"torchtitan/experiments/flux/assets/autoencoder/ae.safetensors\"\n-    )\n+    autoencoder_path: str = \"assets/hf/FLUX.1-dev/ae.safetensors\"\n     \"\"\"Autoencoder checkpoint path to load. This should be a local path referring to a safetensors file.\"\"\"\n     random_init: bool = False\n     \"\"\"If True, initialize encoders with random weights instead of loading pretrained weights (for testing only).\"\"\"\n@@ -56,7 +54,7 @@ class Inference:\n \n     save_img_folder: str = \"inference_results\"\n     \"\"\"Path to save the inference results\"\"\"\n-    prompts_path: str = \"./torchtitan/experiments/flux/inference/prompts.txt\"\n+    prompts_path: str = \"./torchtitan/models/flux/inference/prompts.txt\"\n     \"\"\"Path to file with newline separated prompts to generate images for\"\"\"\n     local_batch_size: int = 2\n     \"\"\"Batch size for inference\"\"\"",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/d8a5b6d0ca123da735984e64b6060d4f888c50ae/torchtitan%2Fmodels%2Fflux%2Fconfigs.py",
