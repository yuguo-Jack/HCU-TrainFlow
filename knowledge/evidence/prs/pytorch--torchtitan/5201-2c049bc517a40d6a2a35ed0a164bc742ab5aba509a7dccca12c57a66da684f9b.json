      "changes": 13,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fmodels%2Fdeepseek_v4%2Ftest_deepseek_v4_compressor.py?ref=11775e37e7a5f339576a6d259e9b285fdb0a95e1",
      "deletions": 0,
      "filename": "tests/unit_tests/cpu/models/deepseek_v4/test_deepseek_v4_compressor.py",
      "patch": "@@ -40,3 +40,16 @@ def test_default_positions_match_explicit_positions(ratio):\n     implicit = compressor(x, positions=None)\n     explicit = compressor(x, positions=torch.arange(seqlen))\n     torch.testing.assert_close(implicit, explicit)\n+\n+\n+def test_rotate_activation_after_fake_tensor_trace():\n+    \"\"\"Regression: a cached Hadamard matrix built under a fake-tensor trace\n+    (make_fx, GraphTrainer) leaked a FakeTensor into later eager calls.\"\"\"\n+    from torch._subclasses.fake_tensor import FakeTensor, FakeTensorMode\n+\n+    from torchtitan.models.deepseek_v4.compressor import Indexer\n+\n+    with FakeTensorMode():\n+        Indexer._rotate_activation(torch.randn(4, 128))\n+    out = Indexer._rotate_activation(torch.randn(4, 128))\n+    assert not isinstance(out, FakeTensor)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/11775e37e7a5f339576a6d259e9b285fdb0a95e1/tests%2Funit_tests%2Fcpu%2Fmodels%2Fdeepseek_v4%2Ftest_deepseek_v4_compressor.py",
      "sha": "1ef2103cfb881cb665a5b8df12a6f8d72dc7f039",
      "status": "modified"
    },
    {
      "additions": 2,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/11775e37e7a5f339576a6d259e9b285fdb0a95e1/torchtitan%2Fmodels%2Fdeepseek_v4%2Fcompressor.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fdeepseek_v4%2Fcompressor.py?ref=11775e37e7a5f339576a6d259e9b285fdb0a95e1",
      "deletions": 2,
      "filename": "torchtitan/models/deepseek_v4/compressor.py",
      "patch": "@@ -5,7 +5,6 @@\n # LICENSE file in the root directory of this source tree.\n \n from dataclasses import dataclass\n-from functools import cache\n \n import torch\n import torch.nn.functional as F\n@@ -27,8 +26,9 @@\n # G = compressed groups, R = compression ratio, S = compressed pool size.\n \n \n-@cache\n def _hadamard(dim: int, dtype: torch.dtype, device: torch.device) -> torch.Tensor:\n+    # Not cached: a cache filled while tracing with fake tensors (make_fx,\n+    # GraphTrainer) would hand FakeTensors to later eager calls.\n     if dim & (dim - 1) != 0:\n         raise ValueError(\"Hadamard dim must be a power of two\")\n     h = torch.ones((1, 1), dtype=dtype, device=device)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/11775e37e7a5f339576a6d259e9b285fdb0a95e1/torchtitan%2Fmodels%2Fdeepseek_v4%2Fcompressor.py",
