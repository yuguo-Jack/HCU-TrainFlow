      "deletions": 1,
      "filename": "tests/unit_tests/cpu/models/muse_spark/test_renderer.py",
      "patch": "@@ -70,7 +70,7 @@ def test_generation_prompt_and_loss_mask(renderer, tokenizer):\n     rendered = renderer.render(messages)\n     text = tokenizer.decode(rendered.token_ids, skip_special_tokens=False)\n     assert \"Current date: 2026-01-15.\" in text\n-    assert \"Reasoning strength: 64.\" in text\n+    assert \"Reasoning strength: 32.\" in text\n     assert \"assistant to=self<|message|>thinking<|eom|>\" in text\n     assert text.endswith(\"assistant to=user<|message|>answer<|eot|>\")\n     sampled_text = tokenizer.decode(\n@@ -181,6 +181,64 @@ def test_tool_call_roundtrip_and_result_name(renderer, tokenizer):\n     )\n \n \n+@pytest.mark.parametrize(\n+    \"effort, strength\", [(\"low\", 8), (\"medium\", 32), (\"high\", 256), (\"xhigh\", 512)]\n+)\n+def test_reasoning_strength_matches_published_template(tokenizer, effort, strength):\n+    renderer = MuseSparkRendererConfig(\n+        current_date=\"2026-01-15\", reasoning_effort=effort\n+    ).build(tokenizer=tokenizer)\n+    text = tokenizer.decode(\n+        renderer.render_ids([{\"role\": \"user\", \"content\": \"hi\"}]),\n+        skip_special_tokens=False,\n+    )\n+    assert f\"Reasoning strength: {strength}.\" in text\n+\n+\n+def test_rejects_reasoning_effort_missing_from_published_template():\n+    with pytest.raises(ValueError, match=\"reasoning_effort\"):\n+        MuseSparkRendererConfig(reasoning_effort=\"minimal\")\n+\n+\n+def test_function_schemas_match_published_template(renderer, tokenizer):\n+    def function(name, **fields):\n+        return {\"type\": \"function\", \"function\": {\"name\": name, **fields}}\n+\n+    tools = [\n+        function(\n+            \"search\",\n+            parameters={\"type\": \"object\", \"properties\": {\"q\": {\"type\": \"string\"}}},\n+        ),\n+        function(\n+            \"open\",\n+            parameters={\n+                \"type\": \"object\",\n+                \"properties\": {},\n+                \"additionalProperties\": True,\n+            },\n+        ),\n+        function(\"now\"),\n+    ]\n+    text = tokenizer.decode(\n+        renderer.render_ids([{\"role\": \"user\", \"content\": \"hi\"}], tools=tools),\n+        skip_special_tokens=False,\n+    )\n+    # A schema without additionalProperties gets it appended; one that has it is\n+    # kept; missing parameters become an empty object schema.\n+    assert (\n+        '\"parameters\": {\"type\": \"object\", \"properties\": {\"q\": {\"type\": \"string\"}}, '\n+        '\"additionalProperties\": false}}'\n+    ) in text\n+    assert (\n+        '\"parameters\": {\"type\": \"object\", \"properties\": {}, '\n+        '\"additionalProperties\": true}}'\n+    ) in text\n+    assert (\n+        '{\"name\": \"now\", \"description\": \"\", \"parameters\": {\"type\": \"object\", '\n+        '\"properties\": {}, \"additionalProperties\": false}}'\n+    ) in text\n+\n+\n @pytest.mark.parametrize(\n     \"content\",\n     [",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/a319759bdd22828583d6579ba72ecd01ebf8826e/tests%2Funit_tests%2Fcpu%2Fmodels%2Fmuse_spark%2Ftest_renderer.py",
      "sha": "92ed7373d0c944204afb37078c1758ec1c407391",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/a319759bdd22828583d6579ba72ecd01ebf8826e/torchtitan%2Fmodels%2Fmuse_spark%2Frenderer.py",
      "changes": 15,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fmuse_spark%2Frenderer.py?ref=a319759bdd22828583d6579ba72ecd01ebf8826e",
      "deletions": 4,
      "filename": "torchtitan/models/muse_spark/renderer.py",
      "patch": "@@ -43,9 +43,8 @@\n \n _DEFAULT_CUTOFF_DATE = \"2026-01-04\"\n _REASONING_EFFORT = {\n-    \"minimal\": 1,\n-    \"low\": 16,\n-    \"medium\": 64,\n+    \"low\": 8,\n+    \"medium\": 32,\n     \"high\": 256,\n     \"xhigh\": 512,\n }\n@@ -202,13 +201,21 @@ def _render_tool_definitions(tools: list[dict[str, Any]]) -> str:\n     ]\n     for tool in tools:\n         function = _tool_function(tool)\n+        # As the published template prints a function: a schema without\n+        # additionalProperties gets \"additionalProperties\": false appended, and\n+        # missing parameters become an empty object schema.\n+        parameters = function.get(\"parameters\") or {}\n+        if not parameters:\n+            parameters = {\"type\": \"object\", \"properties\": {}}\n+        if isinstance(parameters, dict) and \"additionalProperties\" not in parameters:\n+            parameters = {**parameters, \"additionalProperties\": False}\n         parts.append(\n             \"\\n\"\n             + _json(\n                 {\n                     \"name\": function[\"name\"],\n                     \"description\": function.get(\"description\") or \"\",\n-                    \"parameters\": function.get(\"parameters\") or {},\n+                    \"parameters\": parameters,\n                 }\n             )\n         )",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/a319759bdd22828583d6579ba72ecd01ebf8826e/torchtitan%2Fmodels%2Fmuse_spark%2Frenderer.py",
      "sha": "5b3ecb75466cc6ef9bdb9ae05391368596e41e5a",
