    {
      "body": "<!-- ciflow-pending -->\n~~Workflows were awaiting approval.~~ CI has now been triggered for the ciflow labels on this PR.",
      "created_at": "2026-10-11T16:16:46Z",
      "html_url": "https://github.com/pytorch/torchtitan/pull/5283#issuecomment-6111043565",
      "id": 6111043565,
      "updated_at": "2026-10-11T19:03:57Z",
