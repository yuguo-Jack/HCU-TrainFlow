      "changes": 31,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fobservability%2Ftest_structured_logging.py?ref=8e528334c8193edc7079de2881b6554b988159a4",
      "deletions": 0,
      "filename": "tests/unit_tests/cpu/observability/test_structured_logging.py",
      "patch": "@@ -22,6 +22,7 @@\n from unittest import mock\n \n import pytest\n+import torch\n from torchtitan.observability.structured_logger import (\n     step_state,\n     structured_logging as sl_mod,\n@@ -1157,6 +1158,36 @@ async def outer():\n             \"outer_async_end\",\n         ]\n \n+    def test_pairs_while_another_thread_compiles(\n+        self, tmp_path, structured_logger_fixture\n+    ):\n+        \"\"\"A compile on another thread must not drop this thread's span records,\n+        as when vLLM compiles on the RL generator's engine thread.\"\"\"\n+        init_structured_logger(rank=0, source=\"generator\", output_dir=str(tmp_path))\n+        compiling, release = threading.Event(), threading.Event()\n+\n+        def blocking_backend(graph_module, example_inputs):\n+            compiling.set()\n+            release.wait()\n+            return graph_module.forward\n+\n+        compile_thread = threading.Thread(\n+            target=torch.compile(lambda x: x + 1, backend=blocking_backend),\n+            args=(torch.ones(1),),\n+            daemon=True,\n+        )\n+        compile_thread.start()\n+        assert compiling.wait(timeout=60)\n+        with log_trace_span(\"generate\"):\n+            release.set()\n+            compile_thread.join()\n+\n+        lines = _read_trace_lines(tmp_path)\n+        assert [line[\"log_type_name\"] for line in lines] == [\n+            \"generate_start\",\n+            \"generate_end\",\n+        ]\n+\n \n # ---------------------------------------------------------------------------\n # generate_gantt_trace (analysis.py)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/8e528334c8193edc7079de2881b6554b988159a4/tests%2Funit_tests%2Fcpu%2Fobservability%2Ftest_structured_logging.py",
      "sha": "557f848cadb8324f799a1e7eb4ec989f5fabf9bf",
      "status": "modified"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/8e528334c8193edc7079de2881b6554b988159a4/torchtitan%2Fobservability%2Fstructured_logger%2Fstructured_logging.py",
      "changes": 9,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fobservability%2Fstructured_logger%2Fstructured_logging.py?ref=8e528334c8193edc7079de2881b6554b988159a4",
      "deletions": 4,
      "filename": "torchtitan/observability/structured_logger/structured_logging.py",
      "patch": "@@ -311,7 +311,7 @@ def log_trace_scalar(scalars: dict[str, float | int], *, stacklevel: int = 2) ->\n \n         log_trace_scalar({\"train.loss\": 2.5, \"train.tflops\": 45.6})\n     \"\"\"\n-    if _structured_logger_disabled() or torch.compiler.is_compiling():\n+    if _structured_logger_disabled() or torch.compiler.is_dynamo_compiling():\n         return\n     step = get_step()\n     bad_keys: list[str] = []\n@@ -352,7 +352,7 @@ def log_trace_instant(event_type: str, *, stacklevel: int = 2) -> None:\n \n         log_trace_instant(\"training_start\")\n     \"\"\"\n-    if torch.compiler.is_compiling() or _structured_logger_disabled():\n+    if torch.compiler.is_dynamo_compiling() or _structured_logger_disabled():\n         return\n     _structured_logger.info(\n         str(event_type),\n@@ -412,7 +412,8 @@ def __init__(\n         self.end_type_name = self.base_name + \"_end\"\n \n     def __enter__(self):\n-        if torch.compiler.is_compiling() or _structured_logger_disabled():\n+        # Not is_compiling(): it is True in every thread while any thread compiles.\n+        if torch.compiler.is_dynamo_compiling() or _structured_logger_disabled():\n             return self\n \n         # Cache the asyncio task name so __exit__ emits the same one as\n@@ -443,7 +444,7 @@ def __exit__(self, exc_type, exc_val, exc_tb):\n         # ``_end``. The trailing ``_end`` carries elapsed-until-crash\n         # and keeps pairing simple -- analysis tools don't have to\n         # special-case exceptional spans.\n-        if torch.compiler.is_compiling() or _structured_logger_disabled():\n+        if torch.compiler.is_dynamo_compiling() or _structured_logger_disabled():\n             return None\n \n         end_time = timer()",
