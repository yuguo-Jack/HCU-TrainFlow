    {
      "additions": 62,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/08aa33fa2e4875abc782b7fb5380655ef9cdf000/tests%2Funit_tests%2Fcpu%2Fdistributed%2Ftest_fsdp.py",
      "changes": 63,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fcpu%2Fdistributed%2Ftest_fsdp.py?ref=08aa33fa2e4875abc782b7fb5380655ef9cdf000",
      "deletions": 1,
      "filename": "tests/unit_tests/cpu/distributed/test_fsdp.py",
      "patch": "@@ -19,7 +19,7 @@\n )\n from torchtitan.models.common.decoder import TransformerBlock\n from torchtitan.models.common.feed_forward import DenseFeedForward\n-from torchtitan.models.common.linear import Linear\n+from torchtitan.models.common.linear import GroupedLinear, Linear\n from torchtitan.models.common.moe import MoE\n \n \n@@ -121,3 +121,64 @@ def test_enable_fsdp_symm_mem_scope(\n     assert sparse.symm_mem_enabled == sparse_enabled\n     assert other.force_sum_enabled == dense_enabled\n     assert other.symm_mem_enabled == dense_enabled\n+\n+\n+def test_grouped_linear_shard_placements_use_default_shard_dim() -> None:\n+    module = nn.Module()\n+    # Stock layouts: in_features is last, so the output-feature axis is\n+    # second from the end. w13 stacks gate/up, w2 does not.\n+    w13 = GroupedLinear.Config(\n+        group_size=4, in_features=8, out_features=6, num_linears=2\n+    ).build()\n+    w2 = GroupedLinear.Config(\n+        group_size=4, in_features=6, out_features=8, num_linears=1\n+    ).build()\n+    module.add_module(\"w13\", w13)\n+    module.add_module(\"w2\", w2)\n+\n+    placements = linear_param_shard_placements(module, include_unstacked_grouped=True)\n+\n+    assert list(w13.weight.shape) == [4, 2, 6, 8]\n+    assert list(w2.weight.shape) == [4, 8, 6]\n+    assert placements == {\n+        w13.weight: Shard(2),\n+        w2.weight: Shard(1),\n+    }\n+\n+\n+def test_grouped_linear_subclass_declares_its_own_shard_dim() -> None:\n+    \"\"\"A kernel-native layout ends with out_features, so it shards the last dim.\n+\n+    With the stock ``ndim - 2`` this would pick the size-2 gate/up axis, which\n+    does not divide across an FSDP shard group larger than 2.\n+    \"\"\"\n+\n+    class _KernelLayoutGroupedLinear(GroupedLinear):\n+        \"\"\"Stores w13 as [E, D, N, F]: out_features is last.\"\"\"\n+\n+        def __init__(self, config: GroupedLinear.Config) -> None:\n+            super().__init__(config)\n+            self.weight = nn.Parameter(\n+                torch.empty(\n+                    config.group_size,\n+                    config.in_features,\n+                    config.num_linears,\n+                    config.out_features,\n+                )\n+            )\n+\n+        def fsdp_shard_dim(self, param_name: str) -> int:\n+            return -1\n+\n+    module = nn.Module()\n+    config = GroupedLinear.Config(\n+        group_size=4, in_features=8, out_features=6, num_linears=2\n+    )\n+    kernel = _KernelLayoutGroupedLinear(config)\n+    module.add_module(\"w13\", kernel)\n+\n+    placements = linear_param_shard_placements(module)\n+\n+    assert list(kernel.weight.shape) == [4, 8, 2, 6]\n+    # Stock would have picked dim 2, the size-2 gate/up axis.\n+    assert placements == {kernel.weight: Shard(-1)}",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/08aa33fa2e4875abc782b7fb5380655ef9cdf000/tests%2Funit_tests%2Fcpu%2Fdistributed%2Ftest_fsdp.py",
      "sha": "bf61ff84601c1780133012faa0ad1e245e1bbe35",
      "status": "modified"
    },
    {
      "additions": 15,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/08aa33fa2e4875abc782b7fb5380655ef9cdf000/torchtitan%2Fdistributed%2Ffsdp.py",
      "changes": 18,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fdistributed%2Ffsdp.py?ref=08aa33fa2e4875abc782b7fb5380655ef9cdf000",
      "deletions": 3,
      "filename": "torchtitan/distributed/fsdp.py",
      "patch": "@@ -80,6 +80,11 @@ def linear_param_shard_placements(\n     for stacked weights. FSDP's default ``Shard(0)`` would split a logical\n     projection or group dimension, so shard the matrix rows instead.\n \n+    A ``GroupedLinear`` reports the dimension through ``fsdp_shard_dim``, so a\n+    subclass that stores its weight in a kernel-native order shards its own\n+    output-feature axis. The default returns the same dimension this function\n+    used before, so stock placements are unchanged.\n+\n     Args:\n         module: Module tree whose linear parameters should be inspected.\n         include_unstacked_grouped: Also return ordinary ``[E, F, D]`` grouped\n@@ -94,9 +99,16 @@ def linear_param_shard_placements(\n         elif not isinstance(child, nn.Linear) or getattr(child, \"num_linears\", 1) == 1:\n             continue\n         weight = cast(nn.Parameter, child.weight)\n-        placements[weight] = Shard(weight.ndim - 2)\n-        if (bias := getattr(child, \"bias\", None)) is not None:\n-            placements[bias] = Shard(bias.ndim - 1)\n+        bias = getattr(child, \"bias\", None)\n+        if isinstance(child, GroupedLinear):\n+            weight_dim = child.fsdp_shard_dim(\"weight\")\n+            bias_dim = child.fsdp_shard_dim(\"bias\") if bias is not None else None\n+        else:\n+            weight_dim = weight.ndim - 2\n+            bias_dim = bias.ndim - 1 if bias is not None else None\n+        placements[weight] = Shard(weight_dim)\n+        if bias is not None:\n+            placements[bias] = Shard(cast(int, bias_dim))\n     return placements\n \n ",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/08aa33fa2e4875abc782b7fb5380655ef9cdf000/torchtitan%2Fdistributed%2Ffsdp.py",
      "sha": "c3ec90674debbfac612bd93fad9fdbd790ad0478",
      "status": "modified"
    },
    {
      "additions": 21,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/08aa33fa2e4875abc782b7fb5380655ef9cdf000/torchtitan%2Fmodels%2Fcommon%2Flinear%2Flinear.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fcommon%2Flinear%2Flinear.py?ref=08aa33fa2e4875abc782b7fb5380655ef9cdf000",
      "deletions": 0,
      "filename": "torchtitan/models/common/linear/linear.py",
      "patch": "@@ -422,6 +422,27 @@ def __init__(self, config: Config):\n             torch.empty(config.group_size, *output_shape, config.in_features)\n         )\n \n+    def fsdp_shard_dim(self, param_name: str) -> int:\n+        \"\"\"Return the dimension FSDP shards when it cannot shard the group axis.\n+\n+        FSDP shards routed-expert parameters on the group (expert) axis. When\n+        the shard group is larger than the group size, it shards the\n+        output-feature axis instead. Only this class knows where that axis is,\n+        because a subclass may store the weight in a kernel-native order.\n+\n+        The default matches the stock ``[E, N, F, D]`` weight and ``[E, N, F]``\n+        bias layout, where ``in_features`` is last, so the output-feature axis\n+        is second from the end for a weight and last for a bias.\n+\n+        Args:\n+            param_name: ``\"weight\"`` or ``\"bias\"``.\n+\n+        Returns:\n+            The index of the output-feature dimension of that parameter.\n+        \"\"\"\n+        ndim = self.weight.ndim\n+        return ndim - 2 if param_name == \"weight\" else ndim - 1\n+\n     def forward(self, input_RI: torch.Tensor, offsets_E: torch.Tensor) -> torch.Tensor:\n         \"\"\"Apply each grouped linear to rows selected by cumulative offsets.\n ",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/08aa33fa2e4875abc782b7fb5380655ef9cdf000/torchtitan%2Fmodels%2Fcommon%2Flinear%2Flinear.py",
      "sha": "af6a3347e1c96fe90629ee3b60da1ee17e18969e",
      "status": "modified"
    }
