  "files": [
    {
      "additions": 48,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/0e2c535b5fc408624a01afafbf126add13d6e214/tests%2Frl%2Funit_tests%2Fgpu%2Ftest_prefetch_buffers.py",
      "changes": 48,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fgpu%2Ftest_prefetch_buffers.py?ref=0e2c535b5fc408624a01afafbf126add13d6e214",
      "deletions": 0,
      "filename": "tests/rl/unit_tests/gpu/test_prefetch_buffers.py",
      "patch": "@@ -0,0 +1,48 @@\n+# Copyright (c) Meta Platforms, Inc. and affiliates.\n+# All rights reserved.\n+#\n+# This source code is licensed under the BSD-style license found in the\n+# LICENSE file in the root directory of this source tree.\n+\n+import pytest\n+import torch\n+import torch.distributed as dist\n+from torch.distributed.device_mesh import init_device_mesh\n+from torch.distributed.tensor import DTensor, Shard\n+from torchtitan.rl.generator.vllm.model_wrapper import _empty_pinned_like\n+\n+\n+@pytest.mark.skipif(not torch.cuda.is_available(), reason=\"CUDA required\")\n+def test_empty_pinned_like_keeps_spec_without_reading_weights(tmp_path) -> None:\n+    \"\"\"Build a pinned CPU buffer from the weight's shapes alone, with the weight's DTensor spec.\"\"\"\n+    dist.init_process_group(\n+        \"nccl\", init_method=f\"file://{tmp_path / 'store'}\", rank=0, world_size=1\n+    )\n+    try:\n+        mesh = init_device_mesh(\"cuda\", (1,))\n+        # A [2, 8] shard of a [4, 8] weight, with its storage freed: a copy would fail.\n+        local_tensor = torch.empty(2, 8, dtype=torch.bfloat16, device=\"cuda\")\n+        weight = DTensor.from_local(\n+            local_tensor,\n+            mesh,\n+            [Shard(0)],\n+            shape=torch.Size([4, 8]),\n+            stride=(8, 1),\n+            run_check=False,\n+        )\n+        local_tensor.untyped_storage().resize_(0)\n+\n+        buffer = _empty_pinned_like(weight)\n+\n+        assert isinstance(buffer, DTensor)\n+        assert buffer._spec == weight._spec\n+        assert buffer.to_local().shape == (2, 8)\n+        assert buffer.to_local().dtype == torch.bfloat16\n+        assert buffer.to_local().device.type == \"cpu\"\n+        assert buffer.to_local().is_pinned()\n+\n+        plain_buffer = _empty_pinned_like(torch.zeros(4, device=\"cuda\"))\n+        assert plain_buffer.shape == (4,) and plain_buffer.device.type == \"cpu\"\n+        assert plain_buffer.is_pinned()\n+    finally:\n+        dist.destroy_process_group()",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/0e2c535b5fc408624a01afafbf126add13d6e214/tests%2Frl%2Funit_tests%2Fgpu%2Ftest_prefetch_buffers.py",
      "sha": "e52d384326aadcbd89d1c9365c129ba9f0820965",
      "status": "added"
    },
    {
      "additions": 28,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/0e2c535b5fc408624a01afafbf126add13d6e214/torchtitan%2Frl%2Fgenerator%2Fvllm%2Fmodel_wrapper.py",
      "changes": 33,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Frl%2Fgenerator%2Fvllm%2Fmodel_wrapper.py?ref=0e2c535b5fc408624a01afafbf126add13d6e214",
      "deletions": 5,
      "filename": "torchtitan/rl/generator/vllm/model_wrapper.py",
      "patch": "@@ -22,7 +22,7 @@\n import torch\n import torch.distributed as dist\n from torch.distributed._composable.fsdp import FSDPModule\n-from torch.distributed._state_dict_utils import _copy_state_dict, _create_cpu_state_dict\n+from torch.distributed._state_dict_utils import _copy_state_dict\n from torch.distributed.tensor import DTensor, Replicate\n from vllm.compilation.decorators import support_torch_compile\n from vllm.config import VllmConfig\n@@ -414,11 +414,14 @@ def __init__(\n         # is still sharded. Bind first so first-touch places them on the\n         # NUMA node local to this rank's GPU.\n         maybe_apply_numa_binding(torch.cuda.current_device(), \"cuda\")\n+        # TODO: allocating pinned memory still takes 13.7 s per 64 GiB (H100 host). A background\n+        # thread during vLLM's memory profiling would hide it, but joining it before graph capture\n+        # needs a model-runner hook.\n         model_state_dict = self.model.state_dict()\n-        with torch.device(\"cpu\"):\n-            self._prefetched_model_state_dict = _create_cpu_state_dict(\n-                model_state_dict, pin_memory=True\n-            )\n+        self._prefetched_model_state_dict = {\n+            name: _empty_pinned_like(tensor)\n+            for name, tensor in model_state_dict.items()\n+        }\n         # A sync overwrites only the keys the trainer publishes; the rest\n         # (e.g. vLLM's attention scales) keep the values copied here.\n         _copy_state_dict(model_state_dict, self._prefetched_model_state_dict)\n@@ -741,3 +744,23 @@ def load_weights(self, weights_iter):\n \n         # Return the names of all loaded parameters so vLLM knows they were handled\n         return loaded_param_names\n+\n+\n+def _empty_pinned_like(tensor: torch.Tensor) -> torch.Tensor:\n+    \"\"\"Allocate an uninitialized pinned CPU tensor for `tensor`'s local shard, with its DTensor spec.\n+\n+    Example:\n+        DTensor [4096, 1024], Shard(0) over 2 ranks, on GPU\n+        -> DTensor [4096, 1024], Shard(0); local tensor: pinned CPU [2048, 1024]\n+        tensor [64] on GPU -> pinned CPU tensor [64]\n+    \"\"\"\n+    if not isinstance(tensor, DTensor):\n+        return torch.empty(\n+            tensor.shape, dtype=tensor.dtype, device=\"cpu\", pin_memory=True\n+        )\n+    local_tensor = tensor._local_tensor\n+    buffer = torch.empty(\n+        local_tensor.shape, dtype=local_tensor.dtype, device=\"cpu\", pin_memory=True\n+    )\n+    # Not DTensor.from_local: it moves the local tensor to the mesh's device (GPU).\n+    return DTensor(buffer, tensor._spec, requires_grad=False)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/0e2c535b5fc408624a01afafbf126add13d6e214/torchtitan%2Frl%2Fgenerator%2Fvllm%2Fmodel_wrapper.py",
      "sha": "5d21f28779b07f421c691c91a7f3ee62e84a84fa",
      "status": "modified"
    }
