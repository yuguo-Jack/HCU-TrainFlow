    {
      "additions": 21,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/7a8ffef03d9e359b1ab5782c2990fda0b5fccd50/tests%2Funit_tests%2Fgpu%2Fmodels%2Fmuse_spark%2Ftest_attention_compile.py",
      "changes": 21,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Funit_tests%2Fgpu%2Fmodels%2Fmuse_spark%2Ftest_attention_compile.py?ref=7a8ffef03d9e359b1ab5782c2990fda0b5fccd50",
      "deletions": 0,
      "filename": "tests/unit_tests/gpu/models/muse_spark/test_attention_compile.py",
      "patch": "@@ -57,3 +57,24 @@ def test_attention_region_matches_eager(region):\n     # Compiled pointwise math contracts into FMAs: allow ~1 bf16 ulp.\n     for actual_tensor, expected_tensor in zip(actual, expected, strict=True):\n         torch.testing.assert_close(actual_tensor, expected_tensor, atol=2e-2, rtol=2e-2)\n+\n+\n+def test_rmsnorm_region_matches_eager():\n+    # The residual stream is fp32 and the norm weight bf16, as under FSDP mixed precision.\n+    norm = build_model_config(\"debugmodel\").layers[0].attention_norm.build().cuda()\n+    norm = norm.to(torch.bfloat16)\n+    stream_TD = torch.randn(64, norm.normalized_shape[0], device=\"cuda\")\n+\n+    def norm_and_weight_grad(regions):\n+        apply_local_compile(regions)\n+        norm.weight.grad = None\n+        return [*_run(norm, (stream_TD,)), norm.weight.grad]\n+\n+    try:\n+        expected = norm_and_weight_grad([])\n+        actual = norm_and_weight_grad([\"muse_spark_rmsnorm\"])\n+    finally:\n+        apply_local_compile([])\n+\n+    for actual_tensor, expected_tensor in zip(actual, expected, strict=True):\n+        torch.testing.assert_close(actual_tensor, expected_tensor, atol=2e-2, rtol=2e-2)",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/7a8ffef03d9e359b1ab5782c2990fda0b5fccd50/tests%2Funit_tests%2Fgpu%2Fmodels%2Fmuse_spark%2Ftest_attention_compile.py",
      "sha": "bb6a5e58601916e2aa762f74ae02b4d9caf3e52d",
      "status": "modified"
    },
    {
      "additions": 3,
      "blob_url": "https://github.com/pytorch/torchtitan/blob/7a8ffef03d9e359b1ab5782c2990fda0b5fccd50/torchtitan%2Fmodels%2Fmuse_spark%2Fmodel.py",
      "changes": 3,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/torchtitan%2Fmodels%2Fmuse_spark%2Fmodel.py?ref=7a8ffef03d9e359b1ab5782c2990fda0b5fccd50",
      "deletions": 0,
      "filename": "torchtitan/models/muse_spark/model.py",
      "patch": "@@ -213,6 +213,8 @@ def _get_effective_weight(self) -> torch.Tensor | None:\n             return None\n         return self.weight + self.gain_center\n \n+    # Limit 16, not the default 8: all residual-stream norms share this region and use 12 graphs.\n+    @local_compile(\"muse_spark_rmsnorm\", batch_invariant=False, recompile_limit=16)\n     def forward(self, input: torch.Tensor) -> torch.Tensor:\n         input_dtype = input.dtype\n         effective_weight_D = self._get_effective_weight()\n@@ -434,6 +436,7 @@ class Config(MultimodalModel.Config):\n                 \"muse_spark_input_scaled_rmsnorm\",\n                 \"muse_spark_logit_postprocess\",\n                 \"muse_spark_residual\",\n+                \"muse_spark_rmsnorm\",\n             ]\n         )\n         # pyrefly: ignore [bad-override]",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/7a8ffef03d9e359b1ab5782c2990fda0b5fccd50/torchtitan%2Fmodels%2Fmuse_spark%2Fmodel.py",
      "sha": "619bf4bc434b4dc6e1ab661e047a7cecf86eb1ae",
      "status": "modified"
    }
