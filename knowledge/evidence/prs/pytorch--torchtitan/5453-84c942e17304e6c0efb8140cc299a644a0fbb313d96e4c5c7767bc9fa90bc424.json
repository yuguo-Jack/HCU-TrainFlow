      "changes": 19,
      "contents_url": "https://api.github.com/repos/pytorch/torchtitan/contents/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_verifiers.py?ref=9e3f328381c4af8e445c3fc3d2bec46a2ae7d0ab",
      "deletions": 0,
      "filename": "tests/rl/unit_tests/cpu/test_verifiers.py",
      "patch": "@@ -714,6 +714,25 @@ async def generate_fn(*args, **kwargs):\n     asyncio.run(run_test())\n \n \n+def test_generation_server_does_not_log_each_request(caplog) -> None:\n+    async def run_test() -> None:\n+        server = GenerationServer.Config(max_rollout_tokens=40960).build()\n+        await server.start()\n+        try:\n+            async with ClientSession() as session:\n+                response = await session.get(\n+                    f\"http://{server.host}:{server.port}/healthz\"\n+                )\n+                assert response.status == 200\n+        finally:\n+            await server.close()\n+\n+    # aiohttp skips the access log above INFO, and imports can change the root level.\n+    with caplog.at_level(logging.INFO, logger=\"aiohttp.access\"):\n+        asyncio.run(run_test())\n+    assert \"aiohttp.access\" not in [record.name for record in caplog.records]\n+\n+\n def test_generation_server_rejects_prompt_without_room_for_output() -> None:\n     async def run_test() -> None:\n         prompt_lengths = []",
      "raw_url": "https://github.com/pytorch/torchtitan/raw/9e3f328381c4af8e445c3fc3d2bec46a2ae7d0ab/tests%2Frl%2Funit_tests%2Fcpu%2Ftest_verifiers.py",
      "sha": "756388902c2150afb668c90e1aec3ef1abe70292",
      "status": "modified"
    },
