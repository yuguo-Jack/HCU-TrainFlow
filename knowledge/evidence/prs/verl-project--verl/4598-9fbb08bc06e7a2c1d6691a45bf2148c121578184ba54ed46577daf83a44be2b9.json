      "blob_url": "https://github.com/verl-project/verl/blob/8403d042b3f1b6b301a807f8eb86121a6d0ca7d5/verl%2Ftrainer%2Fppo%2Fcore_algos.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/verl%2Ftrainer%2Fppo%2Fcore_algos.py?ref=8403d042b3f1b6b301a807f8eb86121a6d0ca7d5",
      "deletions": 1,
      "filename": "verl/trainer/ppo/core_algos.py",
      "patch": "@@ -319,7 +319,9 @@ def compute_grpo_outcome_advantage(\n             else:\n                 raise ValueError(f\"no score in prompt index: {idx}\")\n         for i in range(bsz):\n-            if norm_adv_by_std_in_grpo:\n+            if torch.all(torch.isclose(torch.stack(id2score[index[i]]), id2mean[index[i]], atol=epsilon)): \n+                scores[i] = 0\n+            elif norm_adv_by_std_in_grpo:\n                 scores[i] = (scores[i] - id2mean[index[i]]) / (id2std[index[i]] + epsilon)\n             else:\n                 scores[i] = scores[i] - id2mean[index[i]]",
      "raw_url": "https://github.com/verl-project/verl/raw/8403d042b3f1b6b301a807f8eb86121a6d0ca7d5/verl%2Ftrainer%2Fppo%2Fcore_algos.py",
