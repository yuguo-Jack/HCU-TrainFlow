      "filename": "pyproject.toml",
      "patch": "@@ -89,7 +89,7 @@ vllm = [\n     \"verl[verl-core]\",\n     \"torch==2.13.0\",\n     \"torchvision==0.28.0\",\n-    \"torchaudio==2.11.0\",\n+    \"torchaudio==2.11.1\",\n     # PyPI's 0.32.0 wheel is already a cu130 / torch-2.13 abi3 build, so it needs\n     # no wheelhouse routing and no source build.\n     \"vllm==0.32.0\",\n@@ -104,7 +104,7 @@ sglang = [\n     \"verl[verl-core]\",\n     \"torch==2.13.0\",\n     \"torchvision==0.28.0\",\n-    \"torchaudio==2.11.0\",\n+    \"torchaudio==2.11.1\",\n     # sglang + sglang-kernel come from PyPI; upstream's 0.5.20 wheels are cu130 /\n     # torch-2.13 builds already (sglang-kernel links libcudart.so.13).\n     \"sglang==0.5.20\",\n@@ -138,7 +138,7 @@ fsdp = [\n     \"verl[cupy-cu130]\",\n     \"torch==2.13.0\",\n     \"torchvision==0.28.0\",\n-    \"torchaudio==2.11.0\",\n+    \"torchaudio==2.11.1\",\n     \"liger-kernel==0.8.4\",\n     \"trl==0.27.0\",\n     \"flash-linear-attention==0.5.2\",\n@@ -155,7 +155,7 @@ megatron = [\n     \"verl[cupy-cu130]\",\n     \"torch==2.13.0\",\n     \"torchvision==0.28.0\",\n-    \"torchaudio==2.11.0\",\n+    \"torchaudio==2.11.1\",\n     \"nvidia-mathdx\",\n     \"apex\",\n     \"transformer-engine==2.20.2\",\n@@ -199,7 +199,7 @@ veomni = [\n     \"verl[cupy-cu130]\",\n     \"torch==2.13.0\",\n     \"torchvision==0.28.0\",\n-    \"torchaudio==2.11.0\",\n+    \"torchaudio==2.11.1\",\n     \"liger-kernel==0.8.4\",\n     \"trl==0.27.0\",\n     \"flash-linear-attention==0.5.2\",\n@@ -248,7 +248,7 @@ cpu = [\n     \"verl[verl-core]\",\n     \"torch==2.13.0\",\n     \"torchvision==0.28.0\",\n-    \"torchaudio==2.11.0\",\n+    \"torchaudio==2.11.1\",\n     \"transformers==5.16.1\",\n     # Plain source package (torch / numpy / packaging + one pybind11 C++ ext, no\n     # CUDA toolchain), and it imports without TE / apex — both are optional there",
