                    "__typename": "User",
                    "login": "vermouth1992"
                  },
                  "body": "Is it correct to perform a global grad clip after all the micro batches forward and backward?",
                  "createdAt": "2025-03-02T12:20:48Z",
                  "databaseId": 1976614209,
                  "diffHunk": "@@ -394,8 +394,10 @@ def training_step(self, batch: TensorDict):\n         n_micro_batches = len(micro_batches)\n         step_loss = 0\n         for micro_batch in micro_batches:\n-            loss = self._compute_loss_and_backward(batch=micro_batch) / n_micro_batches\n+            loss = self._compute_loss_and_backward(batch=micro_batch, do_backward=False) / n_micro_batches\n+            loss.backward()\n             step_loss += loss.item()\n+            grad_norm = self.fsdp_model.clip_grad_norm_(max_norm=self.config.optim.clip_grad)",
                  "line": 400,
                  "originalLine": 400,
