                  "author": {
                    "__typename": "User",
                    "login": "vermouth1992"
                  },
                  "body": "I also think DataProtoItem is not a good design and should be removed. However, when item is a single index, the batch dim vanishes. Is there any way to handle both cases?",
                  "createdAt": "2025-03-12T03:21:25Z",
                  "databaseId": 1990483189,
                  "diffHunk": "@@ -195,6 +195,15 @@ def __len__(self):\n             return 0\n \n     def __getitem__(self, item):\n+        if isinstance(item, slice):\n+            if self.batch is not None:\n+                tensor_data = self.batch[item]\n+            else:\n+                tensor_data = None\n+\n+            non_tensor_data = {key: val[item] for key, val in self.non_tensor_batch.items()}\n+            return DataProto(batch=tensor_data, non_tensor_batch=non_tensor_data, meta_info=self.meta_info)\n+\n         tensor_data = self.batch[item]\n         non_tensor_data = {key: val[item] for key, val in self.non_tensor_batch.items()}\n         return DataProtoItem(batch=tensor_data, non_tensor_batch=non_tensor_data, meta_info=self.meta_info)",
                  "line": 209,
                  "originalLine": 209,
                  "path": "verl/protocol.py",
