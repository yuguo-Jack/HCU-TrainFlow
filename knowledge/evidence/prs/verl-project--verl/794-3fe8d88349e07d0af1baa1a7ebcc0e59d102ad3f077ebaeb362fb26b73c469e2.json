      "patch": "@@ -790,6 +790,9 @@ def fit(self):\n         self.global_steps += 1\n         last_val_metrics = None\n \n+        rank_id_tuples = self.actor_rollout_wg.get_actor_module()\n+        self.ref_policy_wg.ref_bind_actors(rank_id_tuples)\n+\n         for epoch in range(self.config.trainer.total_epochs):\n             for batch_dict in self.train_dataloader:\n                 metrics = {}",
      "raw_url": "https://github.com/verl-project/verl/raw/2a548635219ce8a572112af86739afc0dd003424/verl%2Ftrainer%2Fppo%2Fray_trainer.py",
