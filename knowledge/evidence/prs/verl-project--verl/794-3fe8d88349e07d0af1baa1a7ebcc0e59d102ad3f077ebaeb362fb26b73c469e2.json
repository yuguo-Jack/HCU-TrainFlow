      "changes": 3,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/verl%2Ftrainer%2Fppo%2Fray_trainer.py?ref=2a548635219ce8a572112af86739afc0dd003424",
      "deletions": 0,
