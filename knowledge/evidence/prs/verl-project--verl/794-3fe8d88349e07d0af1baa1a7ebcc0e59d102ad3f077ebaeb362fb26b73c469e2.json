      "changes": 3,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/verl%2Ftrainer%2Fconfig%2Fppo_trainer.yaml?ref=2a548635219ce8a572112af86739afc0dd003424",
      "deletions": 0,
      "filename": "verl/trainer/config/ppo_trainer.yaml",
      "patch": "@@ -66,6 +66,9 @@ actor_rollout_ref:\n     log_prob_use_dynamic_bsz: ${actor_rollout_ref.actor.use_dynamic_bsz}\n     log_prob_max_token_len_per_gpu: ${actor_rollout_ref.actor.ppo_max_token_len_per_gpu}\n     ulysses_sequence_parallel_size: ${actor_rollout_ref.actor.ulysses_sequence_parallel_size} # sp size\n+    sync_ref_model: False\n+    ref_model_sync_steps: 0\n+    ref_model_mixup_alpha: 0.0\n   rollout:\n     name: vllm\n     temperature: 1.0",
      "raw_url": "https://github.com/verl-project/verl/raw/2a548635219ce8a572112af86739afc0dd003424/verl%2Ftrainer%2Fconfig%2Fppo_trainer.yaml",
      "sha": "e3b1e61649b5fb0f3615f4431cfe2768a2e41a0d",
