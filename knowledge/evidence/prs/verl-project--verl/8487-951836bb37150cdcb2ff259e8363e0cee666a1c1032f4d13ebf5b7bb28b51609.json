      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/.github%2Fworkflows%2Fnightly_ascend.yml?ref=dc43b7331f90d5c89419d10082cd2b3b61f2122f",
      "deletions": 6,
      "filename": ".github/workflows/nightly_ascend.yml",
      "patch": "@@ -32,10 +32,7 @@\n name: nightly_ci_ascend\n \n on:\n-  # Trigger the workflow on push or pull request,\n-  # but only for the main branch\n-  # For push, for now only anti-patterns are specified so it is more conservative\n-  # and achieves higher coverage.\n+  pull_request:\n   schedule:\n     - cron: \"0 17 * * *\"\n     - cron: \"0 18 * * *\"\n@@ -103,8 +100,8 @@ jobs:\n \n   # Test grpo qwen3_vl_8b_Instruct fsdp2 vllm\n   nightlyCI_grpo_qwen3_vl_8b_Instruct_fsdp2_vllm_ascend:\n-    if: ${{ github.repository_owner == 'verl-project' && github.event.schedule == '0 17 * * *' }}\n-    runs-on: linux-aarch64-a3-800i-16\n+    if: ${{ github.repository_owner == 'verl-project' && (github.event_name == 'pull_request' || github.event.schedule == '0 17 * * *') }}\n+    runs-on: linux-aarch64-a3-800i-16-memclean\n     timeout-minutes: 180 # Increase this timeout value as needed\n     container:\n       image: swr.cn-southwest-2.myhuaweicloud.com/modelfoundry/ascend-ci/verl/verl:latest-vllm-a3-ubuntu\n@@ -141,6 +138,11 @@ jobs:\n       - name: Preprocess geo3k dataset\n         run: |\n           python examples/data_preprocess/geo3k.py --local_dataset_path ${HOME}/.cache/modelscope/dataset/hiyouga/geometry3k\n+      - name: Print system memory before training\n+        run: |\n+          awk '/^(MemTotal|MemFree|MemAvailable|Cached|Buffers|AnonPages|Shmem|Slab):/ {\n+              printf \"%-16s %10.3f GiB\\n\", $1, $2/1048576\n+          }' /proc/meminfo\n       - name: Running nightlyCI_grpo_qwen3_vl_8b_Instruct_fsdp2_vllm_ascend\n         run: |\n           ray stop --force",
