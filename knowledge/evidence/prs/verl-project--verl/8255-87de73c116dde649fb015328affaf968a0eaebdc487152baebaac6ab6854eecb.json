      "additions": 61,
      "blob_url": "https://github.com/verl-project/verl/blob/9b7d3e3cb5709e48d292145f859a77cdcd9c945b/tests%2Fmodels%2Ftest_qwen3_5_decoder_layer_forward_on_cpu.py",
      "changes": 61,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/tests%2Fmodels%2Ftest_qwen3_5_decoder_layer_forward_on_cpu.py?ref=9b7d3e3cb5709e48d292145f859a77cdcd9c945b",
      "deletions": 0,
      "filename": "tests/models/test_qwen3_5_decoder_layer_forward_on_cpu.py",
      "patch": "@@ -0,0 +1,61 @@\n+# Copyright 2024 Bytedance Ltd. and/or its affiliates\n+#\n+# Licensed under the Apache License, Version 2.0 (the \"License\");\n+# you may not use this file except in compliance with the License.\n+# You may obtain a copy of the License at\n+#\n+#     http://www.apache.org/licenses/LICENSE-2.0\n+#\n+# Unless required by applicable law or agreed to in writing, software\n+# distributed under the License is distributed on an \"AS IS\" BASIS,\n+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n+# See the License for the specific language governing permissions and\n+# limitations under the License.\n+\n+\"\"\"verl's patched Qwen3.5 decoder-layer forward must work across transformers versions.\n+\n+transformers renamed ``Qwen3_5DecoderLayer.layer_type`` to ``block_type`` in 5.13.0. The patched forward\n+used to read ``self.layer_type`` and raised\n+``AttributeError: 'Qwen3_5DecoderLayer' object has no attribute 'layer_type'`` on newer versions.\n+\"\"\"\n+\n+import pytest\n+import torch\n+\n+pytest.importorskip(\"transformers.models.qwen3_5\")\n+\n+from transformers.models.qwen3_5.configuration_qwen3_5 import Qwen3_5TextConfig\n+from transformers.models.qwen3_5.modeling_qwen3_5 import Qwen3_5DecoderLayer, Qwen3_5TextRotaryEmbedding\n+\n+from verl.models.transformers.qwen3_5 import qwen3_5_decoder_layer_forward\n+\n+\n+@pytest.mark.parametrize(\"attr_name\", [\"layer_type\", \"block_type\"])\n+def test_full_attention_layer_forward(attr_name):\n+    config = Qwen3_5TextConfig(\n+        hidden_size=64,\n+        intermediate_size=128,\n+        num_hidden_layers=2,\n+        num_attention_heads=4,\n+        num_key_value_heads=2,\n+        head_dim=16,\n+        layer_types=[\"linear_attention\", \"full_attention\"],\n+    )\n+    config._attn_implementation = \"sdpa\"\n+    layer = Qwen3_5DecoderLayer(config, layer_idx=1)\n+\n+    # Force the layer to expose only `attr_name`, mirroring either side of the\n+    # transformers 5.13 rename regardless of which attribute the installed\n+    # transformers actually uses, so both fallback branches get exercised.\n+    value = getattr(layer, \"layer_type\", None) or layer.block_type\n+    for name in (\"layer_type\", \"block_type\"):\n+        if hasattr(layer, name):\n+            delattr(layer, name)\n+    setattr(layer, attr_name, value)\n+\n+    x = torch.randn(1, 8, 64)\n+    position_ids = torch.arange(8)[None]\n+    position_embeddings = Qwen3_5TextRotaryEmbedding(config)(x, position_ids[None].expand(3, 1, 8))\n+\n+    out = qwen3_5_decoder_layer_forward(layer, x, position_embeddings, attention_mask=None, position_ids=position_ids)\n+    assert out.shape == x.shape",
      "raw_url": "https://github.com/verl-project/verl/raw/9b7d3e3cb5709e48d292145f859a77cdcd9c945b/tests%2Fmodels%2Ftest_qwen3_5_decoder_layer_forward_on_cpu.py",
      "sha": "fbea76dd389114d5f8249039b79cd4e3654a835f",
      "status": "added"
    },
    {
      "additions": 5,
      "blob_url": "https://github.com/verl-project/verl/blob/9b7d3e3cb5709e48d292145f859a77cdcd9c945b/verl%2Fmodels%2Ftransformers%2Fqwen3_5.py",
      "changes": 7,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/verl%2Fmodels%2Ftransformers%2Fqwen3_5.py?ref=9b7d3e3cb5709e48d292145f859a77cdcd9c945b",
      "deletions": 2,
      "filename": "verl/models/transformers/qwen3_5.py",
      "patch": "@@ -350,15 +350,18 @@ def qwen3_5_decoder_layer_forward(\n \n     hidden_states = self.input_layernorm(hidden_states)\n \n-    if self.layer_type == \"linear_attention\":\n+    # transformers >= 5.13 renamed the decoder layer's `layer_type` to `block_type`.\n+    layer_type = getattr(self, \"layer_type\", None) or self.block_type\n+\n+    if layer_type == \"linear_attention\":\n         hidden_states = self.linear_attn(\n             hidden_states=hidden_states,\n             cache_params=past_key_values,\n             attention_mask=attention_mask,\n             cu_seqlens=cu_seqlens,\n             cu_seqlens_cpu=cu_seqlens_cpu,\n         )\n-    elif self.layer_type == \"full_attention\":\n+    elif layer_type == \"full_attention\":\n         hidden_states, _ = self.self_attn(\n             hidden_states=hidden_states,\n             attention_mask=attention_mask,",
      "raw_url": "https://github.com/verl-project/verl/raw/9b7d3e3cb5709e48d292145f859a77cdcd9c945b/verl%2Fmodels%2Ftransformers%2Fqwen3_5.py",
      "sha": "cbe79e2a638da4b226def477eb9ab38e16b1aa10",
      "status": "modified"
    }
