      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/.github%2Fworkflows%2Fnightly_ascend.yml?ref=106361ce30bc517b18aa36f56f97342758869fa7",
      "deletions": 4,
      "filename": ".github/workflows/nightly_ascend.yml",
      "patch": "@@ -32,6 +32,9 @@\n name: nightly_ci_ascend\n \n on:\n+  # Temporary trigger to validate the Qwen3-8B PPO and Qwen3.5-2B FSDP2 GRPO jobs.\n+  pull_request:\n+    branches: [main]\n   # Trigger the workflow on push or pull request,\n   # but only for the main branch\n   # For push, for now only anti-patterns are specified so it is more conservative\n@@ -54,15 +57,15 @@ env:\n jobs:\n   # Test ppo qwen3-8b fsdp vllm\n   nightlyCI_ppo-qwen3-8b-fsdp-vllm_ascend:\n-    if: ${{ github.repository_owner == 'verl-project' && github.event.schedule == '0 17 * * *' }}\n+    if: ${{ github.repository_owner == 'verl-project' && (github.event_name == 'pull_request' || github.event.schedule == '0 17 * * *') }}\n     runs-on: linux-aarch64-a3-8\n     timeout-minutes: 180 # Increase this timeout value as needed\n     container:\n       image: swr.cn-southwest-2.myhuaweicloud.com/modelfoundry/ascend-ci/verl/verl:latest-vllm-a3-ubuntu\n       options: >-\n         --shm-size 16g\n     env:\n-      MODEL_PATH: /root/.cache/models/Qwen/Qwen3-8B\n+      MODEL_PATH: /root/.cache/modelscope/hub/models/Qwen/Qwen3-8B\n       HF_ENDPOINT: \"https://hf-mirror.com\"\n       HF_HUB_ENABLE_HF_TRANSFER: \"0\" # This is more stable\n       PIP_INDEX_URL: \"http://cache-service.nginx-pypi-cache.svc.cluster.local/pypi/simple\"\n@@ -331,7 +334,7 @@ jobs:\n   \n     # Test grpo qwen3_5_2b fsdp2 vllm\n   nightlyCI_grpo_qwen3_5_2b_fsdp2_vllm_ascend:\n-    if: ${{ github.repository_owner == 'verl-project' && github.event.schedule == '0 18 * * *' }}\n+    if: ${{ github.repository_owner == 'verl-project' && (github.event_name == 'pull_request' || github.event.schedule == '0 18 * * *') }}\n     runs-on: linux-aarch64-a3-16\n     timeout-minutes: 180 # Increase this timeout value as needed\n     container:\n@@ -343,7 +346,7 @@ jobs:\n       HF_HUB_ENABLE_HF_TRANSFER: \"0\" # This is more stable\n       PIP_INDEX_URL: \"http://cache-service.nginx-pypi-cache.svc.cluster.local/pypi/simple\"\n       PIP_TRUSTED_HOST: \"cache-service.nginx-pypi-cache.svc.cluster.local\"\n-      MODEL_PATH: /root/.cache/models/Qwen/Qwen3.5-2B\n+      MODEL_PATH: /root/.cache/modelscope/hub/models/Qwen/Qwen3.5-2B\n       TRANSFORMERS_VERBOSITY: 'error'\n     steps:\n       - name: Check npu and CANN info",
