      "filename": "verl/workers/reward_manager/__init__.py",
      "patch": "@@ -16,3 +16,4 @@\n from .dapo import DAPORewardManager\n from .naive import NaiveRewardManager\n from .prime import PrimeRewardManager\n+from .ray import RayRewardManager",
      "raw_url": "https://github.com/verl-project/verl/raw/7156b256aa6e70df06bbeecd78827d91f9858249/verl%2Fworkers%2Freward_manager%2F__init__.py",
      "sha": "dbd8c2e94ab7cc910a4776d959cff8b8bdd7a038",
