      "deletions": 0,
      "filename": "verl/workers/reward_manager/prime.py",
      "patch": "@@ -83,6 +83,10 @@ async def parallel_compute_score_async(\n             scores.append(0.0)\n         elif isinstance(result, int | float | bool):\n             scores.append(float(result))\n+        elif isinstance(result, dict):\n+            # Reward functions like math_dapo / rlla return {\"score\": ...}; float(result[0])\n+            # would raise KeyError, which verify() silently turns into 0.0 for the whole batch.\n+            scores.append(float(result[\"score\"]))\n         else:\n             scores.append(float(result[0]))\n     return scores",
