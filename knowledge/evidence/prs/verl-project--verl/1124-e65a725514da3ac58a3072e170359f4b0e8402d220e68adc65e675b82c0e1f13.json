  "files": [
    {
      "additions": 4,
      "blob_url": "https://github.com/verl-project/verl/blob/4e0bb3d1761cb4c7a82b7844830ea838de741723/verl%2Ftrainer%2Fppo%2Fcore_algos.py",
      "changes": 4,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/verl%2Ftrainer%2Fppo%2Fcore_algos.py?ref=4e0bb3d1761cb4c7a82b7844830ea838de741723",
      "deletions": 0,
      "filename": "verl/trainer/ppo/core_algos.py",
      "patch": "@@ -467,6 +467,10 @@ def kl_penalty(logprob: torch.FloatTensor, ref_logprob: torch.FloatTensor, kl_pe\n     if kl_penalty == \"mse\":\n         return 0.5 * (logprob - ref_logprob).square()\n \n+    if kl_penalty == \"k3_off_policy\":\n+        log_ratio = ref_logprob - logprob\n+        return 1 - log_ratio.exp()\n+\n     # J. Schulman. Approximating kl divergence, 2020.\n     # # URL http://joschu.net/blog/kl-approx.html.\n     if kl_penalty == 'low_var_kl':",
      "raw_url": "https://github.com/verl-project/verl/raw/4e0bb3d1761cb4c7a82b7844830ea838de741723/verl%2Ftrainer%2Fppo%2Fcore_algos.py",
      "sha": "f334fb8d1788d1decb43040eb5d963a8c96bcd23",
      "status": "modified"
    },
    {
      "additions": 11,
      "blob_url": "https://github.com/verl-project/verl/blob/4e0bb3d1761cb4c7a82b7844830ea838de741723/verl%2Fworkers%2Factor%2Fdp_actor.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/verl%2Fworkers%2Factor%2Fdp_actor.py?ref=4e0bb3d1761cb4c7a82b7844830ea838de741723",
      "deletions": 0,
      "filename": "verl/workers/actor/dp_actor.py",
      "patch": "@@ -316,6 +316,17 @@ def update_policy(self, data: DataProto):\n                         kld = kl_penalty(logprob=log_prob,\n                                          ref_logprob=ref_log_prob,\n                                          kl_penalty=self.config.kl_loss_type)\n+\n+                        if self.config.use_kl_loss_important_sampling:\n+                            if cliprange_low is None:\n+                                cliprange_low = cliprange\n+                            if cliprange_high is None:\n+                                cliprange_high = cliprange\n+                            ratio = (log_prob - old_log_prob).exp()\n+                            surr1 = ratio * kld.detach()\n+                            surr2 = ratio.clamp(1 - cliprange_low, 1 + cliprange_high) * kld.detach()\n+                            kld = torch.max(surr1, surr2)\n+                        \n                         kl_loss = agg_loss(loss_mat=kld,\n                                            loss_mask=response_mask,\n                                            loss_agg_mode=self.config.loss_agg_mode)",
      "raw_url": "https://github.com/verl-project/verl/raw/4e0bb3d1761cb4c7a82b7844830ea838de741723/verl%2Fworkers%2Factor%2Fdp_actor.py",
      "sha": "2652d39c2c7d8ce7f85ec2f956a95f54863ba652",
      "status": "modified"
    }
