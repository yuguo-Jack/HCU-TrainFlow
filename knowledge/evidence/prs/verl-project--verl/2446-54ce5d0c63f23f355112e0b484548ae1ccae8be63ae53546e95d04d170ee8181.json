      "additions": 55,
      "blob_url": "https://github.com/verl-project/verl/blob/87d81599de8a58cb7e0d35b2d5003d62698d4ae7/tests%2Futils%2Freward_score%2Ftest_numeric_canonicalization_on_cpu.py",
      "changes": 55,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/tests%2Futils%2Freward_score%2Ftest_numeric_canonicalization_on_cpu.py?ref=87d81599de8a58cb7e0d35b2d5003d62698d4ae7",
      "deletions": 0,
      "filename": "tests/utils/reward_score/test_numeric_canonicalization_on_cpu.py",
      "patch": "@@ -0,0 +1,55 @@\n+# Unit tests for numeric canonicalization helpers:\n+# - legal integer strings      -> normalized form\n+# - illegal / non-integer str. -> unchanged\n+# - end-to-end `is_equiv` on boxed answers\n+\n+import pytest\n+from verl.utils.reward_score.math import _canonical_int_if_safe, is_equiv, remove_boxed\n+\n+\n+# ----- legal integers -------------------------------------------------\n+@pytest.mark.parametrize(\n+    \"raw, expected\",\n+    [\n+        (\"033\", \"33\"),\n+        (\"+033\", \"33\"),\n+        (\"-0\",  \"0\"),\n+        (\"000\", \"0\"),\n+    ],\n+)\n+def test_canonical_int_legal(raw, expected):\n+    \"\"\"Legal integer strings should be canonicalised.\"\"\"\n+    assert _canonical_int_if_safe(raw) == expected\n+\n+\n+# ----- illegal / non-integer ------------------------------------------\n+@pytest.mark.parametrize(\n+    \"illegal\",\n+    [\n+        \"3.3\",      # decimal\n+        \"foo\",      # letters\n+        \"--33\",     # malformed sign\n+        \"\",         # empty\n+        \"+\",        # sign only\n+        \"33a\",      # alphanumeric\n+    ],\n+)\n+def test_canonical_int_illegal(illegal):\n+    \"\"\"Illegal strings must stay untouched.\"\"\"\n+    assert _canonical_int_if_safe(illegal) == illegal\n+\n+\n+# ----- end-to-end boxed answers ---------------------------------------\n+@pytest.mark.parametrize(\n+    \"gt, pred\",\n+    [\n+        (\"\\\\boxed{033}\", \"33\"),\n+        (\"\\\\boxed{+033}\", \"33\"),\n+        (\"\\\\boxed{-0}\",  \"0\"),\n+        (\"\\\\boxed{000}\", \"0\"),\n+    ],\n+)\n+def test_is_equiv_boxed(gt, pred):\n+    \"\"\"`is_equiv` should treat canonicalised values as equal.\"\"\"\n+    gt_val = remove_boxed(gt)\n+    assert is_equiv(gt_val, pred) is True",
      "raw_url": "https://github.com/verl-project/verl/raw/87d81599de8a58cb7e0d35b2d5003d62698d4ae7/tests%2Futils%2Freward_score%2Ftest_numeric_canonicalization_on_cpu.py",
      "sha": "3229e51615ab317c33f8bdadeab897dc7646b003",
      "status": "added"
    },
    {
      "additions": 9,
      "blob_url": "https://github.com/verl-project/verl/blob/87d81599de8a58cb7e0d35b2d5003d62698d4ae7/verl%2Futils%2Freward_score%2Fmath.py",
      "changes": 11,
      "contents_url": "https://api.github.com/repos/verl-project/verl/contents/verl%2Futils%2Freward_score%2Fmath.py?ref=87d81599de8a58cb7e0d35b2d5003d62698d4ae7",
      "deletions": 2,
      "filename": "verl/utils/reward_score/math.py",
      "patch": "@@ -29,6 +29,13 @@ def compute_score(solution_str, ground_truth) -> float:\n \n \n # string normalization from https://github.com/EleutherAI/lm-evaluation-harness/blob/master/lm_eval/tasks/hendrycks_math.py\n+import re\n+\n+def _canonical_int_if_safe(s: str) -> str:\n+    if re.fullmatch(r'[-+]?\\d+', s):\n+        return str(int(s))\n+    return s\n+\n def is_equiv(str1, str2, verbose=False):\n     if str1 is None and str2 is None:\n         print(\"WARNING: Both None\")\n@@ -37,8 +44,8 @@ def is_equiv(str1, str2, verbose=False):\n         return False\n \n     try:\n-        ss1 = strip_string(str1)\n-        ss2 = strip_string(str2)\n+        ss1 = _canonical_int_if_safe(strip_string(str1))\n+        ss2 = _canonical_int_if_safe(strip_string(str2))\n         if verbose:\n             print(ss1, ss2)\n         return ss1 == ss2",
      "raw_url": "https://github.com/verl-project/verl/raw/87d81599de8a58cb7e0d35b2d5003d62698d4ae7/verl%2Futils%2Freward_score%2Fmath.py",
      "sha": "72f62a961730b5115bfd6bcf1001862a5c500de8",
      "status": "modified"
    }
  ],
  "inline_comments": [
    {
      "body": "![high](https://www.gstatic.com/codereviewagent/high-priority.svg)\n\nThe current implementation doesn't correctly normalize integers with signs. For example, `is_equiv('+33', '33')` and `is_equiv('-0', '0')` would both incorrectly return `False`.\n\nYou can simplify this function and fix these issues by converting the string to an `int` and back to a `str`. This will correctly handle all normalization cases: leading zeros, positive `+` signs, and signed zeros.\n\n```suggestion\n        return str(int(s))\n```",
      "created_at": "2025-07-10T00:44:27Z",
      "diff_hunk": "@@ -29,6 +29,18 @@ def compute_score(solution_str, ground_truth) -> float:\n \n \n # string normalization from https://github.com/EleutherAI/lm-evaluation-harness/blob/master/lm_eval/tasks/hendrycks_math.py\n+import re\n+def _canonical_int_if_safe(s: str) -> str:\n+    \"\"\"\n+    If s is an integer (±digits), drop leading zeros; else return unchanged.\n+    \"\"\"\n+    if re.fullmatch(r'[-+]?\\d+', s):\n+        sign = s[0] if s[0] in '+-' else ''\n+        num  = s[1:] if sign else s\n+        num  = num.lstrip('0') or '0'\n+        return sign + num",
      "html_url": "https://github.com/verl-project/verl/pull/2446#discussion_r2196264136",
