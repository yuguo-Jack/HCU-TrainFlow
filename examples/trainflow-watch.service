# Template: replace every uppercase placeholder and verify task permissions.
[Unit]
Description=TrainFlow observation watcher
After=network-online.target

[Service]
Type=simple
User=TASK_USER
WorkingDirectory=/PRIVATE_WORKSPACE
ExecStart=/ABSOLUTE/PYTHON -m hcu_trainflow --workspace /PRIVATE_WORKSPACE watch TASK_ID /PRIVATE_LOG.jsonl /PRIVATE_POLICY.json --interval 10
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
