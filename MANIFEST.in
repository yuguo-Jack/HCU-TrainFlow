include LICENSE README.md CHANGELOG.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md
recursive-include docs *.md
recursive-include knowledge *.md *.json
recursive-include skills *.md *.yaml
recursive-include examples *.json *.service
recursive-include scripts *.py
recursive-include tests *.py
prune .private
prune .work
global-exclude __pycache__ *.py[cod]
