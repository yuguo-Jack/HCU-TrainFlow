* text=auto eol=lf
# Site/case evidence is byte-addressed. Preserve original line endings across OSes.
knowledge/sites/** -text
knowledge/experiments/** -text
# Retained originals may contain whitespace that must not be edited to satisfy lint.
knowledge/sites/**/evidence/** -whitespace
knowledge/experiments/**/evidence/** -whitespace
# Generated source pages preserve upstream prose, code and Markdown hard breaks.
knowledge/prs/** -whitespace
knowledge/upstream-docs/** -whitespace
